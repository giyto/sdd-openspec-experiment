+
+def test_jitter_single_uniform_call():
+    rng = Mock()
+    rng.uniform.return_value = 1.1
+    p = RetryPolicy(base_delay=10, jitter=0.2, max_delay=100)
+    assert p.delay_for(1, rng) == pytest.approx(11)
+    rng.uniform.assert_called_once_with(0.8, 1.2)
