@@ -0,0 +1,86 @@
+"""Политика повторов: параметры, расчёт задержки и классификация ошибок."""
+
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+from typing import Any
+
+from .errors import ConfigError, PermanentJobError
+
+
+def _check_number(name: str, value: Any) -> None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ConfigError(f"{name} must be a number, got {value!r}")
+    if not math.isfinite(value):
+        raise ConfigError(f"{name} must be finite, got {value!r}")
+
+
+@dataclass(frozen=True, kw_only=True)
+class RetryPolicy:
+    """Неизменяемая политика повторов.
+
+    ``max_attempts`` — общее число попыток, включая первую. Задержка перед
+    повтором: ``base_delay * factor ** (attempt - 1)``, не больше ``max_delay``,
+    с необязательным джиттером.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if isinstance(self.max_attempts, bool) or not isinstance(self.max_attempts, int):
+            raise ConfigError(f"max_attempts must be an integer, got {self.max_attempts!r}")
+        if self.max_attempts < 1:
+            raise ConfigError("max_attempts must be >= 1")
+        for name in ("base_delay", "factor", "max_delay", "jitter"):
+            _check_number(name, getattr(self, name))
+        if self.base_delay < 0:
+            raise ConfigError("base_delay must be >= 0")
+        if self.factor < 1:
+            raise ConfigError("factor must be >= 1")
+        if self.max_delay < self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+
+        try:
+            classes = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be an iterable of exception classes") from None
+        for cls in classes:
+            if not (isinstance(cls, type) and issubclass(cls, BaseException)):
+                raise ConfigError(f"non_retryable item is not an exception class: {cls!r}")
+        object.__setattr__(self, "non_retryable", classes)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка (секунды) перед следующей попыткой, если упала попытка ``attempt`` (с 1)."""
+        if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt < 1:
+            raise ConfigError(f"attempt must be an integer >= 1, got {attempt!r}")
+
+        base = float(self.base_delay)
+        if base == 0:
+            return 0.0
+        if self.factor == 1:
+            delay = base
+        else:
+            try:
+                delay = base * float(self.factor) ** (attempt - 1)
+            except OverflowError:
+                delay = self.max_delay
+        delay = min(delay, float(self.max_delay))
+
+        if self.jitter > 0:
+            if rng is None:
+                rng = random.Random()
+            delay = min(delay * rng.uniform(1 - self.jitter, 1 + self.jitter), float(self.max_delay))
+        return delay
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """``False`` для ``non_retryable`` (с подклассами) и :class:`PermanentJobError`."""
+        return not isinstance(exc, (*self.non_retryable, PermanentJobError))
