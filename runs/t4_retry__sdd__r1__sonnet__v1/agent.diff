+import dataclasses
+import math
+from unittest.mock import Mock
+
+import pytest
+
+from jobq import ConfigError, JobqError, PermanentJobError, RetryPolicy
+from jobq import metrics as m
+from jobq.models import DeadLetterEntry, JobStatus
+
+
+def test_permanent_error_is_jobq_error():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_status_values_labels_terminal():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert JobStatus.DEAD_LETTERED.is_terminal
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert dataclasses.is_dataclass(DeadLetterEntry)
+
+
+def test_metric_names():
+    assert m.JOBS_RETRIED == "jobs.retried"
+    assert m.JOBS_DEAD_LETTERED == "jobs.dead_lettered"
+    assert m.JOBS_REQUEUED == "jobs.requeued"
+
+
+def test_defaults_and_frozen():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter, p.non_retryable) == (
+        3,
+        1.0,
+        2.0,
+        60.0,
+        0.0,
+        (),
+    )
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        p.max_attempts = 5
+
+
+def test_non_retryable_list_becomes_tuple():
+    assert RetryPolicy(non_retryable=[ValueError]).non_retryable == (ValueError,)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": 2.5},
+        {"max_attempts": True},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 5, "max_delay": 1},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"base_delay": math.nan},
+        {"max_delay": math.inf},
+        {"factor": "2"},
+        {"non_retryable": [ValueError("x")]},
+        {"non_retryable": ["ValueError"]},
+        {"non_retryable": [int]},
+        {"non_retryable": 5},
+    ],
+)
+def test_invalid_values(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+def test_boundary_values_ok():
+    RetryPolicy(max_attempts=1, base_delay=0, factor=1, max_delay=0, jitter=0)
+    RetryPolicy(base_delay=3, max_delay=3, jitter=1)
+
+
+def test_delay_exponential_and_cap():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=60)
+    assert [p.delay_for(a) for a in (1, 2, 3)] == [1, 2, 4]
+    assert p.delay_for(10) == 60
+
+
+@pytest.mark.parametrize("attempt", [0, -1])
+def test_delay_bad_attempt(attempt):
+    with pytest.raises(ConfigError):
+        RetryPolicy().delay_for(attempt)
+
+
+@pytest.mark.parametrize("attempt", [5000, 10**6])
+def test_delay_huge_attempt(attempt):
+    assert RetryPolicy(max_attempts=10**7, factor=2.0).delay_for(attempt) == 60.0
+    assert RetryPolicy(max_attempts=10**7, factor=2).delay_for(attempt) == 60.0
+    assert RetryPolicy(max_attempts=10**7, base_delay=0, max_delay=1).delay_for(attempt) == 0.0
