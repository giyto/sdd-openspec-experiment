+def test_stats_and_purge_keep_dead_letter(clock, registry):
+    q, w = make(clock, registry, RetryPolicy(max_attempts=1))
+    registry.register("ok", lambda job: 1)
+    ok = q.enqueue("ok")
+    dead = q.enqueue("t")
+    w.run_pending()
+    retry = q.enqueue("t")
+    q.set_retry_policy("t", RetryPolicy(base_delay=5))
+    w.run_once()
+    stats = q.stats()
+    assert stats["retry_scheduled"] == 1 and stats["dead_lettered"] == 1
+    assert q.list_jobs(JobStatus.RETRY_SCHEDULED) == [retry]
+    clock.advance(1)
+    assert q.purge_finished() == 1
+    assert ok.id not in q.store
+    assert q.list_jobs(JobStatus.DEAD_LETTERED) == [dead]
+    assert len(q.dead_letters()) == 1
+
+
+def test_report_rows(clock, registry):
+    q, w = make(clock, registry, RetryPolicy(max_attempts=2, base_delay=5))
+    q.enqueue("t")
+    q.enqueue("t")
+    w.run_pending()
+    lines = render_report(q).splitlines()
+    retry_row = next(line for line in lines if "Ожидает повтора" in line)
+    assert retry_row.split()[-1] == "2"
+    assert next(line for line in lines if "В dead-letter" in line).split()[-1] == "0"
+    assert next(line for line in lines if "Всего" in line).split()[-1] == "2"
+
