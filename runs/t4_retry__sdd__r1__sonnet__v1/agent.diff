@@ -0,0 +1,242 @@
+from datetime import timedelta
+from unittest.mock import Mock
+
+import pytest
+
+from jobq import (
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+from tests.conftest import START
+
+
+def boom(job):
+    raise TimeoutError("slow")
+
+
+def make(clock, registry, policy=None, handler=boom, rng=None):
+    q = JobQueue(clock=clock, default_retry_policy=policy)
+    registry.register("t", handler)
+    return q, Worker(q, registry, rng=rng)
+
+
+def test_due_order_equal_run_at(clock, registry):
+    q, w = make(clock, registry, RetryPolicy(base_delay=5))
+    a = q.enqueue("t")
+    w.run_once()  # a -> повтор через 5 с
+    b = q.enqueue("t", delay=5)  # позже по seq, тот же run_at
+    clock.advance(5)
+    assert a.run_at == b.run_at
+    assert q.next_due().id == a.id
+
+
+def test_policy_lookup(clock):
+    assert JobQueue(clock=clock).retry_policy_for("x") is None
+    d = RetryPolicy(max_attempts=5, base_delay=2)
+    q = JobQueue(clock=clock, default_retry_policy=d)
+    own = RetryPolicy(max_attempts=2)
+    q.set_retry_policy("x", own)
+    assert q.retry_policy_for("x") is own and own.base_delay == 1.0
+    q.set_retry_policy("x", None)
+    assert q.retry_policy_for("x") is d
+
+
+def test_no_policy_failed(clock, registry):
+    q, w = make(clock, registry)
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.FAILED
+    assert q.metrics.get("jobs.failed") == 1
+    assert q.dead_letters() == []
+
+
+def test_schedule_retry(clock, registry):
+    q, w = make(clock, registry, RetryPolicy(base_delay=1))
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.RETRY_SCHEDULED
+    assert j.run_at == START + timedelta(seconds=1)
+    assert q.metrics.get("jobs.retried") == 1
+    assert q.metrics.get("jobs.failed") == 0
+    assert j.error == "TimeoutError: slow"
+    assert w.run_once() is None
+    clock.advance(1)
+    assert w.run_once() is j
+
+
+def test_exhaustion_dead_letter(clock, registry):
+    rng = Mock()
+    rng.uniform.return_value = 1.0
+    q, w = make(clock, registry, RetryPolicy(max_attempts=2, base_delay=1, jitter=0.5), rng=rng)
+    j = q.enqueue("t")
+    w.run_once()
+    clock.advance(1)
+    w.run_once()
+    assert j.status is JobStatus.DEAD_LETTERED
+    assert j.attempts == 2
+    assert rng.uniform.call_count == 1  # только на реальный повтор
+    assert q.metrics.get("jobs.dead_lettered") == 1
+    assert q.metrics.get("jobs.failed") == 0
+    (e,) = q.dead_letters()
+    assert (e.job_id, e.job_type, e.attempts, e.error, e.dead_lettered_at) == (
+        j.id,
+        "t",
+        2,
+        j.error,
+        clock.now(),
+    )
+
+
+def test_max_attempts_one_no_rng(clock, registry):
+    rng = Mock()
+    q, w = make(clock, registry, RetryPolicy(max_attempts=1, jitter=0.5), rng=rng)
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.DEAD_LETTERED
+    assert rng.method_calls == []
+
+
+def test_permanent_on_last_attempt_is_failed(clock, registry):
+    def h(job):
+        raise PermanentJobError("no")
+
+    rng = Mock()
+    q, w = make(clock, registry, RetryPolicy(max_attempts=1, jitter=0.5), handler=h, rng=rng)
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.FAILED
+    assert q.dead_letters() == []
+    assert q.metrics.get("jobs.failed") == 1
+    assert rng.method_calls == []
+
+
+def test_unknown_handler_failed(clock, registry):
+    q = JobQueue(clock=clock, default_retry_policy=RetryPolicy())
+    j = q.enqueue("nope")
+    Worker(q, registry).run_once()
+    assert j.status is JobStatus.FAILED
+    assert q.dead_letters() == []
+
+
+def test_success_after_retry_zero_delay(clock, registry):
+    seen = []
+
+    def h(job):
+        seen.append(job.attempts)
+        if job.attempts == 1:
+            raise TimeoutError("x")
+
+    q, w = make(clock, registry, RetryPolicy(base_delay=0), handler=h)
+    j = q.enqueue("t")
+    assert w.run_pending() == 2
+    assert j.status is JobStatus.SUCCEEDED and j.error is None and j.attempts == 2
+    assert seen == [1, 2]
+
+
+def test_policy_change_while_waiting(clock, registry):
+    q, w = make(clock, registry, RetryPolicy(max_attempts=5, base_delay=1))
+    j = q.enqueue("t")
+    w.run_once()
+    q.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    clock.advance(1)
+    w.run_once()
+    assert j.status is JobStatus.DEAD_LETTERED
+
+
+def test_cancel_retry_scheduled_and_dead_lettered(clock, registry):
+    q, w = make(clock, registry, RetryPolicy(max_attempts=2, base_delay=1))
+    a = q.enqueue("t")
+    w.run_once()
+    q.cancel(a.id)
+    clock.advance(5)
+    assert a.status is JobStatus.CANCELLED and w.run_once() is None
+    assert q.metrics.get("jobs.cancelled") == 1
+    b = q.enqueue("t")
+    w.run_once()
+    clock.advance(1)
+    w.run_once()
+    assert b.status is JobStatus.DEAD_LETTERED
+    with pytest.raises(InvalidTransitionError):
+        q.cancel(b.id)
+    assert len(q.dead_letters()) == 1
+
+
+def test_invalid_transitions(clock, registry):
+    q, _ = make(clock, registry)
+    j = q.enqueue("t")
+    with pytest.raises(InvalidTransitionError):
+        q.mark_retry_scheduled(j.id, "e", START)
+    with pytest.raises(InvalidTransitionError):
+        q.mark_dead_lettered(j.id, "e")
+
+
+def test_dead_letter_order_and_requeue(clock, registry):
+    q, w = make(clock, registry, RetryPolicy(max_attempts=1))
+    b = q.enqueue("t")
+    a = q.enqueue("t")
+    w.run_pending()
+    assert [e.job_id for e in q.dead_letters()] == [b.id, a.id]
+    enqueued = q.metrics.get("jobs.enqueued")
+    clock.advance(10)
+    assert q.requeue_dead_letter(b.id) is b
+    assert b.status is JobStatus.PENDING
+    assert (b.attempts, b.error, b.finished_at, b.run_at) == (0, None, None, clock.now())
+    assert q.metrics.get("jobs.requeued") == 1
+    assert q.metrics.get("jobs.enqueued") == enqueued
+    assert [e.job_id for e in q.dead_letters()] == [a.id]
+    w.run_pending()
+    assert [e.job_id for e in q.dead_letters()] == [a.id, b.id]
+
+
+def test_requeue_errors(clock, registry):
+    q, w = make(clock, registry)
+    with pytest.raises(JobNotFoundError):
+        q.requeue_dead_letter("nope")
+    j = q.enqueue("t")
+    with pytest.raises(InvalidTransitionError):
+        q.requeue_dead_letter(j.id)
+    w.run_once()
+    with pytest.raises(InvalidTransitionError):
+        q.requeue_dead_letter(j.id)
+    assert j.status is JobStatus.FAILED
+
