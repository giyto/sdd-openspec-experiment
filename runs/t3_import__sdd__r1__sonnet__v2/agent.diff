+    assert info.value.line_no == 1
+
+
+def test_duplicate_column_names_unknown(write_csv):
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv("Дата;Сумма;Описание;сумма\n"), MemoryStore())
+
+
+def test_unknown_fmt_value(write_csv):
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(NOVA), MemoryStore(), fmt="bogus")
+
