+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule, normalize_text
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = "Дата;Сумма;Описание\n"
+SPLIT = "Дата;Описание;Приход;Расход\n"
+NOVA = "date,amount,description\n"
+
+
+# --- errors -----------------------------------------------------------------
+
+
+def test_new_errors_keep_line_no():
+    for cls in (UnknownFormatError, StatementRowError):
+        err = cls("boom", line_no=7)
+        assert isinstance(err, StatementError)
+        assert err.line_no == 7
+
+
+# --- normalize_description ---------------------------------------------------
+
+
+@pytest.mark.parametrize("text", ["  Магазин   Лента ", "ЁЖИК\tв  тумане", "abc", ""])
+def test_normalize_description_matches_rules(text):
+    assert normalize_description(text) == normalize_text(text)
+
+
+# --- reading -----------------------------------------------------------------
+
+
+def test_utf8_bom(write_csv):
+    path = write_csv("﻿" + NOVA + "2026-03-01,-1.00,Кофе\n")
+    res = import_statement(path, MemoryStore())
+    assert (res.format, res.encoding, res.added) == ("nova", "utf-8", 1)
+
+
+def test_cp1251(write_csv):
+    path = write_csv(SFERA + "01.03.2026;-10,00;Кофейня\n", encoding="cp1251")
+    store = MemoryStore()
+    res = import_statement(path, store)
+    assert res.encoding == "cp1251"
+    assert store.all()[0].description == "Кофейня"
+
+
+def test_undecodable_file(tmp_path):
+    path = tmp_path / "x.csv"
+    path.write_bytes(b"\xff\xfe\x98\x98")
+    with pytest.raises(StatementError) as info:
+        import_statement(path, MemoryStore())
+    assert info.value.line_no is None
+
+
+def test_junk_rows_skipped(write_csv):
+    path = write_csv("\n  \n;;;\n" + SFERA + "\n;;;\n01.03.2026;-1,00;A\n   \n;;;\n;;\n")
+    res = import_statement(path, MemoryStore())
+    assert (res.added, res.duplicates, res.errors) == (1, 0, [])
+
+
+def test_junk_rows_nova(write_csv):
+    path = write_csv(NOVA + ",,\n\n2026-03-01,-1.00,A\n  \n,,\n")
+    res = import_statement(path, MemoryStore())
+    assert (res.added, res.errors) == (1, [])
+
+
+def test_multiline_quoted_line_numbers(write_csv):
+    path = write_csv(
+        SFERA + "01.03.2026;-1,00;A\n\n" + '32.03.2026;-1,00;"два\nстроки"\n' + "01.03.2026;-2,00;B\n"
+    )
+    res = import_statement(path, MemoryStore())
+    assert res.added == 2
+    assert [e.line_no for e in res.errors] == [4]
+
+
+# --- format detection --------------------------------------------------------
+
+
+def test_detect_three_formats(write_csv):
+    assert detect_format(write_csv(NOVA)) == "nova"
+    assert detect_format(write_csv(SFERA)) == "sfera"
+    assert detect_format(write_csv(SPLIT)) == "sfera_split"
+
+
+def test_sfera_header_case_spaces_extra_columns(write_csv):
+    path = write_csv("ДАТА; Сумма ;Описание;Номер карты\n01.03.2026;-1,00;A;1234\n")
+    res = import_statement(path, MemoryStore())
+    assert (res.format, res.added) == ("sfera", 1)
+
+
+def test_split_reordered_columns(write_csv):
+    path = write_csv("Описание;Расход;Дата;Приход;Остаток\nКофе;5,00;01.03.2026;;100,00\n")
+    store = MemoryStore()
+    res = import_statement(path, store)
+    assert res.format == "sfera_split"
+    assert store.all()[0].amount == Decimal("-5.00")
+
+
+@pytest.mark.parametrize("content", ["", "\n  \n;;;\n"])
+def test_empty_file(write_csv, content):
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv(content), MemoryStore())
+    assert info.value.line_no is None
+
+
+def test_unrecognized_header(write_csv):
+    with pytest.raises(UnknownFormatError) as info:
