+def test_reimport_is_noop(write_csv, clock, tmp_path):
+    db = tmp_path / "db.json"
+    store = JsonFileStore(db)
+    path = write_csv(_file(["01.03.2026;-1,00;A", "02.03.2026;-2,00;B"]))
+    assert import_statement(path, store, clock=clock).added == 2
+    before = db.read_bytes()
+    mtime = db.stat().st_mtime_ns
+    res = import_statement(path, store, clock=clock)
+    assert (res.added, res.duplicates) == (0, 2)
+    assert len(store.all()) == 2
+    assert db.read_bytes() == before and db.stat().st_mtime_ns == mtime
