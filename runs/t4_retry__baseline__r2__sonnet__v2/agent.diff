new file mode 100644
index 0000000..e6369c0
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,92 @@
+import random
+
+import pytest
+
+from jobq import (
+    ConfigError, HandlerRegistry, JobQueue, JobStatus, ManualClock,
+    PermanentJobError, RetryPolicy, Worker,
+)
+
+
+def make(policy=None):
+    clock = ManualClock()
+    queue = JobQueue(clock=clock, default_retry_policy=policy)
+    registry = HandlerRegistry()
+    return clock, queue, registry, Worker(queue, registry)
+
+
+def boom(job):
+    raise RuntimeError("x")
+
+
+def test_delay_and_overflow():
+    p = RetryPolicy(max_attempts=10000, base_delay=1, factor=2, max_delay=60)
+    assert p.delay_for(1) == 1 and p.delay_for(4) == 8
+    assert p.delay_for(5000) == 60
+    assert RetryPolicy(base_delay=0).delay_for(5000) == 0
+
+
+def test_jitter_capped():
+    p = RetryPolicy(base_delay=10, max_delay=10, jitter=1)
+    assert all(0 <= p.delay_for(1, random.Random(i)) <= 10 for i in range(50))
+
+
+@pytest.mark.parametrize("kw", [
+    {"max_attempts": 0}, {"base_delay": -1}, {"factor": 0.5},
+    {"max_delay": 0.5}, {"jitter": 1.1}, {"non_retryable": [int]},
+])
+def test_invalid(kw):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kw)
+
+
+def test_non_retryable_stored_as_tuple():
+    assert RetryPolicy(non_retryable=[ValueError]).non_retryable == (ValueError,)
+
+
+def test_retry_then_dead_letter_then_requeue():
+    clock, queue, registry, worker = make(RetryPolicy(max_attempts=2))
+    registry.register("t", boom)
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED and worker.run_once() is None
+    clock.advance(1)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert [e.job_id for e in queue.dead_letters()] == [job.id]
+    assert queue.purge_finished() == 0
+    queue.requeue_dead_letter(job.id)
+    assert job.status is JobStatus.PENDING and job.attempts == 0 and job.error is None
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.retried") == 1
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    assert queue.metrics.get("jobs.requeued") == 1
+
+
+def test_permanent_fails_and_cancel_retry():
+    clock, queue, registry, worker = make(RetryPolicy(max_attempts=1))
+
+    def perm(job):
+        raise PermanentJobError("no")
+
+    registry.register("p", perm)
+    job = queue.enqueue("p")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED and not queue.dead_letters()
+    registry.register("t", boom)
+    q = RetryPolicy(max_attempts=3)
+    queue.set_retry_policy("t", q)
+    assert queue.retry_policy_for("t") is q
+    j2 = queue.enqueue("t")
+    worker.run_once()
+    queue.cancel(j2.id)
+    assert j2.status is JobStatus.CANCELLED
+
+
+def test_no_policy_and_unknown_type_fail():
+    _, queue, registry, worker = make()
+    registry.register("t", boom)
+    j = queue.enqueue("t")
+    j2 = queue.enqueue("zzz")
+    worker.run_pending()
+    assert j.status is JobStatus.FAILED and j2.status is JobStatus.FAILED
