+
+def test_reserved_is_per_position(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "BOLT-M8", 10)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 4)])
+    assert inv.reserved("NORTH", "BOLT-M8") == 0
+    assert inv.available("NORTH", "BOLT-M8") == 10
