+# --- время, истечение, доступность -------------------------------------------
+
+
+def test_expiry_boundary(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 3)], ttl=timedelta(hours=2))
+    log_size = len(inv.log)
+
+    clock.set(datetime(2026, 3, 1, 11, 59, 59, tzinfo=timezone.utc))
+    assert inv.get_reservation("ORD-1").status is ACTIVE
+    assert inv.reserved("MAIN", "BOLT-M8") == 3
+
+    clock.set(datetime(2026, 3, 1, 12, 0, 0, tzinfo=timezone.utc))
+    assert inv.get_reservation("ORD-1").status is EXPIRED
+    assert inv.reserved("MAIN", "BOLT-M8") == 0
+    assert len(inv.log) == log_size
+
+
+def test_expired_reservation_is_not_changed_in_store(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 3)], ttl=timedelta(minutes=1))
+    clock.advance(timedelta(minutes=1))
+    inv.get_reservation("ORD-1")
+    assert inv.store.get_reservation("ORD-1").status is ACTIVE
+
+
+def test_confirmed_reservation_stays_confirmed_after_expiry(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 3)], ttl=timedelta(minutes=1))
+    inv.confirm("ORD-1")
+    clock.advance(timedelta(hours=1))
+    assert inv.get_reservation("ORD-1").status is CONFIRMED
+
+
+def test_reserved_and_available(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 4)])
+    inv.reserve("ORD-2", [("MAIN", "BOLT-M8", 3)])
+    assert inv.reserved("MAIN", "BOLT-M8") == 7
+    assert inv.available("MAIN", "BOLT-M8") == 3
+    assert inv.on_hand("MAIN", "BOLT-M8") == 10
+
+
+def test_available_not_negative_when_stock_below_reserve(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 5)])
+    inv.adjust("MAIN", "BOLT-M8", 3, "recount")
+    assert inv.reserved("MAIN", "BOLT-M8") == 5
+    assert inv.available("MAIN", "BOLT-M8") == 0
+    assert inv.on_hand("MAIN", "BOLT-M8") == 3
+
+
+def test_reserved_and_available_unknown_sku(inv):
