+
+def test_confirm_success_writes_issue_then_confirm(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("NORTH", "NUT-M8", 5)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 2), ("NORTH", "NUT-M8", 1)])
+
+    confirmed = inv.confirm("ORD-1")
+
+    assert confirmed.status is CONFIRMED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 3
+    assert inv.on_hand("NORTH", "NUT-M8") == 4
+    kinds = [event.kind for event in inv.log][-3:]
+    assert kinds == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    issues = inv.log.events("ISSUE")
+    assert [event.fields["ref"] for event in issues] == ["ORD-1", "ORD-1"]
+    assert inv.log.events("RESERVE_CONFIRM")[0].fields["order"] == "ORD-1"
+
+
+def test_confirm_with_zero_available_from_own_reservation(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("ORD-1", [("MAIN", "BOLT-M8", 5)])
+    assert inv.available("MAIN", "BOLT-M8") == 0
+    assert inv.confirm("ORD-1").status is CONFIRMED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_checks_physical_by_sum_of_same_position(inv):
