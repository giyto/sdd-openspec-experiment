+def test_requeue(queue, clock):
+    job = _dead(queue)
+    clock.advance(10)
+    same = queue.requeue_dead_letter(job.id)
+    assert same is job
+    assert job.status is JobStatus.PENDING
+    assert job.attempts == 0 and job.error is None
+    assert job.run_at == clock.now()
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.requeued") == 1
