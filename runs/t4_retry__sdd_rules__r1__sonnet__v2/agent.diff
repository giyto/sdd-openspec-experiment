+def test_full_cycle(queue, registry, worker, clock):
+    queue.set_retry_policy("x", RetryPolicy(max_attempts=2, base_delay=1))
+    registry.register("x", failing())
+    job = queue.enqueue("x")
+    worker.run_once()
+    assert worker.run_once() is None  # run_at not reached
+    clock.advance(1)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    queue.requeue_dead_letter(job.id)
+    m = queue.metrics
+    assert (m.get("jobs.started"), m.get("jobs.retried")) == (2, 1)
+    assert (m.get("jobs.dead_lettered"), m.get("jobs.requeued")) == (1, 1)
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED  # attempts reset, not dead again
+
