+def test_rng_usage(queue, registry, clock):
+    rng = FakeRng(1.0)
+    worker = Worker(queue, registry, rng=rng)
+    queue.set_retry_policy("x", RetryPolicy(max_attempts=2, jitter=0.5))
+    queue.set_retry_policy("y", RetryPolicy(max_attempts=2, jitter=0.5, non_retryable=(Exception,)))
+    registry.register("x", failing())
+    registry.register("y", failing())
+    queue.enqueue("y")
+    worker.run_once()
+    assert rng.calls == []  # FAILED
+    queue.enqueue("x")
+    worker.run_once()
+    assert len(rng.calls) == 1  # one retry
+    clock.advance(100)
+    worker.run_once()  # DEAD_LETTERED
+    assert len(rng.calls) == 1
