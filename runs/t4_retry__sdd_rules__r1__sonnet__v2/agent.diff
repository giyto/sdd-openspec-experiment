@@ -0,0 +1,403 @@
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobQueue,
+    JobqError,
+    JobStatus,
+    ManualClock,
+    Metrics,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+
+from .conftest import START
+
+
+class FakeRng:
+    def __init__(self, value):
+        self.value = value
+        self.calls = []
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def failing(exc=RuntimeError("boom")):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+# -- 1.x: errors, models, metrics ---------------------------------------------
+
+
+def test_permanent_error_is_jobq_error():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_new_statuses():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert not JobStatus.DEAD_LETTERED.is_terminal
+
+
+def test_new_counters_default_to_zero():
+    metrics = Metrics()
+    for name in ("jobs.retried", "jobs.dead_lettered", "jobs.requeued", "jobs.unknown"):
+        assert metrics.get(name) == 0
+    assert metrics.snapshot() == {}
+
+
+# -- 2.x: RetryPolicy ---------------------------------------------------------
+
+
+def test_defaults_and_frozen():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter, p.non_retryable) == (
+        3, 1.0, 2.0, 60.0, 0.0, (),
+    )
+    with pytest.raises(Exception):
+        p.max_attempts = 5  # type: ignore[misc]
+
+
+def test_non_retryable_list_becomes_tuple():
+    p = RetryPolicy(non_retryable=[ValueError, KeyError])
+    assert p.non_retryable == (ValueError, KeyError)
+    assert isinstance(p.non_retryable, tuple)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": 1.5},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 5, "max_delay": 1},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"non_retryable": (ValueError("x"),)},
+        {"non_retryable": ("ValueError",)},
+        {"non_retryable": (int,)},
+        {"base_delay": float("nan")},
+        {"factor": float("nan")},
+        {"max_delay": float("nan")},
+        {"jitter": float("nan")},
+    ],
+)
+def test_invalid_policy(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 1},
+        {"base_delay": 0},
+        {"factor": 1},
+        {"base_delay": 3, "max_delay": 3},
+        {"jitter": 0},
+        {"jitter": 1},
+    ],
+)
+def test_boundary_policy_valid(kwargs):
+    RetryPolicy(**kwargs)
+
+
+def test_delay_growth_and_cap():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=60)
+    assert [p.delay_for(i) for i in (1, 2, 3)] == [1.0, 2.0, 4.0]
+    assert RetryPolicy(base_delay=1, factor=2, max_delay=10).delay_for(10) == 10.0
+
+
+def test_delay_huge_attempt():
+    p = RetryPolicy(max_attempts=10000)
+    assert p.delay_for(5000) == p.max_delay
+    assert p.delay_for(10**9) == p.max_delay
+
+
+def test_delay_zero_base():
+    p = RetryPolicy(base_delay=0)
+    assert p.delay_for(1) == 0.0
+    assert p.delay_for(10**6) == 0.0
+
+
+def test_delay_factor_one():
+    assert RetryPolicy(base_delay=2, factor=1).delay_for(100) == 2.0
+
+
+def test_jitter_capped():
+    p = RetryPolicy(base_delay=10, max_delay=10, jitter=0.5)
+    assert p.delay_for(3, FakeRng(1.4)) == 10.0
+
+
+def test_jitter_applied_once():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=60, jitter=0.2)
+    rng = FakeRng(1.1)
+    assert p.delay_for(3, rng) == pytest.approx(4.4)
+    assert rng.calls == [(0.8, 1.2)]
+
+
+def test_jitter_default_rng_in_range():
+    p = RetryPolicy(base_delay=1, max_delay=60, jitter=0.5)
+    assert 0.5 <= p.delay_for(1) <= 1.5
+
+
