+def _dead(queue, job_type="x"):
+    job = queue.enqueue(job_type)
+    queue.mark_running(job.id)
+    queue.mark_dead_lettered(job.id, "E: e")
+    return job
+
+
+def test_dead_letter_order_and_copy(queue, clock):
+    a = _dead(queue)
+    clock.advance(1)
+    b = _dead(queue)
+    entries = queue.dead_letters()
+    assert [e.job_id for e in entries] == [a.id, b.id]
+    assert entries[1].dead_lettered_at == START + timedelta(seconds=1)
+    assert isinstance(entries[0], DeadLetterEntry)
+    entries.clear()
+    assert len(queue.dead_letters()) == 2
+
