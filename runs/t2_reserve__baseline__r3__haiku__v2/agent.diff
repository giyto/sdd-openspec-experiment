diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..7167836
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,294 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    UnknownSkuError,
+    ValidationError,
+)
+from warehouse.models import ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL
+
+T0 = datetime(2026, 3, 1, 10, 0, 0, tzinfo=timezone.utc)
+
+
+def test_default_ttl_is_fifteen_minutes():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+def test_reserve_holds_stock_without_changing_on_hand(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    reservation = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert reservation.status is ReservationStatus.ACTIVE
+    assert reservation.created_at == T0
+    assert reservation.expires_at == T0 + DEFAULT_RESERVATION_TTL
+    assert inv.on_hand("MAIN", "BOLT-M8") == 10
+    assert inv.reserved("MAIN", "BOLT-M8") == 4
+    assert inv.available("MAIN", "BOLT-M8") == 6
+
+
+def test_reserve_keeps_lines_as_given_across_warehouses(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("NORTH", "NUT-M8", 5)
+    lines = [("NORTH", "NUT-M8", 2), ReservationLine("MAIN", "BOLT-M8", 1)]
+    reservation = inv.reserve("SO-2", lines, ttl=timedelta(minutes=5))
+    assert reservation.lines == (
+        ReservationLine("NORTH", "NUT-M8", 2),
+        ReservationLine("MAIN", "BOLT-M8", 1),
+    )
+    assert reservation.expires_at == T0 + timedelta(minutes=5)
+
+
+def test_same_position_in_several_lines_is_summed(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-3", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 2)])
+    assert inv.reserved("MAIN", "BOLT-M8") == 4
+    with pytest.raises(InsufficientStockError) as info:
+        inv.reserve("SO-4", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 2)])
+    assert (info.value.requested, info.value.available) == (4, 1)
+
+
+def test_reserve_insufficient_changes_nothing(inv):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    events_before = len(inv.log)
+    with pytest.raises(InsufficientStockError):
+        inv.reserve("SO-5", [("MAIN", "BOLT-M8", 1), ("MAIN", "BOLT-M8", 9)])
+    assert len(inv.log) == events_before
+    with pytest.raises(ReservationNotFoundError):
+        inv.get_reservation("SO-5")
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), timedelta(minutes=-1), 900, "15m"])
+def test_reserve_rejects_bad_ttl(inv, ttl):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-6", [("MAIN", "BOLT-M8", 1)], ttl=ttl)
+
+
+@pytest.mark.parametrize("lines", [[], iter([])])
+def test_reserve_rejects_empty_order(inv, lines):
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-7", lines)
+
+
+def test_reserve_rejects_bad_order_id_and_unknown_sku(inv):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    with pytest.raises(ValidationError):
+        inv.reserve("SO 7", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(UnknownSkuError):
+        inv.reserve("SO-7", [("MAIN", "NOPE", 1)])
+
+
+def test_reserved_and_available_for_unknown_sku(inv):
+    with pytest.raises(UnknownSkuError):
+        inv.reserved("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        inv.available("MAIN", "NOPE")
+
+
+def test_duplicate_reserve_while_active_or_confirmed(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-8", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(DuplicateReservationError) as info:
+        inv.reserve("SO-8", [("MAIN", "BOLT-M8", 1)])
+    assert info.value.order_id == "SO-8"
+    inv.confirm("SO-8")
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-8", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_replaces_cancelled_reservation(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-9", [("MAIN", "BOLT-M8", 4)])
+    inv.cancel("SO-9")
+    reservation = inv.reserve("SO-9", [("MAIN", "BOLT-M8", 7)])
+    assert reservation.status is ReservationStatus.ACTIVE
+    assert inv.reserved("MAIN", "BOLT-M8") == 7
+
+
+def test_reserve_replaces_expired_reservation(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-10", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    reservation = inv.reserve("SO-10", [("MAIN", "BOLT-M8", 2)])
+    assert reservation.created_at == clock.now()
+    assert inv.reserved("MAIN", "BOLT-M8") == 2
+
+
+def test_reservation_expires_exactly_at_expires_at(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-11", [("MAIN", "BOLT-M8", 4)], ttl=timedelta(minutes=1))
+    clock.advance(timedelta(seconds=59))
+    assert inv.get_reservation("SO-11").status is ReservationStatus.ACTIVE
+    assert inv.reserved("MAIN", "BOLT-M8") == 4
+    clock.advance(timedelta(seconds=1))
+    assert inv.get_reservation("SO-11").status is ReservationStatus.EXPIRED
+    assert inv.reserved("MAIN", "BOLT-M8") == 0
+    assert inv.available("MAIN", "BOLT-M8") == 10
+    assert [e.kind for e in inv.log.events()] == ["RECEIVE", "RESERVE"]
+
+
+def test_expired_reservation_cannot_be_confirmed_or_extended(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-12", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    with pytest.raises(ReservationExpiredError) as info:
+        inv.confirm("SO-12")
+    assert info.value.order_id == "SO-12"
+    with pytest.raises(ReservationExpiredError):
+        inv.extend("SO-12", timedelta(minutes=5))
+    assert inv.on_hand("MAIN", "BOLT-M8") == 10
+
+
+def test_confirm_issues_each_line_and_logs(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("NORTH", "BOLT-M8", 5)
+    inv.reserve("SO-13", [("MAIN", "BOLT-M8", 2), ("NORTH", "BOLT-M8", 3)])
+    confirmed = inv.confirm("SO-13")
+    assert confirmed.status is ReservationStatus.CONFIRMED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 3
+    assert inv.on_hand("NORTH", "BOLT-M8") == 2
+    assert inv.reserved("MAIN", "BOLT-M8") == 0
+    issues = inv.log.events("ISSUE")
+    assert [(e.get("wh"), e.get("qty"), e.get("ref")) for e in issues] == [
+        ("MAIN", "2", "SO-13"),
+        ("NORTH", "3", "SO-13"),
+    ]
+    assert inv.log.events()[-1].kind == "RESERVE_CONFIRM"
+    assert inv.log.events()[-1].get("order") == "SO-13"
+
+
+def test_confirm_works_with_zero_available(inv):
+    inv.receive("MAIN", "BOLT-M8", 4)
+    inv.reserve("SO-14", [("MAIN", "BOLT-M8", 4)])
+    assert inv.available("MAIN", "BOLT-M8") == 0
+    inv.confirm("SO-14")
+    assert inv.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_and_cancel_states(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-15", [("MAIN", "BOLT-M8", 1)])
+    inv.reserve("SO-16", [("MAIN", "BOLT-M8", 1)])
+    inv.cancel("SO-16")
+    with pytest.raises(ReservationStateError):
+        inv.confirm("SO-16")
+    inv.confirm("SO-15")
+    with pytest.raises(ReservationStateError):
+        inv.confirm("SO-15")
+    with pytest.raises(ReservationStateError):
+        inv.cancel("SO-15")
+    with pytest.raises(ReservationStateError):
+        inv.extend("SO-15", timedelta(minutes=5))
+
+
+def test_confirm_fails_when_physical_stock_dropped(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-17", [("MAIN", "BOLT-M8", 4)])
+    inv.adjust("MAIN", "BOLT-M8", 2, "recount")
+    assert inv.available("MAIN", "BOLT-M8") == 0
+    events_before = len(inv.log)
+    with pytest.raises(InsufficientStockError) as info:
+        inv.confirm("SO-17")
+    assert (info.value.requested, info.value.available) == (4, 2)
+    assert inv.on_hand("MAIN", "BOLT-M8") == 2
+    assert inv.get_reservation("SO-17").status is ReservationStatus.ACTIVE
+    assert len(inv.log) == events_before
+
+
+def test_cancel_is_idempotent_and_writes_once(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-18", [("MAIN", "BOLT-M8", 5)])
+    assert inv.cancel("SO-18").status is ReservationStatus.CANCELLED
+    events_after_first = len(inv.log)
+    assert inv.cancel("SO-18").status is ReservationStatus.CANCELLED
+    assert len(inv.log) == events_after_first
+    assert inv.available("MAIN", "BOLT-M8") == 5
+
+
+def test_cancel_expired_is_noop_and_stays_expired(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-19", [("MAIN", "BOLT-M8", 5)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    events_before = len(inv.log)
+    assert inv.cancel("SO-19").status is ReservationStatus.EXPIRED
+    assert inv.get_reservation("SO-19").status is ReservationStatus.EXPIRED
+    assert len(inv.log) == events_before
+
+
+def test_extend_moves_expiry_from_now(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-20", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=10))
+    clock.advance(timedelta(minutes=5))
+    extended = inv.extend("SO-20", timedelta(minutes=15))
+    assert extended.expires_at == T0 + timedelta(minutes=20)
+    assert inv.log.events("RESERVE_EXTEND")[0].get("expires") == "2026-03-01T10:20:00Z"
+
+
+def test_extend_never_shortens(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-21", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=30))
+    events_before = len(inv.log)
+    assert inv.extend("SO-21", timedelta(minutes=10)).expires_at == T0 + timedelta(minutes=30)
+    assert len(inv.log) == events_before
+
+
+def test_extend_rejects_bad_ttl(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-22", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        inv.extend("SO-22", timedelta(0))
+
+
+@pytest.mark.parametrize("call", [
+    lambda inv: inv.confirm("NOPE"),
+    lambda inv: inv.cancel("NOPE"),
+    lambda inv: inv.extend("NOPE", timedelta(minutes=1)),
+    lambda inv: inv.get_reservation("NOPE"),
+])
+def test_missing_reservation_raises_not_found(inv, call):
+    with pytest.raises(ReservationNotFoundError) as info:
+        call(inv)
+    assert info.value.order_id == "NOPE"
+    assert isinstance(info.value, ReservationError)
+
+
+def test_issue_cannot_take_reserved_stock(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-23", [("MAIN", "BOLT-M8", 6)])
+    with pytest.raises(InsufficientStockError) as info:
+        inv.issue("MAIN", "BOLT-M8", 5)
+    assert (info.value.requested, info.value.available) == (5, 4)
+    assert inv.issue("MAIN", "BOLT-M8", 4) == 6
+    assert inv.available("MAIN", "BOLT-M8") == 0
+
+
+def test_transfer_cannot_take_reserved_stock(inv):
+    inv.receive("MAIN", "OIL-5L", 4)
+    inv.reserve("SO-24", [("MAIN", "OIL-5L", 3)])
+    with pytest.raises(InsufficientStockError):
+        inv.transfer("MAIN", "NORTH", "OIL-5L", 2)
+    assert inv.on_hand("NORTH", "OIL-5L") == 0
+
+
+def test_adjust_below_reserved_clamps_available_to_zero(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-25", [("MAIN", "BOLT-M8", 8)])
+    inv.adjust("MAIN", "BOLT-M8", 3, "recount")
+    assert inv.available("MAIN", "BOLT-M8") == 0
+    assert inv.reserved("MAIN", "BOLT-M8") == 8
+    assert inv.on_hand("MAIN", "BOLT-M8") == 3
+
+
+def test_get_reservation_returns_snapshot(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    snapshot = inv.reserve("SO-26", [("MAIN", "BOLT-M8", 2)])
+    inv.cancel("SO-26")
+    assert snapshot.status is ReservationStatus.ACTIVE
+    assert inv.get_reservation("SO-26").status is ReservationStatus.CANCELLED
