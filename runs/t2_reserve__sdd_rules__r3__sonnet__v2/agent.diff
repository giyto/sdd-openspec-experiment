index 0000000..35ca54b
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,475 @@
+import inspect
+from dataclasses import FrozenInstanceError
+from datetime import timedelta
+
+import pytest
+
+import warehouse
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    Inventory,
+    Reservation,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationLine,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ReservationStatus,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+    parse_line,
+)
+from warehouse.reservations import validate_ttl
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "BOLT-M8", 10)
+    return inv
+
+
+# --- модели, ошибки, константы ------------------------------------------------
+
+
+def test_status_values_and_immutability():
+    assert [s.value for s in ReservationStatus] == ["active", "expired", "confirmed", "cancelled"]
+    line = ReservationLine("A", "S", 1)
+    with pytest.raises(FrozenInstanceError):
+        line.qty = 2  # type: ignore[misc]
+
+
+def test_errors_hierarchy():
+    for cls in (
+        ReservationNotFoundError,
+        ReservationExpiredError,
+        DuplicateReservationError,
+    ):
+        err = cls("SO-1")
+        assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+        assert err.order_id == "SO-1"
+    err = ReservationStateError("SO-1", "confirmed")
+    assert isinstance(err, ReservationError) and err.order_id == "SO-1"
+
+
+def test_default_ttl_and_validate_ttl():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+    assert validate_ttl(MIN) == MIN
+    for bad in (timedelta(0), -MIN, 5, None):
+        with pytest.raises(ValidationError):
+            validate_ttl(bad)
+
+
+# --- reserve ---------------------------------------------------------------------
+
+
+def test_reserve_multiple_warehouses(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ReservationLine("NORTH", "BOLT-M8", 3)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.lines == (
+        ReservationLine("MAIN", "BOLT-M8", 2),
+        ReservationLine("NORTH", "BOLT-M8", 3),
+    )
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + timedelta(minutes=15)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.on_hand("NORTH", "BOLT-M8") == 10
+
+
+def test_reserve_custom_ttl(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    assert res.expires_at == clock.now() + 5 * MIN
+
+
+def test_reserve_insufficient_leaves_no_trace(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("NORTH", "BOLT-M8", 11)])
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_reserve_duplicate_lines_checked_by_sum(stocked):
+    stocked.adjust("MAIN", "BOLT-M8", 5, "count")
+    lines = [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 4)]
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", lines)
+    assert exc.value.requested == 7 and exc.value.available == 5
+    stocked.adjust("MAIN", "BOLT-M8", 7, "count")
+    res = stocked.reserve("SO-1", lines)
+    assert [l.qty for l in res.lines] == [3, 4]
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"ttl": timedelta(0)},
+        {"ttl": -MIN},
+        {"ttl": 60},
+        {"lines": []},
+        {"order_id": "SO 1"},
+        {"order_id": ""},
+        {"lines": [("MA IN", "BOLT-M8", 1)]},
+        {"lines": [("MAIN", "BO=LT", 1)]},
+        {"lines": [("MAIN", "BOLT-M8")]},
+    ],
+)
+def test_reserve_validation(stocked, kwargs):
+    args = {"order_id": "SO-1", "lines": [("MAIN", "BOLT-M8", 1)], "ttl": None}
+    args.update(kwargs)
+    before = len(stocked.log)
+    with pytest.raises(ValidationError):
+        stocked.reserve(**args)
+    assert len(stocked.log) == before
+
+
+def test_reserve_bad_qty_and_unknown_sku(stocked):
+    for qty in (0, -1, True, 1.5):
+        with pytest.raises(InvalidQuantityError):
+            stocked.reserve("SO-1", [("MAIN", "BOLT-M8", qty)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("MAIN", "NOPE", 1)])
+
+
+# --- повторный reserve ---------------------------------------------------------------
+
+
+def test_duplicate_active_and_confirmed(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(DuplicateReservationError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert exc.value.order_id == "SO-1"
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+@pytest.mark.parametrize("how", ["expire", "cancel"])
+def test_replace_expired_or_cancelled(stocked, clock, how):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    if how == "expire":
+        clock.advance(20 * MIN)
+    else:
+        stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("NORTH", "BOLT-M8", 4)])
+    assert stocked.get_reservation("SO-1") == res
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.lines == (ReservationLine("NORTH", "BOLT-M8", 4),)
+
+
+def test_failed_replacement_keeps_old(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(20 * MIN)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 99)])
+    old = stocked.get_reservation("SO-1")
+    assert old.status is ReservationStatus.EXPIRED
+    assert old.lines == (ReservationLine("MAIN", "BOLT-M8", 1),)
+
+
+# --- available / reserved -----------------------------------------------------------
+
+
+def test_reserved_available(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert (stocked.reserved("MAIN", "BOLT-M8"), stocked.available("MAIN", "BOLT-M8")) == (4, 6)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.stock_levels("MAIN")[0].on_hand == 10
+    assert stocked.available("MAIN", "NUT-M8") == 0
+    with pytest.raises(UnknownSkuError):
+        stocked.available("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("MAIN", "NOPE")
+
+
+def test_adjust_below_reserve(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.adjust("MAIN", "BOLT-M8", 3, "count")
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+
+
+@pytest.mark.parametrize("how", ["confirm", "cancel", "expire"])
+def test_inactive_reservations_not_counted(stocked, clock, how):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    if how == "expire":
+        clock.advance(15 * MIN)
+    else:
+        getattr(stocked, how)("SO-1")
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.available("MAIN", "BOLT-M8") == stocked.on_hand("MAIN", "BOLT-M8")
+
+
+# --- истечение ------------------------------------------------------------------------
+
+
+def test_expiry_boundary_and_log(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(15 * MIN - timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    clock.advance(timedelta(seconds=1))
+    before = len(stocked.log)
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert len(stocked.log) == before
+
+
+def test_confirmed_stays_confirmed_after_deadline(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    clock.advance(timedelta(hours=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+
+
+# --- confirm ------------------------------------------------------------------------------
+
+
+def test_confirm_success_and_log(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("NORTH", "BOLT-M8", 1)])
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 8
+    assert stocked.on_hand("NORTH", "BOLT-M8") == 9
+    events = stocked.log.events()[-3:]
+    assert [e.kind for e in events] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert events[0].get("ref") == "SO-1" and events[1].get("ref") == "SO-1"
+    assert events[2].get("order") == "SO-1"
+
+
+def test_confirm_with_zero_available(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    stocked.confirm("SO-1")
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_physical_shortage_changes_nothing(stocked):
+    stocked.reserve("SO-1", [("NORTH", "BOLT-M8", 1), ("MAIN", "BOLT-M8", 5)])
+    stocked.adjust("MAIN", "BOLT-M8", 4, "count")
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.confirm("SO-1")
+    assert exc.value.available == 4
+    assert len(stocked.log) == before
+    assert stocked.on_hand("NORTH", "BOLT-M8") == 10
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+
+
+def test_confirm_duplicate_lines(stocked):
+    stocked.adjust("MAIN", "BOLT-M8", 7, "count")
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 4)])
+    stocked.adjust("MAIN", "BOLT-M8", 6, "count")
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    stocked.adjust("MAIN", "BOLT-M8", 7, "count")
+    n = len(stocked.log)
+    stocked.confirm("SO-1")
+    assert [e.kind for e in stocked.log.events()[n:]] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_bad_statuses(stocked, clock):
+    stocked.reserve("E", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("C", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("X", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("C")
+    stocked.cancel("X")
+    clock.advance(20 * MIN)
+    stocked.reserve("N", [("MAIN", "BOLT-M8", 1)])
+    before = len(stocked.log)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("E")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("C")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("X")
+    assert len(stocked.log) == before
+
+
+# --- cancel ---------------------------------------------------------------------------------
+
+
+def test_cancel_active_idempotent(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert [e.kind for e in stocked.log.events()[n:]] == ["RESERVE_CANCEL"]
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == n + 1
+
+
+def test_cancel_expired_stays_expired(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(20 * MIN)
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == n
+
+
+def test_cancel_confirmed(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-1")
+
+
+# --- extend ---------------------------------------------------------------------------------
+
+
+def test_extend(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(10 * MIN)
+    n = len(stocked.log)
+    res = stocked.extend("SO-1", 15 * MIN)
+    assert res.expires_at == clock.now() + 15 * MIN
+    (event,) = stocked.log.events()[n:]
+    assert event.kind == "RESERVE_EXTEND" and event.get("order") == "SO-1"
+    assert event.get("expires") == "2026-03-01T10:25:00Z"
+
+
+def test_extend_never_shortens(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    n = len(stocked.log)
+    assert stocked.extend("SO-1", MIN) == res
+    assert stocked.extend("SO-1", 15 * MIN) == res
+    assert len(stocked.log) == n
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 15, None])
+def test_extend_bad_ttl(stocked, ttl):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", ttl)
+
+
+def test_extend_bad_statuses(stocked, clock):
+    stocked.reserve("E", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("C", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("X", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("C")
+    stocked.cancel("X")
+    clock.advance(20 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("E", MIN)
+    with pytest.raises(ReservationStateError):
+        stocked.extend("C", MIN)
+    with pytest.raises(ReservationStateError):
+        stocked.extend("X", MIN)
+
+
+# --- not found / снимки -------------------------------------------------------------------------
+
+
+def test_not_found(inv):
+    for call in (
+        lambda: inv.confirm("NOPE"),
+        lambda: inv.cancel("NOPE"),
+        lambda: inv.extend("NOPE", MIN),
+        lambda: inv.get_reservation("NOPE"),
+    ):
+        with pytest.raises(ReservationNotFoundError) as exc:
+            call()
+        assert exc.value.order_id == "NOPE"
+
+
+def test_snapshots_are_immutable(stocked):
+    snap = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-1")
+    assert snap.status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CANCELLED
+    with pytest.raises(FrozenInstanceError):
+        snap.status = ReservationStatus.CANCELLED  # type: ignore[misc]
+
+
+def test_shared_store_shares_reservations(stocked, clock):
+    other = Inventory(store=stocked.store, clock=clock)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert other.reserved("MAIN", "BOLT-M8") == 4
+
+
+# --- issue / transfer ------------------------------------------------------------------------------
+
+
+def test_issue_respects_reservations(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 3)
+    assert exc.value.available == 2
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10 and len(stocked.log) == n
+    assert stocked.issue("MAIN", "BOLT-M8", 2) == 8
+    clock.advance(20 * MIN)
+    assert stocked.issue("MAIN", "BOLT-M8", 8) == 0
+
+
+def test_transfer_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("MAIN", "SOUTH", "BOLT-M8", 3)
+    stocked.transfer("MAIN", "SOUTH", "BOLT-M8", 2)
+    assert stocked.on_hand("SOUTH", "BOLT-M8") == 2
+
+
+def test_no_reservations_unchanged(stocked):
+    assert stocked.issue("MAIN", "BOLT-M8", 10) == 0
+    with pytest.raises(InsufficientStockError):
+        stocked.issue("MAIN", "BOLT-M8", 1)
+
+
+# --- журнал ------------------------------------------------------------------------------------------
+
+
+def test_log_lines_format(stocked):
+    n = len(stocked.log)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("NORTH", "BOLT-M8", 3)])
+    stocked.extend("SO-1", 30 * MIN)
+    stocked.cancel("SO-1")
+    lines = stocked.log.lines()[n:]
+    assert lines[0] == (
+        "%06d 2026-03-01T10:00:00Z RESERVE expires=2026-03-01T10:15:00Z "
+        "order=SO-1 qty=2 sku=BOLT-M8 wh=MAIN" % (n + 1)
+    )
+    assert lines[1].endswith("qty=3 sku=BOLT-M8 wh=NORTH")
+    assert lines[2].endswith("RESERVE_EXTEND expires=2026-03-01T10:30:00Z order=SO-1")
+    assert lines[3].endswith("RESERVE_CANCEL order=SO-1")
+    for line in lines:
+        assert parse_line(line).format() == line
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    assert stocked.log.lines()[-1].endswith("RESERVE_CONFIRM order=SO-2")
+
+
+# --- публичный API -----------------------------------------------------------------------------------
+
+
+def test_public_api_signatures():
+    sig = lambda f: str(inspect.signature(f))
+    assert list(inspect.signature(Inventory.reserve).parameters) == ["self", "order_id", "lines", "ttl"]
+    assert inspect.signature(Inventory.reserve).parameters["ttl"].default is None
+    assert list(inspect.signature(Inventory.extend).parameters) == ["self", "order_id", "ttl"]
+    for name in ("confirm", "cancel", "get_reservation"):
+        assert list(inspect.signature(getattr(Inventory, name)).parameters) == ["self", "order_id"]
+    for name in ("available", "reserved"):
+        assert list(inspect.signature(getattr(Inventory, name)).parameters) == [
+            "self", "warehouse", "sku"
+        ]
+    assert list(Reservation.__dataclass_fields__) == [
+        "order_id", "lines", "created_at", "expires_at", "status"
+    ]
+    assert list(ReservationLine.__dataclass_fields__) == ["warehouse", "sku", "qty"]
+    for name in (
+        "Reservation", "ReservationLine", "ReservationStatus", "ReservationError",
+        "ReservationNotFoundError", "ReservationExpiredError", "ReservationStateError",
+        "DuplicateReservationError", "DEFAULT_RESERVATION_TTL",
+    ):
+        assert name in warehouse.__all__ and hasattr(warehouse, name)
+    assert sig  # keep linters quiet
