+# -- 2.3 is_retryable ---------------------------------------------------------
+
+
+def test_subclass_of_non_retryable_is_not_retryable():
+    class Strict(ValueError):
+        pass
+
+    policy = RetryPolicy(non_retryable=(ValueError,))
+    assert not policy.is_retryable(Strict("bad"))
+    assert policy.is_retryable(ConnectionError("timeout"))
+
+
+def test_permanent_error_is_not_retryable():
+    policy = RetryPolicy(non_retryable=())
+    assert not policy.is_retryable(PermanentJobError("card declined"))
