index 0000000..a8250e9
--- /dev/null
+++ b/jobq/retry.py
@@ -0,0 +1,100 @@
+"""Политика повторов упавших заданий: задержка с экспоненциальным ростом и признак повторяемости.
+
+Политика — неизменяемое значение без состояния. Решение о переходе задания
+принимает воркер (см. :class:`~jobq.worker.Worker`), а не политика.
+"""
+
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+from numbers import Real
+
+from .errors import ConfigError, PermanentJobError
+
+# Используется, когда ``rng`` не передан, а джиттер положительный. Не засеивается,
+# поэтому задержка недетерминирована только в этом случае.
+_DEFAULT_RNG = random.Random()
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Правила повторов для заданий.
+
+    :param max_attempts: сколько всего попыток допускается (включая первую).
+    :param base_delay: задержка в секундах после первой неудачи.
+    :param factor: множитель задержки между соседними попытками.
+    :param max_delay: верхняя граница задержки в секундах.
+    :param jitter: доля случайного разброса задержки, от 0 до 1.
+    :param non_retryable: классы исключений, при которых повтор не делается.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.max_attempts, int) or isinstance(self.max_attempts, bool):
+            raise ConfigError("max_attempts must be an integer")
+        if self.max_attempts < 1:
+            raise ConfigError("max_attempts must be at least 1")
+
+        for name in ("base_delay", "factor", "max_delay", "jitter"):
+            value = getattr(self, name)
+            if not isinstance(value, Real) or isinstance(value, bool):
+                raise ConfigError(f"{name} must be a number")
+            if not math.isfinite(value):
+                raise ConfigError(f"{name} must be finite")
+
+        if self.base_delay < 0:
+            raise ConfigError("base_delay must be non-negative")
+        if self.factor < 1:
+            raise ConfigError("factor must be at least 1")
+        if self.max_delay < self.base_delay:
+            raise ConfigError("max_delay must not be less than base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be between 0 and 1")
+
+        try:
+            non_retryable = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be an iterable of exception classes") from None
+        for item in non_retryable:
+            if not (isinstance(item, type) and issubclass(item, BaseException)):
+                raise ConfigError(f"non_retryable element {item!r} is not an exception class")
+        # Список приводим к кортежу: политика неизменяема и должна быть хешируемой.
+        object.__setattr__(self, "non_retryable", non_retryable)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка в секундах перед следующей попыткой после неудачной попытки ``attempt``.
+
+        Нумерация попыток начинается с 1. Результат всегда лежит в ``[0, max_delay]``.
+        ``rng`` используется ровно один раз и только при ``jitter > 0``.
+        """
+        if attempt < 1:
+            raise ConfigError("attempt must be at least 1")
+
+        if self.base_delay == 0:
+            capped = 0.0
+        else:
+            try:
+                raw = self.base_delay * self.factor ** (attempt - 1)
+            except OverflowError:
+                raw = math.inf
+            capped = min(raw, self.max_delay)
+
+        if self.jitter > 0:
+            generator = rng if rng is not None else _DEFAULT_RNG
+            capped *= generator.uniform(1 - self.jitter, 1 + self.jitter)
+
+        return min(capped, self.max_delay)
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """Можно ли повторить задание, которое упало с ``exc``. Число попыток не учитывается."""
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
