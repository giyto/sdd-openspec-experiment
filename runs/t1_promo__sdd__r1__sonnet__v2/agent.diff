+++ b/tests/test_pricing_promo.py
@@ -0,0 +1,149 @@
+from decimal import Decimal
+from itertools import product as iproduct
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import EmptyCartError, PromoConditionsError
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def pct(value="10", **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("P", DiscountKind.FIXED, D(value), **kw)
+
+
+def make_cart(*items):
+    cart = Cart()
+    for i, (price, category, qty) in enumerate(items):
+        cart.add(Product(f"SKU-{i}", f"Item {i}", D(price), category), qty)
+    return cart
+
+
+def cart_base(cart):
+    return sum((line.amount for line in cart.lines), D("0.00"))
+
+
+def test_no_promo_zero_discount(products):
+    cart = Cart()
+    cart.add(products["book"])
+    total = calculate_total(cart)
+    assert total.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in total.lines)
+    assert total.total == D("794.00")
+
+
+def test_excluded_and_gift_outside_base_and_minimum():
+    cart = make_cart(
+        ("1000.00", Category.ELECTRONICS, 1),
+        ("500.00", Category.GIFT_CARD, 1),
+        ("200.00", Category.FOOD, 1),
+    )
+    promo = pct("10", excluded_categories=frozenset({Category.FOOD}), min_order_amount=D("1000"))
+    total = calculate_total(cart, promo=promo)
+    assert total.discount == D("100.00")
+    assert [line.discount for line in total.lines] == [D("100.00"), D("0.00"), D("0.00")]
+
+
+def test_percent_half_up():
+    total = calculate_total(make_cart(("10.05", Category.CLOTHING, 1)), promo=pct("10"))
+    assert total.discount == D("1.01")
+
+
+def test_fixed_capped():
+    total = calculate_total(make_cart(("300.00", Category.CLOTHING, 1)), promo=fixed("500"))
+    assert total.discount == D("300.00")
+
+
+def test_hundred_percent_zero_tax():
+    total = calculate_total(make_cart(("300.00", Category.CLOTHING, 1)), promo=pct("100"))
+    assert total.discount == D("300.00")
+    assert total.tax == D("0.00")
+
+
+def test_minimum_inclusive():
+    cart = make_cart(("1000.00", Category.CLOTHING, 1))
+    calculate_total(cart, promo=pct(min_order_amount=D("1000.00")))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(min_order_amount=D("1000.01")))
+
+
+def test_gift_card_not_counted_in_minimum():
+    cart = make_cart(("999.99", Category.CLOTHING, 1), ("500.00", Category.GIFT_CARD, 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(min_order_amount=D("1000.00")))
+
+
+def test_no_participating_lines():
+    cart = make_cart(("500.00", Category.GIFT_CARD, 1), ("10.00", Category.FOOD, 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(excluded_categories=frozenset({Category.FOOD})))
+
+
+def test_empty_cart_with_promo():
+    with pytest.raises(EmptyCartError):
+        calculate_total(Cart(), promo=pct())
+
+
+def test_split_extra_kopeck_goes_first():
+    cart = make_cart(*[("10.00", Category.CLOTHING, 1)] * 3)
+    total = calculate_total(cart, promo=fixed("1.00"))
+    assert [line.discount for line in total.lines] == [D("0.34"), D("0.33"), D("0.33")]
+
+
+def test_split_largest_remainder():
+    cart = make_cart(("1.00", Category.CLOTHING, 1), ("2.00", Category.CLOTHING, 1))
+    total = calculate_total(cart, promo=fixed("1.00"))
+    assert [line.discount for line in total.lines] == [D("0.33"), D("0.67")]
+
+
+def test_split_skips_gift_card_between():
+    cart = make_cart(
+        ("10.00", Category.CLOTHING, 1),
+        ("10.00", Category.GIFT_CARD, 1),
+        ("10.00", Category.CLOTHING, 1),
+    )
+    total = calculate_total(cart, promo=fixed("0.01"))
+    assert [line.discount for line in total.lines] == [D("0.01"), D("0.00"), D("0.00")]
+
+
+def test_split_sums_exactly():
+    prices = ["0.01", "0.07", "3.33", "10.00", "19.99"]
+    for fixed_value, combo in iproduct(["0.01", "0.99", "1.00", "5.55", "33.33"], range(1, 32)):
+        items = [(prices[i], Category.CLOTHING, 1 + i) for i in range(5) if combo >> i & 1]
+        cart = make_cart(*items)
+        total = calculate_total(cart, promo=fixed(fixed_value))
+        expected = min(D(fixed_value), cart_base(cart))
+        assert sum(line.discount for line in total.lines) == total.discount == expected
+        assert all(line.discount <= line.amount for line in total.lines)
+    for value in ["7", "33.33", "99.99", "100"]:
+        cart = make_cart(("0.03", Category.CLOTHING, 1), ("12.34", Category.BOOKS, 3))
+        total = calculate_total(cart, promo=pct(value))
+        assert sum(line.discount for line in total.lines) == total.discount
+
+
+def test_tax_after_discount():
+    cart = make_cart(("100.00", Category.CLOTHING, 1))
+    total = calculate_total(cart, promo=fixed("10.00"))
+    assert total.lines[0].tax == D("18.00")
+    assert total.lines[0].amount == D("100.00")
+    assert total.subtotal == D("100.00")
+    assert total.total == D("100.00") - D("10.00") + total.shipping + D("18.00")
+
+
+def test_shipping_by_discounted_amount():
+    cart = make_cart(("3100.00", Category.CLOTHING, 1))
+    assert calculate_total(cart, promo=fixed("200.00")).shipping == D("299.00")
+    assert calculate_total(cart, promo=fixed("100.00")).shipping == D("0.00")
+    assert calculate_total(cart).shipping == D("0.00")
+
+
+def test_digital_only_no_shipping():
+    cart = make_cart(("100.00", Category.GIFT_CARD, 1))
+    assert calculate_total(cart, ShippingPolicy()).shipping == D("0.00")
diff --git a/tests/test_promo.py b/tests/test_promo.py
new file mode 100644
index 0000000..8a2bf04
--- /dev/null
+++ b/tests/test_promo.py
@@ -0,0 +1,160 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+UTC = timezone.utc
+T0 = datetime(2026, 3, 1, 12, 0, tzinfo=UTC)
+
+
+def pct(code="SUMMER10", value="10", **kw):
+    return PromoCode(code, DiscountKind.PERCENT, Decimal(value), **kw)
+
+
+def test_error_hierarchy():
+    leaves = (UnknownPromoCodeError, PromoExpiredError, PromoConditionsError)
+    assert issubclass(PromoError, ShopError)
+    for cls in leaves:
+        assert issubclass(cls, PromoError)
+        for other in leaves:
+            if other is not cls:
+                assert not issubclass(cls, other)
+
+
+@pytest.mark.parametrize("value", ["0", "100.01", "-1", "NaN"])
+def test_percent_out_of_range(value):
+    with pytest.raises(ValidationError):
+        pct(value=value)
+
+
+def test_percent_100_ok():
+    assert pct(value="100").value == Decimal("100")
+
+
+@pytest.mark.parametrize("value", ["0", "-5", "10.005"])
+def test_fixed_invalid(value):
+    with pytest.raises(ValidationError):
+        PromoCode("X", DiscountKind.FIXED, Decimal(value))
+
+
+def test_float_value_rejected():
+    with pytest.raises(ValidationError):
+        PromoCode("X", DiscountKind.FIXED, 10.0)
+
+
+@pytest.mark.parametrize("uses", [0, -1, True])
+def test_invalid_max_uses(uses):
+    with pytest.raises(ValidationError):
+        pct(max_uses=uses)
+
+
+def test_invalid_interval():
+    with pytest.raises(ValidationError):
+        pct(starts_at=T0, expires_at=T0)
+    with pytest.raises(ValidationError):
+        pct(starts_at=T0 + timedelta(days=1), expires_at=T0)
+    with pytest.raises(ValidationError):
+        pct(starts_at=datetime(2026, 1, 1))
+    with pytest.raises(ValidationError):
+        pct(expires_at=datetime(2026, 1, 1))
+
+
+@pytest.mark.parametrize("code", ["", "   "])
+def test_empty_code(code):
+    with pytest.raises(ValidationError):
+        pct(code=code)
+
+
+def test_negative_minimum():
+    with pytest.raises(ValidationError):
+        pct(min_order_amount=Decimal("-1"))
+
+
+def test_resolve_normalizes():
+    reg = PromoRegistry(FixedClock(T0))
+    reg.add(pct(code="summer10"))
+    assert reg.resolve("  Summer10 ").code == "SUMMER10"
+    assert reg.uses(" summer10") == 0
+
+
+def test_duplicate_rejected():
+    reg = PromoRegistry(FixedClock(T0))
+    first = pct(code="SUMMER10")
+    reg.add(first)
+    with pytest.raises(ValidationError):
+        reg.add(pct(code="summer10 ", value="20"))
+    assert reg.resolve("SUMMER10") is first
+
+
+@pytest.mark.parametrize("code", ["NOPE", ""])
+def test_unknown(code):
+    with pytest.raises(UnknownPromoCodeError):
+        PromoRegistry(FixedClock(T0)).resolve(code)
+
+
+def test_uses_unknown():
+    with pytest.raises(UnknownPromoCodeError):
+        PromoRegistry(FixedClock(T0)).uses("NOPE")
+
+
+def test_validity_bounds():
+    clock = FixedClock(T0)
+    reg = PromoRegistry(clock, [pct(starts_at=T0, expires_at=T0 + timedelta(days=1))])
+    reg.resolve("SUMMER10")
+    clock.set(T0 - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+    clock.set(T0 + timedelta(days=1) - timedelta(microseconds=1))
+    reg.resolve("SUMMER10")
+    clock.set(T0 + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_expiry_beats_limit():
+    clock = FixedClock(T0)
+    reg = PromoRegistry(clock, [pct(max_uses=1, expires_at=T0 + timedelta(days=1))])
+    reg.redeem("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("SUMMER10")
+    clock.advance(timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_resolve_does_not_count_and_redeem_release():
+    reg = PromoRegistry(FixedClock(T0), [pct(max_uses=2)])
+    reg.resolve("SUMMER10")
+    reg.resolve("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.redeem("SUMMER10")
+    reg.redeem("summer10")
+    assert reg.uses("SUMMER10") == 2
+    with pytest.raises(PromoConditionsError):
+        reg.redeem("SUMMER10")
+    assert reg.uses("SUMMER10") == 2
+    reg.release("SUMMER10")
+    assert reg.uses("SUMMER10") == 1
+    reg.release("SUMMER10")
+    reg.release("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.release("UNKNOWN")
+
+
+def test_excluded_categories_and_gift_card():
+    promo = pct(excluded_categories=frozenset({Category.FOOD}))
+    assert promo.applies_to(Category.BOOKS)
+    assert not promo.applies_to(Category.FOOD)
+    assert not promo.applies_to(Category.GIFT_CARD)
