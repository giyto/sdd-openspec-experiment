+++ b/tests/test_orders_promo.py
@@ -0,0 +1,142 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+def setup(clock, **promo_kw):
+    promo = PromoCode("SUMMER10", DiscountKind.PERCENT, Decimal("10"), **promo_kw)
+    reg = PromoRegistry(clock, [promo])
+    return OrderService(clock=clock, promos=reg), reg
+
+
+def cart_of(products, *names):
+    cart = Cart()
+    for name in names:
+        cart.add(products[name])
+    return cart
+
+
+def test_place_order_with_code(clock, products):
+    service, reg = setup(clock)
+    order = service.place_order(cart_of(products, "shirt"), " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == Decimal("99.90")
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_without_code(clock, products):
+    service, reg = setup(clock)
+    order = service.place_order(cart_of(products, "book"))
+    assert order.promo_code is None
+    assert order.total.discount == Decimal("0.00")
+    assert order.total.total == Decimal("794.00")
+    assert reg.uses("SUMMER10") == 0
+
+
+@pytest.mark.parametrize("blank", [None, "", "   "])
+def test_blank_code_with_and_without_registry(clock, products, blank):
+    for service in (setup(clock)[0], OrderService(clock=clock)):
+        order = service.place_order(cart_of(products, "book"), blank)
+        assert order.promo_code is None
+        assert order.total.discount == Decimal("0.00")
+        assert service.quote(cart_of(products, "book"), blank).discount == Decimal("0.00")
+
+
+def test_no_registry_unknown(clock, products):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart_of(products, "book"), "SUMMER10")
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart_of(products, "book"), "SUMMER10")
+    assert len(service.store) == 0
+
+
+def test_quote_does_not_consume(clock, products):
+    service, reg = setup(clock, max_uses=1)
+    service.quote(cart_of(products, "shirt"), "SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def test_failures_have_no_side_effects(clock, products):
+    service, reg = setup(
+        clock, min_order_amount=Decimal("5000"), expires_at=clock.now() + timedelta(days=1)
+    )
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_of(products, "shirt"), "SUMMER10")
+    assert (len(service.store), reg.uses("SUMMER10")) == (0, 0)
+    assert service.store.next_id() == "ORD-000001"
+    clock.advance(timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        service.place_order(cart_of(products, "shirt"), "SUMMER10")
+    assert (len(service.store), reg.uses("SUMMER10")) == (0, 0)
+
+
+def test_limit_before_conditions(clock, products):
+    service, reg = setup(clock, max_uses=1, min_order_amount=Decimal("1000"))
+    service.place_order(cart_of(products, "phone"), "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_of(products, "tea"), "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart_of(products, "phone"), "SUMMER10")
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_expiry_before_conditions(clock, products):
+    service, _ = setup(
+        clock, min_order_amount=Decimal("5000"), expires_at=clock.now() - timedelta(days=1)
+    )
+    with pytest.raises(PromoExpiredError):
+        service.quote(cart_of(products, "tea"), "SUMMER10")
+
+
+def test_cancel_releases(clock, products):
+    service, reg = setup(clock, max_uses=1)
+    order = service.place_order(cart_of(products, "shirt"), "SUMMER10")
+    service.cancel(order.order_id)
+    assert reg.uses("SUMMER10") == 0
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(order.order_id)
+    assert reg.uses("SUMMER10") == 0
+    service.place_order(cart_of(products, "shirt"), "SUMMER10")
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_cancel_without_code_keeps_counter(clock, products):
+    service, reg = setup(clock)
+    service.place_order(cart_of(products, "shirt"), "SUMMER10")
+    plain = service.place_order(cart_of(products, "book"))
+    service.cancel(plain.order_id)
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_cancel_after_expiry_releases(clock, products):
+    service, reg = setup(clock, expires_at=clock.now() + timedelta(days=1))
+    order = service.place_order(cart_of(products, "shirt"), "SUMMER10")
+    clock.advance(timedelta(days=5))
+    service.cancel(order.order_id)
+    assert reg.uses("SUMMER10") == 0
+
+
+def test_free_shipping_lost_after_discount(clock, products):
+    service, _ = setup(clock)
+    cart = Cart()
+    cart.add(products["phone"], 1)
+    cart.add(products["shirt"], 1)  # 3499.00 -> 3149.10 after 10 %, still free
+    assert service.quote(cart, "SUMMER10").shipping == Decimal("0.00")
+    cart = Cart()
+    cart.add(products["phone"], 1)
+    cart.add(products["tea"], 3)  # 3099.70 -> 2789.73 after 10 %, below threshold
+    assert service.quote(cart).shipping == Decimal("0.00")
+    assert service.quote(cart, "SUMMER10").shipping == Decimal("299.00")
diff --git a/tests/test_pricing_promo.py b/tests/test_pricing_promo.py
new file mode 100644
