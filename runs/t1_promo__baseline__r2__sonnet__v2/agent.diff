+def _allocate_discount(cart: Cart, promo: PromoCode) -> list[Decimal]:
+    """Per-line discounts (in cart order); their sum equals the total discount exactly."""
+    from .promo import DiscountKind
+
+    amounts = [
+        line.amount if promo.applies_to(line.product.category) else None for line in cart.lines
+    ]
+    if all(a is None for a in amounts):
+        raise PromoConditionsError(f"promo code {promo.code} has no eligible items in the cart")
+    base = sum_money(a for a in amounts if a is not None)
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"eligible amount {base} is below the minimum {promo.min_order_amount} "
+            f"for promo code {promo.code}"
+        )
+    if promo.kind is DiscountKind.PERCENT:
+        discount = quantize_money(base * promo.value / Decimal(100))
+    else:
+        discount = min(quantize_money(promo.value), base)
+
+    shares = [ZERO] * len(amounts)
+    remainders: list[tuple[Decimal, int]] = []
+    for i, amount in enumerate(amounts):
+        if amount is None:
+            continue
+        exact = discount * amount / base
+        floored = exact.quantize(CENT, rounding=ROUND_FLOOR)
+        shares[i] = floored
+        remainders.append((exact - floored, i))
+    leftover = int((discount - sum_money(shares)) / CENT)
+    remainders.sort(key=lambda r: (-r[0], r[1]))
+    for _, i in remainders[:leftover]:
+        shares[i] += CENT
+    return shares
+
