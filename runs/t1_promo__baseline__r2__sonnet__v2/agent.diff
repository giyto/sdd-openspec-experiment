diff --git a/shop/promo.py b/shop/promo.py
new file mode 100644
index 0000000..968f839
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,129 @@
+"""Promo codes and their registry."""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import to_money
+
+logger = logging.getLogger(__name__)
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _require_aware(at: datetime, name: str) -> None:
+    if at.tzinfo is None or at.utcoffset() is None:
+        raise ValidationError(f"{name} must be an aware datetime")
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = Decimal("0.00")
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = frozenset()
+
+    def __post_init__(self) -> None:
+        code = normalize_key(self.code)
+        if not code:
+            raise ValidationError("promo code must not be empty")
+        object.__setattr__(self, "code", code)
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError("promo kind must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError("promo value must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError("percent discount must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError("fixed discount must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError("fixed discount has more than two fractional digits")
+        if not isinstance(self.min_order_amount, Decimal) or not self.min_order_amount.is_finite():
+            raise ValidationError("min_order_amount must be a finite Decimal")
+        if self.min_order_amount < 0:
+            raise ValidationError("min_order_amount must not be negative")
+        if self.starts_at is not None:
+            _require_aware(self.starts_at, "starts_at")
+        if self.expires_at is not None:
+            _require_aware(self.expires_at, "expires_at")
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError("starts_at must be earlier than expires_at")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool)
+            or not isinstance(self.max_uses, int)
+            or self.max_uses < 1
+        ):
+            raise ValidationError("max_uses must be an integer >= 1")
+        categories = frozenset(self.excluded_categories)
+        if not all(isinstance(c, Category) for c in categories):
+            raise ValidationError("excluded_categories must contain Category values")
+        object.__setattr__(self, "excluded_categories", categories)
+
+    def applies_to(self, category: Category) -> bool:
+        """Gift cards never take part in promotions."""
+        return category is not Category.GIFT_CARD and category not in self.excluded_categories
+
+
+class PromoRegistry:
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+
+    def add(self, promo: PromoCode) -> None:
+        if promo.code in self._promos:
+            raise ValidationError(f"duplicate promo code: {promo.code}")
+        self._promos[promo.code] = promo
+        self._uses[promo.code] = 0
+
+    def resolve(self, code: str) -> PromoCode:
+        promo = self._promos.get(normalize_key(code))
+        if promo is None:
+            raise UnknownPromoCodeError(f"unknown promo code: {code!r}")
+        now = self._clock.now()
+        if (promo.starts_at is not None and now < promo.starts_at) or (
+            promo.expires_at is not None and now >= promo.expires_at
+        ):
+            raise PromoExpiredError(f"promo code {promo.code} is not valid now")
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} usage limit reached")
+        return promo
+
+    def uses(self, code: str) -> int:
+        key = normalize_key(code)
+        if key not in self._promos:
+            raise UnknownPromoCodeError(f"unknown promo code: {code!r}")
+        return self._uses[key]
+
+    def record_use(self, code: str) -> None:
+        self._uses[normalize_key(code)] += 1
+
+    def release_use(self, code: str) -> None:
+        key = normalize_key(code)
+        if self._uses.get(key, 0) > 0:
+            self._uses[key] -= 1
diff --git a/tests/test_promo.py b/tests/test_promo.py
new file mode 100644
index 0000000..4d0f8b6
--- /dev/null
+++ b/tests/test_promo.py
@@ -0,0 +1,116 @@
+from datetime import timedelta
+from decimal import Decimal as D
+
+import pytest
+
+from shop import (
+    Cart,
+    DiscountKind,
+    OrderService,
+    PromoCode,
+    PromoConditionsError,
+    PromoExpiredError,
+    PromoRegistry,
+    UnknownPromoCodeError,
+    ValidationError,
+    calculate_total,
+)
+
+
+def test_percent_allocation_and_tax(products):
+    cart = Cart()
+    cart.add(products["book"], 1)
+    cart.add(products["shirt"], 1)
+    cart.add(products["gift"], 1)
+    t = calculate_total(cart, promo=PromoCode("x", DiscountKind.PERCENT, D("10")))
+    assert t.discount == D("144.90")
+    assert [l.discount for l in t.lines] == [D("45.00"), D("99.90"), D("0.00")]
+    assert t.lines[0].tax == D("40.50")
+    assert t.total == t.subtotal - t.discount + t.shipping + t.tax
+
+
+def test_fixed_capped_and_free_shipping_after_discount(products):
+    cart = Cart()
+    cart.add(products["phone"], 1)
+    cart.add(products["book"], 1)  # 2950
+    t = calculate_total(cart, promo=PromoCode("a", DiscountKind.FIXED, D("100")))
+    assert t.shipping == D("299.00")
+    t = calculate_total(cart, promo=PromoCode("a", DiscountKind.FIXED, D("99999")))
+    assert t.discount == D("2950.00")
+
+
+def test_remainder_tie_goes_to_earlier_line(products):
+    cart = Cart()
+    cart.add(products["tea"], 1)
+    cart.add(products["book"], 1)
+    t = calculate_total(cart, promo=PromoCode("a", DiscountKind.FIXED, D("0.01")))
+    assert sum(l.discount for l in t.lines) == D("0.01")
+    assert t.lines[0].discount == D("0.00")  # larger remainder is the book
+    cart2 = Cart()
+    cart2.add(products["book"], 1)
+    cart2.add(products["shirt"], 1)
+    t = calculate_total(
+        cart2, promo=PromoCode("a", DiscountKind.FIXED, D("0.01"), excluded_categories={})
+    )
+    assert sum(l.discount for l in t.lines) == D("0.01")
+
+
+def test_conditions(products):
+    cart = Cart()
+    cart.add(products["gift"], 1)
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=PromoCode("a", DiscountKind.PERCENT, D("5")))
+    cart.add(products["book"], 2)  # 900
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart, promo=PromoCode("a", DiscountKind.PERCENT, D("5"), min_order_amount=D("900.01"))
+        )
+    calculate_total(
+        cart, promo=PromoCode("a", DiscountKind.PERCENT, D("5"), min_order_amount=D("900"))
+    )
+
+
+def test_service_flow(products, clock):
+    promo = PromoCode(
+        " sum ",
+        DiscountKind.PERCENT,
+        D("10"),
+        max_uses=1,
+        starts_at=clock.now() - timedelta(days=1),
+        expires_at=clock.now() + timedelta(days=1),
+    )
+    reg = PromoRegistry(clock)
+    reg.add(promo)
+    svc = OrderService(clock=clock, promos=reg)
+    cart = Cart()
+    cart.add(products["book"], 1)
+    assert svc.quote(cart, "  ").discount == D("0.00")
+    svc.quote(cart, "sum")
+    assert reg.uses("SUM") == 0
+    order = svc.place_order(cart, " Sum")
+    assert order.promo_code == "SUM" and reg.uses("sum") == 1
+    with pytest.raises(PromoConditionsError):
+        svc.place_order(cart, "SUM")
+    svc.cancel(order.order_id)
+    assert reg.uses("SUM") == 0
+    svc.place_order(cart, "SUM")
+    with pytest.raises(UnknownPromoCodeError):
+        svc.quote(cart, "nope")
+    with pytest.raises(UnknownPromoCodeError):
+        reg.resolve("")
+    clock.advance(timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUM")
+
+
+def test_no_registry_and_validation(products, clock):
+    cart = Cart()
+    cart.add(products["book"], 1)
+    svc = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        svc.quote(cart, "A")
+    assert svc.place_order(cart, "").promo_code is None
+    with pytest.raises(ValidationError):
+        PromoCode("a", DiscountKind.PERCENT, D("101"))
+    with pytest.raises(ValidationError):
+        PromoCode(" ", DiscountKind.FIXED, D("1"))
