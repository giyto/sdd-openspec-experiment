@@ -0,0 +1,429 @@
+import math
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    HandlerRegistry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobqError,
+    JobQueue,
+    JobStatus,
+    ManualClock,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq import metrics as m
+from jobq.dashboard import render_report
+
+from .conftest import START
+
+
+class StubRng:
+    def __init__(self, value: float) -> None:
+        self.value = value
+        self.calls: list[tuple[float, float]] = []
+
+    def uniform(self, a: float, b: float) -> float:
+        self.calls.append((a, b))
+        return self.value
+
+
+def make(policy=None, *, rng=None, **kwargs):
+    clock = ManualClock(START)
+    queue = JobQueue(clock=clock, default_retry_policy=policy, **kwargs)
+    registry = HandlerRegistry()
+    worker = Worker(queue, registry, rng=rng)
+    return clock, queue, registry, worker
+
+
+def always_fail(exc_type=TimeoutError):
+    def handler(job):
+        raise exc_type("boom")
+
+    return handler
+
+
+# -- 1. базовые типы ----------------------------------------------------------
+
+
+def test_permanent_error_hierarchy():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_new_statuses():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert not JobStatus.DEAD_LETTERED.is_terminal
+
+
+def test_metric_names():
+    assert m.JOBS_RETRIED == "jobs.retried"
+    assert m.JOBS_DEAD_LETTERED == "jobs.dead_lettered"
+    assert m.JOBS_REQUEUED == "jobs.requeued"
+
+
+# -- 2. RetryPolicy -----------------------------------------------------------
+
+
+def test_defaults_and_tuple():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter) == (3, 1.0, 2.0, 60.0, 0.0)
+    assert p.non_retryable == ()
+    assert RetryPolicy(non_retryable=[ValueError, KeyError]).non_retryable == (ValueError, KeyError)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
