+    b = q.enqueue("t")
+    c = q.enqueue("t", delay=3)
+    w.run_once()
+    w.run_once()
+    assert a.run_at == b.run_at
+    clock.advance(3)
+    assert [j.id for j in q.store.due(clock.now())] == [c.id]
+    clock.advance(2)
