+def test_end_to_end_retry_then_success():
+    clock, q, reg, w = make(RetryPolicy(base_delay=1))
+    calls = []
+
+    def flaky(job):
+        calls.append(1)
+        if len(calls) == 1:
+            raise TimeoutError("gw")
+        return "ok"
+
+    reg.register("t", flaky)
+    job = q.enqueue("t")
+    w.run_once()
+    assert job.error is not None
+    clock.advance(1)
+    w.run_once()
+    assert job.status is JobStatus.SUCCEEDED
+    assert job.error is None
+    assert q.metrics.get(m.JOBS_RETRIED) == 1
