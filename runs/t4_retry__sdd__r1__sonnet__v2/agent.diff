+def test_end_to_end_dead_letter_requeue_success():
+    clock, q, reg, w = make(RetryPolicy(max_attempts=2, base_delay=0))
+    broken = [True]
+
+    def handler(job):
+        if broken[0]:
+            raise TimeoutError("down")
+        return "ok"
+
+    reg.register("t", handler)
+    job = q.enqueue("t")
+    w.run_pending()
+    assert "В dead-letter" in render_report(q)
+    assert "Ожидает повтора" in render_report(q)
+    broken[0] = False
+    same = q.requeue_dead_letter(job.id)
+    assert same is job
+    assert (job.status, job.attempts, job.error, job.run_at) == (JobStatus.PENDING, 0, None, clock.now())
+    assert q.dead_letters() == []
+    w.run_once()
+    assert job.status is JobStatus.SUCCEEDED and job.error is None
+    snap = q.metrics.snapshot()
+    assert snap["jobs.retried"] == 1
+    assert snap["jobs.dead_lettered"] == 1
+    assert snap["jobs.requeued"] == 1
+    assert "jobs.failed" not in snap
+    assert q.stats()["retry_scheduled"] == 0 and q.stats()["dead_lettered"] == 0
