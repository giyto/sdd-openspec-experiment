new file mode 100644
index 0000000..7c4a554
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,368 @@
+from dataclasses import FrozenInstanceError
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    UnknownSkuError,
+    ValidationError,
+)
+from warehouse.events import parse_line
+from warehouse.models import Reservation, ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL
+
+T0 = datetime(2026, 3, 1, 10, 0, 0, tzinfo=timezone.utc)
+
+
+def kinds(inv):
+    return [event.kind for event in inv.log]
+
+
+def test_default_ttl_is_fifteen_minutes():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+def test_reserve_holds_stock_without_changing_on_hand(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0
+    assert res.expires_at == T0 + timedelta(minutes=15)
+    assert inv.on_hand("MAIN", "BOLT-M8") == 10
+    assert inv.reserved("MAIN", "BOLT-M8") == 4
+    assert inv.available("MAIN", "BOLT-M8") == 6
+
+
+def test_reserve_keeps_lines_as_given(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "NUT-M8", 10)
+    lines = [
+        ReservationLine("NORTH", "NUT-M8", 2),
+        ("MAIN", "BOLT-M8", 3),
+        ("MAIN", "BOLT-M8", 1),
+    ]
+    res = inv.reserve("SO-1", lines)
+    assert res.lines == (
+        ReservationLine("NORTH", "NUT-M8", 2),
+        ReservationLine("MAIN", "BOLT-M8", 3),
+        ReservationLine("MAIN", "BOLT-M8", 1),
+    )
+    assert inv.reserved("MAIN", "BOLT-M8") == 4
+
+
+def test_reserve_is_all_or_nothing(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("MAIN", "NUT-M8", 1)
+    with pytest.raises(InsufficientStockError) as info:
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "NUT-M8", 2)])
+    assert (info.value.sku, info.value.requested, info.value.available) == ("NUT-M8", 2, 1)
+    with pytest.raises(ReservationNotFoundError):
+        inv.get_reservation("SO-1")
+    assert inv.reserved("MAIN", "BOLT-M8") == 0
+    assert kinds(inv) == ["RECEIVE", "RECEIVE"]
+
+
+def test_same_position_lines_are_checked_by_sum(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    with pytest.raises(InsufficientStockError) as info:
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 3)])
+    assert (info.value.requested, info.value.available) == (6, 5)
+
+
+def test_reserve_writes_one_event_per_line(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 1)])
+    reserve_lines = [e for e in inv.log.events("RESERVE")]
+    assert len(reserve_lines) == 2
+    assert reserve_lines[0].format() == "000002 2026-03-01T10:00:00Z RESERVE expires=2026-03-01T10:15:00Z order=SO-1 qty=2 sku=BOLT-M8 wh=MAIN"
+    assert [e.get("qty") for e in reserve_lines] == ["2", "1"]
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), timedelta(seconds=-1), 60, "5m"])
+def test_reserve_rejects_bad_ttl(inv, ttl):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=ttl)
+    assert len(inv.log) == 1
+
+
+def test_reserve_rejects_empty_order(inv):
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-1", [])
+
+
+def test_reserve_rejects_bad_order_id(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    with pytest.raises(ValidationError):
+        inv.reserve("SO 1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_rejects_bad_line_qty_and_unknown_sku(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    with pytest.raises(InvalidQuantityError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 0)])
+    with pytest.raises(UnknownSkuError):
+        inv.reserve("SO-1", [("MAIN", "NOPE", 1)])
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8")])
+
+
+def test_reserve_duplicate_active_is_error(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_duplicate_confirmed_is_error(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_again_after_cancel_replaces_old(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    inv.cancel("SO-1")
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2)], ttl=timedelta(minutes=5))
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.lines == (ReservationLine("MAIN", "BOLT-M8", 2),)
+    assert inv.get_reservation("SO-1").expires_at == T0 + timedelta(minutes=5)
+    assert inv.reserved("MAIN", "BOLT-M8") == 2
+
+
+def test_reserve_again_after_expiry_replaces_old(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    clock.advance(timedelta(minutes=15))
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0 + timedelta(minutes=15)
+
+
+def test_reservation_expires_exactly_at_expires_at(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    clock.advance(timedelta(minutes=15) - timedelta(seconds=1))
+    assert inv.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert inv.reserved("MAIN", "BOLT-M8") == 3
+    clock.advance(timedelta(seconds=1))
+    assert inv.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert inv.reserved("MAIN", "BOLT-M8") == 0
+    assert inv.available("MAIN", "BOLT-M8") == 5
+    assert kinds(inv) == ["RECEIVE", "RESERVE"]
+
+
+def test_expired_reservation_does_not_block_new_reserve(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)], ttl=timedelta(minutes=1))
+    clock.advance(timedelta(minutes=1))
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 5)])
+    assert inv.available("MAIN", "BOLT-M8") == 0
+
+
+def test_available_is_zero_when_counted_below_reserved(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    inv.adjust("MAIN", "BOLT-M8", 3, "count")
+    assert inv.on_hand("MAIN", "BOLT-M8") == 3
+    assert inv.reserved("MAIN", "BOLT-M8") == 8
+    assert inv.available("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_issues_stock_and_logs(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "NUT-M8", 10)
+    inv.reserve("SO-1", [("NORTH", "NUT-M8", 2), ("MAIN", "BOLT-M8", 3)])
+    res = inv.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 7
+    assert inv.on_hand("NORTH", "NUT-M8") == 8
+    assert inv.reserved("MAIN", "BOLT-M8") == 0
+    tail = [e.kind for e in inv.log][-4:]
+    assert tail == ["RESERVE", "ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    issues = inv.log.events("ISSUE")
+    assert [(e.get("wh"), e.get("sku"), e.get("qty"), e.get("ref")) for e in issues] == [
+        ("NORTH", "NUT-M8", "2", "SO-1"),
+        ("MAIN", "BOLT-M8", "3", "SO-1"),
+    ]
+    assert inv.log.events("RESERVE_CONFIRM")[0].get("order") == "SO-1"
+
+
+def test_confirm_works_with_zero_available(inv):
+    inv.receive("MAIN", "BOLT-M8", 4)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert inv.available("MAIN", "BOLT-M8") == 0
+    assert inv.confirm("SO-1").status is ReservationStatus.CONFIRMED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_checks_physical_stock_per_position(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 3)])
+    inv.adjust("MAIN", "BOLT-M8", 4, "count")
+    events_before = len(inv.log)
+    with pytest.raises(InsufficientStockError) as info:
+        inv.confirm("SO-1")
+    assert (info.value.requested, info.value.available) == (5, 4)
+    assert inv.on_hand("MAIN", "BOLT-M8") == 4
+    assert inv.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert len(inv.log) == events_before
+
+
+def test_confirm_expired_is_expired_error(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=15))
+    with pytest.raises(ReservationExpiredError):
+        inv.confirm("SO-1")
+
+
+def test_confirm_twice_or_after_cancel_is_state_error(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        inv.confirm("SO-1")
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    inv.cancel("SO-2")
+    with pytest.raises(ReservationStateError):
+        inv.confirm("SO-2")
+
+
+def test_cancel_releases_and_is_idempotent(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    assert inv.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert inv.available("MAIN", "BOLT-M8") == 5
+    events = len(inv.log)
+    assert inv.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(inv.log) == events
+    assert kinds(inv).count("RESERVE_CANCEL") == 1
+
+
+def test_cancel_expired_is_noop_and_stays_expired(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=20))
+    events = len(inv.log)
+    assert inv.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert len(inv.log) == events
+
+
+def test_cancel_confirmed_is_state_error(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        inv.cancel("SO-1")
+
+
+def test_confirmed_stays_confirmed_after_ttl(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    clock.advance(timedelta(days=1))
+    assert inv.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+
+
+def test_extend_moves_expiry_from_now(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=10))
+    res = inv.extend("SO-1", timedelta(minutes=30))
+    assert res.expires_at == T0 + timedelta(minutes=40)
+    assert inv.log.events("RESERVE_EXTEND")[0].get("expires") == "2026-03-01T10:40:00Z"
+
+
+def test_extend_never_shortens(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=30))
+    res = inv.extend("SO-1", timedelta(minutes=10))
+    assert res.expires_at == T0 + timedelta(minutes=30)
+    assert inv.log.events("RESERVE_EXTEND") == []
+
+
+def test_extend_expired_or_closed_errors(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    inv.cancel("SO-2")
+    with pytest.raises(ReservationStateError):
+        inv.extend("SO-2", timedelta(minutes=5))
+    clock.advance(timedelta(minutes=15))
+    with pytest.raises(ReservationExpiredError):
+        inv.extend("SO-1", timedelta(minutes=5))
+    with pytest.raises(ValidationError):
+        inv.extend("SO-1", timedelta(0))
+
+
+def test_unknown_order_raises_not_found(inv):
+    for call in (
+        lambda: inv.confirm("NOPE"),
+        lambda: inv.cancel("NOPE"),
+        lambda: inv.extend("NOPE", timedelta(minutes=1)),
+        lambda: inv.get_reservation("NOPE"),
+    ):
+        with pytest.raises(ReservationNotFoundError) as info:
+            call()
+        assert info.value.order_id == "NOPE"
+
+
+def test_get_reservation_is_snapshot(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert isinstance(res, Reservation)
+    with pytest.raises(FrozenInstanceError):
+        res.status = ReservationStatus.CANCELLED
+    inv.cancel("SO-1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert inv.get_reservation("SO-1").status is ReservationStatus.CANCELLED
+
+
+def test_issue_cannot_take_from_reserved_stock(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as info:
+        inv.issue("MAIN", "BOLT-M8", 3)
+    assert (info.value.requested, info.value.available) == (3, 2)
+    assert inv.issue("MAIN", "BOLT-M8", 2) == 8
+
+
+def test_transfer_cannot_take_from_reserved_stock(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        inv.transfer("MAIN", "NORTH", "BOLT-M8", 3)
+
+
+def test_expired_reservation_releases_stock_for_issue(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    clock.advance(timedelta(minutes=15))
+    assert inv.issue("MAIN", "BOLT-M8", 10) == 0
+
+
+def test_reserved_and_available_validate_input(inv):
+    with pytest.raises(UnknownSkuError):
+        inv.available("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        inv.reserved("MAIN", "NOPE")
+    assert inv.available("NORTH", "BOLT-M8") == 0
+
+
+def test_custom_ttl_and_journal_lines_parse_back(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(hours=1))
+    inv.extend("SO-1", timedelta(hours=2))
+    for line in inv.log.lines():
+        parse_line(line)
+    assert inv.log.events("RESERVE_EXTEND")[0].get("expires") == "2026-03-01T12:00:00Z"
