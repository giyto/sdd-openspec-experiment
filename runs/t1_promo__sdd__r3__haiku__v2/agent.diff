+def _participates(product: Product, promo: PromoCode) -> bool:
+    return product.category is not Category.GIFT_CARD and product.category not in promo.excluded_categories
+
+
+def _line_discounts(cart: Cart, promo: PromoCode | None) -> list[Decimal]:
+    """Discount of every cart line, in cart order; non-participating lines get ``0.00``."""
+    if promo is None:
+        return [ZERO] * len(cart.lines)
+
+    participating = [
+        index for index, line in enumerate(cart.lines) if _participates(line.product, promo)
+    ]
+    if not participating:
+        raise PromoConditionsError(f"promo code {promo.code} applies to no line of the cart")
+    base = sum_money(cart.lines[index].amount for index in participating)
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"promo code {promo.code} requires an order of at least {promo.min_order_amount}"
+        )
+
+    discount = _order_discount(promo, base)
+    shares = _distribute_discount(discount, [cart.lines[index].amount for index in participating])
+    discounts = [ZERO] * len(cart.lines)
+    for index, share in zip(participating, shares):
+        discounts[index] = share
+    return discounts
+
+
+def _order_discount(promo: PromoCode, base: Decimal) -> Decimal:
+    if promo.kind is DiscountKind.PERCENT:
+        return quantize_money(base * promo.value / Decimal("100"))
+    return min(promo.value, base)
+
+
+def _distribute_discount(discount: Decimal, bases: list[Decimal]) -> list[Decimal]:
+    """Split ``discount`` over ``bases`` in whole kopecks; the parts sum to ``discount`` exactly.
+
+    Every base gets its floored share; the leftover kopecks go one by one to the bases with the
+    largest discarded remainder, ties going to the earlier base.
+    """
+    total_kopecks = int(discount / CENT)
+    base_kopecks = [int(base / CENT) for base in bases]
+    base_sum = sum(base_kopecks)
+    shares = [total_kopecks * base // base_sum for base in base_kopecks]
+    remainders = [total_kopecks * base % base_sum for base in base_kopecks]
+    leftover = total_kopecks - sum(shares)
+    for index in sorted(range(len(bases)), key=lambda i: (-remainders[i], i))[:leftover]:
+        shares[index] += 1
+    return [quantize_money(Decimal(kopecks) * CENT) for kopecks in shares]
