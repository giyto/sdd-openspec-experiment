+import pytest
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+)
+
+
+@pytest.mark.parametrize(
+    "error_type",
+    [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError],
+)
+def test_promo_errors_derive_from_promo_error(error_type):
+    assert issubclass(error_type, PromoError)
+    assert issubclass(error_type, ShopError)
+
+
+def test_promo_subclasses_are_independent():
+    assert not issubclass(UnknownPromoCodeError, PromoExpiredError)
+    assert not issubclass(PromoExpiredError, PromoConditionsError)
+    assert not issubclass(PromoConditionsError, UnknownPromoCodeError)
+
+
+@pytest.mark.parametrize(
+    "error_type",
+    [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError],
+)
+def test_shop_error_catches_every_promo_error(error_type):
+    with pytest.raises(ShopError):
+        raise error_type("message")
