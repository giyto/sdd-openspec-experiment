+
+
+# 4.1 quote and the registry
+
+
+def test_quote_with_code_applies_discount(service, registry, products):
+    add_code(registry)
+    total = service.quote(cart_with(products["book"]), " summer10 ")
+    assert total.discount == Decimal("45.00")
+    assert total.total == Decimal("405.00") + Decimal("299.00") + Decimal("40.50")
+
+
+def test_blank_code_quotes_like_no_code(service, products):
+    cart = cart_with(products["book"])
+    assert service.quote(cart, "   ") == service.quote(cart)
+    assert service.quote(cart, None) == service.quote(cart)
+    assert service.quote(cart, "") == service.quote(cart)
+
+
+def test_non_blank_code_without_registry_is_unknown(clock, products):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart_with(products["book"]), "SUMMER10")
+
+
+def test_quote_does_not_count_use_or_store_order(service, registry, products):
+    add_code(registry, max_uses=1)
+    service.quote(cart_with(products["book"]), "SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+# 4.2 place_order
+
+
+def test_successful_order_consumes_use(service, registry, products):
+    add_code(registry, max_uses=2)
+    order = service.place_order(cart_with(products["book"]), "summer10")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == Decimal("45.00")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_order_without_code_has_no_promo(service, registry, products):
+    add_code(registry)
+    order = service.place_order(cart_with(products["book"]))
+    assert order.promo_code is None
+    assert order.total.discount == Decimal("0.00")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_blank_code_places_order_without_promo(service, registry, products):
+    add_code(registry)
+    order = service.place_order(cart_with(products["book"]), "   ")
+    assert order.promo_code is None
+
+
+def test_order_below_minimum_stores_nothing(service, registry, products):
+    add_code(registry, max_uses=2, min_order_amount=Decimal("1000.00"))
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_with(products["book"]), "SUMMER10")
+    assert len(service.store) == 0
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_expired_code_stores_nothing(service, registry, products, clock):
+    add_code(registry, max_uses=2, expires_at=clock.now() - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        service.place_order(cart_with(products["book"]), "SUMMER10")
+    assert len(service.store) == 0
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_exhausted_code_stores_nothing(service, registry, products):
+    add_code(registry, max_uses=1)
+    service.place_order(cart_with(products["book"]), "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_with(products["book"]), "SUMMER10")
+    assert len(service.store) == 1
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_unknown_code_on_place_order(service, products):
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart_with(products["book"]), "NOPE")
+    assert len(service.store) == 0
+
+
+# 4.3 cancel returns the use
+
+
+def test_cancel_frees_one_use_and_keeps_code(service, registry, products):
+    add_code(registry, max_uses=1)
+    order = service.place_order(cart_with(products["book"]), "SUMMER10")
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert cancelled.promo_code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 0
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_cancel_order_without_code_changes_no_count(service, registry, products):
+    add_code(registry)
+    order = service.place_order(cart_with(products["book"]))
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_cancel_without_registry_skips_release(clock, registry, products):
+    store = OrderStore()
+    with_promos = OrderService(store, clock=clock, promos=registry)
+    add_code(registry, max_uses=1)
+    order = with_promos.place_order(cart_with(products["book"]), "SUMMER10")
+
+    without_promos = OrderService(store, clock=clock)
+    cancelled = without_promos.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert registry.uses("SUMMER10") == 1
diff --git a/tests/test_promo_pricing.py b/tests/test_promo_pricing.py
new file mode 100644
index 0000000..e1b9375
--- /dev/null
+++ b/tests/test_promo_pricing.py
@@ -0,0 +1,208 @@
+import random
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+NOW = datetime(2026, 6, 15, 12, 0, tzinfo=timezone.utc)
+
+
+def promo(kind=DiscountKind.PERCENT, value=Decimal("10"), **overrides):
+    return PromoCode(code="SUMMER10", kind=kind, value=value, **overrides)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, quantity in items:
+        cart.add(product, quantity)
+    return cart
+
+
+def product(sku, price, category):
+    return Product(sku, sku, Decimal(price), category)
+
+
+# 3.2 participating lines, no participating lines, minimum order amount
+
+
+def test_gift_card_line_is_excluded(products):
+    cart = cart_of((products["gift"], 1), (products["book"], 1))
+    total = calculate_total(cart, promo=promo())
+    gift, book = total.lines
+    assert total.discount == Decimal("45.00")
+    assert gift.discount == Decimal("0.00")
+    assert book.discount == Decimal("45.00")
+
+
+def test_excluded_category_gets_no_discount(products):
+    cart = cart_of((products["phone"], 1), (products["shirt"], 1))
+    total = calculate_total(cart, promo=promo(excluded_categories={Category.ELECTRONICS}))
+    phone, shirt = total.lines
+    assert phone.discount == Decimal("0.00")
+    assert shirt.discount == Decimal("99.90")
+    assert total.discount == Decimal("99.90")
+
+
+def test_only_gift_cards_raises(products):
+    cart = cart_of((products["gift"], 2))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo())
+
+
+def test_no_participating_lines_raises_without_minimum(products):
+    cart = cart_of((products["phone"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(excluded_categories={Category.ELECTRONICS}))
+
+
+def test_minimum_exactly_met_applies():
+    cart = cart_of((product("SHIRT-2", "1000.00", Category.CLOTHING), 1))
+    total = calculate_total(cart, promo=promo(min_order_amount=Decimal("1000.00")))
+    assert total.discount == Decimal("100.00")
+
+
+def test_minimum_below_raises():
+    cart = cart_of((product("SHIRT-3", "999.99", Category.CLOTHING), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(min_order_amount=Decimal("1000.00")))
+
+
+def test_minimum_ignores_gift_cards(products):
+    cart = cart_of((products["gift"], 1), (products["book"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(min_order_amount=Decimal("1000.00")))
+
+
+# 3.3 discount amount
+
+
+def test_percent_rounds_half_up(products):
+    cart = cart_of((products["tea"], 1))
+    total = calculate_total(cart, promo=promo(value=Decimal("15")))
+    assert total.discount == Decimal("29.99")
+
+
+def test_fixed_amount_capped_at_base():
+    cart = cart_of((product("BOOK-300", "300.00", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("500.00")))
+    assert total.discount == Decimal("300.00")
+    assert total.lines[0].tax == Decimal("0.00")
+    assert total.total == Decimal("299.00")
+
+
+def test_fixed_amount_below_base(products):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("50.00")))
+    assert total.discount == Decimal("50.00")
+
+
+def test_no_promo_gives_zero_discount(products):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart)
+    assert total.discount == Decimal("0.00")
+    assert total.lines[0].discount == Decimal("0.00")
+
+
+# 3.4 distribution across lines
+
+
+def test_tie_on_remainder_goes_to_earlier_line():
+    a = product("BOOK-A", "100.00", Category.BOOKS)
+    b = product("BOOK-B", "100.00", Category.BOOKS)
+    cart = cart_of((a, 1), (b, 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("0.01")))
+    assert [line.discount for line in total.lines] == [Decimal("0.01"), Decimal("0.00")]
+
+
+def test_largest_remainder_wins_over_larger_line():
+    first = product("BOOK-1A", "1.00", Category.BOOKS)
+    second = product("BOOK-2A", "2.00", Category.BOOKS)
+    cart = cart_of((first, 1), (second, 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("0.02")))
+    assert [line.discount for line in total.lines] == [Decimal("0.01"), Decimal("0.01")]
+
+
+@pytest.mark.parametrize("seed", range(30))
+def test_line_discounts_always_sum_to_order_discount(seed):
+    rng = random.Random(seed)
+    catalog = [
+        product(
+            f"ITEM-{index}",
+            f"{rng.randint(1, 5000)}.{rng.randint(0, 99):02d}",
+            rng.choice(list(Category)),
+        )
+        for index in range(8)
+    ]
+    cart = Cart()
+    for item in rng.sample(catalog, rng.randint(1, 6)):
+        cart.add(item, rng.randint(1, 5))
+    if rng.random() < 0.5:
+        code = promo(value=Decimal(rng.randint(1, 100)))
+    else:
+        fixed = f"{rng.randint(1, 100000)}.{rng.randint(0, 99):02d}"
+        code = promo(kind=DiscountKind.FIXED, value=Decimal(fixed))
+    try:
+        total = calculate_total(cart, promo=code)
+    except PromoConditionsError:
+        pytest.skip("cart has no participating lines for this code")
+    assert sum(line.discount for line in total.lines) == total.discount
+    for line in total.lines:
+        assert Decimal("0.00") <= line.discount <= line.amount
+
+
+# 3.5 tax after discount, shipping threshold, totals
+
+
+def test_book_tax_after_discount(products):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart, promo=promo())
+    assert total.lines[0].tax == Decimal("40.50")
+    assert total.tax == Decimal("40.50")
+
+
+def test_gift_card_stays_untaxed_with_promo(products):
+    cart = cart_of((products["gift"], 1), (products["book"], 1))
+    total = calculate_total(cart, promo=promo())
+    assert total.lines[0].tax == Decimal("0.00")
+
+
+def test_discount_reaches_free_shipping_threshold():
+    goods = product("PHONE-3100", "3100.00", Category.ELECTRONICS)
+    total = calculate_total(cart_of((goods, 1)), promo=promo(kind=DiscountKind.FIXED, value=Decimal("100.00")))
+    assert total.shipping == Decimal("0.00")
+
+
+def test_discount_keeps_goods_below_threshold():
+    goods = product("PHONE-3100", "3100.00", Category.ELECTRONICS)
+    total = calculate_total(cart_of((goods, 1)), promo=promo(kind=DiscountKind.FIXED, value=Decimal("200.00")))
+    assert total.shipping == Decimal("299.00")
+
+
+def test_discount_does_not_reduce_shipping_fee(products):
+    cart = cart_of((products["phone"], 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("100.00")))
+    assert total.shipping == Decimal("299.00")
+
+
+def test_total_with_discount():
+    goods = product("BOOK-2500", "2500.00", Category.BOOKS)
+    total = calculate_total(cart_of((goods, 1)), promo=promo(kind=DiscountKind.FIXED, value=Decimal("100.00")))
+    assert total.subtotal == Decimal("2500.00")
+    assert total.discount == Decimal("100.00")
+    assert total.shipping == Decimal("299.00")
+    assert total.tax == Decimal("240.00")
+    assert total.total == Decimal("2939.00")
+
+
+def test_custom_shipping_threshold_uses_goods_after_discount():
+    policy = ShippingPolicy(free_threshold=Decimal("2400.00"))
+    goods = product("BOOK-2500", "2500.00", Category.BOOKS)
+    total = calculate_total(
+        cart_of((goods, 1)), policy, promo=promo(kind=DiscountKind.FIXED, value=Decimal("100.00"))
+    )
+    assert total.shipping == Decimal("0.00")
diff --git a/tests/test_promo_registry.py b/tests/test_promo_registry.py
new file mode 100644
index 0000000..7586e03
--- /dev/null
+++ b/tests/test_promo_registry.py
@@ -0,0 +1,139 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+NOW = datetime(2026, 6, 15, 12, 0, tzinfo=timezone.utc)
+START = NOW - timedelta(days=10)
+END = NOW + timedelta(days=10)
+
+
+@pytest.fixture
+def clock():
+    return FixedClock(NOW)
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def promo(code="SUMMER10", **overrides):
+    fields = {"kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    return PromoCode(code=code, **fields)
+
+
+def test_resolve_ignores_spacing_and_case(registry):
+    registry.add(promo("SUMMER10"))
+    assert registry.resolve(" summer10\t").code == "SUMMER10"
+
+
+def test_duplicate_code_rejected_and_registry_unchanged(registry):
+    registry.add(promo("SUMMER10", value=Decimal("10")))
+    with pytest.raises(ValidationError):
+        registry.add(promo(" summer10 ", value=Decimal("50")))
+    assert registry.resolve("SUMMER10").value == Decimal("10")
+
+
+def test_unknown_code(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("NOPE")
+
+
+def test_empty_code_is_unknown(registry):
+    registry.add(promo())
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("")
+
+
+def test_uses_of_unknown_code_raises(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE")
+
+
+def test_code_before_start_is_expired(registry):
+    registry.add(promo(starts_at=NOW + timedelta(hours=1)))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_code_at_start_resolves(registry):
+    registry.add(promo(starts_at=NOW))
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_code_at_end_is_expired(registry):
+    registry.add(promo(expires_at=NOW))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_code_inside_period_resolves(registry):
+    registry.add(promo(starts_at=START, expires_at=END))
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_validity_follows_the_injected_clock(clock, registry):
+    registry.add(promo(starts_at=START, expires_at=END))
+    clock.set(END)
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_limit_exhausted_raises_conditions_error(registry):
+    registry.add(promo(max_uses=1))
+    registry.record_use("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+
+
+def test_unlimited_code_always_resolves(registry):
+    registry.add(promo(max_uses=None))
+    for _ in range(50):
+        registry.record_use("SUMMER10")
+        assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_expired_and_exhausted_reports_expired(registry):
+    registry.add(promo(max_uses=1, expires_at=NOW))
+    registry.record_use("SUMMER10")
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_resolve_order_unknown_before_validity(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("LATE")
+
+
+def test_usage_counting_and_release(registry):
+    registry.add(promo(max_uses=2))
+    registry.record_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 1
+    registry.release_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_release_never_goes_below_zero(registry):
+    registry.add(promo())
+    registry.release_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_failed_resolves_do_not_change_counts(registry):
+    registry.add(promo(max_uses=1, starts_at=NOW + timedelta(days=1)))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
