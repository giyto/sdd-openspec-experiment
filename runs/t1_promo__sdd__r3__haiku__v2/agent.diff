@@ -0,0 +1,140 @@
+"""Promo codes: definition, input normalization and the registry of codes.
+
+The module does not depend on :mod:`shop.pricing` (no import cycle): pricing applies
+a :class:`PromoCode` to a cart, the registry decides whether a code may be used.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def normalize_promo_input(raw: str | None) -> str | None:
+    """Normalize a code typed by the customer. ``None``, blank and spaces-only mean "no code"."""
+    if raw is None:
+        return None
+    if isinstance(raw, str) and not raw.strip():
+        return None
+    return normalize_key(raw)
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError(f"promo {self.code}: kind must be a DiscountKind")
+        _check_decimal(self.value, f"promo {self.code}: value")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError(f"promo {self.code}: percent must be in (0, 100]")
+        else:
+            if self.value <= 0 or to_money(self.value) != self.value:
+                raise ValidationError(f"promo {self.code}: fixed amount must be a positive money amount")
+        _check_decimal(self.min_order_amount, f"promo {self.code}: minimum order amount")
+        if self.min_order_amount < 0 or to_money(self.min_order_amount) != self.min_order_amount:
+            raise ValidationError(f"promo {self.code}: minimum order amount must be a non-negative money amount")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError(f"promo {self.code}: max_uses must be None or an integer >= 1")
+        _check_aware(self.starts_at, f"promo {self.code}: starts_at")
+        _check_aware(self.expires_at, f"promo {self.code}: expires_at")
+        if self.starts_at is not None and self.expires_at is not None and self.starts_at >= self.expires_at:
+            raise ValidationError(f"promo {self.code}: starts_at must be earlier than expires_at")
+        excluded = frozenset(self.excluded_categories)
+        if not all(isinstance(category, Category) for category in excluded):
+            raise ValidationError(f"promo {self.code}: excluded categories must be Category values")
+        object.__setattr__(self, "excluded_categories", excluded)
+
+
+def _check_decimal(value: object, what: str) -> None:
+    if not isinstance(value, Decimal) or not value.is_finite():
+        raise ValidationError(f"{what} must be a finite Decimal")
+
+
+def _check_aware(moment: object, what: str) -> None:
+    if moment is None:
+        return
+    if not isinstance(moment, datetime) or moment.utcoffset() is None:
+        raise ValidationError(f"{what} must be an aware datetime")
+
+
+class PromoRegistry:
+    """Registered promo codes, their validity, usage limits and usage counts.
+
+    Clock is injected: the validity period is always checked against it. Usage counts
+    are changed only through :meth:`record_use` and :meth:`release_use`.
+    """
+
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+
+    def add(self, promo: PromoCode) -> None:
+        if promo.code in self._promos:
+            raise ValidationError(f"duplicate promo code: {promo.code}")
+        self._promos[promo.code] = promo
+
+    def resolve(self, raw_code: str) -> PromoCode:
+        """Find the code and check existence, validity period and usage limit, in this order."""
+        promo = self._get(raw_code)
+        now = self._clock.now()
+        if (promo.starts_at is not None and now < promo.starts_at) or (
+            promo.expires_at is not None and now >= promo.expires_at
+        ):
+            raise PromoExpiredError(f"promo code {promo.code} is not valid now")
+        if promo.max_uses is not None and self._uses.get(promo.code, 0) >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} has no uses left")
+        return promo
+
+    def uses(self, raw_code: str) -> int:
+        promo = self._get(raw_code)
+        return self._uses.get(promo.code, 0)
+
+    def record_use(self, raw_code: str) -> None:
+        promo = self._get(raw_code)
+        self._uses[promo.code] = self._uses.get(promo.code, 0) + 1
+
+    def release_use(self, raw_code: str) -> None:
+        """Return one use; the count never drops below zero."""
+        promo = self._get(raw_code)
+        self._uses[promo.code] = max(0, self._uses.get(promo.code, 0) - 1)
+
+    def _get(self, raw_code: str) -> PromoCode:
+        code = normalize_key(raw_code)
+        try:
+            return self._promos[code]
+        except KeyError:
+            raise UnknownPromoCodeError(f"unknown promo code: {code!r}") from None
