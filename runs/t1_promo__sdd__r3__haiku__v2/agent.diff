@@ -0,0 +1,139 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.errors import ValidationError
+from shop.promo import DiscountKind, PromoCode, normalize_promo_input
+
+START = datetime(2026, 6, 1, tzinfo=timezone.utc)
+END = START + timedelta(days=30)
+
+
+def make(**overrides):
+    fields = {"code": "SUMMER10", "kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    return PromoCode(**fields)
+
+
+def test_code_is_normalized():
+    assert make(code="  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize("code", ["", "   "])
+def test_empty_code_rejected(code):
+    with pytest.raises(ValidationError):
+        make(code=code)
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("150"), Decimal("-5")])
+def test_percent_out_of_range_rejected(value):
+    with pytest.raises(ValidationError):
+        make(kind=DiscountKind.PERCENT, value=value)
+
+
+def test_percent_100_accepted():
+    assert make(value=Decimal("100")).value == Decimal("100")
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("-1.00"), Decimal("10.001")])
+def test_fixed_value_must_be_positive_money(value):
+    with pytest.raises(ValidationError):
+        make(kind=DiscountKind.FIXED, value=value)
+
+
+def test_fixed_value_accepted():
+    assert make(kind=DiscountKind.FIXED, value=Decimal("500.00")).value == Decimal("500.00")
+
+
+@pytest.mark.parametrize("value", [10, 10.0, "10", True])
+def test_value_must_be_decimal(value):
+    with pytest.raises(ValidationError):
+        make(value=value)
+
+
+def test_non_finite_value_rejected():
+    with pytest.raises(ValidationError):
+        make(value=Decimal("NaN"))
+
+
+def test_minimum_defaults_to_zero():
+    assert make().min_order_amount == Decimal("0.00")
+
+
+@pytest.mark.parametrize(
+    "minimum",
+    [Decimal("-1.00"), Decimal("10.001"), 100, 100.0],
+)
+def test_minimum_must_be_non_negative_money_decimal(minimum):
+    with pytest.raises(ValidationError):
+        make(min_order_amount=minimum)
+
+
+@pytest.mark.parametrize("max_uses", [0, -1, 1.5, True])
+def test_max_uses_must_be_none_or_positive_int(max_uses):
+    with pytest.raises(ValidationError):
+        make(max_uses=max_uses)
+
+
+def test_max_uses_none_and_one_accepted():
+    assert make(max_uses=None).max_uses is None
+    assert make(max_uses=1).max_uses == 1
+
+
+def test_naive_start_rejected():
+    with pytest.raises(ValidationError):
+        make(starts_at=datetime(2026, 6, 1))
+
+
+def test_naive_expiry_rejected():
+    with pytest.raises(ValidationError):
+        make(expires_at=datetime(2026, 6, 1))
+
+
+@pytest.mark.parametrize("starts, expires", [(END, START), (START, START)])
+def test_start_must_be_before_expiry(starts, expires):
+    with pytest.raises(ValidationError):
+        make(starts_at=starts, expires_at=expires)
+
+
+def test_open_ended_validity_accepted():
+    assert make(starts_at=START).expires_at is None
+    assert make(expires_at=END).starts_at is None
+
+
+def test_excluded_categories_must_be_categories():
+    with pytest.raises(ValidationError):
+        make(excluded_categories={"electronics"})
+
+
+def test_excluded_categories_default_empty_and_frozen():
+    assert make().excluded_categories == frozenset()
+    promo = make(excluded_categories={Category.ELECTRONICS})
+    assert isinstance(promo.excluded_categories, frozenset)
+
+
+def test_promo_code_is_immutable():
+    promo = make()
+    with pytest.raises(AttributeError):
+        promo.value = Decimal("20")
+
+
+def test_kind_must_be_discount_kind():
+    with pytest.raises(ValidationError):
+        make(kind="percent")
+
+
+@pytest.mark.parametrize("raw", [None, "", "   "])
+def test_blank_input_means_no_code(raw):
+    assert normalize_promo_input(raw) is None
+
+
+def test_input_is_normalized():
+    assert normalize_promo_input(" summer10 ") == "SUMMER10"
+
+
+def test_non_string_input_rejected():
+    with pytest.raises(ValidationError):
+        normalize_promo_input(10)
