diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..e7c98c3
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,387 @@
+import dataclasses
+from datetime import timedelta
+
+import pytest
+
+import warehouse
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.models import Reservation, ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL, normalize_lines, totals
+
+from conftest import T0
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "BOLT-M8", 5)
+    inv.receive("MAIN", "NUT-M8", 10)
+    return inv
+
+
+# --- models / errors / helpers ---------------------------------------------
+
+
+def test_models_are_frozen_and_statuses():
+    assert {s.value for s in ReservationStatus} == {"ACTIVE", "CONFIRMED", "CANCELLED", "EXPIRED"}
+    line = ReservationLine("MAIN", "BOLT-M8", 1)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        line.qty = 2
+    res = Reservation("A", (line,), ReservationStatus.ACTIVE, T0, T0)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        res.status = ReservationStatus.CANCELLED
+
+
+def test_error_hierarchy():
+    for cls in (
+        DuplicateReservationError,
+        ReservationNotFoundError,
+        ReservationExpiredError,
+    ):
+        err = cls("SO-1")
+        assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+        assert err.order_id == "SO-1"
+    err = ReservationStateError("SO-1", "CANCELLED")
+    assert isinstance(err, ReservationError) and err.order_id == "SO-1"
+
+
+def test_default_ttl():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 60, True, "5m"])
+def test_reserve_rejects_bad_ttl(stocked, ttl):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=ttl)
+    assert len(stocked.log) == 3
+
+
+def test_normalize_lines_forms_and_empty():
+    result = normalize_lines(iter([("MAIN", "X", 1), ReservationLine("MAIN", "X", 2)]))
+    assert result == (ReservationLine("MAIN", "X", 1), ReservationLine("MAIN", "X", 2))
+    assert totals(result) == {("MAIN", "X"): 3}
+    with pytest.raises(ValidationError):
+        normalize_lines([])
+    with pytest.raises(ValidationError):
+        normalize_lines([("MAIN", "X")])
+
+
+@pytest.mark.parametrize("order_id", ["", "A B", "A=B", None])
+def test_reserve_rejects_bad_order_id(stocked, order_id):
+    with pytest.raises(ValidationError):
+        stocked.reserve(order_id, [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_bad_lines(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("BAD WH", "BOLT-M8", 1)])
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 0)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("MAIN", "NOPE", 1)])
+    assert len(stocked.log) == 3
+
+
+# --- reserve / queries ------------------------------------------------------
+
+
+def test_reserve_default_ttl_and_queries(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0
+    assert res.expires_at == T0 + timedelta(minutes=15)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.available("MAIN", "BOLT-M8") == 6
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+    assert stocked.get_reservation("SO-1") == res
+
+
+def test_reserve_multiple_warehouses_and_duplicate_lines_kept(stocked):
+    lines = [("MAIN", "BOLT-M8", 3), ("NORTH", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 4)]
+    res = stocked.reserve("SO-1", iter(lines))
+    assert res.lines == tuple(ReservationLine(*l) for l in lines)
+    assert stocked.reserved("MAIN", "BOLT-M8") == 7
+    assert stocked.reserved("NORTH", "BOLT-M8") == 2
+
+
+def test_reserve_sums_duplicate_lines_for_check(stocked):
+    stocked.issue("MAIN", "BOLT-M8", 4)  # 6 left
+    before = stocked.log.lines()
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 4)])
+    assert (exc.value.requested, exc.value.available) == (7, 6)
+    assert stocked.log.lines() == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_reserve_rolls_back_on_shortage_in_any_line(stocked):
+    before = stocked.log.lines()
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("NORTH", "BOLT-M8", 6)])
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.log.lines() == before
+
+
+def test_reserve_only_from_available(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 3)])
+    assert exc.value.available == 2
+
+
+def test_duplicate_active_and_confirmed_even_after_expiry(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(DuplicateReservationError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert exc.value.order_id == "SO-1"
+    stocked.confirm("SO-1")
+    clock.advance(timedelta(hours=1))
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_replace_expired_and_cancelled(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=15))
+    new = stocked.reserve("SO-1", [("MAIN", "NUT-M8", 2)])
+    assert stocked.get_reservation("SO-1") == new
+    assert new.lines == (ReservationLine("MAIN", "NUT-M8", 2),)
+    stocked.cancel("SO-1")
+    again = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 5)], ttl=5 * MIN)
+    assert again.status is ReservationStatus.ACTIVE and again.expires_at == clock.now() + 5 * MIN
+
+
+def test_failed_replacement_keeps_old(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=20))
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 99)])
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 99)])
+    assert stocked.get_reservation("SO-2").status is ReservationStatus.CANCELLED
+
+
+# --- expiry -----------------------------------------------------------------
+
+
+def test_expiry_boundary(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)], ttl=10 * MIN)
+    clock.set(T0 + 10 * MIN - timedelta(microseconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert stocked.available("MAIN", "BOLT-M8") == 6
+    clock.set(T0 + 10 * MIN)
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+
+
+def test_expiry_not_logged(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    size = len(stocked.log)
+    clock.advance(timedelta(hours=1))
+    stocked.get_reservation("SO-1")
+    stocked.available("MAIN", "BOLT-M8")
+    assert len(stocked.log) == size
+
+
+def test_confirmed_and_cancelled_never_expire(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation("SO-2").status is ReservationStatus.CANCELLED
+
+
+def test_available_clamped_after_adjust(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    stocked.adjust("MAIN", "BOLT-M8", 5, "recount")
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    assert stocked.reserved("MAIN", "BOLT-M8") == 8
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5
+
+
+def test_queries_unknown_and_empty(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.available("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("MAIN", "NOPE")
+    assert stocked.available("MAIN", "OIL-5L") == 0
+    assert stocked.reserved("MAIN", "OIL-5L") == 0
+
+
+@pytest.mark.parametrize("method", ["get_reservation", "confirm", "cancel", "extend"])
+def test_not_found(stocked, method):
+    with pytest.raises(ReservationNotFoundError) as exc:
+        getattr(stocked, method)("NOPE")
+    assert exc.value.order_id == "NOPE"
+
+
+# --- confirm ----------------------------------------------------------------
+
+
+def test_confirm_with_zero_available_and_events(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 6), ("MAIN", "BOLT-M8", 4)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+    kinds = [e.kind for e in stocked.log.events()][3:]
+    assert kinds == ["RESERVE", "RESERVE", "ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    issues = stocked.log.events("ISSUE")
+    assert [e.get("qty") for e in issues] == ["6", "4"]
+    assert {e.get("ref") for e in issues} == {"SO-1"}
+    assert stocked.log.events("RESERVE")[0].get("expires") == "2026-03-01T10:15:00Z"
+    assert stocked.log.events("RESERVE_CONFIRM")[0].get("order") == "SO-1"
+
+
+def test_confirm_shortage_changes_nothing(stocked):
+    stocked.reserve("SO-1", [("MAIN", "NUT-M8", 2), ("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 4)])
+    stocked.adjust("MAIN", "BOLT-M8", 5, "recount")
+    before = stocked.log.lines()
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.confirm("SO-1")
+    assert (exc.value.requested, exc.value.available) == (7, 5)
+    assert stocked.on_hand("MAIN", "NUT-M8") == 10
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert stocked.log.lines() == before
+
+
+def test_confirm_bad_states(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=15))
+    before = stocked.log.lines()
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+    assert stocked.log.lines() == before
+
+
+# --- cancel / extend --------------------------------------------------------
+
+
+def test_cancel_idempotent_and_logged_once(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    size = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == size
+    assert len(stocked.log.events("RESERVE_CANCEL")) == 1
+
+
+def test_cancel_expired_and_confirmed(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(hours=1))
+    stocked.confirm("SO-2")
+    clock.advance(timedelta(minutes=15))
+    size = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-2")
+    assert len(stocked.log) == size
+
+
+def test_extend_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=10 * MIN)
+    clock.advance(5 * MIN)
+    res = stocked.extend("SO-1", ttl=30 * MIN)
+    assert res.expires_at == clock.now() + 30 * MIN
+    event = stocked.log.events("RESERVE_EXTEND")[0]
+    assert event.get("order") == "SO-1"
+    assert event.get("expires") == "2026-03-01T10:35:00Z"
+
+
+def test_extend_never_shortens(stocked, clock):
+    first = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=10 * MIN)
+    size = len(stocked.log)
+    clock.advance(5 * MIN)
+    assert stocked.extend("SO-1", ttl=5 * MIN) == first  # equal expiry
+    assert stocked.extend("SO-1", ttl=MIN) == first
+    assert len(stocked.log) == size
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", ttl=timedelta(0))
+    with pytest.raises(ValidationError):
+        stocked.extend("NOPE", ttl=-MIN)  # ttl is validated first
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2")
+    clock.advance(timedelta(minutes=15))
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-1")
+
+
+# --- issue / transfer -------------------------------------------------------
+
+
+def test_issue_respects_reservation_then_passes_after_expiry(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    before = stocked.log.lines()
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 3)
+    assert (exc.value.requested, exc.value.available) == (3, 2)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.log.lines() == before
+    stocked.issue("MAIN", "BOLT-M8", 2)
+    clock.advance(timedelta(minutes=15))
+    assert stocked.issue("MAIN", "BOLT-M8", 8) == 0
+
+
+def test_transfer_source_limited_by_available(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.transfer("MAIN", "SOUTH", "BOLT-M8", 3)
+    assert exc.value.available == 2
+    stocked.transfer("MAIN", "SOUTH", "BOLT-M8", 2)
+    assert stocked.on_hand("SOUTH", "BOLT-M8") == 2
+
+
+# --- package exports --------------------------------------------------------
+
+
+def test_public_exports():
+    for name in (
+        "Reservation",
+        "ReservationLine",
+        "ReservationStatus",
+        "ReservationError",
+        "DuplicateReservationError",
+        "ReservationNotFoundError",
+        "ReservationExpiredError",
+        "ReservationStateError",
+        "DEFAULT_RESERVATION_TTL",
+    ):
+        assert hasattr(warehouse, name) and name in warehouse.__all__
