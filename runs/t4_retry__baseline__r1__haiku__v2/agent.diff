+def test_requeue_keeps_dead_letter_order(queue, registry, clock):
+    def boom(job):
+        raise RuntimeError(job.payload["n"])
+
+    registry.register("t", boom)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    jobs = [queue.enqueue("t", {"n": n}) for n in range(3)]
+    Worker(queue, registry).run_pending()
+    assert [entry.job_id for entry in queue.dead_letters()] == [j.id for j in jobs]
+
+    queue.requeue_dead_letter(jobs[0].id)
+    assert [entry.job_id for entry in queue.dead_letters()] == [jobs[1].id, jobs[2].id]
