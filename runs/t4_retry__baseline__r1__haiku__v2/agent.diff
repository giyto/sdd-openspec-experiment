+def test_requeue_dead_letter_restarts_same_job(queue, registry, clock):
+    handler, calls = _flaky_handler(failures=1)
+    registry.register("t", handler)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    job = queue.enqueue("t")
+    worker = Worker(queue, registry)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+
+    clock.advance(100)
+    requeued = queue.requeue_dead_letter(job.id)
+
+    assert requeued is job
+    assert job.status is JobStatus.PENDING
+    assert job.run_at == clock.now()
+    assert job.error is None
+    assert job.attempts == 0
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.requeued") == 1
+
+    # после перезапуска первая же ошибка не уводит задание в dead-letter заново
+    worker.run_once()
+    assert job.status is JobStatus.SUCCEEDED
+    assert calls["n"] == 2
+
