+def test_is_retryable_respects_subclasses_and_permanent_errors():
+    class BadInput(ValueError):
+        pass
+
+    policy = RetryPolicy(non_retryable=(ValueError,))
+    assert not policy.is_retryable(ValueError("x"))
+    assert not policy.is_retryable(BadInput("x"))
+    assert not policy.is_retryable(PermanentJobError("no"))
+    assert policy.is_retryable(RuntimeError("timeout"))
+    assert RetryPolicy().is_retryable(ValueError("x"))
