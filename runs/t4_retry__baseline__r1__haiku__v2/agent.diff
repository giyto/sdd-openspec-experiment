+# -- Worker: повторы и dead-letter -------------------------------------------
+
+
+def _flaky_handler(failures: int):
+    calls = {"n": 0}
+
+    def handler(job):
+        calls["n"] += 1
+        if calls["n"] <= failures:
+            raise TimeoutError("gateway timeout")
+        return "ok"
+
+    return handler, calls
+
+
+def test_retry_then_success(queue, registry, clock):
+    handler, calls = _flaky_handler(failures=2)
+    registry.register("mail", handler)
+    queue.set_retry_policy("mail", RetryPolicy(max_attempts=3, base_delay=5.0))
+    worker = Worker(queue, registry)
+    job = queue.enqueue("mail")
+
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.error == "TimeoutError: gateway timeout"
+    assert job.run_at == START + timedelta(seconds=5)
+    assert worker.run_once() is None  # ещё рано
+
+    clock.advance(5)
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=5 + 10)
+
+    clock.advance(10)
+    worker.run_once()
+    assert job.status is JobStatus.SUCCEEDED
+    assert job.attempts == 3
+    assert job.error is None
+    assert calls["n"] == 3
+    assert queue.metrics.get("jobs.retried") == 2
+    assert queue.metrics.get("jobs.failed") == 0
+    assert queue.dead_letters() == []
+
+
+def test_exhausted_attempts_go_to_dead_letter(queue, registry, clock):
+    def boom(job):
+        raise TimeoutError("503")
+
+    registry.register("billing", boom)
+    queue.set_retry_policy("billing", RetryPolicy(max_attempts=2, base_delay=1.0))
+    worker = Worker(queue, registry)
+    job = queue.enqueue("billing")
+
+    worker.run_pending()
+    clock.advance(1)
+    worker.run_pending()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.attempts == 2
+    assert job.error == "TimeoutError: 503"
+    [entry] = queue.dead_letters()
+    assert entry.job_id == job.id
+    assert entry.job_type == "billing"
+    assert entry.attempts == 2
+    assert entry.error == "TimeoutError: 503"
+    assert entry.dead_lettered_at == START + timedelta(seconds=1)
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    assert queue.metrics.get("jobs.failed") == 0
+
+
