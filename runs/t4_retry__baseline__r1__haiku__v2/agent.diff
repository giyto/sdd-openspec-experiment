@@ -0,0 +1,99 @@
+"""Политика повторов упавших заданий: сколько попыток и с какой задержкой."""
+
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+
+from .errors import ConfigError, PermanentJobError
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Настройки повторов.
+
+    ``max_attempts`` — всего попыток, включая первую. После попытки номер ``n`` задержка
+    перед следующей равна ``base_delay * factor ** (n - 1)``, но не больше ``max_delay``.
+    ``jitter`` — относительный разброс задержки (от 0 до 1). ``non_retryable`` — классы
+    исключений, которые не повторяются (наследники тоже).
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not _is_int(self.max_attempts) or self.max_attempts < 1:
+            raise ConfigError("max_attempts must be an integer >= 1")
+        _check_number("base_delay", self.base_delay)
+        _check_number("factor", self.factor)
+        _check_number("max_delay", self.max_delay)
+        _check_number("jitter", self.jitter)
+        if self.base_delay < 0:
+            raise ConfigError("base_delay must be >= 0")
+        if self.factor < 1:
+            raise ConfigError("factor must be >= 1")
+        if self.max_delay < self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be in [0, 1]")
+
+        try:
+            types = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for item in types:
+            if not (isinstance(item, type) and issubclass(item, BaseException)):
+                raise ConfigError(f"non_retryable item {item!r} is not an exception class")
+        # хранится tuple, чтобы политика оставалась неизменяемой и хешируемой
+        object.__setattr__(self, "non_retryable", types)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка в секундах перед повтором, если упала попытка номер ``attempt`` (с 1).
+
+        Результат всегда лежит в ``[0, max_delay]``, в том числе с джиттером. ``rng``
+        используется только при ``jitter > 0`` и ровно один раз на вызов; без ``rng``
+        берётся генератор модуля ``random``.
+        """
+        if not _is_int(attempt) or attempt < 1:
+            raise ConfigError("attempt must be an integer >= 1")
+
+        delay = self._capped_delay(attempt)
+        if self.jitter > 0:
+            source = rng if rng is not None else random
+            delay = min(delay * source.uniform(1 - self.jitter, 1 + self.jitter), self.max_delay)
+        return float(delay)
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """Можно ли повторить задание, которое упало с исключением ``exc``."""
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
+
+    def _capped_delay(self, attempt: int) -> float:
+        if self.base_delay == 0:
+            return 0.0
+        if self.factor == 1:
+            growth = 1.0
+        else:
+            try:
+                growth = float(self.factor) ** (attempt - 1)
+            except OverflowError:
+                # очень большой номер попытки: задержка уже упёрлась в потолок
+                return float(self.max_delay)
+        return float(min(self.base_delay * growth, self.max_delay))
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _check_number(name: str, value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ConfigError(f"{name} must be a number")
+    if not math.isfinite(value):
+        raise ConfigError(f"{name} must be finite")
