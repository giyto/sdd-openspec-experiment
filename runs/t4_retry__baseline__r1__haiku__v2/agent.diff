+def test_delay_grows_exponentially_and_is_capped():
+    policy = RetryPolicy(max_attempts=10, base_delay=1.0, factor=2.0, max_delay=10.0)
+    assert [policy.delay_for(n) for n in range(1, 6)] == [1.0, 2.0, 4.0, 8.0, 10.0]
+
+
+def test_delay_for_huge_attempt_does_not_overflow():
+    policy = RetryPolicy(max_attempts=10000, base_delay=1.0, factor=2.0, max_delay=60.0)
+    assert policy.delay_for(5000) == 60.0
+    assert policy.delay_for(10**400) == 60.0
+
+
+def test_delay_with_factor_one_and_huge_attempt_stays_base():
+    policy = RetryPolicy(base_delay=3.0, factor=1.0, max_delay=60.0)
+    assert policy.delay_for(10**400) == 3.0
+
+
+def test_delay_with_zero_base_is_zero():
+    policy = RetryPolicy(base_delay=0.0, factor=2.0, max_delay=0.0)
+    assert policy.delay_for(1) == 0.0
+    assert policy.delay_for(5000) == 0.0
+
+
+def test_jitter_uses_one_uniform_per_delay_and_respects_cap():
+    calls = []
+
+    class Recording(random.Random):
+        def uniform(self, a, b):
+            calls.append((a, b))
+            return b  # максимально возможный множитель
+
+    policy = RetryPolicy(base_delay=1.0, factor=2.0, max_delay=10.0, jitter=0.5)
+
+    assert policy.delay_for(1, Recording()) == 1.5
+    assert policy.delay_for(4, Recording()) == 10.0  # 8 * 1.5 = 12, упирается в max_delay
+    assert calls == [(0.5, 1.5), (0.5, 1.5)]
+
+
+def test_jitter_zero_does_not_touch_rng():
+    rng = random.Random(7)
+    state = rng.getstate()
+    RetryPolicy(jitter=0.0).delay_for(2, rng)
+    assert rng.getstate() == state
+
+
+def test_jitter_stays_within_bounds():
+    rng = random.Random(1)
+    policy = RetryPolicy(base_delay=2.0, factor=2.0, max_delay=30.0, jitter=0.25)
+    for attempt in range(1, 8):
+        base = min(2.0 * 2.0 ** (attempt - 1), 30.0)
+        delay = policy.delay_for(attempt, rng)
+        assert 0 <= delay <= 30.0
+        assert base * 0.75 <= delay <= min(base * 1.25, 30.0)
+
