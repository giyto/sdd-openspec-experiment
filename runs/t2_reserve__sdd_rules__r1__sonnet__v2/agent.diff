     """Строку журнала невозможно записать или разобрать."""
+
+
+class ReservationError(WarehouseError):
+    """Базовая ошибка операций с резервами."""
+
+    def __init__(self, order_id: str, message: str | None = None) -> None:
+        super().__init__(message or f"reservation error for order {order_id!r}")
+        self.order_id = order_id
+
+
+class ReservationNotFoundError(ReservationError):
+    """Резерва по заказу нет."""
+
+    def __init__(self, order_id: str, message: str | None = None) -> None:
+        super().__init__(order_id, message or f"no reservation for order {order_id!r}")
+
+
+class ReservationExpiredError(ReservationError):
+    """Резерв истёк."""
+
+    def __init__(self, order_id: str, message: str | None = None) -> None:
+        super().__init__(order_id, message or f"reservation for order {order_id!r} has expired")
+
+
+class ReservationStateError(ReservationError):
+    """Операция недопустима в текущем статусе резерва."""
+
+    def __init__(self, order_id: str, message: str | None = None) -> None:
+        super().__init__(order_id, message or f"invalid reservation state for order {order_id!r}")
+
+
+class DuplicateReservationError(ReservationError):
+    """По заказу уже есть активный или подтверждённый резерв."""
+
+    def __init__(self, order_id: str, message: str | None = None) -> None:
+        super().__init__(order_id, message or f"order {order_id!r} already has a reservation")
