diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..a00d42f
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,348 @@
+from datetime import timedelta
+
+import pytest
+
+from tests.conftest import T0
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    Reservation,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationLine,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ReservationStatus,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.reservations import ReservationRecord, effective_status
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 5)
+    inv.receive("B", "NUT-M8", 3)
+    return inv
+
+
+def kinds(inv):
+    return [e.kind for e in inv.log]
+
+
+# --- models / errors / records -------------------------------------------
+
+
+def test_enum_values_and_snapshots():
+    assert [s.value for s in ReservationStatus] == ["active", "expired", "confirmed", "cancelled"]
+    line = ReservationLine("A", "BOLT-M8", 1)
+    r = Reservation("SO-1", (line,), T0, T0 + MIN, ReservationStatus.ACTIVE)
+    assert r.lines == (line,) and r.status == "active"
+
+
+@pytest.mark.parametrize(
+    "cls",
+    [ReservationNotFoundError, ReservationExpiredError, ReservationStateError, DuplicateReservationError],
+)
+def test_errors_hierarchy(cls):
+    err = cls("SO-1")
+    assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+    assert not isinstance(err, ValidationError)
+    assert err.order_id == "SO-1"
+
+
+def test_effective_status_boundary():
+    rec = ReservationRecord("SO-1", (), T0, T0 + 15 * MIN)
+    assert effective_status(rec, T0 + 15 * MIN - timedelta(seconds=1)) is ReservationStatus.ACTIVE
+    assert effective_status(rec, T0 + 15 * MIN) is ReservationStatus.EXPIRED
+    assert DEFAULT_RESERVATION_TTL == 15 * MIN
+
+
+# --- reserve / queries ------------------------------------------------------
+
+
+def test_reserve_multi_warehouse(stocked):
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3)])
+    assert r.status is ReservationStatus.ACTIVE
+    assert r.lines == (ReservationLine("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3))
+    assert r.created_at == T0 and r.expires_at == T0 + 15 * MIN
+    assert stocked.on_hand("A", "BOLT-M8") == 5
+    events = stocked.log.events("RESERVE")
+    assert [e.get("qty") for e in events] == ["2", "3"]
+    assert events[0].get("expires") == "2026-03-01T10:15:00Z"
+    assert events[0].get("order") == "SO-1"
+
+
+def test_reserve_explicit_ttl(stocked):
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=5 * MIN)
+    assert r.expires_at == T0 + 5 * MIN
+
+
+def test_reserve_same_position_twice(stocked):
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 3), ("A", "BOLT-M8", 2)])
+    assert len(r.lines) == 2
+    assert stocked.reserved("A", "BOLT-M8") == 5
+
+
+def test_reserve_sum_exceeds_available(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 3), ("A", "BOLT-M8", 3)])
+    assert (exc.value.requested, exc.value.available) == (6, 5)
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 5, True])
+def test_reserve_bad_ttl(stocked, ttl):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=ttl)
+
+
+def test_reserve_empty_and_bad_order_id(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO 1", [("A", "BOLT-M8", 1)])
+
+
+def test_reserve_invalid_line_is_atomic(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1), ("A", "BOLT-M8", 0)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("A", "NOPE", 1)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A B", "BOLT-M8", 1)])
+    assert stocked.reserved("A", "BOLT-M8") == 0 and len(stocked.log) == before
+
+
+def test_reserve_insufficient_second_line_is_atomic(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1), ("B", "NUT-M8", 9)])
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert len(stocked.log) == before
+
+
+def test_available_and_reserved(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    assert (stocked.reserved("A", "BOLT-M8"), stocked.available("A", "BOLT-M8")) == (2, 3)
+    assert stocked.on_hand("A", "BOLT-M8") == 5
+    assert stocked.available("C", "OIL-5L") == 0
+    with pytest.raises(UnknownSkuError):
+        stocked.available("A", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("A", "NOPE")
+
+
+def test_available_clamped_after_adjust(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    stocked.adjust("A", "BOLT-M8", 1, "count")
+    assert stocked.available("A", "BOLT-M8") == 0
+    assert stocked.reserved("A", "BOLT-M8") == 4
+
+
+def test_cannot_reserve_beyond_available(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-2", [("A", "BOLT-M8", 2)])
+
+
+# --- expiry -----------------------------------------------------------------
+
+
+def test_expiry(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    clock.advance(15 * MIN - timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert stocked.reserved("A", "BOLT-M8") == 2
+    clock.advance(timedelta(seconds=1))
+    before = len(stocked.log)
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert stocked.available("A", "BOLT-M8") == 5
+    assert len(stocked.log) == before
+
+
+def test_confirmed_never_expires(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    stocked.confirm("SO-1")
+    clock.advance(timedelta(hours=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+
+
+def test_get_reservation_not_found(stocked):
+    with pytest.raises(ReservationNotFoundError) as exc:
+        stocked.get_reservation("SO-404")
+    assert exc.value.order_id == "SO-404"
+    for op in (stocked.confirm, stocked.cancel, lambda o: stocked.extend(o, MIN)):
+        with pytest.raises(ReservationNotFoundError):
+            op("SO-404")
+
+
+# --- duplicates -------------------------------------------------------------
+
+
+def test_duplicates_and_replacement(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    assert stocked.get_reservation("SO-1").lines == (ReservationLine("A", "BOLT-M8", 1),)
+    stocked.cancel("SO-1")
+    clock.advance(MIN)
+    r = stocked.reserve("SO-1", [("B", "NUT-M8", 1)])
+    assert r.lines == (ReservationLine("B", "NUT-M8", 1),) and r.created_at == T0 + MIN
+    clock.advance(20 * MIN)  # expired
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    assert stocked.get_reservation("SO-1").lines == r.lines
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+
+
+# --- confirm ----------------------------------------------------------------
+
+
+def test_confirm_with_zero_available(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 5)])
+    assert stocked.available("A", "BOLT-M8") == 0
+    r = stocked.confirm("SO-1")
+    assert r.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("A", "BOLT-M8") == 0
+
+
+def test_confirm_events(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 1)])
+    n = len(stocked.log)
+    stocked.confirm("SO-1")
+    new = stocked.log.events()[n:]
+    assert [e.kind for e in new] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert new[0].get("ref") == "SO-1" and new[2].get("order") == "SO-1"
+
+
+def test_confirm_insufficient_physical(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 3)])
+    stocked.adjust("B", "NUT-M8", 1, "count")
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert stocked.on_hand("A", "BOLT-M8") == 5 and stocked.on_hand("B", "NUT-M8") == 1
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert len(stocked.log) == n
+
+
+def test_confirm_duplicate_lines(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 3), ("A", "BOLT-M8", 2)])
+    stocked.adjust("A", "BOLT-M8", 4, "count")
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.confirm("SO-1")
+    assert (exc.value.requested, exc.value.available) == (5, 4)
+    assert stocked.on_hand("A", "BOLT-M8") == 4 and len(stocked.log) == n
+
+
+def test_confirm_expired_and_repeated(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-3")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-3")
+    clock.advance(15 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-1")
+
+
+# --- cancel -----------------------------------------------------------------
+
+
+def test_cancel_active_and_idempotent(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    r = stocked.cancel("SO-1")
+    assert r.status is ReservationStatus.CANCELLED
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert kinds(stocked).count("RESERVE_CANCEL") == 1
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == n
+
+
+def test_cancel_expired_and_confirmed(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)], ttl=30 * MIN)
+    stocked.confirm("SO-2")
+    clock.advance(15 * MIN)
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == n
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-2")
+
+
+# --- extend -----------------------------------------------------------------
+
+
+def test_extend_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(10 * MIN)
+    r = stocked.extend("SO-1", 20 * MIN)
+    assert r.expires_at == T0 + 30 * MIN
+    e = stocked.log.events("RESERVE_EXTEND")
+    assert len(e) == 1 and e[0].get("expires") == "2026-03-01T10:30:00Z"
+
+
+def test_extend_never_shortens(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(MIN)
+    n = len(stocked.log)
+    assert stocked.extend("SO-1", 5 * MIN).expires_at == T0 + 15 * MIN
+    assert stocked.extend("SO-1", 14 * MIN).expires_at == T0 + 15 * MIN  # equal
+    assert len(stocked.log) == n
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2", MIN)
+    clock.advance(15 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-1", MIN)
+
+
+# --- issue / transfer -------------------------------------------------------
+
+
+def test_issue_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("A", "BOLT-M8", 2)
+    assert exc.value.available == 1 and stocked.on_hand("A", "BOLT-M8") == 5
+    stocked.issue("A", "BOLT-M8", 1)
+    assert stocked.on_hand("A", "BOLT-M8") == 4
+
+
+def test_transfer_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("A", "B", "BOLT-M8", 2)
+    stocked.transfer("A", "B", "BOLT-M8", 1)
+
+
+def test_expired_reservation_does_not_block_issue(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    clock.advance(15 * MIN)
+    assert stocked.issue("A", "BOLT-M8", 5) == 0
