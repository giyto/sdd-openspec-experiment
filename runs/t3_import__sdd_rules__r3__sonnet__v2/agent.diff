+import pytest
+
+from ledger.errors import LedgerError, StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule, normalize_text
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1 200,50;Магазин Лента\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+)
+SPLIT = "Дата;Описание;Приход;Расход\n01.03.2026;Кофе;;150,00\n02.03.2026;Зарплата;85 000,00;0,00\n"
+
+
+def test_exceptions_hierarchy():
+    for cls in (UnknownFormatError, StatementRowError):
+        exc = cls("boom", line_no=7)
+        assert isinstance(exc, StatementError) and isinstance(exc, LedgerError)
+        assert exc.line_no == 7
+
+
+def test_normalize_description_delegates():
+    for text in ("  Магазин   ЛЕНТА ", "Ёлка", "a\tb"):
+        assert normalize_description(text) == normalize_text(text)
+
+
+def test_import_sfera(write_csv, clock):
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA), store, clock=clock)
+    assert (res.format, res.encoding, res.added, res.duplicates, res.errors) == (
+        "sfera", "utf-8", 2, 0, [],
+    )
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+    assert all(t.imported_at == clock.now() for t in store.all())
+
+
+def test_detect_format_matches_import(write_csv):
+    path = write_csv(SPLIT)
+    assert detect_format(path) == "sfera_split"
+    assert import_statement(path, MemoryStore()).format == "sfera_split"
+
+
+def test_split_amounts(write_csv):
+    store = MemoryStore()
+    res = import_statement(write_csv(SPLIT), store)
+    assert res.errors == []
+    assert [t.amount for t in store.all()] == [Decimal("-150.00"), Decimal("85000.00")]
+
