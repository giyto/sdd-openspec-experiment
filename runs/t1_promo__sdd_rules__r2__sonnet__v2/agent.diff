@@ -0,0 +1,143 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+T0 = datetime(2026, 6, 1, tzinfo=timezone.utc)
+T1 = datetime(2026, 7, 1, tzinfo=timezone.utc)
+
+
+def make(code="SUMMER10", **kw):
+    kw.setdefault("kind", DiscountKind.PERCENT)
+    kw.setdefault("value", Decimal("10"))
+    return PromoCode(code, **kw)
+
+
+def test_error_hierarchy():
+    trio = [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError]
+    for a in trio:
+        assert issubclass(a, PromoError) and issubclass(a, ShopError)
+        for b in trio:
+            if a is not b:
+                assert not issubclass(a, b)
+
+
+def test_code_normalized():
+    assert make("  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize(
+    "kw",
+    [
+        {"code": "   "},
+        {"value": Decimal("0")},
+        {"value": Decimal("100.01")},
+        {"value": 10},
+        {"kind": "percent"},
+        {"kind": DiscountKind.FIXED, "value": Decimal("0")},
+        {"kind": DiscountKind.FIXED, "value": Decimal("10.001")},
+        {"min_order_amount": Decimal("-1")},
+        {"min_order_amount": Decimal("1.001")},
+        {"min_order_amount": 5},
+        {"starts_at": datetime(2026, 1, 1)},
+        {"expires_at": datetime(2026, 1, 1)},
+        {"starts_at": T0, "expires_at": T0},
+        {"starts_at": T1, "expires_at": T0},
+        {"max_uses": 0},
+        {"max_uses": True},
+        {"max_uses": 1.5},
+        {"excluded_categories": frozenset({"books"})},
+    ],
+)
+def test_invalid(kw):
+    with pytest.raises(ValidationError):
+        make(**kw)
+
+
+@pytest.mark.parametrize(
+    "kw",
+    [
+        {"value": Decimal("100")},
+        {"value": Decimal("0.5")},
+        {"kind": DiscountKind.FIXED, "value": Decimal("0.01")},
+        {"max_uses": 1},
+        {"starts_at": T0, "expires_at": T1},
+    ],
+)
+def test_valid_boundaries(kw):
+    make(**kw)
+
+
+@pytest.fixture
+def clock():
+    return FixedClock(T0)
+
+
+@pytest.fixture
+def reg(clock):
+    r = PromoRegistry(clock)
+    r.add(make(starts_at=T0, expires_at=T1, max_uses=2))
+    return r
+
+
+def test_duplicate(reg):
+    with pytest.raises(ValidationError):
+        reg.add(make(" summer10"))
+    assert reg.resolve("SUMMER10").value == Decimal("10")
+
+
+def test_resolve_case_and_unknown(reg):
+    assert reg.resolve("  summer10 ").code == "SUMMER10"
+    for bad in ("NOPE", "", "   "):
+        with pytest.raises(UnknownPromoCodeError):
+            reg.resolve(bad)
+    with pytest.raises(ValidationError):
+        reg.resolve(None)
+
+
+def test_period_bounds(reg, clock):
+    reg.resolve("SUMMER10")  # starts_at inclusive
+    clock.set(T0 - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+    clock.set(T1 - timedelta(seconds=1))
+    reg.resolve("SUMMER10")
+    clock.set(T1)
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_check_order_and_limit(reg, clock):
+    reg.record_use("SUMMER10")
+    reg.resolve("SUMMER10")
+    reg.record_use("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("SUMMER10")
+    clock.set(T1)
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_counter(reg, clock):
+    assert reg.uses(" summer10") == 0
+    reg.release_use("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.resolve("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.record_use("SUMMER10")
+    clock.set(T1 + timedelta(days=1))
+    reg.release_use("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    with pytest.raises(UnknownPromoCodeError):
+        reg.uses("NOPE")
