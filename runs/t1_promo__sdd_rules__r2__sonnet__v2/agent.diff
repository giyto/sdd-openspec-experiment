+++ b/tests/test_pricing_promo.py
@@ -0,0 +1,155 @@
+import inspect
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import LineTotal, OrderTotal, ShippingPolicy, TaxPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def pct(v, **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(v), **kw)
+
+
+def fixed(v, **kw):
+    return PromoCode("F", DiscountKind.FIXED, D(v), **kw)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for i, (cat, price, qty) in enumerate(items):
+        cart.add(Product(f"SKU-{i}", f"Item {i}", D(price), cat), qty)
+    return cart
+
+
+def test_promo_keyword_only():
+    cart = cart_of((Category.BOOKS, "100.00", 1))
+    with pytest.raises(TypeError):
+        calculate_total(cart, None, None, pct("10"))
+    assert calculate_total(cart, promo=pct("10")).discount == D("10.00")
+    param = inspect.signature(calculate_total).parameters["promo"]
+    assert param.kind is inspect.Parameter.KEYWORD_ONLY
+
+
+def test_no_promo_unchanged():
+    cart = cart_of((Category.ELECTRONICS, "1000.00", 1), (Category.BOOKS, "100.00", 2))
+    t = calculate_total(cart)
+    assert t.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in t.lines)
+    assert t.total == t.subtotal + t.shipping + t.tax
+    assert t.subtotal == D("1200.00") and t.shipping == D("299.00") and t.tax == D("220.00")
+
+
+def test_defaults_and_positional_construction():
+    line = LineTotal("A", Category.BOOKS, 1, D("1.00"), D("1.00"), D("0.10"))
+    assert line.discount == D("0.00")
+    assert OrderTotal((line,), D("1"), D("0"), D("0"), D("1")).discount == D("0.00")
+
+
+def test_excluded_and_gift_cards():
+    cart = cart_of(
+        (Category.GIFT_CARD, "1000.00", 1),
+        (Category.FOOD, "500.00", 1),
+        (Category.ELECTRONICS, "1000.00", 1),
+    )
+    t = calculate_total(cart, promo=pct("10", excluded_categories=frozenset({Category.FOOD})))
+    assert [l.discount for l in t.lines] == [D("0.00"), D("0.00"), D("100.00")]
+    t = calculate_total(cart, promo=pct("10", excluded_categories=frozenset({Category.GIFT_CARD})))
+    assert t.lines[0].discount == D("0.00")
+
+
+def test_percent_rounding_and_fixed_cap():
+    t = calculate_total(cart_of((Category.CLOTHING, "333.30", 1)), promo=pct("15"))
+    assert t.discount == D("50.00")
+    t = calculate_total(cart_of((Category.CLOTHING, "300.00", 1)), promo=fixed("500"))
+    assert t.discount == D("300.00") and t.tax == D("0.00")
+
+
+def test_hundred_percent():
+    t = calculate_total(cart_of((Category.ELECTRONICS, "500.00", 1)), promo=pct("100"))
+    assert t.discount == D("500.00") and t.tax == D("0.00")
+    assert t.total == D("299.00")
+
+
+def test_tax_after_discount():
+    t = calculate_total(cart_of((Category.ELECTRONICS, "1000.00", 1)), promo=fixed("100"))
+    assert t.lines[0].tax == D("180.00") and t.lines[0].amount == D("1000.00")
+
+
+def test_min_order_amount_boundary():
+    cart = cart_of((Category.CLOTHING, "1000.00", 1))
+    ok = calculate_total(cart, promo=pct("10", min_order_amount=D("1000.00")))
+    assert ok.discount == D("100.00")
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct("10", min_order_amount=D("1000.01")))
+
+
+def test_min_order_excludes_categories():
+    cart = cart_of((Category.CLOTHING, "900.00", 1), (Category.FOOD, "300.00", 1))
+    promo = pct("10", min_order_amount=D("1000.00"), excluded_categories=frozenset({Category.FOOD}))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo)
+
+
+def test_no_eligible_lines():
+    cart = cart_of((Category.GIFT_CARD, "500.00", 1), (Category.FOOD, "100.00", 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct("10", excluded_categories=frozenset({Category.FOOD})))
+
+
+def test_equal_remainders_go_to_earlier_line():
+    cart = cart_of(*[(Category.CLOTHING, "100.00", 1)] * 3)
+    t = calculate_total(cart, promo=fixed("10"))
+    assert [l.discount for l in t.lines] == [D("3.34"), D("3.33"), D("3.33")]
+
+
+def test_largest_remainder_beats_order():
+    # 0.01 over 1.00 and 2.00: remainders favour the second line
+    cart = cart_of((Category.CLOTHING, "1.00", 1), (Category.CLOTHING, "2.00", 1))
+    t = calculate_total(cart, promo=fixed("0.01"))
+    assert [l.discount for l in t.lines] == [D("0.00"), D("0.01")]
+
+
+@pytest.mark.parametrize(
+    "items,promo",
+    [
+        (
+            [(Category.CLOTHING, "33.33", 3), (Category.BOOKS, "10.01", 7), (Category.FOOD, "0.99", 13)],
+            pct("17.5"),
+        ),
+        ([(Category.CLOTHING, "1.00", 1)] * 7, fixed("0.05")),
+        (
+            [(Category.CLOTHING, "19.99", 2), (Category.GIFT_CARD, "100.00", 1), (Category.BOOKS, "7.77", 9)],
+            fixed("33.33"),
+        ),
+        ([(Category.ELECTRONICS, "99999.99", 3), (Category.FOOD, "0.01", 1)], pct("99.99")),
+    ],
+)
+def test_line_discounts_sum_to_total(items, promo):
+    t = calculate_total(cart_of(*items), promo=promo)
+    assert sum(l.discount for l in t.lines) == t.discount
+    assert t.total == t.subtotal - t.discount + t.shipping + t.tax
+    assert all(0 <= l.discount <= l.amount for l in t.lines)
+
+
+def test_free_shipping_threshold_after_discount():
+    cart = cart_of((Category.CLOTHING, "3100.00", 1))
+    assert calculate_total(cart, promo=fixed("200")).shipping == D("299.00")
+    assert calculate_total(cart, promo=fixed("100")).shipping == D("0.00")
+    assert calculate_total(cart).shipping == D("0.00")
+
+
+def test_custom_policies_with_promo():
+    cart = cart_of((Category.BOOKS, "1000.00", 1))
+    shipping = ShippingPolicy(fee=D("50.00"), free_threshold=None)
+    t = calculate_total(cart, shipping, TaxPolicy(), promo=pct("10"))
+    assert (t.discount, t.tax, t.shipping, t.total) == (
+        D("100.00"),
+        D("90.00"),
+        D("50.00"),
+        D("1040.00"),
+    )
