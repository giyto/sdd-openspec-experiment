+++ b/tests/test_orders_promo.py
@@ -0,0 +1,148 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    EmptyCartError,
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.orders import OrderService
+from shop.pricing import calculate_total
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(
+        PromoCode(
+            "SUMMER10",
+            DiscountKind.PERCENT,
+            Decimal("10"),
+            min_order_amount=Decimal("500.00"),
+            expires_at=clock.now() + timedelta(days=1),
+            max_uses=1,
+        )
+    )
+    return reg
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def cart(products):
+    c = Cart()
+    c.add(products["shirt"])
+    return c
+
+
+def test_no_code_variants(service, cart):
+    base = service.quote(cart)
+    for code in (None, "", "   "):
+        assert service.quote(cart, code) == base
+        assert service.place_order(cart, code).promo_code is None
+
+
+def test_no_registry(clock, cart):
+    bare = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        bare.quote(cart, "SUMMER10")
+    assert bare.quote(cart, " ") == bare.quote(cart)
+
+
+def test_non_string(service, cart):
+    with pytest.raises(ValidationError):
+        service.quote(cart, 10)
+
+
+def test_empty_cart_first(service):
+    with pytest.raises(EmptyCartError):
+        service.quote(Cart(), "NOPE")
+    with pytest.raises(EmptyCartError):
+        service.place_order(Cart(), "SUMMER10")
+
+
+def test_quote_applies_and_does_not_spend(service, registry, cart):
+    for _ in range(3):
+        assert service.quote(cart, "summer10").discount == Decimal("99.90")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_place_order_normalizes_and_counts(service, registry, cart):
+    order = service.place_order(cart, " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == Decimal("99.90")
+    assert order.total == calculate_total(cart, promo=registry._promos["SUMMER10"])
+    assert registry.uses("SUMMER10") == 1
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "SUMMER10")
+    assert len(service.store) == 1
+
+
+def test_failed_attempts_do_not_spend(service, registry, products):
+    small = Cart()
+    small.add(products["tea"])
+    with pytest.raises(PromoConditionsError):
+        service.place_order(small, "SUMMER10")
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(small, "NOPE")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def test_expired(service, clock, cart):
+    clock.advance(timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        service.place_order(cart, "SUMMER10")
+
+
+def test_cancel_releases(service, registry, cart):
+    order = service.place_order(cart, "SUMMER10")
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+    assert service.place_order(cart, "SUMMER10").promo_code == "SUMMER10"
+
+
+def test_cancel_after_expiry(service, registry, clock, cart):
+    order = service.place_order(cart, "SUMMER10")
+    clock.advance(timedelta(days=5))
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_cancel_without_code_keeps_counter(service, registry, cart):
+    service.place_order(cart, "SUMMER10")
+    plain = service.place_order(cart)
+    service.cancel(plain.order_id)
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_cancel_without_registry(clock, cart, registry):
+    with_reg = OrderService(clock=clock, promos=registry)
+    order = with_reg.place_order(cart, "SUMMER10")
+    bare = OrderService(with_reg.store, clock=clock)
+    assert bare.cancel(order.order_id).promo_code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_backward_compat(clock, cart):
+    service = OrderService(clock=clock)
+    t = service.quote(cart)
+    assert t == calculate_total(cart)
+    assert t.discount == Decimal("0.00")
+    order = service.place_order(cart)
+    assert order.total == t and order.promo_code is None
