+def test_dead_letters_order_copy_and_requeue(queue, clock):
+    assert queue.dead_letters() == []
+    a, b = queue.enqueue("t"), queue.enqueue("t")
+    for j in (a, b):
+        queue.mark_running(j.id)
+        queue.mark_dead_lettered(j.id, "E: x")
+    entries = queue.dead_letters()
+    assert [e.job_id for e in entries] == [a.id, b.id]
+    assert entries[0].attempts == 1 and entries[0].error == "E: x"
+    assert entries[0].dead_lettered_at == clock.now()
+    entries.clear()
+    assert len(queue.dead_letters()) == 2
+
+    clock.advance(10)
+    job = queue.requeue_dead_letter(a.id)
+    assert job is a and job.status is JobStatus.PENDING
+    assert (job.run_at, job.error, job.attempts) == (clock.now(), None, 0)
+    assert [e.job_id for e in queue.dead_letters()] == [b.id]
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 1
+
