+def test_due_includes_retry_in_order(queue, clock):
+    a = queue.enqueue("t")
+    b = queue.enqueue("t")
+    queue.mark_running(a.id)
+    queue.mark_retry_scheduled(a.id, "E: x", clock.now() + timedelta(seconds=5))
+    assert queue.store.due(clock.now()) == [b]
+    clock.advance(5)
+    assert queue.store.due(clock.now()) == [b, a]
