+def test_purge_keeps_dead_letter_and_retry(queue, clock):
+    ok, dead, retry = (queue.enqueue("t") for _ in range(3))
+    for j in (ok, dead, retry):
+        queue.mark_running(j.id)
+    queue.mark_succeeded(ok.id)
+    queue.mark_dead_lettered(dead.id, "E")
+    queue.mark_retry_scheduled(retry.id, "E", clock.now())
+    clock.advance(1000)
+    assert queue.purge_finished() == 1
+    assert len(queue.dead_letters()) == 1
