@@ -0,0 +1,430 @@
+import itertools
+import math
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    HandlerRegistry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobQueue,
+    JobqError,
+    JobStatus,
+    ManualClock,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq import metrics as m
+from jobq.dashboard import render_report
+from tests.conftest import START
+
+
+def flaky(failures, exc=TimeoutError):
+    state = {"n": 0}
+
+    def handler(job):
+        state["n"] += 1
+        if state["n"] <= failures:
+            raise exc("gw")
+        return "ok"
+
+    return handler
+
+
+def boom(exc):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+def make(policy, handler, *, rng=None):
+    clock = ManualClock(START)
+    queue = JobQueue(clock=clock, default_retry_policy=policy)
+    reg = HandlerRegistry()
+    if handler is not None:
+        reg.register("t", handler)
+    return clock, queue, Worker(queue, reg, rng=rng)
+
+
+# -- errors / models / metrics ------------------------------------------------
+
+
+def test_permanent_error_hierarchy():
+    assert issubclass(PermanentJobError, JobqError)
+
