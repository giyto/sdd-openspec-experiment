+def test_cancel_retry_and_dead_letter(queue):
+    a = queue.enqueue("t")
+    queue.mark_running(a.id)
+    queue.mark_retry_scheduled(a.id, "E", queue.clock.now())
+    assert queue.cancel(a.id).status is JobStatus.CANCELLED
+    assert queue.metrics.get(m.JOBS_CANCELLED) == 1
+    b = queue.enqueue("t")
+    queue.mark_running(b.id)
+    queue.mark_dead_lettered(b.id, "E")
+    with pytest.raises(InvalidTransitionError):
+        queue.cancel(b.id)
+    assert b.status is JobStatus.DEAD_LETTERED
