+    assert j.run_at == START + timedelta(seconds=expected)
+    clock.advance(100)
+    w.run_once()  # dead-letter
+    assert rng.calls == 1
+
+    rng0 = Spy(3)
+    _, q0, w0 = make(RetryPolicy(jitter=0), boom(TimeoutError()), rng=rng0)
+    q0.enqueue("t")
+    w0.run_once()
+    assert rng0.calls == 0
+
+    rng1 = Spy(3)
+    _, q1, w1 = make(RetryPolicy(jitter=0.5, non_retryable=(TimeoutError,)), boom(TimeoutError()), rng=rng1)
+    q1.enqueue("t")
