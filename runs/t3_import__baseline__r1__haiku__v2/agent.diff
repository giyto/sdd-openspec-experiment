+def detect_format(path: str | os.PathLike[str]) -> str:
+    """Определяет формат выписки по заголовку: "nova", "sfera" или "sfera_split"."""
+    text, _ = _read_text(path)
+    name, _, _ = _detect(text, None)
+    return name
+
+
+def import_csv(
+    path: str | os.PathLike[str],
+    store: MemoryStore,
+    categorizer: Categorizer | None = None,
+    clock: Clock | None = None,
+) -> int:
+    """Импортирует выписку «Новы» в store и возвращает число добавленных транзакций.
+
+    Совместимая обёртка над import_statement: строгий импорт формата nova.
+    """
+    result = import_statement(
+        path, store, fmt="nova", strict=True, categorizer=categorizer, clock=clock
+    )
+    return result.added
+
+
+def _read_text(path: str | os.PathLike[str]) -> tuple[str, str]:
+    raw = Path(path).read_bytes()
+    try:
+        return raw.decode("utf-8-sig"), "utf-8"
+    except UnicodeDecodeError:
+        pass
+    try:
+        return raw.decode("cp1251"), "cp1251"
+    except UnicodeDecodeError as exc:
+        raise StatementError(f"cannot decode {path}: neither utf-8 nor cp1251") from exc
+
+
+def _records(text: str, delimiter: str) -> Iterator[tuple[int, list[str] | None, str | None]]:
+    """Записи CSV как (номер строки, поля, ошибка csv).
+
+    Номер строки — физическая строка, с которой начинается запись. Если запись не
+    разобралась, поля None, а ошибка — текст из csv.Error.
+    """
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    start = 1
+    while True:
+        try:
+            fields = next(reader)
+        except StopIteration:
+            return
+        except csv.Error as exc:
+            yield start, None, str(exc)
+        else:
+            yield start, fields, None
+        start = reader.line_num + 1
+
+
+def _is_junk(fields: list[str]) -> bool:
+    """Пустая строка, строка из пробелов или из одних разделителей (`;;;` или `,,`)."""
+    return all(not field.strip().strip(",;").strip() for field in fields)
+
+
+def _find_header(text: str, delimiter: str) -> tuple[int, list[str]] | None:
+    for line_no, fields, error in _records(text, delimiter):
+        if error is None and fields is not None and not _is_junk(fields):
+            return line_no, fields
+    return None
+
+
+def _match_header(fields: list[str], spec: _Spec) -> dict[str, int] | None:
+    names = [normalize_text(field) for field in fields]
+    indexes = {}
+    for key, column in spec.columns.items():
+        if names.count(column) != 1:
+            return None
+        indexes[key] = names.index(column)
+    return indexes
+
+
+def _detect(text: str, fmt: str | None) -> tuple[str, int, dict[str, int]]:
+    """Возвращает (формат, номер строки заголовка, индексы колонок)."""
+    if fmt is not None and fmt not in _SPECS:
+        raise UnknownFormatError(f"unknown format {fmt!r}")
+    candidates = [fmt] if fmt is not None else list(_SPECS)
+    matches = []
+    for name in candidates:
+        spec = _SPECS[name]
+        found = _find_header(text, spec.delimiter)
+        if found is None:
+            continue
+        header_line, fields = found
+        indexes = _match_header(fields, spec)
+        if indexes is not None:
+            matches.append((name, header_line, indexes))
+    if len(matches) == 1:
+        return matches[0]
+    reason = "header matches several formats" if matches else "header not recognized"
+    raise UnknownFormatError(f"cannot detect statement format: {reason}", line_no=_first_line(text))
+
+
+def _first_line(text: str) -> int | None:
+    return next((n for n, line in enumerate(text.splitlines(), start=1) if line.strip()), None)
+
+
+def _cells(indexes: dict[str, int], fields: list[str]) -> dict[str, str]:
+    cells = {}
+    for key, idx in indexes.items():
+        if idx >= len(fields):
+            raise ValidationError("not enough fields")
+        cells[key] = fields[idx]
+    return cells
+
+
+def _key(tx: Transaction) -> tuple[dt.date, Decimal, str]:
+    return (tx.date, tx.amount, normalize_description(tx.description))
+
+
+def _parse_sfera_date(text: str) -> dt.date:
+    value = text.strip()
+    if not _SFERA_DATE.fullmatch(value):
+        raise ValidationError(f"invalid date {text!r}")
+    try:
+        return dt.datetime.strptime(value, "%d.%m.%Y").date()
+    except ValueError as exc:
+        raise ValidationError(f"invalid date {text!r}") from exc
+
+
+def _parse_sfera_amount(text: str, *, signed: bool) -> Decimal:
+    value = text.strip()
+    match = _SFERA_AMOUNT.fullmatch(value)
+    if match is None or (not signed and match["sign"]):
+        raise ValidationError(f"invalid amount {text!r}")
+    whole = _GROUP_SEPARATORS.sub("", match["whole"])
+    frac = match["frac"] or "0"
+    return to_money(Decimal(f"{match['sign']}{whole}.{frac}"))
+
+
+def _build_nova(cells: dict[str, str], imported_at: dt.datetime) -> Transaction:
+    try:
+        date = dt.date.fromisoformat(cells["date"].strip())
+    except ValueError as exc:
+        raise ValidationError(f"invalid date {cells['date']!r}") from exc
+    return Transaction(
+        date=date,
+        amount=parse_amount(cells["amount"]),
+        description=cells["description"].strip(),
+        imported_at=imported_at,
+    )
+
+
+def _build_sfera(cells: dict[str, str], imported_at: dt.datetime) -> Transaction:
+    return Transaction(
+        date=_parse_sfera_date(cells["date"]),
+        amount=_parse_sfera_amount(cells["amount"], signed=True),
+        description=cells["description"].strip(),
+        imported_at=imported_at,
+    )
+
+
+def _build_sfera_split(cells: dict[str, str], imported_at: dt.datetime) -> Transaction:
+    income = _split_cell(cells["income"])
+    expense = _split_cell(cells["expense"])
+    if (income is None) == (expense is None):
+        raise ValidationError("exactly one of 'Приход' and 'Расход' must be filled")
+    amount = income if income is not None else -expense
+    return Transaction(
+        date=_parse_sfera_date(cells["date"]),
+        amount=amount,
+        description=cells["description"].strip(),
+        imported_at=imported_at,
+    )
+
+
+def _split_cell(text: str) -> Decimal | None:
+    """Беззнаковая сумма из колонки «Приход» или «Расход»; пусто и 0,00 — None."""
+    if not text.strip():
+        return None
+    amount = _parse_sfera_amount(text, signed=False)
+    return None if amount == 0 else amount
+
+
+_BUILDERS: dict[str, Callable[[dict[str, str], dt.datetime], Transaction]] = {
+    "nova": _build_nova,
+    "sfera": _build_sfera,
+    "sfera_split": _build_sfera_split,
+}
