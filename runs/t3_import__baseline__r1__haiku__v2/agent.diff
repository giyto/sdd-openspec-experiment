+def test_sfera_amounts_and_nbsp_separators(write_csv, clock):
+    store = MemoryStore()
+    text = SFERA.replace("1 200", "1 200")
+    result = import_statement(write_csv(text), store, clock=clock)
+    assert result.format == "sfera"
+    assert result.encoding == "utf-8"
+    assert result.added == 3
+    assert [t.amount for t in store.all()] == [
+        Decimal("-1200.50"),
+        Decimal("85000.00"),
+        Decimal("150.50"),
+    ]
+    assert store.all()[0].date == dt.date(2026, 3, 1)
+    assert all(t.imported_at == clock.now() for t in store.all())
