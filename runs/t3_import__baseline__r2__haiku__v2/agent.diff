+def _iso_date(text: str, line_no: int) -> dt.date:
+    try:
+        return dt.date.fromisoformat(text)
+    except ValueError as exc:
+        raise StatementError(f"invalid date {text!r}", line_no=line_no) from exc
+
+
+def _ru_date(text: str, line_no: int) -> dt.date:
+    if not _SFERA_DATE.fullmatch(text):
+        raise StatementError(f"invalid date {text!r}, expected DD.MM.YYYY", line_no=line_no)
+    try:
+        return dt.datetime.strptime(text, "%d.%m.%Y").date()
+    except ValueError as exc:
+        raise StatementError(f"invalid date {text!r}", line_no=line_no) from exc
+
+
+def _checked(parse, text: str, line_no: int):
+    try:
+        return parse(text)
+    except ValidationError as exc:
+        raise StatementError(str(exc), line_no=line_no) from exc
+
+
+def _sfera_amount(text: str, line_no: int) -> Decimal:
+    """Сумма «Сферы»: знак необязателен, тысячи пробелом, дробная часть через запятую."""
+    return _decimal(text, line_no, signed=True)
+
+
+def _split_amount(income: str, expense: str, line_no: int) -> Decimal:
+    """Суммы sfera_split без знака; заполнена ровно одна колонка, 0,00 — как пусто."""
+    inc = _optional_amount(income, line_no)
+    exp = _optional_amount(expense, line_no)
+    if inc is None and exp is None:
+        raise StatementError("no amount: one of 'приход', 'расход' must be filled", line_no=line_no)
+    if inc is not None and exp is not None:
+        raise StatementError("both 'приход' and 'расход' are filled", line_no=line_no)
+    return inc if inc is not None else -exp
+
+
+def _optional_amount(text: str, line_no: int) -> Decimal | None:
+    if not text:
+        return None
+    value = _decimal(text, line_no, signed=False)
+    return None if value == 0 else value
+
+
+def _decimal(text: str, line_no: int, *, signed: bool) -> Decimal:
+    match = _SFERA_AMOUNT.fullmatch(text)
+    if match is None:
+        raise StatementError(f"invalid amount {text!r}", line_no=line_no)
+    if match["sign"] and not signed:
+        raise StatementError(f"sign is not allowed in amount {text!r}", line_no=line_no)
+    whole = re.sub(f"[{_GROUP_SEPARATORS}]", "", match["int"])
+    frac = match["frac"]
+    raw = f"{match['sign']}{whole}" + (f".{frac}" if frac is not None else "")
+    try:
+        return to_money(Decimal(raw))
+    except ValidationError as exc:
+        raise StatementError(str(exc), line_no=line_no) from exc
