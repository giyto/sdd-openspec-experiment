+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import detect_format, import_csv, import_statement, normalize_description
+from ledger.rules import Categorizer, Rule
+from ledger.storage import JsonFileStore, MemoryStore
+
+NBSP = " "
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1" + NBSP + "200,50;Магазин Лента\n"
+    "02.03.2026;+85" + NBSP + "000,00;Зарплата\n"
+    "03.03.2026;-12,5;Кофе\n"
+)
+
+SPLIT = (
+    "Дата;Описание;Приход;Расход\n"
+    "01.03.2026;Магазин Лента;;1" + NBSP + "200,50\n"
+    "02.03.2026;Зарплата;85" + NBSP + "000,00;\n"
+)
+
+
+def _descriptions(store):
+    return [t.description for t in store.all()]
+
+
+def test_sfera_statement(write_csv, clock):
+    store = MemoryStore()
+    result = import_statement(write_csv(SFERA), store, clock=clock)
+    assert result.format == "sfera"
+    assert result.encoding == "utf-8"
+    assert result.added == 3
+    assert result.duplicates == 0
+    assert result.errors == []
+    txs = store.all()
+    assert [t.amount for t in txs] == [Decimal("-1200.50"), Decimal("85000.00"), Decimal("-12.50")]
+    assert txs[0].date == dt.date(2026, 3, 1)
+    assert all(t.imported_at == clock.now() for t in txs)
+
+
+def test_sfera_split_statement(write_csv, clock):
+    store = MemoryStore()
+    result = import_statement(write_csv(SPLIT), store, clock=clock)
+    assert result.format == "sfera_split"
+    assert result.added == 2
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+
+
+def test_detect_format(write_csv):
+    assert detect_format(write_csv(SFERA)) == "sfera"
+    assert detect_format(write_csv(SPLIT)) == "sfera_split"
+    assert detect_format(write_csv("date,amount,description\n")) == "nova"
+
+
+def test_header_is_matched_loosely_and_extra_columns_ignored(write_csv, clock):
+    text = (
+        "Номер карты;ДАТА; Сумма ;Остаток;  описание  \n"
+        "4111;01.03.2026;-5,00;100,00;Чай\n"
+    )
+    store = MemoryStore()
+    result = import_statement(write_csv(text), store, clock=clock)
+    assert result.format == "sfera"
+    assert _descriptions(store) == ["Чай"]
+
+
+def test_utf8_with_bom(write_csv, clock):
+    store = MemoryStore()
+    result = import_statement(write_csv("﻿" + SFERA), store, clock=clock)
