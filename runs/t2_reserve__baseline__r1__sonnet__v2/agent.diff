+class ReservationStateError(ReservationError):
+    """Операция недопустима в текущем статусе резерва."""
+
+    def __init__(self, order_id: str, status: object = None) -> None:
+        detail = f" in status {getattr(status, 'value', status)}" if status is not None else ""
+        super().__init__(order_id, f"operation not allowed for order {order_id!r}{detail}")
+        self.status = status
+
+
+class DuplicateReservationError(ReservationError):
+    def __init__(self, order_id: str) -> None:
+        super().__init__(order_id, f"order {order_id!r} already has a live reservation")
