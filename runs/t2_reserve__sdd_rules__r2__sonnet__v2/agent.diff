diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..e645a90
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,427 @@
+import dataclasses
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.models import Reservation, ReservationLine, ReservationStatus
+from warehouse.reservations import (
+    DEFAULT_RESERVATION_TTL,
+    ReservationRecord,
+    effective_status,
+    normalize_lines,
+    totals_by_position,
+)
+
+from conftest import T0
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 10)
+    inv.receive("B", "NUT-M8", 5)
+    return inv
+
+
+def kinds(inv):
+    return [e.kind for e in inv.log.events()]
+
+
+# --- 1.x модели, ошибки, помощники -------------------------------------------
+
+
+def test_status_values():
+    assert [s.value for s in ReservationStatus] == ["active", "expired", "confirmed", "cancelled"]
+    assert ReservationStatus.ACTIVE == "active"
+    assert ReservationStatus.CANCELLED == "cancelled"
+
+
+def test_models_are_frozen():
+    line = ReservationLine("A", "BOLT-M8", 1)
+    res = Reservation("SO-1", (line,), T0, T0 + MIN, ReservationStatus.ACTIVE)
+    for obj, attr in ((line, "qty"), (res, "status")):
+        with pytest.raises(dataclasses.FrozenInstanceError):
+            setattr(obj, attr, 5)
+    assert [f.name for f in dataclasses.fields(Reservation)] == [
+        "order_id", "lines", "created_at", "expires_at", "status",
+    ]
+
+
+def test_default_ttl():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+@pytest.mark.parametrize(
+    "exc",
+    [ReservationNotFoundError("SO-1"), ReservationExpiredError("SO-1"),
+     ReservationStateError("SO-1", "confirmed"), DuplicateReservationError("SO-1")],
+)
+def test_errors_carry_order_id(exc):
+    assert exc.order_id == "SO-1"
+    assert isinstance(exc, ReservationError)
+    assert isinstance(exc, WarehouseError)
+
+
+def test_helpers():
+    assert normalize_lines([("A", "X", 1), ReservationLine("B", "Y", 2)]) == (
+        ReservationLine("A", "X", 1), ReservationLine("B", "Y", 2),
+    )
+    with pytest.raises(ValidationError):
+        normalize_lines([("A", "X")])
+    with pytest.raises(ValidationError):
+        normalize_lines(5)
+    lines = normalize_lines([("A", "X", 2), ("B", "Y", 1), ("A", "X", 3)])
+    assert totals_by_position(lines) == {("A", "X"): 5, ("B", "Y"): 1}
+    rec = ReservationRecord("SO-1", lines, T0, T0 + MIN)
+    assert effective_status(rec, T0 + MIN - timedelta(microseconds=1)) is ReservationStatus.ACTIVE
+    assert effective_status(rec, T0 + MIN) is ReservationStatus.EXPIRED
+
+
+# --- reserve -----------------------------------------------------------------
+
+
+def test_reserve_multi_warehouse(stocked):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 1)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0
+    assert res.expires_at == T0 + timedelta(minutes=15)
+    assert res.lines == (ReservationLine("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 1))
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.on_hand("B", "NUT-M8") == 5
+
+
+def test_reserve_explicit_ttl_and_line_objects(stocked):
+    res = stocked.reserve("SO-1", [ReservationLine("A", "BOLT-M8", 1)], ttl=timedelta(hours=1))
+    assert res.expires_at == res.created_at + timedelta(hours=1)
+
+
+def test_reserve_keeps_duplicate_positions(stocked):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)])
+    assert len(res.lines) == 2
+    assert stocked.reserved("A", "BOLT-M8") == 5
+
+
+def test_reserve_insufficient_is_atomic(stocked):
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("B", "NUT-M8", 1), ("A", "BOLT-M8", 11)])
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 6), ("A", "BOLT-M8", 5)])
+    assert stocked.reserved("B", "NUT-M8") == 0
+    assert len(stocked.log) == 2
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), timedelta(seconds=-1), 15, "15m"])
+def test_reserve_bad_ttl(stocked, ttl):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=ttl)
+
+
+def test_reserve_empty(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+
+
+def test_reserve_bad_input(stocked):
+    for order_id in ("", "SO 1", "SO=1"):
+        with pytest.raises(ValidationError):
+            stocked.reserve(order_id, [("A", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A b", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8")])
+    for qty in (0, -1, True, 1.5, "1"):
+        with pytest.raises(InvalidQuantityError):
+            stocked.reserve("SO-1", [("A", "BOLT-M8", qty)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("A", "NOPE", 1)])
+    assert len(stocked.log) == 2
+
+
+def test_reserve_duplicate(stocked, clock):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert stocked.get_reservation("SO-1") == first
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+
+
+def test_reserve_replaces_expired_and_cancelled(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    clock.advance(timedelta(minutes=15))
+    res = stocked.reserve("SO-1", [("B", "NUT-M8", 1)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation("SO-1").lines == (ReservationLine("B", "NUT-M8", 1),)
+    stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 3)])
+    assert res.lines == (ReservationLine("A", "BOLT-M8", 3),)
+
+
+def test_failed_replacement_keeps_old(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    stocked.cancel("SO-1")
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 99)])
+    old = stocked.get_reservation("SO-1")
+    assert old.status is ReservationStatus.CANCELLED
+    assert old.lines == (ReservationLine("A", "BOLT-M8", 2),)
+
+
+# --- reserved / available ----------------------------------------------------
+
+
+def test_available_and_reserved(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert (stocked.reserved("A", "BOLT-M8"), stocked.available("A", "BOLT-M8")) == (4, 6)
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.reserve("SO-2", [("A", "BOLT-M8", 7)])
+    assert (info.value.requested, info.value.available) == (7, 6)
+
+
+def test_available_zero_cases(stocked):
+    assert stocked.available("A", "NUT-M8") == 0
+    assert stocked.reserved("A", "NUT-M8") == 0
+
+
+def test_adjust_below_reserved(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    stocked.adjust("A", "BOLT-M8", 5, "recount")
+    assert stocked.available("A", "BOLT-M8") == 0
+    assert stocked.reserved("A", "BOLT-M8") == 8
+
+
+def test_available_unknown_sku(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.available("A", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("A", "NOPE")
+
+
+# --- issue / transfer --------------------------------------------------------
+
+
+def test_issue_respects_reserve(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.issue("A", "BOLT-M8", 3)
+    assert info.value.available == 2
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.issue("A", "BOLT-M8", 2) == 8
+    assert stocked.reserved("A", "BOLT-M8") == 8
+    clock.advance(timedelta(minutes=15))
+    assert stocked.issue("A", "BOLT-M8", 8) == 0
+
+
+def test_transfer_respects_reserve(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("A", "B", "BOLT-M8", 3)
+    stocked.transfer("A", "B", "BOLT-M8", 2)
+    assert stocked.on_hand("B", "BOLT-M8") == 2
+
+
+def test_no_reservations_behaviour_unchanged(stocked):
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.issue("A", "BOLT-M8", 11)
+    assert info.value.available == 10
+    assert stocked.issue("A", "BOLT-M8", 10) == 0
+
+
+# --- get_reservation / expiry ------------------------------------------------
+
+
+def test_expiry_boundary(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    n = len(stocked.log)
+    clock.advance(timedelta(minutes=15) - timedelta(milliseconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert stocked.available("A", "BOLT-M8") == 6
+    clock.advance(timedelta(milliseconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.available("A", "BOLT-M8") == 10
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert len(stocked.log) == n
+
+
+def test_final_statuses_do_not_expire(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation("SO-2").status is ReservationStatus.CANCELLED
+
+
+def test_not_found(stocked):
+    for call in (stocked.confirm, stocked.cancel, stocked.get_reservation,
+                 lambda o: stocked.extend(o, MIN)):
+        with pytest.raises(ReservationNotFoundError) as info:
+            call("SO-9")
+        assert info.value.order_id == "SO-9"
+
+
+# --- confirm -----------------------------------------------------------------
+
+
+def test_confirm_success(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 10)])
+    assert stocked.available("A", "BOLT-M8") == 0
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("A", "BOLT-M8") == 0
+    assert stocked.reserved("A", "BOLT-M8") == 0
+
+
+def test_confirm_sums_same_position(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)])
+    stocked.adjust("A", "BOLT-M8", 4, "recount")
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.confirm("SO-1")
+    assert info.value.requested == 5
+    assert stocked.on_hand("A", "BOLT-M8") == 4
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert len(stocked.log) == n
+
+
+def test_confirm_one_position_short_is_atomic(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 5)])
+    stocked.adjust("B", "NUT-M8", 1, "recount")
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert len(stocked.log) == n
+
+
+def test_confirm_wrong_states(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)], ttl=MIN)
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    clock.advance(MIN)
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+
+
+# --- cancel ------------------------------------------------------------------
+
+
+def test_cancel_flow(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.available("A", "BOLT-M8") == 10
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == n
+
+
+def test_cancel_expired_and_confirmed(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=MIN)
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    clock.advance(MIN)
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == n
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-2")
+
+
+# --- extend ------------------------------------------------------------------
+
+
+def test_extend(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(5 * MIN)
+    res = stocked.extend("SO-1", 30 * MIN)
+    assert res.expires_at == T0 + 35 * MIN
+    assert stocked.log.events()[-1].kind == "RESERVE_EXTEND"
+
+
+def test_extend_never_shortens(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    n = len(stocked.log)
+    for ttl in (MIN, 15 * MIN):
+        res = stocked.extend("SO-1", ttl)
+        assert res.expires_at == T0 + 15 * MIN
+    assert len(stocked.log) == n
+
+
+def test_extend_validation_and_states(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    for ttl in (timedelta(0), -MIN, 5):
+        with pytest.raises(ValidationError):
+            stocked.extend("SO-1", ttl)
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)], ttl=MIN)
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-4", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-3")
+    stocked.cancel("SO-4")
+    clock.advance(MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-2", MIN)
+    for order in ("SO-3", "SO-4"):
+        with pytest.raises(ReservationStateError):
+            stocked.extend(order, MIN)
+
+
+# --- журнал ------------------------------------------------------------------
+
+
+def test_event_log_contents(stocked, clock):
+    base = len(stocked.log)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 1)])
+    ev = stocked.log.events()[base:]
+    assert [e.kind for e in ev] == ["RESERVE", "RESERVE"]
+    assert ev[0].fields == {
+        "order": "SO-1", "wh": "A", "sku": "BOLT-M8", "qty": "2", "expires": "2026-03-01T10:15:00Z",
+    }
+    assert ev[1].get("sku") == "NUT-M8"
+    stocked.extend("SO-1", 30 * MIN)
+    assert stocked.log.events()[-1].fields == {"order": "SO-1", "expires": "2026-03-01T10:30:00Z"}
+    stocked.confirm("SO-1")
+    ev = stocked.log.events()[base + 3 :]
+    assert [e.kind for e in ev] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert ev[0].get("ref") == "SO-1" and ev[1].get("ref") == "SO-1"
+    assert ev[0].get("wh") == "A" and ev[1].get("wh") == "B"
+    assert ev[2].fields == {"order": "SO-1"}
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    assert stocked.log.events()[-1].kind == "RESERVE_CANCEL"
+    assert stocked.log.events()[-1].fields == {"order": "SO-2"}
+
+
+def test_noop_and_expiry_write_nothing(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    n = len(stocked.log)
+    clock.advance(timedelta(hours=1))
+    stocked.get_reservation("SO-1")
+    stocked.cancel("SO-1")
+    stocked.available("A", "BOLT-M8")
+    assert len(stocked.log) == n
+    assert kinds(stocked).count("RESERVE_CANCEL") == 0
