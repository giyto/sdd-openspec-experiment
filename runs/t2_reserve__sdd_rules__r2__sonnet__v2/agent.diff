new file mode 100644
index 0000000..8ec18d3
--- /dev/null
+++ b/warehouse/reservations.py
@@ -0,0 +1,72 @@
+"""Чистые помощники для резервов: без зависимости от ``Inventory``."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from typing import Iterable
+
+from .errors import ValidationError
+from .models import Reservation, ReservationLine, ReservationStatus
+
+DEFAULT_RESERVATION_TTL = timedelta(minutes=15)
+
+
+@dataclass
+class ReservationRecord:
+    """Внутренняя изменяемая запись резерва; наружу отдаются только снимки."""
+
+    order_id: str
+    lines: tuple[ReservationLine, ...]
+    created_at: datetime
+    expires_at: datetime
+    status: ReservationStatus = ReservationStatus.ACTIVE
+
+
+def check_ttl(ttl: object) -> timedelta:
+    """Положительный ``timedelta`` или ``ValidationError``."""
+    if not isinstance(ttl, timedelta) or ttl <= timedelta(0):
+        raise ValidationError(f"ttl must be a positive timedelta, got {ttl!r}")
+    return ttl
+
+
+def normalize_lines(lines: Iterable[object]) -> tuple[ReservationLine, ...]:
+    """Приводит строки к ``ReservationLine`` в исходном порядке (содержимое не проверяет)."""
+    try:
+        items = list(lines)
+    except TypeError as exc:
+        raise ValidationError(f"lines must be an iterable, got {lines!r}") from exc
+    result: list[ReservationLine] = []
+    for item in items:
+        if isinstance(item, ReservationLine):
+            result.append(item)
+        elif isinstance(item, tuple) and len(item) == 3:
+            result.append(ReservationLine(*item))
+        else:
+            raise ValidationError(f"reservation line must be (warehouse, sku, qty), got {item!r}")
+    return tuple(result)
+
+
+def totals_by_position(lines: Iterable[ReservationLine]) -> dict[tuple[str, str], int]:
+    """Суммы по позициям (склад, SKU) в порядке первого появления."""
+    totals: dict[tuple[str, str], int] = {}
+    for line in lines:
+        key = (line.warehouse, line.sku)
+        totals[key] = totals.get(key, 0) + line.qty
+    return totals
+
+
+def effective_status(record: ReservationRecord, now: datetime) -> ReservationStatus:
+    if record.status is ReservationStatus.ACTIVE and now >= record.expires_at:
+        return ReservationStatus.EXPIRED
+    return record.status
+
+
+def snapshot(record: ReservationRecord, now: datetime) -> Reservation:
+    return Reservation(
+        order_id=record.order_id,
+        lines=record.lines,
+        created_at=record.created_at,
+        expires_at=record.expires_at,
+        status=effective_status(record, now),
+    )
