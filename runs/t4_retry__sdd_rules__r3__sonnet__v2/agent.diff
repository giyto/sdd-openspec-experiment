+def test_rng_used_once_per_retry(queue, registry, clock):
+    rng = FakeRng(1.0)
+    worker = Worker(queue, registry, rng=rng)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=2, jitter=0.5))
+    _failing(registry)
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert len(rng.calls) == 1
+    clock.advance(60)
+    worker.run_once()  # dead-letter: rng не трогается
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert len(rng.calls) == 1
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=2, jitter=0.5, non_retryable=(TimeoutError,)))
+    queue.requeue_dead_letter(job.id)
+    worker.run_once()  # FAILED
+    assert job.status is JobStatus.FAILED
+    assert len(rng.calls) == 1
+
