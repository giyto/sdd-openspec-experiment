+    p = RetryPolicy(base_delay=10, jitter=0.2)
+    assert p.delay_for(1, rng) == pytest.approx(9.0)
+    assert len(rng.calls) == 1
+
+
+def test_no_jitter_no_rng_use():
+    rng = FakeRng(1.0)
+    RetryPolicy().delay_for(3, rng)
+    assert rng.calls == []
+
+
+def test_jitter_without_rng_uses_own_generator():
+    assert 0 <= RetryPolicy(jitter=0.5).delay_for(1) <= 60
+
+
+def test_invalid_attempt():
+    with pytest.raises(ConfigError):
+        RetryPolicy().delay_for(0)
+
+
+def test_is_retryable():
+    p = RetryPolicy(non_retryable=(ValueError,))
+    assert not p.is_retryable(UnicodeDecodeError("utf-8", b"", 0, 1, "x"))
+    assert p.is_retryable(TimeoutError())
+    assert not RetryPolicy().is_retryable(PermanentJobError("no"))
