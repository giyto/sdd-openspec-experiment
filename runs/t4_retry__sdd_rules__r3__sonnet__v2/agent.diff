+# -- transitions ---------------------------------------------------------------
+
+
+def _running(queue, job_type="t"):
+    job = queue.enqueue(job_type)
+    queue.mark_running(job.id)
+    return job
+
+
+def test_transitions(queue, clock):
+    job = _running(queue)
+    run_at = clock.now() + timedelta(seconds=5)
+    queue.mark_retry_scheduled(job.id, "E: x", run_at)
+    assert job.status is JobStatus.RETRY_SCHEDULED and job.run_at == run_at
+    with pytest.raises(InvalidTransitionError):
+        queue.mark_succeeded(job.id)
+    with pytest.raises(InvalidTransitionError):
+        queue.mark_dead_lettered(job.id, "E: x")
+    cancelled = queue.cancel(job.id)
+    assert cancelled.status is JobStatus.CANCELLED and cancelled.finished_at is not None
+    assert queue.metrics.get("jobs.cancelled") == 1
+
+
+def test_dead_letter_cannot_be_cancelled(queue):
+    job = _running(queue)
+    queue.mark_dead_lettered(job.id, "E: x")
+    with pytest.raises(InvalidTransitionError):
+        queue.cancel(job.id)
+    assert len(queue.dead_letters()) == 1
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    assert queue.metrics.get("jobs.failed") == 0
+
+
+def test_rejected_transitions_do_not_count(queue, clock):
+    job = queue.enqueue("t")
+    with pytest.raises(InvalidTransitionError):
+        queue.mark_dead_lettered(job.id, "x")
+    with pytest.raises(InvalidTransitionError):
+        queue.mark_retry_scheduled(job.id, "x", clock.now())
+    assert queue.metrics.snapshot() == {"jobs.enqueued": 1}
+
+
+def test_dead_letters_order_and_copy(queue, clock):
+    a = queue.enqueue("t")
+    b = queue.enqueue("t")
+    queue.mark_running(b.id)
+    queue.mark_dead_lettered(b.id, "E: b")
+    clock.advance(1)
+    queue.mark_running(a.id)
+    queue.mark_dead_lettered(a.id, "E: a")
+    entries = queue.dead_letters()
+    assert [e.job_id for e in entries] == [b.id, a.id]
+    assert isinstance(entries[0], DeadLetterEntry)
+    assert entries[1].dead_lettered_at == clock.now()
+    entries.clear()
+    assert len(queue.dead_letters()) == 2
+
+
+def test_requeue(queue, clock):
+    job = _running(queue)
+    queue.mark_dead_lettered(job.id, "E: x")
+    clock.advance(10)
+    size = len(queue.store)
+    result = queue.requeue_dead_letter(job.id)
+    assert result is job
+    assert (job.status, job.run_at, job.error, job.attempts) == (
+        JobStatus.PENDING, clock.now(), None, 0,
+    )
+    assert queue.dead_letters() == []
+    assert len(queue.store) == size
+    assert queue.metrics.get("jobs.requeued") == 1
+    assert queue.metrics.get("jobs.enqueued") == 1
+
+
+def test_requeue_errors(queue):
+    job = queue.enqueue("t")
+    with pytest.raises(InvalidTransitionError):
+        queue.requeue_dead_letter(job.id)
+    with pytest.raises(JobNotFoundError):
+        queue.requeue_dead_letter("job-999999")
+    assert queue.metrics.get("jobs.requeued") == 0
+
+
+def test_purge_keeps_new_statuses(queue, clock):
+    a = _running(queue)
+    queue.mark_dead_lettered(a.id, "x")
+    b = _running(queue)
+    queue.mark_retry_scheduled(b.id, "x", clock.now())
+    clock.advance(100)
+    assert queue.purge_finished(older_than=0) == 0
+    assert len(queue.store) == 2 and len(queue.dead_letters()) == 1
+
+
+def test_due_shared_order(queue, clock):
+    late = queue.enqueue("t", delay=5)
+    early = queue.enqueue("t")
+    queue.mark_running(early.id)
+    queue.mark_retry_scheduled(early.id, "x", clock.now() + timedelta(seconds=1))
+    clock.advance(10)
+    assert queue.next_due() is early
+    assert [j.id for j in queue.store.due(clock.now())] == [early.id, late.id]
+
