+def test_policy_replaces_default_without_merge(clock):
+    default = RetryPolicy(non_retryable=(ValueError,))
+    q = JobQueue(clock=clock, default_retry_policy=default)
+    own = RetryPolicy(max_attempts=5)
+    q.set_retry_policy("a", own)
+    assert q.retry_policy_for("a") is own
+    assert q.retry_policy_for("a").non_retryable == ()
+    assert q.retry_policy_for("b") is default
+    q.set_retry_policy("a", None)
+    assert q.retry_policy_for("a") is default
+
+
+def test_no_policy_is_none(queue):
+    assert queue.retry_policy_for("x") is None
+
+
+def test_bad_policy_type(queue):
+    with pytest.raises(ConfigError):
+        queue.set_retry_policy("a", "oops")
+    with pytest.raises(ConfigError):
+        JobQueue(default_retry_policy="oops")
+
