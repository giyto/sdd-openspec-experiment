+def test_policy_taken_at_failure_time(queue, registry, worker):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=5))
+
+    def handler(job):
+        queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+        raise TimeoutError("x")
+
+    registry.register("t", handler)
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+
+
+def test_success_after_retry(queue, registry, worker, clock):
+    queue.set_retry_policy("t", RetryPolicy(base_delay=3))
+    calls = []
+
+    def handler(job):
+        calls.append(job.attempts)
+        if len(calls) == 1:
+            raise TimeoutError("x")
+        return "ok"
+
+    registry.register("t", handler)
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert worker.run_once() is None
+    clock.advance(3)
+    worker.run_once()
+    assert job.status is JobStatus.SUCCEEDED and job.error is None and job.attempts == 2
+
+
+def test_full_chain_counters(queue, registry, worker, clock):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=2, base_delay=1))
+    _failing(registry)
+    job = queue.enqueue("t")
+    worker.run_once()
+    clock.advance(1)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    queue.requeue_dead_letter(job.id)
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED  # полный новый набор попыток
+    m = queue.metrics
+    assert m.get("jobs.started") == 3
+    assert m.get("jobs.retried") == 2
+    assert m.get("jobs.dead_lettered") == 1
+    assert m.get("jobs.requeued") == 1
+    assert m.get("jobs.failed") == 0
+
