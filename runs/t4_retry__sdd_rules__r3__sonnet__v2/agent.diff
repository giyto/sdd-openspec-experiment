+# -- worker --------------------------------------------------------------------
+
+
+def _failing(registry, exc_factory=lambda: TimeoutError("gateway"), job_type="t"):
+    def handler(job):
+        raise exc_factory()
+
+    registry.register(job_type, handler)
+
+
+def test_no_policy_fails(queue, registry, worker):
+    _failing(registry)
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.metrics.get("jobs.failed") == 1
+
+
+def test_retry_then_dead_letter(queue, registry, clock):
+    rng = FakeRng(1.0)
+    worker = Worker(queue, registry, rng=rng)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3, base_delay=2))
+    _failing(registry)
+    job = queue.enqueue("t")
+    t0 = clock.now()
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == t0 + timedelta(seconds=2)
+    assert job.error == "TimeoutError: gateway"
+    assert worker.run_once() is None
+    clock.advance(2)
+    worker.run_once()
+    assert job.attempts == 2 and job.status is JobStatus.RETRY_SCHEDULED
+    clock.advance(4)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    entry = queue.dead_letters()[0]
+    assert (entry.job_type, entry.attempts, entry.error, entry.dead_lettered_at) == (
+        "t", 3, "TimeoutError: gateway", clock.now(),
+    )
+    assert rng.calls == []
+    assert queue.metrics.get("jobs.failed") == 0
+
+
+def test_max_attempts_one_dead_letters(queue, registry, worker):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    _failing(registry)
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+
