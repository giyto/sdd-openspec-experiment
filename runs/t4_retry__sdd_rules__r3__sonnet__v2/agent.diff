@@ -0,0 +1,425 @@
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    HandlerRegistry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobQueue,
+    JobqError,
+    JobStatus,
+    Metrics,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.errors import PermanentJobError as PermanentFromErrors
+
+
+class FakeRng:
+    def __init__(self, value: float) -> None:
+        self.value = value
+        self.calls: list[tuple[float, float]] = []
+
+    def uniform(self, a: float, b: float) -> float:
+        self.calls.append((a, b))
+        return self.value
+
+
+# -- errors / models / metrics -------------------------------------------------
+
+
+def test_permanent_job_error_hierarchy():
+    assert issubclass(PermanentJobError, JobqError)
+    assert PermanentJobError is PermanentFromErrors
+
+
+def test_new_statuses():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert not JobStatus.DEAD_LETTERED.is_terminal
+
+
+def test_new_counters_default_zero():
+    metrics = Metrics()
+    for name in ("jobs.retried", "jobs.dead_lettered", "jobs.requeued"):
+        assert metrics.get(name) == 0
+
+
+def test_stats_include_new_statuses(queue):
+    stats = queue.stats()
+    assert stats["retry_scheduled"] == 0
+    assert stats["dead_lettered"] == 0
+
+
+# -- RetryPolicy ---------------------------------------------------------------
+
+
+def test_defaults():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter) == (3, 1.0, 2.0, 60.0, 0.0)
+    assert p.non_retryable == ()
+
+
+def test_non_retryable_list_becomes_tuple():
+    p = RetryPolicy(non_retryable=[ValueError, KeyError])
+    assert p.non_retryable == (ValueError, KeyError)
+    assert isinstance(p.non_retryable, tuple)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": True},
+        {"max_attempts": 1.5},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 10, "max_delay": 5},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"base_delay": float("nan")},
+        {"max_delay": float("inf")},
+        {"factor": "2"},
+        {"non_retryable": (ValueError("x"),)},
+        {"non_retryable": (int,)},
+        {"non_retryable": 5},
+    ],
+)
+def test_invalid_params(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+def test_exponential_growth_and_cap():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=60)
+    assert [p.delay_for(n) for n in (1, 2, 4)] == [1.0, 2.0, 8.0]
+    assert p.delay_for(10) == 60.0
+
+
+def test_huge_attempt_no_overflow():
+    p = RetryPolicy(max_attempts=10000, factor=2.0)
+    assert p.delay_for(5000) == p.max_delay
+    assert RetryPolicy(max_attempts=10000, factor=10**300).delay_for(5000) == 60.0
+
+
+def test_zero_base_delay():
+    assert RetryPolicy(base_delay=0, factor=2.0).delay_for(5000) == 0
+
+
+def test_jitter_does_not_break_ceiling():
+    rng = FakeRng(1.5)
+    p = RetryPolicy(jitter=0.5, max_delay=60)
+    assert p.delay_for(10, rng) == 60.0
+    assert rng.calls == [(0.5, 1.5)]
+
+
+def test_jitter_reduces():
