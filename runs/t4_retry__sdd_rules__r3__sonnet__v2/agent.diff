+@pytest.mark.parametrize("exc", [lambda: PermanentJobError("no"), lambda: ValueError("bad")])
+def test_non_retryable_on_last_attempt_fails(queue, registry, worker, exc):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1, non_retryable=(ValueError,)))
+    _failing(registry, exc)
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
