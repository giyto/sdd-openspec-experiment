+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+def percent(code="SUMMER10", **kwargs):
+    return PromoCode(code, DiscountKind.PERCENT, Decimal("10"), **kwargs)
+
+
+def test_code_is_normalized():
+    assert percent("  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize("code", ["", "   "])
+def test_empty_code_rejected(code):
+    with pytest.raises(ValidationError):
+        percent(code)
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("-1"), Decimal("100.01"), Decimal("NaN")])
+def test_percent_range(value):
+    with pytest.raises(ValidationError):
+        PromoCode("P", DiscountKind.PERCENT, value)
+
+
+def test_percent_upper_bound_allowed():
+    assert PromoCode("P", DiscountKind.PERCENT, Decimal("100")).value == Decimal("100")
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("-5"), Decimal("10.005")])
+def test_fixed_value_rules(value):
+    with pytest.raises(ValidationError):
+        PromoCode("P", DiscountKind.FIXED, value)
+
+
+def test_float_value_rejected():
+    with pytest.raises(ValidationError):
+        PromoCode("P", DiscountKind.FIXED, 10.0)
+
+
+def test_negative_min_order_rejected():
+    with pytest.raises(ValidationError):
+        percent(min_order_amount=Decimal("-1"))
+
+
+def test_naive_dates_rejected():
+    with pytest.raises(ValidationError):
+        percent(starts_at=datetime(2026, 1, 1))
+
+
+def test_start_not_before_end_rejected(clock):
+    at = clock.now()
+    with pytest.raises(ValidationError):
+        percent(starts_at=at, expires_at=at)
+
+
+@pytest.mark.parametrize("max_uses", [0, -1, True, 1.5])
+def test_max_uses_rules(max_uses):
+    with pytest.raises(ValidationError):
+        percent(max_uses=max_uses)
+
+
+def test_excluded_categories_are_frozen_and_checked():
+    promo = percent(excluded_categories={Category.BOOKS})
+    assert promo.excluded_categories == frozenset({Category.BOOKS})
+    with pytest.raises(ValidationError):
+        percent(excluded_categories={"books"})
+
+
+def test_error_hierarchy_is_independent():
+    for error in (UnknownPromoCodeError, PromoExpiredError, PromoConditionsError):
+        assert issubclass(error, PromoError)
+        assert issubclass(error, ShopError)
+    assert not issubclass(UnknownPromoCodeError, PromoExpiredError)
+    assert not issubclass(PromoExpiredError, PromoConditionsError)
+
+
+def test_resolve_ignores_case_and_spaces(clock):
+    registry = PromoRegistry(clock)
+    registry.add(percent("SUMMER10"))
+    assert registry.resolve(" summer10 ").code == "SUMMER10"
+
+
+def test_resolve_unknown_and_empty(clock):
+    registry = PromoRegistry(clock)
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("NOPE")
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("")
+
+
+def test_duplicate_add_rejected(clock):
+    registry = PromoRegistry(clock)
+    registry.add(percent("SUMMER10"))
+    with pytest.raises(ValidationError):
+        registry.add(percent("summer10"))
+
+
+def test_validity_period_is_half_open(clock):
+    start = clock.now()
+    promo = percent(starts_at=start, expires_at=start + timedelta(days=1))
+    registry = PromoRegistry(clock)
+    registry.add(promo)
+
+    clock.set(start - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+    clock.set(start)
+    assert registry.resolve("SUMMER10") is promo
+
+    clock.set(start + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_not_started_yet_is_expired_error(clock):
+    registry = PromoRegistry(clock)
+    registry.add(percent(starts_at=clock.now() + timedelta(hours=1)))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_usage_limit_counts_consumed_uses(clock):
+    registry = PromoRegistry(clock)
+    registry.add(percent(max_uses=2))
+    assert registry.uses("SUMMER10") == 0
+    registry.resolve("SUMMER10")  # resolving alone does not count
+    assert registry.uses("SUMMER10") == 0
+
+    registry.consume("SUMMER10")
+    registry.consume("summer10")
+    assert registry.uses("SUMMER10") == 2
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+
+
+def test_unlimited_uses(clock):
+    registry = PromoRegistry(clock)
+    registry.add(percent())
+    for _ in range(5):
+        registry.consume("SUMMER10")
+    assert registry.uses("SUMMER10") == 5
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_release_gives_back_one_use(clock):
+    registry = PromoRegistry(clock)
+    registry.add(percent(max_uses=1))
+    registry.consume("SUMMER10")
+    registry.release("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_uses_of_unknown_code_raises(clock):
+    with pytest.raises(UnknownPromoCodeError):
+        PromoRegistry(clock).uses("NOPE")
+
+
+def test_expiry_is_checked_before_limit(clock):
+    registry = PromoRegistry(clock)
+    registry.add(percent(max_uses=1, expires_at=clock.now() + timedelta(hours=1)))
+    registry.consume("SUMMER10")
+    clock.advance(timedelta(hours=2))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_registry_uses_injected_clock_only():
+    moment = datetime(2030, 1, 1, tzinfo=timezone.utc)
+    registry = PromoRegistry(FixedClock(moment))
+    registry.add(percent(expires_at=moment))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
