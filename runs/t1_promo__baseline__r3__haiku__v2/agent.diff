index 0000000..bb4ea16
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,140 @@
+"""Promo codes: discount rules and the registry that tracks validity and usage.
+
+A promo code gives a percentage or a fixed discount on the participating lines of an
+order (see README). The registry checks that a code exists, is active and is not used up.
+Order conditions (minimum amount, participating lines) are checked by the pricing module.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, Product, normalize_key
+from .clock import Clock, _require_aware
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+MAX_PERCENT = Decimal("100")
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = frozenset()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError(f"discount kind of {self.code} must be a DiscountKind")
+        _require_finite(f"value of {self.code}", self.value)
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= MAX_PERCENT:
+                raise ValidationError(f"percent of {self.code} must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"fixed discount of {self.code} must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError(f"fixed discount of {self.code} has more than two digits")
+        _require_finite(f"minimum order of {self.code}", self.min_order_amount)
+        if self.min_order_amount < 0 or to_money(self.min_order_amount) != self.min_order_amount:
+            raise ValidationError(f"minimum order of {self.code} must be a non-negative amount")
+        for moment in (self.starts_at, self.expires_at):
+            if moment is not None:
+                _require_aware(moment)
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError(f"promo {self.code} starts after it expires")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool)
+            or not isinstance(self.max_uses, int)
+            or self.max_uses < 1
+        ):
+            raise ValidationError(f"max uses of {self.code} must be None or >= 1")
+        object.__setattr__(self, "excluded_categories", frozenset(self.excluded_categories))
+        for category in self.excluded_categories:
+            if not isinstance(category, Category):
+                raise ValidationError(f"excluded category of {self.code} must be a Category")
+
+    def covers(self, product: Product) -> bool:
+        """Whether the code discounts the product: gift cards never, excluded categories never."""
+        return product.is_physical and product.category not in self.excluded_categories
+
+
+def _require_finite(name: str, value: Decimal) -> None:
+    if not isinstance(value, Decimal) or not value.is_finite():
+        raise ValidationError(f"{name} must be a finite Decimal")
+
+
+class PromoRegistry:
+    """In-memory promo codes with their usage counters."""
+
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+
+    def add(self, promo: PromoCode) -> None:
+        if promo.code in self._promos:
+            raise ValidationError(f"duplicate promo code: {promo.code}")
+        self._promos[promo.code] = promo
+        self._uses[promo.code] = 0
+        logger.debug("promo: added %s", promo.code)
+
+    def resolve(self, code: str) -> PromoCode:
+        """Return the promo code if it exists, is active now and is not used up."""
+        promo = self._get(code)
+        now = self._clock.now()
+        if promo.starts_at is not None and now < promo.starts_at:
+            raise PromoExpiredError(f"promo code {promo.code} has not started yet")
+        if promo.expires_at is not None and now >= promo.expires_at:
+            raise PromoExpiredError(f"promo code {promo.code} has expired")
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} is used up")
+        return promo
+
+    def uses(self, code: str) -> int:
+        return self._uses[self._get(code).code]
+
+    def consume(self, code: str) -> None:
+        """Count one successful use of the code. Call only for a placed order."""
+        promo = self.resolve(code)
+        self._uses[promo.code] += 1
+
+    def release(self, code: str) -> None:
+        """Give back one use, e.g. when the order that used the code is cancelled."""
+        promo = self._get(code)
+        self._uses[promo.code] -= 1
+
+    def _get(self, code: str) -> PromoCode:
+        key = normalize_key(code)
+        try:
+            return self._promos[key]
+        except KeyError:
+            raise UnknownPromoCodeError(f"unknown promo code: {code!r}") from None
