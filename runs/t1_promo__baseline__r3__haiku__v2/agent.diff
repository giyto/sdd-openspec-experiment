@@ -0,0 +1,122 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+)
+from shop.orders import OrderService, OrderStatus
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(PromoCode("SUMMER10", DiscountKind.PERCENT, Decimal("10")))
+    return reg
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+def tea_cart(products):
+    cart = Cart()
+    cart.add(products["tea"])  # 199.90
+    return cart
+
+
+def test_place_order_with_promo_stores_code_and_counts_use(products, service, registry):
+    order = service.place_order(tea_cart(products), " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == Decimal("19.99")  # 199.90 * 10 %
+    assert registry.uses("SUMMER10") == 1
+    assert len(service.store) == 1
+
+
+def test_quote_with_promo_does_not_count(products, service, registry):
+    total = service.quote(tea_cart(products), "SUMMER10")
+    assert total.discount == Decimal("19.99")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def test_failed_attempts_do_not_count(products, service, registry):
+    cart = tea_cart(products)
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart, "NOPE")
+    with pytest.raises(PromoConditionsError):
+        _gift_only_attempt(service, products)
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def _gift_only_attempt(service, products):
+    cart = Cart()
+    cart.add(products["gift"])
+    return service.place_order(cart, "SUMMER10")
+
+
+def test_blank_code_means_no_promo(products, service, registry):
+    order = service.place_order(tea_cart(products), "   ")
+    assert order.promo_code is None
+    assert order.total.discount == Decimal("0.00")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_none_code_means_no_promo(products, service):
+    assert service.quote(tea_cart(products), None).discount == Decimal("0.00")
+
+
+def test_service_without_registry_knows_no_codes(products, clock):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(tea_cart(products), "SUMMER10")
+    assert service.quote(tea_cart(products), "  ").discount == Decimal("0.00")
+
+
+def test_expired_code_is_rejected_at_checkout(products, clock):
+    reg = PromoRegistry(clock)
+    reg.add(
+        PromoCode(
+            "SHORT",
+            DiscountKind.FIXED,
+            Decimal("5.00"),
+            expires_at=clock.now() + timedelta(hours=1),
+        )
+    )
+    service = OrderService(clock=clock, promos=reg)
+    clock.advance(timedelta(hours=1))
+    with pytest.raises(PromoExpiredError):
+        service.place_order(tea_cart(products), "SHORT")
+
+
+def test_cancel_returns_the_use(products, service, registry):
+    registry.add(PromoCode("ONCE", DiscountKind.FIXED, Decimal("5.00"), max_uses=1))
+    first = service.place_order(tea_cart(products), "ONCE")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(tea_cart(products), "ONCE")
+
+    cancelled = service.cancel(first.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert cancelled.promo_code == "ONCE"
+    assert registry.uses("ONCE") == 0
+    assert service.place_order(tea_cart(products), "ONCE").promo_code == "ONCE"
+
+
+def test_cancel_order_without_promo_leaves_counters(products, service, registry):
+    order = service.place_order(tea_cart(products))
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_place_order_without_promo_is_unchanged(products, clock):
+    service = OrderService(clock=clock)
+    order = service.place_order(tea_cart(products))
+    assert order.promo_code is None
+    assert order.total.total == Decimal("518.89")  # 199.90 + 19.99 tax (food) + 299.00 shipping
