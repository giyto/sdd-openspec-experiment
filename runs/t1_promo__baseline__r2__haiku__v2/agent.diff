+def _is_eligible(cart_line: CartLine, promo: PromoCode) -> bool:
+    """Gift cards never take part in promotions; codes may exclude more categories."""
+    category = cart_line.product.category
+    return category is not Category.GIFT_CARD and category not in promo.excluded_categories
+
+
+def _line_discounts(cart_lines: Sequence[CartLine], promo: PromoCode) -> list[Decimal]:
+    """Discount of every cart line, in cart order (zero for non-participating lines)."""
+    eligible = [i for i, cart_line in enumerate(cart_lines) if _is_eligible(cart_line, promo)]
+    if not eligible:
+        raise PromoConditionsError(f"promo code {promo.code} applies to no item in the cart")
+
+    base = sum_money(cart_lines[i].amount for i in eligible)
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"promo code {promo.code} requires eligible items worth at least "
+            f"{promo.min_order_amount}"
+        )
+
+    if promo.kind is DiscountKind.PERCENT:
+        total_discount = quantize_money(base * promo.value / Decimal("100"))
+    else:
+        total_discount = min(promo.value, base)
+
+    shares = _split_discount(total_discount, [cart_lines[i].amount for i in eligible])
+    discounts = [ZERO] * len(cart_lines)
+    for index, share in zip(eligible, shares):
+        discounts[index] = share
+    return discounts
+
+
+def _split_discount(total: Decimal, amounts: Sequence[Decimal]) -> list[Decimal]:
+    """Split ``total`` between lines in proportion to ``amounts``, exactly, in kopecks.
+
+    Every share is rounded down to a kopeck. The kopecks left over are given one each to
+    the lines with the largest discarded remainder; on equal remainders the earlier line wins.
+    The shares always add up to ``total``.
+    """
+    total_kopecks = int(total * 100)
+    amount_kopecks = [int(amount * 100) for amount in amounts]
+    base_kopecks = sum(amount_kopecks)
+    weighted = [total_kopecks * amount for amount in amount_kopecks]
+    shares = [part // base_kopecks for part in weighted]
+    leftover = total_kopecks - sum(shares)
+    by_remainder = sorted(
+        range(len(shares)), key=lambda i: (-(weighted[i] % base_kopecks), i)
     )
+    for index in by_remainder[:leftover]:
+        shares[index] += 1
+    return [quantize_money(Decimal(share) / 100) for share in shares]
