new file mode 100644
index 0000000..bf51a3e
--- /dev/null
+++ b/jobq/retry.py
@@ -0,0 +1,63 @@
+"""Политика повторов упавших заданий."""
+
+from __future__ import annotations
+
+import random
+from dataclasses import dataclass, field
+
+from .errors import ConfigError, PermanentJobError
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Экспоненциальная задержка между попытками.
+
+    ``max_attempts`` — общее число попыток, включая первую.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = field(default=())
+
+    def __post_init__(self) -> None:
+        if self.max_attempts < 1:
+            raise ConfigError("max_attempts must be >= 1")
+        if self.base_delay < 0:
+            raise ConfigError("base_delay must be >= 0")
+        if self.factor < 1:
+            raise ConfigError("factor must be >= 1")
+        if self.max_delay < self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+        try:
+            types = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be an iterable of exception classes") from None
+        for t in types:
+            if not (isinstance(t, type) and issubclass(t, BaseException)):
+                raise ConfigError(f"non_retryable item {t!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", types)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка в секундах перед следующей попыткой после падения попытки ``attempt``."""
+        if attempt < 1:
+            raise ConfigError("attempt must be >= 1")
+        try:
+            delay = self.base_delay * self.factor ** (attempt - 1)
+        except OverflowError:
+            delay = 0.0 if self.base_delay == 0 else self.max_delay
+        delay = min(delay, self.max_delay)
+        if self.jitter > 0:
+            r = rng if rng is not None else random.Random()
+            delay = min(delay * r.uniform(1 - self.jitter, 1 + self.jitter), self.max_delay)
+        return max(delay, 0.0)
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """``False`` для ``PermanentJobError`` и экземпляров ``non_retryable`` (с подклассами)."""
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not (self.non_retryable and isinstance(exc, self.non_retryable))
