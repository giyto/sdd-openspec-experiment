diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..dc098cd
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,46 @@
+import pytest
+
+from jobq import (HandlerRegistry, InvalidTransitionError, JobQueue, JobStatus, ManualClock,
+                  PermanentJobError, RetryPolicy, Worker)
+
+
+def _setup(policy, fail_times):
+    clock = ManualClock()
+    q = JobQueue(clock=clock, default_retry_policy=policy)
+    calls = []
+
+    def handler(job):
+        calls.append(job.attempts)
+        if len(calls) <= fail_times:
+            raise RuntimeError("boom")
+
+    reg = HandlerRegistry()
+    reg.register("t", handler)
+    return q, clock, Worker(q, reg)
+
+
+def test_retry_then_success():
+    q, clock, w = _setup(RetryPolicy(base_delay=5), 1)
+    job = q.enqueue("t")
+    w.run_pending()
+    assert job.status is JobStatus.RETRY_SCHEDULED and q.metrics.get("jobs.retried") == 1
+    clock.advance(5)
+    w.run_pending()
+    assert job.status is JobStatus.SUCCEEDED and job.error is None and job.attempts == 2
+
+
+def test_dead_letter_and_requeue():
+    q, _, w = _setup(RetryPolicy(max_attempts=1), 99)
+    job = q.enqueue("t")
+    w.run_pending()
+    assert job.status is JobStatus.DEAD_LETTERED and len(q.dead_letters()) == 1
+    with pytest.raises(InvalidTransitionError):
+        q.cancel(job.id)
+    assert q.purge_finished() == 0
+    q.requeue_dead_letter(job.id)
+    assert job.status is JobStatus.PENDING and not q.dead_letters()
+
+
+def test_permanent_is_failed():
+    assert not RetryPolicy().is_retryable(PermanentJobError())
+    assert RetryPolicy().delay_for(5000) == 60.0
