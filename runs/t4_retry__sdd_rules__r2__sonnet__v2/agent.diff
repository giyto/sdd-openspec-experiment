new file mode 100644
index 0000000..eda1e2d
--- /dev/null
+++ b/tests/test_retry_policy.py
@@ -0,0 +1,104 @@
+import random
+
+import pytest
+
+from jobq import ConfigError, PermanentJobError, RetryPolicy
+
+
+class CountingRng(random.Random):
+    def __init__(self, value=1.0):
+        super().__init__(0)
+        self.calls = []
+        self.value = value
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def test_defaults():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter) == (3, 1.0, 2.0, 60.0, 0.0)
+    assert p.non_retryable == ()
+
+
+def test_non_retryable_list_becomes_tuple():
+    p = RetryPolicy(non_retryable=[ValueError, KeyError])
+    assert p.non_retryable == (ValueError, KeyError)
+
+
+def test_frozen():
+    with pytest.raises(Exception):
+        RetryPolicy().max_attempts = 5
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"base_delay": -0.1},
+        {"factor": 0.5},
+        {"base_delay": 10.0, "max_delay": 5.0},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"jitter": float("nan")},
+        {"base_delay": "x"},
+        {"non_retryable": (ValueError("x"),)},
+        {"non_retryable": (int,)},
+    ],
+)
+def test_invalid(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+def test_boundaries_ok():
+    RetryPolicy(max_attempts=1, base_delay=0, factor=1, max_delay=0, jitter=1)
+
+
+def test_growth_and_cap():
+    p = RetryPolicy()
+    assert [p.delay_for(n) for n in (1, 2, 3, 4)] == [1.0, 2.0, 4.0, 8.0]
+    assert p.delay_for(10) == 60.0
+
+
+def test_huge_attempt():
+    assert RetryPolicy(max_attempts=10000).delay_for(5000) == 60.0
+
+
+def test_zero_base_and_factor_one():
+    assert RetryPolicy(base_delay=0.0).delay_for(5000) == 0.0
+    assert RetryPolicy(base_delay=3.0, factor=1.0).delay_for(1000) == 3.0
+
+
+def test_jitter_applied_and_capped():
+    rng = CountingRng(1.2)
+    p = RetryPolicy(base_delay=10.0, jitter=0.5, max_delay=60.0)
+    assert p.delay_for(1, rng) == pytest.approx(12.0)
+    assert rng.calls == [(0.5, 1.5)]
+    rng = CountingRng(1.4)
+    assert RetryPolicy(jitter=0.5).delay_for(10, rng) == 60.0
+
+
+def test_no_rng_without_jitter():
+    rng = CountingRng()
+    RetryPolicy().delay_for(2, rng)
+    assert rng.calls == []
+
+
+def test_default_rng_with_jitter():
+    assert 0 <= RetryPolicy(jitter=0.5).delay_for(1) <= 60.0
+
+
+@pytest.mark.parametrize("attempt", [0, -1])
+def test_invalid_attempt(attempt):
+    with pytest.raises(ConfigError):
+        RetryPolicy().delay_for(attempt)
+
+
+def test_is_retryable():
+    p = RetryPolicy(non_retryable=(ValueError,))
+    assert not p.is_retryable(ValueError("x"))
+    assert not p.is_retryable(UnicodeDecodeError("utf-8", b"", 0, 1, "r"))
+    assert p.is_retryable(TimeoutError())
+    assert not RetryPolicy().is_retryable(PermanentJobError("no"))
diff --git a/tests/test_retry_worker.py b/tests/test_retry_worker.py
new file mode 100644
index 0000000..b368ed9
--- /dev/null
+++ b/tests/test_retry_worker.py
@@ -0,0 +1,170 @@
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    HandlerRegistry,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from tests.test_retry_policy import CountingRng
+
+
+def failing(exc):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+def test_no_policy_fails(queue, registry, worker):
+    registry.register("t", failing(RuntimeError("boom")))
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+    assert job.error == "RuntimeError: boom"
+    assert queue.metrics.get("jobs.retried") == 0
+    assert queue.metrics.get("jobs.dead_lettered") == 0
+
+
+def test_retry_then_dead_letter(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy(max_attempts=3))
+    worker = Worker(queue, registry)
+    registry.register("t", failing(TimeoutError("gw")))
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.attempts == 1
+    assert job.error == "TimeoutError: gw"
+    assert job.run_at == clock.now() + timedelta(seconds=1)
+    assert worker.run_pending() == 0
+    clock.advance(1)
+    worker.run_once()
+    assert job.run_at == clock.now() + timedelta(seconds=2)
+    clock.advance(2)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.attempts == 3
+    assert queue.metrics.get("jobs.retried") == 2
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    assert queue.metrics.get("jobs.failed") == 0
+
+
+def test_max_attempts_one_dead_letters(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy(max_attempts=1))
+    registry.register("t", failing(TimeoutError()))
+    job = queue.enqueue("t")
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+
+
+def test_permanent_error_fails(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy())
+    registry.register("t", failing(PermanentJobError("bad")))
+    job = queue.enqueue("t")
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.retried") == 0
+
+
+def test_non_retryable_on_last_attempt_and_subclass(clock, registry):
+    queue = JobQueue(
+        clock=clock, default_retry_policy=RetryPolicy(max_attempts=1, non_retryable=(ValueError,))
+    )
+    registry.register("t", failing(UnicodeDecodeError("utf-8", b"", 0, 1, "r")))
+    job = queue.enqueue("t")
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_type_policy_replaces_default():
+    queue = JobQueue(default_retry_policy=RetryPolicy(non_retryable=(ValueError,)))
+    queue.set_retry_policy("a", RetryPolicy(max_attempts=5))
+    assert queue.retry_policy_for("a").non_retryable == ()
+    assert queue.retry_policy_for("b").non_retryable == (ValueError,)
+    queue.set_retry_policy("a", None)
+    assert queue.retry_policy_for("a") is queue.retry_policy_for("b")
+    assert JobQueue().retry_policy_for("a") is None
+
+
+def test_invalid_policy_args():
+    queue = JobQueue()
+    with pytest.raises(ConfigError):
+        queue.set_retry_policy("a", "oops")
+    with pytest.raises(ConfigError):
+        queue.set_retry_policy("", RetryPolicy())
+    with pytest.raises(ConfigError):
+        JobQueue(default_retry_policy="x")
+
+
+def test_policy_at_failure_time(queue, registry, worker):
+    registry.register("t", failing(TimeoutError()))
+    job = queue.enqueue("t")
+    queue.set_retry_policy("t", RetryPolicy())
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+
+
+def test_unknown_handler_no_retry_no_rng(clock):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy(jitter=0.5))
+    rng = CountingRng()
+    job = queue.enqueue("nope")
+    Worker(queue, HandlerRegistry(), rng=rng).run_once()
+    assert job.status is JobStatus.FAILED
+    assert job.error.startswith("UnknownJobTypeError")
+    assert rng.calls == []
+
+
+def test_retry_succeeds_clears_error(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy())
+    worker = Worker(queue, registry)
+    calls = []
+
+    def handler(job):
+        calls.append(1)
+        if len(calls) < 3:
+            raise TimeoutError("x")
+        return "ok"
+
+    registry.register("t", handler)
+    job = queue.enqueue("t")
+    for _ in range(3):
+        worker.run_once()
+        clock.advance(10)
+    assert job.status is JobStatus.SUCCEEDED
+    assert job.error is None
+    m = queue.metrics
+    assert (m.get("jobs.started"), m.get("jobs.retried"), m.get("jobs.succeeded")) == (3, 2, 1)
+    assert m.get("jobs.failed") == 0 and m.get("jobs.dead_lettered") == 0
+
+
+def test_cancel_retry_scheduled(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy())
+    registry.register("t", failing(TimeoutError()))
+    job = queue.enqueue("t")
+    worker = Worker(queue, registry)
+    worker.run_once()
+    queue.cancel(job.id)
+    assert job.status is JobStatus.CANCELLED
+    clock.advance(1000)
+    assert worker.run_pending() == 0
+    assert queue.metrics.get("jobs.cancelled") == 1
+
+
+def test_rng_used_once_only_on_retry(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy(max_attempts=2, jitter=0.5))
+    rng = CountingRng()
+    worker = Worker(queue, registry, rng=rng)
+    registry.register("t", failing(TimeoutError()))
+    queue.enqueue("t")
+    worker.run_once()
+    assert len(rng.calls) == 1
+    clock.advance(100)
+    worker.run_once()  # dead-letter
+    assert len(rng.calls) == 1
