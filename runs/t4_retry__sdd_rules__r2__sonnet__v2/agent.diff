@@ -0,0 +1,123 @@
+import pytest
+
+from jobq import (
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+
+
+@pytest.fixture
+def dl_queue(clock):
+    return JobQueue(clock=clock, default_retry_policy=RetryPolicy(max_attempts=1))
+
+
+def _timeout(job):
+    raise TimeoutError("gw")
+
+
+def _permanent(job):
+    raise PermanentJobError("p")
+
+
+def run_fail(queue, registry, job_type="billing"):
+    if job_type not in registry:
+        registry.register(job_type, _timeout)
+    job = queue.enqueue(job_type)
+    Worker(queue, registry).run_once()
+    return job
+
+
+def test_statuses_and_labels():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert not JobStatus.DEAD_LETTERED.is_terminal
+
+
+def test_entry_and_order(dl_queue, registry, clock):
+    assert dl_queue.dead_letters() == []
+    a = run_fail(dl_queue, registry, "billing")
+    b = run_fail(dl_queue, registry, "mail")
+    entries = dl_queue.dead_letters()
+    assert [e.job_id for e in entries] == [a.id, b.id]
+    assert entries[0].job_type == "billing"
+    assert entries[0].attempts == 1
+    assert entries[0].error == "TimeoutError: gw"
+    assert entries[0].dead_lettered_at == clock.now()
+    entries.clear()
+    assert len(dl_queue.dead_letters()) == 2
+
+
+def test_requeue(dl_queue, registry, clock):
+    job = run_fail(dl_queue, registry)
+    clock.advance(5)
+    same = dl_queue.requeue_dead_letter(job.id)
+    assert same is job
+    assert (job.status, job.run_at, job.error, job.attempts) == (
+        JobStatus.PENDING,
+        clock.now(),
+        None,
+        0,
+    )
+    assert job.finished_at is None
+    assert dl_queue.dead_letters() == []
+    assert dl_queue.metrics.get("jobs.requeued") == 1
+    assert dl_queue.metrics.get("jobs.dead_lettered") == 1
+
+
+def test_requeued_job_retries(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy(max_attempts=2))
+    job = run_fail(queue, registry)
+    clock.advance(100)
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    queue.requeue_dead_letter(job.id)
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+
+
+def test_requeue_errors(queue):
+    job = queue.enqueue("t")
+    with pytest.raises(InvalidTransitionError):
+        queue.requeue_dead_letter(job.id)
+    assert job.status is JobStatus.PENDING
+    assert queue.metrics.get("jobs.requeued") == 0
+    with pytest.raises(JobNotFoundError):
+        queue.requeue_dead_letter("nope")
+
+
+def test_cancel_forbidden(dl_queue, registry):
+    job = run_fail(dl_queue, registry)
+    with pytest.raises(InvalidTransitionError):
+        dl_queue.cancel(job.id)
+    assert job.status is JobStatus.DEAD_LETTERED
+
+
+def test_purge_keeps_dead_letter(dl_queue, registry, clock):
+    registry.register("ok", lambda job: 1)
+    registry.register("perm", _permanent)
+    dl_queue.enqueue("ok")
+    dl_queue.enqueue("perm")
+    Worker(dl_queue, registry).run_pending()
+    dead = run_fail(dl_queue, registry)
+    clock.advance(1000)
+    assert dl_queue.purge_finished() == 2
+    assert dead.id in dl_queue.store
+    assert len(dl_queue.dead_letters()) == 1
+
+
+def test_stats_and_report(dl_queue, registry):
+    assert dl_queue.stats()["retry_scheduled"] == 0
+    run_fail(dl_queue, registry)
+    assert dl_queue.stats()["dead_lettered"] == 1
+    report = render_report(dl_queue)
+    assert "Ожидает повтора" in report
+    assert "В dead-letter" in report
