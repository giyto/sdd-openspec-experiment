+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import detect_format, import_statement, normalize_description
+from ledger.rules import Categorizer, Rule, normalize_text
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = "Дата;Сумма;Описание\n01.03.2026;-1 200,50;Магазин Лента\n02.03.2026;+85 000,00;Зарплата\n"
+SPLIT = "Дата;Описание;Приход;Расход\n01.03.2026;Магазин;;1 200,50\n02.03.2026;Зарплата;85 000,00;\n"
+
+
+def test_detect_formats(write_csv):
+    assert detect_format(write_csv("date,amount,description\n")) == "nova"
+    assert detect_format(write_csv(SFERA)) == "sfera"
+    assert detect_format(write_csv(SPLIT)) == "sfera_split"
+
+
+def test_header_is_case_insensitive_and_extra_columns_ignored(write_csv, clock):
+    text = " Номер карты ; ДАТА ;Остаток; сумма ;  Описание \n1234;01.03.2026;10,00; -5,00 ;Чай\n"
+    store = MemoryStore()
+    result = import_statement(write_csv(text), store, clock=clock)
+    assert result.format == "sfera"
+    assert [t.amount for t in store.all()] == [Decimal("-5.00")]
+
+
+def test_unknown_header_raises_in_any_mode(write_csv, clock):
+    for strict in (False, True):
+        with pytest.raises(UnknownFormatError):
+            import_statement(write_csv("foo;bar\n1;2\n"), MemoryStore(), strict=strict, clock=clock)
+
+
+def test_empty_file_is_unknown_format(write_csv, clock):
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(""), store, clock=clock)
+    assert store.all() == []
+
+
+def test_explicit_fmt_must_match_header(write_csv, clock):
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="nova", clock=clock)
+    assert info.value.line_no == 1
+
+
+def test_unknown_fmt_name(write_csv, clock):
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="tinkoff", clock=clock)
+
+
+def test_sfera_amounts_with_nbsp_and_sign(write_csv, clock):
+    text = "Дата;Сумма;Описание\n01.03.2026;-1 200,50;A\n02.03.2026;85 000,00;B\n03.03.2026;+7,5;C\n"
+    store = MemoryStore()
+    result = import_statement(write_csv(text), store, clock=clock)
