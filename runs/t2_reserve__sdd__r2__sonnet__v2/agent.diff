diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..7f504c8
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,438 @@
+import dataclasses
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    Reservation,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationLine,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ReservationStatus,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.reservations import normalize_lines, validate_ttl
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "NUT-M8", 10)
+    return inv
+
+
+def state(inv):
+    records = [dataclasses.replace(r) for r in inv.store.reservations()]
+    return inv.log.lines(), inv.stock_levels(), records
+
+
+# --- модели и ошибки ---------------------------------------------------------
+
+
+def test_models_are_immutable(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert isinstance(res.lines, tuple)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        res.status = ReservationStatus.CANCELLED
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        res.lines[0].qty = 5
+
+
+def test_errors_hierarchy():
+    for cls in (ReservationNotFoundError, ReservationExpiredError, DuplicateReservationError):
+        err = cls("SO-1")
+        assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+        assert err.order_id == "SO-1"
+    err = ReservationStateError("SO-1", "CANCELLED")
+    assert isinstance(err, ReservationError) and err.order_id == "SO-1"
+
+
+# --- reservations.py ---------------------------------------------------------
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 5, "5", None])
+def test_validate_ttl_rejects(ttl):
+    with pytest.raises(ValidationError):
+        validate_ttl(ttl)
+
+
+def test_default_ttl():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+def test_normalize_lines_accepts_tuple_and_line():
+    lines = normalize_lines(iter([("A", "S", 1), ReservationLine("B", "S", 2)]))
+    assert lines == (ReservationLine("A", "S", 1), ReservationLine("B", "S", 2))
+
+
+@pytest.mark.parametrize("bad", [("A", "S"), "abc", 5, ("A", "S", 1, 1), ["A", "S", 1]])
+def test_normalize_lines_bad_line(bad):
+    with pytest.raises(ValidationError):
+        normalize_lines([bad])
+
+
+def test_normalize_lines_bad_values():
+    with pytest.raises(InvalidQuantityError):
+        normalize_lines([("A", "S", 0)])
+    with pytest.raises(ValidationError):
+        normalize_lines([("A B", "S", 1)])
+    with pytest.raises(ValidationError):
+        normalize_lines(5)
+
+
+# --- reserve -----------------------------------------------------------------
+
+
+def test_reserve_multiple_warehouses(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ReservationLine("NORTH", "NUT-M8", 1)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + timedelta(minutes=15)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.on_hand("NORTH", "NUT-M8") == 10
+
+
+def test_reserve_explicit_ttl(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    assert res.expires_at - res.created_at == 5 * MIN
+
+
+def test_reserve_keeps_duplicate_lines(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("NORTH", "NUT-M8", 1), ("MAIN", "BOLT-M8", 3)])
+    assert [l.qty for l in res.lines] == [2, 1, 3]
+
+
+def test_reserve_events(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("NORTH", "NUT-M8", 1)])
+    lines = stocked.log.lines()[-2:]
+    assert lines[0] == (
+        "000003 2026-03-01T10:00:00Z RESERVE expires=2026-03-01T10:15:00Z order=SO-1 "
+        "qty=2 sku=BOLT-M8 wh=MAIN"
+    )
+    assert "RESERVE" in lines[1] and "sku=NUT-M8" in lines[1]
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 10, "x"])
+def test_reserve_bad_ttl_is_atomic(stocked, ttl):
+    before = state(stocked)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=ttl)
+    assert state(stocked) == before
+
+
+def test_reserve_ttl_overflow(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(days=999_999_999))
+
+
+def test_reserve_empty_and_bad_order(stocked):
+    before = state(stocked)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO 1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO=1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("MAIN", "NOPE", 1)])
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 0)])
+    assert state(stocked) == before
+
+
+def test_reserve_sums_duplicate_positions(stocked):
+    stocked.receive("MAIN", "NUT-M8", 5)
+    before = state(stocked)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "NUT-M8", 3), ("MAIN", "NUT-M8", 3)])
+    assert (exc.value.requested, exc.value.available) == (6, 5)
+    assert state(stocked) == before
+
+
+def test_reserve_partial_failure_reserves_nothing(stocked):
+    before = state(stocked)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("MAIN", "NUT-M8", 1)])
+    assert state(stocked) == before
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+
+
+def test_reserve_only_from_available(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 3)])
+    assert exc.value.available == 2
+
+
+def test_duplicate_active_and_confirmed(stocked):
+    first = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    before = state(stocked)
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert state(stocked) == before
+    assert stocked.get_reservation("SO-1") == first
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_replace_expired_and_cancelled(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(15 * MIN)
+    res = stocked.reserve("SO-1", [("NORTH", "NUT-M8", 2)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.lines == (ReservationLine("NORTH", "NUT-M8", 2),)
+    stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    assert res.status is ReservationStatus.ACTIVE and res.lines[0].qty == 3
+
+
+# --- запросы и истечение -----------------------------------------------------
+
+
+def test_available_and_reserved(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+    assert stocked.available("MAIN", "BOLT-M8") == 6
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.available("MAIN", "NUT-M8") == 0
+
+
+def test_available_unknown_sku(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.available("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("MAIN", "NOPE")
+
+
+def test_available_after_adjust_below_reserve(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    stocked.adjust("MAIN", "BOLT-M8", 2, "recount")
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+
+
+def test_expiry_boundary(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(15 * MIN - timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    clock.advance(timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+
+
+def test_expiry_writes_nothing_to_log(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    size = len(stocked.log)
+    clock.advance(timedelta(hours=1))
+    stocked.get_reservation("SO-1")
+    stocked.available("MAIN", "BOLT-M8")
+    assert len(stocked.log) == size
+
+
+def test_confirmed_stays_confirmed(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.confirm("SO-1")
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+
+
+def test_snapshot_is_detached(stocked):
+    snap = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.confirm("SO-1")
+    assert snap.status is ReservationStatus.ACTIVE
+    assert isinstance(snap, Reservation)
+
+
+# --- issue / transfer --------------------------------------------------------
+
+
+def test_issue_respects_reservations(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    before = state(stocked)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 3)
+    assert exc.value.available == 2
+    assert state(stocked) == before
+    assert stocked.issue("MAIN", "BOLT-M8", 2) == 8
+
+
+def test_issue_after_expiry(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    clock.advance(15 * MIN)
+    assert stocked.issue("MAIN", "BOLT-M8", 10) == 0
+
+
+def test_transfer_respects_reservations(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("MAIN", "NORTH", "BOLT-M8", 3)
+    stocked.transfer("MAIN", "NORTH", "BOLT-M8", 2)
+    assert stocked.on_hand("NORTH", "BOLT-M8") == 2
+    clock.advance(15 * MIN)
+    stocked.transfer("MAIN", "NORTH", "BOLT-M8", 8)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+
+
+# --- confirm -----------------------------------------------------------------
+
+
+def test_confirm_success_and_events(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ("NORTH", "NUT-M8", 1)])
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 6
+    assert stocked.on_hand("NORTH", "NUT-M8") == 9
+    tail = stocked.log.lines()[-3:]
+    assert tail[0].endswith("ISSUE qty=4 ref=SO-1 sku=BOLT-M8 wh=MAIN")
+    assert tail[1].endswith("ISSUE qty=1 ref=SO-1 sku=NUT-M8 wh=NORTH")
+    assert tail[2].endswith("RESERVE_CONFIRM order=SO-1")
+
+
+def test_confirm_when_available_is_zero(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    assert stocked.confirm("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_after_adjust_is_atomic(stocked):
+    stocked.reserve("SO-1", [("NORTH", "NUT-M8", 1), ("MAIN", "BOLT-M8", 5)])
+    stocked.adjust("MAIN", "BOLT-M8", 2, "recount")
+    before = state(stocked)
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert state(stocked) == before
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+
+
+def test_confirm_sums_duplicate_lines(stocked):
+    stocked.receive("MAIN", "OIL-5L", 5)
+    stocked.reserve("SO-1", [("MAIN", "OIL-5L", 2), ("MAIN", "OIL-5L", 3)])
+    stocked.adjust("MAIN", "OIL-5L", 4, "recount")
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.confirm("SO-1")
+    assert exc.value.requested == 5
+
+
+def test_confirm_wrong_states(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    clock.advance(15 * MIN)
+    before = state(stocked)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+    assert state(stocked) == before
+
+
+# --- cancel / extend ---------------------------------------------------------
+
+
+def test_cancel_active_and_idempotent(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    size = len(stocked.log)
+    assert stocked.log.lines()[-1].endswith("RESERVE_CANCEL order=SO-1")
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == size
+
+
+def test_cancel_expired_stays_expired(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(15 * MIN)
+    size = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == size
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+
+
+def test_cancel_confirmed(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-1")
+
+
+def test_extend_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(10 * MIN)
+    res = stocked.extend("SO-1", 15 * MIN)
+    assert res.expires_at == clock.now() + 15 * MIN
+    assert stocked.log.lines()[-1] == (
+        "000004 2026-03-01T10:10:00Z RESERVE_EXTEND expires=2026-03-01T10:25:00Z order=SO-1"
+    )
+
+
+def test_extend_never_shortens(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    size = len(stocked.log)
+    same = stocked.extend("SO-1", 5 * MIN)
+    assert same.expires_at == res.expires_at
+    assert stocked.extend("SO-1", 15 * MIN).expires_at == res.expires_at
+    assert len(stocked.log) == size
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)], ttl=MIN)
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-3", timedelta(0))
+    with pytest.raises(ValidationError):
+        stocked.extend("MISSING", timedelta(0))
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-1", MIN)
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2", MIN)
+    clock.advance(MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-3", MIN)
+
+
+# --- not found ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda inv: inv.confirm("NOPE"),
+        lambda inv: inv.cancel("NOPE"),
+        lambda inv: inv.extend("NOPE", MIN),
+        lambda inv: inv.get_reservation("NOPE"),
+    ],
+    ids=["confirm", "cancel", "extend", "get_reservation"],
+)
+def test_not_found(stocked, call):
+    with pytest.raises(ReservationNotFoundError) as exc:
+        call(stocked)
+    assert exc.value.order_id == "NOPE"
+
+
+def test_event_lines_parse(stocked):
+    from warehouse import parse_line
+
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.extend("SO-1", 20 * MIN)
+    stocked.confirm("SO-1")
+    for line in stocked.log.lines():
+        assert parse_line(line).format() == line
