+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.errors import ValidationError
+from shop.promo import DiscountKind, PromoCode
+
+START = datetime(2026, 6, 1, tzinfo=timezone.utc)
+END = datetime(2026, 9, 1, tzinfo=timezone.utc)
+
+
+def percent(value="10", **kwargs):
+    return PromoCode("summer10", DiscountKind.PERCENT, Decimal(value), **kwargs)
+
+
+def fixed(value="100.00", **kwargs):
+    return PromoCode("minus100", DiscountKind.FIXED, Decimal(value), **kwargs)
+
+
+def test_code_is_normalized():
+    assert percent().code == "SUMMER10"
+    assert PromoCode(" summer10 ", DiscountKind.PERCENT, Decimal("5")).code == "SUMMER10"
+
+
+@pytest.mark.parametrize("code", ["", "   "])
+def test_empty_code_is_rejected(code):
+    with pytest.raises(ValidationError):
+        PromoCode(code, DiscountKind.PERCENT, Decimal("5"))
+
+
+@pytest.mark.parametrize("value", ["0", "150", "-1"])
+def test_percent_out_of_range_is_rejected(value):
+    with pytest.raises(ValidationError):
+        percent(value)
+
+
+def test_percent_100_and_fractional_percent_are_allowed():
+    assert percent("100").value == Decimal("100")
+    assert percent("12.5").value == Decimal("12.5")
+
+
+@pytest.mark.parametrize("value", ["0", "-5.00"])
+def test_fixed_must_be_positive(value):
+    with pytest.raises(ValidationError):
+        fixed(value)
+
+
+def test_fixed_with_fraction_beyond_kopecks_is_rejected():
+    with pytest.raises(ValidationError):
+        fixed("10.005")
+
+
+def test_fixed_with_kopecks_is_allowed():
+    assert fixed("10.50").value == Decimal("10.50")
+
+
+def test_money_must_be_decimal():
+    with pytest.raises(ValidationError):
+        PromoCode("X", DiscountKind.FIXED, 10)  # type: ignore[arg-type]
+
+
+def test_negative_minimum_is_rejected():
+    with pytest.raises(ValidationError):
+        percent(min_order_amount=Decimal("-1.00"))
+
+
+@pytest.mark.parametrize("max_uses", [0, -3, True, 1.5])
+def test_max_uses_must_be_positive_integer(max_uses):
+    with pytest.raises(ValidationError):
+        percent(max_uses=max_uses)
+
+
+def test_max_uses_one_and_none_are_allowed():
+    assert percent(max_uses=1).max_uses == 1
+    assert percent().max_uses is None
+
+
+def test_starts_at_must_be_before_expires_at():
+    with pytest.raises(ValidationError):
+        percent(starts_at=END, expires_at=START)
+    with pytest.raises(ValidationError):
+        percent(starts_at=START, expires_at=START)
+
+
+def test_naive_datetime_is_rejected():
+    with pytest.raises(ValidationError):
+        percent(starts_at=datetime(2026, 6, 1))
+
+
+def test_excluded_categories_are_frozen_and_checked():
+    promo = percent(excluded_categories=[Category.BOOKS])
+    assert promo.excluded_categories == frozenset({Category.BOOKS})
+    with pytest.raises(ValidationError):
+        percent(excluded_categories=["books"])
