+import pytest
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+)
+
+PROMO_ERRORS = (UnknownPromoCodeError, PromoExpiredError, PromoConditionsError)
+
+
+@pytest.mark.parametrize("error_type", (PromoError, *PROMO_ERRORS))
+def test_promo_errors_are_shop_errors(error_type):
+    assert issubclass(error_type, ShopError)
+
+
+@pytest.mark.parametrize("error_type", PROMO_ERRORS)
+def test_promo_errors_derive_from_promo_error(error_type):
+    assert issubclass(error_type, PromoError)
+
+
+@pytest.mark.parametrize(
+    ("first", "second"),
+    [(a, b) for a in PROMO_ERRORS for b in PROMO_ERRORS if a is not b],
+)
+def test_specific_promo_errors_are_independent(first, second):
+    assert not issubclass(first, second)
+
+
+def test_unknown_promo_code_error_keeps_code():
+    error = UnknownPromoCodeError("NOPE")
+    assert error.code == "NOPE"
+    assert "NOPE" in str(error)
diff --git a/tests/test_promo_registry.py b/tests/test_promo_registry.py
new file mode 100644
index 0000000..42a1aee
--- /dev/null
+++ b/tests/test_promo_registry.py
@@ -0,0 +1,142 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+START = datetime(2026, 6, 1, 0, 0, tzinfo=timezone.utc)
+END = datetime(2026, 9, 1, 0, 0, tzinfo=timezone.utc)
+
+
+def make_promo(**kwargs):
+    defaults = dict(kind=DiscountKind.PERCENT, value=Decimal("10"))
+    defaults.update(kwargs)
+    return PromoCode("SUMMER10", **defaults)
+
+
+@pytest.fixture
+def registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(make_promo())
+    return reg
+
+
+def test_resolve_finds_normalized_code(registry):
+    assert registry.resolve("  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize("code", ["NOPE", "", "   "])
+def test_unknown_and_empty_codes_are_unknown(registry, code):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve(code)
+
+
+def test_duplicate_registration_is_rejected(registry):
+    with pytest.raises(ValidationError):
+        registry.add(make_promo(value=Decimal("20")))
+    with pytest.raises(ValidationError):
+        registry.add(PromoCode("Summer10", DiscountKind.PERCENT, Decimal("5")))
+
+
+def test_start_is_inclusive_and_end_is_exclusive():
+    clock = FixedClock(START)
+    reg = PromoRegistry(clock)
+    reg.add(make_promo(starts_at=START, expires_at=END))
+    assert reg.resolve("SUMMER10").code == "SUMMER10"
+    clock.set(END - timedelta(microseconds=1))
+    assert reg.resolve("SUMMER10").code == "SUMMER10"
+    clock.set(END)
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_before_start_is_expired():
+    clock = FixedClock(START - timedelta(seconds=1))
+    reg = PromoRegistry(clock)
+    reg.add(make_promo(starts_at=START))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_expiry_is_checked_before_limit():
+    clock = FixedClock(START)
+    reg = PromoRegistry(clock)
+    reg.add(make_promo(starts_at=START, expires_at=END, max_uses=1))
+    reg.consume("SUMMER10")
+    clock.set(END)
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_uses_start_at_zero(registry):
+    assert registry.uses("summer10") == 0
+
+
+def test_uses_unknown_code_raises(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE")
+
+
+def test_consume_counts_and_respects_limit(clock):
+    reg = PromoRegistry(clock)
+    reg.add(make_promo(max_uses=2))
