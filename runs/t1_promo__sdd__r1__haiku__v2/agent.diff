+def _allocate_discount(cart: Cart, promo: PromoCode | None) -> tuple[Decimal, ...]:
+    """Discount of every cart line (same order as ``cart.lines``), summing to the order discount.
+
+    Each participating line gets ``floor(discount * amount / base)`` kopecks, where ``base``
+    is the amount of all participating lines. The leftover kopecks go one by one to the lines
+    with the largest remainders; on equal remainders the earlier line in the cart wins.
+    """
+    if promo is None:
+        return tuple(ZERO for _ in cart.lines)
+
+    eligible = [
+        index
+        for index, cart_line in enumerate(cart.lines)
+        if cart_line.product.category is not Category.GIFT_CARD
+        and cart_line.product.category not in promo.excluded_categories
+    ]
+    if not eligible:
+        raise PromoConditionsError(f"promo code {promo.code} applies to no lines of the cart")
+
+    base = sum_money(cart.lines[index].amount for index in eligible)
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"promo code {promo.code} requires goods of at least {promo.min_order_amount}"
+        )
+    if promo.kind is DiscountKind.PERCENT:
+        discount = quantize_money(base * promo.value / 100)
+    else:
+        discount = min(promo.value, base)
+
+    total_kopecks = int(discount / CENT)
+    base_kopecks = int(base / CENT)
+    shares: dict[int, int] = {}
+    remainders: dict[int, int] = {}
+    for index in eligible:
+        line_kopecks = int(cart.lines[index].amount / CENT)
+        shares[index], remainders[index] = divmod(total_kopecks * line_kopecks, base_kopecks)
+    leftover = total_kopecks - sum(shares.values())
+    for index in sorted(eligible, key=lambda i: (-remainders[i], i))[:leftover]:
+        shares[index] += 1
+
+    return tuple(
+        CENT * shares[index] if index in shares else ZERO for index in range(len(cart.lines))
     )
