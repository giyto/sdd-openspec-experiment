new file mode 100644
index 0000000..4a9cde1
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,145 @@
+"""Promo codes: their definition, registration, validity period and usage limit.
+
+:class:`PromoCode` describes a discount. :class:`PromoRegistry` keeps the codes, checks
+that a code exists, is inside its validity period and is under its usage limit, and
+counts successful uses. How a discount is spread over the lines of an order is decided
+in :mod:`shop.pricing`.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock, SystemClock
+from .errors import PromoConditionsError, PromoExpiredError, UnknownPromoCodeError, ValidationError
+from .money import ZERO, quantize_money
+
+logger = logging.getLogger(__name__)
+
+MAX_PERCENT = Decimal("100")
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    """A promo code. ``value`` is a percentage for PERCENT, rubles for FIXED."""
+
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    excluded_categories: frozenset[Category] = frozenset()
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError(f"discount kind of {self.code} must be a DiscountKind")
+        _check_decimal(self.value, f"value of {self.code}")
+        if self.kind is DiscountKind.PERCENT:
+            if not ZERO < self.value <= MAX_PERCENT:
+                raise ValidationError(f"percent of {self.code} must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"fixed discount of {self.code} must be positive")
+            _check_kopecks(self.value, f"fixed discount of {self.code}")
+
+        _check_decimal(self.min_order_amount, f"minimum order amount of {self.code}")
+        if self.min_order_amount < 0:
+            raise ValidationError(f"minimum order amount of {self.code} must not be negative")
+        _check_kopecks(self.min_order_amount, f"minimum order amount of {self.code}")
+
+        excluded = frozenset(self.excluded_categories)
+        if not all(isinstance(category, Category) for category in excluded):
+            raise ValidationError(f"excluded categories of {self.code} must be Category values")
+        object.__setattr__(self, "excluded_categories", excluded)
+
+        for label, moment in (("starts_at", self.starts_at), ("expires_at", self.expires_at)):
+            if moment is not None and (moment.tzinfo is None or moment.utcoffset() is None):
+                raise ValidationError(f"{label} of {self.code} must be an aware datetime")
+        if self.starts_at is not None and self.expires_at is not None:
+            if self.starts_at >= self.expires_at:
+                raise ValidationError(f"promo code {self.code} must start before it expires")
+
+        if self.max_uses is not None:
+            if isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int):
+                raise ValidationError(f"max_uses of {self.code} must be an integer")
+            if self.max_uses < 1:
+                raise ValidationError(f"max_uses of {self.code} must be at least 1")
+
+
+def _check_decimal(amount: object, label: str) -> None:
+    if not isinstance(amount, Decimal) or not amount.is_finite():
+        raise ValidationError(f"{label} must be a finite Decimal")
+
+
+def _check_kopecks(amount: Decimal, label: str) -> None:
+    if quantize_money(amount) != amount:
+        raise ValidationError(f"{label} has more than two fractional digits")
+
+
+class PromoRegistry:
+    """In-memory registry of promo codes and their successful-use counters.
+
+    ``resolve`` checks in this order: the code exists, the validity period
+    ``[starts_at, expires_at)`` contains the current time, the usage limit is not reached.
+    """
+
+    def __init__(self, clock: Clock | None = None) -> None:
+        self._clock = clock or SystemClock()
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+
+    def add(self, promo: PromoCode) -> None:
+        if promo.code in self._promos:
+            raise ValidationError(f"duplicate promo code: {promo.code}")
+        self._promos[promo.code] = promo
+        self._uses[promo.code] = 0
+        logger.debug("promo: registered %s", promo.code)
+
+    def resolve(self, code: str) -> PromoCode:
+        """Return the promo code if it can be used right now, otherwise raise."""
+        promo = self._find(code)
+        now = self._clock.now()
+        if promo.starts_at is not None and now < promo.starts_at:
+            raise PromoExpiredError(f"promo code {promo.code} starts at {promo.starts_at.isoformat()}")
+        if promo.expires_at is not None and now >= promo.expires_at:
+            raise PromoExpiredError(f"promo code {promo.code} expired at {promo.expires_at.isoformat()}")
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} has no uses left")
+        return promo
+
+    def uses(self, code: str) -> int:
+        return self._uses[self._find(code).code]
+
+    def consume(self, code: str) -> None:
+        """Count one successful use. Runs the same checks as :meth:`resolve`."""
+        promo = self.resolve(code)
+        self._uses[promo.code] += 1
+        logger.debug("promo: %s used %d time(s)", promo.code, self._uses[promo.code])
+
+    def release(self, code: str) -> None:
+        """Undo one successful use, e.g. when an order is cancelled. No time or limit checks."""
+        promo = self._find(code)
+        if self._uses[promo.code] == 0:
+            raise ValidationError(f"promo code {promo.code} has no uses to release")
+        self._uses[promo.code] -= 1
+
+    def _find(self, code: str) -> PromoCode:
+        try:
+            return self._promos[normalize_key(code)]
+        except KeyError:
+            raise UnknownPromoCodeError(code) from None
