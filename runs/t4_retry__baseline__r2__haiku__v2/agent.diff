+def test_retry_exhaustion_goes_to_dead_letter(queue, registry, clock):
+    registry.register("boom", _always_raise(TransientError("timeout")))
+    queue.set_retry_policy("boom", RetryPolicy(max_attempts=2, base_delay=1.0))
+    worker = Worker(queue, registry)
+    job = queue.enqueue("boom")
+
+    worker.run_once()
+    clock.advance(1)
+    worker.run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.attempts == 2
+    assert job.error == "TransientError: timeout"
+    assert job.finished_at == START + timedelta(seconds=1)
+    assert queue.dead_letters() == [
+        DeadLetterEntry(
+            job_id=job.id,
+            job_type="boom",
+            attempts=2,
+            error="TransientError: timeout",
+            dead_lettered_at=START + timedelta(seconds=1),
+        )
+    ]
+    assert queue.metrics.get("jobs.retried") == 1
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    assert queue.metrics.get("jobs.failed") == 0
+    assert worker.run_once() is None
