+def test_public_api_signatures():
+    sig = inspect.signature(import_statement)
+    assert list(sig.parameters) == ["path", "store", "fmt", "strict", "categorizer", "clock"]
+    for name in ("fmt", "strict", "categorizer", "clock"):
+        assert sig.parameters[name].kind is inspect.Parameter.KEYWORD_ONLY
+    assert [f.name for f in dataclasses.fields(ImportResult)] == [
+        "format", "encoding", "added", "duplicates", "errors",
+    ]
+    assert [f.name for f in dataclasses.fields(RowError)] == ["line_no", "message"]
+    assert list(inspect.signature(import_csv).parameters) == [
+        "path", "store", "categorizer", "clock",
+    ]
+    assert list(inspect.signature(detect_format).parameters) == ["path"]
