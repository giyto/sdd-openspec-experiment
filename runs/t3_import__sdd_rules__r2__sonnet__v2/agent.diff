+import dataclasses
+import inspect
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = "Дата;Сумма;Описание\n"
+SPLIT = "Дата;Описание;Приход;Расход\n"
+NOVA = "date,amount,description\n"
+
+
+def test_error_classes():
+    assert issubclass(UnknownFormatError, StatementError)
+    assert issubclass(StatementRowError, StatementError)
+    assert StatementRowError("x", line_no=3).line_no == 3
+
+
+def test_sfera_success(write_csv):
+    store = MemoryStore()
+    text = SFERA + "01.03.2026;-1 200,50;Магазин Лента\n02.03.2026;+85 000,00;Зарплата\n"
+    res = import_statement(write_csv(text), store)
+    assert (res.format, res.encoding, res.added, res.duplicates, res.errors) == (
+        "sfera", "utf-8", 2, 0, [],
+    )
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+
+
+def test_detect_variants(write_csv):
+    assert detect_format(write_csv(SPLIT)) == "sfera_split"
+    assert detect_format(write_csv(NOVA)) == "nova"
+    assert detect_format(write_csv("﻿" + SFERA)) == "sfera"
+    assert detect_format(write_csv("Номер карты; ДАТА ; Описание; Сумма ;Остаток\n")) == "sfera"
+    assert detect_format(write_csv("Сумма;Описание;Дата\n")) == "sfera"
+
+
+def test_bom_and_cp1251(write_csv):
+    store = MemoryStore()
+    res = import_statement(write_csv("﻿" + SFERA + "01.03.2026;-5,00;Кофе\n"), store)
+    assert res.encoding == "utf-8" and res.added == 1
+    res = import_statement(
+        write_csv(SFERA + "01.03.2026;-6,00;Ёлка\n", encoding="cp1251"), store
+    )
+    assert res.encoding == "cp1251"
+    assert store.all()[1].description == "Ёлка"
+
+
+def test_undecodable(write_csv, tmp_path):
+    path = tmp_path / "bad.csv"
+    path.write_bytes(b"\xff\x98\n")
+    with pytest.raises(StatementError) as info:
+        import_statement(path, MemoryStore())
+    assert info.value.line_no is None
+    with pytest.raises(StatementError):
+        import_statement(tmp_path / "missing.csv", MemoryStore())
+
+
+@pytest.mark.parametrize(
+    "text, line",
+    [
+        ("", None),
+        ("\n  \n", None),
+        ("foo,bar\n", 1),
+        ("\nfoo,bar\n", 2),
+        ("Дата;Сумма;Приход;Расход;Описание\n", 1),
+        ("Дата;Сумма;Сумма;Описание\n", 1),
+    ],
+)
+@pytest.mark.parametrize("strict", [False, True])
+def test_unknown_header(write_csv, text, line, strict):
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv(text), store, strict=strict)
+    assert info.value.line_no == line
+    assert store.all() == []
+
+
+def test_explicit_fmt(write_csv):
+    path = write_csv(SFERA + "01.03.2026;-5,00;x\n")
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError):
+        import_statement(path, store, fmt="nova")
+    with pytest.raises(UnknownFormatError):
+        import_statement(path, store, fmt="bogus")
+    assert store.all() == []
+    assert import_statement(path, store, fmt="sfera").added == 1
+
+
+def test_junk_rows_and_numbering(write_csv):
+    text = "\n" + SFERA + "\n;;;\n   \n01.03.2026;-5,00;a\n\n;;;\n01.03.2026;abc;b\n\n"
+    res = import_statement(write_csv(text), MemoryStore())
+    assert res.added == 1 and res.duplicates == 0
+    assert [e.line_no for e in res.errors] == [9]
+
+
+def test_nova_junk(write_csv):
+    res = import_statement(write_csv(NOVA + ",,\n2026-03-01,-1.00,a\n"), MemoryStore())
+    assert res.added == 1 and res.errors == []
+
+
+def test_multiline_numbering(write_csv):
+    text = SFERA + '01.03.2026;-5,00;"a\nb"\n01.03.2026;oops;c\n'
+    res = import_statement(write_csv(text), MemoryStore())
+    assert res.added == 1
+    assert res.errors[0].line_no == 4
+
