@@ -0,0 +1,148 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    EmptyCartError,
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+@pytest.fixture
+def service(clock, registry):
+    registry.add(PromoCode("SUMMER10", DiscountKind.PERCENT, Decimal("10")))
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def cart(products):
+    cart = Cart()
+    cart.add(products["shirt"])
+    return cart
+
+
+def test_without_code(service, cart):
+    for code in (None, "", "   "):
+        order = service.place_order(cart, code)
+        assert order.promo_code is None
+        assert order.total.discount == Decimal("0.00")
+    assert service.quote(cart, "   ") == service.quote(cart)
+
+
+def test_no_registry_unknown(clock, cart):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart, "SUMMER")
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart, "SUMMER")
+    assert service.quote(cart, "  ") == service.quote(cart)
+    assert len(service.store) == 0
+
+
+def test_quote_applies_and_keeps_counter(service, registry, cart):
+    total = service.quote(cart, " summer10 ")
+    assert total.discount == Decimal("99.90")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_check_order(service, registry, clock, products):
+    with pytest.raises(EmptyCartError):
+        service.quote(Cart(), "NOPE")
+    registry.add(
+        PromoCode(
+            "OLD",
+            DiscountKind.PERCENT,
+            Decimal("10"),
+            min_order_amount=Decimal("100000.00"),
+            expires_at=clock.now() - timedelta(days=1),
+            starts_at=clock.now() - timedelta(days=2),
+        )
+    )
+    cart = Cart()
+    cart.add(products["tea"])
+    with pytest.raises(PromoExpiredError):
+        service.quote(cart, "old")
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart, "nope")
+
+
+def test_place_order_counts(service, registry, cart):
+    order = service.place_order(cart, "summer10")
+    assert order.promo_code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 1
+    assert order.total.discount == service.quote(cart, "SUMMER10").discount
+
+
+def test_failed_attempts_change_nothing(clock, registry, cart):
+    registry.add(
+        PromoCode("BIG", DiscountKind.FIXED, Decimal("10"), min_order_amount=Decimal("99999.00"))
+    )
+    service = OrderService(clock=clock, promos=registry)
+    for code in ("BIG", "NOPE"):
+        with pytest.raises(Exception):
+            service.place_order(cart, code)
+    with pytest.raises(EmptyCartError):
+        service.place_order(Cart(), "BIG")
+    assert registry.uses("BIG") == 0
+    assert len(service.store) == 0
+    assert service.place_order(cart).order_id == "ORD-000001"
+
+
+def test_limit_one_and_cancel(clock, registry, cart):
+    registry.add(PromoCode("ONCE", DiscountKind.FIXED, Decimal("10"), max_uses=1))
+    service = OrderService(clock=clock, promos=registry)
+    first = service.place_order(cart, "once")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "once")
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "once")
+    service.cancel(first.order_id)
+    assert registry.uses("ONCE") == 0
+    assert service.place_order(cart, "once").promo_code == "ONCE"
+
+
+def test_repeated_cancel_keeps_counter(clock, registry, cart):
+    registry.add(PromoCode("TWICE", DiscountKind.FIXED, Decimal("10"), max_uses=5))
+    service = OrderService(clock=clock, promos=registry)
+    a = service.place_order(cart, "twice")
+    service.place_order(cart, "twice")
+    service.cancel(a.order_id)
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(a.order_id)
+    assert registry.uses("TWICE") == 1
+
+
+def test_cancel_after_expiry_releases(clock, registry, cart):
+    registry.add(
+        PromoCode(
+            "SHORT",
+            DiscountKind.FIXED,
+            Decimal("10"),
+            expires_at=clock.now() + timedelta(days=1),
+            max_uses=1,
+        )
+    )
+    service = OrderService(clock=clock, promos=registry)
+    order = service.place_order(cart, "short")
+    clock.advance(timedelta(days=2))
+    service.cancel(order.order_id)
+    assert registry.uses("SHORT") == 0
+
+
+def test_cancel_without_code_leaves_counters(service, registry, cart):
+    service.place_order(cart, "summer10")
+    plain = service.place_order(cart)
+    service.cancel(plain.order_id)
+    assert registry.uses("SUMMER10") == 1
diff --git a/tests/test_pricing_promo.py b/tests/test_pricing_promo.py
new file mode 100644
index 0000000..0ec455e
--- /dev/null
+++ b/tests/test_pricing_promo.py
@@ -0,0 +1,158 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def percent(value, **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("F", DiscountKind.FIXED, D(value), **kw)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def prod(sku, price, category=Category.CLOTHING):
+    return Product(f"SKU-{sku}", sku, D(price), category)
+
+
+def test_no_promo_unchanged(products):
+    cart = cart_of((products["book"], 1), (products["phone"], 1))
+    total = calculate_total(cart)
+    assert total.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in total.lines)
+    assert total.total == total.subtotal + total.shipping + total.tax
+    assert total == calculate_total(cart, promo=None)
+
+
+def test_gift_card_and_excluded_not_counted(products):
+    cart = cart_of((products["book"], 1), (products["gift"], 1), (products["phone"], 1))
+    total = calculate_total(cart, promo=percent("10", excluded_categories={Category.ELECTRONICS}))
+    book, gift, phone = total.lines
+    assert book.discount == D("45.00")
+    assert gift.discount == D("0.00")
+    assert phone.discount == D("0.00")
+    assert total.discount == D("45.00")
+
+
+def test_percent_rounding_half_up():
+    cart = cart_of((prod("A", "100.05"), 1))
+    assert calculate_total(cart, promo=percent("10")).discount == D("10.01")
+
+
+def test_fixed_capped():
+    cart = cart_of((prod("A", "300.00"), 1))
+    total = calculate_total(cart, promo=fixed("500"))
+    assert total.discount == D("300.00")
+    assert total.lines[0].discount == D("300.00")
+    assert total.lines[0].tax == D("0.00")
+
+
+def test_min_order_exact_ok():
+    cart = cart_of((prod("A", "1000.00"), 1))
+    assert calculate_total(cart, promo=percent("10", min_order_amount=D("1000.00"))).discount == D(
+        "100.00"
+    )
+
+
+def test_min_order_below():
+    cart = cart_of((prod("A", "999.99"), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=percent("10", min_order_amount=D("1000.00")))
+
+
+def test_min_order_not_met_by_gift_card(products):
+    cart = cart_of((prod("A", "900.00"), 1), (products["gift"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=percent("10", min_order_amount=D("1000.00")))
+
+
+def test_no_eligible_lines(products):
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=percent("10"))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart_of((products["phone"], 1)),
+            promo=percent("10", excluded_categories={Category.ELECTRONICS}),
+        )
+
+
+def test_expired_promo_object_still_applies():
+    promo = percent("10", expires_at=__import__("datetime").datetime(2000, 1, 1, tzinfo=__import__("datetime").timezone.utc))
+    assert calculate_total(cart_of((prod("A", "100.00"), 1)), promo=promo).discount == D("10.00")
+
+
+def test_spread_remainder_goes_to_first():
+    cart = cart_of((prod("A", "100.00"), 1), (prod("B", "100.00"), 1), (prod("C", "100.00"), 1))
+    total = calculate_total(cart, promo=fixed("10.00"))
+    assert [line.discount for line in total.lines] == [D("3.34"), D("3.33"), D("3.33")]
+
+
+def test_spread_largest_remainder():
+    # discount 0.01 over 100.00 / 200.00 / 300.00 / ... use remainders: 0.02 over 1.00 and 2.00
+    cart = cart_of((prod("A", "1.00"), 1), (prod("B", "2.00"), 1))
+    # shares: 2*100//300=0 rem 200 ; 2*200//300=1 rem 100 -> missing 1 -> first (rem 200)
+    promo = fixed("0.02")
+    total = calculate_total(cart, promo=promo)
+    assert [line.discount for line in total.lines] == [D("0.01"), D("0.01")]
+    # discount 0.01: rem A=100, rem B=200 -> B gets it
+    total = calculate_total(cart, promo=fixed("0.01"))
+    assert [line.discount for line in total.lines] == [D("0.00"), D("0.01")]
+
+
+def test_spread_sums_and_bounded():
+    cart = cart_of(
+        (prod("A", "33.33"), 3), (prod("B", "0.07"), 1), (prod("C", "12.34"), 2), (prod("D", "5.55"), 7)
+    )
+    for promo in (percent("37.5"), percent("100"), fixed("77.77"), fixed("1.00")):
+        total = calculate_total(cart, promo=promo)
+        assert sum(line.discount for line in total.lines) == total.discount
+        assert all(line.discount <= line.amount for line in total.lines)
+
+
+def test_full_discount():
+    cart = cart_of((prod("A", "50.00"), 1), (prod("B", "70.00"), 1))
+    total = calculate_total(cart, promo=percent("100"))
+    assert total.discount == total.subtotal
+    assert all(line.tax == D("0.00") for line in total.lines)
+
+
+def test_tax_after_discount(products):
+    cart = cart_of((prod("E", "1000.00", Category.ELECTRONICS), 1))
+    total = calculate_total(cart, promo=fixed("100"))
+    assert total.lines[0].tax == D("180.00")
+    assert total.lines[0].amount == D("1000.00")
+    assert total.tax == D("180.00")
+
+
+def test_total_formula():
+    cart = cart_of((prod("A", "500.00"), 1), (prod("B", "250.00", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=percent("10"))
+    assert total.total == total.subtotal - total.discount + total.shipping + total.tax
+
+
+def test_shipping_threshold_after_discount():
+    cart = cart_of((prod("A", "3100.00"), 1))
+    assert calculate_total(cart).shipping == D("0.00")
+    assert calculate_total(cart, promo=fixed("200")).shipping == D("299.00")
+    assert calculate_total(cart, promo=fixed("100")).shipping == D("0.00")  # exactly 3000.00
+
+
+def test_shipping_not_discounted():
+    cart = cart_of((prod("A", "100.00"), 1))
+    total = calculate_total(cart, ShippingPolicy(), promo=percent("100"))
+    assert total.shipping == D("299.00")
+    assert total.total == D("299.00")
diff --git a/tests/test_promo.py b/tests/test_promo.py
new file mode 100644
index 0000000..3d056de
--- /dev/null
+++ b/tests/test_promo.py
@@ -0,0 +1,199 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+T0 = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def make(code="SUMMER10", **kw):
+    kw.setdefault("kind", DiscountKind.PERCENT)
+    kw.setdefault("value", Decimal("10"))
+    return PromoCode(code, **kw)
+
+
+def test_code_normalized():
+    assert make("  summer10 ").code == "SUMMER10"
+
+
+def test_defaults():
+    promo = make()
+    assert promo.min_order_amount == Decimal("0.00")
+    assert promo.max_uses is None
+    assert promo.excluded_categories == frozenset()
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("100.01"), Decimal("-1"), 10, 10.0])
+def test_percent_out_of_range(value):
+    with pytest.raises(ValidationError):
+        make(value=value)
+
+
+def test_percent_100_ok_and_fractional_ok():
+    assert make(value=Decimal("100")).value == Decimal("100")
+    assert make(value=Decimal("12.5")).value == Decimal("12.5")
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("-5"), Decimal("1.005")])
+def test_fixed_invalid(value):
+    with pytest.raises(ValidationError):
+        make(kind=DiscountKind.FIXED, value=value)
+
+
+def test_fixed_ok():
+    assert make(kind=DiscountKind.FIXED, value=Decimal("150.50")).value == Decimal("150.50")
+
+
+@pytest.mark.parametrize("amount", [Decimal("-0.01"), Decimal("1.001"), 5])
+def test_min_order_amount_invalid(amount):
+    with pytest.raises(ValidationError):
+        make(min_order_amount=amount)
+
+
+def test_empty_code():
+    for code in ("", "   "):
+        with pytest.raises(ValidationError):
+            make(code)
+
+
+def test_naive_datetimes():
+    with pytest.raises(ValidationError):
+        make(starts_at=datetime(2026, 1, 1))
+    with pytest.raises(ValidationError):
+        make(expires_at=datetime(2026, 1, 1))
+
+
+def test_interval_invalid():
+    with pytest.raises(ValidationError):
+        make(starts_at=T0, expires_at=T0)
+    with pytest.raises(ValidationError):
+        make(starts_at=T0, expires_at=T0 - timedelta(days=1))
+    make(starts_at=T0, expires_at=T0 + timedelta(seconds=1))
+
+
+@pytest.mark.parametrize("uses", [0, -1, True, 1.5])
+def test_max_uses_invalid(uses):
+    with pytest.raises(ValidationError):
+        make(max_uses=uses)
+
+
+def test_excluded_categories():
+    with pytest.raises(ValidationError):
+        make(excluded_categories=frozenset({"books"}))
+    promo = make(excluded_categories={Category.BOOKS})
+    assert promo.excluded_categories == frozenset({Category.BOOKS})
+    assert isinstance(promo.excluded_categories, frozenset)
+
+
+def test_promo_is_frozen():
+    with pytest.raises(Exception):
+        make().value = Decimal("5")
+
+
+@pytest.fixture
+def clock():
+    return FixedClock(T0)
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def test_duplicate_add(registry):
+    registry.add(make("SUMMER"))
+    with pytest.raises(ValidationError):
+        registry.add(make("summer"))
+    with pytest.raises(ValidationError):
+        registry.add(make(" SUMMER "))
+
+
+def test_resolve_normalizes(registry):
+    promo = make()
+    registry.add(promo)
+    assert registry.resolve("  summer10 ") is promo
+
+
+def test_resolve_unknown_and_empty(registry):
+    registry.add(make())
+    for code in ("NOPE", "", "   "):
+        with pytest.raises(UnknownPromoCodeError):
+            registry.resolve(code)
+
+
+def test_resolve_non_string(registry):
+    with pytest.raises(ValidationError):
+        registry.resolve(None)
+
+
+def test_interval_boundaries(registry, clock):
+    registry.add(make(starts_at=T0, expires_at=T0 + timedelta(days=1)))
+    assert registry.resolve("SUMMER10")  # start inclusive
+    clock.set(T0 + timedelta(days=1) - timedelta(microseconds=1))
+    assert registry.resolve("SUMMER10")
+    clock.set(T0 + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_not_started_yet(registry, clock):
+    registry.add(make(starts_at=T0 + timedelta(hours=1)))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_open_bounds(registry, clock):
+    registry.add(make())
+    clock.set(datetime(2100, 1, 1, tzinfo=timezone.utc))
+    assert registry.resolve("SUMMER10")
+
+
+def test_limit_exhausted(registry):
+    registry.add(make(max_uses=2))
+    registry.consume("SUMMER10")
+    registry.resolve("SUMMER10")
+    registry.consume("SUMMER10")
+    assert registry.uses("SUMMER10") == 2
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+
+
+def test_check_order_expired_before_limit(registry, clock):
+    registry.add(make(max_uses=1, expires_at=T0 + timedelta(days=1)))
+    registry.consume("SUMMER10")
+    clock.set(T0 + timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_uses_and_reads_do_not_change_counter(registry):
+    registry.add(make())
+    assert registry.uses("SUMMER10") == 0
+    for _ in range(3):
+        registry.resolve("summer10")
+        registry.uses(" summer10")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_uses_unknown(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE")
+
+
+def test_consume_release(registry):
+    registry.add(make())
+    registry.consume("summer10")
+    assert registry.uses("SUMMER10") == 1
+    registry.release(" SUMMER10 ")
+    registry.release("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
diff --git a/tests/test_promo_errors.py b/tests/test_promo_errors.py
new file mode 100644
index 0000000..0b72ee3
--- /dev/null
+++ b/tests/test_promo_errors.py
@@ -0,0 +1,25 @@
+from itertools import permutations
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+
+CONCRETE = (UnknownPromoCodeError, PromoExpiredError, PromoConditionsError)
+
+
+def test_concrete_errors_are_independent():
+    for a, b in permutations(CONCRETE, 2):
+        assert not issubclass(a, b)
+
+
+def test_hierarchy():
+    for error in CONCRETE:
+        assert issubclass(error, PromoError)
+        assert issubclass(error, ShopError)
+        assert not issubclass(error, ValidationError)
+    assert issubclass(PromoError, ShopError)
