+class ReservationStateError(ReservationError):
+    """Операция недопустима в текущем статусе резерва."""
+
+    def __init__(self, order_id: str, status: str) -> None:
+        super().__init__(order_id, f"operation not allowed: reservation for order {order_id!r} is {status}")
