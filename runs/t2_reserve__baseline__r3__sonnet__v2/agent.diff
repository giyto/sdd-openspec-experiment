+        now = self._clock.now()
+        reservation = Reservation(
+            order_id=order_id,
+            lines=parsed,
+            created_at=now,
+            expires_at=now + ttl,
+            status=ReservationStatus.ACTIVE,
+        )
+        self._reservations[order_id] = reservation
+        for line in parsed:
