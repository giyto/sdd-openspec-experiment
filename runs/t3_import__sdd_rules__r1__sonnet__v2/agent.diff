+# --- store interaction ----------------------------------------------------
+
+
+class CountingStore(MemoryStore):
+    def __init__(self):
+        super().__init__()
+        self.calls = 0
+
+    def add_many(self, txs):
+        self.calls += 1
+        return super().add_many(txs)
+
+
+def test_single_add_many(write_csv, clock):
+    store = CountingStore()
+    path = write_csv(SFERA)
+    import_statement(path, store, clock=clock)
+    assert store.calls == 1
+    import_statement(path, store, clock=clock)  # nothing to add
+    assert store.calls == 1
+
