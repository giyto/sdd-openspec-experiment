+import dataclasses
+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule
+from ledger.storage import JsonFileStore, MemoryStore
+
+NBSP = " "
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    f"01.03.2026;-1{NBSP}200,50;Магазин Лента\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+    "03.03.2026;-150,00;Кофейня\n"
+)
+NOVA = "date,amount,description\n2026-03-01,-350.00,Кофейня\n2026-03-02,85000.00,Зарплата\n"
+
+
+def amounts(store):
+    return [t.amount for t in store.all()]
+
+
+# --- errors ---------------------------------------------------------------
+
+
+def test_new_exceptions():
+    assert issubclass(UnknownFormatError, StatementError)
+    assert issubclass(StatementRowError, StatementError)
+    assert StatementRowError("x", line_no=4).line_no == 4
+    with pytest.raises(TypeError):
+        StatementRowError("x")  # type: ignore[call-arg]
+
+
+# --- encoding -------------------------------------------------------------
+
+
+def test_utf8_bom(write_csv, clock):
+    path = write_csv("﻿" + SFERA)
+    res = import_statement(path, MemoryStore(), clock=clock)
+    assert (res.format, res.encoding, res.added) == ("sfera", "utf-8", 3)
+
+
+def test_utf8_plain_and_cp1251(write_csv, clock):
+    assert import_statement(write_csv(SFERA), MemoryStore(), clock=clock).encoding == "utf-8"
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA, encoding="cp1251"), store, clock=clock)
+    assert res.encoding == "cp1251"
+    assert store.all()[0].description == "Магазин Лента"
+
+
+def test_undecodable(tmp_path):
+    path = tmp_path / "bad.csv"
+    path.write_bytes(b"\xff\x98\x81")
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(path, store)
+    assert info.value.line_no is None
+    assert store.all() == []
+
+
+# --- format detection -----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        (NOVA, "nova"),
+        (SFERA, "sfera"),
+        ("Номер карты;ДАТА; Сумма ;Описание;Остаток\n", "sfera"),
+        ("Дата;Описание;Приход;Расход\n", "sfera_split"),
+    ],
+)
+def test_detect_format(write_csv, text, expected):
+    assert detect_format(write_csv(text)) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "foo,bar\n",
+        "",
+        "Дата;Сумма;Описание;Приход;Расход\n",
+        "Дата;Сумма;Сумма;Описание\n",
+        "\nДата;Сумма;Описание\n",
+    ],
+)
+def test_detect_format_unknown(write_csv, clock, text):
+    store = MemoryStore()
+    path = write_csv(text)
+    with pytest.raises(UnknownFormatError):
+        detect_format(path)
+    with pytest.raises(UnknownFormatError):
+        import_statement(path, store, clock=clock)
+    assert store.all() == []
+
+
+def test_empty_file_line_no_none(write_csv):
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv(""), MemoryStore())
+    assert info.value.line_no is None
+
+
+def test_explicit_fmt_mismatch(write_csv):
+    store = MemoryStore()
+    for bad in ("nova", "bogus"):
+        with pytest.raises(UnknownFormatError):
+            import_statement(write_csv(SFERA), store, fmt=bad, strict=False)
+    assert store.all() == []
+
+
+def test_header_only(write_csv):
+    res = import_statement(write_csv("Дата;Сумма;Описание\n"), MemoryStore())
+    assert (res.added, res.duplicates, res.errors) == (0, 0, [])
+
+
+def test_result_frozen():
