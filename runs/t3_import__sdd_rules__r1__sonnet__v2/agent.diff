+def import_statement(
+    path: str | os.PathLike[str],
+    store: MemoryStore,
+    *,
+    fmt: str | None = None,
+    strict: bool = False,
+    categorizer: Categorizer | None = None,
+    clock: Clock | None = None,
+) -> ImportResult:
+    """Импортирует выписку в store: автоформат, без дублей, одной атомарной записью."""
+    clock = clock or SystemClock()
+    imported_at = clock.now()
+    text, encoding = _decode(Path(path).read_bytes())
+    fmt, cols = _detect(text, fmt)
+    parsed = _parse_rows(text, fmt, cols, imported_at)
+
+    errors = [item for item in parsed if isinstance(item, RowError)]
+    if strict and errors:
+        raise StatementRowError(errors[0].message, line_no=errors[0].line_no)
+
+    existing = Counter(
+        (tx.date, tx.amount, normalize_description(tx.description)) for tx in store.all()
+    )
+    new: list[Transaction] = []
+    duplicates = 0
+    for item in parsed:
+        if isinstance(item, RowError):
+            continue
+        key = (item.date, item.amount, normalize_description(item.description))
+        if existing[key] > 0:
+            existing[key] -= 1
+            duplicates += 1
+            continue
+        if categorizer is not None:
+            category = categorizer.categorize(item)
+            if category is not None:
+                item = replace(item, category=category)
+        new.append(item)
+
+    if new:
+        store.add_many(new)
+    logger.info(
+        "imported %d transactions from %s (%s, %d duplicates, %d errors)",
+        len(new), path, fmt, duplicates, len(errors),
+    )
+    return ImportResult(fmt, encoding, len(new), duplicates, errors)
 
 
