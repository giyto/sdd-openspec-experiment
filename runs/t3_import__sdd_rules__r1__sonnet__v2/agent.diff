+def _decode(data: bytes) -> tuple[str, str]:
+    try:
+        return data.decode("utf-8-sig"), "utf-8"
+    except UnicodeDecodeError:
+        pass
+    try:
+        return data.decode("cp1251"), "cp1251"
+    except UnicodeDecodeError as exc:
+        raise UnknownFormatError("cannot decode file as utf-8 or cp1251") from exc
+
+
+def _reader(text: str, delimiter: str):
+    return csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+
+
+def _match_header(spec: _Spec, header: list[str]) -> dict[str, int] | None:
+    """Карта «логическая колонка → индекс» или None, если заголовок не подходит."""
+    names = header if spec.exact else [h.strip().casefold() for h in header]
+    result: dict[str, int] = {}
+    for key, wanted in spec.columns.items():
+        found = [i for i, n in enumerate(names) if n == wanted]
+        if len(found) != 1:
+            return None
+        result[key] = found[0]
+    return result
+
+
+def _detect(text: str, fmt: str | None) -> tuple[str, dict[str, int]]:
+    if not text:
+        raise UnknownFormatError("empty file")
+    if fmt is not None and fmt not in _SPECS:
+        raise UnknownFormatError(f"unknown format {fmt!r}", line_no=1)
+    matched: list[tuple[str, dict[str, int]]] = []
+    for name in (fmt,) if fmt else _SPECS:
+        try:
+            header = next(_reader(text, _SPECS[name].delimiter), None)
+        except csv.Error:
+            header = None
+        columns = _match_header(_SPECS[name], header) if header is not None else None
+        if columns is not None:
+            matched.append((name, columns))
+    if len(matched) > 1:
+        raise UnknownFormatError("ambiguous header", line_no=1)
+    if not matched:
+        what = f"header does not match format {fmt!r}" if fmt else "unrecognized header"
+        raise UnknownFormatError(what, line_no=1)
+    return matched[0]
+
+
+def detect_format(path: str | os.PathLike[str]) -> str:
+    """Определяет формат выписки по заголовку или бросает UnknownFormatError."""
+    text, _ = _decode(Path(path).read_bytes())
+    return _detect(text, None)[0]
 
 
