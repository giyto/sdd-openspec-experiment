+def test_junk_rows(write_csv, clock):
+    text = "Дата;Сумма;Описание\n01.03.2026;-1,00;a\n\n   \n;;;\n02.03.2026;-2,00;b\n;;;\n"
+    res = import_statement(write_csv(text), MemoryStore(), strict=True, clock=clock)
+    assert (res.added, res.duplicates, res.errors) == (2, 0, [])
+
+
+def test_junk_nova(write_csv, clock):
+    res = import_statement(
+        write_csv("date,amount,description\n,,\n2026-03-01,-1.00,a\n"), MemoryStore(), clock=clock
+    )
+    assert res.added == 1
+
+
+def test_line_numbers_blank_and_multiline(write_csv, clock):
+    text = (
+        "Дата;Сумма;Описание\n"
+        "\n"
+        "01.03.2026;abc;x\n"  # line 3
+        '02.03.2026;-1,00;"multi\nline"\n'  # lines 4-5
+        "03.03.2026;-1,00;\n"  # line 6
+    )
+    res = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert res.added == 1
+    assert [e.line_no for e in res.errors] == [3, 6]
+    assert not res.errors[0].message.startswith("line")
