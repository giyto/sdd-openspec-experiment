+def _parse_rows(
+    text: str, fmt: str, cols: dict[str, int], imported_at: dt.datetime
+) -> list[Transaction | RowError]:
+    reader = _reader(text, _SPECS[fmt].delimiter)
+    next(reader)  # заголовок
+    out: list[Transaction | RowError] = []
+    while True:
+        line_no = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as exc:
+            out.append(RowError(line_no, str(exc)))
+            if reader.line_num < line_no:
+                break
+            continue
+        if all(not value.strip() for value in row):
+            continue
+        try:
+            out.append(_build_row(fmt, cols, row, imported_at))
+        except _RowProblem as exc:
+            out.append(RowError(line_no, str(exc)))
+    return out
+
