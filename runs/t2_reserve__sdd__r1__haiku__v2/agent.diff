+# --- журнал (6.1) -----------------------------------------------------------
+
+def test_reservation_events_round_trip(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 1)])
+    inv.extend("SO-1", timedelta(minutes=30))
+    inv.cancel("SO-1")
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-2")
+    kinds = {event.kind for event in inv.log if event.kind.startswith("RESERVE")}
+    assert kinds == {"RESERVE", "RESERVE_EXTEND", "RESERVE_CANCEL", "RESERVE_CONFIRM"}
+    for line in inv.log.lines():
+        assert parse_line(line).format() == line
+
+
+def test_expires_field_uses_journal_timestamp(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    reservation = reserve_bolts(inv, qty=1)
+    expires = inv.log.events("RESERVE")[0].fields["expires"]
+    assert expires == format_timestamp(reservation.expires_at)
+    assert parse_timestamp(expires) == reservation.expires_at
