+# --- extend (4.3) -----------------------------------------------------------
+
+def test_extend_active_moves_expiry_to_now_plus_ttl(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    reserve_bolts(inv, qty=4)
+    clock.advance(timedelta(minutes=10))
+    extended = inv.extend("SO-1", timedelta(minutes=15))
+    assert extended.expires_at == clock.now() + timedelta(minutes=15)
+    event = inv.log.events("RESERVE_EXTEND")[0]
+    assert event.fields["order"] == "SO-1"
+    assert event.fields["expires"] == format_timestamp(extended.expires_at)
+
+
+def test_extend_never_shortens_expiry(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    reservation = reserve_bolts(inv, qty=4)
+    clock.advance(timedelta(minutes=1))
+    events_before = len(inv.log)
+    result = inv.extend("SO-1", timedelta(minutes=5))
+    assert result.expires_at == reservation.expires_at
+    assert len(inv.log) == events_before
+
+
+def test_extend_default_ttl_is_fifteen_minutes(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    reserve_bolts(inv, qty=4)
