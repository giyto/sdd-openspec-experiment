+# --- confirm (4.1) ----------------------------------------------------------
+
+def test_confirm_with_zero_available_ships_stock(inv):
+    inv.receive("MAIN", "BOLT-M8", 4)
+    reserve_bolts(inv, order_id="SO-1", qty=4)
+    assert inv.available("MAIN", "BOLT-M8") == 0
+    confirmed = inv.confirm("SO-1")
+    assert confirmed.status is CONFIRMED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 0
+    kinds = [event.kind for event in inv.log][1:]
+    assert kinds == ["RESERVE", "ISSUE", "RESERVE_CONFIRM"]
+    issue = inv.log.events("ISSUE")[0]
+    assert issue.fields["ref"] == "SO-1"
+    assert issue.fields["qty"] == "4"
+    assert inv.log.events("RESERVE_CONFIRM")[0].fields["order"] == "SO-1"
+
+
+def test_confirm_issues_each_line_in_order(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("EAST", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("EAST", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    issues = inv.log.events("ISSUE")
+    assert [(e.fields["wh"], e.fields["qty"]) for e in issues] == [("MAIN", "2"), ("EAST", "1")]
+    assert inv.on_hand("MAIN", "BOLT-M8") == 3
+    assert inv.on_hand("EAST", "BOLT-M8") == 4
+
+
+def test_confirm_physical_shortage_changes_nothing(inv):
