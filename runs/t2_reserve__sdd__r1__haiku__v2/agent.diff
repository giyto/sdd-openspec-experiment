+    reserve_bolts(inv, qty=4)
+    inv.adjust("MAIN", "BOLT-M8", 3, "recount")
+    events_before = len(inv.log)
+    with pytest.raises(InsufficientStockError):
+        inv.confirm("SO-1")
+    assert inv.on_hand("MAIN", "BOLT-M8") == 3
+    assert inv.get_reservation("SO-1").status is ACTIVE
+    assert len(inv.log) == events_before
+
+
