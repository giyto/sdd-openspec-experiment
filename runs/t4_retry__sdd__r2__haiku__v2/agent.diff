index 0000000..def04f2
--- /dev/null
+++ b/jobq/retry.py
@@ -0,0 +1,102 @@
+"""Политика повторов упавших заданий: число попыток, задержка, неповторяемые ошибки.
+
+Политика — неизменяемое значение без состояния очереди. Решение «повторить или нет» принимает
+воркер, а :class:`~jobq.queue.JobQueue` только хранит политики и выполняет переходы.
+"""
+
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+
+from .errors import ConfigError, PermanentJobError
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Параметры повторов.
+
+    :param max_attempts: сколько всего запусков допустимо (включая первый), не меньше 1.
+    :param base_delay: задержка перед первым повтором, секунды, не меньше 0.
+    :param factor: множитель задержки на каждую следующую попытку, не меньше 1.
+    :param max_delay: потолок задержки, секунды, не меньше ``base_delay``.
+    :param jitter: доля случайного разброса задержки, от 0 до 1 включительно.
+    :param non_retryable: классы исключений, при которых повтор не делается.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not _is_int(self.max_attempts) or self.max_attempts < 1:
+            raise ConfigError(f"max_attempts must be an integer >= 1, got {self.max_attempts!r}")
+        for name in ("base_delay", "factor", "max_delay", "jitter"):
+            _require_finite(name, getattr(self, name))
+        if self.base_delay < 0:
+            raise ConfigError(f"base_delay must be >= 0, got {self.base_delay!r}")
+        if self.factor < 1:
+            raise ConfigError(f"factor must be >= 1, got {self.factor!r}")
+        if self.max_delay < self.base_delay:
+            raise ConfigError(f"max_delay ({self.max_delay!r}) must be >= base_delay ({self.base_delay!r})")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError(f"jitter must be within [0, 1], got {self.jitter!r}")
+
+        try:
+            classes = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for item in classes:
+            if not (isinstance(item, type) and issubclass(item, BaseException)):
+                raise ConfigError(f"non_retryable element {item!r} is not an exception class")
+        # dataclass заморожен, поэтому пишем в обход __setattr__
+        object.__setattr__(self, "non_retryable", classes)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка перед повтором после неудачной попытки ``attempt`` (нумерация с 1).
+
+        Результат лежит в ``[0, max_delay]``. ``rng`` используется только при ``jitter > 0``;
+        если его не передали, берётся новый ``random.Random()``.
+        """
+        if not _is_int(attempt) or attempt < 1:
+            raise ConfigError(f"attempt must be an integer >= 1, got {attempt!r}")
+
+        if self.base_delay == 0:
+            raw = 0.0
+        else:
+            try:
+                raw = self.base_delay * self.factor ** (attempt - 1)
+            except OverflowError:
+                # factor ** big не помещается во float: задержка всё равно упирается в потолок
+                raw = self.max_delay
+        delay = min(raw, self.max_delay)
+
+        if self.jitter > 0:
+            if rng is None:
+                rng = random.Random()
+            delay = min(delay * rng.uniform(1 - self.jitter, 1 + self.jitter), self.max_delay)
+        return float(delay)
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """Можно ли повторить задание, которое упало с ``exc``.
+
+        :class:`PermanentJobError` никогда не повторяется; подклассы из ``non_retryable`` тоже нет.
+        """
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _require_finite(name: str, value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ConfigError(f"{name} must be a number, got {value!r}")
+    if not math.isfinite(value):
+        raise ConfigError(f"{name} must be finite, got {value!r}")
