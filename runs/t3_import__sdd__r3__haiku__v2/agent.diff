+
+def _read_text(path: str | os.PathLike[str]) -> tuple[str, str]:
+    """Читает файл целиком: UTF-8 (BOM снимается), иначе cp1251. Возвращает текст и кодировку."""
+    try:
+        raw = Path(path).read_bytes()
+    except OSError as exc:
+        raise StatementError(f"cannot read {path}: {exc}") from exc
+    try:
+        return raw.decode("utf-8-sig"), "utf-8"
+    except UnicodeDecodeError:
+        pass
+    try:
+        return raw.decode("cp1251"), "cp1251"
+    except UnicodeDecodeError as exc:
+        raise UnknownFormatError(f"cannot decode {path} as UTF-8 or cp1251") from exc
+
+
+def _detect(text: str, fmt: str | None) -> tuple[_Format, dict[str, int]]:
+    """Находит формат по заголовку (строка 1) и возвращает его вместе с индексами колонок."""
+    candidates = [FORMATS[fmt]] if fmt is not None else list(FORMATS.values())
+    matches: list[tuple[_Format, dict[str, int]]] = []
+    for spec in candidates:
+        # Каждый формат разбирает заголовок своим разделителем; разделитель не угадываем.
+        header = next(csv.reader(io.StringIO(text, newline=""), delimiter=spec.delimiter), [])
+        names = [cell.strip().casefold() for cell in header]
+        if any(names.count(column) > 1 for column in spec.columns):
+            raise UnknownFormatError(f"duplicated column in header for format {spec.name!r}", line_no=1)
+        if all(column in names for column in spec.columns):
+            matches.append((spec, {column: names.index(column) for column in spec.columns}))
+    if len(matches) == 1:
+        return matches[0]
+    if fmt is not None:
+        raise UnknownFormatError(f"header does not match format {fmt!r}", line_no=1)
+    if not matches:
+        raise UnknownFormatError("unknown statement header", line_no=1)
+    raise UnknownFormatError("header matches several formats", line_no=1)
+
+
+def detect_format(path: str | os.PathLike[str]) -> str:
+    """Возвращает имя формата выписки по заголовку: 'nova', 'sfera' или 'sfera_split'."""
+    text, _ = _read_text(path)
+    spec, _ = _detect(text, None)
+    return spec.name
+
+
+def normalize_description(text: str) -> str:
+    """Нормализация описания для сравнения на дубли; та же, что в правилах категоризации."""
+    return normalize_text(text)
+
+
+def _dedup_key(tx: Transaction) -> tuple[dt.date, Decimal, str]:
+    return (tx.date, tx.amount, normalize_description(tx.description))
+
+
+def _parse_rows(
+    text: str,
+    spec: _Format,
+    cols: dict[str, int],
+    imported_at: dt.datetime,
+    strict: bool,
+) -> tuple[list[Transaction], list[RowError]]:
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=spec.delimiter)
+    next(reader, None)  # заголовок уже разобран в _detect
+    txs: list[Transaction] = []
+    errors: list[RowError] = []
+    while True:
+        # line_num после чтения указывает на последнюю физическую строку записи,
+        # поэтому номер начала берём до чтения.
+        line_no = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            break
+        if not any(cell.strip() for cell in row):
+            continue
+        try:
+            txs.append(spec.parse(row, cols, imported_at))
+        except StatementError as exc:
+            if strict:
+                raise StatementRowError(exc.message, line_no=line_no) from exc
+            errors.append(RowError(line_no=line_no, message=exc.message))
+    return txs, errors
+
+
+def import_statement(
+    path: str | os.PathLike[str],
+    store: MemoryStore,
+    *,
+    fmt: str | None = None,
+    strict: bool = False,
+    categorizer: Categorizer | None = None,
+    clock: Clock | None = None,
+) -> ImportResult:
+    """Импортирует выписку в store.
+
+    Формат определяется по заголовку, либо берётся из fmt. Дубли — строки, для которых в store
+    уже есть операция с той же датой, суммой и описанием (по количеству). В строгом режиме первая
+    ошибка строки бросает StatementRowError до записи; иначе ошибки попадают в ImportResult.errors.
+    """
+    if fmt is not None and fmt not in FORMATS:
+        raise UnknownFormatError(f"unknown format {fmt!r}")
+    clock = clock or SystemClock()
+    imported_at = clock.now()
+    text, encoding = _read_text(path)
+    spec, cols = _detect(text, fmt)
+    txs, errors = _parse_rows(text, spec, cols, imported_at, strict)
+
+    remaining = Counter(_dedup_key(tx) for tx in store.all())
+    to_add: list[Transaction] = []
+    duplicates = 0
+    for tx in txs:
+        key = _dedup_key(tx)
+        if remaining[key] > 0:
+            remaining[key] -= 1
+            duplicates += 1
+            continue
+        if categorizer is not None:
+            category = categorizer.categorize(tx)
+            if category is not None:
+                tx = replace(tx, category=category)
+        to_add.append(tx)
+
+    if to_add:
+        store.add_many(to_add)
+    logger.info("imported %d transactions from %s", len(to_add), path)
+    return ImportResult(
+        format=spec.name,
+        encoding=encoding,
+        added=len(to_add),
+        duplicates=duplicates,
+        errors=errors,
+    )
 
 
