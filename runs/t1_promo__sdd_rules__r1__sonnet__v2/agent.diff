+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+T0 = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def make(code="SUMMER10", **kw):
+    kw.setdefault("kind", DiscountKind.PERCENT)
+    kw.setdefault("value", D("10"))
+    return PromoCode(code, **kw)
+
+
+def test_errors_are_independent():
+    errors = (UnknownPromoCodeError, PromoExpiredError, PromoConditionsError)
+    for a in errors:
+        assert issubclass(a, PromoError) and issubclass(a, ShopError)
+        for b in errors:
+            if a is not b:
+                assert not issubclass(a, b)
+
+
+def test_code_normalized():
+    assert make("  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize(
+    "kw",
+    [
+        {"code": "   "},
+        {"value": D("0")},
+        {"value": D("100.01")},
+        {"value": 10},
+        {"value": 10.0},
+        {"kind": "percent"},
+        {"kind": DiscountKind.FIXED, "value": D("0")},
+        {"kind": DiscountKind.FIXED, "value": D("1.005")},
+        {"min_order_amount": D("-1")},
+        {"min_order_amount": D("1.001")},
+        {"starts_at": datetime(2026, 1, 1)},
+        {"expires_at": datetime(2026, 1, 1)},
+        {"starts_at": T0, "expires_at": T0},
+        {"max_uses": 0},
+        {"max_uses": True},
+        {"max_uses": 1.5},
+        {"excluded_categories": {Category.BOOKS}},
+        {"excluded_categories": frozenset({"books"})},
+    ],
+)
+def test_invalid_promo(kw):
+    args = {"code": "X1"}
+    args.update(kw)
+    with pytest.raises(ValidationError):
+        make(**args)
+
+
+def test_percent_100_ok():
+    assert make(value=D("100")).value == D("100")
+
+
+@pytest.fixture
+def reg(clock):
+    return PromoRegistry(clock)
+
+
+def test_duplicate(reg):
+    reg.add(make("SUMMER10"))
+    with pytest.raises(ValidationError):
+        reg.add(make(" summer10"))
+
+
+def test_resolve_case_insensitive_and_uses_zero(reg):
+    promo = make()
+    reg.add(promo)
+    assert reg.resolve("  summer10 ") is promo
+    assert reg.uses("summer10") == 0
+
+
+def test_unknown_and_empty(reg):
+    for code in ("NOPE", "", "  "):
+        with pytest.raises(UnknownPromoCodeError):
+            reg.resolve(code)
+    with pytest.raises(UnknownPromoCodeError):
+        reg.uses("NOPE")
+
+
+def test_validity_boundaries(reg, clock):
+    reg.add(make(starts_at=T0 + timedelta(hours=1), expires_at=T0 + timedelta(hours=2)))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")  # not started yet
+    clock.set(T0 + timedelta(hours=1))
+    reg.resolve("SUMMER10")
+    clock.set(T0 + timedelta(hours=2))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_expired_beats_exhausted(reg, clock):
+    reg.add(make(expires_at=T0 + timedelta(hours=1), max_uses=1))
+    reg.redeem("SUMMER10")
+    clock.set(T0 + timedelta(hours=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_limit(reg):
+    reg.add(make(max_uses=1))
+    reg.resolve("SUMMER10")
+    reg.redeem("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        reg.redeem("SUMMER10")
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_release_not_below_zero(reg):
+    reg.add(make())
+    reg.release("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.redeem("SUMMER10")
+    reg.release("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
