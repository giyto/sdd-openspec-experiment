diff --git a/shop/promo.py b/shop/promo.py
new file mode 100644
index 0000000..b2609c5
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,141 @@
+"""Promo codes: model and registry with usage counters."""
+
+from __future__ import annotations
+
+import logging
+import threading
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _is_aware(value: object) -> bool:
+    return isinstance(value, datetime) and value.tzinfo is not None and value.utcoffset() is not None
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError(f"promo {self.code}: kind must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError(f"promo {self.code}: value must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError(f"promo {self.code}: percent must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"promo {self.code}: fixed value must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError(f"promo {self.code}: fixed value has more than two digits")
+        amount = self.min_order_amount
+        if not isinstance(amount, Decimal) or not amount.is_finite():
+            raise ValidationError(f"promo {self.code}: min_order_amount must be a finite Decimal")
+        if amount < 0 or to_money(amount) != amount:
+            raise ValidationError(f"promo {self.code}: invalid min_order_amount")
+        for name in ("starts_at", "expires_at"):
+            moment = getattr(self, name)
+            if moment is not None and not _is_aware(moment):
+                raise ValidationError(f"promo {self.code}: {name} must be an aware datetime")
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError(f"promo {self.code}: starts_at must be before expires_at")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError(f"promo {self.code}: max_uses must be an integer >= 1")
+        if not isinstance(self.excluded_categories, frozenset) or not all(
+            isinstance(c, Category) for c in self.excluded_categories
+        ):
+            raise ValidationError(
+                f"promo {self.code}: excluded_categories must be a frozenset of Category"
+            )
+
+
+class PromoRegistry:
+    """In-memory promo codes with usage counters."""
+
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._codes: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+        self._lock = threading.Lock()
+
+    def add(self, promo: PromoCode) -> None:
+        with self._lock:
+            if promo.code in self._codes:
+                raise ValidationError(f"duplicate promo code: {promo.code!r}")
+            self._codes[promo.code] = promo
+            self._uses[promo.code] = 0
+
+    def _get(self, code: str) -> PromoCode:
+        key = normalize_key(code)
+        try:
+            return self._codes[key]
+        except KeyError:
+            raise UnknownPromoCodeError(key) from None
+
+    def resolve(self, code: str) -> PromoCode:
+        promo = self._get(code)
+        now = self._clock.now()
+        if (promo.starts_at is not None and now < promo.starts_at) or (
+            promo.expires_at is not None and now >= promo.expires_at
+        ):
+            raise PromoExpiredError(f"promo code {promo.code} is not active")
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} usage limit reached")
+        return promo
+
+    def uses(self, code: str) -> int:
+        return self._uses[self._get(code).code]
+
+    def redeem(self, code: str) -> None:
+        """Count one use; re-checks the limit atomically."""
+        promo = self._get(code)
+        with self._lock:
+            if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+                raise PromoConditionsError(f"promo code {promo.code} usage limit reached")
+            self._uses[promo.code] += 1
+            count = self._uses[promo.code]
+        logger.info("promo %s redeemed, uses=%d", promo.code, count)
+
+    def release(self, code: str) -> None:
+        """Give one use back; the counter never goes below zero."""
+        promo = self._get(code)
+        with self._lock:
+            self._uses[promo.code] = max(0, self._uses[promo.code] - 1)
+            count = self._uses[promo.code]
+        logger.info("promo %s released, uses=%d", promo.code, count)
diff --git a/tests/test_orders_promo.py b/tests/test_orders_promo.py
new file mode 100644
index 0000000..19b372f
--- /dev/null
+++ b/tests/test_orders_promo.py
@@ -0,0 +1,105 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    EmptyCartError,
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+@pytest.fixture
+def registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(PromoCode("SUMMER10", DiscountKind.PERCENT, D("10"), max_uses=1))
+    reg.add(PromoCode("BIG", DiscountKind.PERCENT, D("10"), min_order_amount=D("100000")))
+    reg.add(PromoCode("OLD", DiscountKind.PERCENT, D("10"), expires_at=clock.now() - timedelta(days=1)))
+    return reg
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def cart(products):
+    c = Cart()
+    c.add(products["phone"])
+    return c
+
+
+def test_without_registry(clock, cart):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart, "SUMMER10")
+    assert service.quote(cart, "  ").discount == D("0.00")
+    assert service.place_order(cart, None).promo_code is None
+
+
+def test_blank_code(service, registry, cart):
+    order = service.place_order(cart, "  ")
+    assert order.promo_code is None and order.total.discount == D("0.00")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_quote_does_not_redeem(service, registry, cart):
+    first = service.quote(cart, " summer10 ")
+    assert first.discount == D("250.00")
+    service.quote(cart, "SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    assert service.place_order(cart, "summer10").total == first
+
+
+def test_place_order_stores_code_and_limit(service, registry, cart):
+    order = service.place_order(cart, " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 1
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER10")
+    assert len(service.store) == 1
+
+
+def test_failures_leave_state(service, registry, cart):
+    for code, exc in (("NOPE", UnknownPromoCodeError), ("OLD", PromoExpiredError), ("BIG", PromoConditionsError)):
+        with pytest.raises(exc):
+            service.place_order(cart, code)
+    with pytest.raises(EmptyCartError):
+        service.place_order(Cart(), "SUMMER10")
+    with pytest.raises(ValidationError):
+        service.place_order(cart, 5)
+    assert len(service.store) == 0
+    assert registry.uses("SUMMER10") == 0
+    assert registry.uses("BIG") == 0
+
+
+def test_cancel_releases(service, registry, cart):
+    order = service.place_order(cart, "SUMMER10")
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+    assert service.place_order(cart, "SUMMER10").promo_code == "SUMMER10"
+
+
+def test_double_cancel_does_not_double_release(service, registry, cart):
+    first = service.place_order(cart, "SUMMER10")
+    service.cancel(first.order_id)
+    service.place_order(cart, "SUMMER10")
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(first.order_id)
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_cancel_without_code(service, registry, cart):
+    order = service.place_order(cart)
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
