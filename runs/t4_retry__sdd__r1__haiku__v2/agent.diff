@@ -0,0 +1,198 @@
+import inspect
+from datetime import timedelta
+
+from jobq import JobQueue, JobStatus, PermanentJobError, RetryPolicy, Worker
+
+from .conftest import START
+
+
+class _StubRng:
+    def __init__(self, value: float) -> None:
+        self.value = value
+
+    def uniform(self, low: float, high: float) -> float:
+        return self.value
+
+
+def _policy(**overrides) -> RetryPolicy:
+    params = {"max_attempts": 3, "base_delay": 1.0, "factor": 2.0, "max_delay": 60.0}
+    params.update(overrides)
+    return RetryPolicy(**params)
+
+
+def _scripted(*outcomes):
+    """Обработчик, который на каждом вызове берёт следующий исход: исключение или значение."""
+    calls = iter(outcomes)
+
+    def handler(job):
+        outcome = next(calls)
+        if isinstance(outcome, BaseException):
+            raise outcome
+        return outcome
+
+    return handler
+
+
+def test_first_failure_schedules_retry(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy())
+    worker = Worker(queue, registry)
+    registry.register("net", _scripted(TimeoutError("slow")))
+    job = queue.enqueue("net")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.error == "TimeoutError: slow"
+    assert job.run_at == START + timedelta(seconds=_policy().delay_for(1))
+
+
+def test_retry_waits_for_run_at(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy())
+    worker = Worker(queue, registry)
+    registry.register("net", _scripted(TimeoutError("slow"), "ok"))
+    job = queue.enqueue("net")
+    worker.run_once()
+
+    assert worker.run_once() is None
+
+    clock.advance(_policy().delay_for(1))
+    assert worker.run_once() is job
+    assert job.attempts == 2
+    assert job.status is JobStatus.SUCCEEDED
+
+
+def test_single_attempt_policy_dead_letters_retryable_error(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy(max_attempts=1))
+    worker = Worker(queue, registry)
+    registry.register("net", _scripted(ConnectionError("503")))
+    job = queue.enqueue("net")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.metrics.get("jobs.failed") == 0
+
+
+def test_non_retryable_error_fails_on_first_attempt(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy(non_retryable=(ValueError,)))
+    worker = Worker(queue, registry)
+    registry.register("parse", _scripted(ValueError("bad")))
+    job = queue.enqueue("parse")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_permanent_error_on_last_attempt_fails(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy(max_attempts=3))
+    worker = Worker(queue, registry)
+    registry.register(
+        "billing",
+        _scripted(TimeoutError("a"), TimeoutError("b"), PermanentJobError("card declined")),
+    )
+    job = queue.enqueue("billing")
+
+    for _ in range(3):
+        clock.advance(60)
+        worker.run_once()
+
+    assert job.attempts == 3
+    assert job.status is JobStatus.FAILED
+    assert job.error == "PermanentJobError: card declined"
+    assert queue.dead_letters() == []
+
+
+def test_unknown_job_type_fails_even_with_policy(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy())
+    worker = Worker(queue, registry)
+    job = queue.enqueue("nobody")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.FAILED
+    assert job.error.startswith("UnknownJobTypeError:")
+    assert queue.metrics.get("jobs.retried") == 0
+
+
+def test_no_policy_keeps_old_behaviour(clock, registry):
+    queue = JobQueue(clock=clock)
+    worker = Worker(queue, registry)
+    registry.register("net", _scripted(TimeoutError("slow")))
+    job = queue.enqueue("net")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.FAILED
+    assert queue.metrics.get("jobs.retried") == 0
+    assert queue.metrics.get("jobs.dead_lettered") == 0
+
+
+def test_policy_is_taken_at_time_of_failure(clock, registry):
+    queue = JobQueue(clock=clock)
+    worker = Worker(queue, registry)
+    registry.register("net", _scripted(TimeoutError("slow")))
+    job = queue.enqueue("net")
+    queue.set_retry_policy("net", _policy())
+
+    worker.run_once()
+
+    assert job.status is JobStatus.RETRY_SCHEDULED
+
+
+def test_success_after_retry_clears_error(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy())
+    worker = Worker(queue, registry)
+    registry.register("net", _scripted(TimeoutError("slow"), "done"))
+    job = queue.enqueue("net")
+    worker.run_once()
+    assert job.error == "TimeoutError: slow"
+
+    clock.advance(60)
+    worker.run_once()
+
+    assert job.status is JobStatus.SUCCEEDED
+    assert job.result == "done"
+    assert job.error is None
+
+
+def test_success_on_third_attempt_metrics(clock, registry):
+    queue = JobQueue(clock=clock, default_retry_policy=_policy(max_attempts=3))
+    worker = Worker(queue, registry)
+    registry.register(
+        "net",
+        _scripted(ConnectionError("1"), ConnectionError("2"), "ok"),
+    )
+    queue.enqueue("net")
+
+    for _ in range(3):
+        clock.advance(60)
+        worker.run_once()
+
+    assert queue.metrics.get("jobs.started") == 3
+    assert queue.metrics.get("jobs.retried") == 2
+    assert queue.metrics.get("jobs.succeeded") == 1
+    assert queue.metrics.get("jobs.failed") == 0
+
+
+def test_jitter_uses_worker_rng(clock, registry):
+    policy = _policy(base_delay=2.0, jitter=0.5)
+    queue = JobQueue(clock=clock, default_retry_policy=policy)
+    worker = Worker(queue, registry, rng=_StubRng(1.5))
+    registry.register("net", _scripted(TimeoutError("slow")))
+    job = queue.enqueue("net")
+
+    worker.run_once()
+
+    assert job.run_at == START + timedelta(seconds=3.0)
+
+
+def test_worker_and_queue_signatures_keep_new_params_keyword_only():
+    worker_params = inspect.signature(Worker.__init__).parameters
+    assert worker_params["rng"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert worker_params["rng"].default is None
+
+    queue_params = inspect.signature(JobQueue.__init__).parameters
+    assert queue_params["default_retry_policy"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert queue_params["default_retry_policy"].default is None
