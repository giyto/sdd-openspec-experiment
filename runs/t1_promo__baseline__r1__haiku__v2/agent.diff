+++ b/tests/test_promo.py
@@ -0,0 +1,181 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+START = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def make_promo(**kwargs):
+    defaults = dict(code="SUMMER", kind=DiscountKind.PERCENT, value=Decimal("10"))
+    defaults.update(kwargs)
+    return PromoCode(**defaults)
+
+
+def registry_with(promo, at=START):
+    registry = PromoRegistry(FixedClock(at))
+    registry.add(promo)
+    return registry
+
+
+def test_code_is_normalized():
+    assert make_promo(code="  summer  ").code == "SUMMER"
+
+
+@pytest.mark.parametrize("code", ["", "   "])
+def test_empty_code_rejected(code):
+    with pytest.raises(ValidationError):
+        make_promo(code=code)
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("-5"), Decimal("100.01")])
+def test_percent_out_of_range_rejected(value):
+    with pytest.raises(ValidationError):
+        make_promo(kind=DiscountKind.PERCENT, value=value)
+
+
+def test_percent_100_is_allowed():
+    assert make_promo(value=Decimal("100")).value == Decimal("100")
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("-1"), Decimal("1.005")])
+def test_fixed_value_must_be_positive_money(value):
+    with pytest.raises(ValidationError):
+        make_promo(kind=DiscountKind.FIXED, value=value)
+
+
+def test_money_fields_reject_floats_and_extra_digits():
+    with pytest.raises(ValidationError):
+        make_promo(kind=DiscountKind.FIXED, value=100.0)
+    with pytest.raises(ValidationError):
+        make_promo(min_order_amount=Decimal("-1.00"))
+    with pytest.raises(ValidationError):
+        make_promo(min_order_amount=Decimal("10.001"))
+
+
+def test_validity_period_must_be_ordered_and_aware():
+    with pytest.raises(ValidationError):
+        make_promo(starts_at=START, expires_at=START)
+    with pytest.raises(ValidationError):
+        make_promo(starts_at=datetime(2026, 3, 1))
+
+
+@pytest.mark.parametrize("max_uses", [0, -1, True, 1.5])
+def test_max_uses_must_be_positive_int(max_uses):
+    with pytest.raises(ValidationError):
+        make_promo(max_uses=max_uses)
+
+
+def test_unknown_category_rejected():
+    with pytest.raises(ValidationError):
+        make_promo(excluded_categories=frozenset({"toys"}))
+
+
+def test_promo_errors_are_independent_subclasses():
+    for error in (UnknownPromoCodeError, PromoExpiredError, PromoConditionsError):
+        assert issubclass(error, PromoError)
+        assert issubclass(error, ShopError)
+    assert not issubclass(PromoExpiredError, UnknownPromoCodeError)
+    assert not issubclass(PromoConditionsError, PromoExpiredError)
+
+
+def test_resolve_is_case_and_space_insensitive():
+    registry = registry_with(make_promo())
+    assert registry.resolve(" summer ").code == "SUMMER"
+
+
+def test_resolve_unknown_and_blank_codes():
+    registry = registry_with(make_promo())
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("WINTER")
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("")
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("   ")
+
+
+def test_duplicate_code_rejected():
+    registry = registry_with(make_promo())
+    with pytest.raises(ValidationError):
+        registry.add(make_promo(code="summer", value=Decimal("5")))
+
+
+def test_not_started_yet_is_expired_error():
+    promo = make_promo(starts_at=START + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        registry_with(promo).resolve("SUMMER")
+
+
+def test_start_is_inclusive_and_expiry_is_exclusive():
+    promo = make_promo(starts_at=START, expires_at=START + timedelta(days=1))
+    clock = FixedClock(START)
+    registry = PromoRegistry(clock)
+    registry.add(promo)
+    assert registry.resolve("SUMMER") is promo
+
+    clock.set(START + timedelta(days=1) - timedelta(seconds=1))
+    assert registry.resolve("SUMMER") is promo
+
+    clock.set(START + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER")
+
+
+def test_limit_reached_is_conditions_error():
+    promo = make_promo(max_uses=2)
+    registry = registry_with(promo)
+    registry.record_use("summer")
+    assert registry.resolve("SUMMER") is promo
+    registry.record_use("SUMMER")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER")
+
+
+def test_expiry_is_checked_before_limit():
+    promo = make_promo(max_uses=1, expires_at=START)
+    clock = FixedClock(START - timedelta(hours=1))
+    registry = PromoRegistry(clock)
+    registry.add(promo)
+    registry.record_use("SUMMER")
+    clock.set(START)
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER")
+
+
+def test_uses_counter_and_release():
+    registry = registry_with(make_promo())
+    assert registry.uses("SUMMER") == 0
+    registry.record_use("SUMMER")
+    registry.record_use("summer")
+    assert registry.uses(" SUMMER ") == 2
+    registry.release_use("SUMMER")
+    assert registry.uses("SUMMER") == 1
+
+
+def test_uses_of_unknown_code_is_unknown_error():
+    with pytest.raises(UnknownPromoCodeError):
+        registry_with(make_promo()).uses("WINTER")
+
+
+def test_resolve_does_not_count_use():
+    registry = registry_with(make_promo(max_uses=1))
+    registry.resolve("SUMMER")
+    registry.resolve("SUMMER")
+    assert registry.uses("SUMMER") == 0
+
+
+def test_excluded_categories_are_stored_as_categories():
+    promo = make_promo(excluded_categories=frozenset({"food", Category.CLOTHING}))
+    assert promo.excluded_categories == frozenset({Category.FOOD, Category.CLOTHING})
diff --git a/tests/test_promo_orders.py b/tests/test_promo_orders.py
new file mode 100644
index 0000000..ae54d29
--- /dev/null
+++ b/tests/test_promo_orders.py
@@ -0,0 +1,133 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import PromoConditionsError, PromoExpiredError, UnknownPromoCodeError
+from shop.orders import OrderService, OrderStatus
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    promos = PromoRegistry(clock)
+    promos.add(PromoCode("SUMMER", DiscountKind.PERCENT, Decimal("10"), max_uses=1))
+    promos.add(PromoCode("BIGMIN", DiscountKind.FIXED, Decimal("100.00"),
+                         min_order_amount=Decimal("5000.00")))
+    return promos
+
+
+def test_old_calls_without_promo_are_unchanged(products, clock):
+    service = OrderService(clock=clock)
+    cart = Cart()
+    cart.add(products["tea"], 3)
+    cart.add(products["shirt"])
+    assert service.quote(cart).total == Decimal("2157.47")
+    order = service.place_order(cart)
+    assert order.promo_code is None
+    assert order.total.discount == Decimal("0.00")
+
+
+@pytest.mark.parametrize("blank", ["", "   "])
+def test_blank_code_means_no_code(products, clock, blank):
+    service = OrderService(clock=clock)
+    cart = Cart()
+    cart.add(products["book"])
+    assert service.quote(cart, blank).total == service.quote(cart).total
+    assert service.place_order(cart, blank).promo_code is None
+
+
+def test_quote_applies_code_without_counting_it(products, clock, registry):
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["phone"])
+    for _ in range(3):
+        total = service.quote(cart, "summer")
+    assert total.discount == Decimal("250.00")
+    assert registry.uses("SUMMER") == 0
+    assert len(service.store) == 0
+
+
+def test_place_order_stores_normalized_code_and_counts_use(products, clock, registry):
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["phone"])
+    order = service.place_order(cart, " summer ")
+    assert order.promo_code == "SUMMER"
+    assert order.total.discount == Decimal("250.00")
+    assert order.total.total == Decimal("2250.00") + Decimal("299.00") + Decimal("450.00")
+    assert registry.uses("SUMMER") == 1
+
+
+def test_limit_blocks_second_order(products, clock, registry):
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["phone"])
+    service.place_order(cart, "SUMMER")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER")
+    assert registry.uses("SUMMER") == 1
+    assert len(service.store) == 1
+
+
+def test_failed_order_does_not_count_use(products, clock, registry):
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["book"])  # below the 5000.00 minimum
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "BIGMIN")
+    assert registry.uses("BIGMIN") == 0
+    assert len(service.store) == 0
+
+
+def test_cancel_returns_use(products, clock, registry):
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["phone"])
+    order = service.place_order(cart, "SUMMER")
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert cancelled.promo_code == "SUMMER"
+    assert registry.uses("SUMMER") == 0
+    # the code can be used again by a new order
+    again = service.place_order(cart, "SUMMER")
+    assert again.total.discount == Decimal("250.00")
+
+
+def test_cancel_without_code_leaves_counter_alone(products, clock, registry):
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["book"])
+    order = service.place_order(cart)
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER") == 0
+
+
+def test_code_without_registry_is_unknown(products, clock):
+    service = OrderService(clock=clock)
+    cart = Cart()
+    cart.add(products["book"])
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart, "SUMMER")
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart, "SUMMER")
+
+
+def test_unknown_code_is_rejected(products, clock, registry):
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["book"])
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart, "NOPE")
+    assert len(service.store) == 0
+
+
+def test_expired_code_is_rejected(products, clock, registry):
+    registry.add(PromoCode("OLD", DiscountKind.FIXED, Decimal("50.00"),
+                           expires_at=clock.now() - timedelta(seconds=1)))
+    service = OrderService(clock=clock, promos=registry)
+    cart = Cart()
+    cart.add(products["book"])
+    with pytest.raises(PromoExpiredError):
+        service.quote(cart, "OLD")
diff --git a/tests/test_promo_pricing.py b/tests/test_promo_pricing.py
new file mode 100644
index 0000000..a925f9c
--- /dev/null
+++ b/tests/test_promo_pricing.py
@@ -0,0 +1,195 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+
+def percent(value="10", **kwargs):
+    return PromoCode("SUMMER", DiscountKind.PERCENT, Decimal(value), **kwargs)
+
+
+def fixed(value, **kwargs):
+    return PromoCode("SUMMER", DiscountKind.FIXED, Decimal(value), **kwargs)
+
+
+def test_no_promo_gives_zero_discount_and_same_totals(products):
+    cart = Cart()
+    cart.add(products["tea"], 3)
+    cart.add(products["shirt"])
+    total = calculate_total(cart, promo=None)
+    assert total.discount == Decimal("0.00")
+    assert all(line.discount == Decimal("0.00") for line in total.lines)
+    assert total.total == Decimal("2157.47")
+
+
+def test_percent_applies_only_to_participating_lines(products):
+    cart = Cart()
+    cart.add(products["phone"])  # 2500.00, electronics
+    cart.add(products["tea"])    # 199.90, food
+    cart.add(products["gift"])   # 1000.00, gift card: never discounted
+    total = calculate_total(cart, promo=percent("10", excluded_categories=frozenset({Category.FOOD})))
+    by_sku = {line.sku: line for line in total.lines}
+    assert by_sku["PHONE-1"].discount == Decimal("250.00")
+    assert by_sku["TEA-1"].discount == Decimal("0.00")
+    assert by_sku["GIFT-1000"].discount == Decimal("0.00")
+    assert total.discount == Decimal("250.00")
+    assert total.subtotal == Decimal("3699.90")
+
+
+def test_tax_is_charged_after_line_discount(products):
+    cart = Cart()
+    cart.add(products["tea"])  # 199.90 at 10 %
+    cart.add(products["book"])  # 450.00 at 10 %
+    total = calculate_total(cart, promo=percent("10"))
+    tea, book = total.lines
+    # tea: 199.90 - 19.99 = 179.91 -> tax 17.991 -> 17.99
+    assert tea.discount == Decimal("19.99")
+    assert tea.tax == Decimal("17.99")
+    # book: 450.00 - 45.00 = 405.00 -> tax 40.50
+    assert book.discount == Decimal("45.00")
+    assert book.tax == Decimal("40.50")
+
+
+def test_full_example_totals(products):
+    cart = Cart()
+    cart.add(products["book"])
+    cart.add(products["tea"])
+    cart.add(products["phone"])
+    total = calculate_total(cart, promo=percent("10"))
+    # subtotal 3149.90, discount 314.99 (exact split 45.00 / 19.99 / 250.00),
+    # goods after discount 2834.91 < 3000 -> shipping 299.00, tax 40.50 + 17.99 + 450.00
+    assert total.subtotal == Decimal("3149.90")
+    assert total.discount == Decimal("314.99")
+    assert total.shipping == Decimal("299.00")
+    assert total.tax == Decimal("508.49")
+    assert total.total == Decimal("3642.40")
+    assert total.total == total.subtotal - total.discount + total.shipping + total.tax
+
+
+def test_percent_rounds_half_up():
+    product = Product("ITEM-1", "Item", Decimal("333.33"), Category.ELECTRONICS)
+    cart = Cart()
+    cart.add(product)
+    # 333.33 * 15 % = 49.9995 -> 50.00
+    assert calculate_total(cart, promo=percent("15")).discount == Decimal("50.00")
+
+
+def test_fixed_discount_is_capped_by_participating_sum(products):
+    cart = Cart()
+    cart.add(products["book"])   # 450.00 participates
+    cart.add(products["gift"])   # 1000.00 does not participate
+    total = calculate_total(cart, promo=fixed("700.00"))
+    assert total.discount == Decimal("450.00")
+    assert total.lines[0].discount == Decimal("450.00")
+    assert total.lines[1].discount == Decimal("0.00")
+    # the book is fully discounted, so it has no tax; goods after discount 1000.00 -> shipping 299.00
+    assert total.shipping == Decimal("299.00")
+    assert total.tax == Decimal("0.00")
+    assert total.total == Decimal("1299.00")
+
+
+def test_fixed_discount_below_cap_is_taken_as_is(products):
+    cart = Cart()
+    cart.add(products["phone"])
+    total = calculate_total(cart, promo=fixed("300.00"))
+    assert total.discount == Decimal("300.00")
+    assert total.subtotal - total.discount + total.shipping + total.tax == total.total
+
+
+def test_split_leftover_goes_to_largest_remainder_not_first_line():
+    # 0.05 over 10.00 and 20.00: floors 0.01 + 0.03 = 0.04, the extra kopeck goes to
+    # the first line (remainder 2000/3000 beats 1000/3000)
+    cart = Cart()
+    cart.add(Product("X-1", "X", Decimal("10.00"), Category.CLOTHING))
+    cart.add(Product("Y-1", "Y", Decimal("20.00"), Category.CLOTHING))
+    total = calculate_total(cart, promo=fixed("0.05"))
+    assert [line.discount for line in total.lines] == [Decimal("0.02"), Decimal("0.03")]
+
+
+def test_split_ties_go_to_earlier_line_in_cart():
+    cart = Cart()
+    for sku in ("A-1", "B-1", "C-1"):
+        cart.add(Product(sku, sku, Decimal("100.00"), Category.CLOTHING))
+    total = calculate_total(cart, promo=fixed("0.10"))
+    assert [line.discount for line in total.lines] == [
+        Decimal("0.04"),
+        Decimal("0.03"),
+        Decimal("0.03"),
+    ]
+    assert total.discount == Decimal("0.10")
+
+
+def test_split_is_exact_for_large_leftover_case(products):
+    # Shares of 200.00 over 3149.90 (book, tea, phone): floors 28.57 + 12.69 + 158.73,
+    # and the one leftover kopeck goes to the phone (largest remainder 0.52 kopecks).
+    cart = Cart()
+    cart.add(products["book"])
+    cart.add(products["tea"])
+    cart.add(products["phone"])
+    total = calculate_total(cart, promo=fixed("200.00"))
+    assert [line.discount for line in total.lines] == [
+        Decimal("28.57"),
+        Decimal("12.69"),
+        Decimal("158.74"),
+    ]
+    assert sum(line.discount for line in total.lines) == Decimal("200.00")
+
+
+def test_excluded_categories_only_cart_is_rejected(products):
+    cart = Cart()
+    cart.add(products["tea"])
+    promo = percent("10", excluded_categories=frozenset({Category.FOOD}))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo)
+
+
+def test_gift_cards_only_cart_is_rejected(products):
+    cart = Cart()
+    cart.add(products["gift"])
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=percent("10"))
+
+
+def test_min_order_amount_counts_only_participating_lines_before_discount(products):
+    cart = Cart()
+    cart.add(products["book"])   # 450.00
+    cart.add(products["gift"])   # 1000.00, does not count
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=percent("10", min_order_amount=Decimal("1000.00")))
+
+
+def test_min_order_amount_is_inclusive():
+    product = Product("EXACT-1", "Exact", Decimal("1000.00"), Category.CLOTHING)
+    cart = Cart()
+    cart.add(product)
+    total = calculate_total(cart, promo=percent("10", min_order_amount=Decimal("1000.00")))
+    assert total.discount == Decimal("100.00")
+
+
+def test_min_order_amount_ignores_shipping_and_tax():
+    product = Product("EXACT-2", "Exact", Decimal("999.00"), Category.CLOTHING)
+    cart = Cart()
+    cart.add(product)  # 999.00 + tax 199.80 + shipping 299.00 would pass 1000
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=percent("10", min_order_amount=Decimal("1000.00")))
+
+
+def test_shipping_threshold_uses_goods_after_discount(products):
+    cart = Cart()
+    cart.add(products["phone"])
+    cart.add(products["book"])
+    cart.add(products["tea"])  # 3149.90 before discount, free shipping without promo
+    assert calculate_total(cart).shipping == Decimal("0.00")
+    # 200.00 off -> 2949.90 of goods, below 3000 -> shipping is charged
+    assert calculate_total(cart, promo=fixed("200.00")).shipping == Decimal("299.00")
+
+
+def test_discount_does_not_change_shipping_fee(products):
+    cart = Cart()
+    cart.add(products["book"])
+    total = calculate_total(cart, ShippingPolicy(), promo=fixed("100.00"))
+    assert total.shipping == Decimal("299.00")
