+def _parse_row(layout: _Layout, cells: list[str], imported_at: dt.datetime) -> Transaction:
+    fmt = layout.format
+    needed = max(layout.columns[col] for col in fmt.columns)
+    if len(cells) <= needed:
+        raise ValidationError("not enough fields")
+    if len(cells) > layout.width and any(cell.strip() for cell in cells[layout.width :]):
+        raise ValidationError("too many fields")
+    values = {col: cells[layout.columns[col]].strip() for col in fmt.columns}
+    date, amount, description = fmt.parse(values)
+    return Transaction(date=date, amount=amount, description=description, imported_at=imported_at)
+
