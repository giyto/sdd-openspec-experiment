+def import_statement(
+    path: str | os.PathLike[str],
+    store: MemoryStore,
+    *,
+    fmt: str | None = None,
+    strict: bool = False,
+    categorizer: Categorizer | None = None,
+    clock: Clock | None = None,
+) -> ImportResult:
+    """Импортирует выписку в store.
+
+    Нестрогий режим: плохие строки попадают в `errors`, остальные импортируются.
+    Строгий режим: на первой плохой строке (в порядке файла) бросается StatementRowError,
+    и store не меняется. Дубликаты (уже есть в store) ошибками не считаются.
+    Все новые транзакции пишутся одним вызовом `store.add_many`.
+    """
+    clock = clock or SystemClock()
+    imported_at = clock.now()
+    text, encoding = _read_text(path)
+    layout = _layout(text, fmt)
+
+    # Дедупликация по количеству: k — сколько таких операций уже в хранилище.
+    existing = Counter(_key(tx) for tx in store.all())
+    new_txs: list[Transaction] = []
+    errors: list[RowError] = []
+    duplicates = 0
+    for line_no, cells in layout.rows:
+        if _is_junk(cells):
+            continue
+        try:
+            tx = _parse_row(layout, cells, imported_at)
+        except ValidationError as exc:
+            if strict:
+                raise StatementRowError(str(exc), line_no=line_no) from exc
+            errors.append(RowError(line_no=line_no, message=str(exc)))
+            continue
+        key = _key(tx)
+        if existing[key] > 0:
+            existing[key] -= 1
+            duplicates += 1
+            continue
+        if categorizer is not None:
+            category = categorizer.categorize(tx)
+            if category is not None:
+                tx = Transaction(
+                    date=tx.date,
+                    amount=tx.amount,
+                    description=tx.description,
+                    category=category,
+                    imported_at=tx.imported_at,
+                )
+        new_txs.append(tx)
+
+    if new_txs:
+        store.add_many(new_txs)
+    logger.info("imported %d transactions from %s", len(new_txs), path)
+    return ImportResult(
+        format=layout.format.name,
+        encoding=encoding,
+        added=len(new_txs),
+        duplicates=duplicates,
+        errors=tuple(errors),
+    )
 
 
