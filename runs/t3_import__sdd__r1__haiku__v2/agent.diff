+def _read_records(text: str, delimiter: str) -> list[tuple[int, list[str]]]:
+    """Записи CSV с физическим номером строки, где запись начинается.
+
+    Запись в кавычках может занимать несколько строк; пустая строка даёт пустой список ячеек.
+    """
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    records = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            cells = next(reader)
+        except StopIteration:
+            return records
+        records.append((start, cells))
+
+
+def _is_junk(cells: list[str]) -> bool:
+    """Строка из пустых ячеек, пробелов или одних разделителей."""
+    return not any(cell.strip() for cell in cells)
+
