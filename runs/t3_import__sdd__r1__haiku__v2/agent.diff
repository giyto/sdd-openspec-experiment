+def _layout(text: str, fmt_name: str | None) -> _Layout:
+    if fmt_name is not None and fmt_name not in _FORMATS:
+        raise UnknownFormatError(f"unknown format {fmt_name!r}")
+    formats = [_FORMATS[fmt_name]] if fmt_name is not None else list(_FORMATS.values())
+
+    headers: dict[str, tuple[int, list[str]]] = {}
+    for delimiter in _DELIMITERS:
+        header = next((rec for rec in _read_records(text, delimiter) if not _is_junk(rec[1])), None)
+        if header is not None:
+            headers[delimiter] = header
+    if not headers:
+        raise UnknownFormatError("file has no header line")
+
+    matches = []
+    for fmt in formats:
+        if fmt.delimiter not in headers:
+            continue
+        line_no, cells = headers[fmt.delimiter]
+        columns = _column_index(cells)
+        if set(fmt.columns) <= columns.keys():
+            matches.append((fmt, line_no, columns, cells))
+    if len(matches) != 1:
+        if fmt_name is not None:
+            reason = f"header does not match format {fmt_name!r}"
+        elif matches:
+            names = ", ".join(m[0].name for m in matches)
+            reason = f"header matches several formats: {names}"
+        else:
+            reason = "header matches no known format"
+        raise UnknownFormatError(reason, line_no=1)
+
+    fmt, header_line, columns, cells = matches[0]
+    rows = [rec for rec in _read_records(text, fmt.delimiter) if rec[0] > header_line]
+    return _Layout(format=fmt, columns=columns, width=len(cells), rows=rows)
+
