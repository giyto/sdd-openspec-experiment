@@ -0,0 +1,146 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import PromoConditionsError, PromoExpiredError, UnknownPromoCodeError
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def book_cart(products):
+    cart = Cart()
+    cart.add(products["book"])  # 450.00
+    return cart
+
+
+def add_promo(registry, code="SUMMER10", **overrides):
+    fields = {"kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    registry.add(PromoCode(code=code, **fields))
+
+
+# 4.1 Order.promo_code and the optional registry
+
+
+def test_order_without_promo_has_no_promo_code(clock, book_cart):
+    order = OrderService(clock=clock).place_order(book_cart)
+    assert order.promo_code is None
+
+
+def test_order_without_promo_code_argument_has_none(service, book_cart):
+    assert service.place_order(book_cart).promo_code is None
+
+
+# 4.2 quote
+
+
+@pytest.mark.parametrize("raw", [None, "", "   "])
+def test_blank_code_means_no_promo(service, book_cart, raw):
+    total = service.quote(book_cart, raw)
+    assert total.discount == Decimal("0.00")
+    assert total == service.quote(book_cart)
+
+
+def test_quote_applies_discount(service, registry, book_cart):
+    add_promo(registry)
+    total = service.quote(book_cart, "  summer10 ")
+    assert total.discount == Decimal("45.00")
+
+
+def test_quote_does_not_count_use(service, registry, book_cart):
+    add_promo(registry, max_uses=1)
+    for _ in range(3):
+        service.quote(book_cart, "SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    assert service.place_order(book_cart, "SUMMER10").promo_code == "SUMMER10"
+
+
+def test_quote_with_code_but_no_registry_is_unknown(clock, book_cart):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(book_cart, "SUMMER10")
+
+
+def test_quote_unknown_code(service, book_cart):
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(book_cart, "NOPE")
+
+
+# 4.3 place_order
+
+
+def test_place_order_stores_normalized_code(service, registry, book_cart):
+    add_promo(registry)
+    order = service.place_order(book_cart, " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == Decimal("45.00")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_failed_order_does_not_count_use_or_consume_id(service, registry, book_cart):
+    add_promo(registry, min_order_amount=Decimal("5000.00"), max_uses=1)
+    with pytest.raises(PromoConditionsError):
+        service.place_order(book_cart, "SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+    assert service.place_order(book_cart).order_id == "ORD-000001"
+
+
+def test_expired_code_fails_without_order(clock, service, registry, book_cart):
+    add_promo(registry, expires_at=clock.now())
+    with pytest.raises(PromoExpiredError):
+        service.place_order(book_cart, "SUMMER10")
+    assert len(service.store) == 0
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_unknown_code_creates_no_order(service, book_cart):
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(book_cart, "NOPE")
+    assert len(service.store) == 0
+
+
+def test_limit_is_respected_across_orders(service, registry, book_cart):
+    add_promo(registry, max_uses=2)
+    service.place_order(book_cart, "SUMMER10")
+    service.place_order(book_cart, "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(book_cart, "SUMMER10")
+    assert registry.uses("SUMMER10") == 2
+    assert len(service.store) == 2
+
+
+# 4.4 cancel returns the use
+
+
+def test_cancel_returns_use_so_code_can_be_reused(service, registry, book_cart):
+    add_promo(registry, max_uses=1)
+    first = service.place_order(book_cart, "SUMMER10")
+    assert registry.uses("SUMMER10") == 1
+
+    service.cancel(first.order_id)
+    assert registry.uses("SUMMER10") == 0
+
+    second = service.place_order(book_cart, "SUMMER10")
+    assert second.promo_code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_cancel_order_without_promo_leaves_counter(service, registry, book_cart):
+    add_promo(registry, max_uses=1)
+    plain = service.place_order(book_cart)
+    service.cancel(plain.order_id)
+    assert registry.uses("SUMMER10") == 0
+
diff --git a/tests/test_promo_pricing.py b/tests/test_promo_pricing.py
new file mode 100644
index 0000000..9e7d602
--- /dev/null
+++ b/tests/test_promo_pricing.py
@@ -0,0 +1,203 @@
+import random
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+def promo(kind=DiscountKind.PERCENT, value="10", **overrides):
+    return PromoCode(code="SALE", kind=kind, value=Decimal(value), **overrides)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, quantity in items:
+        cart.add(product, quantity)
+    return cart
+
+
+def product(sku, price, category):
+    return Product(sku, sku, Decimal(price), category)
+
+
+# 3.2 eligibility and minimum amount
+
+
+def test_excluded_category_is_not_discounted(products):
+    cart = cart_of((products["book"], 1), (products["phone"], 1))
+    total = calculate_total(
+        cart, promo=promo(excluded_categories=frozenset({Category.ELECTRONICS}))
+    )
+    lines = {line.sku: line for line in total.lines}
+    assert lines["BOOK-1"].discount == Decimal("45.00")
+    assert lines["PHONE-1"].discount == Decimal("0.00")
+    assert total.discount == Decimal("45.00")
+
+
+def test_gift_card_is_never_discounted(products):
+    cart = cart_of((products["gift"], 1), (products["book"], 1))
+    total = calculate_total(cart, promo=promo())
+    lines = {line.sku: line for line in total.lines}
+    assert lines["GIFT-1000"].discount == Decimal("0.00")
+    assert lines["GIFT-1000"].tax == Decimal("0.00")
+    assert total.discount == Decimal("45.00")
+
+
+def test_only_gift_cards_gives_conditions_error(products):
+    cart = cart_of((products["gift"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(min_order_amount=Decimal("0")))
+
+
+def test_only_excluded_items_gives_conditions_error_even_without_minimum(products):
+    cart = cart_of((products["phone"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart,
+            promo=promo(excluded_categories=frozenset({Category.ELECTRONICS})),
+        )
+
+
+def test_minimum_is_inclusive(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 1))  # 2950.00 eligible
+    total = calculate_total(cart, promo=promo(min_order_amount=Decimal("2950.00")))
+    assert total.discount == Decimal("295.00")
+
+
+def test_below_minimum_gives_conditions_error(products):
+    cart = cart_of((products["phone"], 1), (products["tea"], 1))  # 2699.90
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(min_order_amount=Decimal("2700.00")))
+
+
+def test_minimum_above_eligible_amount_gives_conditions_error(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 1))  # 2950.00 eligible
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(min_order_amount=Decimal("2950.01")))
+
+
+# 3.3 discount amount and kopeck split
+
+
+def test_percent_rounds_half_up():
+    book = product("BOOK-X", "1005.55", Category.BOOKS)
+    total = calculate_total(cart_of((book, 1)), promo=promo(value="10"))
+    assert total.discount == Decimal("100.56")
+
+
+def test_fixed_discount_is_capped_by_eligible_amount(products):
+    cart = cart_of((products["tea"], 1), (products["book"], 1))  # 649.90 eligible
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "700.00"))
+    assert total.discount == Decimal("649.90")
+    assert total.total == total.shipping + total.tax
+
+
+def test_fixed_discount_below_amount(products):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "50.00"))
+    assert total.discount == Decimal("50.00")
+
+
+def test_hundred_percent_discount_equals_eligible_amount(products):
+    cart = cart_of((products["book"], 1), (products["phone"], 1))
+    total = calculate_total(cart, promo=promo(value="100"))
+    assert total.discount == Decimal("2950.00")
+
+
+def test_penny_goes_to_first_line_with_largest_remainder():
+    a = product("A-1", "100.00", Category.BOOKS)
+    b = product("B-1", "100.00", Category.BOOKS)
+    total = calculate_total(
+        cart_of((a, 1), (b, 1)), promo=promo(DiscountKind.FIXED, "0.01")
+    )
+    assert [line.discount for line in total.lines] == [Decimal("0.01"), Decimal("0.00")]
+
+
+def test_equal_remainders_follow_cart_order():
+    items = [product(f"C-{i}", "100.00", Category.BOOKS) for i in range(3)]
+    cart = cart_of(*[(item, 1) for item in items])
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "0.02"))
+    assert [line.discount for line in total.lines] == [
+        Decimal("0.01"),
+        Decimal("0.01"),
+        Decimal("0.00"),
+    ]
+
+
+def test_line_discounts_sum_to_order_discount_on_random_carts():
+    rng = random.Random(20260615)
+    categories = [Category.BOOKS, Category.FOOD, Category.CLOTHING, Category.ELECTRONICS]
+    for _ in range(300):
+        cart = Cart()
+        for index in range(rng.randint(1, 6)):
+            price = Decimal(rng.randint(1, 99999)) / 100
+            item = Product(f"R-{index}", f"r{index}", price, rng.choice(categories))
+            cart.add(item, rng.randint(1, 5))
+        if rng.random() < 0.5:
+            sale = promo(value=str(rng.randint(1, 100)))
+        else:
+            sale = promo(DiscountKind.FIXED, str(Decimal(rng.randint(1, 500000)) / 100))
+        try:
+            total = calculate_total(cart, promo=sale)
+        except PromoConditionsError:
+            continue
+        assert sum(line.discount for line in total.lines) == total.discount
+        for line in total.lines:
+            assert Decimal("0") <= line.discount <= line.amount
+            assert line.discount == line.discount.quantize(Decimal("0.01"))
+
+
+# 3.4 tax and shipping with discount
+
+
+def test_tax_is_charged_after_discount(products):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart, promo=promo(value="10"))
+    assert total.lines[0].tax == Decimal("40.50")
+    assert total.tax == Decimal("40.50")
+
+
+def test_discount_brings_free_shipping_threshold_closer():
+    big = product("BIG-1", "3100.00", Category.ELECTRONICS)
+    total = calculate_total(cart_of((big, 1)), promo=promo(DiscountKind.FIXED, "200.00"))
+    assert total.subtotal == Decimal("3100.00")
+    assert total.discount == Decimal("200.00")
+    assert total.shipping == Decimal("299.00")
+    assert total.tax == Decimal("580.00")
+    assert total.total == Decimal("3779.00")
+
+
+def test_discount_does_not_reduce_shipping(products):
+    cart = cart_of((products["book"], 1))
+    plain = calculate_total(cart)
+    discounted = calculate_total(cart, promo=promo(value="50"))
+    assert discounted.shipping == plain.shipping == Decimal("299.00")
+
+
+def test_total_formula_with_discount(products):
+    cart = cart_of((products["book"], 2), (products["phone"], 1))
+    total = calculate_total(cart, promo=promo(value="10"))
+    assert total.total == total.subtotal - total.discount + total.shipping + total.tax
+
+
+# 3.5 backward compatibility of the signature
+
+
+def test_promo_is_keyword_only(products):
+    cart = cart_of((products["book"], 1))
+    with pytest.raises(TypeError):
+        calculate_total(cart, None, None, promo())
+
+
+def test_calls_without_promo_give_the_same_totals(products):
+    cart = cart_of((products["book"], 2), (products["tea"], 3), (products["gift"], 1))
+    shipping = ShippingPolicy()
+    default = calculate_total(cart)
+    explicit = calculate_total(cart, shipping, None)
+    assert default == explicit
+    assert default.discount == Decimal("0.00")
+    assert all(line.discount == Decimal("0.00") for line in default.lines)
+    assert default.total == default.subtotal + default.shipping + default.tax
diff --git a/tests/test_promo_registry.py b/tests/test_promo_registry.py
new file mode 100644
index 0000000..a991d49
--- /dev/null
+++ b/tests/test_promo_registry.py
@@ -0,0 +1,162 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+NOW = datetime(2026, 6, 15, 12, 0, tzinfo=timezone.utc)
+START = datetime(2026, 6, 1, tzinfo=timezone.utc)
+END = datetime(2026, 7, 1, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def clock():
+    return FixedClock(NOW)
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def promo(code="SUMMER10", **overrides):
+    fields = {"kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    return PromoCode(code=code, **fields)
+
+
+# 2.1 registry storage and duplicates
+
+
+def test_add_and_resolve_by_normalized_code(registry):
+    registry.add(promo("summer10"))
+    assert registry.resolve("  SUMMER10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize("other", ["summer10", " Summer10", "SUMMER10  "])
+def test_duplicate_code_with_other_case_or_spaces_is_rejected(registry, other):
+    registry.add(promo("SUMMER10"))
+    with pytest.raises(ValidationError):
+        registry.add(promo(other))
+
+
+def test_uses_starts_at_zero(registry):
+    registry.add(promo())
+    assert registry.uses("summer10") == 0
+
+
+# 2.2 resolve order and validity boundaries
+
+
+def test_resolve_unknown_code(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("NOPE")
+
+
+def test_resolve_empty_code_is_unknown(registry):
+    registry.add(promo())
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("   ")
+
+
+def test_starts_at_is_inclusive(clock, registry):
+    registry.add(promo(starts_at=NOW, expires_at=END))
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_before_starts_at_is_expired(clock, registry):
+    registry.add(promo(starts_at=NOW + timedelta(seconds=1)))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_expires_at_is_exclusive(clock, registry):
+    registry.add(promo(starts_at=START, expires_at=NOW))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_one_second_before_expires_at_is_valid(clock, registry):
+    registry.add(promo(starts_at=START, expires_at=NOW + timedelta(seconds=1)))
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_open_bounds_mean_no_limit(clock, registry):
+    registry.add(promo())
+    clock.set(datetime(2100, 1, 1, tzinfo=timezone.utc))
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_expiry_is_checked_before_usage_limit(clock, registry):
+    registry.add(promo(expires_at=NOW + timedelta(days=1), max_uses=1))
+    registry.record_use("SUMMER10")  # the limit is now exhausted
+    clock.advance(timedelta(days=2))  # and the code has expired
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_existence_is_checked_first(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("MISSING")
+
+
+# 2.3 usage counter and limit
+
+
+def test_resolve_after_limit_is_exhausted_gives_conditions_error(registry):
+    registry.add(promo(max_uses=1))
+    registry.record_use("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+
+
+def test_resolve_works_again_after_release_use(registry):
+    registry.add(promo(max_uses=1))
+    registry.record_use("SUMMER10")
+    registry.release_use("SUMMER10")
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_record_use_counts_up_to_limit(registry):
+    registry.add(promo(max_uses=2))
+    registry.record_use("SUMMER10")
+    registry.record_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 2
+    with pytest.raises(PromoConditionsError):
+        registry.record_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 2
+
+
+def test_record_use_on_expired_code_does_not_count(clock, registry):
+    registry.add(promo(expires_at=NOW))
+    with pytest.raises(PromoExpiredError):
+        registry.record_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_release_use_never_goes_below_zero(registry):
+    registry.add(promo())
+    registry.release_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+
+
+# 2.4 uses for unknown codes
+
+
+def test_uses_of_unknown_code_raises(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE")
+
+
+def test_release_use_of_unknown_code_raises(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.release_use("NOPE")
