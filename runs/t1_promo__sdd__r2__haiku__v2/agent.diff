+++ b/tests/test_promo_code.py
@@ -0,0 +1,78 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.errors import ValidationError
+from shop.promo import DiscountKind, PromoCode
+
+START = datetime(2026, 6, 1, tzinfo=timezone.utc)
+END = START + timedelta(days=30)
+
+
+def make(**overrides):
+    fields = {"code": "SUMMER10", "kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    return PromoCode(**fields)
+
+
+def test_code_is_normalized():
+    assert make(code="  summer10 ").code == "SUMMER10"
+
+
+def test_defaults():
+    promo = make()
+    assert promo.min_order_amount == Decimal("0.00")
+    assert promo.starts_at is None and promo.expires_at is None
+    assert promo.max_uses is None
+    assert promo.excluded_categories == frozenset()
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"value": Decimal("100")},
+        {"value": Decimal("0.5")},
+        {"kind": DiscountKind.FIXED, "value": Decimal("0.01")},
+        {"kind": DiscountKind.FIXED, "value": Decimal("500")},
+        {"min_order_amount": Decimal("0")},
+        {"starts_at": START, "expires_at": END},
+        {"starts_at": START, "expires_at": END, "max_uses": 1},
+        {"max_uses": 1},
+        {"excluded_categories": frozenset({Category.ELECTRONICS})},
+    ],
+)
+def test_valid_promo_codes_are_accepted(overrides):
+    make(**overrides)
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"value": Decimal("0")},
+        {"value": Decimal("150")},
+        {"value": Decimal("-1")},
+        {"kind": DiscountKind.FIXED, "value": Decimal("0")},
+        {"kind": DiscountKind.FIXED, "value": Decimal("-5")},
+        {"kind": DiscountKind.FIXED, "value": Decimal("1.005")},
+        {"value": Decimal("NaN")},
+        {"value": 10},
+        {"code": ""},
+        {"code": "   "},
+        {"min_order_amount": Decimal("-1")},
+        {"min_order_amount": Decimal("1.001")},
+        {"max_uses": 0},
+        {"max_uses": True},
+        {"max_uses": 1.5},
+        {"starts_at": datetime(2026, 6, 1)},
+        {"expires_at": datetime(2026, 6, 1)},
+        {"starts_at": END, "expires_at": START},
+        {"starts_at": START, "expires_at": START},
+        {"excluded_categories": frozenset({"electronics"})},
+        {"kind": "percent"},
+    ],
+)
+def test_invalid_promo_codes_are_rejected(overrides):
+    with pytest.raises(ValidationError):
+        make(**overrides)
diff --git a/tests/test_promo_errors.py b/tests/test_promo_errors.py
new file mode 100644
index 0000000..28802cf
--- /dev/null
+++ b/tests/test_promo_errors.py
@@ -0,0 +1,33 @@
+import pytest
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+)
+
+
+@pytest.mark.parametrize(
+    "error_type",
+    [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError],
+)
+def test_promo_errors_derive_from_promo_error(error_type):
+    assert issubclass(error_type, PromoError)
+    assert issubclass(error_type, ShopError)
+
+
+def test_promo_errors_are_independent_of_each_other():
+    errors = [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError]
+    for error_type in errors:
+        others = [other for other in errors if other is not error_type]
+        for other in others:
+            assert not issubclass(error_type, other)
+            assert not issubclass(other, error_type)
+
+
+def test_unknown_promo_code_error_keeps_code():
+    error = UnknownPromoCodeError("NOPE")
+    assert error.code == "NOPE"
+    assert "NOPE" in str(error)
