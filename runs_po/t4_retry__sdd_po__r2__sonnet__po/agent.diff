+def test_policy_assignment(clock):
+    default = RetryPolicy(non_retryable=(ValueError,))
+    q = JobQueue(clock=clock, default_retry_policy=default)
+    assert q.retry_policy_for("t") is default
+    own = RetryPolicy()
+    q.set_retry_policy("t", own)
+    assert q.retry_policy_for("t") is own
+    q.set_retry_policy("t", None)
+    assert q.retry_policy_for("t") is default
+    assert JobQueue(clock=clock).retry_policy_for("t") is None
+    for bad in (("t", "x"), ("", own)):
+        with pytest.raises(ConfigError):
+            q.set_retry_policy(*bad)
+    with pytest.raises(ConfigError):
+        JobQueue(default_retry_policy="x")
