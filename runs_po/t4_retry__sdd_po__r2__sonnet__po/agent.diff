+import math
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobQueue,
+    JobStatus,
+    JobqError,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+
+from .conftest import START
+
+
+class FakeRng:
+    def __init__(self, value):
+        self.value = value
+        self.calls = []
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def flaky(fail_times, exc=TimeoutError):
+    state = {"n": 0}
+
+    def handler(job):
+        state["n"] += 1
+        if state["n"] <= fail_times:
+            raise exc("gw")
+        return "ok"
+
+    return handler
+
+
+# -- errors / models / metrics ----------------------------------------------
+
+
+def test_permanent_error_hierarchy():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_new_statuses():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert JobStatus.DEAD_LETTERED.is_terminal
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+
+
+def test_new_counters_zero(queue):
+    for name in ("jobs.retried", "jobs.dead_lettered", "jobs.requeued"):
+        assert queue.metrics.get(name) == 0
+
+
+# -- RetryPolicy ------------------------------------------------------------
+
+
+def test_defaults_and_tuple():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter) == (3, 1.0, 2.0, 60.0, 0.0)
+    assert p.non_retryable == ()
+    assert RetryPolicy(non_retryable=[ValueError]).non_retryable == (ValueError,)
+    assert RetryPolicy(max_attempts=1).max_attempts == 1
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": True},
+        {"max_attempts": 2.5},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 10, "max_delay": 5},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
