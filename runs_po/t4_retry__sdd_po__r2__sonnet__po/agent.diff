+"""Политика повторов: параметры, расчёт задержки и классификация ошибок."""
+
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+from typing import Any, Sequence
+
+from .errors import ConfigError, PermanentJobError
+
+
+def _is_number(value: Any) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Неизменяемая политика повторов.
+
+    :param max_attempts: всего попыток, включая первую.
+    :param base_delay: задержка после первой неудачи, секунды.
+    :param factor: множитель роста задержки.
+    :param max_delay: жёсткий потолок задержки (jitter его тоже не превышает).
+    :param jitter: доля разброса, ``[0, 1]``.
+    :param non_retryable: классы ошибок, которые не повторяются.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: Sequence[type[BaseException]] = ()
+
+    def __post_init__(self) -> None:
+        if isinstance(self.max_attempts, bool) or not isinstance(self.max_attempts, int):
+            raise ConfigError("max_attempts must be an integer")
+        if self.max_attempts < 1:
+            raise ConfigError("max_attempts must be >= 1")
+        for name in ("base_delay", "factor", "max_delay", "jitter"):
+            value = getattr(self, name)
+            if not _is_number(value) or math.isnan(value):
+                raise ConfigError(f"{name} must be a number, not NaN")
+        if self.base_delay < 0:
+            raise ConfigError("base_delay must be >= 0")
+        if self.factor < 1:
+            raise ConfigError("factor must be >= 1")
+        if self.max_delay < self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+        try:
+            classes = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for cls in classes:
+            if not (isinstance(cls, type) and issubclass(cls, BaseException)):
+                raise ConfigError(f"non_retryable item {cls!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", classes)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка в секундах перед повтором, если упала попытка ``attempt`` (с 1)."""
+        if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt < 1:
+            raise ConfigError("attempt must be an integer >= 1")
+        if self.base_delay == 0:
+            raw = 0.0
+        elif self.factor == 1:
+            raw = float(self.base_delay)
+        else:
+            try:
+                raw = self.base_delay * float(self.factor) ** (attempt - 1)
+            except OverflowError:
+                raw = math.inf
+        delay = float(min(raw, self.max_delay))
+        if self.jitter > 0:
+            generator = rng if rng is not None else random
+            delay *= generator.uniform(1 - self.jitter, 1 + self.jitter)
+            delay = min(delay, float(self.max_delay))
+        return delay
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """Стоит ли повторять задание после ошибки ``exc``."""
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, tuple(self.non_retryable))
