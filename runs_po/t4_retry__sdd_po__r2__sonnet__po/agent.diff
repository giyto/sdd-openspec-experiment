+def test_dead_letters_is_copy_and_ordered(queue, registry):
+    registry.register("t", flaky(99))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    a, b = queue.enqueue("t"), queue.enqueue("t")
+    Worker(queue, registry).run_pending()
+    entries = queue.dead_letters()
+    assert [e.job_id for e in entries] == [a.id, b.id]
+    entries.clear()
+    assert len(queue.dead_letters()) == 2
+    assert JobQueue().dead_letters() == []
