+def make(queue, registry, handler, policy, rng=None):
+    registry.register("t", handler)
+    queue.set_retry_policy("t", policy)
+    return queue.enqueue("t"), Worker(queue, registry, rng=rng)
+
+
+def test_retry_scheduled_and_delays(queue, registry, clock):
+    job, w = make(queue, registry, flaky(5), RetryPolicy())
+    w.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=1)
+    assert job.error == "TimeoutError: gw"
+    assert w.run_once() is None
+    clock.advance(1)
+    w.run_once()
+    assert job.run_at == clock.now() + timedelta(seconds=2)
+    assert job.attempts == 2
+
+
+def test_dead_letter_when_exhausted(queue, registry, clock):
+    job, w = make(queue, registry, flaky(9), RetryPolicy())
+    for _ in range(3):
+        w.run_once()
+        clock.advance(100)
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.finished_at is not None
+    (entry,) = queue.dead_letters()
+    assert entry == DeadLetterEntry(job.id, "t", 3, "TimeoutError: gw", entry.dead_lettered_at)
+    m = queue.metrics
+    assert (m.get("jobs.retried"), m.get("jobs.dead_lettered"), m.get("jobs.failed"), m.get("jobs.started")) == (2, 1, 0, 3)
+    assert w.run_once() is None
+
+
+def test_max_attempts_one(queue, registry):
