+# -- dead-letter ------------------------------------------------------------
+
+
+def dead(queue, registry, clock, handler=None, policy=None):
+    policy = policy or RetryPolicy()
+    job, w = make(queue, registry, handler or flaky(99), policy)
+    for _ in range(policy.max_attempts):
+        w.run_once()
+        clock.advance(100)
+    assert job.status is JobStatus.DEAD_LETTERED
+    return job, w
+
+
+def test_requeue_resets_attempts(queue, registry, clock):
+    job, w = dead(queue, registry, clock)
+    result = queue.requeue_dead_letter(job.id)
+    assert result is job
+    assert (job.status, job.attempts, job.error, job.finished_at) == (JobStatus.PENDING, 0, None, None)
+    assert job.run_at == clock.now()
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.requeued") == 1
+
+
+def test_requeued_gets_full_attempts(queue, registry, clock):
+    job, w = dead(queue, registry, clock)
+    queue.requeue_dead_letter(job.id)
+    w.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    clock.advance(100)
+    w.run_once()
+    clock.advance(100)
+    w.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert len(queue.dead_letters()) == 1
+
+
+def test_full_path_to_success(queue, registry, clock):
+    job, w = dead(queue, registry, clock, flaky(3), RetryPolicy(max_attempts=3))
+    queue.requeue_dead_letter(job.id)
+    w.run_once()
+    assert job.status is JobStatus.SUCCEEDED and job.error is None
+    m = queue.metrics
+    assert (m.get("jobs.retried"), m.get("jobs.dead_lettered"), m.get("jobs.requeued")) == (2, 1, 1)
+
