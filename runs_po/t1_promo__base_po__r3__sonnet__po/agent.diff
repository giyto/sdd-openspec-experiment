+def _line_discounts(cart_lines: tuple, promo: PromoCode) -> list[Decimal]:
+    """Split the promo discount over cart lines; the parts add up to the discount exactly."""
+    eligible = [
+        line.product.category is not Category.GIFT_CARD
+        and line.product.category not in promo.excluded_categories
+        for line in cart_lines
+    ]
+    amounts = [line.amount if ok else ZERO for line, ok in zip(cart_lines, eligible)]
+    base = sum_money(amounts)
+    if base <= 0:
+        raise PromoConditionsError(f"promo code {promo.code} applies to no items in the order")
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"order amount is below the minimum {promo.min_order_amount} for {promo.code}"
+        )
+    if promo.kind is DiscountKind.PERCENT:
+        discount = quantize_money(base * promo.value / Decimal(100))
+    else:
+        discount = min(quantize_money(promo.value), base)
+
+    # Largest remainder on whole kopecks; ties go to the earlier line.
+    cents = int(discount / CENT)
+    base_cents = int(base / CENT)
+    floors: list[int] = []
+    remainders: list[int] = []
+    for amount in amounts:
+        share, rest = divmod(cents * int(amount / CENT), base_cents)
+        floors.append(share)
+        remainders.append(rest)
+    leftover = cents - sum(floors)
+    order = sorted(range(len(amounts)), key=lambda i: (-remainders[i], i))
+    for i in order[:leftover]:
+        floors[i] += 1
+    return [Decimal(c) * CENT for c in floors]
