+def test_sfera_bad_values(write_csv, date, value):
+    text = f"{HEAD}01.03.2026;-1,00;ok\n{date};{value};x\n"
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(text), MemoryStore(), strict=True)
