+import datetime as dt
+import json
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import (
+    StatementError,
+    StatementRowError,
+    UnknownFormatError,
+)
+from ledger.importer import (
+    _decode,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule
+from ledger.storage import JsonFileStore, MemoryStore
+
+HEAD = "Дата;Сумма;Описание\n"
+SFERA = HEAD + "01.03.2026;-1 200,50;Магазин Лента\n02.03.2026;+85 000,00;Зарплата\n"
+SPLIT = "Дата;Описание;Приход;Расход\n02.03.2026;Кофе;;350,00\n03.03.2026;Зарплата;85 000,00;\n"
+NOVA = "date,amount,description\n2026-03-01,-350.00,Кофейня\n"
+
+
+def amounts(store):
+    return [t.amount for t in store.all()]
+
+
+def test_error_hierarchy():
+    assert issubclass(UnknownFormatError, StatementError)
+    assert issubclass(StatementRowError, StatementError)
+    assert StatementRowError("x", line_no=4).line_no == 4
+
+
+def test_decode_variants():
+    assert _decode("Дата".encode("utf-8")) == ("Дата", "utf-8")
+    assert _decode(b"\xef\xbb\xbf" + "Дата".encode("utf-8")) == ("Дата", "utf-8")
+    assert _decode("Дата".encode("cp1251")) == ("Дата", "cp1251")
+    with pytest.raises(UnknownFormatError):
+        _decode(b"\x98\xff\xfe")
+
+
+@pytest.mark.parametrize("enc", ["utf-8", "utf-8-sig", "cp1251"])
+def test_sfera_encodings(write_csv, clock, enc):
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA, encoding=enc), store, clock=clock)
+    assert res.added == 2 and res.format == "sfera"
+    assert res.encoding == ("cp1251" if enc == "cp1251" else "utf-8")
+    assert store.all()[0].description == "Магазин Лента"
+    assert amounts(store) == [Decimal("-1200.50"), Decimal("85000.00")]
+
+
+def test_detect_formats(write_csv):
+    assert detect_format(write_csv(NOVA)) == "nova"
+    assert detect_format(write_csv(SFERA)) == "sfera"
+    assert detect_format(write_csv(SPLIT)) == "sfera_split"
+    assert detect_format(write_csv("  ДАТА ; сумма;ОПИСАНИЕ\n")) == "sfera"
+
+
+def test_explicit_format_mismatch(write_csv):
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(NOVA), store, fmt="sfera")
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(NOVA), store, fmt="bogus")
+    assert store.all() == []
+
+
+@pytest.mark.parametrize("text", ["", "\n\n  \n", ";;;\n,,\n"])
+@pytest.mark.parametrize("strict", [True, False])
+def test_empty_file(write_csv, text, strict):
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv(text), MemoryStore(), strict=strict)
+    assert info.value.line_no is None
+
+
+def test_unrecognized_header_line_1(write_csv):
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv("a;b;c\n1;2;3\n"), MemoryStore())
+    assert info.value.line_no == 1
+
+
+def test_junk_everywhere_and_numbering(write_csv, clock):
+    text = (
+        ";;;\n\n" + HEAD +
+        "01.03.2026;-1,00;a\n"
+        "   \n,,\n;;;\n"
+        '02.03.2026;-2,00;"multi\nline"\n'
+        "\n"
+        "31.02.2026;-3,00;bad\n"
+        ";;;\n"
+    )
+    res = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert res.added == 2 and res.duplicates == 0
+    assert [e.line_no for e in res.errors] == [11]
+
+
+@pytest.mark.parametrize(
+    "value,expected",
+    [
+        ("-350,00", "-350.00"),
+        ("350", "350.00"),
+        ("+85 000,00", "85000.00"),
+        ("-1 200,5", "-1200.50"),
+        ("1 234 567,89", "1234567.89"),
