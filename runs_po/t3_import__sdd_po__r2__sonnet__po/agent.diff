+)
+def test_sfera_amounts_ok(write_csv, value, expected):
+    store = MemoryStore()
+    import_statement(write_csv(f"{HEAD}01.03.2026;{value};x\n"), store, strict=True)
+    assert amounts(store) == [Decimal(expected)]
+
+
+@pytest.mark.parametrize(
