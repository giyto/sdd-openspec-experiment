--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,272 @@
+from datetime import timedelta
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.models import Reservation, ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL, aggregate
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "NUT-M8", 5)
+    return inv
+
+
+def test_models_frozen_and_errors_hierarchy():
+    line = ReservationLine("MAIN", "BOLT-M8", 1)
+    with pytest.raises(Exception):
+        line.qty = 2
+    for cls in (ReservationNotFoundError, ReservationExpiredError, DuplicateReservationError):
+        assert issubclass(cls, ReservationError) and issubclass(cls, WarehouseError)
+    assert ReservationStateError("A", "CONFIRMED").order_id == "A"
+    assert ReservationNotFoundError("A").order_id == "A"
+
+
+def test_aggregate_and_default_ttl():
+    lines = [ReservationLine("W", "S", 2), ReservationLine("W", "S", 3)]
+    assert aggregate(lines) == {("W", "S"): 5}
+    assert DEFAULT_RESERVATION_TTL == 15 * MIN
+
+
+def test_reserve_multi_warehouse(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ReservationLine("NORTH", "NUT-M8", 2)])
+    assert isinstance(res, Reservation)
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.expires_at == res.created_at + 15 * MIN
+    assert [l.sku for l in res.lines] == ["BOLT-M8", "NUT-M8"]
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+    assert stocked.available("MAIN", "BOLT-M8") == 6
+    assert len(stocked.log.events("RESERVE")) == 2
+
+
+def test_reserve_explicit_ttl(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    assert res.expires_at == res.created_at + 5 * MIN
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 5])
+def test_reserve_bad_ttl(stocked, ttl):
+    before = len(stocked.log)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=ttl)
+    assert len(stocked.log) == before
+
+
+def test_reserve_validation(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 0)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("MAIN", "NOPE", 1)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO 1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+    assert len(stocked.log.events("RESERVE")) == 0
+
+
+def test_reserve_insufficient_is_atomic(stocked):
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("NORTH", "NUT-M8", 6)])
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert len(stocked.log.events("RESERVE")) == 0
+
+
+def test_duplicate_lines_checked_by_sum_and_kept(stocked):
+    stocked.receive("MAIN", "OIL-5L", 5)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "OIL-5L", 3), ("MAIN", "OIL-5L", 3)])
+    assert exc.value.requested == 6
+    res = stocked.reserve("SO-2", [("MAIN", "OIL-5L", 2), ("MAIN", "OIL-5L", 3)])
+    assert [l.qty for l in res.lines] == [2, 3]
+    assert stocked.reserved("MAIN", "OIL-5L") == 5
+
+
+def test_duplicate_order_active_or_confirmed(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(DuplicateReservationError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert exc.value.order_id == "SO-1"
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_replaces_expired(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(15 * MIN)
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation("SO-1").lines == (ReservationLine("MAIN", "BOLT-M8", 2),)
+    assert stocked.reserved("MAIN", "BOLT-M8") == 2
+
+
+def test_reserve_replaces_cancelled(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("NORTH", "NUT-M8", 1)])
+    assert stocked.get_reservation("SO-1") == res
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+
+
+def test_expiry_boundary_and_no_log(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    size = len(stocked.log)
+    clock.advance(15 * MIN - timedelta(microseconds=1))
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+    clock.advance(timedelta(microseconds=1))
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == size
+
+
+def test_queries_unknown_sku(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.available("MAIN", "NOPE")
+
+
+def test_confirm_uses_whole_available(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10), ("NORTH", "NUT-M8", 1)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    tail = stocked.log.events()[-3:]
+    assert [e.kind for e in tail] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert tail[0].get("ref") == "SO-1" and tail[2].get("order") == "SO-1"
+
+
+def test_confirm_errors(stocked, clock):
+    with pytest.raises(ReservationNotFoundError):
+        stocked.confirm("X")
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(15 * MIN)
+    size = len(stocked.log)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+    assert len(stocked.log) == size
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+
+
+def test_confirm_physical_shortage_after_adjust(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    stocked.adjust("MAIN", "BOLT-M8", 3, "recount")
+    size = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 3
+    assert len(stocked.log) == size
+
+
+def test_confirm_duplicate_lines_by_sum(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 3)])
+    stocked.adjust("MAIN", "BOLT-M8", 5, "recount")
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.confirm("SO-1")
+    assert exc.value.requested == 6
+
+
+def test_cancel(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert stocked.log.events()[-1].kind == "RESERVE_CANCEL"
+    size = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == size
+
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(15 * MIN)
+    size = len(stocked.log)
+    assert stocked.cancel("SO-2").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == size
+
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-3")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-3")
+    with pytest.raises(ReservationNotFoundError):
+        stocked.cancel("X")
+
+
+def test_extend_counts_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(10 * MIN)
+    res = stocked.extend("SO-1", 10 * MIN)
+    assert res.expires_at == clock.now() + 10 * MIN
+    event = stocked.log.events()[-1]
+    assert event.kind == "RESERVE_EXTEND"
+    assert event.get("expires") == "2026-03-01T10:20:00Z"
+
+
+def test_extend_never_shortens(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    size = len(stocked.log)
+    clock.advance(MIN)
+    for ttl in (5 * MIN, 14 * MIN):  # now + ttl <= expires_at
+        same = stocked.extend("SO-1", ttl)
+        assert same.expires_at == res.expires_at
+    assert len(stocked.log) == size
+
+
+def test_extend_errors(stocked, clock):
+    with pytest.raises(ReservationNotFoundError):
+        stocked.extend("X", MIN)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+    stocked.cancel("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-1", MIN)
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(15 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-2", MIN)
+
+
+def test_issue_and_transfer_respect_reserve(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 5)
+    assert exc.value.available == 2
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("MAIN", "NORTH", "BOLT-M8", 3)
+    stocked.issue("MAIN", "BOLT-M8", 2)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 8
+
+
+def test_no_reservations_behaviour_unchanged(stocked):
+    stocked.issue("MAIN", "BOLT-M8", 10)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
