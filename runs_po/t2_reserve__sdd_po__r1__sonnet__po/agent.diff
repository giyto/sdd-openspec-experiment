@@ -58,3 +58,40 @@ class InsufficientStockError(WarehouseError):
 
 class EventFormatError(WarehouseError):
     """Строку журнала невозможно записать или разобрать."""
+
+
+class ReservationError(WarehouseError):
+    """Базовая ошибка резервов; всегда знает номер заказа."""
+
+    def __init__(self, order_id: str, message: str) -> None:
+        super().__init__(message)
+        self.order_id = order_id
+
+
+class ReservationNotFoundError(ReservationError):
+    """Резерва с таким номером заказа нет."""
+
+    def __init__(self, order_id: str) -> None:
+        super().__init__(order_id, f"reservation for order {order_id!r} not found")
+
+
+class ReservationExpiredError(ReservationError):
+    """Резерв истёк, операция невозможна."""
+
+    def __init__(self, order_id: str) -> None:
+        super().__init__(order_id, f"reservation for order {order_id!r} has expired")
+
+
+class ReservationStateError(ReservationError):
+    """Операция недопустима в текущем статусе резерва."""
+
+    def __init__(self, order_id: str, status: str) -> None:
+        super().__init__(order_id, f"reservation for order {order_id!r} is {status}")
+        self.status = status
+
+
+class DuplicateReservationError(ReservationError):
+    """На заказ уже есть действующий или подтверждённый резерв."""
+
+    def __init__(self, order_id: str) -> None:
+        super().__init__(order_id, f"order {order_id!r} already has a reservation")
