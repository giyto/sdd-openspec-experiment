+    # --- резервы ------------------------------------------------------------
+
+    def reserved(self, warehouse: str, sku: str) -> int:
+        """Сумма действующих (не истёкших) резервов по позиции."""
+        self._require_sku(sku)
+        return self._reserved(warehouse, sku, self._clock.now())
+
+    def available(self, warehouse: str, sku: str) -> int:
+        """Физический остаток минус резервы, но не менее 0."""
+        self._require_sku(sku)
+        return self._available(warehouse, sku, self._clock.now())
+
+    def get_reservation(self, order_id: str) -> Reservation:
+        now = self._clock.now()
+        return snapshot(self._find(order_id), now)
+
+    def reserve(
+        self,
+        order_id: str,
+        lines: Iterable[object],
+        ttl: timedelta = DEFAULT_RESERVATION_TTL,
+    ) -> Reservation:
+        """Резервирует товар по всем строкам атомарно. Физический остаток не меняется.
+
+        Истёкший или отменённый резерв на тот же ``order_id`` заменяется новым.
+        """
+        now = self._clock.now()
+        _validate_code(order_id, "order_id")
+        validate_ttl(ttl)
+        raw_lines = list(lines)
+        if not raw_lines:
+            raise ValidationError("reservation must have at least one line")
+        normalized: list[ReservationLine] = []
+        for raw in raw_lines:
+            warehouse, sku, qty = normalize_line(raw)
+            _validate_code(warehouse, "warehouse")
+            _validate_qty(qty)
+            _validate_code(sku, "SKU code")
+            self._require_sku(sku)
+            normalized.append(ReservationLine(warehouse, sku, qty))
+        existing = self._store.get_reservation(order_id)
+        if existing is not None and status_of(existing, now) in (
+            ReservationStatus.ACTIVE,
+            ReservationStatus.CONFIRMED,
+        ):
+            raise DuplicateReservationError(order_id)
+        for (warehouse, sku), total in aggregate(normalized).items():
+            available = self._available(warehouse, sku, now)
+            if total > available:
+                raise InsufficientStockError(warehouse, sku, total, available)
+        record = ReservationRecord(order_id, tuple(normalized), now, now + ttl)
+        self._store.put_reservation(record)
+        for line in record.lines:
+            self._log.append(
+                now,
+                "RESERVE",
+                order=order_id,
+                wh=line.warehouse,
+                sku=line.sku,
+                qty=line.qty,
+                expires=format_timestamp(record.expires_at),
+            )
+        logger.info("reserved order %s (%d lines)", order_id, len(record.lines))
+        return snapshot(record, now)
+
+    def confirm(self, order_id: str) -> Reservation:
+        """Превращает активный резерв в отгрузку (``ISSUE`` по каждой строке)."""
+        now = self._clock.now()
+        record = self._find(order_id)
+        self._require_active(record, now)
+        for (warehouse, sku), total in aggregate(record.lines).items():
+            on_hand = self._store.get_qty(warehouse, sku)
+            if total > on_hand:
+                raise InsufficientStockError(warehouse, sku, total, on_hand)
+        for line in record.lines:
+            current = self._store.get_qty(line.warehouse, line.sku)
+            self._store.set_qty(line.warehouse, line.sku, current - line.qty)
+            self._log.append(
+                now, "ISSUE", wh=line.warehouse, sku=line.sku, qty=line.qty, ref=order_id
+            )
+        record.confirmed = True
+        self._log.append(now, "RESERVE_CONFIRM", order=order_id)
+        logger.info("confirmed order %s", order_id)
+        return snapshot(record, now)
+
+    def cancel(self, order_id: str) -> Reservation:
+        """Отменяет активный резерв; для отменённого и истёкшего — без изменений."""
+        now = self._clock.now()
+        record = self._find(order_id)
+        status = status_of(record, now)
+        if status is ReservationStatus.CONFIRMED:
+            raise ReservationStateError(order_id, status.value)
+        if status is ReservationStatus.ACTIVE:
+            record.cancelled = True
+            self._log.append(now, "RESERVE_CANCEL", order=order_id)
+            logger.info("cancelled order %s", order_id)
+        return snapshot(record, now)
+
+    def extend(self, order_id: str, ttl: timedelta) -> Reservation:
+        """Продлевает активный резерв до ``now + ttl``; срок никогда не сокращается.
+
+        Если ``now + ttl`` не позже текущего срока, ничего не меняется и не пишется.
+        """
+        now = self._clock.now()
+        record = self._find(order_id)
+        validate_ttl(ttl)
+        self._require_active(record, now)
+        candidate = now + ttl
+        if candidate > record.expires_at:
+            record.expires_at = candidate
+            self._log.append(
+                now, "RESERVE_EXTEND", order=order_id, expires=format_timestamp(candidate)
+            )
+            logger.info("extended order %s", order_id)
+        return snapshot(record, now)
+
     # --- служебное ----------------------------------------------------------
 
+    def _find(self, order_id: str):
+        record = self._store.get_reservation(order_id)
+        if record is None:
+            raise ReservationNotFoundError(order_id)
+        return record
+
+    def _require_active(self, record: ReservationRecord, now: datetime) -> None:
+        status = status_of(record, now)
+        if status is ReservationStatus.EXPIRED:
+            raise ReservationExpiredError(record.order_id)
+        if status is not ReservationStatus.ACTIVE:
+            raise ReservationStateError(record.order_id, status.value)
+
+    def _reserved(self, warehouse: str, sku: str, now: datetime) -> int:
+        total = 0
+        for record in self._store.reservations():
+            if status_of(record, now) is ReservationStatus.ACTIVE:
+                total += sum(
+                    line.qty
+                    for line in record.lines
+                    if line.warehouse == warehouse and line.sku == sku
+                )
+        return total
+
+    def _available(self, warehouse: str, sku: str, now: datetime) -> int:
+        return max(0, self._store.get_qty(warehouse, sku) - self._reserved(warehouse, sku, now))
+
     def _require_sku(self, sku: str) -> None:
         if not self._store.has_sku(sku):
             raise UnknownSkuError(sku)
