+def test_dead_letter_entries(queue, clock):
+    a = queue.enqueue("t")
+    b = queue.enqueue("u")
+    for j in (a, b):
+        queue.mark_running(j.id)
+    clock.advance(5)
+    queue.mark_dead_lettered(b.id, "RuntimeError: boom")
+    queue.mark_dead_lettered(a.id, "RuntimeError: boom")
+    entries = queue.dead_letters()
+    assert [e.job_id for e in entries] == [b.id, a.id]
+    assert entries[0] == DeadLetterEntry(b.id, "u", 1, "RuntimeError: boom", clock.now())
+    entries.clear()
+    assert len(queue.dead_letters()) == 2
+    assert queue.metrics.get("jobs.dead_lettered") == 2
+    assert queue.metrics.get("jobs.failed") == 0
