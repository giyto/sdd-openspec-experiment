@@ -0,0 +1,79 @@
+"""Политика повторов: число попыток, экспоненциальная задержка, классификация ошибок."""
+
+from __future__ import annotations
+
+import math
+import random
+from collections.abc import Iterable
+from dataclasses import dataclass
+
+from .errors import ConfigError, PermanentJobError
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Параметры повторов задания.
+
+    :param max_attempts: максимум запусков задания (``1`` — без повторов, но в dead-letter).
+    :param base_delay: задержка перед первым повтором, секунды.
+    :param factor: множитель роста задержки.
+    :param max_delay: жёсткий потолок задержки, включая jitter.
+    :param jitter: доля разброса задержки, ``0..1``.
+    :param non_retryable: классы исключений, которые не повторяются.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not (isinstance(self.max_attempts, int) and not isinstance(self.max_attempts, bool)
+                and self.max_attempts >= 1):
+            raise ConfigError("max_attempts must be an integer >= 1")
+        if not self.base_delay >= 0:
+            raise ConfigError("base_delay must be >= 0")
+        if not self.factor >= 1:
+            raise ConfigError("factor must be >= 1")
+        if not self.max_delay >= self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+        try:
+            items = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for item in items:
+            if not (isinstance(item, type) and issubclass(item, BaseException)):
+                raise ConfigError(f"non_retryable item {item!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", items)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка перед следующей попыткой после падения попытки ``attempt`` (с 1)."""
+        if not attempt >= 1:
+            raise ConfigError("attempt must be >= 1")
+        if self.base_delay == 0:
+            delay = 0.0
+        elif self.factor == 1:
+            delay = float(self.base_delay)
+        else:
+            try:
+                delay = self.base_delay * float(self.factor) ** (attempt - 1)
+            except OverflowError:
+                delay = self.max_delay
+        delay = min(delay, self.max_delay)
+        if self.jitter > 0:
+            source = rng if rng is not None else random
+            delay = delay * source.uniform(1 - self.jitter, 1 + self.jitter)
+            if math.isnan(delay):
+                raise ConfigError("rng returned NaN")
+            delay = min(max(delay, 0.0), self.max_delay)
+        return delay
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """Можно ли повторять задание после ошибки ``exc``."""
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
