@@ -0,0 +1,423 @@
+import math
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobqError,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+
+from .conftest import START
+
+
+class FakeRng:
+    def __init__(self, value):
+        self.value = value
+        self.calls = []
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def boom(job):
+    raise RuntimeError("boom")
+
+
+# -- ошибки, модели, метрики ------------------------------------------------
+
+
+def test_permanent_error_is_jobq_error():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_new_statuses():
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert not JobStatus.DEAD_LETTERED.is_terminal
+
+
+def test_unknown_counter_is_zero(queue):
+    assert queue.metrics.get("jobs.retried") == 0
+    assert queue.metrics.get("jobs.dead_lettered") == 0
+    assert queue.metrics.get("jobs.requeued") == 0
+
+
+# -- RetryPolicy -----------------------------------------------------------
+
+
+def test_defaults():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter, p.non_retryable) == (
+        3, 1.0, 2.0, 60.0, 0.0, ())
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": True},
+        {"max_attempts": 1.5},
+        {"base_delay": -1},
+        {"base_delay": math.nan},
+        {"factor": 0.5},
+        {"factor": math.nan},
+        {"base_delay": 5, "max_delay": 4},
+        {"max_delay": math.nan},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"jitter": math.nan},
+        {"non_retryable": ["ValueError"]},
+        {"non_retryable": [ValueError("x")]},
+        {"non_retryable": [int]},
+        {"non_retryable": 5},
+    ],
+)
+def test_invalid_policy(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+def test_non_retryable_list_becomes_tuple():
+    assert RetryPolicy(non_retryable=[ValueError]).non_retryable == (ValueError,)
+
+
+def test_delay_growth_and_cap():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=60)
+    assert [p.delay_for(n) for n in (1, 4, 10)] == [1, 8, 60]
+
+
+def test_delay_huge_attempts():
+    p = RetryPolicy(factor=2.0, max_delay=60)
+    assert p.delay_for(5001) == 60
+    assert p.delay_for(10**6) == 60
+    assert RetryPolicy(factor=2, max_delay=60).delay_for(10**6) == 60
+
+
+def test_delay_zero_base_and_factor_one():
+    assert RetryPolicy(base_delay=0).delay_for(10000) == 0
+    p = RetryPolicy(base_delay=3, factor=1)
+    assert p.delay_for(1000) == 3
