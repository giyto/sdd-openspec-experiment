+def test_end_to_end_dead_letter_requeue_full_attempts(queue, registry, worker, clock):
+    fail = [True]
+
+    def handler(job):
+        if fail[0]:
+            raise RuntimeError("down")
+        return "ok"
+
+    registry.register("t", handler)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=2, base_delay=1))
+    job = queue.enqueue("t")
+    for _ in range(2):
+        worker.run_once()
+        clock.advance(10)
+    assert job.status is JobStatus.DEAD_LETTERED
+
+    queue.requeue_dead_letter(job.id)
+    assert job.attempts == 0
+    worker.run_once()  # первое падение после возврата — повтор, а не dead-letter
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    clock.advance(10)
+    fail[0] = False
+    worker.run_once()
+    assert job.status is JobStatus.SUCCEEDED
+    assert queue.metrics.get("jobs.retried") == 2
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    assert queue.metrics.get("jobs.requeued") == 1
+
