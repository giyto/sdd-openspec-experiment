+def test_end_to_end_retries_then_success(queue, registry, worker, clock):
+    calls = []
+
+    def flaky(job):
+        calls.append(1)
+        if len(calls) < 3:
+            raise RuntimeError("temp")
+        return "ok"
+
+    registry.register("t", flaky)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3, base_delay=10, factor=2))
+    job = queue.enqueue("t")
