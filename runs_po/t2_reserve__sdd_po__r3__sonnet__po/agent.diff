diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..bc6d499
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,411 @@
+from dataclasses import FrozenInstanceError
+from datetime import timedelta
+
+import pytest
+
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    Reservation,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationLine,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ReservationStatus,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+    parse_line,
+)
+from warehouse.reports import movement_summary
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 10)
+    inv.receive("B", "NUT-M8", 10)
+    return inv
+
+
+def kinds(inv):
+    return [e.kind for e in inv.log.events()]
+
+
+# --- модели, ошибки, константы ---------------------------------------------
+
+
+def test_models_frozen_and_statuses():
+    line = ReservationLine("A", "X", 1)
+    with pytest.raises(FrozenInstanceError):
+        line.qty = 2  # type: ignore[misc]
+    assert {s.value for s in ReservationStatus} == {"ACTIVE", "CONFIRMED", "CANCELLED", "EXPIRED"}
+
+
+def test_errors_hierarchy():
+    for err in (
+        ReservationNotFoundError("O"),
+        DuplicateReservationError("O"),
+        ReservationExpiredError("O"),
+        ReservationStateError("O", "CONFIRMED"),
+    ):
+        assert isinstance(err, ReservationError)
+        assert isinstance(err, WarehouseError)
+        assert err.order_id == "O"
+
+
+def test_default_ttl():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+# --- reserve ----------------------------------------------------------------
+
+
+def test_reserve_two_warehouses(stocked, clock):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3)])
+    assert isinstance(res, Reservation)
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.lines == (ReservationLine("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3))
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + 15 * MIN
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert kinds(stocked)[-2:] == ["RESERVE", "RESERVE"]
+
+
+def test_reserve_explicit_ttl_and_duplicates_lines(stocked):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)], ttl=5 * MIN)
+    assert res.expires_at - res.created_at == 5 * MIN
+    assert len(res.lines) == 2
+    assert stocked.reserved("A", "BOLT-M8") == 5
+    assert stocked.available("A", "BOLT-M8") == 5
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 5, "x"])
+def test_reserve_bad_ttl(stocked, ttl):
+    before = len(stocked.log)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=ttl)
+    assert len(stocked.log) == before
+
+
+@pytest.mark.parametrize(
+    "order_id, lines",
+    [
+        ("SO-1", []),
+        ("", [("A", "BOLT-M8", 1)]),
+        ("SO 1", [("A", "BOLT-M8", 1)]),
+        ("SO-1", [("A b", "BOLT-M8", 1)]),
+        ("SO-1", [("A", "BOLT=M8", 1)]),
+        ("SO-1", [("A", "BOLT-M8")]),
+    ],
+)
+def test_reserve_validation(stocked, order_id, lines):
+    with pytest.raises(ValidationError):
+        stocked.reserve(order_id, lines)
+
+
+@pytest.mark.parametrize("qty", [0, -1, True, 1.5, "1"])
+def test_reserve_bad_qty(stocked, qty):
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", qty)])
+
+
+def test_reserve_unknown_sku(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("A", "NOPE", 1)])
+
+
+def test_reserve_insufficient_by_sum(stocked):
+    stocked.issue("A", "BOLT-M8", 5)  # 5 left
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 3), ("A", "BOLT-M8", 3)])
+    assert (exc.value.requested, exc.value.available) == (6, 5)
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert len(stocked.log) == before
+
+
+def test_reserve_insufficient_second_line_leaves_no_trace(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1), ("B", "NUT-M8", 11)])
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_foreign_reservation_not_available(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-2", [("A", "BOLT-M8", 3)])
+    assert exc.value.available == 2
+
+
+# --- повторный order_id -----------------------------------------------------
+
+
+def test_duplicate_active_rejected_without_changes(stocked):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    before = len(stocked.log)
+    with pytest.raises(DuplicateReservationError) as exc:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert exc.value.order_id == "SO-1"
+    assert stocked.get_reservation("SO-1") == first
+    assert len(stocked.log) == before
+
+
+def test_duplicate_confirmed_rejected(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    stocked.confirm("SO-1")
+    before = len(stocked.log)
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert stocked.on_hand("A", "BOLT-M8") == 8
+    assert len(stocked.log) == before
+
+
+def test_reserve_replaces_expired(stocked, clock):
+    old = stocked.reserve("SO-1", [("A", "BOLT-M8", 9)])
+    clock.advance(15 * MIN)
+    new = stocked.reserve("SO-1", [("B", "NUT-M8", 4)])
+    assert new.status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation("SO-1") == new
+    assert new.lines == (ReservationLine("B", "NUT-M8", 4),)
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert old.status is ReservationStatus.ACTIVE  # прежний снимок не меняется
+
+
+def test_reserve_replaces_cancelled(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 9)])
+    stocked.cancel("SO-1")
+    new = stocked.reserve("SO-1", [("A", "BOLT-M8", 10)])
+    assert new.status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation("SO-1").lines == (ReservationLine("A", "BOLT-M8", 10),)
+    assert stocked.reserved("A", "BOLT-M8") == 10
+
+
+# --- запросы, истечение -----------------------------------------------------
+
+
+def test_reserved_available_unknown_sku(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("A", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.available("A", "NOPE")
+
+
+def test_available_never_negative_after_adjust(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    stocked.adjust("A", "BOLT-M8", 3, "recount")
+    assert stocked.available("A", "BOLT-M8") == 0
+
+
+def test_expiry_boundary(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    before = len(stocked.log)
+    clock.advance(15 * MIN - timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    clock.advance(timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert stocked.available("A", "BOLT-M8") == 10
+    assert len(stocked.log) == before
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 10)])
+
+
+def test_final_statuses_survive_time(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation("SO-2").status is ReservationStatus.CANCELLED
+
+
+# --- confirm ----------------------------------------------------------------
+
+
+def test_confirm_with_zero_available(stocked):
+    stocked.issue("A", "BOLT-M8", 5)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 5)])
+    assert stocked.available("A", "BOLT-M8") == 0
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("A", "BOLT-M8") == 0
+
+
+def test_confirm_duplicate_lines_and_events(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 3), ("B", "NUT-M8", 1), ("A", "BOLT-M8", 2)])
+    stocked.confirm("SO-1")
+    assert stocked.on_hand("A", "BOLT-M8") == 5
+    tail = stocked.log.events()[-4:]
+    assert [e.kind for e in tail] == ["ISSUE", "ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert [e.get("qty") for e in tail[:3]] == ["3", "1", "2"]
+    assert all(e.get("ref") == "SO-1" for e in tail[:3])
+    assert tail[3].get("order") == "SO-1"
+
+
+def test_confirm_errors(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)])
+    clock.advance(15 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+    assert stocked.on_hand("A", "BOLT-M8") == 9
+
+
+def test_confirm_insufficient_physical(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 5), ("B", "NUT-M8", 1)])
+    stocked.adjust("A", "BOLT-M8", 2, "recount")
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.confirm("SO-1")
+    assert (exc.value.requested, exc.value.available) == (5, 2)
+    assert stocked.on_hand("B", "NUT-M8") == 10
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert len(stocked.log) == before
+
+
+# --- cancel -----------------------------------------------------------------
+
+
+def test_cancel_idempotent_and_frees(stocked):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    res = stocked.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert first.status is ReservationStatus.ACTIVE
+    assert stocked.available("A", "BOLT-M8") == 10
+    count = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == count
+    assert kinds(stocked).count("RESERVE_CANCEL") == 1
+
+
+def test_cancel_confirmed_and_expired(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-1")
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    clock.advance(15 * MIN)
+    count = len(stocked.log)
+    assert stocked.cancel("SO-2").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == count
+
+
+# --- extend -----------------------------------------------------------------
+
+
+def test_extend_counts_from_now(stocked, clock):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])  # до T0+15
+    clock.advance(10 * MIN)
+    ext = stocked.extend("SO-1", 10 * MIN)  # now+10 = T0+20 > T0+15
+    assert ext.expires_at == clock.now() + 10 * MIN
+    assert ext.expires_at == res.expires_at + 5 * MIN
+    assert ext.lines == res.lines and ext.created_at == res.created_at
+    event = stocked.log.events()[-1]
+    assert event.kind == "RESERVE_EXTEND"
+    assert event.get("order") == "SO-1"
+    assert event.get("expires") == "2026-03-01T10:20:00Z"
+    assert kinds(stocked).count("RESERVE_EXTEND") == 1
+
+
+@pytest.mark.parametrize("ttl", [5 * MIN, 15 * MIN])  # короче и ровно до текущего срока
+def test_extend_never_shortens(stocked, ttl):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    count = len(stocked.log)
+    assert stocked.extend("SO-1", ttl) == res
+    assert stocked.get_reservation("SO-1").expires_at == res.expires_at
+    assert len(stocked.log) == count
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+    with pytest.raises(ReservationNotFoundError):
+        stocked.extend("NOPE", MIN)
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2", MIN)
+    clock.advance(15 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-1", MIN)
+
+
+# --- поиск ------------------------------------------------------------------
+
+
+def test_not_found_everywhere(stocked):
+    for call in (
+        lambda: stocked.get_reservation("NOPE"),
+        lambda: stocked.confirm("NOPE"),
+        lambda: stocked.cancel("NOPE"),
+        lambda: stocked.extend("NOPE", MIN),
+    ):
+        with pytest.raises(ReservationNotFoundError) as exc:
+            call()
+        assert exc.value.order_id == "NOPE"
+    with pytest.raises(ValidationError):
+        stocked.get_reservation("bad id")
+
+
+# --- issue / transfer -------------------------------------------------------
+
+
+def test_issue_respects_reservations(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("A", "BOLT-M8", 3)
+    assert exc.value.available == 2
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.issue("A", "BOLT-M8", 2) == 8
+    clock.advance(15 * MIN)
+    assert stocked.issue("A", "BOLT-M8", 8) == 0
+
+
+def test_transfer_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("A", "B", "BOLT-M8", 3)
+    stocked.transfer("A", "B", "BOLT-M8", 2)
+    assert stocked.on_hand("B", "BOLT-M8") == 2
+
+
+# --- журнал -----------------------------------------------------------------
+
+
+def test_event_formats(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 3)])
+    reserves = stocked.log.events("RESERVE")
+    assert [(e.get("wh"), e.get("sku"), e.get("qty")) for e in reserves] == [
+        ("A", "BOLT-M8", "2"),
+        ("B", "NUT-M8", "3"),
+    ]
+    for e in reserves:
+        assert e.get("order") == "SO-1"
+        assert e.get("expires") == "2026-03-01T10:15:00Z"
+    for line in stocked.log.lines():
+        parse_line(line)
+
+
+def test_movement_summary_not_distorted(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    summary = movement_summary(stocked.log)
+    bolt = summary["BOLT-M8"]
+    assert (bolt.received, bolt.issued, bolt.adjusted) == (10, 0, 0)
+    stocked.confirm("SO-1")
+    assert movement_summary(stocked.log)["BOLT-M8"].issued == 2
