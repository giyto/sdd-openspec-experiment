+++ b/warehouse/reservations.py
@@ -0,0 +1,61 @@
+"""Внутренние части резервов: запись, нормализация строк, вычисление статуса."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from typing import Iterable
+
+from .errors import ValidationError
+from .models import Reservation, ReservationLine, ReservationStatus
+
+DEFAULT_RESERVATION_TTL = timedelta(minutes=15)
+
+
+@dataclass(frozen=True)
+class ReservationRecord:
+    """Хранимая запись; ``status`` — сохранённый (``EXPIRED`` не хранится)."""
+
+    order_id: str
+    lines: tuple[ReservationLine, ...]
+    status: ReservationStatus
+    created_at: datetime
+    expires_at: datetime
+
+
+def normalize_lines(lines: Iterable[object]) -> tuple[ReservationLine, ...]:
+    """Приводит строки к ``ReservationLine``; форму проверяет, коды и qty — нет."""
+    result: list[ReservationLine] = []
+    for item in lines:
+        if isinstance(item, ReservationLine):
+            result.append(item)
+        elif isinstance(item, tuple) and len(item) == 3:
+            result.append(ReservationLine(*item))
+        else:
+            raise ValidationError(f"reservation line must be (warehouse, sku, qty), got {item!r}")
+    return tuple(result)
+
+
+def effective_status(record: ReservationRecord, now: datetime) -> ReservationStatus:
+    if record.status is ReservationStatus.ACTIVE and now >= record.expires_at:
+        return ReservationStatus.EXPIRED
+    return record.status
+
+
+def snapshot(record: ReservationRecord, now: datetime) -> Reservation:
+    return Reservation(
+        order_id=record.order_id,
+        lines=record.lines,
+        status=effective_status(record, now),
+        created_at=record.created_at,
+        expires_at=record.expires_at,
+    )
+
+
+def totals(lines: Iterable[ReservationLine]) -> dict[tuple[str, str], int]:
+    """Суммы по позициям ``(warehouse, sku)`` в порядке первого появления."""
+    result: dict[tuple[str, str], int] = {}
+    for line in lines:
+        key = (line.warehouse, line.sku)
+        result[key] = result.get(key, 0) + line.qty
+    return result
