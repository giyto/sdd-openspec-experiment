+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementRowError, UnknownFormatError
+from ledger.importer import detect_format, import_statement, normalize_description
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1 200,50;Магазин Лента\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+    "\n;;;\n   \n"
+)
+SPLIT = "Дата;Описание;Приход;Расход\n01.03.2026;Кафе;;350,00\n02.03.2026;Зарплата;1000,00;\n"
+
+
+def test_sfera(write_csv, clock):
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA), store, clock=clock)
+    assert (res.format, res.encoding, res.added, res.duplicates, res.errors) == ("sfera", "utf-8", 2, 0, [])
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+
+
+def test_split_bom_and_cp1251(write_csv):
+    assert detect_format(write_csv(SPLIT, encoding="utf-8-sig")) == "sfera_split"
+    store = MemoryStore()
+    res = import_statement(write_csv(SPLIT, encoding="cp1251"), store)
+    assert res.encoding == "cp1251" and store.all()[0].amount == Decimal("-350.00")
+
+
+def test_reimport_dedup(write_csv):
+    store = MemoryStore()
+    p = write_csv(SFERA)
+    import_statement(p, store)
+    res = import_statement(p, store)
+    assert (res.added, res.duplicates) == (0, 2) and len(store.all()) == 2
+    assert normalize_description(" Ёж  КАФЕ ") == "еж кафе"
+
+
+def test_row_errors_and_strict(write_csv, tmp_path):
+    text = SPLIT + "03.03.2026;x;1,00;2,00\n04.03.2026;y;-5,00;\n"
+    store = MemoryStore()
+    res = import_statement(write_csv(text), store)
+    assert [e.line_no for e in res.errors] == [4, 5] and res.added == 2
+    js = JsonFileStore(tmp_path / "s.json")
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(text), js, strict=True)
+    assert info.value.line_no == 4 and js.all() == [] and not (tmp_path / "s.json").exists()
+
+
+def test_unknown_format(write_csv):
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(""), MemoryStore())
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="nova")
+
+
+def test_split_zero_in_unused_column(write_csv):
+    text = (
+        "Дата;Описание;Приход;Расход\n"
+        "01.03.2026;Кафе;0,00;350,00\n"
+        "02.03.2026;Зарплата;1000,00;0,00\n"
+        "03.03.2026;Пусто;0,00;0,00\n"
+        "04.03.2026;Обе;5,00;6,00\n"
+    )
+    store = MemoryStore()
+    res = import_statement(write_csv(text), store)
+    assert [t.amount for t in store.all()] == [Decimal("-350.00"), Decimal("1000.00")]
+    assert [e.line_no for e in res.errors] == [4, 5]
