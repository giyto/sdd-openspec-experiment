+def import_statement(
+    path: str | os.PathLike[str],
+    store: MemoryStore,
+    *,
+    fmt: str | None = None,
+    strict: bool = False,
+    categorizer: Categorizer | None = None,
+    clock: Clock | None = None,
+) -> ImportResult:
+    """Импортирует выписку в store: определяет формат, пропускает дубли, собирает ошибки."""
+    clock = clock or SystemClock()
+    text, encoding = _decode(path)
+    fmt, index = _read_header(text, fmt)
+    imported_at = clock.now()
+    delimiter = _FORMATS[fmt][0]
+
+    existing = Counter(
+        (t.date, t.amount, normalize_description(t.description)) for t in store.all()
+    )
+    batch: list[Transaction] = []
+    errors: list[RowError] = []
+    duplicates = 0
+
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    next(reader)  # заголовок
+    while True:
+        line_no = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as exc:
+            if strict:
+                raise StatementRowError(str(exc), line_no=line_no) from exc
+            errors.append(RowError(line_no, str(exc)))
+            continue
+        if all(not f.strip() for f in row):
+            continue
+        try:
+            date, amount, description = _parse_record(fmt, index, row)
+            tx = Transaction(
+                date=date, amount=amount, description=description, imported_at=imported_at
+            )
+        except (ValueError, ValidationError) as exc:
+            if strict:
+                raise StatementRowError(str(exc), line_no=line_no) from exc
+            errors.append(RowError(line_no, str(exc)))
+            continue
+        key = (tx.date, tx.amount, normalize_description(tx.description))
+        if existing[key] > 0:
+            existing[key] -= 1
+            duplicates += 1
+            continue
+        if categorizer is not None:
+            category = categorizer.categorize(tx)
+            if category is not None:
+                tx = replace(tx, category=category)
+        batch.append(tx)
+
+    if batch:
+        store.add_many(batch)
+    logger.info(
+        "imported %d transactions from %s (%d duplicates, %d errors)",
+        len(batch), path, duplicates, len(errors),
+    )
+    return ImportResult(fmt, encoding, len(batch), duplicates, errors)
 
 
