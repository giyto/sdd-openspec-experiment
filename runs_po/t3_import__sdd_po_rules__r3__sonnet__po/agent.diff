+        ("Дата;Сумма;Остаток;Описание;Приход;Расход\n", "sfera"),
+        ("Balance,Description,Amount,x,DATE\n", "nova"),
+    ],
+)
+def test_detect(write_csv, text, fmt):
+    assert detect_format(write_csv(text)) == fmt
+
+
