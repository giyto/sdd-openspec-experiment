+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = "Дата;Сумма;Описание\n01.03.2026;-1 200,50;Магазин Лента\n02.03.2026;+85 000,00;Зарплата\n"
+SPLIT = "Дата;Описание;Приход;Расход\n01.03.2026;Магазин Лента;;1 200,50\n"
+NOVA = "date,amount,description\n2026-03-01,-350.00,Кофейня\n"
+
+
+def test_exceptions_hierarchy():
+    assert issubclass(UnknownFormatError, StatementError)
+    assert StatementRowError("x", line_no=4).line_no == 4
+    with pytest.raises(TypeError):
+        StatementRowError("x")
+
+
+def test_summary_sfera(write_csv, clock):
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA), store, clock=clock)
+    assert res == ImportResult("sfera", "utf-8", 2, 0, [])
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+    assert all(t.imported_at == clock.now() for t in store.all())
+
+
+@pytest.mark.parametrize("enc,bom", [("utf-8", ""), ("utf-8", "﻿"), ("cp1251", "")])
+def test_encodings(write_csv, enc, bom):
+    path = write_csv(bom + SFERA, encoding=enc)
+    res = import_statement(path, MemoryStore())
+    assert res.encoding == enc and res.added == 2
+
+
+def test_undecodable(tmp_path):
+    p = tmp_path / "bad.csv"
+    p.write_bytes(b"Date;\x98\xff\n")  # 0x98 не определён в cp1251
+    with pytest.raises(UnknownFormatError) as info:
+        detect_format(p)
+    assert info.value.line_no is None
