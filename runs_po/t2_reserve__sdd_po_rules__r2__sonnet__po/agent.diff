new file mode 100644
index 0000000..c5900c8
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,352 @@
+import dataclasses
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    Reservation,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationLine,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ReservationStatus,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+    parse_line,
+)
+from warehouse.reservations import aggregate, normalize_lines, validate_ttl
+
+T0 = datetime(2026, 3, 1, 10, 0, 0, tzinfo=timezone.utc)
+
+M = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("EAST", "BOLT-M8", 10)
+    return inv
+
+
+# --- модели, ошибки, помощники ---------------------------------------------
+
+
+def test_models():
+    assert [s.value for s in ReservationStatus] == ["active", "expired", "confirmed", "cancelled"]
+    assert issubclass(ReservationStatus, str)
+    line = ReservationLine("MAIN", "BOLT-M8", 1)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        line.qty = 2
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+@pytest.mark.parametrize(
+    "cls",
+    [ReservationNotFoundError, ReservationExpiredError, ReservationStateError, DuplicateReservationError],
+)
+def test_errors_carry_order_id(cls):
+    err = cls("SO-9")
+    assert err.order_id == "SO-9"
+    assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+
+
+def test_normalize_and_validate():
+    got = normalize_lines([("MAIN", "A", 1), ReservationLine("MAIN", "A", 2)])
+    assert got == (ReservationLine("MAIN", "A", 1), ReservationLine("MAIN", "A", 2))
+    assert aggregate(got) == {("MAIN", "A"): 3}
+    with pytest.raises(InvalidQuantityError):
+        normalize_lines([("MAIN", "A", 0)])
+    with pytest.raises(ValidationError):
+        normalize_lines([("MAIN", "A")])
+    with pytest.raises(ValidationError):
+        validate_ttl(timedelta(0))
+    with pytest.raises(ValidationError):
+        validate_ttl(15)
+
+
+# --- reserve ---------------------------------------------------------------
+
+
+def test_reserve_default_ttl_and_multi_warehouse(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("EAST", "BOLT-M8", 3)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0 and res.expires_at == T0 + 15 * M
+    assert [l.qty for l in res.lines] == [2, 3]
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 2
+    assert stocked.reserved("EAST", "BOLT-M8") == 3
+    assert stocked.available("MAIN", "BOLT-M8") == 8
+
+
+def test_reserve_duplicate_lines(stocked):
+    stocked.adjust("MAIN", "BOLT-M8", 5, "count")
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 3)])
+    assert (exc.value.requested, exc.value.available) == (6, 5)
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 3)])
+    assert len(res.lines) == 2 and stocked.reserved("MAIN", "BOLT-M8") == 5
+
+
+def test_reserve_failure_leaves_no_trace(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("EAST", "BOLT-M8", 99)])
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+@pytest.mark.parametrize(
+    "order, lines, ttl",
+    [
+        ("SO-1", [], None),
+        ("SO-1", [("MAIN", "BOLT-M8", 1)], timedelta(0)),
+        ("SO-1", [("MAIN", "BOLT-M8", 1)], -M),
+        ("SO-1", [("MAIN", "BOLT-M8", 1)], 5),
+        ("SO 1", [("MAIN", "BOLT-M8", 1)], None),
+    ],
+)
+def test_reserve_validation(stocked, order, lines, ttl):
+    with pytest.raises(ValidationError):
+        stocked.reserve(order, lines, ttl)
+
+
+def test_reserve_unknown_sku_and_qty(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("MAIN", "NOPE", 1)])
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 0)])
+
+
+def test_reserve_only_from_available(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 3)])
+    assert exc.value.available == 2
+
+
+@pytest.mark.parametrize("final", ["active", "confirmed"])
+def test_duplicate_order_active_or_confirmed(stocked, final):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    if final == "confirmed":
+        stocked.confirm("SO-1")
+    before = len(stocked.log)
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert len(stocked.log) == before
+
+
+@pytest.mark.parametrize("how", ["expired", "cancelled"])
+def test_reserve_replaces_expired_or_cancelled(stocked, clock, how):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("EAST", "BOLT-M8", 4)])
+    if how == "expired":
+        clock.advance(15 * M)
+    else:
+        stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3)], ttl=10 * M)
+    assert res.status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation("SO-1") == res
+    assert res.lines == (ReservationLine("MAIN", "BOLT-M8", 3),)
+    assert stocked.reserved("MAIN", "BOLT-M8") == 3
+    assert stocked.reserved("EAST", "BOLT-M8") == 0
+    assert len([r for r in stocked.store.reservations() if r.order_id == "SO-1"]) == 1
+    # после новой отмены/истечения замена тоже возможна
+    clock.advance(10 * M)
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+
+
+# --- запросы и истечение ---------------------------------------------------
+
+
+def test_expiry_boundary_and_no_log(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    events = len(stocked.log)
+    clock.advance(15 * M - timedelta(seconds=1))
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+    clock.advance(timedelta(seconds=1))
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == events
+
+
+def test_available_never_negative_and_unknown_sku(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.adjust("MAIN", "BOLT-M8", 3, "count")
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    assert stocked.available("MAIN", "NUT-M8") == 0
+    with pytest.raises(UnknownSkuError):
+        stocked.available("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("MAIN", "NOPE")
+
+
+def test_snapshot_is_not_updated(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.cancel("SO-1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert isinstance(res, Reservation)
+
+
+def test_unknown_order_everywhere(inv):
+    for call in (inv.confirm, inv.cancel, inv.get_reservation, lambda o: inv.extend(o, M)):
+        with pytest.raises(ReservationNotFoundError) as exc:
+            call("SO-404")
+        assert exc.value.order_id == "SO-404"
+
+
+# --- confirm ---------------------------------------------------------------
+
+
+def test_confirm_with_zero_available(stocked):
+    stocked.adjust("MAIN", "BOLT-M8", 2, "count")
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    kinds = [e.kind for e in stocked.log][-2:]
+    assert kinds == ["ISSUE", "RESERVE_CONFIRM"]
+    assert stocked.log.events("ISSUE")[-1].get("ref") == "SO-1"
+
+
+def test_confirm_atomic_on_shortage(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 3), ("EAST", "BOLT-M8", 1)])
+    stocked.adjust("MAIN", "BOLT-M8", 4, "count")
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert len(stocked.log) == before
+    assert stocked.on_hand("EAST", "BOLT-M8") == 10
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+
+
+def test_confirm_statuses(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(15 * M)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+
+
+# --- cancel ----------------------------------------------------------------
+
+
+def test_cancel(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.log.events()[-1].kind == "RESERVE_CANCEL"
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == n
+
+
+def test_cancel_confirmed_and_expired(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=1 * M)
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-1")
+    clock.advance(1 * M)
+    n = len(stocked.log)
+    assert stocked.cancel("SO-2").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == n
+
+
+# --- extend ----------------------------------------------------------------
+
+
+def test_extend_counts_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(5 * M)
+    res = stocked.extend("SO-1", 20 * M)
+    assert res.expires_at == T0 + 25 * M and res.status is ReservationStatus.ACTIVE
+    last = stocked.log.events()[-1]
+    assert last.kind == "RESERVE_EXTEND" and last.get("expires") == "2026-03-01T10:25:00Z"
+
+
+def test_extend_never_shortens(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(5 * M)
+    n = len(stocked.log)
+    assert stocked.extend("SO-1", 10 * M).expires_at == T0 + 15 * M
+    assert len(stocked.log) == n
+    assert stocked.extend("SO-1", 5 * M).expires_at == T0 + 15 * M  # ровно равный срок
+    assert len(stocked.log) == n
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2", M)
+    clock.advance(15 * M)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-1", M)
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+
+
+# --- issue / transfer ------------------------------------------------------
+
+
+def test_issue_respects_reservations(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 3)
+    assert exc.value.available == 2
+    assert stocked.issue("MAIN", "BOLT-M8", 2) == 8
+    clock.advance(15 * M)
+    assert stocked.issue("MAIN", "BOLT-M8", 8) == 0
+
+
+def test_transfer_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("MAIN", "NORTH", "BOLT-M8", 3)
+    stocked.transfer("MAIN", "NORTH", "BOLT-M8", 2)
+
+
+def test_without_reservations_error_unchanged(inv):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    with pytest.raises(InsufficientStockError) as exc:
+        inv.issue("MAIN", "BOLT-M8", 5)
+    assert (exc.value.requested, exc.value.available) == (5, 3)
+
+
+# --- журнал ----------------------------------------------------------------
+
+
+def test_log_format(stocked):
+    base = len(stocked.log)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("EAST", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    lines = stocked.log.lines()[base:]
+    assert lines[0].endswith(
+        "RESERVE expires=2026-03-01T10:15:00Z order=SO-1 qty=2 sku=BOLT-M8 wh=MAIN"
+    )
+    assert lines[4].endswith("RESERVE_CONFIRM order=SO-1")
+    assert lines[-1].endswith("RESERVE_CANCEL order=SO-2")
+    for line in lines:
+        assert parse_line(line).format() == line
