+    # --- резервы ------------------------------------------------------------
+
+    def reserve(
+        self,
+        order_id: str,
+        lines: Iterable[object],
+        ttl: timedelta | None = None,
+    ) -> Reservation:
+        """Резервирует товар под заказ сразу по всем строкам.
+
+        Прежний истёкший или отменённый резерв того же заказа полностью заменяется.
+        """
+        validate_code(order_id, "order_id")
+        normalized = normalize_lines(lines)
+        for line in normalized:
+            self._require_sku(line.sku)
+        if not normalized:
