diff --git a/warehouse/reservations.py b/warehouse/reservations.py
new file mode 100644
index 0000000..09e52a1
--- /dev/null
+++ b/warehouse/reservations.py
@@ -0,0 +1,67 @@
+"""Помощники резервирования: константы, нормализация и проверки без зависимости от Inventory."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from typing import Iterable
+
+from .errors import InvalidQuantityError, ValidationError
+from .models import ReservationLine, ReservationStatus
+
+DEFAULT_RESERVATION_TTL = timedelta(minutes=15)
+
+
+@dataclass
+class ReservationRecord:
+    """Изменяемая внутренняя запись; наружу отдаётся только снимок :class:`Reservation`."""
+
+    order_id: str
+    lines: tuple[ReservationLine, ...]
+    created_at: datetime
+    expires_at: datetime
+    status: ReservationStatus  # ACTIVE, CONFIRMED или CANCELLED
+
+
+def validate_code(value: object, what: str) -> None:
+    if not isinstance(value, str) or not value or any(ch.isspace() for ch in value) or "=" in value:
+        raise ValidationError(f"{what} must be a non-empty string without spaces, got {value!r}")
+
+
+def validate_ttl(ttl: object) -> timedelta:
+    if not isinstance(ttl, timedelta) or ttl <= timedelta(0):
+        raise ValidationError(f"ttl must be a positive timedelta, got {ttl!r}")
+    return ttl
+
+
+def normalize_lines(lines: Iterable[object]) -> tuple[ReservationLine, ...]:
+    """Приводит строки к ``ReservationLine`` с проверкой кодов и количеств; порядок сохраняется."""
+    if isinstance(lines, (str, bytes)):
+        raise ValidationError("lines must be an iterable of (warehouse, sku, qty)")
+    try:
+        items = list(lines)
+    except TypeError as exc:
+        raise ValidationError("lines must be an iterable of (warehouse, sku, qty)") from exc
+    result: list[ReservationLine] = []
+    for item in items:
+        if isinstance(item, ReservationLine):
+            line = item
+        elif isinstance(item, (tuple, list)) and len(item) == 3:
+            line = ReservationLine(item[0], item[1], item[2])
+        else:
+            raise ValidationError(f"reservation line must be (warehouse, sku, qty), got {item!r}")
+        validate_code(line.warehouse, "warehouse")
+        validate_code(line.sku, "SKU code")
+        if isinstance(line.qty, bool) or not isinstance(line.qty, int) or line.qty <= 0:
+            raise InvalidQuantityError(line.qty)
+        result.append(ReservationLine(line.warehouse, line.sku, line.qty))
+    return tuple(result)
+
+
+def aggregate(lines: Iterable[ReservationLine]) -> dict[tuple[str, str], int]:
+    """Суммарное требование по позициям в порядке первого появления."""
+    totals: dict[tuple[str, str], int] = {}
+    for line in lines:
+        key = (line.warehouse, line.sku)
+        totals[key] = totals.get(key, 0) + line.qty
+    return totals
