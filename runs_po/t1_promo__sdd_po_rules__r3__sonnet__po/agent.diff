new file mode 100644
index 0000000..b208068
--- /dev/null
+++ b/tests/test_pricing_promo.py
@@ -0,0 +1,110 @@
+from decimal import Decimal
+
+import pytest
+
+from shop import (
+    Cart,
+    Category,
+    DiscountKind,
+    Product,
+    PromoCode,
+    PromoConditionsError,
+    calculate_total,
+)
+
+D = Decimal
+
+
+def promo(kind=DiscountKind.PERCENT, value="10", **kw):
+    return PromoCode(code="P", kind=kind, value=D(value), **kw)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def p(sku, price, category=Category.ELECTRONICS):
+    return Product(sku, sku, D(price), category)
+
+
+def test_no_promo_zero_discount(products):
+    total = calculate_total(cart_of((products["book"], 1)))
+    assert total.discount == D("0.00")
+    assert total.lines[0].discount == D("0.00")
+    assert total.total == total.subtotal + total.shipping + total.tax
+
+
+def test_percent_rounding():
+    total = calculate_total(cart_of((p("A-1", "10.05"), 1)), promo=promo())
+    assert total.discount == D("1.01")
+
+
+def test_fixed_exceeds_sum():
+    total = calculate_total(
+        cart_of((p("A-1", "500.00"), 1)), promo=promo(DiscountKind.FIXED, "800")
+    )
+    assert total.discount == D("500.00")
+    assert total.lines[0].tax == D("0.00")
+
+
+def test_largest_remainder():
+    cart = cart_of((p("A-1", "10.00"), 1), (p("B-1", "10.00"), 1), (p("C-1", "10.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "10"))
+    assert [line.discount for line in total.lines] == [D("3.34"), D("3.33"), D("3.33")]
+    assert sum(line.discount for line in total.lines) == total.discount == D("10.00")
+
+
+def test_lines_sum_equals_total_uneven():
+    cart = cart_of((p("A-1", "0.07"), 3), (p("B-1", "13.31"), 1), (p("C-1", "99.99"), 7))
+    total = calculate_total(cart, promo=promo(DiscountKind.PERCENT, "33.33"))
+    assert sum(line.discount for line in total.lines) == total.discount
+    for line in total.lines:
+        assert D("0") <= line.discount <= line.amount
+
+
+def test_tax_after_discount():
+    cart = cart_of((p("A-1", "1000.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "100"))
+    assert total.lines[0].tax == D("180.00")
+    assert total.total == D("1000.00") - D("100.00") + D("180.00") + total.shipping
+
+
+def test_gift_card_and_excluded(products):
+    cart = cart_of((products["book"], 1), (products["gift"], 1), (products["shirt"], 1))
+    total = calculate_total(cart, promo=promo(excluded_categories=frozenset({Category.CLOTHING})))
+    by_sku = {line.sku: line.discount for line in total.lines}
+    assert by_sku == {"BOOK-1": D("45.00"), "GIFT-1000": D("0.00"), "SHIRT-1": D("0.00")}
+
+
+def test_only_gift_cards(products):
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=promo())
+
+
+def test_minimum(products):
+    cart = cart_of((p("A-1", "999.99"), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(min_order_amount=D("1000.00")))
+    cart = cart_of((p("A-1", "1000.00"), 1))
+    assert calculate_total(cart, promo=promo(min_order_amount=D("1000.00"))).discount == D("100.00")
+
+
+def test_shipping_threshold_after_discount():
+    code = promo(DiscountKind.FIXED, "500")
+    below = calculate_total(cart_of((p("A-1", "3100.00"), 1)), promo=code)
+    assert below.discount == D("500.00")
+    assert below.shipping == D("299.00")  # 2600.00 after discount, below the threshold
+
+    above = calculate_total(cart_of((p("A-1", "3600.00"), 1)), promo=code)
+    assert above.shipping == D("0.00")  # exactly 3100.00 after discount
+
+    exact = calculate_total(cart_of((p("A-1", "3500.00"), 1)), promo=code)
+    assert exact.shipping == D("0.00")  # exactly the threshold
+
+
+def test_shipping_not_reduced():
+    total = calculate_total(cart_of((p("A-1", "1000.00"), 1)), promo=promo())
+    assert total.shipping == D("299.00")
