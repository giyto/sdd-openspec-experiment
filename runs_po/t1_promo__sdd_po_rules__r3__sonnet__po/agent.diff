diff --git a/shop/promo.py b/shop/promo.py
new file mode 100644
index 0000000..cb34988
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,138 @@
+"""Promo codes and the registry that validates and counts their usage.
+
+The registry owns existence, validity period and usage limit checks; order
+conditions (minimum amount, participating lines) are checked by pricing.
+The validity period is a half-open interval ``[starts_at, expires_at)``.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _is_aware(at: datetime) -> bool:
+    return at.tzinfo is not None and at.utcoffset() is not None
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError("promo kind must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError(f"value of {self.code} must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError(f"percent of {self.code} must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"fixed discount of {self.code} must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError(
+                    f"fixed discount of {self.code} has more than two fractional digits"
+                )
+        if not isinstance(self.min_order_amount, Decimal) or self.min_order_amount < 0:
+            raise ValidationError(f"min order amount of {self.code} must be a Decimal >= 0")
+        for at in (self.starts_at, self.expires_at):
+            if at is not None and (not isinstance(at, datetime) or not _is_aware(at)):
+                raise ValidationError(f"validity bounds of {self.code} must be aware datetimes")
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError(f"{self.code}: starts_at must be earlier than expires_at")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool)
+            or not isinstance(self.max_uses, int)
+            or self.max_uses < 1
+        ):
+            raise ValidationError(f"max_uses of {self.code} must be an integer >= 1")
+        object.__setattr__(self, "excluded_categories", frozenset(self.excluded_categories))
+
+
+class PromoRegistry:
+    """In-memory promo code storage with usage counters."""
+
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._codes: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+
+    def add(self, promo: PromoCode) -> None:
+        if promo.code in self._codes:
+            raise ValidationError(f"duplicate promo code: {promo.code}")
+        self._codes[promo.code] = promo
+        self._uses[promo.code] = 0
+        logger.debug("promo: added %s", promo.code)
+
+    def _get(self, code: str) -> PromoCode:
+        key = normalize_key(code)
+        try:
+            return self._codes[key]
+        except KeyError:
+            raise UnknownPromoCodeError(key) from None
+
+    def resolve(self, code: str) -> PromoCode:
+        """Find a code usable right now: existence, then validity period, then limit."""
+        promo = self._get(code)
+        now = self._clock.now()
+        if promo.starts_at is not None and now < promo.starts_at:
+            raise PromoExpiredError(f"promo code {promo.code} is not active yet")
+        if promo.expires_at is not None and now >= promo.expires_at:
+            raise PromoExpiredError(f"promo code {promo.code} has expired")
+        self._check_limit(promo)
+        return promo
+
+    def uses(self, code: str) -> int:
+        """Number of placed and not cancelled orders with the code."""
+        return self._uses[self._get(code).code]
+
+    def redeem(self, code: str) -> None:
+        """Count one placed order; re-checks the limit. Called by OrderService only."""
+        promo = self._get(code)
+        self._check_limit(promo)
+        self._uses[promo.code] += 1
+
+    def release(self, code: str) -> None:
+        """Give back one use after an order is cancelled. Called by OrderService only."""
+        promo = self._get(code)
+        if self._uses[promo.code] > 0:
+            self._uses[promo.code] -= 1
+
+    def _check_limit(self, promo: PromoCode) -> None:
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} has no uses left")
diff --git a/tests/test_orders_promo.py b/tests/test_orders_promo.py
