+++ b/tests/test_orders_promo.py
@@ -0,0 +1,116 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.errors import InvalidOrderStateError
+
+from shop import (
+    Cart,
+    DiscountKind,
+    OrderService,
+    PromoCode,
+    PromoConditionsError,
+    PromoRegistry,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+
+
+@pytest.fixture
+def registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(PromoCode("SUMMER10", DiscountKind.PERCENT, Decimal("10")))
+    reg.add(PromoCode("ONCE", DiscountKind.FIXED, Decimal("100"), max_uses=1))
+    reg.add(
+        PromoCode("BIG", DiscountKind.PERCENT, Decimal("10"), min_order_amount=Decimal("10000"))
+    )
+    return reg
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def cart(products):
+    cart = Cart()
+    cart.add(products["phone"])
+    return cart
+
+
+def test_blank_code_means_none(service, cart):
+    for blank in (None, "", "   "):
+        order = service.place_order(cart, blank)
+        assert order.promo_code is None
+        assert order.total.discount == Decimal("0.00")
+
+
+def test_no_registry(clock, cart):
+    with pytest.raises(UnknownPromoCodeError):
+        OrderService(clock=clock).quote(cart, "SUMMER10")
+
+
+def test_non_string(service, cart):
+    with pytest.raises(ValidationError):
+        service.quote(cart, 5)
+
+
+def test_normalized_in_order(service, cart, registry):
+    order = service.place_order(cart, " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == Decimal("250.00")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_quote_does_not_consume(service, cart, registry):
+    for _ in range(3):
+        service.quote(cart, "ONCE")
+    assert registry.uses("ONCE") == 0
+
+
+def test_failure_does_not_consume(service, registry):
+    with pytest.raises(PromoConditionsError):
+        service.place_order(_cart_small(), "BIG")
+    assert registry.uses("BIG") == 0
+    assert len(service.store) == 0
+
+
+def _cart_small():
+    from shop import Category, Product
+
+    cart = Cart()
+    cart.add(Product("S-1", "small", Decimal("100.00"), Category.BOOKS))
+    return cart
+
+
+def test_last_use(service, cart):
+    service.place_order(cart, "ONCE")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "ONCE")
+
+
+def test_cancel_returns_use(service, cart, registry):
+    order = service.place_order(cart, "ONCE")
+    assert registry.uses("ONCE") == 1
+    service.cancel(order.order_id)
+    assert registry.uses("ONCE") == 0
+    again = service.place_order(cart, "ONCE")
+    assert again.promo_code == "ONCE"
+    assert registry.uses("ONCE") == 1
+
+
+def test_cancel_twice_keeps_uses(service, cart, registry):
+    order = service.place_order(cart, "SUMMER10")
+    service.place_order(cart, "SUMMER10")
+    service.cancel(order.order_id)
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_cancel_without_code(service, cart, registry):
+    service.place_order(cart, "SUMMER10")
+    plain = service.place_order(cart)
+    service.cancel(plain.order_id)
+    assert registry.uses("SUMMER10") == 1
