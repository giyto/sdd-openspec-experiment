@@ -0,0 +1,130 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop import (
+    DiscountKind,
+    PromoCode,
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    PromoRegistry,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+
+NOW = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def make(**kw):
+    args = dict(code="SUMMER10", kind=DiscountKind.PERCENT, value=Decimal("10"))
+    args.update(kw)
+    return PromoCode(**args)
+
+
+def test_error_hierarchy():
+    errors = [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError]
+    for a in errors:
+        assert issubclass(a, PromoError) and issubclass(a, ShopError)
+        for b in errors:
+            if a is not b:
+                assert not issubclass(a, b)
+
+
+def test_code_normalized():
+    assert make(code="  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("100.01"), Decimal("-1")])
+def test_percent_out_of_range(value):
+    with pytest.raises(ValidationError):
+        make(value=value)
+
+
+def test_percent_100_ok():
+    assert make(value=Decimal("100")).value == 100
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        dict(code="   "),
+        dict(value=10),
+        dict(kind=DiscountKind.FIXED, value=Decimal("0")),
+        dict(kind=DiscountKind.FIXED, value=Decimal("1.005")),
+        dict(min_order_amount=Decimal("-1")),
+        dict(starts_at=datetime(2026, 1, 1)),
+        dict(expires_at=datetime(2026, 1, 1)),
+        dict(starts_at=NOW, expires_at=NOW),
+        dict(starts_at=NOW + timedelta(days=1), expires_at=NOW),
+        dict(max_uses=0),
+        dict(max_uses=True),
+        dict(max_uses=1.5),
+    ],
+)
+def test_invalid_promo(kwargs):
+    with pytest.raises(ValidationError):
+        make(**kwargs)
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def test_resolve_normalizes(registry):
+    promo = make()
+    registry.add(promo)
+    assert registry.resolve("  summer10 ") is promo
+    assert registry.uses("summer10") == 0
+
+
+def test_duplicate(registry):
+    registry.add(make())
+    with pytest.raises(ValidationError):
+        registry.add(make(code=" summer10"))
+
+
+def test_unknown_and_empty(registry):
+    registry.add(make())
+    for code in ("NOPE", "", "   "):
+        with pytest.raises(UnknownPromoCodeError):
+            registry.resolve(code)
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE")
+
+
+def test_period_boundaries(clock, registry):
+    registry.add(make(starts_at=NOW, expires_at=NOW + timedelta(days=1)))
+    clock.set(NOW - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+    clock.set(NOW)
+    registry.resolve("SUMMER10")
+    clock.set(NOW + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_limit_and_check_order(clock, registry):
+    registry.add(make(max_uses=1, expires_at=NOW + timedelta(days=1)))
+    registry.redeem("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.redeem("SUMMER10")
+    clock.set(NOW + timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_release(registry):
+    registry.add(make(max_uses=1))
+    registry.redeem("SUMMER10")
+    registry.release("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    registry.resolve("SUMMER10")
+    registry.release("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
