+++ b/tests/test_split_zero.py
@@ -0,0 +1,21 @@
+from decimal import Decimal
+
+from ledger.importer import import_statement
+from ledger.storage import MemoryStore
+
+
+def test_split_zero_column_is_empty(tmp_path):
+    p = tmp_path / "s.csv"
+    p.write_text(
+        "Дата;Описание;Приход;Расход\n"
+        "01.03.2026;A;0,00;1 200,50\n"
+        "02.03.2026;B;85 000,00;0,00\n"
+        "03.03.2026;C;0,00;0,00\n"
+        "04.03.2026;D;5,00;6,00\n",
+        encoding="utf-8",
+    )
+    store = MemoryStore()
+    res = import_statement(p, store)
+    assert res.added == 2
+    assert [e.line_no for e in res.errors] == [4, 5]
+    assert sorted(t.amount for t in store.all()) == [Decimal("-1200.50"), Decimal("85000.00")]
