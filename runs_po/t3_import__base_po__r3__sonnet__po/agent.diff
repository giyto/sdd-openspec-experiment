diff --git a/tests/test_import_statement.py b/tests/test_import_statement.py
new file mode 100644
index 0000000..b5810b8
--- /dev/null
+++ b/tests/test_import_statement.py
@@ -0,0 +1,88 @@
+import json
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementRowError, UnknownFormatError
+from ledger.importer import detect_format, import_csv, import_statement, normalize_description
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1\u00a0200,50;Магазин Лента\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+    "\n"
+    "  ;;\n"
+    ";;;\n"
+)
+
+
+def test_sfera_bom_and_junk(write_csv, clock):
+    p = write_csv("\ufeff" + SFERA)
+    store = MemoryStore()
+    r = import_statement(p, store, clock=clock)
+    assert (r.format, r.encoding, r.added, r.duplicates, r.errors) == ("sfera", "utf-8", 2, 0, [])
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+
+
+def test_cp1251_and_reimport_dupes(write_csv, clock):
+    p = write_csv(SFERA, encoding="cp1251")
+    store = MemoryStore()
+    assert import_statement(p, store, clock=clock).encoding == "cp1251"
+    r = import_statement(p, store, clock=clock)
+    assert (r.added, r.duplicates) == (0, 2)
+
+
+def test_dupe_uses_normalized_description(write_csv, clock):
+    store = MemoryStore()
+    import_statement(write_csv("Дата;Сумма;Описание\n01.03.2026;-5,00;Ёлка  Лента\n"), store)
+    r = import_statement(
+        write_csv("Дата;Сумма;Описание\n01.03.2026;-5,00;елка лента\n", name="b.csv"), store
+    )
+    assert r.duplicates == 1 and normalize_description(" Ёж ") == "еж"
+
+
+def test_split_format(write_csv, clock):
+    text = (
+        "Дата;Описание;Приход;Расход\n"
+        "01.03.2026;A;;1 200,50\n"
+        "02.03.2026;B;10,00;\n"
+        "03.03.2026;C;;-5,00\n"
+        "03.03.2026;D;1,00;2,00\n"
+        "03.03.2026;E;;\n"
+    )
+    store = MemoryStore()
+    r = import_statement(write_csv(text), store, clock=clock)
+    assert r.format == "sfera_split" and r.added == 2
+    assert [e.line_no for e in r.errors] == [4, 5, 6]
+    assert store.all()[0].amount == Decimal("-1200.50")
+
+
+def test_strict_is_atomic(write_csv, tmp_path):
+    store = JsonFileStore(tmp_path / "s.json")
+    p = write_csv("Дата;Сумма;Описание\n01.03.2026;-1,00;a\n31.02.2026;-1,00;b\n")
+    with pytest.raises(StatementRowError) as info:
+        import_statement(p, store, strict=True)
+    assert info.value.line_no == 3
+    assert store.all() == [] and not (tmp_path / "s.json").exists()
+
+
+def test_nonstrict_collects_errors(write_csv):
+    store = MemoryStore()
+    r = import_statement(write_csv("Дата;Сумма;Описание\n01.03.2026;abc;a\n01.03.2026;-1,00;b\n"), store)
+    assert r.added == 1 and r.errors[0].line_no == 2
+
+
+def test_unknown_format(write_csv):
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(""), MemoryStore())
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="nova")
+    assert detect_format(write_csv(SFERA)) == "sfera"
+
+
+def test_nova_junk_and_compat(write_csv, clock):
+    p = write_csv("\ufeffdate,amount,description\n,,\n2026-03-01,-3.00,x\n")
+    store = MemoryStore()
+    assert import_csv(p, store, clock=clock) == 1
+    assert import_csv(p, store, clock=clock) == 0
