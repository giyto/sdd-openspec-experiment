@@ -0,0 +1,140 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop import (
+    Category,
+    DiscountKind,
+    FixedClock,
+    PromoCode,
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    PromoRegistry,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+
+D = Decimal
+T0 = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def pct(code="SUMMER10", value="10", **kw):
+    return PromoCode(code, DiscountKind.PERCENT, D(value), **kw)
+
+
+@pytest.mark.parametrize("cls", [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError])
+def test_error_hierarchy(cls):
+    others = {UnknownPromoCodeError, PromoExpiredError, PromoConditionsError} - {cls}
+    assert issubclass(cls, PromoError) and issubclass(cls, ShopError)
+    for other in others:
+        assert not issubclass(cls, other)
+
+
+def test_defaults_and_normalization():
+    p = pct(" summer10 ", "15")
+    assert p.code == "SUMMER10"
+    assert p.min_order_amount == D("0.00")
+    assert p.max_uses is None and p.starts_at is None and p.expires_at is None
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "100.01"])
+def test_percent_out_of_range(value):
+    with pytest.raises(ValidationError):
+        pct(value=value)
+
+
+def test_percent_100_ok():
+    pct(value="100")
+
+
+@pytest.mark.parametrize("value", [D("0"), D("-5"), 5.0, D("1.001")])
+def test_fixed_invalid(value):
+    with pytest.raises(ValidationError):
+        PromoCode("X", DiscountKind.FIXED, value)
+
+
+@pytest.mark.parametrize("code", ["", "   "])
+def test_empty_code(code):
+    with pytest.raises(ValidationError):
+        pct(code)
+
+
+def test_bad_dates_and_limits():
+    with pytest.raises(ValidationError):
+        pct(starts_at=datetime(2026, 1, 1))
+    with pytest.raises(ValidationError):
+        pct(starts_at=T0, expires_at=T0)
+    for bad in (0, -1, True):
+        with pytest.raises(ValidationError):
+            pct(max_uses=bad)
+
+
+def test_min_order_amount_validation():
+    with pytest.raises(ValidationError):
+        pct(min_order_amount=D("-1"))
+    with pytest.raises(ValidationError):
+        pct(min_order_amount=500.0)
+
+
+def test_registry_normalization_and_duplicates():
+    reg = PromoRegistry(FixedClock(T0))
+    reg.add(pct("Summer10"))
+    assert reg.resolve("  SUMMER10 ").code == "SUMMER10"
+    with pytest.raises(ValidationError):
+        reg.add(pct(" summer10"))
+
+
+def test_unknown_and_empty():
+    reg = PromoRegistry(FixedClock(T0))
+    for code in ("NOPE", ""):
+        with pytest.raises(UnknownPromoCodeError):
+            reg.resolve(code)
+    with pytest.raises(UnknownPromoCodeError):
+        reg.uses("NOPE")
+
+
+def test_period_boundaries():
+    clock = FixedClock(T0)
+    reg = PromoRegistry(clock)
+    reg.add(pct(starts_at=T0, expires_at=T0 + timedelta(days=1)))
+    reg.resolve("SUMMER10")
+    clock.set(T0 - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+    clock.set(T0 + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_expired_before_limit():
+    clock = FixedClock(T0)
+    reg = PromoRegistry(clock)
+    reg.add(pct(max_uses=1, expires_at=T0 + timedelta(days=1)))
+    reg.redeem("SUMMER10")
+    clock.set(T0 + timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_redeem_release():
+    reg = PromoRegistry(FixedClock(T0))
+    reg.add(pct(max_uses=1))
+    reg.resolve("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.redeem("SUMMER10")
+    assert reg.uses("summer10") == 1
+    with pytest.raises(PromoConditionsError):
+        reg.redeem("SUMMER10")
+    reg.release("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.release("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg.resolve("SUMMER10")
+
+
+def test_excluded_categories_frozen():
+    p = pct(excluded_categories={Category.BOOKS})
+    assert p.excluded_categories == frozenset({Category.BOOKS})
