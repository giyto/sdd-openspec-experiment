+++ b/tests/test_orders_promo.py
@@ -0,0 +1,101 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop import (
+    Cart,
+    DiscountKind,
+    OrderService,
+    PromoCode,
+    PromoConditionsError,
+    PromoExpiredError,
+    PromoRegistry,
+    UnknownPromoCodeError,
+)
+from shop.errors import EmptyCartError
+
+D = Decimal
+
+
+@pytest.fixture
+def setup(clock, products):
+    reg = PromoRegistry(clock)
+    reg.add(
+        PromoCode("SUMMER10", DiscountKind.PERCENT, D("10"), max_uses=1, min_order_amount=D("500"))
+    )
+    svc = OrderService(clock=clock, promos=reg)
+    cart = Cart()
+    cart.add(products["shirt"], 1)
+    return svc, reg, cart
+
+
+def test_old_calls_unchanged(clock, products):
+    svc = OrderService(clock=clock)
+    cart = Cart()
+    cart.add(products["shirt"], 1)
+    assert svc.quote(cart) == svc.place_order(cart).total
+    assert svc.quote(cart, "   ").discount == D("0.00")
+    assert svc.place_order(cart, "  ").promo_code is None
+
+
+def test_success_and_cancel_release(setup):
+    svc, reg, cart = setup
+    q = svc.quote(cart, "summer10")
+    assert reg.uses("SUMMER10") == 0
+    order = svc.place_order(cart, " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == q.discount == D("99.90")
+    assert reg.uses("SUMMER10") == 1
+    with pytest.raises(PromoConditionsError):
+        svc.place_order(cart, "SUMMER10")
+    svc.cancel(order.order_id)
+    assert reg.uses("SUMMER10") == 0
+    svc.place_order(cart, "SUMMER10")
+
+
+def test_cancel_without_code_leaves_counters(setup):
+    svc, reg, cart = setup
+    svc.place_order(cart, "SUMMER10")
+    plain = svc.place_order(cart)
+    svc.cancel(plain.order_id)
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_failures_have_no_side_effects(setup, products):
+    svc, reg, cart = setup
+    cheap = Cart()
+    cheap.add(products["tea"], 1)
+    with pytest.raises(UnknownPromoCodeError):
+        svc.place_order(cart, "NOPE")
+    with pytest.raises(PromoConditionsError):
+        svc.place_order(cheap, "SUMMER10")
+    with pytest.raises(EmptyCartError):
+        svc.place_order(Cart(), "NOPE")
+    assert len(svc.store) == 0 and reg.uses("SUMMER10") == 0
+
+
+def test_expired(clock, products):
+    reg = PromoRegistry(clock)
+    now = clock.now()
+    reg.add(
+        PromoCode(
+            "OLD",
+            DiscountKind.PERCENT,
+            D("5"),
+            starts_at=now - timedelta(days=5),
+            expires_at=now - timedelta(days=1),
+        )
+    )
+    svc = OrderService(clock=clock, promos=reg)
+    cart = Cart()
+    cart.add(products["shirt"], 1)
+    with pytest.raises(PromoExpiredError):
+        svc.place_order(cart, "OLD")
+
+
+def test_no_registry(clock, products):
+    cart = Cart()
+    cart.add(products["shirt"], 1)
+    with pytest.raises(UnknownPromoCodeError):
+        OrderService(clock=clock).place_order(cart, "SUMMER10")
