@@ -0,0 +1,119 @@
+import itertools
+from decimal import Decimal
+
+import pytest
+
+from shop import (
+    Cart,
+    Category,
+    DiscountKind,
+    Product,
+    PromoCode,
+    PromoConditionsError,
+    ShippingPolicy,
+    calculate_total,
+)
+
+D = Decimal
+
+
+def prod(sku, price, cat=Category.CLOTHING):
+    return Product(sku, sku, D(price), cat)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def pct(value, **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("F", DiscountKind.FIXED, D(value), **kw)
+
+
+def test_no_promo_unchanged(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 2))
+    t = calculate_total(cart)
+    assert t.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in t.lines)
+    assert t.total == t.subtotal + t.shipping + t.tax
+
+
+def test_percent_rounding():
+    t = calculate_total(cart_of((prod("A1", "100.05"), 1)), promo=pct("10"))
+    assert t.discount == D("10.01")
+
+
+def test_fixed_capped_and_full():
+    t = calculate_total(cart_of((prod("A1", "1200.00"), 1)), promo=fixed("5000"))
+    assert t.discount == D("1200.00") and t.lines[0].tax == D("0.00")
+    t = calculate_total(cart_of((prod("A1", "1200.00"), 1)), promo=pct("100"))
+    assert t.discount == D("1200.00")
+
+
+def test_min_order_boundary():
+    promo = pct("10", min_order_amount=D("500.00"))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((prod("A1", "499.99"), 1)), promo=promo)
+    assert calculate_total(cart_of((prod("A1", "500.00"), 1)), promo=promo).discount == D("50.00")
+
+
+def test_only_gift_cards_or_excluded():
+    gift = prod("G1", "1000.00", Category.GIFT_CARD)
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((gift, 1)), promo=pct("10"))
+    book = prod("B1", "100.00", Category.BOOKS)
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((book, 1)), promo=pct("10", excluded_categories={Category.BOOKS}))
+
+
+def test_gift_card_and_excluded_get_no_discount():
+    cart = cart_of(
+        (prod("G1", "1000.00", Category.GIFT_CARD), 1),
+        (prod("B1", "100.00", Category.BOOKS), 1),
+        (prod("C1", "200.00"), 1),
+    )
+    t = calculate_total(cart, promo=pct("10", excluded_categories={Category.BOOKS}))
+    assert [ln.discount for ln in t.lines] == [D("0.00"), D("0.00"), D("20.00")]
+
+
+def test_largest_remainder():
+    cart = cart_of(*[(prod(f"A{i}", "10.00"), 1) for i in range(3)])
+    t = calculate_total(cart, promo=fixed("10.00"))
+    assert [ln.discount for ln in t.lines] == [D("3.34"), D("3.33"), D("3.33")]
+    assert t.discount == D("10.00")
+
+
+def test_tax_after_discount():
+    t = calculate_total(
+        cart_of((prod("E1", "1000.00", Category.ELECTRONICS), 1)),
+        ShippingPolicy(free_threshold=D("100")),
+        promo=fixed("100"),
+    )
+    assert t.lines[0].tax == D("180.00")
+    assert t.total == D("1000.00") - D("100.00") + D("180.00")
+
+
+def test_shipping_threshold_after_discount():
+    cart = cart_of((prod("A1", "3100.00"), 1))
+    assert calculate_total(cart).shipping == D("0.00")
+    t = calculate_total(cart, promo=fixed("200"))
+    assert t.shipping == D("299.00")
+    assert t.total == t.subtotal - t.discount + t.shipping + t.tax
+    assert calculate_total(cart, promo=fixed("100")).shipping == D("0.00")
+
+
+def test_invariants_on_many_carts():
+    prices = ["0.01", "3.33", "10.00", "99.99", "123.45"]
+    promos = [pct("12.5"), pct("33"), fixed("7.77"), fixed("1000"), pct("100")]
+    for combo in itertools.product(prices, repeat=3):
+        cart = cart_of(*[(prod(f"S{i}", p), i + 1) for i, p in enumerate(combo)])
+        for promo in promos:
+            t = calculate_total(cart, promo=promo)
+            assert sum(ln.discount for ln in t.lines) == t.discount
+            assert all(D("0") <= ln.discount <= ln.amount for ln in t.lines)
