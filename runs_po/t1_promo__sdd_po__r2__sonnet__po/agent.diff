new file mode 100644
index 0000000..1a8a3b4
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,154 @@
+"""Promo codes: model, validation and the registry with usage counters."""
+
+from __future__ import annotations
+
+import logging
+import threading
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock, SystemClock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO
+
+logger = logging.getLogger(__name__)
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _check_money(value: object, name: str) -> Decimal:
+    if not isinstance(value, Decimal) or not value.is_finite():
+        raise ValidationError(f"{name} must be a finite Decimal")
+    if value != value.quantize(Decimal("0.01")):
+        raise ValidationError(f"{name} must have at most two decimal places")
+    return value
+
+
+def _check_aware(value: datetime | None, name: str) -> None:
+    if value is None:
+        return
+    if not isinstance(value, datetime) or value.tzinfo is None or value.utcoffset() is None:
+        raise ValidationError(f"{name} must be an aware datetime")
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        code = normalize_key(self.code)
+        if not code:
+            raise ValidationError("promo code must not be empty")
+        object.__setattr__(self, "code", code)
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError("kind must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError("promo value must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError("percent must be in (0, 100]")
+        else:
+            _check_money(self.value, "fixed discount")
+            if self.value <= 0:
+                raise ValidationError("fixed discount must be positive")
+        _check_money(self.min_order_amount, "min_order_amount")
+        if self.min_order_amount < 0:
+            raise ValidationError("min_order_amount must not be negative")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError("max_uses must be None or an int >= 1")
+        _check_aware(self.starts_at, "starts_at")
+        _check_aware(self.expires_at, "expires_at")
+        if self.starts_at and self.expires_at and self.starts_at >= self.expires_at:
+            raise ValidationError("starts_at must be earlier than expires_at")
+        try:
+            categories = frozenset(self.excluded_categories)
+        except TypeError:
+            raise ValidationError("excluded_categories must be a set of Category") from None
+        if not all(isinstance(c, Category) for c in categories):
+            raise ValidationError("excluded_categories must contain only Category values")
+        object.__setattr__(self, "excluded_categories", categories)
+
+
+class PromoRegistry:
+    """In-memory promo code storage with usage counters."""
+
+    def __init__(self, clock: Clock | None = None, codes: Iterable[PromoCode] = ()) -> None:
+        self._clock = clock or SystemClock()
+        self._codes: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+        self._lock = threading.Lock()
+        for promo in codes:
+            self.add(promo)
+
+    def add(self, promo: PromoCode) -> None:
+        with self._lock:
+            if promo.code in self._codes:
+                raise ValidationError(f"duplicate promo code: {promo.code}")
+            self._codes[promo.code] = promo
+            self._uses[promo.code] = 0
+
+    def _key(self, code: str) -> str:
+        return normalize_key(code)
+
+    def _resolve_locked(self, code: str) -> PromoCode:
+        key = self._key(code)
+        promo = self._codes.get(key)
+        if promo is None:
+            raise UnknownPromoCodeError(f"unknown promo code: {code!r}")
+        now = self._clock.now()
+        if (promo.starts_at is not None and now < promo.starts_at) or (
+            promo.expires_at is not None and now >= promo.expires_at
+        ):
+            raise PromoExpiredError(f"promo code {key} is not active")
+        if promo.max_uses is not None and self._uses[key] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {key} usage limit reached")
+        return promo
+
+    def resolve(self, code: str) -> PromoCode:
+        with self._lock:
+            return self._resolve_locked(code)
+
+    def uses(self, code: str) -> int:
+        key = self._key(code)
+        with self._lock:
+            if key not in self._codes:
+                raise UnknownPromoCodeError(f"unknown promo code: {code!r}")
+            return self._uses[key]
+
+    def redeem(self, code: str) -> PromoCode:
+        """Re-check the code and count one use, atomically."""
+        with self._lock:
+            promo = self._resolve_locked(code)
+            self._uses[promo.code] += 1
+            logger.info("promo %s redeemed, uses=%s", promo.code, self._uses[promo.code])
+            return promo
+
+    def release(self, code: str) -> None:
+        """Give back one use (order cancelled); never goes below zero."""
+        key = self._key(code)
+        with self._lock:
+            if key not in self._codes:
+                raise UnknownPromoCodeError(f"unknown promo code: {code!r}")
+            self._uses[key] = max(0, self._uses[key] - 1)
+            logger.info("promo %s released, uses=%s", key, self._uses[key])
