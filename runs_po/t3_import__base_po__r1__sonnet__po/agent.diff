+# --- LEDGER-58 ---
+from ledger.errors import StatementRowError, UnknownFormatError  # noqa: E402
+from ledger.importer import detect_format, import_statement, normalize_description  # noqa: E402
+from ledger.storage import JsonFileStore  # noqa: E402
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1 200,50;Магазин Лента\n"
+    "\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+    ";;;\n"
+    "   \n"
+)
+
+
+def test_sfera_cp1251_junk_and_reimport(write_csv, clock):
+    store = MemoryStore()
+    path = write_csv(SFERA, encoding="cp1251")
+    r = import_statement(path, store, clock=clock)
+    assert (r.format, r.encoding, r.added, r.duplicates, r.errors) == ("sfera", "cp1251", 2, 0, [])
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+    r = import_statement(path, store, clock=clock)
+    assert (r.added, r.duplicates) == (0, 2)
+
+
+def test_bom_and_detect(write_csv):
+    path = write_csv("﻿" + NOVA)
+    assert detect_format(path) == "nova"
+    assert import_statement(path, MemoryStore()).encoding == "utf-8"
+
+
+def test_split_format(write_csv):
+    text = (
+        "Дата;Описание;Приход;Расход\n"
+        "01.03.2026;А;;1 200,50\n"
+        "02.03.2026;Б;10,00;\n"
+        "03.03.2026;В;-5,00;\n"
+        "04.03.2026;Г;1,00;2,00\n"
+        "05.03.2026;Д;;\n"
+    )
+    store = MemoryStore()
+    r = import_statement(write_csv(text), store)
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("10.00")]
+    assert [e.line_no for e in r.errors] == [4, 5, 6]
+
+
+def test_strict_stores_nothing(write_csv, tmp_path):
+    store = JsonFileStore(tmp_path / "s.json")
+    text = "date,amount,description\n2026-03-01,-1.00,ok\n,,\n2026-03-02,x,bad\n"
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(text), store, strict=True)
+    assert info.value.line_no == 4
+    assert store.all() == [] and not (tmp_path / "s.json").exists()
+
+
+def test_unknown_format(write_csv):
+    for text in ("", "a,b,c\n"):
+        with pytest.raises(UnknownFormatError):
+            import_statement(write_csv(text), MemoryStore())
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="nova")
+
+
+def test_dedupe_normalizes_and_keeps_in_file_repeats(write_csv):
+    store = MemoryStore()
+    twice = "date,amount,description\n2026-03-01,-1.00,Кофе\n2026-03-01,-1.00,Кофе\n"
+    assert import_statement(write_csv(twice), store).added == 2
+    again = "date,amount,description\n2026-03-01,-1.00,  КОФЕ \n"
+    assert import_statement(write_csv(again), store).duplicates == 1
+    assert normalize_description(" Ёлка  Х") == "елка х"
+
+
+def test_import_csv_bad_header_keeps_missing_columns_error(tmp_path):
+    from ledger.errors import StatementError, UnknownFormatError
+    from ledger.importer import import_csv
+    from ledger.storage import MemoryStore
+
+    p = tmp_path / "x.csv"
+    p.write_text("date,amount\n", encoding="utf-8")
+    try:
+        import_csv(p, MemoryStore())
+    except StatementError as exc:
+        assert type(exc) is StatementError
+        assert not isinstance(exc, UnknownFormatError)
+        assert exc.line_no == 1 and "missing columns: description" in exc.message
+    else:
+        raise AssertionError("no error")
