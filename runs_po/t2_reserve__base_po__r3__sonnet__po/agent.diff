@@ -0,0 +1,100 @@
+from datetime import timedelta
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ValidationError,
+)
+from warehouse.models import ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL
+
+
+def test_reserve_and_availability(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ("MAIN", "BOLT-M8", 3)])
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+    assert res.expires_at == clock.now() + DEFAULT_RESERVATION_TTL
+    assert len(res.lines) == 2
+    assert inv.on_hand("MAIN", "BOLT-M8") == 10
+    assert inv.reserved("MAIN", "BOLT-M8") == 7
+    assert inv.available("MAIN", "BOLT-M8") == 3
+    with pytest.raises(InsufficientStockError):
+        inv.issue("MAIN", "BOLT-M8", 4)
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_validation_and_atomicity(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    n = len(inv.log)
+    with pytest.raises(InsufficientStockError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "NUT-M8", 1)])
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-1", [])
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(0))
+    assert len(inv.log) == n
+    with pytest.raises(ReservationNotFoundError):
+        inv.get_reservation("SO-1")
+
+
+def test_expiry_confirm_cancel(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert inv.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert inv.available("MAIN", "BOLT-M8") == 5
+    with pytest.raises(ReservationExpiredError):
+        inv.confirm("SO-1")
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 5)])
+    inv.confirm("SO-2")
+    assert inv.on_hand("MAIN", "BOLT-M8") == 0
+    clock.advance(timedelta(days=1))
+    assert inv.get_reservation("SO-2").status is ReservationStatus.CONFIRMED
+    with pytest.raises(ReservationStateError):
+        inv.cancel("SO-2")
+
+
+def test_cancel_idempotent_and_extend(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    first = inv.get_reservation("SO-1").expires_at
+    n = len(inv.log)
+    assert inv.extend("SO-1", timedelta(minutes=5)).expires_at == first
+    assert len(inv.log) == n
+    assert inv.extend("SO-1", timedelta(minutes=20)).expires_at == clock.now() + timedelta(minutes=20)
+    assert len(inv.log) == n + 1
+    inv.cancel("SO-1")
+    n = len(inv.log)
+    assert inv.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(inv.log) == n
+    with pytest.raises(ReservationStateError):
+        inv.extend("SO-1", timedelta(minutes=5))
+
+
+def test_extend_counts_from_now(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    clock.advance(timedelta(minutes=10))
+    res = inv.extend("SO-1", timedelta(minutes=10))
+    assert res.expires_at == clock.now() + timedelta(minutes=10)
+
+
+def test_reserve_replaces_expired_or_cancelled(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert inv.reserved("MAIN", "BOLT-M8") == 3
+    inv.cancel("SO-1")
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert inv.get_reservation("SO-1").lines[0].qty == 1
+    inv.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
