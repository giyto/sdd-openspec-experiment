+def test_no_policy_and_replacement(queue, registry):
+    assert queue.retry_policy_for("t") is None
+    default = RetryPolicy(non_retryable=(ValueError,))
+    q = JobQueue(clock=queue.clock, default_retry_policy=default)
+    assert q.retry_policy_for("t") is default
+    own = RetryPolicy()
+    q.set_retry_policy("t", own)
+    assert q.retry_policy_for("t") is own
+    q.set_retry_policy("t", None)
+    assert q.retry_policy_for("t") is default
+    with pytest.raises(ConfigError):
+        q.set_retry_policy("t", "x")
