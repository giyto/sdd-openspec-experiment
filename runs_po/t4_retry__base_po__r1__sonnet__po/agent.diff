@@ -0,0 +1,75 @@
+"""Политика повторов упавших заданий."""
+
+from __future__ import annotations
+
+import random
+from dataclasses import dataclass
+
+from .errors import ConfigError, PermanentJobError
+
+
+def _is_number(value: object) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Экспоненциальная задержка между попытками.
+
+    ``max_attempts`` — всего попыток, включая первую. ``non_retryable`` — классы
+    исключений (с наследниками), которые не повторяются; список приводится к tuple.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.max_attempts, int) or isinstance(self.max_attempts, bool):
+            raise ConfigError("max_attempts must be an integer")
+        if self.max_attempts < 1:
+            raise ConfigError("max_attempts must be at least 1")
+        for name in ("base_delay", "factor", "max_delay", "jitter"):
+            if not _is_number(getattr(self, name)):
+                raise ConfigError(f"{name} must be a number")
+        # сравнения записаны так, чтобы NaN тоже отвергался
+        if not self.base_delay >= 0:
+            raise ConfigError("base_delay must be non-negative")
+        if not self.factor >= 1:
+            raise ConfigError("factor must be at least 1")
+        if not self.max_delay >= self.base_delay:
+            raise ConfigError("max_delay must not be less than base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be between 0 and 1")
+        try:
+            classes = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for cls in classes:
+            if not (isinstance(cls, type) and issubclass(cls, BaseException)):
+                raise ConfigError(f"non_retryable item {cls!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", classes)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка перед следующей попыткой, если упала попытка ``attempt`` (с 1)."""
+        if not isinstance(attempt, int) or isinstance(attempt, bool) or attempt < 1:
+            raise ConfigError("attempt must be an integer >= 1")
+        if self.base_delay == 0:
+            delay = 0.0
+        else:
+            try:
+                delay = min(self.base_delay * self.factor ** (attempt - 1), self.max_delay)
+            except OverflowError:
+                delay = self.max_delay
+        if self.jitter > 0:
+            generator = rng if rng is not None else random
+            delay = min(delay * generator.uniform(1 - self.jitter, 1 + self.jitter), self.max_delay)
+        return delay
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
