+def _allocate_discount(amounts: list[Decimal], discount: Decimal) -> list[Decimal]:
+    """Split ``discount`` over ``amounts`` proportionally, to the kopeck.
+
+    Largest remainder method; ties go to the earlier line. The parts sum exactly to
+    ``discount`` and no part exceeds its amount (discount <= sum of amounts).
+    """
+    cents = [int(a / CENT) for a in amounts]
+    total_cents = sum(cents)
+    to_split = int(discount / CENT)
+    shares = [to_split * c // total_cents for c in cents]
+    remainders = [to_split * c % total_cents for c in cents]
+    left = to_split - sum(shares)
+    order = sorted(range(len(cents)), key=lambda i: (-remainders[i], i))
+    for i in order[:left]:
+        shares[i] += 1
+    return [Decimal(share) * CENT for share in shares]
