diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..cef1c58
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,395 @@
+import dataclasses
+from datetime import timedelta
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.inventory import Inventory
+from warehouse.models import ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL, ReservationRecord, effective_status
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 10)
+    inv.receive("B", "NUT-M8", 10)
+    return inv
+
+
+# --- модели, ошибки, статус ---------------------------------------------------
+
+
+def test_models_frozen_and_status_values(stocked):
+    assert issubclass(ReservationStatus, str)
+    assert [s.value for s in ReservationStatus] == ["ACTIVE", "CONFIRMED", "CANCELLED", "EXPIRED"]
+    snap = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        snap.status = ReservationStatus.CANCELLED
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        snap.lines[0].qty = 5
+
+
+@pytest.mark.parametrize(
+    "cls",
+    [ReservationNotFoundError, DuplicateReservationError, ReservationExpiredError, ReservationStateError],
+)
+def test_errors_hierarchy(cls):
+    err = cls("SO-1")
+    assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+    assert err.order_id == "SO-1"
+
+
+def test_effective_status_boundary(clock):
+    rec = ReservationRecord("X", ReservationStatus.ACTIVE, (), clock.now(), clock.now() + MIN)
+    assert effective_status(rec, clock.now() + MIN - timedelta(seconds=1)) is ReservationStatus.ACTIVE
+    assert effective_status(rec, clock.now() + MIN) is ReservationStatus.EXPIRED
+    for status in (ReservationStatus.CONFIRMED, ReservationStatus.CANCELLED):
+        rec.status = status
+        assert effective_status(rec, clock.now() + 10 * MIN) is status
+
+
+# --- reserve ------------------------------------------------------------------
+
+
+def test_reserve_multiple_warehouses(stocked, clock):
+    snap = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3)])
+    assert snap.status is ReservationStatus.ACTIVE
+    assert snap.lines == (ReservationLine("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3))
+    assert snap.created_at == clock.now()
+    assert DEFAULT_RESERVATION_TTL == 15 * MIN
+    assert snap.expires_at == clock.now() + 15 * MIN
+    assert stocked.on_hand("A", "BOLT-M8") == 10 and stocked.on_hand("B", "NUT-M8") == 10
+
+
+def test_reserve_explicit_ttl_and_generator(stocked, clock):
+    lines = (line for line in [("A", "BOLT-M8", 1)])
+    snap = stocked.reserve("SO-1", lines, ttl=timedelta(hours=1))
+    assert snap.expires_at == clock.now() + timedelta(hours=1)
+
+
+def test_duplicate_lines_kept_and_summed(stocked):
+    snap = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)])
+    assert [line.qty for line in snap.lines] == [2, 3]
+    assert stocked.reserved("A", "BOLT-M8") == 5
+    assert stocked.available("A", "BOLT-M8") == 5
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 60, True, None])
+def test_reserve_bad_ttl(stocked, ttl):
+    before = len(stocked.log)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=ttl)
+    assert len(stocked.log) == before
+
+
+@pytest.mark.parametrize("order_id", ["", "SO 1", "SO=1", None])
+def test_reserve_bad_order_id(stocked, order_id):
+    with pytest.raises(ValidationError):
+        stocked.reserve(order_id, [("A", "BOLT-M8", 1)])
+
+
+def test_reserve_empty(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+
+
+def test_reserve_bad_line_no_partial(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1), ("B", "NUT-M8", 0)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1), ("B", "NOPE", 1)])
+    assert stocked.reserved("A", "BOLT-M8") == 0 and len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_reserve_insufficient_sum_of_duplicates(stocked):
+    stocked.reserve("SO-0", [("A", "BOLT-M8", 6)])
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)])
+    assert (exc.value.requested, exc.value.available) == (5, 4)
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_reserve_blocked_by_other_reservation(stocked):
+    stocked.reserve("SO-0", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 3)])
+
+
+# --- уникальность / замена ----------------------------------------------------
+
+
+def test_duplicate_active_and_confirmed(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    before = len(stocked.log)
+    with pytest.raises(DuplicateReservationError) as exc:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert exc.value.order_id == "SO-1" and len(stocked.log) == before
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+
+
+def test_replace_after_cancel(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-1")
+    snap = stocked.reserve("SO-1", [("B", "NUT-M8", 4)])
+    assert stocked.get_reservation("SO-1") == snap
+    assert snap.status is ReservationStatus.ACTIVE
+    assert snap.lines == (ReservationLine("B", "NUT-M8", 4),)
+    assert stocked.reserved("A", "BOLT-M8") == 0
+
+
+def test_replace_after_expiry(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(15 * MIN)
+    snap = stocked.reserve("SO-1", [("A", "BOLT-M8", 7)])
+    assert snap.status is ReservationStatus.ACTIVE and snap.created_at == clock.now()
+    assert stocked.get_reservation("SO-1").lines == (ReservationLine("A", "BOLT-M8", 7),)
+    assert stocked.reserved("A", "BOLT-M8") == 7
+
+
+# --- available / reserved / истечение ----------------------------------------
+
+
+def test_available_calc_and_unknown_sku(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.reserved("A", "BOLT-M8") == 4
+    assert stocked.available("A", "BOLT-M8") == 6
+    assert stocked.available("Z", "OIL-5L") == 0 and stocked.reserved("Z", "OIL-5L") == 0
+    for fn in (stocked.available, stocked.reserved):
+        with pytest.raises(UnknownSkuError):
+            fn("A", "NOPE")
+
+
+def test_available_clamped_after_adjust(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    stocked.adjust("A", "BOLT-M8", 3, "recount")
+    assert stocked.available("A", "BOLT-M8") == 0
+
+
+def test_expiry_releases_stock_without_events(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    before = len(stocked.log)
+    clock.advance(15 * MIN - timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    clock.advance(timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.reserved("A", "BOLT-M8") == 0 and stocked.available("A", "BOLT-M8") == 10
+    assert len(stocked.log) == before
+
+
+def test_final_statuses_do_not_expire(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation("SO-2").status is ReservationStatus.CANCELLED
+
+
+def test_snapshot_not_changed_retroactively(stocked):
+    snap = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-1")
+    assert snap.status is ReservationStatus.ACTIVE
+
+
+# --- confirm -----------------------------------------------------------------
+
+
+def test_confirm_with_zero_available(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 10)])
+    assert stocked.available("A", "BOLT-M8") == 0
+    snap = stocked.confirm("SO-1")
+    assert snap.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("A", "BOLT-M8") == 0
+
+
+def test_confirm_insufficient_physical_atomic(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3), ("B", "NUT-M8", 1)])
+    stocked.adjust("A", "BOLT-M8", 4, "recount")
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.confirm("SO-1")
+    assert (exc.value.requested, exc.value.available) == (5, 4)
+    assert stocked.on_hand("A", "BOLT-M8") == 4 and stocked.on_hand("B", "NUT-M8") == 10
+    assert len(stocked.log) == before
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+
+
+def test_confirm_expired_repeated_missing(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    for oid in ("SO-1", "SO-2"):
+        with pytest.raises(ReservationStateError):
+            stocked.confirm(oid)
+    clock.advance(15 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+    assert stocked.on_hand("A", "BOLT-M8") == 9
+    with pytest.raises(ReservationNotFoundError) as exc:
+        stocked.confirm("NOPE")
+    assert exc.value.order_id == "NOPE"
+
+
+# --- cancel ------------------------------------------------------------------
+
+
+def test_cancel_active_idempotent(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.available("A", "BOLT-M8") == 10
+    assert len(stocked.log.events("RESERVE_CANCEL")) == 1
+    before = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == before
+
+
+def test_cancel_confirmed_and_expired_and_missing(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)], ttl=MIN)
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-1")
+    clock.advance(MIN)
+    before = len(stocked.log)
+    assert stocked.cancel("SO-2").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.cancel("NOPE")
+
+
+# --- extend ------------------------------------------------------------------
+
+
+def test_extend_counts_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(10 * MIN)  # до истечения осталось 5 минут
+    snap = stocked.extend("SO-1", 10 * MIN)
+    assert snap.expires_at == clock.now() + 10 * MIN
+    assert stocked.get_reservation("SO-1").expires_at == snap.expires_at
+    (event,) = stocked.log.events("RESERVE_EXTEND")
+    assert event.get("order") == "SO-1" and event.get("expires") == "2026-03-01T10:20:00Z"
+
+
+def test_extend_never_shortens(stocked):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    before = len(stocked.log)
+    for ttl in (5 * MIN, 15 * MIN):  # now + ttl не позже expires_at
+        assert stocked.extend("SO-1", ttl).expires_at == first.expires_at
+    assert len(stocked.log) == before
+    assert not stocked.log.events("RESERVE_EXTEND")
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)], ttl=MIN)
+    stocked.confirm("SO-2")
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+    with pytest.raises(ValidationError):
+        stocked.extend("NOPE", -MIN)
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2", MIN)
+    clock.advance(MIN)
+    before = stocked.get_reservation("SO-3").expires_at
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-3", 60 * MIN)
+    assert stocked.get_reservation("SO-3").expires_at == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.extend("NOPE", MIN)
+
+
+def test_get_reservation_missing(stocked):
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("NOPE")
+
+
+# --- issue / transfer --------------------------------------------------------
+
+
+def test_issue_limited_by_available(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("A", "BOLT-M8", 3)
+    assert exc.value.available == 2 and stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.issue("A", "BOLT-M8", 2) == 8
+    clock.advance(15 * MIN)
+    assert stocked.issue("A", "BOLT-M8", 8) == 0
+
+
+def test_transfer_limited_by_available(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("A", "C", "BOLT-M8", 3)
+    stocked.transfer("A", "C", "BOLT-M8", 2)
+    assert stocked.on_hand("C", "BOLT-M8") == 2
+
+
+def test_adjust_ignores_reservations(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    assert stocked.adjust("A", "BOLT-M8", 1, "recount") == 1
+    assert stocked.on_hand("A", "BOLT-M8") == 1
+    assert stocked.stock_levels("A")[0].on_hand == 1
+
+
+# --- журнал ------------------------------------------------------------------
+
+
+def test_event_format_and_confirm_order(stocked):
+    base = len(stocked.log)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 3)])
+    events = stocked.log.events()[base:]
+    assert [e.kind for e in events] == ["RESERVE", "RESERVE"]
+    assert events[0].format() == (
+        "000003 2026-03-01T10:00:00Z RESERVE expires=2026-03-01T10:15:00Z "
+        "order=SO-1 qty=2 sku=BOLT-M8 wh=A"
+    )
+    assert events[1].get("wh") == "B" and events[1].get("qty") == "3"
+    stocked.confirm("SO-1")
+    tail = stocked.log.events()[base + 2:]
+    assert [e.kind for e in tail] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert [e.get("ref") for e in tail[:2]] == ["SO-1", "SO-1"]
+    assert tail[2].get("order") == "SO-1"
+
+
+def test_no_events_on_failures_or_expiry(stocked, clock):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 99)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    clock.advance(timedelta(hours=1))
+    stocked.get_reservation("SO-2")
+    assert len(stocked.log) == before + 1
+
+
+def test_shared_store_shares_reservations(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    other = Inventory(store=stocked.store, clock=stocked.clock)
+    assert other.available("A", "BOLT-M8") == 6
