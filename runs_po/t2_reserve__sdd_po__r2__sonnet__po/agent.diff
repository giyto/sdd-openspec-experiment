@@ -0,0 +1,28 @@
+"""Резервы: TTL по умолчанию, изменяемая запись и расчёт эффективного статуса."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+from .models import ReservationLine, ReservationStatus
+
+DEFAULT_RESERVATION_TTL = timedelta(minutes=15)
+
+
+@dataclass
+class ReservationRecord:
+    """Хранимая запись резерва. Наружу отдаётся только frozen-снимок."""
+
+    order_id: str
+    status: ReservationStatus
+    lines: tuple[ReservationLine, ...]
+    created_at: datetime
+    expires_at: datetime
+
+
+def effective_status(record: ReservationRecord, now: datetime) -> ReservationStatus:
+    """Статус на момент ``now``: только ``ACTIVE`` может стать ``EXPIRED``."""
+    if record.status is ReservationStatus.ACTIVE and now >= record.expires_at:
+        return ReservationStatus.EXPIRED
+    return record.status
