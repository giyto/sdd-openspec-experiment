diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..b2d7d4f
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,317 @@
+from dataclasses import FrozenInstanceError
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationNotFoundError,
+    ReservationStateError,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.models import Reservation, ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL
+
+T0 = datetime(2026, 3, 1, 10, 0, 0, tzinfo=timezone.utc)
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "NUT-M8", 5)
+    return inv
+
+
+def test_models_and_enum():
+    line = ReservationLine("MAIN", "BOLT-M8", 1)
+    res = Reservation("SO-1", (line,), T0, T0 + MIN, ReservationStatus.ACTIVE)
+    with pytest.raises(FrozenInstanceError):
+        res.status = ReservationStatus.EXPIRED
+    assert [s.value for s in ReservationStatus] == ["active", "expired", "confirmed", "cancelled"]
+
+
+def test_errors_hierarchy():
+    for cls in (ReservationNotFoundError, ReservationExpiredError, DuplicateReservationError):
+        err = cls("SO-1")
+        assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+        assert err.order_id == "SO-1"
+    assert ReservationStateError("SO-1", "confirmed").order_id == "SO-1"
+
+
+def test_default_ttl_constant():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+
+
+def test_reserve_keeps_lines_and_default_ttl(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ReservationLine("MAIN", "BOLT-M8", 3)])
+    assert res.lines == (ReservationLine("MAIN", "BOLT-M8", 2), ReservationLine("MAIN", "BOLT-M8", 3))
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0 and res.expires_at == T0 + timedelta(minutes=15)
+    assert stocked.get_reservation("SO-1") == res
+
+
+def test_reserve_multi_warehouse_and_balances(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ("NORTH", "NUT-M8", 5)])
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+    assert stocked.available("MAIN", "BOLT-M8") == 6
+    assert stocked.available("NORTH", "NUT-M8") == 0
+
+
+def test_reserve_sum_of_duplicate_lines(stocked):
+    stocked.issue("MAIN", "BOLT-M8", 6)
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 3)])
+    assert exc.value.requested == 6 and exc.value.available == 4
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0 and len(stocked.log) == n
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_reserve_no_partial(stocked):
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("NORTH", "NUT-M8", 9)])
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0 and len(stocked.log) == n
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 5, "x"])
+def test_reserve_bad_ttl(stocked, ttl):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl)
+
+
+def test_reserve_bad_input(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 0)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO 1", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("MAIN", "NOPE", 1)])
+
+
+def test_reserve_accepts_generator(stocked):
+    stocked.reserve("SO-1", (line for line in [("MAIN", "BOLT-M8", 1)]))
+    assert stocked.reserved("MAIN", "BOLT-M8") == 1
+
+
+def test_duplicate_active_and_confirmed(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    n = len(stocked.log)
+    with pytest.raises(DuplicateReservationError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert exc.value.order_id == "SO-1" and len(stocked.log) == n
+    assert stocked.reserved("MAIN", "BOLT-M8") == 1
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_replaces_expired(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=15))
+    res = stocked.reserve("SO-1", [("NORTH", "NUT-M8", 2)], MIN)
+    assert stocked.get_reservation("SO-1") == res
+    assert res.lines == (ReservationLine("NORTH", "NUT-M8", 2),)
+    assert res.created_at == clock.now() and res.status is ReservationStatus.ACTIVE
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+
+
+def test_reserve_replaces_cancelled(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 7)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert stocked.reserved("MAIN", "BOLT-M8") == 7
+
+
+def test_failed_replacement_keeps_old(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-1")
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 99)])
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CANCELLED
+
+
+def test_expiry_boundary_and_no_log(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    n = len(stocked.log)
+    clock.advance(timedelta(minutes=15) - timedelta(seconds=1))
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+    clock.advance(timedelta(seconds=1))
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == n
+
+
+def test_available_never_negative(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    stocked.adjust("MAIN", "BOLT-M8", 3, "count")
+    assert stocked.reserved("MAIN", "BOLT-M8") == 8
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 1)
+    assert exc.value.available == 0
+
+
+def test_available_unknown_and_zero(inv):
+    with pytest.raises(UnknownSkuError):
+        inv.available("MAIN", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        inv.reserved("MAIN", "NOPE")
+    assert inv.available("MAIN", "OIL-5L") == 0 and inv.reserved("MAIN", "OIL-5L") == 0
+
+
+def test_final_statuses_survive_expiry(stocked, clock):
+    stocked.reserve("A", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("B", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("A")
+    stocked.cancel("B")
+    clock.advance(timedelta(hours=1))
+    assert stocked.get_reservation("A").status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation("B").status is ReservationStatus.CANCELLED
+
+
+def test_not_found(stocked):
+    for op in (stocked.get_reservation, stocked.confirm, stocked.cancel):
+        with pytest.raises(ReservationNotFoundError) as exc:
+            op("NOPE")
+        assert exc.value.order_id == "NOPE"
+    with pytest.raises(ReservationNotFoundError):
+        stocked.extend("NOPE", MIN)
+
+
+def test_reserve_events(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("MAIN", "BOLT-M8", 2), ("NORTH", "NUT-M8", 1)])
+    events = stocked.log.events("RESERVE")
+    assert len(events) == 3
+    assert {e.fields["expires"] for e in events} == {"2026-03-01T10:15:00Z"}
+    assert events[0].fields["order"] == "SO-1" and events[1].fields["qty"] == "2"
+
+
+def test_confirm_full_stock_and_events(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ("MAIN", "BOLT-M8", 6)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    n = len(stocked.log)
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0 and stocked.reserved("MAIN", "BOLT-M8") == 0
+    new = stocked.log.events()[n:]
+    assert [e.kind for e in new] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert [e.fields["qty"] for e in new[:2]] == ["4", "6"]
+    assert all(e.fields["ref"] == "SO-1" for e in new[:2])
+
+
+def test_confirm_errors(stocked, clock):
+    stocked.reserve("A", [("MAIN", "BOLT-M8", 1)], MIN)
+    stocked.reserve("B", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("B")
+    clock.advance(MIN)
+    n = len(stocked.log)
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("A")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("B")
+    stocked.reserve("C", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("C")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("C")
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 9
+    assert len(stocked.log) == n + 2
+
+
+def test_confirm_after_adjust_below_reservation(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ("MAIN", "BOLT-M8", 4)])
+    stocked.adjust("MAIN", "BOLT-M8", 5, "count")
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5 and len(stocked.log) == n
+
+
+def test_cancel_frees_and_is_idempotent(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    res = stocked.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == n
+    assert len(stocked.log.events("RESERVE_CANCEL")) == 1
+
+
+def test_cancel_confirmed_and_expired(stocked, clock):
+    stocked.reserve("A", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("A")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("A")
+    stocked.reserve("B", [("MAIN", "BOLT-M8", 1)], MIN)
+    clock.advance(MIN)
+    n = len(stocked.log)
+    assert stocked.cancel("B").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == n
+
+
+def test_extend_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], MIN)
+    clock.advance(timedelta(seconds=30))
+    res = stocked.extend("SO-1", timedelta(minutes=10))
+    assert res.expires_at == clock.now() + timedelta(minutes=10)
+    assert stocked.get_reservation("SO-1") == res
+    event = stocked.log.events("RESERVE_EXTEND")[0]
+    assert event.fields["order"] == "SO-1" and event.fields["expires"] == "2026-03-01T10:10:30Z"
+
+
+def test_extend_never_shortens(stocked):
+    before = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    n = len(stocked.log)
+    assert stocked.extend("SO-1", MIN) == before
+    assert stocked.extend("SO-1", timedelta(minutes=15)) == before
+    assert stocked.get_reservation("SO-1").expires_at == before.expires_at
+    assert len(stocked.log) == n
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("A", [("MAIN", "BOLT-M8", 1)], MIN)
+    stocked.reserve("B", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("B")
+    with pytest.raises(ValidationError):
+        stocked.extend("A", timedelta(0))
+    with pytest.raises(ReservationStateError):
+        stocked.extend("B", MIN)
+    clock.advance(MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("A", MIN)
+    assert stocked.get_reservation("A").expires_at == T0 + MIN
+
+
+def test_issue_respects_reservations(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 3)
+    assert exc.value.available == 2
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    stocked.issue("MAIN", "BOLT-M8", 2)
+    clock.advance(timedelta(minutes=15))
+    stocked.issue("MAIN", "BOLT-M8", 8)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_transfer_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("MAIN", "NORTH", "BOLT-M8", 3)
+    stocked.transfer("MAIN", "NORTH", "BOLT-M8", 2)
+    assert stocked.on_hand("NORTH", "BOLT-M8") == 2
