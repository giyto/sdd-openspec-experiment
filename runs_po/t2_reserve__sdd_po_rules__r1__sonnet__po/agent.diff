@@ -0,0 +1,51 @@
+"""Вспомогательная логика резервов: нормализация строк и вычисление статуса."""
+
+from __future__ import annotations
+
+import dataclasses
+from datetime import datetime, timedelta
+from typing import Iterable
+
+from .errors import ValidationError
+from .models import Reservation, ReservationLine, ReservationStatus
+
+DEFAULT_RESERVATION_TTL = timedelta(minutes=15)
+
+
+def validate_ttl(ttl: object) -> timedelta:
+    if not isinstance(ttl, timedelta) or ttl <= timedelta(0):
+        raise ValidationError(f"ttl must be a positive timedelta, got {ttl!r}")
+    return ttl
+
+
+def normalize_lines(lines: Iterable[object]) -> tuple[ReservationLine, ...]:
+    """Строки как кортежи ``(warehouse, sku, qty)`` или ``ReservationLine`` (без проверки кодов)."""
+    result: list[ReservationLine] = []
+    for item in lines:
+        if isinstance(item, ReservationLine):
+            result.append(item)
+        elif isinstance(item, (tuple, list)) and len(item) == 3:
+            result.append(ReservationLine(item[0], item[1], item[2]))
+        else:
+            raise ValidationError(f"bad reservation line {item!r}")
+    if not result:
+        raise ValidationError("reservation must have at least one line")
+    return tuple(result)
+
+
+def effective(reservation: Reservation, now: datetime) -> Reservation:
+    """Снимок со статусом на момент ``now``: ``ACTIVE`` при ``now >= expires_at`` — ``EXPIRED``."""
+    if reservation.status is ReservationStatus.ACTIVE and now >= reservation.expires_at:
+        return dataclasses.replace(reservation, status=ReservationStatus.EXPIRED)
+    return reservation
+
+
+def group_totals(lines: Iterable[ReservationLine]) -> dict[tuple[str, str], int]:
+    """Суммы по позициям ``(warehouse, sku)`` в порядке первого появления."""
+    totals: dict[tuple[str, str], int] = {}
+    for line in lines:
+        key = (line.warehouse, line.sku)
+        totals[key] = totals.get(key, 0) + line.qty
+    return totals
+
+
