+            ReservationStatus.ACTIVE,
+            ReservationStatus.CONFIRMED,
+        ):
+            raise DuplicateReservationError(order_id)
+        for line in parsed:
+            self._require_sku(line.sku)
+        for (warehouse, sku), total in group_totals(parsed).items():
+            free = self._available(warehouse, sku, now)
+            if total > free:
+                raise InsufficientStockError(warehouse, sku, total, free)
+        reservation = Reservation(order_id, parsed, now, now + ttl, ReservationStatus.ACTIVE)
+        self._store.put_reservation(reservation)
+        expires = format_timestamp(reservation.expires_at)
+        for line in parsed:
+            self._log.append(
+                now, "RESERVE", order=order_id, wh=line.warehouse, sku=line.sku,
+                qty=line.qty, expires=expires,
+            )
+        logger.info("reserved %d lines for order %s", len(parsed), order_id)
+        return reservation
+
+    def confirm(self, order_id: str) -> Reservation:
+        """Превращает действующий резерв в расход со склада."""
+        now = self._clock.now()
+        current = self._active_or_raise(order_id, now)
+        for (warehouse, sku), total in group_totals(current.lines).items():
+            on_hand = self._store.get_qty(warehouse, sku)
+            if total > on_hand:
+                raise InsufficientStockError(warehouse, sku, total, on_hand)
+        for line in current.lines:
+            qty = self._store.get_qty(line.warehouse, line.sku)
+            self._store.set_qty(line.warehouse, line.sku, qty - line.qty)
+            self._log.append(
+                now, "ISSUE", wh=line.warehouse, sku=line.sku, qty=line.qty, ref=order_id
+            )
+        confirmed = dataclasses.replace(current, status=ReservationStatus.CONFIRMED)
+        self._store.put_reservation(confirmed)
+        self._log.append(now, "RESERVE_CONFIRM", order=order_id)
+        logger.info("confirmed reservation %s", order_id)
+        return confirmed
+
+    def cancel(self, order_id: str) -> Reservation:
+        """Отменяет действующий резерв; повторная отмена и отмена истёкшего — без эффекта."""
+        now = self._clock.now()
+        record = self._store.get_reservation(order_id)
+        if record is None:
+            raise ReservationNotFoundError(order_id)
+        snapshot = effective(record, now)
+        if snapshot.status is ReservationStatus.CONFIRMED:
+            raise ReservationStateError(order_id, snapshot.status.value)
+        if snapshot.status is not ReservationStatus.ACTIVE:
+            return snapshot
+        cancelled = dataclasses.replace(record, status=ReservationStatus.CANCELLED)
+        self._store.put_reservation(cancelled)
+        self._log.append(now, "RESERVE_CANCEL", order=order_id)
+        logger.info("cancelled reservation %s", order_id)
+        return cancelled
+
+    def extend(self, order_id: str, ttl: timedelta) -> Reservation:
+        """Переносит срок на ``now + ttl``; срок никогда не сокращается."""
+        validate_ttl(ttl)
+        now = self._clock.now()
+        current = self._active_or_raise(order_id, now)
+        new_expires = now + ttl
+        if new_expires <= current.expires_at:
+            return current
+        extended = dataclasses.replace(current, expires_at=new_expires)
+        self._store.put_reservation(extended)
+        self._log.append(
+            now, "RESERVE_EXTEND", order=order_id, expires=format_timestamp(new_expires)
+        )
+        logger.info("extended reservation %s", order_id)
+        return extended
+
+    def _active_or_raise(self, order_id: str, now: datetime) -> Reservation:
+        record = self._store.get_reservation(order_id)
+        if record is None:
+            raise ReservationNotFoundError(order_id)
+        snapshot = effective(record, now)
+        if snapshot.status is ReservationStatus.EXPIRED:
+            raise ReservationExpiredError(order_id)
+        if snapshot.status is not ReservationStatus.ACTIVE:
+            raise ReservationStateError(order_id, snapshot.status.value)
+        return record
+
+    def _reserved(self, warehouse: str, sku: str, now: datetime) -> int:
+        return sum(
+            line.qty
+            for reservation in self._store.reservations()
+            if effective(reservation, now).status is ReservationStatus.ACTIVE
+            for line in reservation.lines
+            if line.warehouse == warehouse and line.sku == sku
+        )
+
+    def _available(self, warehouse: str, sku: str, now: datetime) -> int:
+        return max(0, self._store.get_qty(warehouse, sku) - self._reserved(warehouse, sku, now))
+
     # --- служебное ----------------------------------------------------------
 
     def _require_sku(self, sku: str) -> None:
