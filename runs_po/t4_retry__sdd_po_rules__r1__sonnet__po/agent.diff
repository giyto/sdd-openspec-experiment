+class StubRng:
+    def __init__(self, value=1.0):
+        self.value = value
+        self.calls = []
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def failing(exc):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+# -- RetryPolicy --------------------------------------------------------------
+
+
+def test_permanent_error_hierarchy():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_statuses():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert JobStatus.DEAD_LETTERED.is_terminal
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+
+
+def test_unknown_counters_zero():
+    assert m.Metrics().get(m.JOBS_RETRIED) == 0
+    assert (m.JOBS_RETRIED, m.JOBS_DEAD_LETTERED, m.JOBS_REQUEUED) == (
+        "jobs.retried",
+        "jobs.dead_lettered",
+        "jobs.requeued",
+    )
+
+
+def test_defaults_and_list_normalised():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter) == (3, 1.0, 2.0, 60.0, 0.0)
+    assert RetryPolicy(non_retryable=[ValueError, KeyError]).non_retryable == (ValueError, KeyError)
+    with pytest.raises(Exception):
+        p.max_attempts = 5  # type: ignore[misc]
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 1.0, "max_delay": 0.5},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"jitter": float("nan")},
+        {"base_delay": float("nan")},
+        {"factor": "2"},
+        {"max_attempts": None},
+        {"non_retryable": (ValueError("x"),)},
+        {"non_retryable": ("ValueError",)},
+        {"non_retryable": (int,)},
+        {"non_retryable": ValueError},
+    ],
+)
+def test_invalid_policy(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+def test_boundary_policy_ok():
+    RetryPolicy(max_attempts=1, base_delay=0, factor=1, max_delay=0, jitter=1)
+
+
+def test_delay_growth_and_cap():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=10)
+    assert [p.delay_for(i) for i in (1, 2, 3, 5)] == [1, 2, 4, 10]
+
+
