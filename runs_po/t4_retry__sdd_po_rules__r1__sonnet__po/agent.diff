+def test_exhaustion_dead_letter_and_requeue(queue, registry, worker, clock):
+    registry.register("t", failing(TimeoutError("t")))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3))
+    job = queue.enqueue("t")
+    for _ in range(3):
+        worker.run_once()
+        clock.advance(100)
+    assert job.status is JobStatus.DEAD_LETTERED and job.attempts == 3
+    assert queue.dead_letters() == [DeadLetterEntry(job.id, "t", 3, "TimeoutError: t", job.finished_at)]
+    assert queue.metrics.get(m.JOBS_RETRIED) == 2
+    queue.dead_letters().clear()
+    assert len(queue.dead_letters()) == 1
+
+    same = queue.requeue_dead_letter(job.id)
+    assert same is job and job.status is JobStatus.PENDING
+    assert job.attempts == 0 and job.error is None and job.run_at == clock.now()
+    assert queue.dead_letters() == []
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 1
+
+    worker.run_once()  # полный набор попыток: первая ошибка снова повтор
+    assert job.status is JobStatus.RETRY_SCHEDULED and job.attempts == 1
+
+    with pytest.raises(InvalidTransitionError):
+        queue.requeue_dead_letter(job.id)
+    with pytest.raises(JobNotFoundError):
+        queue.requeue_dead_letter("nope")
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 1
+
