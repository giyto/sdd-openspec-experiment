+def test_stats_and_cancel_rules(queue, registry, worker):
+    assert "retry_scheduled" in queue.stats() and "dead_lettered" in queue.stats()
+    registry.register("t", failing(TimeoutError("t")))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=2))
+    a = queue.enqueue("t")
+    worker.run_once()
+    assert queue.cancel(a.id).status is JobStatus.CANCELLED
+    b = queue.enqueue("t")
+    worker.run_once()
+    queue.clock.advance(10)
+    worker.run_once()
+    assert b.status is JobStatus.DEAD_LETTERED
+    with pytest.raises(InvalidTransitionError):
+        queue.cancel(b.id)
+    queue.clock.advance(1000)
+    queue.purge_finished()
+    assert b.id in queue.store
+
