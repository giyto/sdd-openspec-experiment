+def test_end_to_end_success_clears_error(queue, registry, worker, clock):
+    calls = []
+
+    def flaky(job):
+        calls.append(1)
+        if len(calls) < 2:
+            raise TimeoutError("t")
+        return "ok"
+
+    registry.register("t", flaky)
+    queue.set_retry_policy("t", RetryPolicy(base_delay=5))
+    job = queue.enqueue("t")
+    worker.run_pending()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    clock.advance(5)
+    worker.run_pending()
+    assert job.status is JobStatus.SUCCEEDED and job.error is None and job.attempts == 2
+    mt = queue.metrics
+    counts = (mt.get(m.JOBS_RETRIED), mt.get(m.JOBS_STARTED), mt.get(m.JOBS_SUCCEEDED), mt.get(m.JOBS_FAILED))
+    assert counts == (1, 2, 1, 0)
