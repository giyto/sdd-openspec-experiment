+def test_retry_scheduled_and_due(queue, registry, worker, clock):
+    registry.register("t", failing(TimeoutError("t")))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3, base_delay=2))
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=2)
+    assert job.error == "TimeoutError: t"
+    assert queue.metrics.get(m.JOBS_RETRIED) == 1
+    assert worker.run_once() is None
+    clock.advance(2)
+    assert queue.next_due() is job
