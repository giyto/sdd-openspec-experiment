+"""Политика повторов: параметры, расчёт задержки и классификация ошибок."""
+
+from __future__ import annotations
+
+import random
+from dataclasses import dataclass
+from numbers import Real
+
+from .errors import ConfigError, PermanentJobError
+
+
+def _is_number(value: object) -> bool:
+    return isinstance(value, Real) and not isinstance(value, bool)
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Политика повторов задания.
+
+    :param max_attempts: всего попыток, включая первую.
+    :param base_delay: задержка после первой попытки, секунды.
+    :param factor: множитель роста задержки.
+    :param max_delay: жёсткий потолок задержки (джиттер его тоже не превышает).
+    :param jitter: доля разброса задержки, от 0 до 1.
+    :param non_retryable: классы ошибок, после которых повтор не планируется.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.max_attempts, int) or isinstance(self.max_attempts, bool):
+            raise ConfigError("max_attempts must be an integer")
+        for name in ("base_delay", "factor", "max_delay", "jitter"):
+            if not _is_number(getattr(self, name)):
+                raise ConfigError(f"{name} must be a number")
+        if not self.max_attempts >= 1:
+            raise ConfigError("max_attempts must be >= 1")
+        if not self.base_delay >= 0:
+            raise ConfigError("base_delay must be >= 0")
+        if not self.factor >= 1:
+            raise ConfigError("factor must be >= 1")
+        if not self.max_delay >= self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+
+        raw = self.non_retryable
+        if not isinstance(raw, (list, tuple)):
+            raise ConfigError("non_retryable must be a list or tuple of exception classes")
+        for item in raw:
+            if not (isinstance(item, type) and issubclass(item, BaseException)):
+                raise ConfigError(f"non_retryable item {item!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", tuple(raw))
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка в секундах перед следующей попыткой после падения попытки ``attempt``."""
+        if not _is_number(attempt) or not attempt >= 1:
+            raise ConfigError("attempt must be >= 1")
+
+        if self.base_delay == 0:
+            delay = 0.0
+        elif self.factor == 1:
+            delay = float(self.base_delay)
+        else:
+            try:
+                delay = self.base_delay * float(self.factor) ** (attempt - 1)
+            except OverflowError:
+                delay = float(self.max_delay)
+        delay = min(delay, self.max_delay)
+
+        if self.jitter > 0:
+            if rng is None:
+                rng = random.Random()
+            delay = min(delay * rng.uniform(1 - self.jitter, 1 + self.jitter), self.max_delay)
+        return delay
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """``False`` для ``PermanentJobError`` и ошибок из ``non_retryable``."""
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
