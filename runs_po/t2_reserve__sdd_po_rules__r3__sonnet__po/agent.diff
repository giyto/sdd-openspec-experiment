diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..105ff25
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,430 @@
+from dataclasses import FrozenInstanceError
+from datetime import timedelta
+
+import pytest
+
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    Reservation,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationLine,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ReservationStatus,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 10)
+    inv.receive("B", "NUT-M8", 10)
+    return inv
+
+
+# --- модели и ошибки ---------------------------------------------------------
+
+
+def test_default_ttl_and_enum_values():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+    assert {s.value for s in ReservationStatus} == {"ACTIVE", "EXPIRED", "CONFIRMED", "CANCELLED"}
+
+
+def test_snapshot_is_frozen(stocked):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    with pytest.raises(FrozenInstanceError):
+        res.status = ReservationStatus.CANCELLED
+    with pytest.raises(FrozenInstanceError):
+        res.lines[0].qty = 5
+
+
+def test_errors_carry_order_id():
+    for cls in (ReservationNotFoundError, ReservationExpiredError, DuplicateReservationError):
+        exc = cls("SO-9")
+        assert isinstance(exc, ReservationError) and isinstance(exc, WarehouseError)
+        assert exc.order_id == "SO-9"
+    assert ReservationStateError("SO-9", "CONFIRMED", "cancel").order_id == "SO-9"
+
+
+# --- reserve -----------------------------------------------------------------
+
+
+def test_reserve_multiple_warehouses(stocked, clock):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3)])
+    assert isinstance(res, Reservation)
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.lines == (ReservationLine("A", "BOLT-M8", 2), ReservationLine("B", "NUT-M8", 3))
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + DEFAULT_RESERVATION_TTL
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.on_hand("B", "NUT-M8") == 10
+
+
+def test_reserve_explicit_ttl(stocked, clock):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=timedelta(hours=1))
+    assert res.expires_at == clock.now() + timedelta(hours=1)
+
+
+def test_reserve_duplicate_lines_kept(stocked):
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)])
+    assert len(res.lines) == 2
+    assert stocked.reserved("A", "BOLT-M8") == 5
+
+
+def test_reserve_duplicate_lines_sum_exceeds(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 6), ("A", "BOLT-M8", 5)])
+    assert (info.value.requested, info.value.available) == (11, 10)
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_reserve_is_atomic_across_lines(stocked):
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1), ("B", "NUT-M8", 99)])
+    assert stocked.reserved("A", "BOLT-M8") == 0
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 60, None.__class__])
+def test_reserve_bad_ttl(stocked, ttl):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=ttl)
+    assert len(stocked.log) == 2
+
+
+def test_reserve_validation(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    for bad in ("", "SO 1", "A=B"):
+        with pytest.raises(ValidationError):
+            stocked.reserve(bad, [("A", "BOLT-M8", 1)])
+    for qty in (0, True, 1.5, "2"):
+        with pytest.raises(InvalidQuantityError):
+            stocked.reserve("SO-1", [("A", "BOLT-M8", qty)])
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("A", "NOPE", 1)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8")])
+
+
+# --- повторный reserve -------------------------------------------------------
+
+
+def test_reserve_again_active_or_confirmed_fails(stocked):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    before = len(stocked.log)
+    with pytest.raises(DuplicateReservationError) as info:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    assert info.value.order_id == "SO-1"
+    assert stocked.get_reservation("SO-1") == first
+    assert len(stocked.log) == before
+
+    stocked.confirm("SO-1")
+    before = len(stocked.log)
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+    assert len(stocked.log) == before
+
+
+def test_reserve_again_after_cancel_replaces(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("B", "NUT-M8", 2)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation("SO-1").lines == (ReservationLine("B", "NUT-M8", 2),)
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert stocked.reserved("B", "NUT-M8") == 2
+
+
+def test_reserve_again_after_expiry_replaces(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 10)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    res = stocked.reserve("SO-1", [("A", "BOLT-M8", 10)], ttl=timedelta(hours=1))
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + timedelta(hours=1)
+    assert stocked.reserved("A", "BOLT-M8") == 10
+
+
+# --- available / reserved ----------------------------------------------------
+
+
+def test_reserved_and_available(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert (stocked.reserved("A", "BOLT-M8"), stocked.available("A", "BOLT-M8")) == (4, 6)
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.available("NORTH", "BOLT-M8") == 0
+
+
+def test_second_order_sees_remainder(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.reserve("SO-2", [("A", "BOLT-M8", 3)])
+    assert info.value.available == 2
+
+
+def test_available_never_negative(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    stocked.adjust("A", "BOLT-M8", 5, "recount")
+    assert stocked.reserved("A", "BOLT-M8") == 8
+    assert stocked.available("A", "BOLT-M8") == 0
+    assert stocked.on_hand("A", "BOLT-M8") == 5
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    assert info.value.available == 0
+
+
+def test_queries_unknown_sku(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.available("A", "NOPE")
+    with pytest.raises(UnknownSkuError):
+        stocked.reserved("A", "NOPE")
+
+
+# --- истечение ---------------------------------------------------------------
+
+
+def test_expiry_boundary(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    before = len(stocked.log)
+    clock.advance(DEFAULT_RESERVATION_TTL - timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    clock.advance(timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert stocked.available("A", "BOLT-M8") == 10
+    assert len(stocked.log) == before
+
+
+def test_expired_frees_stock_for_others(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 10)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 10)])
+
+
+def test_final_statuses_do_not_expire(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation("SO-2").status is ReservationStatus.CANCELLED
+
+
+def test_snapshot_not_mutated(stocked):
+    snap = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-1")
+    assert snap.status is ReservationStatus.ACTIVE
+
+
+# --- confirm -----------------------------------------------------------------
+
+
+def test_confirm(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("A", "BOLT-M8") == 6
+    assert stocked.reserved("A", "BOLT-M8") == 0
+
+
+def test_confirm_with_zero_available(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 10)])
+    assert stocked.available("A", "BOLT-M8") == 0
+    stocked.confirm("SO-1")
+    assert stocked.on_hand("A", "BOLT-M8") == 0
+
+
+def test_confirm_duplicate_lines_checked_by_sum(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)])
+    stocked.adjust("A", "BOLT-M8", 4, "recount")
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.confirm("SO-1")
+    assert info.value.requested == 5
+    assert stocked.on_hand("A", "BOLT-M8") == 4
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert len(stocked.log) == before
+
+
+def test_confirm_errors(stocked, clock):
+    with pytest.raises(ReservationNotFoundError) as info:
+        stocked.confirm("NOPE")
+    assert info.value.order_id == "NOPE"
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-2")
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    before = stocked.on_hand("A", "BOLT-M8")
+    with pytest.raises(ReservationExpiredError):
+        stocked.confirm("SO-3")
+    assert stocked.on_hand("A", "BOLT-M8") == before
+
+
+# --- cancel ------------------------------------------------------------------
+
+
+def test_cancel_idempotent(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.reserved("A", "BOLT-M8") == 0
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    before = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == before
+
+
+def test_cancel_confirmed_and_missing(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-1")
+    with pytest.raises(ReservationNotFoundError):
+        stocked.cancel("NOPE")
+
+
+def test_cancel_expired_is_noop(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    before = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == before
+
+
+# --- extend ------------------------------------------------------------------
+
+
+def test_extend_is_counted_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(10 * MIN)
+    res = stocked.extend("SO-1", 10 * MIN)
+    assert res.expires_at == clock.now() + 10 * MIN
+    assert res.status is ReservationStatus.ACTIVE
+    last = stocked.log.events()[-1]
+    assert last.kind == "RESERVE_EXTEND" and last.get("order") == "SO-1"
+
+
+def test_extend_never_shortens(stocked, clock):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    before = len(stocked.log)
+    res = stocked.extend("SO-1", 10 * MIN)  # now + 10 < expires_at
+    assert res == first
+    assert len(stocked.log) == before
+    res = stocked.extend("SO-1", DEFAULT_RESERVATION_TTL)  # ровно тот же срок
+    assert res == first
+    assert len(stocked.log) == before
+
+
+def test_extend_errors(stocked, clock):
+    with pytest.raises(ReservationNotFoundError):
+        stocked.extend("NOPE", MIN)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    for bad in (timedelta(0), -MIN, 5):
+        with pytest.raises(ValidationError):
+            stocked.extend("SO-1", bad)
+    stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-1", MIN)
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2", MIN)
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-3", MIN)
+
+
+def test_extend_invalid_ttl_keeps_expiry(stocked):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+    assert stocked.get_reservation("SO-1").expires_at == first.expires_at
+
+
+# --- issue / transfer --------------------------------------------------------
+
+
+def test_issue_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.issue("A", "BOLT-M8", 3)
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert len(stocked.log) == before
+    stocked.issue("A", "BOLT-M8", 2)
+    assert stocked.on_hand("A", "BOLT-M8") == 8
+    assert stocked.available("A", "BOLT-M8") == 0
+
+
+def test_transfer_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("A", "B", "BOLT-M8", 3)
+    stocked.transfer("A", "B", "BOLT-M8", 2)
+    assert stocked.on_hand("B", "BOLT-M8") == 2
+
+
+def test_expired_reservation_does_not_block_issue(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    stocked.issue("A", "BOLT-M8", 10)
+
+
+# --- журнал ------------------------------------------------------------------
+
+
+def test_events(stocked, clock):
+    base = len(stocked.log)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 3)])
+    events = stocked.log.events()[base:]
+    assert [e.kind for e in events] == ["RESERVE", "RESERVE"]
+    assert [(e.get("order"), e.get("wh"), e.get("sku"), e.get("qty")) for e in events] == [
+        ("SO-1", "A", "BOLT-M8", "2"),
+        ("SO-1", "B", "NUT-M8", "3"),
+    ]
+    assert all(e.get("expires") == "2026-03-01T10:15:00Z" for e in events)
+
+    base = len(stocked.log)
+    stocked.confirm("SO-1")
+    events = stocked.log.events()[base:]
+    assert [e.kind for e in events] == ["ISSUE", "ISSUE", "RESERVE_CONFIRM"]
+    assert [e.get("ref") for e in events[:2]] == ["SO-1", "SO-1"]
+    assert events[2].get("order") == "SO-1"
+
+
+def test_extend_and_cancel_events(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    base = len(stocked.log)
+    clock.advance(10 * MIN)
+    stocked.extend("SO-1", 10 * MIN)
+    stocked.cancel("SO-1")
+    events = stocked.log.events()[base:]
+    assert [e.kind for e in events] == ["RESERVE_EXTEND", "RESERVE_CANCEL"]
+    assert events[0].get("expires") == "2026-03-01T10:20:00Z"
+
+
+def test_physical_levels_unaffected(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert {(lv.warehouse, lv.sku): lv.on_hand for lv in stocked.stock_levels()} == {
+        ("A", "BOLT-M8"): 10,
+        ("B", "NUT-M8"): 10,
+    }
