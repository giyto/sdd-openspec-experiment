+def test_rng_usage(queue, registry, clock):
+    from jobq import HandlerRegistry
+
+    policy = RetryPolicy(max_attempts=2, base_delay=10, max_delay=100, jitter=0.5)
+    q = JobQueue(clock=clock, default_retry_policy=policy)
+    reg = HandlerRegistry()
+    reg.register("mail", failing())
+    w = Worker(q, reg, rng=random.Random(42))
+    job = q.enqueue("mail")
+    start = clock.now()
+    w.run_once()
+    expected_rng = random.Random(42)
+    expected = policy.delay_for(1, expected_rng)
+    assert job.run_at == start + timedelta(seconds=expected)
+    assert w._rng.getstate() == expected_rng.getstate()
+    state = w._rng.getstate()
+    clock.set(job.run_at)
+    w.run_once()  # dead-letter: rng не трогается
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert w._rng.getstate() == state
+
