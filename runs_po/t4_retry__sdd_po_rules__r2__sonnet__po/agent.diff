+def test_full_cycle_dead_letter(queue, registry, worker, clock):
+    job = _dead_letter(queue, registry, worker, clock)
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.attempts == 3
+    assert queue.metrics.get("jobs.retried") == 2
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    assert queue.metrics.get("jobs.failed") == 0
+    entries = queue.dead_letters()
+    assert entries == [DeadLetterEntry(job.id, "mail", 3, "TimeoutError: gw", clock.now() - timedelta(seconds=100))]
+    entries.clear()
+    assert len(queue.dead_letters()) == 1
