@@ -0,0 +1,397 @@
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobqError,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+
+
+class FakeRng:
+    def __init__(self, value):
+        self.value = value
+        self.calls = []
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def failing(exc=RuntimeError("boom")):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+# -- errors / models / metrics ------------------------------------------------
+
+
+def test_permanent_error_hierarchy():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_new_statuses():
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert not JobStatus.DEAD_LETTERED.is_terminal
+
+
+def test_counters_default_zero(queue):
+    for name in ("jobs.retried", "jobs.dead_lettered", "jobs.requeued"):
+        assert queue.metrics.get(name) == 0
+
+
+# -- RetryPolicy --------------------------------------------------------------
+
+
+def test_policy_defaults_and_tuple():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter) == (3, 1.0, 2.0, 60.0, 0.0)
+    assert p.non_retryable == ()
+    q = RetryPolicy(non_retryable=[ValueError, KeyError])
+    assert q.non_retryable == (ValueError, KeyError)
+    with pytest.raises(Exception):
+        q.max_attempts = 5
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 10, "max_delay": 5},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"jitter": float("nan")},
+        {"non_retryable": [ValueError("x")]},
+        {"non_retryable": [int]},
+        {"non_retryable": ["ValueError"]},
+    ],
+)
+def test_policy_invalid(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+def test_policy_boundaries():
+    RetryPolicy(max_attempts=1, base_delay=0, factor=1, max_delay=0, jitter=1)
+
+
+def test_delay_growth_and_cap():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=60)
+    assert [p.delay_for(n) for n in (1, 2, 3)] == [1.0, 2.0, 4.0]
+    assert p.delay_for(10) == 60.0
+
+
+@pytest.mark.parametrize("attempt", [5000, 10000])
+def test_delay_huge_attempt(attempt):
+    assert RetryPolicy(max_attempts=10000).delay_for(attempt) == 60.0
+    assert RetryPolicy(base_delay=0).delay_for(attempt) == 0.0
+    assert RetryPolicy(factor=1).delay_for(attempt) == 1.0
+
+
+def test_delay_jitter_is_capped_by_max_delay():
+    rng = FakeRng(1.25)
+    p = RetryPolicy(base_delay=1, max_delay=60, jitter=0.5)
+    assert p.delay_for(10, rng) == 60.0
+    assert rng.calls == [(0.5, 1.5)]
+
+
+def test_delay_jitter_below_cap_is_applied():
+    rng = FakeRng(0.5)
+    assert RetryPolicy(base_delay=1, max_delay=60, jitter=0.5).delay_for(3, rng) == 2.0
+
+
+def test_delay_without_jitter_ignores_rng():
+    rng = object()
+    assert RetryPolicy().delay_for(1, rng) == 1.0
+
+
+def test_delay_invalid_attempt():
+    with pytest.raises(ConfigError):
+        RetryPolicy().delay_for(0)
+
+
+def test_is_retryable():
+    p = RetryPolicy(non_retryable=(ValueError,))
+    assert not p.is_retryable(ValueError())
+    assert not p.is_retryable(UnicodeDecodeError("utf-8", b"", 0, 1, "x"))
+    assert not RetryPolicy().is_retryable(PermanentJobError("no"))
+    assert p.is_retryable(TimeoutError())
+
+
+# -- queue --------------------------------------------------------------------
+
+
+def test_policy_selection(queue):
+    default = RetryPolicy(non_retryable=(ValueError,))
+    q = JobQueue(clock=queue.clock, default_retry_policy=default)
+    assert q.retry_policy_for("mail") is default
+    own = RetryPolicy(max_attempts=5)
+    q.set_retry_policy("mail", own)
+    assert q.retry_policy_for("mail") is own
+    assert q.retry_policy_for("mail").non_retryable == ()
+    q.set_retry_policy("mail", None)
+    assert q.retry_policy_for("mail") is default
+    assert JobQueue().retry_policy_for("mail") is None
+
+
+def test_policy_validation(queue):
+    with pytest.raises(ConfigError):
+        queue.set_retry_policy("", RetryPolicy())
+    with pytest.raises(ConfigError):
+        queue.set_retry_policy("mail", "x")
+    with pytest.raises(ConfigError):
+        JobQueue(default_retry_policy="x")
+
+
+def test_due_includes_retry_scheduled(queue, clock):
+    job = queue.enqueue("mail")
+    queue.mark_running(job.id)
+    queue.mark_retry_scheduled(job.id, "E: x", clock.now() + timedelta(seconds=5))
+    assert queue.next_due() is None
+    clock.advance(5)
