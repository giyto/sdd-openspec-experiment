+def _dead_letter(queue, registry, worker, clock, attempts=3):
+    queue.set_retry_policy("mail", RetryPolicy(max_attempts=attempts))
+    registry.register("mail", failing(TimeoutError("gw")))
+    job = queue.enqueue("mail")
+    for _ in range(attempts):
+        assert worker.run_once() is job
+        clock.advance(100)
+    return job
+
