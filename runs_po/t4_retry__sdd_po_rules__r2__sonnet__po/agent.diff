+"""Политика повторов: параметры, задержка перед следующей попыткой, повторяемость ошибок."""
+
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+from typing import Any
+
+from .errors import ConfigError, PermanentJobError
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Политика повторов задания.
+
+    ``max_attempts`` — всего попыток, включая первую. ``max_delay`` — жёсткий потолок
+    задержки, джиттер его не превышает.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        # проверки вида «не (допустимо)», чтобы NaN отклонялся
+        if not (isinstance(self.max_attempts, int) and self.max_attempts >= 1):
+            raise ConfigError("max_attempts must be an integer >= 1")
+        if not self.base_delay >= 0:
+            raise ConfigError("base_delay must be >= 0")
+        if not self.factor >= 1:
+            raise ConfigError("factor must be >= 1")
+        if not self.max_delay >= self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+        try:
+            classes = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for cls in classes:
+            if not (isinstance(cls, type) and issubclass(cls, BaseException)):
+                raise ConfigError(f"non_retryable item {cls!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", classes)
+
+    def delay_for(self, attempt: int, rng: Any = None) -> float:
+        """Задержка перед следующей попыткой после падения попытки ``attempt`` (с 1)."""
+        if attempt < 1:
+            raise ConfigError("attempt must be >= 1")
+        delay = self._capped_delay(attempt)
+        if self.jitter > 0:
+            source = rng if rng is not None else random
+            delay *= source.uniform(1 - self.jitter, 1 + self.jitter)
+            delay = min(delay, self.max_delay)
+        return delay
+
+    def _capped_delay(self, attempt: int) -> float:
+        if self.base_delay == 0:
+            return 0.0
+        if self.factor == 1:
+            return min(self.base_delay, self.max_delay)
+        try:
+            raw = self.base_delay * self.factor ** (attempt - 1)
+        except OverflowError:
+            return self.max_delay
+        if math.isinf(raw) or math.isnan(raw):
+            return self.max_delay
+        return min(raw, self.max_delay)
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
