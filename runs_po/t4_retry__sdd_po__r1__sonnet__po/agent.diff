+def flaky(fails, exc=TimeoutError):
+    state = {"n": 0}
+
+    def handler(job):
+        state["n"] += 1
+        if state["n"] <= fails:
+            raise exc("boom")
+        return "ok"
+
+    return handler
+
+
+def test_no_policy_fails(queue, registry, worker):
+    registry.register("t", flaky(1))
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+
+
+def test_retry_then_success(queue, registry, clock):
+    rng = FakeRng(1.0)
+    worker = Worker(queue, registry, rng=rng)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3, base_delay=10, jitter=0.1))
+    registry.register("t", flaky(1))
+    job = queue.enqueue("t")
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.error == "TimeoutError: boom"
+    assert job.run_at == clock.now() + timedelta(seconds=10)
+    assert len(rng.calls) == 1
+    assert worker.run_once() is None
+    clock.advance(10)
+    worker.run_once()
+    assert (job.status, job.error, job.attempts) == (JobStatus.SUCCEEDED, None, 2)
+
+
+def test_exhaustion_and_counters(queue, registry, worker, clock):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3, base_delay=1))
+    registry.register("t", flaky(10))
+    job = queue.enqueue("t")
+    for _ in range(3):
+        worker.run_once()
+        clock.advance(100)
+    assert job.status is JobStatus.DEAD_LETTERED
+    m = queue.metrics
+    assert (m.get("jobs.started"), m.get("jobs.retried"), m.get("jobs.dead_lettered"), m.get("jobs.failed")) == (3, 2, 1, 0)
