@@ -0,0 +1,84 @@
+"""Политика повторов: расчёт задержки и классификация ошибок."""
+
+from __future__ import annotations
+
+import math
+import random
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any
+
+from .errors import ConfigError, PermanentJobError
+
+
+def _check_number(name: str, value: Any) -> None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ConfigError(f"{name} must be a number")
+    if not math.isfinite(value):
+        raise ConfigError(f"{name} must be finite")
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Неизменяемая политика повторов.
+
+    ``max_attempts`` — всего попыток, включая первую. ``max_delay`` — жёсткий потолок
+    задержки, в том числе с учётом джиттера.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: Sequence[type[BaseException]] = ()
+
+    def __post_init__(self) -> None:
+        for name in ("max_attempts", "base_delay", "factor", "max_delay", "jitter"):
+            _check_number(name, getattr(self, name))
+        if isinstance(self.max_attempts, float) and not self.max_attempts.is_integer():
+            raise ConfigError("max_attempts must be an integer")
+        if self.max_attempts < 1:
+            raise ConfigError("max_attempts must be >= 1")
+        if self.base_delay < 0:
+            raise ConfigError("base_delay must be >= 0")
+        if self.factor < 1:
+            raise ConfigError("factor must be >= 1")
+        if self.max_delay < self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+        try:
+            classes = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for cls in classes:
+            if not (isinstance(cls, type) and issubclass(cls, BaseException)):
+                raise ConfigError(f"non_retryable item {cls!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", classes)
+
+    def delay_for(self, attempt: int, rng: Any = None) -> float:
+        """Задержка перед следующей попыткой, если упала попытка номер ``attempt`` (с 1).
+
+        Результат никогда не превышает ``max_delay``, в том числе после джиттера.
+        """
+        if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt < 1:
+            raise ConfigError("attempt must be an integer >= 1")
+        if self.factor == 1 or self.base_delay == 0:
+            raw = self.base_delay
+        else:
+            try:
+                raw = self.base_delay * float(self.factor) ** (attempt - 1)
+            except OverflowError:
+                raw = self.max_delay
+        delay = min(raw, self.max_delay)
+        if self.jitter > 0:
+            source = rng if rng is not None else random
+            delay = min(delay * source.uniform(1 - self.jitter, 1 + self.jitter), self.max_delay)
+        return delay
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        """Можно ли повторять задание после этой ошибки."""
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, tuple(self.non_retryable))
