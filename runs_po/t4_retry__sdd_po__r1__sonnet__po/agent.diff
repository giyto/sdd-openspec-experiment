+def test_dead_letters_order_and_requeue(queue, clock):
+    a = queue.enqueue("t")
+    b = queue.enqueue("t")
+    for j in (a, b):
+        queue.mark_running(j.id)
+        queue.mark_dead_lettered(j.id, "E: x")
+    entries = queue.dead_letters()
+    assert [e.job_id for e in entries] == [a.id, b.id]
+    assert entries[0] == DeadLetterEntry(a.id, "t", 1, "E: x", clock.now())
+    entries.clear()
+    assert len(queue.dead_letters()) == 2
+
+    clock.advance(10)
+    job = queue.requeue_dead_letter(a.id)
+    assert job is a
+    assert (a.status, a.run_at, a.error, a.finished_at, a.attempts) == (
+        JobStatus.PENDING,
+        clock.now(),
+        None,
+        None,
+        0,
+    )
+    assert [e.job_id for e in queue.dead_letters()] == [b.id]
+    assert queue.metrics.get("jobs.requeued") == 1
+    assert queue.metrics.get("jobs.dead_lettered") == 2
