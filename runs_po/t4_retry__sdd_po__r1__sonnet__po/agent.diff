+def test_requeue_resets_attempts_end_to_end():
+    clock = ManualClock(START)
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy(max_attempts=3, base_delay=1))
+    registry = HandlerRegistry()
+    state = {"fail": True}
+
+    def handler(job):
+        if state["fail"]:
+            raise TimeoutError("down")
+        return "ok"
+
+    registry.register("t", handler)
+    worker = Worker(queue, registry)
+    job = queue.enqueue("t")
+    for _ in range(3):
+        worker.run_once()
+        clock.advance(100)
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert "В dead-letter" in render_report(queue)
+
+    queue.requeue_dead_letter(job.id)
+    assert job.attempts == 0
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.attempts == 1
+    assert "Ожидает повтора" in render_report(queue)
+
+    state["fail"] = False
+    clock.advance(100)
+    worker.run_once()
+    assert job.status is JobStatus.SUCCEEDED and job.error is None
+    m = queue.metrics
+    assert (m.get("jobs.retried"), m.get("jobs.dead_lettered"), m.get("jobs.requeued")) == (3, 1, 1)
+
