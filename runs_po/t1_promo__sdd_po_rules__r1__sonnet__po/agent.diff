--- /dev/null
+++ b/tests/test_promo_errors.py
@@ -0,0 +1,32 @@
+import pytest
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+
+CHILDREN = [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError]
+
+
+@pytest.mark.parametrize("cls", CHILDREN)
+def test_children_derive_from_promo_error(cls):
+    assert issubclass(cls, PromoError)
+    assert issubclass(cls, ShopError)
+    assert not issubclass(cls, ValidationError)
+    assert PromoError in cls.__bases__
+
+
+@pytest.mark.parametrize("cls", CHILDREN)
+def test_children_are_independent(cls):
+    for other in CHILDREN:
+        if other is not cls:
+            assert not issubclass(cls, other)
+
+
+def test_promo_error_is_not_validation_error():
+    assert issubclass(PromoError, ShopError)
+    assert not issubclass(PromoError, ValidationError)
diff --git a/tests/test_promo_registry.py b/tests/test_promo_registry.py
new file mode 100644
index 0000000..76827f8
--- /dev/null
+++ b/tests/test_promo_registry.py
@@ -0,0 +1,114 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+T0 = datetime(2026, 6, 1, tzinfo=timezone.utc)
+
+
+def promo(code="SUMMER10", **kw):
+    return PromoCode(code, DiscountKind.PERCENT, Decimal("10"), **kw)
+
+
+@pytest.fixture
+def clock():
+    return FixedClock(T0)
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def test_resolve_ignores_case_and_spaces(registry):
+    p = promo()
+    registry.add(p)
+    assert registry.resolve("  summer10 ") is p
+
+
+def test_duplicate_rejected(registry):
+    p = promo()
+    registry.add(p)
+    with pytest.raises(ValidationError):
+        registry.add(promo("summer10"))
+    assert registry.resolve("SUMMER10") is p
+
+
+@pytest.mark.parametrize("code", ["NOPE", "", "   "])
+def test_unknown(registry, code):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve(code)
+
+
+def test_not_started(registry):
+    registry.add(promo(starts_at=T0 + timedelta(seconds=1)))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_start_inclusive(registry):
+    registry.add(promo(starts_at=T0))
+    registry.resolve("SUMMER10")
+
+
+def test_end_exclusive(registry, clock):
+    registry.add(promo(expires_at=T0))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+    clock.set(T0 - timedelta(microseconds=1))
+    registry.resolve("SUMMER10")
+
+
+def test_check_order_expired_before_limit(registry):
+    registry.add(promo(expires_at=T0, max_uses=1))
+    registry.consume("SUMMER10")
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_limit(registry):
+    registry.add(promo(max_uses=2))
+    registry.consume("SUMMER10")
+    registry.resolve("SUMMER10")
+    registry.consume("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.consume("SUMMER10")
+    assert registry.uses("SUMMER10") == 2
+
+
+def test_resolve_does_not_consume(registry):
+    registry.add(promo(max_uses=1))
+    registry.resolve("SUMMER10")
+    registry.resolve("SUMMER10")
+    assert registry.uses(" summer10") == 0
+
+
+def test_uses_unknown(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE")
+
+
+def test_release(registry):
+    registry.add(promo(max_uses=1))
+    registry.consume("SUMMER10")
+    registry.release("summer10")
+    assert registry.uses("SUMMER10") == 0
+    registry.release("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    registry.resolve("SUMMER10")
+
+
+def test_release_unknown(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.release("NOPE")
