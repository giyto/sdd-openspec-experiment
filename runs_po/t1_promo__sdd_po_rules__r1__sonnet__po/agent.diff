+def _line_discounts(cart: Cart, promo: PromoCode | None) -> list[Decimal]:
+    """Per-line discounts in cart order; the sum is exactly the promo discount."""
+    lines = cart.lines
+    if promo is None:
+        return [ZERO] * len(lines)
+
+    eligible = [
+        line.product.category is not Category.GIFT_CARD
+        and line.product.category not in promo.excluded_categories
+        for line in lines
+    ]
+    base = sum_money(line.amount for line, ok in zip(lines, eligible) if ok)
+    if not any(eligible):
+        raise PromoConditionsError(f"promo code {promo.code} has no eligible items in the order")
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"promo code {promo.code} requires eligible items for at least {promo.min_order_amount}"
+        )
+
+    if promo.kind is DiscountKind.PERCENT:
+        total_discount = quantize_money(base * promo.value / 100)
+    else:
+        total_discount = min(promo.value, base)
+
+    discount_cents = int(total_discount * 100)
+    base_cents = int(base * 100)
+    floors: dict[int, int] = {}
+    remainders: dict[int, int] = {}
+    for index, (line, ok) in enumerate(zip(lines, eligible)):
+        if ok:
+            floors[index], remainders[index] = divmod(
+                discount_cents * int(line.amount * 100), base_cents
+            )
+    leftover = discount_cents - sum(floors.values())
+    for index in sorted(remainders, key=lambda i: (-remainders[i], i))[:leftover]:
+        floors[index] += 1
+    return [Decimal(floors.get(index, 0)).scaleb(-2).quantize(CENT) for index in range(len(lines))]
