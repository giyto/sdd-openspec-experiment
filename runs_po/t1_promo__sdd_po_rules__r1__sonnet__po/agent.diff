@@ -0,0 +1,95 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.errors import ValidationError
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+T1 = datetime(2026, 1, 1, tzinfo=timezone.utc)
+T2 = datetime(2026, 2, 1, tzinfo=timezone.utc)
+
+
+def make(**kw):
+    args = dict(code="SUMMER10", kind=DiscountKind.PERCENT, value=D("10"))
+    args.update(kw)
+    return PromoCode(**args)
+
+
+def test_code_is_normalized():
+    assert make(code="  summer10 ").code == "SUMMER10"
+
+
+def test_defaults():
+    p = make()
+    assert p.min_order_amount == D("0.00")
+    assert p.starts_at is None and p.expires_at is None and p.max_uses is None
+    assert p.excluded_categories == frozenset()
+
+
+def test_kinds():
+    assert {k.name for k in DiscountKind} == {"PERCENT", "FIXED"}
+
+
+@pytest.mark.parametrize("code", ["   ", "", 5])
+def test_bad_code(code):
+    with pytest.raises(ValidationError):
+        make(code=code)
+
+
+@pytest.mark.parametrize(
+    "kind,value",
+    [
+        (DiscountKind.PERCENT, D("0")),
+        (DiscountKind.PERCENT, D("100.01")),
+        (DiscountKind.PERCENT, D("-1")),
+        (DiscountKind.FIXED, D("0")),
+        (DiscountKind.FIXED, D("10.001")),
+        (DiscountKind.PERCENT, 10),
+        (DiscountKind.FIXED, 10.0),
+    ],
+)
+def test_bad_value(kind, value):
+    with pytest.raises(ValidationError):
+        make(kind=kind, value=value)
+
+
+def test_percent_100_ok_and_fractional_percent_ok():
+    make(value=D("100"))
+    make(value=D("12.5"))
+
+
+@pytest.mark.parametrize("amount", [D("-1"), D("1.001"), 5])
+def test_bad_min_order(amount):
+    with pytest.raises(ValidationError):
+        make(min_order_amount=amount)
+
+
+@pytest.mark.parametrize(
+    "kw",
+    [
+        {"starts_at": T2, "expires_at": T1},
+        {"starts_at": T1, "expires_at": T1},
+        {"starts_at": datetime(2026, 1, 1)},
+        {"expires_at": datetime(2026, 1, 1)},
+        {"max_uses": 0},
+        {"max_uses": True},
+        {"max_uses": 1.5},
+        {"excluded_categories": frozenset({"books"})},
+    ],
+)
+def test_bad_other_fields(kw):
+    with pytest.raises(ValidationError):
+        make(**kw)
+
+
+def test_valid_full():
+    p = make(starts_at=T1, expires_at=T2, max_uses=3, excluded_categories={Category.BOOKS})
+    assert p.excluded_categories == frozenset({Category.BOOKS})
+
+
+def test_frozen():
+    with pytest.raises(Exception):
+        make().value = D("5")
diff --git a/tests/test_promo_errors.py b/tests/test_promo_errors.py
new file mode 100644
