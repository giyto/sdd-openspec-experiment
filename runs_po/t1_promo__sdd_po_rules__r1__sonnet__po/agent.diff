+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import LineTotal, OrderTotal, ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def pc(kind=DiscountKind.PERCENT, value="10", **kw):
+    return PromoCode("CODE", kind, D(value), **kw)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def prod(sku, price, category=Category.ELECTRONICS):
+    return Product(sku, sku, D(price), category)
+
+
+def test_backward_compatible(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 2))
+    t = calculate_total(cart)
+    assert t.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in t.lines)
+    assert t.total == t.subtotal + t.shipping + t.tax
+
+
+def test_promo_is_keyword_only(products):
+    with pytest.raises(TypeError):
+        calculate_total(cart_of((products["book"], 1)), None, None, pc())
+
+
+def test_default_discount_fields_are_last():
+    assert LineTotal.__dataclass_fields__["discount"].default == D("0.00")
+    assert OrderTotal.__dataclass_fields__["discount"].default == D("0.00")
+    assert list(OrderTotal.__dataclass_fields__)[-1] == "discount"
+    assert list(LineTotal.__dataclass_fields__)[-1] == "discount"
+
+
+def test_percent_rounding():
+    cart = cart_of((prod("A-1", "100.05"), 1))
+    assert calculate_total(cart, promo=pc()).discount == D("10.01")
+
+
+def test_fixed_capped_at_base():
+    cart = cart_of((prod("A-1", "500.00"), 1))
+    t = calculate_total(cart, promo=pc(DiscountKind.FIXED, "800"))
+    assert t.discount == D("500.00")
+    assert t.lines[0].discount == D("500.00")
+    assert t.lines[0].tax == D("0.00")
+
+
+def test_gift_card_and_excluded(products):
+    cart = cart_of((products["book"], 1), (products["shirt"], 1), (products["gift"], 1))
+    t = calculate_total(cart, promo=pc(excluded_categories={Category.BOOKS}))
+    by_sku = {line.sku: line for line in t.lines}
+    assert by_sku["BOOK-1"].discount == D("0.00")
+    assert by_sku["GIFT-1000"].discount == D("0.00")
+    assert by_sku["SHIRT-1"].discount == D("99.90")
+    assert t.discount == D("99.90")
+
+
+def test_gift_cards_never_discounted(products):
+    cart = cart_of((products["gift"], 1), (products["book"], 1))
+    t = calculate_total(cart, promo=pc())
+    assert t.lines[0].discount == D("0.00")
+    assert t.lines[1].discount == D("45.00")
+
+
+def test_only_gift_cards(products):
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=pc())
+
+
+def test_all_excluded(products):
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart_of((products["book"], 1)), promo=pc(excluded_categories={Category.BOOKS})
+        )
+
+
+def test_min_order_boundary():
+    cart = cart_of((prod("A-1", "999.99"), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pc(min_order_amount=D("1000.00")))
+    cart = cart_of((prod("A-1", "1000.00"), 1))
+    assert calculate_total(cart, promo=pc(min_order_amount=D("1000.00"))).discount == D("100.00")
+
+
+def test_min_order_counts_only_eligible(products):
+    cart = cart_of((products["phone"], 1), (products["gift"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pc(min_order_amount=D("3000.00")))
+
+
+def test_split_three_equal_lines():
+    cart = cart_of(*[(prod(f"A-{i}", "10.00"), 1) for i in range(3)])
+    t = calculate_total(cart, promo=pc(DiscountKind.FIXED, "10"))
+    assert [line.discount for line in t.lines] == [D("3.34"), D("3.33"), D("3.33")]
+    assert t.discount == D("10.00")
+
+
+def test_split_invariants():
+    cart = cart_of(
+        (prod("A-1", "33.33"), 1),
+        (prod("A-2", "66.67"), 1),
+        (prod("A-3", "0.01"), 1),
+        (prod("A-4", "19.99"), 3),
+    )
+    for value in ("0.01", "0.02", "7.77", "50", "99.99", "123.45"):
+        t = calculate_total(cart, promo=pc(DiscountKind.FIXED, value))
+        assert sum(line.discount for line in t.lines) == t.discount
+        assert all(D(0) <= line.discount <= line.amount for line in t.lines)
+        assert t.total == t.subtotal - t.discount + t.shipping + t.tax
+
+
+def test_tax_after_discount():
+    t = calculate_total(cart_of((prod("A-1", "1000.00"), 1)), promo=pc(DiscountKind.FIXED, "100"))
+    assert t.lines[0].tax == D("180.00")
+    assert t.tax == D("180.00")
+    assert t.total == D("1000.00") - D("100.00") + t.shipping + D("180.00")
+
+
+def test_promo_none_equals_no_promo(products):
+    cart = cart_of((products["phone"], 1))
+    assert calculate_total(cart, promo=None) == calculate_total(cart)
+
+
+def test_shipping_becomes_paid_when_discount_drops_below_threshold():
+    cart = cart_of((prod("A-1", "3000.00"), 1))
+    assert calculate_total(cart).shipping == D("0.00")
+    t = calculate_total(cart, promo=pc())
+    assert t.subtotal == D("3000.00")
+    assert t.discount == D("300.00")
+    assert t.shipping == D("299.00")
+    assert t.total == D("3000.00") - D("300.00") + D("299.00") + t.tax
+
+
+def test_shipping_free_when_after_discount_reaches_threshold():
+    cart = cart_of((prod("A-1", "3400.00"), 1))
+    assert calculate_total(cart, promo=pc()).shipping == D("0.00")
+    cart = cart_of((prod("A-1", "3000.00"), 1))
+    assert calculate_total(cart, promo=pc(DiscountKind.FIXED, "0.01")).shipping == D("299.00")
+
+
+def test_shipping_fee_not_discounted():
+    cart = cart_of((prod("A-1", "100.00"), 1))
+    t = calculate_total(cart, promo=pc(value="100"))
+    assert t.discount == D("100.00")
+    assert t.shipping == D("299.00")
+    assert t.total == D("299.00")
+
+
+def test_expired_code_is_not_checked_here():
+    p = pc(
+        starts_at=datetime(2000, 1, 1, tzinfo=timezone.utc),
+        expires_at=datetime(2000, 1, 2, tzinfo=timezone.utc),
+    )
+    assert calculate_total(cart_of((prod("A-1", "100.00"), 1)), promo=p).discount == D("10.00")
+
+
+def test_custom_shipping_policy_uses_post_discount_amount():
+    cart = cart_of((prod("A-1", "1000.00"), 1))
+    policy = ShippingPolicy(fee=D("50.00"), free_threshold=D("1000.00"))
+    assert calculate_total(cart, policy).shipping == D("0.00")
+    assert calculate_total(cart, policy, promo=pc()).shipping == D("50.00")
