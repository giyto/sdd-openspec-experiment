index 0000000..e3572a1
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,145 @@
+"""Promo codes: the code model and the registry that tracks validity and usage."""
+
+from __future__ import annotations
+
+import logging
+import threading
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import PromoConditionsError, PromoExpiredError, UnknownPromoCodeError, ValidationError
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _is_aware(value: datetime) -> bool:
+    return value.tzinfo is not None and value.utcoffset() is not None
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError(f"kind of {self.code} must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError(f"value of {self.code} must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError(f"percent of {self.code} must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"fixed discount of {self.code} must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError(f"fixed discount of {self.code} has more than two digits")
+        if not isinstance(self.min_order_amount, Decimal) or not self.min_order_amount.is_finite():
+            raise ValidationError(f"min_order_amount of {self.code} must be a finite Decimal")
+        if self.min_order_amount < 0:
+            raise ValidationError(f"min_order_amount of {self.code} must not be negative")
+        if to_money(self.min_order_amount) != self.min_order_amount:
+            raise ValidationError(f"min_order_amount of {self.code} has more than two digits")
+        for name in ("starts_at", "expires_at"):
+            moment = getattr(self, name)
+            if moment is not None and (not isinstance(moment, datetime) or not _is_aware(moment)):
+                raise ValidationError(f"{name} of {self.code} must be an aware datetime")
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError(f"starts_at of {self.code} must be before expires_at")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError(f"max_uses of {self.code} must be None or an integer >= 1")
+        try:
+            categories = frozenset(self.excluded_categories)
+        except TypeError:
+            raise ValidationError("excluded_categories must be a set of Category") from None
+        if not all(isinstance(item, Category) for item in categories):
+            raise ValidationError("excluded_categories must contain only Category values")
+        object.__setattr__(self, "excluded_categories", categories)
+
+
+class PromoRegistry:
+    """Registered promo codes and their usage counters."""
+
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._codes: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+        self._lock = threading.Lock()
+
+    def add(self, promo: PromoCode) -> None:
+        key = normalize_key(promo.code)
+        with self._lock:
+            if key in self._codes:
+                raise ValidationError(f"duplicate promo code: {key}")
+            self._codes[key] = promo
+            self._uses[key] = 0
+        logger.debug("promo: added %s", key)
+
+    def resolve(self, code: str) -> PromoCode:
+        """Find an active code with remaining uses; does not consume a use."""
+        key = normalize_key(code)
+        with self._lock:
+            promo = self._codes.get(key)
+            if promo is None:
+                raise UnknownPromoCodeError(key)
+            now = self._clock.now()
+            if promo.starts_at is not None and now < promo.starts_at:
+                raise PromoExpiredError(f"promo code {key} is not active yet")
+            if promo.expires_at is not None and now >= promo.expires_at:
+                raise PromoExpiredError(f"promo code {key} has expired")
+            self._check_limit(promo)
+            return promo
+
+    def uses(self, code: str) -> int:
+        key = normalize_key(code)
+        with self._lock:
+            if key not in self._codes:
+                raise UnknownPromoCodeError(key)
+            return self._uses[key]
+
+    def consume(self, code: str) -> None:
+        """Count one use, re-checking the limit atomically."""
+        key = normalize_key(code)
+        with self._lock:
+            promo = self._codes.get(key)
+            if promo is None:
+                raise UnknownPromoCodeError(key)
+            self._check_limit(promo)
+            self._uses[key] += 1
+
+    def release(self, code: str) -> None:
+        """Give back one use (order cancelled); the counter never goes below zero."""
+        key = normalize_key(code)
+        with self._lock:
+            if key not in self._codes:
+                raise UnknownPromoCodeError(key)
+            self._uses[key] = max(0, self._uses[key] - 1)
+
+    def _check_limit(self, promo: PromoCode) -> None:
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} usage limit reached")
