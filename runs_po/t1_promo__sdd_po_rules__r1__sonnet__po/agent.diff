+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    EmptyCartError,
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def cart(products):
+    c = Cart()
+    c.add(products["shirt"], 2)
+    return c
+
+
+def add(registry, **kw):
+    registry.add(PromoCode("SUMMER10", DiscountKind.PERCENT, D("10"), **kw))
+
+
+def test_blank_codes_mean_no_promo(clock, cart):
+    plain = OrderService(clock=clock)
+    for code in (None, "", "   "):
+        assert plain.quote(cart, code) == plain.quote(cart)
+        assert plain.place_order(cart, code).promo_code is None
+
+
+def test_normalized_code_stored(service, registry, cart):
+    add(registry)
+    order = service.place_order(cart, " summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == D("199.80")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_quote_does_not_consume(service, registry, cart):
+    add(registry, max_uses=1)
+    assert service.quote(cart, "summer10").discount == D("199.80")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def test_no_registry(clock, cart):
+    with pytest.raises(UnknownPromoCodeError):
+        OrderService(clock=clock).quote(cart, "SUMMER10")
+
+
+def test_unknown_code(service, cart):
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart, "NOPE")
+
+
+def test_failed_attempts_do_not_consume(service, registry, cart):
+    add(registry, min_order_amount=D("100000.00"))
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER10")
+    with pytest.raises(EmptyCartError):
+        service.place_order(Cart(), "SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def test_max_uses_one(service, registry, cart):
+    add(registry, max_uses=1)
+    service.place_order(cart, "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER10")
+    assert len(service.store) == 1
+
+
+def test_check_order(clock, registry, cart):
+    add(
+        registry,
+        expires_at=clock.now() + timedelta(days=1),
+        max_uses=1,
+        min_order_amount=D("100000.00"),
+    )
+    service = OrderService(clock=clock, promos=registry)
+    with pytest.raises(PromoConditionsError):  # conditions fail, limit not reached
+        service.quote(cart, "SUMMER10")
+    registry.consume("SUMMER10")
+    with pytest.raises(PromoConditionsError):  # limit reached
+        service.quote(cart, "SUMMER10")
+    clock.advance(timedelta(days=2))
+    with pytest.raises(PromoExpiredError):  # expiry wins over limit
+        service.quote(cart, "SUMMER10")
+
+
+def test_cancel_releases_use(service, registry, cart):
+    add(registry, max_uses=1)
+    order = service.place_order(cart, "SUMMER10")
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+    assert service.place_order(cart, "SUMMER10").promo_code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_cancel_without_code_keeps_counters(service, registry, cart):
+    add(registry)
+    service.place_order(cart, "SUMMER10")
+    other = service.place_order(cart)
+    service.cancel(other.order_id)
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_second_cancel_does_not_release_twice(service, registry, cart):
+    add(registry)
+    first = service.place_order(cart, "SUMMER10")
+    service.place_order(cart, "SUMMER10")
+    service.cancel(first.order_id)
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(first.order_id)
+    assert registry.uses("SUMMER10") == 1
