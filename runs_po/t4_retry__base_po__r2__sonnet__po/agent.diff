diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..eb799b6
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,127 @@
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    HandlerRegistry,
+    JobQueue,
+    JobStatus,
+    ManualClock,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+
+
+def make(policy=None, exc=None):
+    clock = ManualClock()
+    q = JobQueue(clock=clock, default_retry_policy=policy)
+    reg = HandlerRegistry()
+
+    def boom(job):
+        raise exc if exc is not None else RuntimeError("x")
+
+    reg.register("t", boom)
+    return clock, q, Worker(q, reg)
+
+
+def test_delay_and_overflow():
+    p = RetryPolicy(max_attempts=10000, base_delay=1, factor=2, max_delay=60)
+    assert p.delay_for(1) == 1 and p.delay_for(4) == 8 and p.delay_for(5000) == 60
+    assert RetryPolicy(base_delay=0).delay_for(5000) == 0
+    assert p.delay_for(10**1000) == 60
+
+
+def test_validation():
+    for kw in [
+        dict(max_attempts=0),
+        dict(base_delay=-1),
+        dict(factor=0.5),
+        dict(max_delay=0.5),
+        dict(jitter=2),
+        dict(non_retryable=[int]),
+    ]:
+        with pytest.raises(ConfigError):
+            RetryPolicy(**kw)
+    with pytest.raises(ConfigError):
+        RetryPolicy().delay_for(0)
+    assert RetryPolicy(non_retryable=[ValueError]).non_retryable == (ValueError,)
+
+
+def test_jitter_rng_only_when_scheduling():
+    class R(random.Random):
+        n = 0
+
+        def uniform(self, a, b):
+            self.n += 1
+            return 1.0
+
+    rng = R()
+    clock = ManualClock()
+    q = JobQueue(clock=clock, default_retry_policy=RetryPolicy(max_attempts=2, jitter=0.5))
+    reg = HandlerRegistry()
+    reg.register("t", lambda j: 1 / 0)
+    w = Worker(q, reg, rng=rng)
+    q.enqueue("t")
+    w.run_once()
+    assert rng.n == 1
+    clock.advance(1)
+    w.run_once()
+    assert rng.n == 1
+
+
+def test_retry_then_dead_letter_and_requeue():
+    clock, q, w = make(RetryPolicy(max_attempts=2))
+    job = q.enqueue("t")
+    w.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == clock.now() + timedelta(seconds=1)
+    assert w.run_once() is None
+    clock.advance(1)
+    w.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert [e.job_id for e in q.dead_letters()] == [job.id]
+    assert q.metrics.get("jobs.retried") == 1
+    assert q.metrics.get("jobs.dead_lettered") == 1
+    assert q.requeue_dead_letter(job.id) is job
+    assert job.status is JobStatus.PENDING and job.error is None and not q.dead_letters()
+    assert q.metrics.get("jobs.requeued") == 1
+    assert "В dead-letter" in render_report(q)
+
+
+def test_non_retryable_and_no_policy():
+    _, q, w = make(RetryPolicy(max_attempts=1), exc=PermanentJobError("no"))
+    q.enqueue("t")
+    assert w.run_once().status is JobStatus.FAILED
+    _, q, w = make(None)
+    q.enqueue("t")
+    assert w.run_once().status is JobStatus.FAILED
+    _, q, w = make(RetryPolicy(max_attempts=1))
+    q.enqueue("t")
+    assert w.run_once().status is JobStatus.DEAD_LETTERED
+
+
+def test_type_policy_replaces_default():
+    _, q, _ = make(RetryPolicy(max_attempts=5))
+    q.set_retry_policy("t", RetryPolicy(max_attempts=2))
+    assert q.retry_policy_for("t").max_attempts == 2
+    q.set_retry_policy("t", None)
+    assert q.retry_policy_for("t").max_attempts == 5
+
+
+def test_jitter_never_exceeds_max_delay():
+    p = RetryPolicy(base_delay=10, max_delay=10, jitter=1.0)
+    rng = random.Random(1)
+    assert all(p.delay_for(3, rng) <= 10 for _ in range(200))
+
+
+def test_requeue_resets_attempts():
+    _, q, w = make(RetryPolicy(max_attempts=1))
+    job = q.enqueue("t")
+    w.run_once()
+    assert job.attempts == 1
+    q.requeue_dead_letter(job.id)
+    assert job.attempts == 0
