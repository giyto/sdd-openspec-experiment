+def _line_discounts(cart: Cart, promo: PromoCode | None) -> list[Decimal]:
+    """Per-line discounts in cart order; they add up exactly to the order discount."""
+    if promo is None:
+        return [ZERO for _ in cart.lines]
+    eligible = [
+        line.product.category is not Category.GIFT_CARD
+        and line.product.category not in promo.excluded_categories
+        for line in cart.lines
+    ]
+    amounts = [line.amount if ok else ZERO for line, ok in zip(cart.lines, eligible)]
+    eligible_sum = sum_money(amounts)
+    if not any(eligible):
+        raise PromoConditionsError(f"promo {promo.code}: no eligible items in the cart")
+    if eligible_sum < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"promo {promo.code}: eligible items sum {eligible_sum} is below "
+            f"the minimum {promo.min_order_amount}"
+        )
+    if promo.kind is DiscountKind.PERCENT:
+        discount = quantize_money(eligible_sum * promo.value / Decimal(100))
+    else:
+        discount = min(promo.value, eligible_sum)
+    return _allocate(discount, amounts)
+
+
+def _allocate(discount: Decimal, amounts: list[Decimal]) -> list[Decimal]:
+    """Largest remainder method in kopecks; ties go to the line earlier in the cart."""
+    total_cents = _cents(sum_money(amounts))
+    discount_cents = _cents(discount)
+    if total_cents == 0 or discount_cents == 0:
+        return [ZERO for _ in amounts]
+    shares = [discount_cents * _cents(a) for a in amounts]
+    parts = [share // total_cents for share in shares]
+    remainders = [share % total_cents for share in shares]
+    leftover = discount_cents - sum(parts)
+    by_remainder = sorted(range(len(amounts)), key=lambda i: (-remainders[i], i))
+    for i in by_remainder[:leftover]:
+        parts[i] += 1
+    return [Decimal(part).scaleb(-2).quantize(CENT) for part in parts]
+
+
+def _cents(amount: Decimal) -> int:
+    return int(amount.scaleb(2))
