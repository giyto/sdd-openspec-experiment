index 0000000..13eb496
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,148 @@
+"""Promo codes and the registry that resolves them and counts their usage."""
+
+from __future__ import annotations
+
+import logging
+import threading
+from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock, SystemClock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    excluded_categories: frozenset[Category] = frozenset()
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+
+    def __post_init__(self) -> None:
+        code = normalize_key(self.code)
+        if not code:
+            raise ValidationError("promo code must not be empty")
+        object.__setattr__(self, "code", code)
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError("promo kind must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError(f"promo {code}: value must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError(f"promo {code}: percent must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"promo {code}: fixed amount must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError(f"promo {code}: more than two fractional digits")
+        if not isinstance(self.min_order_amount, Decimal) or not self.min_order_amount.is_finite():
+            raise ValidationError(f"promo {code}: min_order_amount must be a finite Decimal")
+        if self.min_order_amount < 0:
+            raise ValidationError(f"promo {code}: min_order_amount must not be negative")
+        object.__setattr__(self, "excluded_categories", frozenset(self.excluded_categories))
+        if not all(isinstance(c, Category) for c in self.excluded_categories):
+            raise ValidationError(f"promo {code}: excluded_categories must be Categories")
+        for name in ("starts_at", "expires_at"):
+            moment = getattr(self, name)
+            if moment is not None and (
+                not isinstance(moment, datetime)
+                or moment.tzinfo is None
+                or moment.utcoffset() is None
+            ):
+                raise ValidationError(f"promo {code}: {name} must be an aware datetime")
+        if self.starts_at is not None and self.expires_at is not None:
+            if self.starts_at >= self.expires_at:
+                raise ValidationError(f"promo {code}: starts_at must be before expires_at")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError(f"promo {code}: max_uses must be None or an integer >= 1")
+
+    def is_active_at(self, moment: datetime) -> bool:
+        """Validity interval is half-open: ``[starts_at, expires_at)``."""
+        if self.starts_at is not None and moment < self.starts_at:
+            return False
+        if self.expires_at is not None and moment >= self.expires_at:
+            return False
+        return True
+
+
+class PromoRegistry:
+    """In-memory promo codes with usage counters."""
+
+    def __init__(self, clock: Clock | None = None, promos: Iterable[PromoCode] = ()) -> None:
+        self._clock = clock or SystemClock()
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+        self._lock = threading.Lock()
+        for promo in promos:
+            self.add(promo)
+
+    def add(self, promo: PromoCode) -> None:
+        with self._lock:
+            if promo.code in self._promos:
+                raise ValidationError(f"duplicate promo code: {promo.code}")
+            self._promos[promo.code] = promo
+            self._uses[promo.code] = 0
+        logger.debug("promo: added %s", promo.code)
+
+    def resolve(self, code: str) -> PromoCode:
+        """Find the promo by user input: existence, then validity period, then usage limit."""
+        with self._lock:
+            return self._resolve_locked(code)
+
+    def uses(self, code: str) -> int:
+        key = normalize_key(code)
+        with self._lock:
+            if key not in self._promos:
+                raise UnknownPromoCodeError(code)
+            return self._uses[key]
+
+    def redeem(self, code: str) -> PromoCode:
+        """Atomically check the code and count one use."""
+        with self._lock:
+            promo = self._resolve_locked(code)
+            self._uses[promo.code] += 1
+        logger.info("promo %s redeemed", promo.code)
+        return promo
+
+    def release(self, code: str) -> None:
+        """Give one use back (order cancelled); the counter never goes below zero."""
+        key = normalize_key(code)
+        with self._lock:
+            if key not in self._promos:
+                raise UnknownPromoCodeError(code)
+            self._uses[key] = max(0, self._uses[key] - 1)
+        logger.info("promo %s released", key)
+
+    def _resolve_locked(self, code: str) -> PromoCode:
+        key = normalize_key(code)
+        promo = self._promos.get(key)
+        if promo is None:
+            raise UnknownPromoCodeError(code)
+        if not promo.is_active_at(self._clock.now()):
+            raise PromoExpiredError(f"promo code {promo.code} is not valid now")
+        if promo.max_uses is not None and self._uses[key] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} usage limit reached")
+        return promo
