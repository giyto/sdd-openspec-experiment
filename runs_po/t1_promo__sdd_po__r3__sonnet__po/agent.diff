+++ b/tests/test_orders_promo.py
@@ -0,0 +1,140 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    EmptyCartError,
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(PromoCode("SUMMER10", DiscountKind.PERCENT, Decimal("10"), max_uses=1))
+    reg.add(PromoCode("BIG", DiscountKind.PERCENT, Decimal("10"), min_order_amount=Decimal("10000")))
+    reg.add(PromoCode("OLD", DiscountKind.PERCENT, Decimal("10"), expires_at=clock.now()))
+    reg.add(
+        PromoCode(
+            "SHORT",
+            DiscountKind.PERCENT,
+            Decimal("10"),
+            expires_at=clock.now() + timedelta(days=1),
+        )
+    )
+    return reg
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def cart(products):
+    c = Cart()
+    c.add(products["book"], 2)
+    return c
+
+
+def test_quote_with_promo_does_not_count(service, registry, cart):
+    total = service.quote(cart, "summer10")
+    assert total.discount == Decimal("90.00")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def test_backward_compatible(service, cart):
+    assert service.quote(cart).discount == Decimal("0.00")
+    assert service.place_order(cart).promo_code is None
+
+
+def test_no_registry(clock, cart):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart, "ANY")
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart, "ANY")
+
+
+@pytest.mark.parametrize("empty", [None, "", "   "])
+def test_empty_code_means_no_promo(clock, registry, cart, empty):
+    for svc in (OrderService(clock=clock), OrderService(clock=clock, promos=registry)):
+        order = svc.place_order(cart, empty)
+        assert order.promo_code is None
+        assert order.total.discount == Decimal("0.00")
+
+
+def test_non_string_code(service, cart):
+    with pytest.raises(ValidationError):
+        service.quote(cart, 123)
+
+
+def test_place_order_counts_and_normalizes(service, registry, cart):
+    order = service.place_order(cart, " summer10")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == Decimal("90.00")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_failures_do_not_count_or_store(service, registry, cart):
+    for code, error in (
+        ("NOPE", UnknownPromoCodeError),
+        ("OLD", PromoExpiredError),
+        ("BIG", PromoConditionsError),
+    ):
+        with pytest.raises(error):
+            service.place_order(cart, code)
+    with pytest.raises(EmptyCartError):
+        service.place_order(Cart(), "SUMMER10")
+    assert registry.uses("SUMMER10") == 0 and registry.uses("BIG") == 0
+    assert len(service.store) == 0
+    assert service.store.next_id() == "ORD-000001"  # no id was consumed
+
+
+def test_limit(service, cart):
+    service.place_order(cart, "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER10")
+    assert len(service.store) == 1
+
+
+def test_cancel_returns_use(service, registry, cart):
+    order = service.place_order(cart, "SUMMER10")
+    assert registry.uses("SUMMER10") == 1
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+    again = service.place_order(cart, "SUMMER10")  # limited code is available again
+    assert again.promo_code == "SUMMER10"
+
+
+def test_cancel_twice_releases_once(service, registry, cart):
+    first = service.place_order(cart, "SUMMER10")
+    service.cancel(first.order_id)
+    second = service.place_order(cart, "SUMMER10")
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(first.order_id)
+    assert registry.uses("SUMMER10") == 1
+    assert second.promo_code == "SUMMER10"
+
+
+def test_cancel_works_after_code_expired(service, registry, cart, clock):
+    order = service.place_order(cart, "SHORT")
+    clock.advance(timedelta(days=2))
+    service.cancel(order.order_id)
+    assert registry.uses("SHORT") == 0
+
+
+def test_cancel_without_promo_keeps_counters(service, registry, cart):
+    service.place_order(cart, "SUMMER10")
+    plain = service.place_order(cart)
+    service.cancel(plain.order_id)
+    assert registry.uses("SUMMER10") == 1
