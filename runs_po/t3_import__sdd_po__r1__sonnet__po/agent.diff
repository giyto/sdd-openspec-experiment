+def test_nova_extra_fields_ignored(write_csv, clock):
+    store = MemoryStore()
+    res = import_statement(write_csv("date,amount,description\n2026-03-01,-5.00,Кофе,лишнее,ещё\n"), store, clock=clock)
+    assert res.errors == [] and res.added == 1
+    assert import_csv(write_csv("date,amount,description\n2026-03-02,-5.00,Чай,x\n", name="b.csv"), store) == 1
+
+
+def test_nova_not_enough_fields(write_csv):
+    res = import_statement(write_csv("date,amount,description\n2026-03-01,-5.00\n"), MemoryStore())
+    assert len(res.errors) == 1
+
+
+def test_unknown_format(write_csv):
+    for text in ("", "\n;;;\n", "a;b;c\n", "Дата;Сумма\n"):
+        with pytest.raises(UnknownFormatError):
+            import_statement(write_csv(text), MemoryStore())
+    with pytest.raises(UnknownFormatError) as ei:
+        import_statement(write_csv("a;b;c\n"), MemoryStore(), strict=True)
+    assert ei.value.line_no == 1
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="nova")
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="bogus")
+
+
+def test_garbage_and_line_numbers(write_csv):
+    text = "\n" + SFERA + "\n 01.03.2026;-1,00;A\n;;;\n\"x\ny\";\n03.03.2026;zzz;B\n   \n"
+    res = import_statement(write_csv(text), MemoryStore())
+    assert res.added == 1
+    assert [e.line_no for e in res.errors] == [6, 8]
+
+
+def test_dedup(write_csv, clock):
+    store = MemoryStore()
+    text = SFERA + "01.03.2026;-1,00;Лента\n01.03.2026;-1,00;лента\n"
+    path = write_csv(text)
+    assert import_statement(path, store, clock=clock).added == 2
+    res = import_statement(path, store, clock=clock)
+    assert (res.added, res.duplicates) == (0, 2)
+    nova = write_csv("date,amount,description\n2026-03-01,-1.00,ЛЕНТА\n2026-03-01,-1.00,лента\n2026-03-01,-1.00,Лента\n", name="n.csv")
+    res = import_statement(nova, store)
+    assert (res.added, res.duplicates) == (1, 2)
