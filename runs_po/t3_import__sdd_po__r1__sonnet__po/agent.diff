+def _parse_row(row: list[str], fmt: str, idx: dict[str, int]) -> Transaction:
+    if len(row) <= max(idx.values()):
+        raise ValidationError("not enough fields")
+    if fmt == "nova":
+        date = _parse_date_iso(row[idx["date"]])
+        amount = parse_amount(row[idx["amount"]])
+        desc = row[idx["description"]]
+    elif fmt == "sfera":
+        date = _parse_date_sfera(row[idx["дата"]])
+        amount = _parse_amount_sfera(row[idx["сумма"]])
+        desc = row[idx["описание"]]
+    else:
+        date = _parse_date_sfera(row[idx["дата"]])
+        amount = _split_amount(row[idx["приход"]], row[idx["расход"]])
+        desc = row[idx["описание"]]
+    return Transaction(date=date, amount=amount, description=desc.strip())
