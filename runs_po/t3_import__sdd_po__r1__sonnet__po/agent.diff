+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import (
+    LedgerError,
+    StatementError,
+    StatementRowError,
+    UnknownFormatError,
+)
+from ledger.importer import (
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule, normalize_text
+from ledger.storage import JsonFileStore, MemoryStore
+
+SPLIT = "Дата;Описание;Приход;Расход\n"
+SFERA = "Дата;Сумма;Описание\n"
+
+
+def test_exceptions_hierarchy():
+    for exc in (UnknownFormatError("x"), StatementRowError("x", line_no=3)):
+        assert isinstance(exc, StatementError) and isinstance(exc, LedgerError)
+    assert StatementRowError("x", line_no=3).line_no == 3
+
+
+def test_normalize_description():
+    assert normalize_description("  Ёлка  ЛЕНТА ") == normalize_text("  Ёлка  ЛЕНТА ")
+
+
+def test_bom_and_cp1251(write_csv, clock):
+    res = import_statement(write_csv("﻿" + SFERA + "01.03.2026;-10,00;Кофе\n"), MemoryStore(), clock=clock)
+    assert (res.format, res.encoding, res.added) == ("sfera", "utf-8", 1)
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA + "01.03.2026;-10,00;Кофе\n", encoding="cp1251"), store, clock=clock)
+    assert res.encoding == "cp1251" and store.all()[0].description == "Кофе"
+
+
+def test_undecodable(write_csv):
+    path = write_csv("")
+    path.write_bytes(b"\xff\x98\xff")
+    with pytest.raises(StatementError) as ei:
+        import_statement(path, MemoryStore())
+    assert ei.value.line_no is None
+
+
+def test_split_columns_any_order_and_extra(write_csv, clock):
+    text = (
+        "Номер карты;Описание; дата ; РАСХОД;Приход;Остаток\n"
+        "1234;Кофе;05.03.2026;350,00;0,00;100,00\n"
+        "1234;Зарплата;06.03.2026;;1 000,00;500,00\n"
+    )
+    store = MemoryStore()
+    res = import_statement(write_csv(text), store, clock=clock)
+    assert res.format == "sfera_split" and res.errors == []
+    assert [t.amount for t in store.all()] == [Decimal("-350.00"), Decimal("1000.00")]
+
+
+def test_sfera_any_order_and_extra(write_csv, clock):
+    text = "Остаток;Сумма;Дата;Описание\n5;-1 200,50;01.03.2026;Лента\n"
+    store = MemoryStore()
+    res = import_statement(write_csv(text), store, clock=clock)
+    assert res.format == "sfera"
+    assert store.all()[0].amount == Decimal("-1200.50")
+
+
+@pytest.mark.parametrize(
+    "line, amount",
+    [
+        ("05.03.2026;Кофе;0,00;350,00", "-350.00"),
+        ("05.03.2026;Кофе;350,00;0,00", "350.00"),
+        ("05.03.2026;Кофе;;350,00", "-350.00"),
+        ("05.03.2026;Кофе;0;350,00", "-350.00"),
+    ],
+)
+def test_split_zero_is_empty(write_csv, line, amount):
+    store = MemoryStore()
+    res = import_statement(write_csv(SPLIT + line + "\n"), store)
+    assert res.errors == [] and store.all()[0].amount == Decimal(amount)
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "05.03.2026;Кофе;;",
+        "05.03.2026;Кофе;0,00;0,00",
+        "05.03.2026;Кофе;0,00;",
+        "05.03.2026;Кофе;10,00;20,00",
+        "05.03.2026;Кофе;;-350,00",
+        "05.03.2026;Кофе;+100,00;",
+        "05.03.2026;Кофе;abc;350,00",
