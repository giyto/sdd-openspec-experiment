+def test_sfera_plus_and_narrow_space(write_csv):
+    store = MemoryStore()
+    import_statement(write_csv(SFERA + "02.03.2026;+85 000,00;Зарплата\n"), store)
+    assert store.all()[0].amount == Decimal("85000.00")
