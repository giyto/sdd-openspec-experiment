+    """Импортирует выписку в store; запись в хранилище — одним add_many в конце."""
+    clock = clock or SystemClock()
+    if fmt is not None and fmt not in _FORMATS:
+        raise UnknownFormatError(f"unknown format {fmt!r}")
+    with open(path, "rb") as fh:
+        text, encoding = _decode(fh.read())
+
+    if fmt is None:
+        fmt = detect_format(text)
+    header = _find_header(text, fmt)
+    if header is None or header[1] is None or _header_index(header[1], fmt) is None:
+        raise UnknownFormatError(
+            f"header does not match format {fmt!r}",
+            line_no=header[0] if header else None,
