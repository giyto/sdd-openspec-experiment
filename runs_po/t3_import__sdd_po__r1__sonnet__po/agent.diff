+
+def _records(text: str, delimiter: str):
+    """Отдаёт (номер физической строки начала записи, поля или None, ошибка csv)."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    prev = 0
+    while True:
+        start = prev + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            return
+        except csv.Error as exc:
+            prev = reader.line_num
+            yield start, None, str(exc)
+            continue
+        prev = reader.line_num
+        yield start, row, None
+
+
+def _is_garbage(row: list[str] | None) -> bool:
+    return row is not None and all(not f.strip() for f in row)
+
+
+def _header_index(row: list[str], fmt: str) -> dict[str, int] | None:
+    names: dict[str, int] = {}
+    for i, f in enumerate(row):
+        names.setdefault(f.strip().casefold(), i)
+    required = _FORMATS[fmt][1]
+    if all(c in names for c in required):
+        return {c: names[c] for c in required}
+    return None
+
+
+def _find_header(text: str, fmt: str) -> tuple[int, list[str] | None] | None:
+    """Первая не мусорная запись для разделителя формата fmt."""
+    for line_no, row, _err in _records(text, _FORMATS[fmt][0]):
+        if not _is_garbage(row):
+            return line_no, row
+    return None
+
+
+def detect_format(text: str) -> str:
+    """Определяет формат по заголовку (первой не мусорной записи)."""
+    matched: list[str] = []
+    first_line: int | None = None
+    for delim in (",", ";"):
+        for line_no, row, _err in _records(text, delim):
+            if _is_garbage(row):
+                continue
+            if first_line is None or line_no < first_line:
+                first_line = line_no
+            if row is not None:
+                for fmt, (d, _cols) in _FORMATS.items():
+                    if d == delim and _header_index(row, fmt):
+                        matched.append(fmt)
+            break
+    if len(matched) != 1:
+        raise UnknownFormatError("unrecognized statement header", line_no=first_line)
+    return matched[0]
