+def _parse_amount_sfera(value: str) -> Decimal:
+    v = value.strip()
+    if not _SFERA_AMOUNT.match(v):
+        raise ValidationError(f"invalid amount: {value!r}")
+    cleaned = v.replace(",", ".")
+    for sep in (" ", " ", " "):
+        cleaned = cleaned.replace(sep, "")
+    return parse_amount(cleaned)
+
+
+def _split_amount(income: str, expense: str) -> Decimal:
+    values = []
+    for raw in (income, expense):
+        v = raw.strip()
+        if not v:
+            values.append(Decimal(0))
+            continue
+        if v[0] in "+-":
+            raise ValidationError(f"sign is not allowed in split amount: {raw!r}")
+        values.append(_parse_amount_sfera(v))
+    inc, exp = values
+    # нулевая сумма равна пустой колонке
+    if (inc != 0) == (exp != 0):
+        raise ValidationError("exactly one of income/expense must be a non-zero amount")
+    return inc if inc != 0 else -exp
+
