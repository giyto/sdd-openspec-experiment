-    except ValidationError as exc:
-        raise StatementError(str(exc), line_no=line_no) from exc
+    header_line, header_row = header
+    idx = _header_index(header_row, fmt)
+
+    parsed: list[Transaction] = []
+    errors: list[RowError] = []
+    for line_no, row, csv_err in _records(text, _FORMATS[fmt][0]):
+        if line_no <= header_line or _is_garbage(row):
+            continue
+        try:
+            if row is None:
+                raise ValidationError(csv_err or "malformed row")
+            parsed.append(_parse_row(row, fmt, idx))
+        except (ValidationError, ValueError) as exc:
+            if strict:
+                raise StatementRowError(str(exc), line_no=line_no) from exc
+            errors.append(RowError(line_no, str(exc)))
+
+    existing = Counter(
+        (t.date, t.amount, normalize_description(t.description)) for t in store.all()
+    )
+    imported_at = clock.now()
+    new: list[Transaction] = []
+    duplicates = 0
+    for tx in parsed:
+        key = (tx.date, tx.amount, normalize_description(tx.description))
+        if existing[key] > 0:
+            existing[key] -= 1
+            duplicates += 1
+            continue
+        tx = dataclasses.replace(tx, imported_at=imported_at)
+        if categorizer is not None:
+            category = categorizer.categorize(tx)
+            if category is not None:
+                tx = dataclasses.replace(tx, category=category)
+        new.append(tx)
+    if new:
+        store.add_many(new)
+    logger.info("imported %d transactions from %s (%d duplicates)", len(new), path, duplicates)
+    return ImportResult(fmt, encoding, len(new), duplicates, errors)
 
 
