+def test_strict_no_write_memory_and_json(write_csv, clock, tmp_path):
+    good = "".join(f"2026-03-01,-{i}.00,x{i}\n" for i in range(1, 101))
+    text = "date,amount,description\n" + good + "2026-03-01,abc,x\n"
+    path = write_csv(text)
+    mem = MemoryStore()
+    with pytest.raises(StatementRowError) as info:
+        import_statement(path, mem, strict=True, clock=clock)
+    assert info.value.line_no == 102 and mem.all() == []
+    js = tmp_path / "store.json"
+    with pytest.raises(StatementRowError):
