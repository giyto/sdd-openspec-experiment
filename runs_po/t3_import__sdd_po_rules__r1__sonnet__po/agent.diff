+import dataclasses
+import datetime as dt
+import inspect
+from decimal import Decimal
+
+import pytest
+
+from ledger import importer
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule, normalize_text
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1 200,50;Магазин Лента\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+    "03.03.2026;100,00;Возврат\n"
+)
+SPLIT = (
+    "Дата;Описание;Приход;Расход\n"
+    "01.03.2026;Магазин Лента;;1 200,50\n"
+    "02.03.2026;Зарплата;85 000,00;\n"
+)
+NOVA = "date,amount,description\n2026-03-01,-350.00,Кофейня Зерно\n2026-03-02,85000.00,Зарплата\n"
+
+
+def amounts(store):
+    return [t.amount for t in store.all()]
+
+
+# --- исключения -------------------------------------------------------------
+
+
+@pytest.mark.parametrize("cls", [UnknownFormatError, StatementRowError])
+def test_exceptions(cls):
+    exc = cls("boom", line_no=7)
+    assert isinstance(exc, StatementError)
+    assert exc.line_no == 7
+    assert "line 7:" in str(exc)
+
+
+# --- кодировка и формат -----------------------------------------------------
+
+
+def test_utf8_bom_and_plain(write_csv, clock):
+    for data in (SFERA.encode("utf-8"), SFERA.encode("utf-8-sig")):
+        path = write_csv(SFERA)
+        path.write_bytes(data)
+        res = import_statement(path, MemoryStore(), clock=clock)
+        assert (res.format, res.encoding, res.added) == ("sfera", "utf-8", 3)
+
+
+def test_cp1251(write_csv, clock):
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA, encoding="cp1251"), store, clock=clock)
+    assert res.encoding == "cp1251"
+    assert store.all()[0].description == "Магазин Лента"
+
+
+def test_undecodable_bytes(tmp_path):
+    p = tmp_path / "x.csv"
+    p.write_bytes(b"date,amount,description\n2026-03-01,-1.00,\x98\n\xff")
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(p, MemoryStore())
+    assert info.value.line_no is None
+
+
+def test_detect_formats(write_csv):
+    assert detect_format(write_csv(NOVA)) == "nova"
+    assert detect_format(write_csv(SFERA)) == "sfera"
+    assert detect_format(write_csv(SPLIT)) == "sfera_split"
+
+
