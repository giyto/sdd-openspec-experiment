+def test_public_api_signatures():
+    assert str(inspect.signature(import_statement)) == (
+        "(path: 'str | os.PathLike[str]', store: 'MemoryStore', *, fmt: 'str | None' = None, "
+        "strict: 'bool' = False, categorizer: 'Categorizer | None' = None, "
+        "clock: 'Clock | None' = None) -> 'ImportResult'"
+    )
+    assert list(inspect.signature(import_csv).parameters) == ["path", "store", "categorizer", "clock"]
+    assert inspect.signature(import_csv).parameters["categorizer"].default is None
+    assert [f.name for f in dataclasses.fields(RowError)] == ["line_no", "message"]
+    assert [f.name for f in dataclasses.fields(ImportResult)] == [
+        "format", "encoding", "added", "duplicates", "errors",
+    ]
+    assert RowError.__dataclass_params__.frozen and ImportResult.__dataclass_params__.frozen
+    assert issubclass(UnknownFormatError, StatementError) and issubclass(StatementRowError, StatementError)
+    assert importer.NOVA_COLUMNS == ("date", "amount", "description")
