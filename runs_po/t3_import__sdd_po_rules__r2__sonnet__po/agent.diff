+def _records(text: str, delimiter: str) -> Iterator[tuple[int, list[str]]]:
+    """Записи после заголовка с номером первой физической строки каждой."""
+    state = {"n": 0, "start": None}
+
+    def lines() -> Iterator[str]:
+        for line in io.StringIO(text, newline=""):
+            state["n"] += 1
+            if state["start"] is None and line.strip("\r\n"):
+                state["start"] = state["n"]
+            yield line
+
+    reader = csv.reader(lines(), delimiter=delimiter)
+    next(reader)  # заголовок
+    state["start"] = None
+    for row in reader:
+        start, state["start"] = state["start"], None
+        if not row or start is None:
+            continue
+        yield start, row
+
+
+def import_statement(
+    path: str | os.PathLike[str],
+    store: MemoryStore,
+    *,
+    fmt: str | None = None,
+    strict: bool = False,
+    categorizer: Categorizer | None = None,
+    clock: Clock | None = None,
+) -> ImportResult:
+    """Импортирует выписку в store и возвращает отчёт.
+
+    Дубль — только строка, которой соответствует операция, уже бывшая в store
+    до загрузки (по количеству); одинаковые строки внутри файла — разные операции.
+    """
+    clock = clock or SystemClock()
+    imported_at = clock.now()
+    text, encoding = _decode(path)
+    fmt, cols = _resolve(text, fmt)
+    delimiter, _, parse = _FORMATS[fmt]
+    need = max(cols.values()) + 1
+
+    existing = Counter(
+        (t.date, t.amount, normalize_description(t.description)) for t in store.all()
+    )
+    new: list[Transaction] = []
+    errors: list[RowError] = []
+    duplicates = 0
+    for line_no, row in _records(text, delimiter):
+        if all(not f.strip() for f in row):
+            continue
+        try:
+            if len(row) < need:
+                raise _RowProblem("not enough fields")
+            date, amount, description = parse(row, cols)
+            tx = Transaction(date=date, amount=amount, description=description, imported_at=imported_at)
+        except (_RowProblem, ValidationError) as exc:
+            message = exc.args[0] if isinstance(exc, _RowProblem) else str(exc)
+            if strict:
+                raise StatementRowError(message, line_no=line_no) from exc
+            errors.append(RowError(line_no, message))
+            continue
+        key = (tx.date, tx.amount, normalize_description(tx.description))
+        if existing[key] > 0:
+            existing[key] -= 1
+            duplicates += 1
+            continue
+        if categorizer is not None:
+            category = categorizer.categorize(tx)
+            if category is not None:
+                tx = dataclasses.replace(tx, category=category)
+        new.append(tx)
+
+    if new:
+        store.add_many(new)
+    logger.info("imported %d transactions from %s (%d duplicates)", len(new), path, duplicates)
+    return ImportResult(fmt, encoding, len(new), duplicates, errors)
 
 
