+SFERA = "Дата;Сумма;Описание\n01.03.2026;-1 200,50;Магазин Лента\n02.03.2026;+85 000,00;Зарплата\n"
+SPLIT = "Дата;Описание;Приход;Расход\n"
+NOVA = "date,amount,description\n2026-03-01,-350.00,Кофейня\n"
+
+
+def test_exceptions_and_dataclasses():
+    assert issubclass(UnknownFormatError, StatementError)
+    assert issubclass(StatementRowError, StatementError)
+    assert StatementRowError("x", line_no=4).line_no == 4
+    with pytest.raises(Exception):
+        RowError(1, "x").line_no = 2
+    assert normalize_description(" Магазин  ЛЕНТА ") == normalize_description("магазин лента")
+
+
+def test_sfera_basic(write_csv, clock):
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA), store, clock=clock)
+    assert res == ImportResult("sfera", "utf-8", 2, 0, [])
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+    assert store.all()[0].date == dt.date(2026, 3, 1)
+
+
+@pytest.mark.parametrize("enc,name", [("utf-8-sig", "utf-8"), ("cp1251", "cp1251")])
+def test_encodings(write_csv, enc, name):
+    path = write_csv(SFERA, encoding=enc)
+    store = MemoryStore()
+    res = import_statement(path, store)
+    assert res.encoding == name and res.added == 2
+    assert store.all()[1].description == "Зарплата"
+
+
+def test_undecodable(write_csv, tmp_path):
+    p = tmp_path / "x.csv"
+    p.write_bytes(b"\xff\x98\xff")
