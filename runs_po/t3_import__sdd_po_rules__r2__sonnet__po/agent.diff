+def _decode(path: str | os.PathLike[str]) -> tuple[str, str]:
+    with open(path, "rb") as fh:
+        data = fh.read()
+    try:
+        return data.decode("utf-8-sig"), "utf-8"
+    except UnicodeDecodeError:
+        pass
+    try:
+        return data.decode("cp1251"), "cp1251"
+    except UnicodeDecodeError as exc:
+        raise UnknownFormatError("file is neither utf-8 nor cp1251") from exc
+
+
+def _header_columns(text: str, fmt: str) -> dict[str, int] | None:
+    """Индексы обязательных колонок формата в заголовке или None."""
+    delimiter, required, _ = _FORMATS[fmt]
+    first = next(csv.reader(io.StringIO(text, newline=""), delimiter=delimiter), None)
+    if not first:
+        return None
+    names: dict[str, int] = {}
+    for idx, name in enumerate(first):
+        names.setdefault(name.strip().casefold(), idx)
+    if any(name not in names for name in required.values()):
+        return None
+    return {key: names[name] for key, name in required.items()}
+
+
+def _resolve(text: str, fmt: str | None) -> tuple[str, dict[str, int]]:
+    if fmt is not None and fmt not in _FORMATS:
+        raise ValueError(f"unknown format {fmt!r}")
+    if not text.strip():
+        raise UnknownFormatError("empty file")
+    for name in (fmt,) if fmt else _DETECT_ORDER:
+        cols = _header_columns(text, name)
+        if cols is not None:
+            return name, cols
+    if fmt:
+        raise UnknownFormatError(f"header does not match format {fmt!r}", line_no=1)
+    raise UnknownFormatError("unrecognized header", line_no=1)
+
