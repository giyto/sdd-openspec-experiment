@@ -0,0 +1,136 @@
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    HandlerRegistry,
+    InvalidTransitionError,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+
+from .conftest import START
+
+
+def test_delay_growth_cap_and_overflow():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=60, max_attempts=10000)
+    assert [p.delay_for(i) for i in (1, 2, 3, 7)] == [1, 2, 4, 60]
+    assert p.delay_for(5000) == 60
+    assert RetryPolicy(base_delay=0).delay_for(5000) == 0
+
+
+def test_jitter_uses_rng_once():
+    p = RetryPolicy(jitter=0.5)
+    assert p.delay_for(1, random.Random(1)) == pytest.approx(random.Random(1).uniform(0.5, 1.5))
+
+
+@pytest.mark.parametrize(
+    "kw",
+    [
+        {"max_attempts": 0},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 5, "max_delay": 1},
+        {"jitter": 1.5},
+        {"non_retryable": [int, "x"]},
+    ],
+)
+def test_invalid_policy(kw):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kw)
+
+
+def test_non_retryable_list_and_inheritance():
+    p = RetryPolicy(non_retryable=[ValueError])
+    assert p.non_retryable == (ValueError,)
+    assert not p.is_retryable(UnicodeError())
+    assert not RetryPolicy().is_retryable(PermanentJobError())
+    with pytest.raises(ConfigError):
+        p.delay_for(0)
+
+
+def _setup(policy, clock):
+    q = JobQueue(clock=clock, default_retry_policy=policy)
+    reg = HandlerRegistry()
+
+    def boom(job):
+        raise RuntimeError("x")
+
+    reg.register("boom", boom)
+    return q, Worker(q, reg)
+
+
+def test_retry_then_dead_letter_and_requeue(clock):
+    q, w = _setup(RetryPolicy(max_attempts=2, base_delay=5), clock)
+    job = q.enqueue("boom")
+    w.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=5)
+    assert w.run_once() is None
+    clock.advance(5)
+    w.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert [e.job_id for e in q.dead_letters()] == [job.id]
+    assert job.error == "RuntimeError: x"
+    assert q.metrics.get("jobs.retried") == 1
+    assert q.metrics.get("jobs.dead_lettered") == 1
+
+    assert q.requeue_dead_letter(job.id) is job
+    assert job.status is JobStatus.PENDING and job.error is None
+    assert q.dead_letters() == []
+    assert q.metrics.get("jobs.requeued") == 1
+    with pytest.raises(InvalidTransitionError):
+        q.requeue_dead_letter(job.id)
+
+
+def test_single_attempt_goes_to_dead_letter(clock):
+    q, w = _setup(RetryPolicy(max_attempts=1), clock)
+    job = q.enqueue("boom")
+    w.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+
+
+def test_non_retryable_fails_and_rng_untouched(clock):
+    class Rng(random.Random):
+        def uniform(self, a, b):
+            raise AssertionError("rng used")
+
+    q = JobQueue(clock=clock, default_retry_policy=RetryPolicy(jitter=0.5, non_retryable=(RuntimeError,)))
+    reg = HandlerRegistry()
+    reg.register("boom", lambda job: 1 / 0)
+    reg.register("perm", lambda job: (_ for _ in ()).throw(PermanentJobError("no")))
+    w = Worker(q, reg, rng=Rng())
+    q.set_retry_policy("boom", RetryPolicy(max_attempts=1, jitter=0.5))
+    a, b, c = q.enqueue("boom"), q.enqueue("perm"), q.enqueue("nohandler")
+    for _ in range(3):
+        w.run_once()
+    assert a.status is JobStatus.DEAD_LETTERED
+    assert b.status is JobStatus.FAILED
+    assert c.status is JobStatus.FAILED
+    q.set_retry_policy("boom", None)
+    assert q.retry_policy_for("boom") is q.retry_policy_for("other")
+
+
+def test_jitter_never_exceeds_max_delay():
+    class Hi(random.Random):
+        def uniform(self, a, b):
+            return b
+
+    p = RetryPolicy(base_delay=1, max_delay=60, jitter=0.5)
+    assert p.delay_for(10, Hi()) == 60
+
+
+def test_requeue_resets_attempts_and_purge_skips_dead_letter(clock):
+    q, w = _setup(RetryPolicy(max_attempts=1), clock)
+    job = q.enqueue("boom")
+    w.run_once()
+    clock.advance(10**9) if hasattr(clock, "advance") else None
+    assert q.purge_finished() == 0
+    assert q.get(job.id).status is JobStatus.DEAD_LETTERED
+    q.requeue_dead_letter(job.id)
+    assert job.attempts == 0
