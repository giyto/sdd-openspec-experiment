+import datetime as dt
+import json
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import detect_format, import_csv, import_statement, normalize_description
+from ledger.rules import Categorizer, Rule
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = "Дата;Сумма;Описание\n01.03.2026;-1 200,50;Магазин Лента\n02.03.2026;+85 000,00;Зарплата\n"
+SPLIT = "Дата;Описание;Приход;Расход\n03.03.2026;Кофейня;;350,00\n02.03.2026;Зарплата;85 000,00;\n"
+
+
+def test_exceptions():
+    assert issubclass(UnknownFormatError, StatementError)
+    assert issubclass(StatementRowError, StatementError)
+    assert StatementRowError("x", line_no=4).line_no == 4
+
+
+def test_normalize_description():
+    assert normalize_description("  Ёлка  МАГАЗИН ") == "елка магазин"
+
+
+@pytest.mark.parametrize("enc,bom", [("utf-8", ""), ("utf-8", "﻿"), ("cp1251", "")])
+def test_encodings(write_csv, clock, enc, bom):
+    store = MemoryStore()
+    text = (bom + SFERA).replace(" ", " ") if enc == "cp1251" else bom + SFERA
+    res = import_statement(write_csv(text, encoding=enc), store, clock=clock)
+    assert res.encoding == enc and res.format == "sfera" and res.added == 2
+    assert store.all()[0].amount == Decimal("-1200.50")
+    assert store.all()[1].amount == Decimal("85000.00")
+
+
+def test_undecodable(write_csv):
+    path = write_csv("")
+    path.write_bytes(b"\xff\x98\xff")
+    with pytest.raises(UnknownFormatError):
+        import_statement(path, MemoryStore())
+
+
+def test_detect_formats(write_csv):
+    assert detect_format(write_csv("date,amount,description\n")) == "nova"
+    assert detect_format(write_csv(SFERA)) == "sfera"
+    assert detect_format(write_csv(SPLIT)) == "sfera_split"
+
+
+def test_detect_any_order_case_extra(write_csv, clock):
+    text = "Номер карты;ОПИСАНИЕ; Сумма ;дата;Остаток\n1234;Магазин;-350,00;03.03.2026;10 000,00\n"
+    store = MemoryStore()
+    res = import_statement(write_csv(text), store, clock=clock)
+    assert res.format == "sfera" and res.added == 1 and not res.errors
+    tx = store.all()[0]
+    assert (tx.date, tx.amount, tx.description) == (dt.date(2026, 3, 3), Decimal("-350.00"), "Магазин")
+
+
+def test_extra_columns_split_and_nova(write_csv, clock):
+    store = MemoryStore()
+    split = "Остаток;РАСХОД;Приход;Описание;ДАТА\n1;350,00;;Кофейня;03.03.2026\n"
+    assert import_statement(write_csv(split), store, clock=clock).added == 1
+    nova = "note,Amount,date,description\nx,-1.00,2026-03-01,a\n"
+    assert import_statement(write_csv(nova, name="n.csv"), store, clock=clock).added == 1
+    assert [t.amount for t in store.all()] == [Decimal("-350.00"), Decimal("-1.00")]
+
+
+def test_row_missing_required_field(write_csv, clock):
+    res = import_statement(write_csv("Дата;Описание;Сумма\n03.03.2026;Магазин\n"), MemoryStore(), clock=clock)
+    assert [e.line_no for e in res.errors] == [2]
+
+
+def test_ambiguous_header_and_explicit(write_csv, clock):
+    text = "Дата;Описание;Сумма;Приход;Расход\n03.03.2026;М;-1,00;;\n"
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(text), MemoryStore())
+    assert import_statement(write_csv(text), MemoryStore(), clock=clock, fmt="sfera").added == 1
+
+
+def test_format_errors(write_csv):
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv(SFERA), MemoryStore(), fmt="nova")
+    assert info.value.line_no == 1
+    with pytest.raises(UnknownFormatError) as info:
+        import_statement(write_csv(""), MemoryStore())
+    assert info.value.line_no is None
+    for strict in (False, True):
