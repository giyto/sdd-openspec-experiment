@@ -0,0 +1,217 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.errors import EmptyCartError
+from shop import (
+    Cart,
+    Category,
+    DiscountKind,
+    OrderService,
+    PromoCode,
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    PromoRegistry,
+    UnknownPromoCodeError,
+    ValidationError,
+    calculate_total,
+)
+
+D = Decimal
+NOW = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def pct(value="10", **kw):
+    return PromoCode("SUMMER", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value="100.00", **kw):
+    return PromoCode("FIX", DiscountKind.FIXED, D(value), **kw)
+
+
+def cart_of(*pairs):
+    cart = Cart()
+    for product, qty in pairs:
+        cart.add(product, qty)
+    return cart
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+def test_error_hierarchy():
+    for exc in (UnknownPromoCodeError, PromoExpiredError, PromoConditionsError):
+        assert issubclass(exc, PromoError)
+    assert not issubclass(PromoExpiredError, UnknownPromoCodeError)
+    assert not issubclass(PromoConditionsError, PromoExpiredError)
+
+
+def test_percent_and_tax_after_discount(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 1))
+    total = calculate_total(cart, promo=pct("10"))
+    assert total.subtotal == D("2950.00")
+    assert total.discount == D("295.00")
+    assert [l.discount for l in total.lines] == [D("250.00"), D("45.00")]
+    assert [l.tax for l in total.lines] == [D("450.00"), D("40.50")]
+    assert total.tax == D("490.50")
+    assert total.total == D("2950.00") - D("295.00") + D("299.00") + D("490.50")
+
+
+def test_no_promo_unchanged(products):
+    cart = cart_of((products["phone"], 1))
+    total = calculate_total(cart)
+    assert total.discount == D("0.00")
+    assert total.lines[0].discount == D("0.00")
+    assert total.total == D("2500.00") + D("299.00") + D("500.00")
+
+
+def test_fixed_capped_to_participating(products):
+    cart = cart_of((products["book"], 1), (products["gift"], 1))
+    total = calculate_total(cart, promo=fixed("1000.00"))
+    assert total.discount == D("450.00")
+    gift = [l for l in total.lines if l.category is Category.GIFT_CARD][0]
+    assert gift.discount == D("0.00")
+    assert total.lines[0].tax == D("0.00")
+
+
+def test_excluded_categories_and_gift_cards(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 1), (products["gift"], 1))
+    total = calculate_total(cart, promo=pct("100", excluded_categories=frozenset({Category.BOOKS})))
+    assert [l.discount for l in total.lines] == [D("2500.00"), D("0.00"), D("0.00")]
+
+
+def test_allocation_sums_exactly(products):
+    cart = cart_of((products["tea"], 1), (products["book"], 1), (products["shirt"], 1))
+    total = calculate_total(cart, promo=fixed("100.00"))
+    assert sum(l.discount for l in total.lines) == total.discount == D("100.00")
+    assert all(l.discount <= l.amount for l in total.lines)
+
+
+def test_allocation_remainder_goes_to_earlier_line(products):
+    from shop import Product
+
+    a = Product("A-1", "a", D("1.00"), Category.CLOTHING)
+    b = Product("B-1", "b", D("1.00"), Category.CLOTHING)
+    c = Product("C-1", "c", D("1.00"), Category.CLOTHING)
+    total = calculate_total(cart_of((a, 1), (b, 1), (c, 1)), promo=fixed("1.00"))
+    assert [l.discount for l in total.lines] == [D("0.34"), D("0.33"), D("0.33")]
+
+
+def test_percent_rounding_half_up(products):
+    cart = cart_of((products["tea"], 1))  # 199.90 * 12.5% = 24.98750
+    assert calculate_total(cart, promo=pct("12.5")).discount == D("24.99")
+
+
+def test_shipping_not_discounted(products):
+    cart = cart_of((products["shirt"], 1))
+    total = calculate_total(cart, promo=pct("100"))
+    assert total.shipping == D("299.00")
+    assert total.total == D("299.00")
+
+
+def test_conditions(products):
+    cart = cart_of((products["book"], 1), (products["gift"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(min_order_amount=D("500.00")))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=pct())
+    calculate_total(cart, promo=pct(min_order_amount=D("450.00")))
+
+
+def test_promo_validation():
+    with pytest.raises(ValidationError):
+        PromoCode("  ", DiscountKind.PERCENT, D("10"))
+    with pytest.raises(ValidationError):
+        pct("0")
+    with pytest.raises(ValidationError):
+        pct("100.01")
+    with pytest.raises(ValidationError):
+        fixed("0")
+    with pytest.raises(ValidationError):
+        pct(max_uses=0)
+    with pytest.raises(ValidationError):
+        pct(starts_at=NOW, expires_at=NOW)
+    with pytest.raises(ValidationError):
+        pct(starts_at=datetime(2026, 1, 1))
+
+
+def test_registry_normalization_and_duplicates(registry):
+    registry.add(PromoCode(" summer ", DiscountKind.PERCENT, D("10")))
+    assert registry.resolve("Summer ").code == "SUMMER"
+    with pytest.raises(ValidationError):
+        registry.add(pct())
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("")
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve("nope")
+
+
+def test_registry_period_half_open(registry, clock):
+    registry.add(pct(starts_at=NOW + timedelta(hours=1), expires_at=NOW + timedelta(hours=2)))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("summer")
+    clock.advance(timedelta(hours=1))
+    registry.resolve("summer")
+    clock.advance(timedelta(hours=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("summer")
+
+
+def test_check_order_unknown_expired_then_limit(registry, clock):
