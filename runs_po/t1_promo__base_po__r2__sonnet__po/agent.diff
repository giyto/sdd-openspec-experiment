+def _allocate_discount(amounts: list[Decimal], discount: Decimal) -> list[Decimal]:
+    """Spread ``discount`` over ``amounts`` proportionally; the parts sum exactly to it."""
+    base = sum_money(amounts)
+    cents = int(discount / CENT)
+    exact = [a * cents / base for a in amounts]
+    floors = [int(x) for x in exact]
+    leftover = cents - sum(floors)
