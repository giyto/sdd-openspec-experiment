@@ -0,0 +1,123 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+UTC = timezone.utc
+D = Decimal
+
+
+def make(**kw):
+    kw.setdefault("code", "SUMMER10")
+    kw.setdefault("kind", DiscountKind.PERCENT)
+    kw.setdefault("value", D("10"))
+    return PromoCode(**kw)
+
+
+def test_error_hierarchy():
+    errs = [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError]
+    for a in errs:
+        assert issubclass(a, PromoError) and issubclass(a, ShopError)
+        for b in errs:
+            if a is not b:
+                assert not issubclass(a, b)
+
+
+def test_code_normalized():
+    assert make(code="  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize(
+    "kw",
+    [
+        {"code": "   "},
+        {"value": D("0")},
+        {"value": D("-1")},
+        {"value": D("100.01")},
+        {"kind": DiscountKind.FIXED, "value": D("0")},
+        {"kind": DiscountKind.FIXED, "value": D("10.005")},
+        {"min_order_amount": D("-1")},
+        {"starts_at": datetime(2026, 1, 1)},
+        {"expires_at": datetime(2026, 1, 1)},
+        {"starts_at": datetime(2026, 1, 1, tzinfo=UTC), "expires_at": datetime(2026, 1, 1, tzinfo=UTC)},
+        {"max_uses": 0},
+        {"max_uses": True},
+        {"excluded_categories": frozenset({"books"})},
+    ],
+)
+def test_invalid(kw):
+    with pytest.raises(ValidationError):
+        make(**kw)
+
+
+def test_valid_edges():
+    assert make(value=D("100")).value == D("100")
+    assert make(value=D("12.5")).value == D("12.5")
+    assert make(kind=DiscountKind.FIXED, value=D("10.50")).kind is DiscountKind.FIXED
+
+
+def registry(clock, **kw):
+    reg = PromoRegistry(clock)
+    reg.add(make(**kw))
+    return reg
+
+
+def test_resolve_case_and_unknown(clock):
+    reg = registry(clock)
+    assert reg.resolve("  summer10 ").code == "SUMMER10"
+    for bad in ("NOPE", "", "   "):
+        with pytest.raises(UnknownPromoCodeError):
+            reg.resolve(bad)
+    with pytest.raises(UnknownPromoCodeError):
+        reg.uses("NOPE")
+    assert reg.uses("summer10") == 0
+
+
+def test_duplicate(clock):
+    reg = PromoRegistry(clock)
+    reg.add(make(code="sale"))
+    with pytest.raises(ValidationError):
+        reg.add(make(code=" SALE "))
+
+
+def test_period_bounds(clock):
+    now = clock.now()
+    reg = registry(clock, starts_at=now, expires_at=now + timedelta(days=1))
+    assert reg.resolve("SUMMER10")
+    clock.set(now - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+    clock.set(now + timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_limit_and_expired_priority(clock):
+    now = clock.now()
+    reg = registry(clock, max_uses=1, expires_at=now + timedelta(days=1))
+    reg._record_use("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("SUMMER10")
+    clock.set(now + timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER10")
+
+
+def test_release_use(clock):
+    reg = registry(clock, max_uses=1)
+    reg._record_use("SUMMER10")
+    reg._release_use("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    reg._release_use("SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+    assert reg.resolve("SUMMER10")
