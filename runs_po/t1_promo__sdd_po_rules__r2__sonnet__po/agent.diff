+++ b/tests/test_orders_promo.py
@@ -0,0 +1,106 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+@pytest.fixture
+def cart(products):
+    c = Cart()
+    c.add(products["shirt"], 2)
+    return c
+
+
+def build(clock, **kw):
+    reg = PromoRegistry(clock)
+    reg.add(PromoCode("SUMMER10", DiscountKind.PERCENT, D("10"), **kw))
+    return OrderService(clock=clock, promos=reg), reg
+
+
+def test_blank_code_is_no_code(clock, cart):
+    service, reg = build(clock)
+    plain = service.place_order(cart)
+    for blank in (None, "", "  "):
+        order = service.place_order(cart, promo_code=blank)
+        assert order.promo_code is None
+        assert order.total == plain.total
+    assert plain.total.discount == D("0.00")
+    assert reg.uses("SUMMER10") == 0
+
+
+def test_normalized_and_counted(clock, cart):
+    service, reg = build(clock)
+    order = service.place_order(cart, promo_code=" summer10 ")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == D("199.80")
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_no_registry(clock, cart):
+    with pytest.raises(UnknownPromoCodeError):
+        OrderService(clock=clock).quote(cart, "ANY")
+    assert OrderService(clock=clock).quote(cart, " ").discount == D("0.00")
+
+
+def test_quote_does_not_use(clock, cart):
+    service, reg = build(clock)
+    for _ in range(3):
+        service.quote(cart, "SUMMER10")
+    assert reg.uses("SUMMER10") == 0
+
+
+def test_failed_place_order(clock, cart):
+    service, reg = build(clock, min_order_amount=D("99999"))
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER10")
+    with pytest.raises(UnknownPromoCodeError):
+        service.place_order(cart, "NOPE")
+    assert len(service.store) == 0
+    assert reg.uses("SUMMER10") == 0
+    assert service.store.next_id() == "ORD-000001"
+
+
+def test_expired(clock, cart):
+    service, _ = build(clock, expires_at=clock.now() + timedelta(days=1))
+    clock.advance(timedelta(days=1))
+    with pytest.raises(PromoExpiredError):
+        service.place_order(cart, "SUMMER10")
+
+
+def test_limit(clock, cart):
+    service, _ = build(clock, max_uses=1)
+    service.place_order(cart, "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER10")
+
+
+def test_cancel_returns_use(clock, cart):
+    service, reg = build(clock, max_uses=1)
+    order = service.place_order(cart, "SUMMER10")
+    service.cancel(order.order_id)
+    assert reg.uses("SUMMER10") == 0
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(order.order_id)
+    assert reg.uses("SUMMER10") == 0
+    assert service.place_order(cart, "SUMMER10").promo_code == "SUMMER10"
+    assert reg.uses("SUMMER10") == 1
+
+
+def test_cancel_without_code_keeps_uses(clock, cart):
+    service, reg = build(clock)
+    service.place_order(cart, "SUMMER10")
+    plain = service.place_order(cart)
+    service.cancel(plain.order_id)
+    assert reg.uses("SUMMER10") == 1
