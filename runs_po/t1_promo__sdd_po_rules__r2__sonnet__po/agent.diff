diff --git a/shop/promo.py b/shop/promo.py
new file mode 100644
index 0000000..c8f1f6f
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,144 @@
+"""Promo codes: the code model and the registry with expiry and usage limits."""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+_HUNDRED = Decimal("100")
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _is_aware(at: datetime) -> bool:
+    return at.tzinfo is not None and at.utcoffset() is not None
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        code = normalize_key(self.code)
+        if not code:
+            raise ValidationError("promo code must not be empty")
+        object.__setattr__(self, "code", code)
+
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError(f"invalid discount kind: {self.kind!r}")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError(f"promo value must be a Decimal, got {self.value!r}")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= _HUNDRED:
+                raise ValidationError(f"percent must be in (0, 100], got {self.value}")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"fixed discount must be positive, got {self.value}")
+            if to_money(self.value) != self.value:
+                raise ValidationError(f"fixed discount has more than 2 decimals: {self.value}")
+
+        if not isinstance(self.min_order_amount, Decimal) or not self.min_order_amount.is_finite():
+            raise ValidationError("min_order_amount must be a Decimal")
+        if self.min_order_amount < 0:
+            raise ValidationError("min_order_amount must not be negative")
+        if to_money(self.min_order_amount) != self.min_order_amount:
+            raise ValidationError("min_order_amount has more than 2 decimals")
+
+        for name in ("starts_at", "expires_at"):
+            at = getattr(self, name)
+            if at is not None and (not isinstance(at, datetime) or not _is_aware(at)):
+                raise ValidationError(f"{name} must be an aware datetime")
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError("starts_at must be earlier than expires_at")
+
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError(f"max_uses must be None or an integer >= 1, got {self.max_uses!r}")
+
+        categories = frozenset(self.excluded_categories)
+        if not all(isinstance(c, Category) for c in categories):
+            raise ValidationError("excluded_categories must contain only Category values")
+        object.__setattr__(self, "excluded_categories", categories)
+
+    def is_active_at(self, moment: datetime) -> bool:
+        """Validity interval is half-open: ``[starts_at, expires_at)``."""
+        if self.starts_at is not None and moment < self.starts_at:
+            return False
+        if self.expires_at is not None and moment >= self.expires_at:
+            return False
+        return True
+
+
+class PromoRegistry:
+    """In-memory promo code registry. Not thread-safe."""
+
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+
+    def add(self, promo: PromoCode) -> None:
+        if promo.code in self._promos:
+            raise ValidationError(f"duplicate promo code: {promo.code!r}")
+        self._promos[promo.code] = promo
+        self._uses[promo.code] = 0
+
+    def _get(self, code: str) -> PromoCode:
+        key = normalize_key(code)
+        try:
+            return self._promos[key]
+        except KeyError:
+            raise UnknownPromoCodeError(f"unknown promo code: {key!r}") from None
+
+    def resolve(self, code: str) -> PromoCode:
+        """Find a code that can be used right now: exists, in its period, limit not reached."""
+        promo = self._get(code)
+        if not promo.is_active_at(self._clock.now()):
+            raise PromoExpiredError(f"promo code {promo.code!r} is not valid now")
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code!r} usage limit reached")
+        return promo
+
+    def uses(self, code: str) -> int:
+        return self._uses[self._get(code).code]
+
+    def _record_use(self, code: str) -> None:
+        promo = self._get(code)
+        self._uses[promo.code] += 1
+        logger.info("promo %s used, uses=%s", promo.code, self._uses[promo.code])
+
+    def _release_use(self, code: str) -> None:
+        promo = self._get(code)
+        if self._uses[promo.code] > 0:
+            self._uses[promo.code] -= 1
+            logger.info("promo %s use released, uses=%s", promo.code, self._uses[promo.code])
diff --git a/tests/test_orders_promo.py b/tests/test_orders_promo.py
new file mode 100644
index 0000000..541edd9
