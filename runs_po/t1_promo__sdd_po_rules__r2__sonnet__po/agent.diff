+def _split_discount(discount: Decimal, amounts: list[Decimal]) -> list[Decimal]:
+    """Spread ``discount`` over ``amounts`` proportionally, exactly to the cent.
+
+    Works in integer cents: floor of each exact share, then the leftover cents go to the
+    largest fractional remainders, ties broken by cart order.
+    """
+    cents = [int(a / CENT) for a in amounts]
+    base = sum(cents)
+    discount_cents = int(discount / CENT)
+    shares = [discount_cents * c // base for c in cents]
+    remainders = [discount_cents * c % base for c in cents]
+    leftover = discount_cents - sum(shares)
+    order = sorted(range(len(cents)), key=lambda i: (-remainders[i], i))
+    for i in order[:leftover]:
+        shares[i] += 1
+    return [Decimal(s) * CENT for s in shares]
