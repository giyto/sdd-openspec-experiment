+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import EmptyCartError, PromoConditionsError
+from shop.pricing import calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def pct(v, **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(str(v)), **kw)
+
+
+def fixed(v, **kw):
+    return PromoCode("F", DiscountKind.FIXED, D(str(v)), **kw)
+
+
+def prod(sku, price, cat=Category.CLOTHING):
+    return Product(f"SKU-{sku}", sku, D(price), cat)
+
+
+def test_no_promo_compat(products):
+    total = calculate_total(cart_of((products["shirt"], 1)))
+    assert total.discount == D("0.00")
+    assert total.lines[0].discount == D("0.00")
+    assert total.total == total.subtotal + total.shipping + total.tax
+
+
+def test_excluded_and_gift(products):
+    cart = cart_of((products["book"], 1), (products["shirt"], 1), (products["gift"], 1))
+    total = calculate_total(cart, promo=pct(10, excluded_categories=frozenset({Category.BOOKS})))
+    by = {ln.sku: ln for ln in total.lines}
+    assert by["BOOK-1"].discount == D("0.00")
+    assert by["GIFT-1000"].discount == D("0.00")
+    assert by["SHIRT-1"].discount == D("99.90")
+    assert total.discount == D("99.90")
+    assert total.total == total.subtotal - total.discount + total.shipping + total.tax
+
+
+def test_half_up():
+    total = calculate_total(cart_of((prod("A", "10.10"), 1)), promo=pct(5))
+    assert total.discount == D("0.51")
+
+
+def test_fixed_exceeds():
+    total = calculate_total(cart_of((prod("A", "1200.00"), 1)), promo=fixed(5000))
+    assert total.discount == D("1200.00")
+    assert total.tax == D("0.00")
+
+
+def test_min_order_boundary():
+    cart = cart_of((prod("A", "999.99"), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(10, min_order_amount=D("1000.00")))
+    cart = cart_of((prod("A", "1000.00"), 1))
+    assert calculate_total(cart, promo=pct(10, min_order_amount=D("1000.00"))).discount == D("100.00")
+
+
+def test_min_order_ignores_gift(products):
+    cart = cart_of((products["shirt"], 1), (products["gift"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(10, min_order_amount=D("1500.00")))
+
+
+def test_no_eligible(products):
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=pct(10))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart_of((products["book"], 1)),
+            promo=pct(10, excluded_categories=frozenset({Category.BOOKS})),
+        )
+
+
+def test_empty_cart():
+    with pytest.raises(EmptyCartError):
+        calculate_total(Cart(), promo=pct(10))
+
+
+def test_split_three_lines():
+    cart = cart_of((prod("A", "33.33"), 1), (prod("B", "33.33"), 1), (prod("C", "33.33"), 1))
+    total = calculate_total(cart, promo=fixed("10.00"))
+    ds = [ln.discount for ln in total.lines]
+    assert sum(ds) == D("10.00") == total.discount
+    assert ds == [D("3.34"), D("3.33"), D("3.33")]
+
+
+def test_split_largest_remainder():
+    cart = cart_of((prod("A", "1.00"), 1), (prod("B", "2.00"), 1))
+    total = calculate_total(cart, promo=fixed("1.00"))
+    # exact shares 0.3333 / 0.6667 -> floor 0.33 / 0.66, leftover cent goes to B
+    assert [ln.discount for ln in total.lines] == [D("0.33"), D("0.67")]
+
+
+def test_tax_after_discount():
+    total = calculate_total(cart_of((prod("A", "1000.00"), 1)), promo=fixed(100))
+    assert total.lines[0].tax == D("180.00")
+    assert total.total == D("1000.00") - D("100.00") + D("299.00") + D("180.00")
+
+
+def test_free_shipping_threshold_after_discount():
+    low = calculate_total(cart_of((prod("A", "3000.00"), 1)), promo=pct(10))
+    assert low.shipping == D("299.00")
+    high = calculate_total(cart_of((prod("A", "4000.00"), 1)), promo=pct(10))
+    assert high.shipping == D("0.00")
+    assert high.total == high.subtotal - high.discount + high.shipping + high.tax
+
+
+def test_paid_shipping_not_reduced():
+    total = calculate_total(cart_of((prod("A", "1000.00"), 1)), promo=fixed(200))
+    assert total.shipping == D("299.00")
