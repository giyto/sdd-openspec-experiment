+"""Политика повторов: валидация параметров, расчёт задержки, классификация ошибок."""
+
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+
+from .errors import ConfigError, PermanentJobError
+
+
+def _is_finite_number(value: object) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    """Параметры повторов задания.
+
+    ``max_attempts`` — всего попыток, включая первую. ``max_delay`` — жёсткий потолок
+    задержки (джиттер его не превышает). ``non_retryable`` — классы ошибок без повторов.
+    """
+
+    max_attempts: int = 3
+    base_delay: float = 1.0
+    factor: float = 2.0
+    max_delay: float = 60.0
+    jitter: float = 0.0
+    non_retryable: tuple[type[BaseException], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not (
+            isinstance(self.max_attempts, int)
+            and not isinstance(self.max_attempts, bool)
+            and self.max_attempts >= 1
+        ):
+            raise ConfigError("max_attempts must be an int >= 1")
+        for name in ("base_delay", "factor", "max_delay", "jitter"):
+            if not _is_finite_number(getattr(self, name)):
+                raise ConfigError(f"{name} must be a finite number")
+        if not self.base_delay >= 0:
+            raise ConfigError("base_delay must be >= 0")
+        if not self.factor >= 1:
+            raise ConfigError("factor must be >= 1")
+        if not self.max_delay >= self.base_delay:
+            raise ConfigError("max_delay must be >= base_delay")
+        if not 0 <= self.jitter <= 1:
+            raise ConfigError("jitter must be within [0, 1]")
+        try:
+            classes = tuple(self.non_retryable)
+        except TypeError:
+            raise ConfigError("non_retryable must be a sequence of exception classes") from None
+        for cls in classes:
+            if not (isinstance(cls, type) and issubclass(cls, BaseException)):
+                raise ConfigError(f"non_retryable item {cls!r} is not an exception class")
+        object.__setattr__(self, "non_retryable", classes)
+
+    def delay_for(self, attempt: int, rng: random.Random | None = None) -> float:
+        """Задержка после упавшей попытки ``attempt`` (с 1), не больше ``max_delay``."""
+        if not isinstance(attempt, int) or isinstance(attempt, bool) or attempt < 1:
+            raise ConfigError("attempt must be an int >= 1")
+        if self.base_delay == 0:
+            return 0.0
+        max_delay = float(self.max_delay)
+        if self.factor == 1:
+            delay = min(float(self.base_delay), max_delay)
+        else:
+            try:
+                raw = self.base_delay * float(self.factor) ** (attempt - 1)
+            except OverflowError:
+                raw = math.inf
+            delay = min(raw, max_delay)
+        if self.jitter > 0:
+            gen = rng if rng is not None else random
+            delay *= gen.uniform(1 - self.jitter, 1 + self.jitter)
+            delay = min(delay, max_delay)
+        return delay
+
+    def is_retryable(self, exc: BaseException) -> bool:
+        if isinstance(exc, PermanentJobError):
+            return False
+        return not isinstance(exc, self.non_retryable)
