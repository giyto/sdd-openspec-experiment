+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    HandlerRegistry,
+    InvalidTransitionError,
+    JobNotFoundError,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryPolicy,
+    Worker,
+)
+from jobq.dashboard import render_report
+
+
+class Rng:
+    def __init__(self, value=1.0):
+        self.value = value
+        self.calls = 0
+
+    def uniform(self, a, b):
+        self.calls += 1
+        return self.value
+
+
+def _timeout(job):
+    raise TimeoutError("gw")
+
+
+def make(clock, policy=None, handler=None, rng=None):
+    queue = JobQueue(clock=clock, default_retry_policy=policy)
+    registry = HandlerRegistry()
+    registry.register("mail", handler or _timeout)
+    return queue, Worker(queue, registry, rng=rng)
+
+
+def test_no_policy_failed(clock):
+    queue, worker = make(clock)
+    job = queue.enqueue("mail")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_retry_scheduled(clock):
+    queue, worker = make(clock, RetryPolicy(base_delay=2, factor=2))
+    job = queue.enqueue("mail")
+    t = clock.now()
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == t + timedelta(seconds=2)
+    assert job.error == "TimeoutError: gw" and job.attempts == 1
+    assert worker.run_once() is None
+    clock.advance(2)
+    assert worker.run_once() is job
+
+
+def test_succeeds_on_third(clock):
+    state = {"n": 0}
+
+    def handler(job):
+        state["n"] += 1
+        if state["n"] < 3:
+            raise TimeoutError("gw")
+        return "ok"
+
+    queue, worker = make(clock, RetryPolicy(base_delay=1), handler)
+    job = queue.enqueue("mail")
+    for _ in range(3):
+        worker.run_once()
+        clock.advance(10)
+    assert job.status is JobStatus.SUCCEEDED
+    assert job.error is None and job.attempts == 3
+    m = queue.metrics
+    assert (m.get("jobs.retried"), m.get("jobs.started"), m.get("jobs.failed")) == (2, 3, 0)
+    assert "Ожидает повтора" in render_report(queue)
+
+
+def test_dead_letter_and_requeue_resets_attempts(clock):
+    queue, worker = make(clock, RetryPolicy(max_attempts=2, base_delay=1))
+    job = queue.enqueue("mail")
+    worker.run_once()
+    clock.advance(5)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    (entry,) = queue.dead_letters()
+    assert (entry.attempts, entry.error) == (2, "TimeoutError: gw")
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+    with pytest.raises(InvalidTransitionError):
+        queue.cancel(job.id)
+    assert queue.purge_finished() == 0
+
+    same = queue.requeue_dead_letter(job.id)
+    assert same is job and job.status is JobStatus.PENDING
+    assert job.attempts == 0 and job.error is None and job.finished_at is None
+    assert job.run_at == clock.now()
+    assert queue.dead_letters() == [] and queue.metrics.get("jobs.requeued") == 1
+
+    worker.run_once()  # первая же ошибка после возврата — повтор, не dead-letter
+    assert job.status is JobStatus.RETRY_SCHEDULED and job.attempts == 1
+    assert queue.dead_letters() == []
+    clock.advance(5)
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert len(queue.dead_letters()) == 1 and queue.dead_letters()[0].attempts == 2
+
+
+def test_requeued_then_success(clock):
+    state = {"ok": False}
+
+    def handler(job):
+        if not state["ok"]:
+            raise TimeoutError("gw")
+        return 1
+
+    queue, worker = make(clock, RetryPolicy(max_attempts=1), handler)
+    job = queue.enqueue("mail")
+    worker.run_once()
+    state["ok"] = True
+    queue.requeue_dead_letter(job.id)
+    worker.run_once()
+    assert job.status is JobStatus.SUCCEEDED
+
+
+def test_requeue_errors(clock):
+    queue, worker = make(clock)
+    job = queue.enqueue("mail")
+    with pytest.raises(InvalidTransitionError):
+        queue.requeue_dead_letter(job.id)
+    with pytest.raises(JobNotFoundError):
+        queue.requeue_dead_letter("job-999999")
+    assert queue.metrics.get("jobs.requeued") == 0
+    assert job.status is JobStatus.PENDING
+
+
+def test_dead_letters_is_copy(clock):
+    queue, worker = make(clock, RetryPolicy(max_attempts=1))
+    queue.enqueue("mail")
+    worker.run_once()
+    queue.dead_letters().clear()
+    assert len(queue.dead_letters()) == 1
+
+
+def test_non_retryable_and_permanent(clock):
+    def perm(job):
+        raise PermanentJobError("no")
+
+    queue, worker = make(clock, RetryPolicy(), perm)
+    job = queue.enqueue("mail")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+
+    queue, worker = make(clock, RetryPolicy(non_retryable=[OSError]))
+    job = queue.enqueue("mail")
+    worker.run_once()  # TimeoutError — подкласс OSError
+    assert job.status is JobStatus.FAILED
+
+
+def test_unknown_handler_failed(clock):
+    queue = JobQueue(clock=clock, default_retry_policy=RetryPolicy())
+    worker = Worker(queue, HandlerRegistry())
+    job = queue.enqueue("x")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+
+
+def test_policy_priority_and_validation(clock):
+    queue = JobQueue(clock=clock)
+    policy = RetryPolicy()
+    queue.set_retry_policy("a", policy)
+    assert queue.retry_policy_for("a") is policy
+    assert queue.retry_policy_for("b") is None
+    queue.set_retry_policy("a", None)
+    assert queue.retry_policy_for("a") is None
+    with pytest.raises(ConfigError):
+        queue.set_retry_policy("a", object())
+    with pytest.raises(ConfigError):
+        queue.set_retry_policy("", policy)
+    with pytest.raises(ConfigError):
+        JobQueue(default_retry_policy="x")
+
+
+def test_cancel_retry_scheduled(clock):
+    queue, worker = make(clock, RetryPolicy())
+    job = queue.enqueue("mail")
+    worker.run_once()
+    queue.cancel(job.id)
+    assert job.status is JobStatus.CANCELLED
+
+
+def test_rng_usage(clock):
+    rng = Rng(1.1)
+    queue, worker = make(clock, RetryPolicy(jitter=0.5, max_attempts=2), rng=rng)
+    queue.enqueue("mail")
+    worker.run_once()
+    assert rng.calls == 1
+    clock.advance(100)
+    worker.run_once()  # dead-letter
+    assert rng.calls == 1
+
+    rng = Rng()
+    queue, worker = make(clock, RetryPolicy(jitter=0), rng=rng)
+    queue.enqueue("mail")
+    worker.run_once()
+    assert rng.calls == 0
+
+
+def test_jitter_capped_in_worker(clock):
+    queue, worker = make(
+        clock, RetryPolicy(base_delay=10, max_delay=10, jitter=0.5), rng=Rng(1.4)
+    )
+    job = queue.enqueue("mail")
+    t = clock.now()
+    worker.run_once()
+    assert job.run_at == t + timedelta(seconds=10)
