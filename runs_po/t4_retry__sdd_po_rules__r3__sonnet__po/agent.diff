@@ -0,0 +1,125 @@
+import dataclasses
+import math
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    JobqError,
+    JobStatus,
+    Metrics,
+    PermanentJobError,
+    RetryPolicy,
+)
+
+
+class CountingRng:
+    def __init__(self, value):
+        self.value = value
+        self.calls = []
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def test_permanent_error_hierarchy():
+    assert issubclass(PermanentJobError, JobqError)
+
+
+def test_statuses_and_entry(clock):
+    assert JobStatus.RETRY_SCHEDULED.value == "retry_scheduled"
+    assert JobStatus.DEAD_LETTERED.value == "dead_lettered"
+    assert JobStatus.RETRY_SCHEDULED.label == "Ожидает повтора"
+    assert JobStatus.DEAD_LETTERED.label == "В dead-letter"
+    assert not JobStatus.RETRY_SCHEDULED.is_terminal
+    assert not JobStatus.DEAD_LETTERED.is_terminal
+    entry = DeadLetterEntry("j", "t", 1, "e", clock.now())
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        entry.attempts = 2
+
+
+def test_metrics_default_zero():
+    assert Metrics().get("jobs.retried") == 0
+
+
+def test_defaults_and_tuple():
+    p = RetryPolicy()
+    assert (p.max_attempts, p.base_delay, p.factor, p.max_delay, p.jitter) == (3, 1.0, 2.0, 60.0, 0.0)
+    assert p.non_retryable == ()
+    assert RetryPolicy(non_retryable=[ValueError]).non_retryable == (ValueError,)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": True},
+        {"max_attempts": 1.5},
+        {"base_delay": -1},
+        {"factor": 0.5},
+        {"base_delay": 5, "max_delay": 1},
+        {"jitter": 1.5},
+        {"jitter": -0.1},
+        {"jitter": math.nan},
+        {"max_delay": math.inf},
+        {"non_retryable": (int,)},
+        {"non_retryable": ("ValueError",)},
+    ],
+)
+def test_invalid(kwargs):
+    with pytest.raises(ConfigError):
+        RetryPolicy(**kwargs)
+
+
+def test_boundaries():
+    RetryPolicy(max_attempts=1, base_delay=0, factor=1, max_delay=0, jitter=1)
+
+
+def test_delay_growth_and_cap():
+    p = RetryPolicy(base_delay=1, factor=2, max_delay=10)
+    assert [p.delay_for(n) for n in (1, 2, 3, 5)] == [1, 2, 4, 10]
+
+
+@pytest.mark.parametrize("n", [5000, 10**6])
+def test_huge_attempt(n):
+    assert RetryPolicy(max_attempts=10**7, max_delay=60).delay_for(n) == 60.0
+
+
+def test_zero_base_and_factor_one():
+    p = RetryPolicy(base_delay=0, max_delay=1)
+    assert p.delay_for(1) == 0.0 and p.delay_for(5000) == 0.0
+    q = RetryPolicy(base_delay=3, factor=1)
+    assert q.delay_for(1) == q.delay_for(10**6) == 3
+
+
+def test_jitter_never_exceeds_max_delay():
+    rng = CountingRng(1.2)
+    p = RetryPolicy(jitter=0.5, base_delay=1, max_delay=10)
+    assert p.delay_for(10, rng) == 10.0
+    assert rng.calls == [(0.5, 1.5)]
+
+
+def test_jitter_can_reduce():
+    p = RetryPolicy(jitter=0.5, base_delay=1, max_delay=10)
+    assert p.delay_for(10, CountingRng(0.8)) == 8.0
+
+
+def test_no_jitter_no_rng():
+    rng = CountingRng(1.0)
+    RetryPolicy().delay_for(2, rng)
+    assert rng.calls == []
+
+
+@pytest.mark.parametrize("n", [0, -1])
+def test_bad_attempt(n):
+    with pytest.raises(ConfigError):
+        RetryPolicy().delay_for(n)
+
+
+def test_is_retryable():
