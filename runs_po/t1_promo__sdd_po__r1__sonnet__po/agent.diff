+++ b/tests/test_promo.py
@@ -0,0 +1,93 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode
+
+UTC = timezone.utc
+
+
+def pct(value="10", **kw):
+    return PromoCode("SUMMER10", DiscountKind.PERCENT, Decimal(value), **kw)
+
+
+def test_error_hierarchy():
+    classes = [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError]
+    for cls in classes:
+        assert issubclass(cls, PromoError) and issubclass(cls, ShopError)
+        assert not issubclass(cls, ValidationError)
+        for other in classes:
+            if other is not cls:
+                assert not issubclass(cls, other)
+
+
+def test_code_is_normalized():
+    assert PromoCode("  summer10 ", DiscountKind.PERCENT, Decimal("10")).code == "SUMMER10"
+
+
+def test_empty_code():
+    with pytest.raises(ValidationError):
+        PromoCode("   ", DiscountKind.PERCENT, Decimal("10"))
+
+
+@pytest.mark.parametrize("value", ["0", "100.01", "-1", "NaN", "Infinity"])
+def test_percent_out_of_range(value):
+    with pytest.raises(ValidationError):
+        pct(value)
+
+
+def test_percent_100_ok():
+    assert pct("100").value == Decimal("100")
+
+
+@pytest.mark.parametrize("value", [Decimal("0"), Decimal("-5.00"), Decimal("1.001"), 10.0, 10])
+def test_bad_fixed(value):
+    with pytest.raises(ValidationError):
+        PromoCode("X1", DiscountKind.FIXED, value)
+
+
+def test_fixed_ok():
+    assert PromoCode("X1", DiscountKind.FIXED, Decimal("50.00")).value == Decimal("50.00")
+
+
+def test_negative_min_amount():
+    with pytest.raises(ValidationError):
+        pct(min_order_amount=Decimal("-1.00"))
+
+
+@pytest.mark.parametrize("max_uses", [0, -1, 1.5, True])
+def test_bad_max_uses(max_uses):
+    with pytest.raises(ValidationError):
+        pct(max_uses=max_uses)
+
+
+def test_naive_datetime():
+    with pytest.raises(ValidationError):
+        pct(starts_at=datetime(2026, 1, 1))
+    with pytest.raises(ValidationError):
+        pct(expires_at=datetime(2026, 1, 1))
+
+
+def test_bad_interval():
+    at = datetime(2026, 1, 1, tzinfo=UTC)
+    with pytest.raises(ValidationError):
+        pct(starts_at=at, expires_at=at)
+    with pytest.raises(ValidationError):
+        pct(starts_at=at.replace(year=2027), expires_at=at)
+
+
+def test_excluded_categories_frozen():
+    promo = pct(excluded_categories=[Category.FOOD])
+    assert promo.excluded_categories == frozenset({Category.FOOD})
+    with pytest.raises(ValidationError):
+        pct(excluded_categories=["FOOD"])
diff --git a/tests/test_promo_registry.py b/tests/test_promo_registry.py
new file mode 100644
index 0000000..b4e0c3d
--- /dev/null
+++ b/tests/test_promo_registry.py
@@ -0,0 +1,106 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+T0 = datetime(2026, 6, 1, tzinfo=timezone.utc)
+T1 = datetime(2026, 7, 1, tzinfo=timezone.utc)
+
+
+def make(clock, **kw):
+    promo = PromoCode("SUMMER10", DiscountKind.PERCENT, Decimal("10"), **kw)
+    registry = PromoRegistry(clock=clock)
+    registry.add(promo)
+    return registry, promo
+
+
+def test_resolve_normalizes():
+    registry, promo = make(FixedClock(T0))
+    assert registry.resolve(" summer10 ") is promo
+
+
+@pytest.mark.parametrize("code", ["", "  ", "NOPE"])
+def test_unknown(code):
+    registry, _ = make(FixedClock(T0))
+    with pytest.raises(UnknownPromoCodeError):
+        registry.resolve(code)
+
+
+def test_non_string():
+    registry, _ = make(FixedClock(T0))
+    with pytest.raises(ValidationError):
+        registry.resolve(None)
+
+
+def test_uses_unknown():
+    registry, _ = make(FixedClock(T0))
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("nope")
+
+
+def test_window_boundaries():
+    clock = FixedClock(T0)
+    registry, _ = make(clock, starts_at=T0, expires_at=T1)
+    registry.resolve("SUMMER10")  # start inclusive
+    clock.set(T1 - timedelta(microseconds=1))
+    registry.resolve("SUMMER10")
+    clock.set(T1)
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+    clock.set(T0 - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_expired_before_exhausted():
+    clock = FixedClock(T0)
+    registry, _ = make(clock, expires_at=T1, max_uses=1)
+    registry.record_use("SUMMER10")
+    clock.set(T1)
+    with pytest.raises(PromoExpiredError):
+        registry.resolve("SUMMER10")
+
+
+def test_limit():
+    registry, _ = make(FixedClock(T0), max_uses=1)
+    registry.resolve("SUMMER10")
+    registry.record_use("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        registry.record_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_resolve_does_not_count():
+    registry, _ = make(FixedClock(T0), max_uses=1)
+    for _ in range(3):
+        registry.resolve("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_duplicate():
+    registry, promo = make(FixedClock(T0))
+    with pytest.raises(ValidationError):
+        registry.add(PromoCode(" summer10", DiscountKind.FIXED, Decimal("5.00")))
+    assert registry.resolve("SUMMER10") is promo
+
+
+def test_release_use():
+    registry, _ = make(FixedClock(T0))
+    registry.record_use("SUMMER10")
+    registry.release_use("summer10")
+    assert registry.uses("SUMMER10") == 0
+    registry.release_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    with pytest.raises(UnknownPromoCodeError):
+        registry.release_use("NOPE")
