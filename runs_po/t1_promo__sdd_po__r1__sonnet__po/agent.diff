index 0000000..4518c52
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,152 @@
+"""Promo codes: the code model and the registry with usage counters."""
+
+from __future__ import annotations
+
+import logging
+import threading
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock, SystemClock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+MAX_PERCENT = Decimal("100")
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _check_money(name: str, value: object) -> Decimal:
+    if not isinstance(value, Decimal) or not value.is_finite():
+        raise ValidationError(f"{name} must be a finite Decimal")
+    if to_money(value) != value:
+        raise ValidationError(f"{name} has more than two fractional digits")
+    return value
+
+
+def _check_aware(name: str, value: object) -> None:
+    if value is None:
+        return
+    if not isinstance(value, datetime) or value.tzinfo is None or value.utcoffset() is None:
+        raise ValidationError(f"{name} must be an aware datetime")
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = frozenset()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError("kind must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError(f"value of {self.code} must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= MAX_PERCENT:
+                raise ValidationError(f"percent of {self.code} must be in (0, 100]")
+        else:
+            _check_money(f"value of {self.code}", self.value)
+            if self.value <= 0:
+                raise ValidationError(f"fixed discount of {self.code} must be positive")
+        _check_money(f"min_order_amount of {self.code}", self.min_order_amount)
+        if self.min_order_amount < 0:
+            raise ValidationError(f"min_order_amount of {self.code} must not be negative")
+        _check_aware("starts_at", self.starts_at)
+        _check_aware("expires_at", self.expires_at)
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError(f"starts_at of {self.code} must be before expires_at")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError(f"max_uses of {self.code} must be an integer >= 1")
+        try:
+            categories = frozenset(self.excluded_categories)
+        except TypeError:
+            raise ValidationError("excluded_categories must be iterable") from None
+        if not all(isinstance(c, Category) for c in categories):
+            raise ValidationError("excluded_categories must contain Category values")
+        object.__setattr__(self, "excluded_categories", categories)
+
+
+class PromoRegistry:
+    """Promo codes by normalized code, with usage counters."""
+
+    def __init__(self, codes: tuple[PromoCode, ...] | list[PromoCode] = (), *, clock: Clock | None = None) -> None:
+        self._clock = clock or SystemClock()
+        self._codes: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+        self._lock = threading.Lock()
+        for promo in codes:
+            self.add(promo)
+
+    def add(self, promo: PromoCode) -> None:
+        with self._lock:
+            if promo.code in self._codes:
+                raise ValidationError(f"duplicate promo code: {promo.code}")
+            self._codes[promo.code] = promo
+            self._uses[promo.code] = 0
+
+    def _get(self, code: str) -> PromoCode:
+        key = normalize_key(code)
+        try:
+            return self._codes[key]
+        except KeyError:
+            raise UnknownPromoCodeError(f"unknown promo code: {key!r}") from None
+
+    def uses(self, code: str) -> int:
+        promo = self._get(code)
+        return self._uses[promo.code]
+
+    def resolve(self, code: str) -> PromoCode:
+        """Find a code valid right now and not exhausted. Does not count a use."""
+        promo = self._get(code)
+        now = self._clock.now()
+        if (promo.starts_at is not None and now < promo.starts_at) or (
+            promo.expires_at is not None and now >= promo.expires_at
+        ):
+            raise PromoExpiredError(f"promo code {promo.code} is not valid now")
+        if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+            raise PromoConditionsError(f"promo code {promo.code} usage limit reached")
+        return promo
+
+    def record_use(self, code: str) -> None:
+        promo = self._get(code)
+        with self._lock:
+            if promo.max_uses is not None and self._uses[promo.code] >= promo.max_uses:
+                raise PromoConditionsError(f"promo code {promo.code} usage limit reached")
+            self._uses[promo.code] += 1
+        logger.info("promo code %s used (%s)", promo.code, self._uses[promo.code])
+
+    def release_use(self, code: str) -> None:
+        """Give back one use (order cancelled); the counter never goes below zero."""
+        promo = self._get(code)
+        with self._lock:
+            if self._uses[promo.code] > 0:
+                self._uses[promo.code] -= 1
+        logger.info("promo code %s use released (%s)", promo.code, self._uses[promo.code])
