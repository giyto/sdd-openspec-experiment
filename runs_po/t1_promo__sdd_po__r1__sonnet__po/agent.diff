+++ b/tests/test_orders_promo.py
@@ -0,0 +1,124 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+def make_cart(products, key="shirt", qty=1):
+    cart = Cart()
+    cart.add(products[key], qty)
+    return cart
+
+
+def setup(clock, **kw):
+    registry = PromoRegistry(clock=clock)
+    registry.add(PromoCode("SUMMER10", DiscountKind.PERCENT, D("10"), **kw))
+    return registry, OrderService(clock=clock, promos=registry)
+
+
+def test_blank_codes_mean_no_promo(clock, products):
+    service = OrderService(clock=clock)
+    for code in (None, "", "   "):
+        order = service.place_order(make_cart(products), promo_code=code)
+        assert order.promo_code is None
+        assert order.total.discount == D("0.00")
+
+
+def test_normalized_code(clock, products):
+    registry, service = setup(clock)
+    order = service.place_order(make_cart(products), promo_code=" summer10")
+    assert order.promo_code == "SUMMER10"
+    assert order.total.discount == D("99.90")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_no_registry(clock, products):
+    with pytest.raises(UnknownPromoCodeError):
+        OrderService(clock=clock).place_order(make_cart(products), promo_code="X")
+    with pytest.raises(UnknownPromoCodeError):
+        OrderService(clock=clock).quote(make_cart(products), promo_code="X")
+
+
+def test_non_string(clock, products):
+    _, service = setup(clock)
+    with pytest.raises(ValidationError):
+        service.quote(make_cart(products), promo_code=5)
+
+
+def test_quote_does_not_consume(clock, products):
+    registry, service = setup(clock, max_uses=1)
+    cart = make_cart(products)
+    assert service.quote(cart, "SUMMER10").discount == D("99.90")
+    assert registry.uses("SUMMER10") == 0
+    service.place_order(cart, "SUMMER10")
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_failed_attempt_does_not_change_state(clock, products):
+    registry, service = setup(clock, min_order_amount=D("5000.00"))
+    with pytest.raises(PromoConditionsError):
+        service.place_order(make_cart(products), "SUMMER10")
+    assert registry.uses("SUMMER10") == 0
+    assert len(service.store) == 0
+
+
+def test_limit_exhausted(clock, products):
+    _, service = setup(clock, max_uses=1)
+    service.place_order(make_cart(products), "SUMMER10")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(make_cart(products), "SUMMER10")
+
+
+def test_error_order_expired_before_conditions(clock, products):
+    _, service = setup(
+        clock, min_order_amount=D("5000.00"), expires_at=clock.now() - timedelta(days=1)
+    )
+    with pytest.raises(PromoExpiredError):
+        service.place_order(make_cart(products), "SUMMER10")
+
+
+def test_cancel_releases_use(clock, products):
+    registry, service = setup(clock, max_uses=1)
+    order = service.place_order(make_cart(products), "SUMMER10")
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+    assert service.place_order(make_cart(products), "SUMMER10").promo_code == "SUMMER10"
+
+
+def test_cancel_after_expiry_still_releases(clock, products):
+    registry, service = setup(clock, expires_at=clock.now() + timedelta(days=1))
+    order = service.place_order(make_cart(products), "SUMMER10")
+    clock.advance(timedelta(days=2))
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_cancel_without_promo_keeps_counters(clock, products):
+    registry, service = setup(clock)
+    service.place_order(make_cart(products), "SUMMER10")
+    plain = service.place_order(make_cart(products))
+    service.cancel(plain.order_id)
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_double_cancel(clock, products):
+    registry, service = setup(clock)
+    service.place_order(make_cart(products), "SUMMER10")
+    order = service.place_order(make_cart(products), "SUMMER10")
+    service.cancel(order.order_id)
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 1
