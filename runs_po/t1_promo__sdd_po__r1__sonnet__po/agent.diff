@@ -0,0 +1,144 @@
+import random
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def percent(value, **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("F", DiscountKind.FIXED, D(value), **kw)
+
+
+def test_no_promo_has_zero_discount(products):
+    total = calculate_total(cart_of((products["phone"], 1)))
+    assert total.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in total.lines)
+
+
+def test_percent_rounding_half_up():
+    product = Product("ITEM-1", "x", D("100.05"), Category.CLOTHING)
+    total = calculate_total(cart_of((product, 1)), promo=percent("10"))
+    assert total.discount == D("10.01")
+
+
+def test_fixed_capped_at_base(products):
+    total = calculate_total(cart_of((products["tea"], 1)), promo=fixed("500.00"))
+    assert total.discount == D("199.90")
+    assert total.lines[0].discount == D("199.90")
+    assert total.tax == D("0.00")
+
+
+def test_gift_card_never_discounted(products):
+    total = calculate_total(
+        cart_of((products["book"], 1), (products["gift"], 1)), promo=percent("10")
+    )
+    assert total.lines[1].discount == D("0.00")
+    assert total.discount == D("45.00")
+
+
+def test_excluded_category(products):
+    promo = percent("10", excluded_categories=frozenset({Category.FOOD}))
+    total = calculate_total(cart_of((products["tea"], 1), (products["book"], 1)), promo=promo)
+    assert total.lines[0].discount == D("0.00")
+    assert total.lines[1].discount == D("45.00")
+
+
+def test_min_order_amount(products):
+    cart = cart_of((products["book"], 2))  # 900.00
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=percent("10", min_order_amount=D("900.01")))
+    ok = calculate_total(cart, promo=percent("10", min_order_amount=D("900.00")))
+    assert ok.discount == D("90.00")
+
+
+def test_min_amount_uses_participating_base(products):
+    cart = cart_of((products["book"], 1), (products["gift"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=percent("10", min_order_amount=D("1000.00")))
+
+
+def test_only_gift_cards(products):
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=percent("10"))
+
+
+def test_ten_over_three_lines():
+    items = [Product(f"ITEM-{i}", "x", D("10.00"), Category.CLOTHING) for i in range(3)]
+    total = calculate_total(cart_of(*[(p, 1) for p in items]), promo=fixed("10.00"))
+    assert [line.discount for line in total.lines] == [D("3.34"), D("3.33"), D("3.33")]
+    assert total.discount == D("10.00")
+
+
+def test_full_discount():
+    items = [
+        Product("ITEM-1", "x", D("33.33"), Category.CLOTHING),
+        Product("ITEM-2", "x", D("0.01"), Category.BOOKS),
+        Product("ITEM-3", "x", D("12.50"), Category.FOOD),
+    ]
+    total = calculate_total(cart_of(*[(p, 1) for p in items]), promo=percent("100"))
+    assert [line.discount for line in total.lines] == [line.amount for line in total.lines]
+    assert total.tax == D("0.00")
+    assert total.total == total.shipping
+
+
+def test_tax_after_discount():
+    product = Product("ITEM-1", "x", D("1000.00"), Category.CLOTHING)
+    total = calculate_total(cart_of((product, 1)), promo=fixed("100.00"))
+    assert total.lines[0].tax == D("180.00")
+    assert total.total == D("1000.00") - D("100.00") + total.shipping + D("180.00")
+
+
+def test_discount_can_remove_free_shipping():
+    product = Product("ITEM-1", "x", D("3100.00"), Category.CLOTHING)
+    total = calculate_total(cart_of((product, 1)), promo=fixed("200.00"))
+    assert total.shipping == D("299.00")
+
+
+def test_free_shipping_kept_when_still_above_threshold():
+    product = Product("ITEM-1", "x", D("3100.00"), Category.CLOTHING)
+    total = calculate_total(cart_of((product, 1)), promo=fixed("100.00"))
+    assert total.shipping == D("0.00")
+
+
+def test_shipping_cost_not_discounted():
+    product = Product("ITEM-1", "x", D("100.00"), Category.CLOTHING)
+    total = calculate_total(cart_of((product, 1)), promo=percent("100"))
+    assert total.shipping == D("299.00")
+
+
+def test_random_carts_invariants():
+    rng = random.Random(42)
+    cats = [Category.CLOTHING, Category.BOOKS, Category.FOOD, Category.GIFT_CARD]
+    for _ in range(300):
+        cart = Cart()
+        for i in range(rng.randint(1, 6)):
+            price = D(rng.randint(1, 500000)) / 100
+            cart.add(Product(f"ITEM-{i}", "x", price, rng.choice(cats)), rng.randint(1, 5))
+        if rng.random() < 0.5:
+            promo = percent(str(rng.randint(1, 100)))
+        else:
+            promo = fixed(str(D(rng.randint(1, 800000)) / 100))
+        try:
+            total = calculate_total(cart, promo=promo)
+        except PromoConditionsError:
+            continue
+        assert sum(line.discount for line in total.lines) == total.discount
+        assert all(0 <= line.discount <= line.amount for line in total.lines)
+        assert total.total == total.subtotal - total.discount + total.shipping + total.tax
diff --git a/tests/test_promo.py b/tests/test_promo.py
new file mode 100644
index 0000000..c3c0fcb
