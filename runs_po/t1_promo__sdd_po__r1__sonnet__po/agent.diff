+def _line_discounts(cart_lines: Sequence[CartLine], promo: PromoCode | None) -> list[Decimal]:
+    """Discount of every cart line (``0.00`` for non-participating lines)."""
+    if promo is None:
+        return [ZERO for _ in cart_lines]
+    participates = [
+        line.product.category is not Category.GIFT_CARD
+        and line.product.category not in promo.excluded_categories
+        for line in cart_lines
+    ]
+    base = sum_money(line.amount for line, ok in zip(cart_lines, participates) if ok)
+    if base == 0:
+        raise PromoConditionsError(f"promo code {promo.code}: no lines eligible for a discount")
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"promo code {promo.code}: minimum order amount is {promo.min_order_amount}"
+        )
+    if promo.kind is DiscountKind.PERCENT:
+        discount = quantize_money(base * promo.value / 100)
+    else:
+        discount = min(promo.value, base)
+
+    # Largest remainder method on integer kopecks.
+    discount_cents = int(discount / CENT)
+    base_cents = int(base / CENT)
+    shares = [0] * len(cart_lines)
+    remainders: list[tuple[int, int]] = []
+    for index, (line, ok) in enumerate(zip(cart_lines, participates)):
+        if not ok:
+            continue
+        quotient, remainder = divmod(discount_cents * int(line.amount / CENT), base_cents)
+        shares[index] = quotient
+        remainders.append((-remainder, index))
+    leftover = discount_cents - sum(shares)
+    for _, index in sorted(remainders)[:leftover]:
+        shares[index] += 1
+    return [(CENT * cents).quantize(CENT) for cents in shares]
