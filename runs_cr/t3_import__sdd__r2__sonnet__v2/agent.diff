+def test_dry_run(write_csv, tmp_path, clock):
+    class Spy(MemoryStore):
+        calls = 0
+
+        def add_many(self, txs):
+            Spy.calls += 1
+            return super().add_many(txs)
+
+    path = write_csv(SFERA + "x;1,00;Bad\n")
+    store = Spy()
+    r = import_statement(path, store, clock=clock, dry_run=True)
+    assert Spy.calls == 0 and store.all() == []
+    assert r.added == 2 and [t.id for t in r.transactions] == [None, None]
+    real = import_statement(path, store, clock=clock)
+    assert Spy.calls == 1
+    assert (r.added, r.duplicates, r.errors) == (real.added, real.duplicates, real.errors)
+    assert [t.id for t in real.transactions] == [t.id for t in store.all()] == [1, 2]
+    assert [replace(t, id=None) for t in real.transactions] == r.transactions
+    db = tmp_path / "db.json"
+    import_statement(path, JsonFileStore(db), dry_run=True)
+    assert not db.exists()
+    with pytest.raises(StatementRowError) as ei:
+        import_statement(path, Spy(), strict=True, dry_run=True)
+    assert len(ei.value.errors) == 1
+
