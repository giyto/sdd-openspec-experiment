diff --git a/tests/test_reservations_rework.py b/tests/test_reservations_rework.py
new file mode 100644
index 0000000..8e0b038
--- /dev/null
+++ b/tests/test_reservations_rework.py
@@ -0,0 +1,340 @@
+import dataclasses
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    UnknownSkuError,
+    ValidationError,
+)
+from warehouse.models import Availability, ReservationStatus
+from warehouse.reservations import (
+    DEFAULT_RESERVATION_TTL,
+    MAX_RESERVATION_LIFETIME,
+    ReservationRecord,
+    cap_expiry,
+)
+from warehouse.storage import InMemoryStore
+
+from conftest import T0
+
+MIN = timedelta(minutes=1)
+HOUR = timedelta(hours=1)
+
+
+def events(inv, kind=None):
+    items = list(inv.log)
+    return [e for e in items if kind is None or e.kind == kind]
+
+
+def kinds(inv):
+    return [e.kind for e in inv.log]
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 10)
+    inv.receive("B", "NUT-M8", 5)
+    return inv
+
+
+# --- модели и константы ------------------------------------------------------
+
+
+def test_availability_model():
+    a = Availability("A", "BOLT", 10, 4, 6)
+    assert (a.warehouse, a.sku, a.on_hand, a.reserved, a.available) == ("A", "BOLT", 10, 4, 6)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        a.on_hand = 1
+
+
+def test_constants_and_cap():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=20)
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+    assert ReservationRecord("O", (), T0, T0).expiry_reported is False
+    assert cap_expiry(T0, T0 + 3 * HOUR) == T0 + 2 * HOUR
+    assert cap_expiry(T0, T0 + 2 * HOUR) == T0 + 2 * HOUR
+    assert cap_expiry(T0, T0 + HOUR) == T0 + HOUR
+
+
+def test_store_unreported():
+    store = InMemoryStore()
+    rec = ReservationRecord("O", (), T0, T0)
+    store.add_unreported(rec)
+    assert store.list_unreported() == [rec]
+    store.remove_unreported(rec)
+    assert store.list_unreported() == []
+
+
+# --- reserve: TTL ------------------------------------------------------------
+
+
+def test_reserve_default_ttl_and_max(stocked):
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert r.expires_at == T0 + 20 * MIN
+    r = stocked.reserve("SO-2", [("A", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    assert r.expires_at == T0 + 2 * HOUR
+
+
+def test_reserve_ttl_over_max(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    before = len(events(stocked))
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=2 * HOUR + timedelta(seconds=1))
+    assert len(events(stocked)) == before
+    assert stocked.get_reservation("SO-1").lines[0].qty == 2
+
+
+# --- reserve: замена ---------------------------------------------------------
+
+
+def test_replace_active(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    clock.advance(5 * MIN)
+    r = stocked.reserve("SO-1", [("B", "NUT-M8", 1)])
+    assert r.status is ReservationStatus.ACTIVE
+    assert r.created_at == T0 + 5 * MIN
+    assert r.expires_at == T0 + 25 * MIN
+    assert stocked.reserved("A", "BOLT-M8") == 0
+
+
+def test_replace_counts_own_as_free(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 10)])
+    assert stocked.reserved("A", "BOLT-M8") == 10
+    stocked.cancel("SO-1")
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-2", [("A", "BOLT-M8", 10)])
+
+
+def test_replace_failure_is_atomic(stocked):
+    first = stocked.reserve("SO-1", [("A", "BOLT-M8", 8)])
+    before = len(events(stocked))
+    for lines, exc in [
+        ([("A", "BOLT-M8", 11)], InsufficientStockError),
+        ([], ValidationError),
+        ([("A", "NOPE", 1)], UnknownSkuError),
+    ]:
+        with pytest.raises(exc):
+            stocked.reserve("SO-1", lines)
+    assert stocked.get_reservation("SO-1") == first
+    assert len(events(stocked)) == before
+
+
+def test_replace_log(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    n = len(events(stocked))
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1), ("B", "NUT-M8", 1)])
+    assert kinds(stocked)[n:] == ["RESERVE_CANCEL", "RESERVE", "RESERVE"]
+    assert events(stocked)[n].fields["order"] == "SO-1"
+
+
+def test_duplicate_confirmed(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    snap = stocked.confirm("SO-1")
+    n = len(events(stocked))
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert stocked.get_reservation("SO-1") == snap
+    assert len(events(stocked)) == n
+
+
+def test_replace_expired_and_cancelled(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    clock.advance(30 * MIN)
+    n = len(events(stocked))
+    r = stocked.reserve("SO-1", [("B", "NUT-M8", 1)])
+    assert r.status is ReservationStatus.ACTIVE and r.lines[0].sku == "NUT-M8"
+    assert "RESERVE_CANCEL" not in kinds(stocked)[n:]
+    stocked.cancel("SO-1")
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert r.status is ReservationStatus.ACTIVE
+
+
+def test_replace_expired_failure_keeps_old(stocked, clock):
+    old = stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    clock.advance(30 * MIN)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 99)])
+    assert stocked.get_reservation("SO-1").lines == old.lines
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+
+
+# --- cancel подтверждённого --------------------------------------------------
+
+
+def test_cancel_confirmed_returns_stock(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("B", "NUT-M8", 1)])
+    stocked.confirm("SO-1")
+    assert stocked.on_hand("A", "BOLT-M8") == 8
+    clock.advance(10 * HOUR)
+    n = len(events(stocked))
+    r = stocked.cancel("SO-1")
+    assert r.status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.on_hand("B", "NUT-M8") == 5
+    new = events(stocked)[n:]
+    assert [e.kind for e in new] == ["RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+    assert new[0].fields["ref"] == "SO-1" and new[0].fields["wh"] == "A"
+    assert new[1].fields["wh"] == "B"
+    assert new[2].fields["order"] == "SO-1"
+
+
+def test_cancel_confirmed_same_position_and_repeat(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2), ("A", "BOLT-M8", 3)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-1")
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    n = len(events(stocked))
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert len(events(stocked)) == n
+
+
+# --- extend ------------------------------------------------------------------
+
+
+def test_extend_basic_and_cap(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(5 * MIN)
+    r = stocked.extend("SO-1", 30 * MIN)
+    assert r.expires_at == T0 + 35 * MIN
+    clock.set(T0 + 30 * MIN)
+    r = stocked.extend("SO-1", 100 * MIN)
+    assert r.expires_at == T0 + 2 * HOUR
+    assert events(stocked, "RESERVE_EXTEND")[-1].fields["expires"].startswith("2026-03-01T12:00:00")
+
+
+def test_extend_at_limit_is_noop(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=2 * HOUR)
+    clock.advance(MIN)
+    n = len(events(stocked))
+    r = stocked.extend("SO-1", timedelta(days=365))
+    assert r.expires_at == T0 + 2 * HOUR
+    assert len(events(stocked)) == n
+
+
+def test_extend_invariant(stocked, clock):
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    for _ in range(10):
+        clock.advance(10 * MIN)
+        r = stocked.extend("SO-1", 45 * MIN)
+        assert r.expires_at - r.created_at <= MAX_RESERVATION_LIFETIME
+
+
+# --- reservations ------------------------------------------------------------
+
+
+def test_reservations_list_and_filter(stocked, clock):
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)], ttl=10 * MIN)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(MIN)
+    stocked.reserve("SO-3", [("A", "BOLT-M8", 1)], ttl=HOUR)
+    stocked.reserve("SO-4", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-4")
+    stocked.reserve("SO-5", [("B", "NUT-M8", 1)])
+    stocked.cancel("SO-5")
+    clock.advance(25 * MIN)
+    n = len(events(stocked))
+    assert [r.order_id for r in stocked.reservations()] == ["SO-1", "SO-2", "SO-3", "SO-4", "SO-5"]
+    assert [r.order_id for r in stocked.reservations(ReservationStatus.EXPIRED)] == ["SO-1", "SO-2"]
+    assert [r.order_id for r in stocked.reservations(ReservationStatus.ACTIVE)] == ["SO-3"]
+    assert [r.order_id for r in stocked.reservations("confirmed")] == ["SO-4"]
+    assert len(events(stocked)) == n
+
+
+def test_reservations_empty_replaced_invalid(stocked):
+    assert stocked.reservations() == []
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    got = stocked.reservations()
+    assert len(got) == 1 and got[0].lines[0].qty == 2
+    assert stocked.reservations(ReservationStatus.CANCELLED) == []
+    with pytest.raises(ValidationError):
+        stocked.reservations("bogus")
+    with pytest.raises(ValidationError):
+        stocked.reservations(5)
+
+
+# --- availability ------------------------------------------------------------
+
+
+def test_availability(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    assert stocked.availability("A") == [Availability("A", "BOLT-M8", 10, 4, 6)]
+    assert stocked.availability() == [
+        Availability("A", "BOLT-M8", 10, 4, 6),
+        Availability("B", "NUT-M8", 5, 0, 5),
+    ]
+    assert stocked.availability("Z") == []
+
+
+def test_availability_reserve_only_and_expired(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 4)])
+    stocked.adjust("A", "BOLT-M8", 0, "lost")
+    assert Availability("A", "BOLT-M8", 0, 4, 0) in stocked.availability()
+    clock.advance(HOUR)
+    assert all(a.sku != "BOLT-M8" for a in stocked.availability())
+
+
+# --- sweep_expired -----------------------------------------------------------
+
+
+def test_sweep_order_and_once(stocked, clock):
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.reserve("SO-9", [("A", "BOLT-M8", 1)], ttl=5 * MIN)
+    stocked.reserve("SO-A", [("A", "BOLT-M8", 1)], ttl=HOUR)
+    stocked.reserve("SO-C", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-C")
+    clock.advance(30 * MIN)
+    n = len(events(stocked))
+    on_hand, avail = stocked.on_hand("A", "BOLT-M8"), stocked.available("A", "BOLT-M8")
+    assert stocked.sweep_expired() == ["SO-9", "SO-1", "SO-2"]
+    new = events(stocked)[n:]
+    assert [e.kind for e in new] == ["RESERVE_EXPIRE"] * 3
+    assert [e.fields["order"] for e in new] == ["SO-9", "SO-1", "SO-2"]
+    assert new[0].fields["expires"].startswith("2026-03-01T10:05:00")
+    assert stocked.sweep_expired() == []
+    assert len(events(stocked)) == n + 3
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.on_hand("A", "BOLT-M8") == on_hand
+    assert stocked.available("A", "BOLT-M8") == avail
+    n = len(events(stocked))
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert len(events(stocked)) == n
+
+
+def test_sweep_new_reservation_same_order(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(30 * MIN)
+    assert stocked.sweep_expired() == ["SO-1"]
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(30 * MIN)
+    assert stocked.sweep_expired() == ["SO-1"]
+    assert len(events(stocked, "RESERVE_EXPIRE")) == 2
+
+
+def test_sweep_replaced_before_report(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(30 * MIN)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(30 * MIN)
+    assert stocked.sweep_expired() == ["SO-1", "SO-1"]
+    assert len(events(stocked, "RESERVE_EXPIRE")) == 2
+    assert stocked.sweep_expired() == []
+    assert len(stocked.reservations()) == 1
+
+
+def test_no_events_without_sweep(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(HOUR)
+    n = len(events(stocked))
+    stocked.get_reservation("SO-1")
+    stocked.reservations()
+    stocked.availability()
+    stocked.available("A", "BOLT-M8")
+    assert len(events(stocked)) == n
