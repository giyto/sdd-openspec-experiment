+            record
+            for record in self._store.list_reservations()
+            if not record.expiry_reported
+            and effective_status(record, now) is ReservationStatus.EXPIRED
+        ]
+        candidates.extend(self._store.list_unreported())
+        candidates.sort(key=lambda record: (record.expires_at, record.order_id))
+        for record in candidates:
+            self._log.append(
+                now, "RESERVE_EXPIRE", order=record.order_id,
+                expires=format_timestamp(record.expires_at),
+            )
+            record.expiry_reported = True
+            self._store.remove_unreported(record)
+        return [record.order_id for record in candidates]
+
