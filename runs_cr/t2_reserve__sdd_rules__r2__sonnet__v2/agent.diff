+    def reservations(self, status: ReservationStatus | None = None) -> list[Reservation]:
+        """Снимки текущих резервов (по одному на заказ), опционально по статусу."""
+        if status is not None:
+            try:
+                status = ReservationStatus(status)
+            except ValueError as exc:
+                raise ValidationError(f"invalid reservation status: {status!r}") from exc
+        now = self._clock.now()
+        result = [snapshot(record, now) for record in self._store.list_reservations()]
+        if status is not None:
+            result = [item for item in result if item.status is status]
+        result.sort(key=lambda item: (item.created_at, item.order_id))
+        return result
+
+    def availability(self, warehouse: str | None = None) -> list[Availability]:
+        """Остаток, резерв и свободное количество по позициям."""
+        now = self._clock.now()
+        keys = {(wh, sku) for wh, sku, _ in self._store.positions()}
+        for record in self._store.list_reservations():
+            if effective_status(record, now) is ReservationStatus.ACTIVE:
+                keys.update((line.warehouse, line.sku) for line in record.lines)
+        return [
+            Availability(
+                warehouse=wh,
+                sku=sku,
+                on_hand=self._store.get_qty(wh, sku),
+                reserved=self._reserved_at(wh, sku, now),
+                available=self._available_at(wh, sku, now),
+            )
+            for wh, sku in sorted(keys)
+            if warehouse is None or wh == warehouse
+        ]
+
+    def sweep_expired(self) -> list[str]:
