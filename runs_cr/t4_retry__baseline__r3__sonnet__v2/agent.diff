+class RetryLaterError(JobqError):
+    """Временная ошибка, после которой внешний сервис сам назвал время повтора."""
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        super().__init__(message)
+        if (
+            isinstance(retry_after, bool)
+            or not isinstance(retry_after, (int, float))
+            or not retry_after >= 0
+        ):
+            raise ConfigError("retry_after must be a number >= 0")
+        self.retry_after = retry_after
+
+
 class InvalidTransitionError(JobqError):
     """Недопустимый переход между статусами задания."""
 
