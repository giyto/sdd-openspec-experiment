+    text = SFERA + "01.03.2026;-1,00;кофе\n01.03.2026;-1,00;dup\nbad;1;x\n02.03.2026;-2,00;b\n"
+    cat = Categorizer([Rule("кофе", "Еда")])
+    seed = SFERA + "01.03.2026;-1,00;dup\n"
+
+    def prep(name):
+        store = JsonFileStore(tmp_path / name)
+        import_statement(write_csv(seed, name="seed.csv"), store, clock=clock)
+        return store
+
+    dry_store, real_store = prep("a.json"), prep("b.json")
+    before = (tmp_path / "a.json").read_bytes()
+    dry = import_statement(
+        write_csv(text), dry_store, categorizer=cat, clock=clock, dry_run=True
+    )
+    assert dry_store.all() == real_store.all()
+    assert (tmp_path / "a.json").read_bytes() == before
+    real = import_statement(write_csv(text), real_store, categorizer=cat, clock=clock)
+    assert (dry.format, dry.encoding, dry.added, dry.duplicates, dry.errors) == (
+        real.format, real.encoding, real.added, real.duplicates, real.errors,
+    )
+    assert all(t.id is None for t in dry.transactions)
+    assert dry.transactions == [dataclasses.replace(t, id=None) for t in real.transactions]
+    assert [t.category for t in dry.transactions] == ["Еда", None]
+
+
+def test_dry_run_strict_raises(write_csv):
+    store = MemoryStore()
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(SFERA + "bad;1;x\n"), store, strict=True, dry_run=True)
