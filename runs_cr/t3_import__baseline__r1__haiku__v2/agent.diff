+def test_dry_run_matches_real_import(write_csv, clock):
+    text = (
+        SFERA_HEADER
+        + "01.03.2026;-1 200,50;Магазин Лента\n"
+        + "02.03.2026;+85 000,00;Зарплата\n"
+        + "03.03.2026;-150,00;Кофе\n"
+        + "03.03.2026;-150,00;Кофе\n"
+        + "04.03.2026;oops;bad\n"
+    )
+    cat = Categorizer([Rule("лента", "food"), Rule("зарплата", "salary", kind="income")])
+    store = MemoryStore()
+    preview = import_statement(
+        write_csv(text), store, categorizer=cat, dry_run=True, clock=clock
+    )
+    assert store.all() == []
+    real = import_statement(write_csv(text), store, categorizer=cat, clock=clock)
+    assert preview.transactions == [replace_id(tx, None) for tx in real.transactions]
+    assert (preview.added, preview.duplicates, preview.errors) == (
+        real.added,
+        real.duplicates,
+        real.errors,
+    )
+    assert all(tx.id is None for tx in preview.transactions)
+    # два одинаковых «Кофе» в одном файле — не дубли, оба добавляются
+    assert [tx.id for tx in real.transactions] == [1, 2, 3, 4]
+    assert [tx.category for tx in real.transactions] == ["food", "salary", None, None]
+
