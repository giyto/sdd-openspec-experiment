diff --git a/tests/test_statements_ledger74.py b/tests/test_statements_ledger74.py
new file mode 100644
index 0000000..3ba0062
--- /dev/null
+++ b/tests/test_statements_ledger74.py
@@ -0,0 +1,236 @@
+import datetime as dt
+from dataclasses import replace
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementRowError
+from ledger.importer import import_statement
+from ledger.models import Transaction
+from ledger.rules import Categorizer, Rule
+from ledger.storage import JsonFileStore, MemoryStore
+
+SPLIT_HEADER = "Дата;Описание;Приход;Расход\n"
+SFERA_HEADER = "Дата;Сумма;Описание\n"
+
+
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [("-1 234.56", "-1234.56"), ("-1234.5", "-1234.50"), ("+85 000.00", "85000.00"), ("150.50", "150.50")],
+)
+def test_sfera_accepts_dot_decimal_separator(write_csv, clock, amount, expected):
+    store = MemoryStore()
+    text = SFERA_HEADER + "01.03.2026;" + amount + ";x\n"
+    result = import_statement(write_csv(text), store, clock=clock)
+    assert result.errors == []
+    assert store.all()[0].amount == Decimal(expected)
+
+
+@pytest.mark.parametrize("amount", ["1,234.56", "1.234,56", "-1,5.0", "1 234,5.6"])
+def test_sfera_mixed_separators_is_row_error(write_csv, clock, amount):
+    text = SFERA_HEADER + "01.03.2026;" + amount + ";x\n"
+    result = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert [e.line_no for e in result.errors] == [2]
+
+
+def test_sfera_split_accepts_dot_decimal_separator(write_csv, clock):
+    store = MemoryStore()
+    text = SPLIT_HEADER + "01.03.2026;x;;1 200.50\n02.03.2026;y;85000.00;0\n"
+    result = import_statement(write_csv(text), store, clock=clock)
+    assert result.errors == []
+    assert [t.amount for t in store.all()] == [Decimal("-1200.50"), Decimal("85000.00")]
+
+
+@pytest.mark.parametrize("zero", ["0", "0,00", "0.00"])
+def test_sfera_split_zero_in_both_columns_is_skipped(write_csv, clock, zero):
+    text = (
+        SPLIT_HEADER
+        + f"01.03.2026;Блокировка;{zero};{zero}\n"
+        + "02.03.2026;Магазин;;5,00\n"
+    )
+    result = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert result.errors == []
+    assert result.duplicates == 0
+    assert result.added == 1
+    assert [t.description for t in result.transactions] == ["Магазин"]
+
+
+def test_sfera_split_zeros_mixed_separators_are_skipped(write_csv, clock):
+    text = SPLIT_HEADER + "01.03.2026;Блокировка;0,00;0.00\n"
+    result = import_statement(write_csv(text), MemoryStore(), clock=clock, strict=True)
+    assert (result.added, result.duplicates, result.errors) == (0, 0, [])
+
+
+def test_sfera_split_skipped_row_is_not_a_duplicate(write_csv, clock):
+    store = MemoryStore()
+    text = SPLIT_HEADER + "01.03.2026;Блокировка;0,00;0,00\n" + "01.03.2026;Блокировка;0,00;0,00\n"
+    result = import_statement(write_csv(text), store, clock=clock)
+    assert (result.added, result.duplicates) == (0, 0)
+    assert store.all() == []
+
+
+def test_sfera_split_zero_with_empty_column_is_still_error(write_csv, clock):
+    text = SPLIT_HEADER + "01.03.2026;x;0,00;\n"
+    result = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert [e.line_no for e in result.errors] == [2]
+
+
+@pytest.mark.parametrize(
+    ("raw_description", "expected"),
+    [
+        ("  Магазин   Лента  ", "Магазин Лента"),
+        ("Магазин\tЛента", "Магазин Лента"),
+        ('"Оплата\n  услуг\r\n\tсвязи"', "Оплата услуг связи"),
+        ("КОФЕЙНЯ  Зерно", "КОФЕЙНЯ Зерно"),
+        ("Ёж  и  ежи", "Ёж и ежи"),
+    ],
+)
+def test_description_whitespace_is_collapsed(write_csv, clock, raw_description, expected):
+    text = SFERA_HEADER + "01.03.2026;-1,00;" + raw_description + "\n"
+    store = MemoryStore()
+    import_statement(write_csv(text), store, clock=clock)
+    assert store.all()[0].description == expected
+
+
+def test_description_whitespace_collapsed_in_nova(write_csv, clock):
+    text = 'date,amount,description\n2026-03-01,-1.00,"  Кофе\t\tЗерно  "\n'
+    store = MemoryStore()
+    import_statement(write_csv(text), store, clock=clock)
+    assert store.all()[0].description == "Кофе Зерно"
+
+
+def test_description_whitespace_collapsed_in_cp1251(write_csv, clock):
+    text = SFERA_HEADER + "01.03.2026;-1,00; Зарплата   за  март \n"
+    store = MemoryStore()
+    import_statement(write_csv(text, encoding="cp1251"), store, clock=clock)
+    assert store.all()[0].description == "Зарплата за март"
+
+
+def test_strict_collects_all_errors_and_reports_first(write_csv, clock, tmp_path):
+    path = tmp_path / "ledger.json"
+    store = JsonFileStore(path)
+    text = (
+        SFERA_HEADER
+        + "01.03.2026;-1,00;ok\n"
+        + "02.03.2026;oops;first\n"
+        + "03.03.2026;-2,00;fine\n"
+        + "04.03.2026;-3,00;\n"
+        + "05.03.2026;1,2,3;last\n"
+    )
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(text), store, strict=True, clock=clock)
+    exc = info.value
+    assert exc.line_no == 3
+    assert exc.message == "invalid amount 'oops'"
+    assert [e.line_no for e in exc.errors] == [3, 5, 6]
