+def test_registry_counters(clock):
+    reg = PromoRegistry(clock, [pct()])
+    reg.redeem("P", "u1")
+    reg.redeem("P", "u1")
+    reg.redeem("P", "u2")
+    reg.redeem("P")
+    assert reg.uses("P", "u1") == 2
+    assert reg.uses("P", "u2") == 1
+    assert reg.uses("P", "u3") == 0
+    assert reg.uses("P") == 4
+    reg.resolve("P", "u1")
+    assert reg.uses("P") == 4
+    reg.release("P", "u1")
+    assert (reg.uses("P", "u1"), reg.uses("P")) == (1, 3)
+    reg.release("P", "u3")
+    assert reg.uses("P", "u3") == 0 and reg.uses("P") == 2
+    for _ in range(5):
+        reg.release("P", "u1")
+    assert reg.uses("P") == 0 and reg.uses("P", "u1") == 0
