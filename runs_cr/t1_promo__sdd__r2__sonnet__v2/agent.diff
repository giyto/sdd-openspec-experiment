+@pytest.mark.parametrize(
+    "delta,returned",
+    [
+        (timedelta(hours=1), True),
+        (timedelta(hours=23, minutes=59, seconds=59), True),
+        (timedelta(hours=24), False),
+        (timedelta(days=3), False),
+    ],
+)
+def test_cancel_window(clock, cart, delta, returned):
+    svc, reg = service(clock)
+    order = svc.place_order(cart, "P", customer_id="u1")
+    clock.advance(delta)
+    cancelled = svc.cancel(order.order_id)
+    assert cancelled.customer_id == "u1" and cancelled.promo_code == "P"
+    expected = 0 if returned else 1
+    assert reg.uses("P") == expected and reg.uses("P", "u1") == expected
+    with pytest.raises(InvalidOrderStateError):
+        svc.cancel(order.order_id)
+    assert reg.uses("P") == expected
