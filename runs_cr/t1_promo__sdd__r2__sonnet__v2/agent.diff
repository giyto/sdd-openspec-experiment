new file mode 100644
index 0000000..2ecb78a
--- /dev/null
+++ b/tests/test_promo_autumn.py
@@ -0,0 +1,315 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import (
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    ValidationError,
+)
+from shop.orders import OrderService
+from shop.pricing import ShippingPolicy, _split_discount, calculate_total
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+def pct(value="10", **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("P", DiscountKind.FIXED, D(value), **kw)
+
+
+def free(**kw):
+    return PromoCode("P", DiscountKind.FREE_SHIPPING, D("0"), **kw)
+
+
+def prod(sku, price, category=Category.CLOTHING):
+    return Product(sku, sku, D(price), category)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+# --- model -------------------------------------------------------------------------------
+
+
+def test_free_shipping_value():
+    assert free().value == 0
+    assert PromoCode("P", DiscountKind.FREE_SHIPPING, D("0.00")).kind is DiscountKind.FREE_SHIPPING
+    with pytest.raises(ValidationError):
+        PromoCode("P", DiscountKind.FREE_SHIPPING, D("5"))
+
+
+@pytest.mark.parametrize("bad", [0, -1, True, 1.5])
+def test_bad_max_uses_per_customer(bad):
+    with pytest.raises(ValidationError):
+        pct(max_uses_per_customer=bad)
+
+
+@pytest.mark.parametrize("bad", [D("0"), D("-1"), D("1.001"), 5, D("NaN")])
+def test_bad_max_discount(bad):
+    with pytest.raises(ValidationError):
+        pct(max_discount=bad)
+
+
+def test_max_discount_only_percent():
+    with pytest.raises(ValidationError):
+        fixed("10", max_discount=D("5"))
+    with pytest.raises(ValidationError):
+        free(max_discount=D("5"))
+
+
+def test_old_promo_defaults():
+    promo = pct()
+    assert promo.max_discount is None and promo.max_uses_per_customer is None
+    assert pct(max_discount=D("150.00"), max_uses_per_customer=2).max_uses_per_customer == 2
+
+
+# --- registry ----------------------------------------------------------------------------
+
+
+def test_registry_customer_limit(clock):
+    reg = PromoRegistry(clock, [pct(max_uses_per_customer=1)])
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("P")
+    reg.resolve("P", "u1")
+    reg.redeem("P", "u1")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("P", "u1")
+    with pytest.raises(PromoConditionsError):
