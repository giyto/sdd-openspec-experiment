new file mode 100644
index 0000000..0b05672
--- /dev/null
+++ b/tests/test_reserve_improvements.py
@@ -0,0 +1,163 @@
+from datetime import timedelta
+
+import pytest
+
+from tests.conftest import T0
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    MAX_RESERVATION_LIFETIME,
+    Availability,
+    DuplicateReservationError,
+    InsufficientStockError,
+    ReservationExpiredError,
+    ReservationStatus,
+    ValidationError,
+)
+
+MIN = timedelta(minutes=1)
+
+
+def log_len(inv):
+    return len(inv.log)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 5)
+    inv.receive("B", "NUT-M8", 3)
+    return inv
+
+
+def test_constants():
+    assert DEFAULT_RESERVATION_TTL == 20 * MIN
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+
+
+def test_availability_is_frozen_model():
+    a = Availability("A", "BOLT-M8", 5, 2, 3)
+    with pytest.raises(Exception):
+        a.on_hand = 1
+
+
+def test_ttl_limit(stocked):
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    assert r.expires_at == r.created_at + timedelta(hours=2)
+    before = log_len(stocked)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-2", [("A", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME + timedelta(seconds=1))
+    assert log_len(stocked) == before
+    assert [x.order_id for x in stocked.reservations()] == ["SO-1"]
+
+
+def test_replace_active(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 5)])
+    clock.advance(5 * MIN)
+    n = log_len(stocked)
+    r = stocked.reserve("SO-1", [("A", "BOLT-M8", 5)], ttl=10 * MIN)
+    assert r.status is ReservationStatus.ACTIVE
+    assert r.created_at == T0 + 5 * MIN and r.expires_at == T0 + 15 * MIN
+    assert stocked.reserved("A", "BOLT-M8") == 5
+    assert log_len(stocked) == n + 2
+    assert len(stocked.reservations()) == 1
+
+
+def test_failed_replace_keeps_old(stocked):
+    stocked.reserve("SO-0", [("A", "BOLT-M8", 3)])
+    old = stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    n = log_len(stocked)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 3)])
+    assert (exc.value.requested, exc.value.available) == (3, 2)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=timedelta(0))
+    assert stocked.get_reservation("SO-1") == old
+    assert log_len(stocked) == n
+
+
+def test_duplicate_confirmed(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    n = log_len(stocked)
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    assert log_len(stocked) == n
+
+
+def test_extend_capped(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)], ttl=90 * MIN)
+    clock.advance(timedelta(hours=1))
+    stocked.extend("SO-1", timedelta(hours=3))
+    r = stocked.get_reservation("SO-1")
+    assert r.expires_at == T0 + timedelta(hours=2)
+    n = log_len(stocked)
+    stocked.extend("SO-1", timedelta(hours=5))
+    assert log_len(stocked) == n
+    clock.advance(timedelta(hours=1))
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-1", MIN)
+
+
+def test_cancel_confirmed_refunds(stocked):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 3), ("B", "NUT-M8", 2), ("A", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    assert stocked.on_hand("A", "BOLT-M8") == 1
+    r = stocked.cancel("SO-1")
+    assert r.status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("A", "BOLT-M8") == 5
+    assert stocked.on_hand("B", "NUT-M8") == 3
+    n = log_len(stocked)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("A", "BOLT-M8") == 5 and log_len(stocked) == n
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+
+
+def test_refund_after_expiry_time(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)])
+    stocked.confirm("SO-1")
+    clock.advance(timedelta(hours=3))
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("A", "BOLT-M8") == 5
+
+
+def test_reservations_order_and_filter(stocked, clock):
+    stocked.reserve("SO-2", [("A", "BOLT-M8", 1)], ttl=MIN)
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 1)])
+    clock.advance(MIN)
+    stocked.reserve("SO-0", [("A", "BOLT-M8", 1)])
+    assert [r.order_id for r in stocked.reservations()] == ["SO-1", "SO-2", "SO-0"]
+    n = log_len(stocked)
+    expired = stocked.reservations(ReservationStatus.EXPIRED)
+    assert [r.order_id for r in expired] == ["SO-2"]
+    assert log_len(stocked) == n
+
+
+def test_availability(stocked, clock):
+    stocked.reserve("SO-1", [("A", "BOLT-M8", 2)], ttl=MIN)
+    assert stocked.availability() == [
+        Availability("A", "BOLT-M8", 5, 2, 3),
+        Availability("B", "NUT-M8", 3, 0, 3),
+    ]
+    assert stocked.availability("B") == [Availability("B", "NUT-M8", 3, 0, 3)]
+    stocked.adjust("A", "BOLT-M8", 0, "count")
+    assert stocked.availability("A") == [Availability("A", "BOLT-M8", 0, 2, 0)]
+    clock.advance(MIN)
+    assert stocked.availability("A") == []
+
+
+def test_sweep_expired(stocked, clock):
+    stocked.reserve("SO-B", [("A", "BOLT-M8", 1)], ttl=MIN)
+    stocked.reserve("SO-C", [("A", "BOLT-M8", 1)], ttl=2 * MIN)
+    stocked.reserve("SO-A", [("A", "BOLT-M8", 1)], ttl=2 * MIN)
+    stocked.reserve("SO-OK", [("A", "BOLT-M8", 1)], ttl=timedelta(hours=1))
+    assert stocked.sweep_expired() == []
+    clock.advance(2 * MIN)
+    n = log_len(stocked)
+    assert stocked.sweep_expired() == ["SO-B", "SO-A", "SO-C"]
+    assert log_len(stocked) == n + 3
+    assert stocked.get_reservation("SO-B").status is ReservationStatus.EXPIRED
+    assert stocked.sweep_expired() == []
+    assert log_len(stocked) == n + 3
+    # повторный резерв того же заказа
+    stocked.reserve("SO-B", [("A", "BOLT-M8", 1)], ttl=MIN)
+    clock.advance(MIN)
+    assert stocked.sweep_expired() == ["SO-B"]
