diff --git a/tests/test_reservations_rework.py b/tests/test_reservations_rework.py
new file mode 100644
index 0000000..c7d9845
--- /dev/null
+++ b/tests/test_reservations_rework.py
@@ -0,0 +1,309 @@
+from datetime import timedelta
+
+import pytest
+
+import warehouse
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    MAX_RESERVATION_LIFETIME,
+    Availability,
+    DuplicateReservationError,
+    InsufficientStockError,
+    ReservationStatus,
+    ValidationError,
+)
+from warehouse.storage import InMemoryStore
+
+from conftest import T0
+
+MIN = timedelta(minutes=1)
+HOUR = timedelta(hours=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("EXTRA", "NUT-M8", 5)
+    return inv
+
+
+# --- константы, модель, хранилище -------------------------------------------
+
+
+def test_constants_model_and_exports():
+    assert DEFAULT_RESERVATION_TTL == 20 * MIN
+    assert MAX_RESERVATION_LIFETIME == 2 * HOUR
+    assert warehouse.Availability is Availability and "Availability" in warehouse.__all__
+    assert "MAX_RESERVATION_LIFETIME" in warehouse.__all__
+    item = Availability("MAIN", "BOLT-M8", 1, 0, 1)
+    with pytest.raises(Exception):
+        item.on_hand = 5
+
+
+def test_store_tracks_recorded_expiries():
+    store = InMemoryStore()
+    assert not store.is_expiry_recorded("SO-1", T0)
+    store.mark_expiry_recorded("SO-1", T0)
+    assert store.is_expiry_recorded("SO-1", T0)
+    assert not store.is_expiry_recorded("SO-1", T0 + MIN)
+    assert not store.is_expiry_recorded("SO-2", T0)
+
+
+# --- предел и ttl -----------------------------------------------------------
+
+
+def test_reserve_ttl_limit(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=2 * HOUR)
+    assert res.expires_at == T0 + 2 * HOUR
+    before = len(stocked.log)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=2 * HOUR + timedelta(seconds=1))
+    assert len(stocked.log) == before
+
+
+def test_reserve_ttl_limit_checked_before_stock_and_keeps_active(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    before = stocked.log.lines()
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 999)], ttl=3 * HOUR)
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert stocked.log.lines() == before
+
+
+def test_default_ttl_is_20_minutes(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert res.expires_at == T0 + 20 * MIN
+
+
+# --- замена -----------------------------------------------------------------
+
+
+def test_replace_active_reservation(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    clock.advance(5 * MIN)
+    new = stocked.reserve("SO-1", [("EXTRA", "NUT-M8", 2), ("MAIN", "BOLT-M8", 1)])
+    assert new.status is ReservationStatus.ACTIVE
+    assert new.created_at == T0 + 5 * MIN and new.expires_at == T0 + 25 * MIN
+    assert stocked.get_reservation("SO-1") == new
+    assert stocked.reserved("MAIN", "BOLT-M8") == 1
+    assert stocked.reserved("EXTRA", "NUT-M8") == 2
+
+
+def test_replace_event_order(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    n = len(stocked.log)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("EXTRA", "NUT-M8", 1)])
+    events = stocked.log.events()[n:]
+    assert [e.kind for e in events] == ["RESERVE_CANCEL", "RESERVE", "RESERVE"]
+    assert events[0].get("order") == "SO-1"
+    assert [e.get("wh") for e in events[1:]] == ["MAIN", "EXTRA"]
+
+
+def test_replaced_goods_count_as_free(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    assert res.status is ReservationStatus.ACTIVE
+
+
+def test_replace_insufficient_is_atomic(stocked):
+    stocked.reserve("SO-0", [("MAIN", "BOLT-M8", 5)])
+    old = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    before = stocked.log.lines()
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 6)])
+    assert (exc.value.requested, exc.value.available) == (6, 5)
+    assert stocked.get_reservation("SO-1") == old
+    assert stocked.log.lines() == before
+
+
+def test_replace_confirmed_still_duplicate(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_after_expiry_or_cancel_has_no_cancel_event(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(30 * MIN)
+    n = len(stocked.log)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert [e.kind for e in stocked.log.events()[n:]] == ["RESERVE"]
+    stocked.cancel("SO-1")
+    n = len(stocked.log)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert [e.kind for e in stocked.log.events()[n:]] == ["RESERVE"]
+
+
+# --- возврат ----------------------------------------------------------------
+
+
+def test_cancel_confirmed_is_refund(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("EXTRA", "NUT-M8", 2)])
+    stocked.confirm("SO-1")
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 7
+    clock.advance(5 * HOUR)
+    n = len(stocked.log)
+    res = stocked.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.on_hand("EXTRA", "NUT-M8") == 5
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    events = stocked.log.events()[n:]
+    assert [e.kind for e in events] == ["RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+    assert [(e.get("wh"), e.get("sku"), e.get("qty"), e.get("ref")) for e in events[:2]] == [
+        ("MAIN", "BOLT-M8", "3", "SO-1"),
+        ("EXTRA", "NUT-M8", "2", "SO-1"),
+    ]
+    assert events[2].get("order") == "SO-1"
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CANCELLED
+
+
+def test_repeat_refund_is_noop(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-1")
+    lines = stocked.log.lines()
+    res = stocked.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert stocked.log.lines() == lines
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+
+
+# --- extend -----------------------------------------------------------------
+
+
+def test_extend_capped_at_limit(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(10 * MIN)
+    res = stocked.extend("SO-1", 5 * HOUR)
+    assert res.expires_at == T0 + 2 * HOUR
+    last = stocked.log.events()[-1]
+    assert last.kind == "RESERVE_EXTEND" and last.get("expires") == "2026-03-01T12:00:00Z"
+
+
+def test_extend_at_limit_is_noop(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=2 * HOUR)
+    clock.advance(10 * MIN)
+    lines = stocked.log.lines()
+    res = stocked.extend("SO-1", HOUR)
+    assert res.expires_at == T0 + 2 * HOUR
+    assert stocked.log.lines() == lines
+
+
+def test_extend_basic_and_validation(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=15 * MIN)
+    clock.advance(10 * MIN)
+    assert stocked.extend("SO-1", 30 * MIN).expires_at == T0 + 40 * MIN
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+
+
+# --- reservations -----------------------------------------------------------
+
+
+def test_reservations_sorted_and_filtered(stocked, clock):
+    assert stocked.reservations() == []
+    stocked.reserve("SO-B", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    stocked.reserve("SO-A", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-C", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-C")
+    clock.advance(MIN)
+    stocked.reserve("SO-D", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-D")
+    clock.advance(10 * MIN)
+    lines = stocked.log.lines()
+    assert [r.order_id for r in stocked.reservations()] == ["SO-A", "SO-B", "SO-C", "SO-D"]
+    assert [r.status for r in stocked.reservations()] == [
+        ReservationStatus.ACTIVE,
+        ReservationStatus.EXPIRED,
+        ReservationStatus.CONFIRMED,
+        ReservationStatus.CANCELLED,
+    ]
+    expired = stocked.reservations(ReservationStatus.EXPIRED)
+    assert [(r.order_id, r.status) for r in expired] == [("SO-B", ReservationStatus.EXPIRED)]
+    assert [r.order_id for r in stocked.reservations(ReservationStatus.ACTIVE)] == ["SO-A"]
+    with pytest.raises(ValidationError):
+        stocked.reservations("ACTIVE")
+    assert stocked.log.lines() == lines
+
+
+def test_reservations_one_per_order(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-1")
+    new = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert stocked.reservations() == [new]
+
+
+# --- availability -----------------------------------------------------------
+
+
+def test_availability_values_order_and_filter(stocked):
+    stocked.receive("EXTRA", "BOLT-M8", 1)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    rows = stocked.availability()
+    assert rows == [
+        Availability("EXTRA", "BOLT-M8", 1, 0, 1),
+        Availability("EXTRA", "NUT-M8", 5, 0, 5),
+        Availability("MAIN", "BOLT-M8", 10, 4, 6),
+    ]
+    for row in rows:
+        assert row.on_hand == stocked.on_hand(row.warehouse, row.sku)
+        assert row.reserved == stocked.reserved(row.warehouse, row.sku)
+        assert row.available == stocked.available(row.warehouse, row.sku)
+    assert [r.sku for r in stocked.availability("EXTRA")] == ["BOLT-M8", "NUT-M8"]
+    assert stocked.availability("NOPE") == []
+
+
+def test_availability_reserved_zero_stock_and_expired(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.adjust("MAIN", "BOLT-M8", 0, "recount")
+    assert Availability("MAIN", "BOLT-M8", 0, 4, 0) in stocked.availability()
+    clock.advance(HOUR)
+    assert all(r.sku != "BOLT-M8" or r.warehouse != "MAIN" for r in stocked.availability())
+
+
+# --- sweep_expired ----------------------------------------------------------
+
+
+def test_sweep_expired_records_once_in_order(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=10 * MIN)
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    stocked.reserve("SO-4", [("MAIN", "BOLT-M8", 1)])
+    assert stocked.sweep_expired() == []
+    clock.advance(10 * MIN)
+    n = len(stocked.log)
+    assert stocked.sweep_expired() == ["SO-2", "SO-3", "SO-1"]
+    events = stocked.log.events()[n:]
+    assert [e.kind for e in events] == ["RESERVE_EXPIRE"] * 3
+    assert [e.get("order") for e in events] == ["SO-2", "SO-3", "SO-1"]
+    assert events[0].get("expires") == "2026-03-01T10:05:00Z"
+    assert events[2].get("expires") == "2026-03-01T10:10:00Z"
+    lines = stocked.log.lines()
+    assert stocked.sweep_expired() == []
+    assert stocked.log.lines() == lines
+
+
+def test_sweep_expired_reissued_order_and_no_state_change(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)], ttl=5 * MIN)
+    clock.advance(6 * MIN)
+    assert stocked.sweep_expired() == ["SO-1"]
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)], ttl=5 * MIN)
+    clock.advance(6 * MIN)
+    assert stocked.sweep_expired() == ["SO-1"]
+    assert len(stocked.log.events("RESERVE_EXPIRE")) == 2
+
+
+def test_sweep_ignores_non_expired_statuses(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    stocked.cancel("SO-3")
+    clock.advance(HOUR)
+    assert stocked.sweep_expired() == ["SO-1"]
