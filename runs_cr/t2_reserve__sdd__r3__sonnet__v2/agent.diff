+    def reservations(self, status: ReservationStatus | None = None) -> list[Reservation]:
+        """Снимки резервов со статусом на текущий момент, по ``(created_at, order_id)``."""
+        if status is not None and not isinstance(status, ReservationStatus):
+            raise ValidationError(f"status must be a ReservationStatus, got {status!r}")
+        now = self._clock.now()
+        snapshots = [with_effective_status(r, now) for r in self._store.reservations()]
+        if status is not None:
+            snapshots = [r for r in snapshots if r.status is status]
+        return sorted(snapshots, key=lambda r: (r.created_at, r.order_id))
+
+    def availability(self, warehouse: str | None = None) -> list[Availability]:
+        """Позиции с остатком или активным резервом, по складу и SKU."""
+        now = self._clock.now()
+        keys = {(wh, sku) for wh, sku, _ in self._store.positions()}
+        for reservation in self._store.reservations():
+            if effective_status(reservation, now) is ReservationStatus.ACTIVE:
+                keys.update((line.warehouse, line.sku) for line in reservation.lines)
+        result = []
