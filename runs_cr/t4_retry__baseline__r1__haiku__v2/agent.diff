+def test_requeue_all_restarts_in_dead_letter_order(queue, registry, clock):
+    registry.register("t", _always_fail(RuntimeError("x")))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    jobs = [queue.enqueue("t", {"n": n}) for n in range(3)]
+    Worker(queue, registry).run_pending()
+
+    requeued = queue.requeue_all_dead_letters()
+    assert requeued == jobs
+    assert all(j.status is JobStatus.PENDING for j in jobs)
+    assert all(j.attempts == 0 and j.error is None for j in jobs)
+    assert all(j.run_at == clock.now() for j in jobs)
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.requeued") == 3
+
