+def test_purge_dead_letter_age_counts_from_dead_lettering(queue, registry, clock):
+    registry.register("t", _always_fail(RuntimeError("x")))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    old = queue.enqueue("t")
+    Worker(queue, registry).run_once()  # DL в START
+    clock.advance(100)
+    fresh = queue.enqueue("t")
+    Worker(queue, registry).run_once()  # DL в START+100
+    clock.advance(50)  # сейчас START+150
+
+    assert queue.purge_finished(older_than=100) == 1
+    assert [e.job_id for e in queue.dead_letters()] == [fresh.id]
+    assert old.id not in [j.id for j in queue.list_jobs()]
