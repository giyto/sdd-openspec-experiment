+class RetryLaterError(JobqError):
+    """Временная ошибка, после которой внешний сервис сам назвал время следующей попытки.
+
+    ``retry_after`` — секунды до следующей попытки. Задержка режется до ``max_delay`` политики
+    и не получает джиттер.
+    """
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        super().__init__(message)
+        if not math.isfinite(retry_after) or retry_after < 0:
+            raise ConfigError("retry_after must be a finite number >= 0")
+        self.retry_after = float(retry_after)
 
 
