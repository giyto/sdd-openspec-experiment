@@ -0,0 +1,267 @@
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterReason,
+    HandlerRegistry,
+    JobNotFoundError,
+    JobStatus,
+    PermanentJobError,
+    RetryLaterError,
+    RetryPolicy,
+    Worker,
+)
+
+from .conftest import START
+
+
+def _always_fail(exc):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+# -- неповторяемые ошибки -----------------------------------------------------
+
+
+@pytest.mark.parametrize("exc", [ValueError("bad"), PermanentJobError("closed")])
+def test_non_retryable_goes_to_dead_letter_with_reason(queue, registry, exc):
+    registry.register("t", _always_fail(exc))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=5, non_retryable=(ValueError,)))
+    job = queue.enqueue("t")
+    Worker(queue, registry).run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.attempts == 1
+    [entry] = queue.dead_letters()
+    assert entry.reason is DeadLetterReason.NON_RETRYABLE
+    assert entry.dead_lettered_at == START
+
+
+def test_non_retryable_on_last_attempt_is_non_retryable_reason(queue, registry, clock):
+    registry.register("t", _always_fail(TimeoutError("x")))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1, non_retryable=(TimeoutError,)))
+    job = queue.enqueue("t")
+    Worker(queue, registry).run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_exhausted_reason(queue, registry):
+    registry.register("t", _always_fail(TimeoutError("x")))
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    queue.enqueue("t")
+    Worker(queue, registry).run_once()
+
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_permanent_error_without_policy_still_fails(queue, registry):
+    registry.register("t", _always_fail(PermanentJobError("no")))
+    job = queue.enqueue("t")
+    Worker(queue, registry).run_once()
+
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_mark_dead_lettered_reason_is_optional(queue):
+    job = queue.enqueue("t")
+    queue.mark_running(job.id)
+    queue.mark_dead_lettered(job.id, "X: y")
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+# -- джиттер -------------------------------------------------------------------
+
+
+def test_jitter_multiplier_is_uniform_one_minus_jitter_to_one():
+    calls = []
+
+    class Recording(random.Random):
+        def uniform(self, a, b):
+            calls.append((a, b))
+            return a
+
+    policy = RetryPolicy(base_delay=10.0, factor=2.0, max_delay=100.0, jitter=0.3)
+    assert policy.delay_for(2, Recording()) == pytest.approx(20.0 * 0.7)
+    assert calls == [(0.7, 1)]
+
+
+def test_jitter_never_exceeds_scheduled_delay():
+    rng = random.Random(5)
+    policy = RetryPolicy(base_delay=2.0, factor=2.0, max_delay=30.0, jitter=0.5)
+    for attempt in range(1, 10):
+        scheduled = min(2.0 * 2.0 ** (attempt - 1), 30.0)
+        for _ in range(50):
+            assert policy.delay_for(attempt, rng) <= scheduled
+
+
+# -- RetryLaterError -----------------------------------------------------------
+
+
+def test_retry_later_error_rejects_negative_retry_after():
+    with pytest.raises(ConfigError):
+        RetryLaterError("slow down", retry_after=-1.0)
+
+
+def test_retry_later_error_rejects_nan_retry_after():
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=float("nan"))
+
+
+def test_retry_later_error_stores_retry_after_as_float():
+    err = RetryLaterError(retry_after=5)
+    assert err.retry_after == 5.0
+    assert isinstance(err.retry_after, float)
+
+
+def test_retry_later_uses_retry_after_instead_of_policy(queue, registry, clock):
+    calls = {"n": 0}
+
+    def handler(job):
+        calls["n"] += 1
+        if calls["n"] == 1:
+            raise RetryLaterError("throttled", retry_after=7.0)
+        return "ok"
+
+    registry.register("billing", handler)
+    queue.set_retry_policy(
+        "billing", RetryPolicy(max_attempts=3, base_delay=100.0, max_delay=200.0, jitter=0.5)
+    )
+    job = queue.enqueue("billing")
+    worker = Worker(queue, registry, rng=random.Random(1))
+    worker.run_once()
+
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.error == "RetryLaterError: throttled"
+    assert job.run_at == START + timedelta(seconds=7)
+    assert queue.metrics.get("jobs.retried") == 1
+
+    clock.advance(7)
+    worker.run_once()
+    assert job.status is JobStatus.SUCCEEDED
+
