diff --git a/tests/test_statement_import_v2.py b/tests/test_statement_import_v2.py
new file mode 100644
index 0000000..3c31668
--- /dev/null
+++ b/tests/test_statement_import_v2.py
@@ -0,0 +1,147 @@
+import dataclasses
+import json
+
+import pytest
+
+from decimal import Decimal
+
+from ledger.errors import RowError as ErrorsRowError
+from ledger.errors import StatementRowError
+from ledger.importer import ImportResult, RowError, import_csv, import_statement
+from ledger.models import Transaction
+from ledger.storage import JsonFileStore, MemoryStore
+import datetime as dt
+
+SFERA = "Дата;Сумма;Описание\n"
+SPLIT = "Дата;Описание;Приход;Расход\n"
+NOVA = "date,amount,description\n"
+
+
+def test_row_error_reexport_and_errors():
+    assert RowError is ErrorsRowError
+    exc = StatementRowError("x", line_no=3)
+    assert exc.errors == [RowError(3, "x")]
+    assert str(exc) == "line 3: x"
+    assert StatementRowError("y").errors == []
+    assert RowError(1, "m").raw == ""
+
+
+def test_import_result_default_transactions():
+    res = ImportResult("nova", "utf-8", 0, 0, [])
+    assert res.transactions == []
+
+
+@pytest.mark.parametrize("amount", ["-1 234.56", "-1 234,56"])
+def test_amount_separators(write_csv, amount):
+    store = MemoryStore()
+    res = import_statement(write_csv(SFERA + f"01.03.2026;{amount};x\n"), store)
+    assert res.errors == []
+    assert store.all()[0].amount == Decimal("-1234.56")
+    split = import_statement(
+        write_csv(SPLIT + f"01.03.2026;y;;{amount[1:]}\n", name="b.csv"), MemoryStore()
+    )
+    assert split.transactions[0].amount == Decimal("-1234.56")
+
+
+@pytest.mark.parametrize("amount", ["1.234,56", "1,234.56", "1 234.567", "0.00"])
+def test_amount_bad(write_csv, amount):
+    res = import_statement(write_csv(SFERA + f"01.03.2026;{amount};x\n"), MemoryStore())
+    assert res.added == 0 and len(res.errors) == 1
+
+
+@pytest.mark.parametrize(
+    "a, b", [("0", "0"), ("0,00", "0,00"), ("0.00", "0"), ("0", "0,00")]
+)
+@pytest.mark.parametrize("strict", [False, True])
+def test_split_zero_rows_skipped(write_csv, a, b, strict):
+    text = SPLIT + f"01.03.2026;ok;10,00;\n01.03.2026;svc;{a};{b}\n01.03.2026;bad;;\n"
+    store = MemoryStore()
+    if strict:
+        text = text.replace("01.03.2026;bad;;\n", "")
+    res = import_statement(write_csv(text), store, strict=strict)
+    assert (res.added, res.duplicates) == (1, 0)
+    assert [e.line_no for e in res.errors] == ([] if strict else [4])
+
+
+@pytest.mark.parametrize("a, b", [("0,00", ""), ("0,00", "abc"), ("+0,00", "0,00")])
+def test_split_zero_still_errors(write_csv, a, b):
+    res = import_statement(write_csv(SPLIT + f"01.03.2026;x;{a};{b}\n"), MemoryStore())
+    assert res.added == 0 and len(res.errors) == 1
+
+
+def test_description_normalized(write_csv):
+    store = MemoryStore()
+    old = Transaction(
+        date=dt.date(2026, 3, 1), amount=Decimal("-5.00"), description="Кофе  Бар",
+        imported_at=dt.datetime(2026, 1, 1, tzinfo=dt.timezone.utc),
+    )
+    store.add_many([old])
+    text = SFERA + '01.03.2026;-5,00;"  Кофе\t\n Бар "\n02.03.2026;-1,00;"a  B"\n03.03.2026;-1,00;   \n'
+    res = import_statement(write_csv(text), store)
+    assert res.duplicates == 1
+    assert [t.description for t in res.transactions] == ["a B"]
+    assert [e.line_no for e in res.errors] == [5]
+
+
+def test_raw(write_csv):
+    text = SFERA + 'bad;1;x\r\n01.03.2026;-5,00;"a\r\nb"\r\n02.03.2026;zz;"m\nn"\r\n'
+    res = import_statement(write_csv(text, encoding="utf-8-sig"), MemoryStore())
+    assert [(e.line_no, e.raw) for e in res.errors] == [
+        (2, "bad;1;x"),
+        (5, '02.03.2026;zz;"m\nn"'),
+    ]
+    cp = import_statement(write_csv("Дата;Сумма;Описание\nбб;1;я\n", name="c.csv", encoding="cp1251"), MemoryStore())
+    assert cp.encoding == "cp1251" and cp.errors[0].raw == "бб;1;я"
+
+
+def test_raw_csv_error(write_csv):
+    res = import_statement(write_csv(SFERA + '01.03.2026;-5,00;"oops\nmore\n'), MemoryStore())
+    assert res.errors[0].line_no == 2
+    assert res.errors[0].raw == '01.03.2026;-5,00;"oops\nmore'
+
+
+def test_strict_all_errors(write_csv, tmp_path):
+    path = tmp_path / "s.json"
+    store = JsonFileStore(path)
+    text = SFERA + "01.03.2026;-5,00;a\nbad;1;b\n01.03.2026;-5,00;c\n01.03.2026;x;d\n"
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(text), store, strict=True)
+    assert info.value.line_no == 3
+    assert [e.line_no for e in info.value.errors] == [3, 5]
+    assert store.all() == [] and not path.exists()
+    path2 = write_csv(NOVA + "2026-03-01,-5.00,a\n2026-03-02,zz,b\n2026-03-03,yy,c\n", name="n.csv")
+    with pytest.raises(StatementRowError) as info:
+        import_csv(path2, store)
+    assert [e.line_no for e in info.value.errors] == [3, 4]
+    assert not path.exists()
+
+
+def _strip(txs):
+    return [dataclasses.replace(t, id=None) for t in txs]
+
+
+def test_dry_run(write_csv, tmp_path, clock):
+    path = tmp_path / "s.json"
+    store = JsonFileStore(path)
+    seed = write_csv(SFERA + "01.03.2026;-1,00;dup\n", name="seed.csv")
+    import_statement(seed, store)
+    before = path.read_text(encoding="utf-8")
+    text = SFERA + "01.03.2026;-1,00;dup\n02.03.2026;-2,00;a\nbad;1;x\n03.03.2026;-3,00;b\n"
+    f = write_csv(text)
+    preview = import_statement(f, store, dry_run=True, clock=clock)
+    assert path.read_text(encoding="utf-8") == before and len(store.all()) == 1
+    assert all(t.id is None for t in preview.transactions)
+    real = import_statement(f, store, clock=clock)
+    for name in ("format", "encoding", "added", "duplicates", "errors"):
+        assert getattr(preview, name) == getattr(real, name)
+    assert _strip(preview.transactions) == _strip(real.transactions)
+    assert real.transactions == store.all()[1:]
+    assert [t.description for t in real.transactions] == ["a", "b"]
+    assert all(t.id is not None for t in real.transactions)
+
+
+def test_dry_run_strict_raises(write_csv):
+    store = MemoryStore()
+    with pytest.raises(StatementRowError):
+        import_statement(write_csv(SFERA + "bad;1;x\n"), store, strict=True, dry_run=True)
+    assert store.all() == []
