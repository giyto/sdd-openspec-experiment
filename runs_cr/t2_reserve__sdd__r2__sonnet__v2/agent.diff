diff --git a/tests/test_reservations_followups.py b/tests/test_reservations_followups.py
new file mode 100644
index 0000000..f1b0242
--- /dev/null
+++ b/tests/test_reservations_followups.py
@@ -0,0 +1,164 @@
+from datetime import timedelta
+
+import pytest
+
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    MAX_RESERVATION_LIFETIME,
+    Availability,
+    DuplicateReservationError,
+    InsufficientStockError,
+    ReservationExpiredError,
+    ReservationStateError,
+    ReservationStatus,
+    ValidationError,
+)
+
+
+def kinds(inv):
+    return [e.kind for e in inv.log]
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("A", "BOLT-M8", 10)
+    inv.receive("B", "NUT-M8", 10)
+    return inv
+
+
+def test_limits():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=20)
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+
+
+def test_ttl_limit(stocked, clock):
+    res = stocked.reserve("O1", [("A", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    assert res.expires_at == res.created_at + timedelta(hours=2)
+    before = len(list(stocked.log))
+    with pytest.raises(ValidationError):
+        stocked.reserve("O2", [("A", "BOLT-M8", 1)], ttl=timedelta(hours=2, seconds=1))
+    assert len(list(stocked.log)) == before
+
+
+def test_replace_active(stocked, clock):
+    stocked.reserve("O1", [("A", "BOLT-M8", 5)])
+    clock.advance(timedelta(minutes=5))
+    n = len(list(stocked.log))
+    res = stocked.reserve("O1", [("A", "BOLT-M8", 10), ("B", "NUT-M8", 1)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + DEFAULT_RESERVATION_TTL
+    assert kinds(stocked)[n:] == ["RESERVE_CANCEL", "RESERVE", "RESERVE"]
+    assert stocked.reserved("A", "BOLT-M8") == 10
+    assert len(stocked.reservations()) == 1
+
+
+def test_failed_replace_changes_nothing(stocked):
+    first = stocked.reserve("O1", [("A", "BOLT-M8", 5)])
+    n = len(list(stocked.log))
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("O1", [("A", "BOLT-M8", 11)])
+    assert stocked.get_reservation("O1") == first
+    assert len(list(stocked.log)) == n
+
+
+def test_replace_expired_and_confirmed(stocked, clock):
+    stocked.reserve("O1", [("A", "BOLT-M8", 5)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    n = len(list(stocked.log))
+    stocked.reserve("O1", [("A", "BOLT-M8", 2)])
+    assert "RESERVE_CANCEL" not in kinds(stocked)[n:]
+    stocked.confirm("O1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("O1", [("A", "BOLT-M8", 1)])
+
+
+def test_refund_confirmed(stocked):
+    stocked.reserve("O1", [("A", "BOLT-M8", 3), ("B", "NUT-M8", 4)])
+    stocked.confirm("O1")
+    assert stocked.on_hand("A", "BOLT-M8") == 7
+    n = len(list(stocked.log))
+    res = stocked.cancel("O1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+    assert stocked.on_hand("B", "NUT-M8") == 10
+    events = list(stocked.log)[n:]
+    assert [e.kind for e in events] == ["RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+    stocked.cancel("O1")
+    assert len(list(stocked.log)) == n + 3
+    assert stocked.on_hand("A", "BOLT-M8") == 10
+
+
+def test_extend_capped(stocked, clock):
+    res = stocked.reserve("O1", [("A", "BOLT-M8", 1)], ttl=timedelta(minutes=100))
+    clock.advance(timedelta(minutes=90))
+    ext = stocked.extend("O1", timedelta(days=10**6))
+    assert ext.expires_at == res.created_at + MAX_RESERVATION_LIFETIME
+    n = len(list(stocked.log))
+    stocked.extend("O1", timedelta(minutes=5))
+    assert len(list(stocked.log)) == n
+    clock.advance(timedelta(minutes=30))
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("O1", timedelta(minutes=5))
+
+
+def test_extend_state_errors(stocked):
+    stocked.reserve("O1", [("A", "BOLT-M8", 1)])
+    stocked.confirm("O1")
+    with pytest.raises(ReservationStateError):
+        stocked.extend("O1", timedelta(minutes=5))
+
+
+def test_reservations_listing(stocked, clock):
+    stocked.reserve("B", [("A", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    stocked.reserve("A", [("A", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=2))
+    stocked.reserve("C", [("A", "BOLT-M8", 1)])
+    assert [r.order_id for r in stocked.reservations()] == ["A", "B", "C"]
+    expired = stocked.reservations(ReservationStatus.EXPIRED)
+    assert [r.order_id for r in expired] == ["B"]
+
+
+def test_availability(stocked):
+    stocked.reserve("O1", [("A", "BOLT-M8", 4)])
+    stocked.receive("B", "OIL-5L", 1)
+    stocked.adjust("B", "OIL-5L", 0, "count")
+    assert stocked.availability("A") == [Availability("A", "BOLT-M8", 10, 4, 6)]
+    assert [(a.warehouse, a.sku) for a in stocked.availability()] == [
+        ("A", "BOLT-M8"),
+        ("B", "NUT-M8"),
+    ]
+    assert stocked.availability("ZZ") == []
+
+
+def test_availability_reserve_without_stock(stocked):
+    stocked.reserve("O1", [("A", "BOLT-M8", 3)])
+    stocked.adjust("A", "BOLT-M8", 0, "lost")
+    assert stocked.availability("A") == [Availability("A", "BOLT-M8", 0, 3, 0)]
+
+
+def test_sweep_expired(stocked, clock):
+    stocked.reserve("B", [("A", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    stocked.reserve("A", [("A", "BOLT-M8", 1)], ttl=timedelta(minutes=2))
+    stocked.reserve("D", [("A", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    stocked.reserve("X", [("A", "BOLT-M8", 1)])
+    stocked.reserve("Y", [("A", "BOLT-M8", 1)])
+    stocked.confirm("Y")
+    clock.advance(timedelta(minutes=3))
+    n = len(list(stocked.log))
+    assert stocked.sweep_expired() == ["B", "D", "A"]
+    events = list(stocked.log)[n:]
+    assert [e.kind for e in events] == ["RESERVE_EXPIRE"] * 3
+    assert stocked.get_reservation("B").status is ReservationStatus.EXPIRED
+    assert stocked.sweep_expired() == []
+    assert len(list(stocked.log)) == n + 3
+
+
+def test_sweep_after_new_reservation_expires_again(stocked, clock):
+    stocked.reserve("O1", [("A", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    clock.advance(timedelta(minutes=1))
+    assert stocked.sweep_expired() == ["O1"]
+    stocked.reserve("O1", [("A", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    assert stocked.sweep_expired() == []
+    clock.advance(timedelta(minutes=1))
+    assert stocked.sweep_expired() == ["O1"]
