diff --git a/tests/test_import_followup.py b/tests/test_import_followup.py
new file mode 100644
index 0000000..cd3c5c6
--- /dev/null
+++ b/tests/test_import_followup.py
@@ -0,0 +1,51 @@
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementRowError
+from ledger.importer import import_statement
+from ledger.storage import MemoryStore
+
+SPLIT = "Дата;Описание;Приход;Расход\n"
+
+
+def test_sfera_both_separators(write_csv, clock):
+    text = "Дата;Сумма;Описание\n01.03.2026;-1 234.56;a\n02.03.2026;-1 234,56;b\n03.03.2026;1,234.56;c\n"
+    res = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert res.added == 2 and [e.line_no for e in res.errors] == [4]
+
+
+def test_split_zero_rows_skipped(write_csv, clock):
+    text = SPLIT + "01.03.2026;Блок;0,00;0.00\n02.03.2026;x;0,00;\n03.03.2026;y;;5.5\n"
+    res = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert (res.added, res.duplicates) == (1, 0)
+    assert [e.line_no for e in res.errors] == [3]
+
+
+def test_description_whitespace(write_csv, clock):
+    text = 'Дата;Сумма;Описание\n01.03.2026;-1,00;"  Оплата \n\t  Ёлка  "\n'
+    store = MemoryStore()
+    import_statement(write_csv(text), store, clock=clock)
+    assert store.all()[0].description == "Оплата Ёлка"
+
+
+def test_strict_collects_all_and_dry_run(write_csv, clock):
+    text = "date,amount,description\n2026-03-01,x,a\n2026-03-02,-1.00,b\n2026-03-03,y,c\n"
+    path = write_csv(text)
+    with pytest.raises(StatementRowError) as info:
+        import_statement(path, MemoryStore(), strict=True, clock=clock)
+    exc = info.value
+    assert [e.line_no for e in exc.errors] == [2, 4] and exc.line_no == 2
+    assert exc.errors[0].raw == "2026-03-01,x,a"
+    store = MemoryStore()
+    res = import_statement(path, store, clock=clock, dry_run=True)
+    assert store.all() == [] and res.added == 1
+    assert [t.id for t in res.transactions] == [None]
+    res = import_statement(path, store, clock=clock)
+    assert [t.id for t in res.transactions] == [1]
+
+
+def test_raw_multiline_cp1251(write_csv, clock):
+    text = 'Дата;Сумма;Описание\r\n01.03.2026;zz;"а\r\nб"\r\n'
+    res = import_statement(write_csv(text, encoding="cp1251"), MemoryStore(), clock=clock)
+    assert res.errors[0].raw == '01.03.2026;zz;"а\nб"'
