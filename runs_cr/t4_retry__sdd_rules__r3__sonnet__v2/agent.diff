@@ -44,6 +46,23 @@ class PermanentJobError(JobqError):
     """Обработчик бросает её, когда повтор задания точно не поможет."""
 
 
+class RetryLaterError(JobqError):
+    """Обработчик бросает её, когда внешний сервис сам указал время следующей попытки.
+
+    ``retry_after`` — секунды до следующей попытки (``>= 0``).
+    """
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        if isinstance(retry_after, bool) or not isinstance(retry_after, (int, float)):
+            raise ConfigError(f"retry_after must be a number, got {retry_after!r}")
+        if not math.isfinite(retry_after):
+            raise ConfigError(f"retry_after must be finite, got {retry_after!r}")
+        if retry_after < 0:
+            raise ConfigError("retry_after must be >= 0")
+        super().__init__(message)
+        self.retry_after = float(retry_after)
+
+
 class InvalidTransitionError(JobqError):
     """Недопустимый переход между статусами задания."""
 
