 from __future__ import annotations
 
+import math
+
 
 class JobqError(Exception):
     """Базовая ошибка пакета."""
@@ -40,6 +42,22 @@ class PermanentJobError(JobqError):
     """Обработчик сообщает, что повтор задания заведомо не поможет: задание сразу в FAILED."""
 
 
+class RetryLaterError(JobqError):
+    """Обработчик сообщает, через сколько секунд повторить задание (например, по ``Retry-After``).
+
+    Это обычная временная ошибка: следующая попытка планируется через ``min(retry_after, max_delay)``
+    секунд, джиттер к этой задержке не применяется.
+    """
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        if isinstance(retry_after, bool) or not isinstance(retry_after, (int, float)):
+            raise ConfigError(f"retry_after must be a number, got {retry_after!r}")
+        if not math.isfinite(retry_after) or retry_after < 0:
+            raise ConfigError(f"retry_after must be finite and >= 0, got {retry_after!r}")
+        super().__init__(message)
+        self.retry_after = float(retry_after)
+
+
 class DuplicateHandlerError(JobqError):
     """Попытка повторно зарегистрировать обработчик для того же типа."""
 
