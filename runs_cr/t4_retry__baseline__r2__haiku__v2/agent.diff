+def test_purge_removes_dead_letters_by_age_but_not_fresh_ones(queue, registry, worker, clock):
+    registry.register("boom", _always_raise(TransientError("timeout")))
+    queue.set_retry_policy("boom", RetryPolicy(max_attempts=1))
+    old = queue.enqueue("boom")
+    worker.run_once()
+    clock.advance(100)
+    fresh = queue.enqueue("boom")
+    worker.run_once()
+
+    assert queue.purge_finished(older_than=50) == 1
+    assert old.id not in queue.store
+    assert fresh.id in queue.store
+    assert [entry.job_id for entry in queue.dead_letters()] == [fresh.id]
