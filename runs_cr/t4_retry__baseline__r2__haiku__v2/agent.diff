+def test_purge_removes_old_dead_letters_and_entries(queue, registry, worker, clock):
+    registry.register("boom", _always_raise(TransientError("timeout")))
+    queue.set_retry_policy("boom", RetryPolicy(max_attempts=1))
+    job = queue.enqueue("boom")
+    worker.run_once()
+    clock.advance(1000)
+
+    assert queue.purge_finished(older_than=500) == 1
