@@ -0,0 +1,317 @@
+"""Доработки повторов по JOBQ-237: неповторяемые ошибки, джиттер, очистка, RetryLaterError."""
+
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    DeadLetterReason,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryLaterError,
+    RetryPolicy,
+    Worker,
+)
+
+from .conftest import START
+
+
+class CountingRandom(random.Random):
+    """Генератор, который считает вызовы uniform()."""
+
+    def __init__(self, seed: int = 0) -> None:
+        super().__init__(seed)
+        self.calls = 0
+
+    def uniform(self, a: float, b: float) -> float:
+        self.calls += 1
+        return super().uniform(a, b)
+
+
+class TransientError(Exception):
+    pass
+
+
+class FatalError(TransientError):
+    pass
+
+
+def _always_raise(exc: BaseException):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+# -- неповторяемые ошибки -> dead-letter -------------------------------------
+
+
+def test_permanent_error_goes_to_dead_letter_with_non_retryable_reason(queue, registry, worker):
+    registry.register("pay", _always_raise(PermanentJobError("card declined")))
+    queue.set_retry_policy("pay", RetryPolicy(max_attempts=5))
+    job = queue.enqueue("pay")
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.attempts == 1
+    assert job.error == "PermanentJobError: card declined"
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+    assert queue.metrics.get("jobs.failed") == 0
+    assert queue.metrics.get("jobs.dead_lettered") == 1
+
+
+def test_non_retryable_exception_reason_wins_on_last_attempt(queue, registry, worker):
+    registry.register("boom", _always_raise(FatalError("bad config")))
+    queue.set_retry_policy("boom", RetryPolicy(max_attempts=1, non_retryable=(TransientError,)))
+    job = queue.enqueue("boom")
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_exhausted_reason(queue, registry, worker):
+    registry.register("boom", _always_raise(TransientError("timeout")))
+    queue.set_retry_policy("boom", RetryPolicy(max_attempts=1))
+    job = queue.enqueue("boom")
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_unknown_job_type_still_failed_with_policy(queue, worker):
+    queue.set_retry_policy("ghost", RetryPolicy(max_attempts=5))
+    job = queue.enqueue("ghost")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_permanent_error_without_policy_is_failed(queue, registry, worker):
+    registry.register("pay", _always_raise(PermanentJobError("nope")))
+    job = queue.enqueue("pay")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_dead_letter_entry_reason_defaults_to_exhausted():
+    entry = DeadLetterEntry(
+        job_id="job-000001",
+        job_type="t",
+        attempts=1,
+        error="E: x",
+        dead_lettered_at=START,
+    )
+    assert entry.reason is DeadLetterReason.EXHAUSTED
+
+
+# -- джиттер только уменьшает задержку ---------------------------------------
+
+
+def test_jitter_only_shortens_delay():
+    policy = RetryPolicy(base_delay=10.0, factor=1.0, max_delay=60.0, jitter=0.3)
+    rng = random.Random(11)
+    for _ in range(500):
+        delay = policy.delay_for(1, rng)
+        assert 7.0 <= delay <= 10.0
+
+
+def test_jitter_multiplier_range_is_one_minus_jitter_to_one():
+    policy = RetryPolicy(base_delay=4.0, factor=1.0, max_delay=60.0, jitter=0.5)
+    seen = []
+
+    class RecordingRandom(random.Random):
+        def uniform(self, a, b):
+            seen.append((a, b))
+            return b
+
+    assert policy.delay_for(1, RecordingRandom()) == 4.0
+    assert seen == [(0.5, 1)]
+
+
+# -- RetryLaterError ---------------------------------------------------------
+
+
+def test_retry_later_rejects_negative_retry_after():
+    with pytest.raises(ConfigError):
+        RetryLaterError("slow down", retry_after=-1.0)
+
+
+def test_retry_later_rejects_nan_retry_after():
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=float("nan"))
+
+
+def test_retry_later_keeps_message_and_retry_after():
+    exc = RetryLaterError("billing busy", retry_after=12.5)
+    assert str(exc) == "billing busy"
+    assert exc.retry_after == 12.5
+
+
+def test_retry_later_uses_server_delay_without_jitter_or_rng(queue, registry):
+    registry.register("bill", _always_raise(RetryLaterError("busy", retry_after=7.0)))
+    queue.set_retry_policy(
+        "bill", RetryPolicy(max_attempts=3, base_delay=1.0, jitter=0.9)
+    )
+    rng = CountingRandom(seed=5)
+    worker = Worker(queue, registry, rng=rng)
+    job = queue.enqueue("bill")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=7)
+    assert job.error == "RetryLaterError: busy"
+    assert rng.calls == 0
+
+
+def test_retry_later_is_capped_by_max_delay(queue, registry):
+    registry.register("bill", _always_raise(RetryLaterError("busy", retry_after=3600.0)))
+    queue.set_retry_policy("bill", RetryPolicy(max_attempts=3, base_delay=1.0, max_delay=60.0))
+    job = queue.enqueue("bill")
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=60)
+
+
+def test_retry_later_zero_retry_after_retries_immediately(queue, registry):
+    registry.register("bill", _always_raise(RetryLaterError(retry_after=0.0)))
+    queue.set_retry_policy("bill", RetryPolicy(max_attempts=3))
+    job = queue.enqueue("bill")
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START
+
+
+def test_retry_later_on_last_attempt_is_exhausted(queue, registry, worker):
+    registry.register("bill", _always_raise(RetryLaterError(retry_after=5.0)))
+    queue.set_retry_policy("bill", RetryPolicy(max_attempts=1))
+    job = queue.enqueue("bill")
+    worker.run_once()
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_retry_later_without_policy_is_failed(queue, registry, worker):
+    registry.register("bill", _always_raise(RetryLaterError(retry_after=5.0)))
+    job = queue.enqueue("bill")
+    worker.run_once()
+    assert job.status is JobStatus.FAILED
+
+
+# -- requeue_all_dead_letters ------------------------------------------------
+
+
+def _dead_letter_jobs(queue, registry, worker):
+    registry.register("a", _always_raise(TransientError("x")))
+    registry.register("b", _always_raise(PermanentJobError("y")))
+    queue.set_retry_policy("a", RetryPolicy(max_attempts=1))
+    queue.set_retry_policy("b", RetryPolicy(max_attempts=1))
+    a1 = queue.enqueue("a")
+    b1 = queue.enqueue("b")
+    a2 = queue.enqueue("a")
+    worker.run_pending()
+    return a1, b1, a2
+
+
+def test_requeue_all_returns_jobs_in_dead_letter_order(queue, registry, worker):
+    a1, b1, a2 = _dead_letter_jobs(queue, registry, worker)
+    requeued = queue.requeue_all_dead_letters()
+    assert requeued == [a1, b1, a2]
+    assert all(job.status is JobStatus.PENDING for job in requeued)
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.requeued") == 3
+
+
+def test_requeue_all_filters_by_job_type(queue, registry, worker):
+    a1, b1, a2 = _dead_letter_jobs(queue, registry, worker)
+    requeued = queue.requeue_all_dead_letters("a")
+    assert requeued == [a1, a2]
+    assert b1.status is JobStatus.DEAD_LETTERED
+    assert [entry.job_id for entry in queue.dead_letters()] == [b1.id]
+
+
+def test_requeue_all_on_empty_dead_letter_returns_empty_list(queue):
+    assert queue.requeue_all_dead_letters() == []
+    assert queue.requeue_all_dead_letters("anything") == []
+
+
+def test_requeue_all_with_no_matching_type_returns_empty_list(queue, registry, worker):
+    _dead_letter_jobs(queue, registry, worker)
+    assert queue.requeue_all_dead_letters("missing") == []
+    assert len(queue.dead_letters()) == 3
+
+
+def test_requeue_all_restarts_like_requeue_dead_letter(queue, registry, worker, clock):
+    registry.register("boom", _always_raise(TransientError("timeout")))
+    queue.set_retry_policy("boom", RetryPolicy(max_attempts=2, base_delay=0.0))
+    job = queue.enqueue("boom")
+    worker.run_pending()
+    assert job.status is JobStatus.DEAD_LETTERED
+
+    clock.advance(30)
+    assert queue.requeue_all_dead_letters() == [job]
+    assert job.status is JobStatus.PENDING
+    assert job.attempts == 0
+    assert job.error is None
+    assert job.finished_at is None
+    assert job.run_at == START + timedelta(seconds=30)
+
+
+# -- purge_finished и dead-letter --------------------------------------------
+
