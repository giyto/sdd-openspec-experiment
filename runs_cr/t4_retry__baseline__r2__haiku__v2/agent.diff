+def test_purge_ages_dead_letters_from_dead_lettered_at(queue, registry, worker, clock):
+    registry.register("boom", _always_raise(TransientError("timeout")))
+    queue.set_retry_policy("boom", RetryPolicy(max_attempts=2, base_delay=0.0))
+    job = queue.enqueue("boom")
+    worker.run_pending()
+    # dead_lettered_at == START: задание завершилось последним запуском в тот же момент
+    clock.advance(50)
+    assert queue.purge_finished(older_than=60) == 0
+    clock.advance(10)
+    assert queue.purge_finished(older_than=60) == 1
+    assert job.id not in queue.store
