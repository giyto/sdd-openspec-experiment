+class RetryLaterError(JobqError):
+    """Временная ошибка, после которой сервис сам назвал время следующей попытки.
+
+    ``retry_after`` — секунды до следующей попытки (например, Retry-After внешнего сервиса).
+    Задержка режется потолком ``max_delay`` политики и не джиттерится.
+    """
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        # not >= 0 также отсекает NaN
+        if not retry_after >= 0:
+            raise ConfigError(f"retry_after must be a non-negative number, got {retry_after!r}")
+        super().__init__(message)
+        self.retry_after = retry_after
+
