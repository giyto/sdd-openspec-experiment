diff --git a/tests/test_reservations_followup.py b/tests/test_reservations_followup.py
new file mode 100644
index 0000000..c200dc6
--- /dev/null
+++ b/tests/test_reservations_followup.py
@@ -0,0 +1,302 @@
+"""Сценарии change ``reservations-followup``: замена, возврат, предел срока, выборки, отметка истечения."""
+
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.clock import ManualClock
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    ValidationError,
+)
+from warehouse.events import parse_line
+from warehouse.inventory import Inventory
+from warehouse.models import Availability, ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL, MAX_RESERVATION_LIFETIME
+
+T0 = datetime(2026, 3, 1, 10, 0, 0, tzinfo=timezone.utc)
+ACTIVE = ReservationStatus.ACTIVE
+EXPIRED = ReservationStatus.EXPIRED
+CONFIRMED = ReservationStatus.CONFIRMED
+CANCELLED = ReservationStatus.CANCELLED
+
+
+@pytest.fixture
+def stocked(inv: Inventory) -> Inventory:
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("EAST", "BOLT-M8", 3)
+    return inv
+
+
+def _kinds_since(inv: Inventory, start: int) -> list[str]:
+    return [event.kind for event in inv.log.events()[start:]]
+
+
+# --- константы и предел TTL (1.2, 2.1, 3.2) ----------------------------------
+
+
+def test_default_ttl_is_twenty_minutes_and_lifetime_is_two_hours():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=20)
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+
+
+def test_reserve_ttl_equal_to_limit_is_allowed(stocked: Inventory):
+    snap = stocked.reserve("ORD-2A", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    assert snap.expires_at == T0 + timedelta(hours=2)
+
+
+def test_reserve_ttl_above_limit_is_validation_error(stocked: Inventory):
+    before = len(stocked.log)
+    with pytest.raises(ValidationError):
+        stocked.reserve(
+            "ORD-2B", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME + timedelta(seconds=1)
+        )
+    assert stocked.store.get_reservation("ORD-2B") is None
+    assert len(stocked.log) == before
+
+
+def test_extend_clamps_expiry_to_lifetime(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-20A", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=10))
+    snap = stocked.extend("ORD-20A", timedelta(hours=5))
+    assert snap.expires_at == T0 + timedelta(hours=2)
+    event = stocked.log.events("RESERVE_EXTEND")[-1]
+    assert event.get("expires") == "2026-03-01T12:00:00Z"
+
+
+def test_extend_does_not_shorten_and_writes_nothing(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-20", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=20))
+    before = len(stocked.log)
+    snap = stocked.extend("ORD-20", timedelta(minutes=5))
+    assert snap.expires_at == T0 + timedelta(minutes=20)
+    assert len(stocked.log) == before
+
+
+def test_extend_past_limit_is_not_an_error_for_ttl_check(stocked: Inventory):
+    stocked.reserve("ORD-22X", [("MAIN", "BOLT-M8", 1)])
+    assert stocked.extend("ORD-22X", MAX_RESERVATION_LIFETIME * 10).expires_at == T0 + timedelta(hours=2)
+
+
+# --- замена резерва (2.2–2.4) --------------------------------------------------
+
+
+def test_replace_active_writes_cancel_then_reserve(stocked: Inventory):
+    stocked.reserve("ORD-7", [("MAIN", "BOLT-M8", 2)])
+    start = len(stocked.log)
+    snap = stocked.reserve("ORD-7", [("MAIN", "BOLT-M8", 3)])
+    assert snap.status is ACTIVE
+    assert stocked.reserved("MAIN", "BOLT-M8") == 3
+    assert _kinds_since(stocked, start) == ["RESERVE_CANCEL", "RESERVE"]
+    cancel, reserve = stocked.log.events()[start:]
+    assert cancel.get("order") == "ORD-7"
+    assert reserve.get("order") == "ORD-7"
+    assert reserve.get("qty") == "3"
+    for event in stocked.log.events()[start:]:
+        assert parse_line(event.format()) == event
+
+
+def test_replace_counts_old_reservation_as_free(stocked: Inventory):
+    stocked.reserve("ORD-7C", [("MAIN", "BOLT-M8", 4)])
+    snap = stocked.reserve("ORD-7C", [("MAIN", "BOLT-M8", 5)])
+    assert snap.lines == (ReservationLine("MAIN", "BOLT-M8", 5),)
+    assert stocked.reserved("MAIN", "BOLT-M8") == 5
+
+
+def test_replace_insufficient_keeps_old_reservation(stocked: Inventory):
+    stocked.reserve("ORD-7A", [("MAIN", "BOLT-M8", 2)])
+    stocked.issue("MAIN", "BOLT-M8", 2)  # на MAIN осталось 3, из них 2 удержаны
+    before_snap = stocked.get_reservation("ORD-7A")
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as info:
+        stocked.reserve("ORD-7A", [("MAIN", "BOLT-M8", 4)])
+    assert (info.value.requested, info.value.available) == (4, 3)
+    assert stocked.get_reservation("ORD-7A") == before_snap
+    assert stocked.get_reservation("ORD-7A").status is ACTIVE
+    assert len(stocked.log) == before
+
+
+def test_replace_new_term_starts_at_replacement(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-7B", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=10))
+    snap = stocked.reserve("ORD-7B", [("MAIN", "BOLT-M8", 1)])
+    assert snap.created_at == T0 + timedelta(minutes=10)
+    assert snap.expires_at == T0 + timedelta(minutes=30)
+
+
+def test_replace_expired_writes_no_cancel(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-8", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    start = len(stocked.log)
+    stocked.reserve("ORD-8", [("MAIN", "BOLT-M8", 2)])
+    assert _kinds_since(stocked, start) == ["RESERVE"]
+
+
+def test_replace_cancelled_writes_no_cancel(stocked: Inventory):
+    stocked.reserve("ORD-9", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("ORD-9")
+    start = len(stocked.log)
+    snap = stocked.reserve("ORD-9", [("MAIN", "BOLT-M8", 1)])
+    assert snap.status is ACTIVE
+    assert _kinds_since(stocked, start) == ["RESERVE"]
+
+
+def test_replace_confirmed_still_duplicate(stocked: Inventory):
+    stocked.reserve("ORD-10", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("ORD-10")
+    before = len(stocked.log)
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("ORD-10", [("MAIN", "BOLT-M8", 1)])
+    assert len(stocked.log) == before
+
+
+# --- возврат подтверждённого заказа (3.1) --------------------------------------
+
+
+def test_cancel_confirmed_returns_stock_per_line(stocked: Inventory):
+    stocked.reserve("ORD-18", [("MAIN", "BOLT-M8", 2), ("EAST", "BOLT-M8", 1)])
+    stocked.confirm("ORD-18")
+    start = len(stocked.log)
+    snap = stocked.cancel("ORD-18")
+    assert snap.status is CANCELLED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5 - 2 + 2
+    assert stocked.on_hand("EAST", "BOLT-M8") == 3 - 1 + 1
+    assert _kinds_since(stocked, start) == ["RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+    receives = stocked.log.events("RECEIVE")[-2:]
+    assert [(e.get("wh"), e.get("qty"), e.get("ref")) for e in receives] == [
+        ("MAIN", "2", "ORD-18"),
+        ("EAST", "1", "ORD-18"),
+    ]
+    assert stocked.log.events("RESERVE_CANCEL")[-1].get("order") == "ORD-18"
+
+
+def test_cancel_confirmed_second_time_changes_nothing(stocked: Inventory):
+    stocked.reserve("ORD-18A", [("MAIN", "BOLT-M8", 2)])
+    stocked.confirm("ORD-18A")
+    stocked.cancel("ORD-18A")
+    before = len(stocked.log)
+    assert stocked.cancel("ORD-18A").status is CANCELLED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5
+    assert len(stocked.log) == before
+
+
+# --- выборки (4.1, 4.2) ---------------------------------------------------------
+
+
+def test_reservations_sorted_by_created_then_order(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-B", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=2))
+    stocked.reserve("ORD-A", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("ORD-C", [("MAIN", "BOLT-M8", 1)])
+    ids = [snap.order_id for snap in stocked.reservations()]
+    assert ids == ["ORD-B", "ORD-A", "ORD-C"]
+
+
+def test_reservations_filter_by_status_uses_current_time(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-D", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=5))
+    stocked.reserve("ORD-E", [("EAST", "BOLT-M8", 1)])
+    stocked.confirm("ORD-E")
+    clock.advance(timedelta(minutes=5))
+    expired = [snap.order_id for snap in stocked.reservations(EXPIRED)]
+    active = [snap.order_id for snap in stocked.reservations(ACTIVE)]
+    confirmed = [snap.order_id for snap in stocked.reservations(CONFIRMED)]
+    assert expired == ["ORD-D"]
+    assert active == []
+    assert confirmed == ["ORD-E"]
+
+
+def test_reservations_does_not_change_log_or_stock(stocked: Inventory):
+    stocked.reserve("ORD-Q", [("MAIN", "BOLT-M8", 1)])
+    before = len(stocked.log)
+    stocked.reservations()
+    stocked.availability()
+    assert len(stocked.log) == before
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5
+
+
+def test_availability_rows_and_order(stocked: Inventory):
+    stocked.reserve("ORD-AV", [("MAIN", "BOLT-M8", 2)])
+    # NUT-M8 зарегистрирован фикстурой, но ни остатка, ни резерва по нему нет: в выборку не попадает
+    rows = stocked.availability()
+    assert rows == [
+        Availability("EAST", "BOLT-M8", on_hand=3, reserved=0, available=3),
+        Availability("MAIN", "BOLT-M8", on_hand=5, reserved=2, available=3),
+    ]
+
+
+def test_availability_filters_by_warehouse(stocked: Inventory):
+    stocked.reserve("ORD-AW", [("MAIN", "BOLT-M8", 1)])
+    rows = stocked.availability("MAIN")
+    assert [row.warehouse for row in rows] == ["MAIN"]
+
+
+def test_availability_includes_position_with_only_live_reservation(
+    stocked: Inventory, clock: ManualClock
+):
+    stocked.receive("SOUTH", "BOLT-M8", 1)
+    stocked.reserve("ORD-AR", [("SOUTH", "BOLT-M8", 1)])
+    stocked.adjust("SOUTH", "BOLT-M8", 0, "recount")  # физический остаток 0, резерв живой
+    rows = {(r.warehouse, r.sku): r for r in stocked.availability()}
+    assert rows[("SOUTH", "BOLT-M8")] == Availability("SOUTH", "BOLT-M8", 0, 1, 0)
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert ("SOUTH", "BOLT-M8") not in {(r.warehouse, r.sku) for r in stocked.availability()}
+
+
+# --- отметка истечения (5.1, 5.2) ---------------------------------------------
+
+
+def test_sweep_marks_expired_in_expiry_order(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-30", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=15))
+    stocked.reserve("ORD-31", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=5))
+    stocked.reserve("ORD-32", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=60))
+    clock.advance(timedelta(minutes=20))
+    start = len(stocked.log)
+    assert stocked.sweep_expired() == ["ORD-31", "ORD-30"]
+    events = stocked.log.events("RESERVE_EXPIRE")
+    assert [e.get("order") for e in events] == ["ORD-31", "ORD-30"]
+    assert events[0].get("expires") == "2026-03-01T10:05:00Z"
+    assert events[1].get("expires") == "2026-03-01T10:15:00Z"
+    assert _kinds_since(stocked, start) == ["RESERVE_EXPIRE", "RESERVE_EXPIRE"]
+    for event in stocked.log.events()[start:]:
+        assert parse_line(event.format()) == event
+
+
+def test_sweep_second_call_is_empty(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-30", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    stocked.sweep_expired()
+    before = len(stocked.log)
+    assert stocked.sweep_expired() == []
+    assert len(stocked.log) == before
+
+
+def test_sweep_replaced_then_expired_again_is_reported_again(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-33", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert stocked.sweep_expired() == ["ORD-33"]
+    stocked.reserve("ORD-33", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert stocked.sweep_expired() == ["ORD-33"]
+    expires = [e.get("expires") for e in stocked.log.events("RESERVE_EXPIRE")]
+    assert expires == ["2026-03-01T10:20:00Z", "2026-03-01T10:40:00Z"]
+
+
+def test_sweep_skips_confirmed_and_cancelled(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-34", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("ORD-34")
+    stocked.reserve("ORD-34B", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("ORD-34B")
+    clock.advance(MAX_RESERVATION_LIFETIME)
+    before = len(stocked.log)
+    assert stocked.sweep_expired() == []
+    assert len(stocked.log) == before
+
+
+def test_sweep_keeps_statuses_and_stock(stocked: Inventory, clock: ManualClock):
+    stocked.reserve("ORD-35", [("MAIN", "BOLT-M8", 2)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    available_before = stocked.available("MAIN", "BOLT-M8")
+    stocked.sweep_expired()
+    assert stocked.get_reservation("ORD-35").status is EXPIRED
+    assert stocked.available("MAIN", "BOLT-M8") == available_before
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5
