 class PermanentJobError(JobqError):
-    """Обработчик сообщает, что повтор не поможет: задание сразу получает FAILED."""
+    """Обработчик сообщает, что повтор не поможет.
+
+    При действующей политике повторов задание сразу уходит в DEAD_LETTERED
+    (причина ``non_retryable``), без политики — в FAILED.
+    """
+
+
+class RetryLaterError(JobqError):
+    """Временная ошибка, после которой внешний сервис просит повторить через ``retry_after`` секунд."""
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        if (
+            isinstance(retry_after, bool)
+            or not isinstance(retry_after, (int, float))
+            or not retry_after >= 0
+        ):
+            raise ConfigError("retry_after must be a number >= 0")
+        super().__init__(message)
+        self.retry_after = retry_after
