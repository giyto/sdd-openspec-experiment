diff --git a/tests/test_retry_refinements.py b/tests/test_retry_refinements.py
new file mode 100644
index 0000000..0faf494
--- /dev/null
+++ b/tests/test_retry_refinements.py
@@ -0,0 +1,241 @@
+import math
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    DeadLetterReason,
+    JobStatus,
+    PermanentJobError,
+    RetryLaterError,
+    RetryPolicy,
+    Worker,
+)
+from jobq import metrics as m
+
+from .conftest import START
+
+
+class CountingRng:
+    def __init__(self, value=1.0):
+        self.calls = []
+        self.value = value
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+def failing(exc):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+def run(queue, registry, job_type, exc, rng=None):
+    registry.register(job_type, failing(exc))
+    job = queue.enqueue(job_type)
+    Worker(queue, registry, rng=rng).run_once()
+    return job
+
+
+def dead_letter(queue, job_type="t"):
+    job = queue.enqueue(job_type)
+    queue.mark_running(job.id)
+    return queue.mark_dead_lettered(job.id, "e")
+
+
+# -- модели и ошибки ---------------------------------------------------------
+
+
+def test_dead_letter_entry_default_reason():
+    entry = DeadLetterEntry("j", "t", 1, "e", START)
+    assert entry.reason is DeadLetterReason.EXHAUSTED
+
+
+@pytest.mark.parametrize("bad", [-1, "5", None, True, math.nan])
+def test_retry_later_invalid(bad):
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=bad)
+
+
+def test_retry_later_attrs():
+    err = RetryLaterError(retry_after=0)
+    assert err.retry_after == 0
+    assert str(err) == ""
+    assert RetryLaterError("x", retry_after=5).retry_after == 5
+
+
+# -- джиттер -----------------------------------------------------------------
+
+
+def test_jitter_only_decreases():
+    policy = RetryPolicy(base_delay=10, max_delay=60, jitter=0.5)
+    rng = CountingRng(1.0)
+    assert policy.delay_for(1, rng) == 10
+    assert rng.calls == [(0.5, 1)]
+    assert policy.delay_for(1, CountingRng(0.5)) == 5
+
+
+# -- dead-letter и воркер ----------------------------------------------------
+
+
+def test_non_retryable_first_attempt_dead_letters(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3, jitter=0.5))
+    rng = CountingRng()
+    job = run(queue, registry, "t", PermanentJobError("bad"), rng)
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert job.attempts == 1
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+    assert queue.metrics.get(m.JOBS_DEAD_LETTERED) == 1
+    assert queue.metrics.get(m.JOBS_FAILED) == 0
+    assert queue.metrics.get(m.JOBS_RETRIED) == 0
+    assert rng.calls == []
+
+
+def test_non_retryable_class_and_last_attempt(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1, non_retryable=(KeyError,)))
+    job = run(queue, registry, "t", KeyError("k"))
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_no_policy_failed(queue, registry):
+    job = run(queue, registry, "t", PermanentJobError("bad"))
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_exhausted_reason(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    job = run(queue, registry, "t", TimeoutError("x"))
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_no_handler_failed_with_policy(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy())
+    job = queue.enqueue("t")
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_mark_dead_lettered_default_reason(queue):
+    dead_letter(queue)
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+# -- RetryLaterError ---------------------------------------------------------
+
+
+def test_retry_later_delay_and_no_rng(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3, max_delay=60, jitter=0.5))
+    rng = CountingRng()
+    job = run(queue, registry, "t", RetryLaterError("slow", retry_after=30), rng)
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=30)
+    assert job.error == "RetryLaterError: slow"
+    assert rng.calls == []
+
+
+def test_retry_later_capped(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(max_delay=60))
+    job = run(queue, registry, "t", RetryLaterError(retry_after=3600))
+    assert job.run_at == START + timedelta(seconds=60)
+
+
+def test_retry_later_zero(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy())
+    job = run(queue, registry, "t", RetryLaterError(retry_after=0))
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START
+
+
+def test_retry_later_last_attempt(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    job = run(queue, registry, "t", RetryLaterError(retry_after=5))
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_retry_later_no_policy(queue, registry):
+    job = run(queue, registry, "t", RetryLaterError(retry_after=5))
+    assert job.status is JobStatus.FAILED
+
+
+def test_retry_later_explicit_non_retryable(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(non_retryable=(RetryLaterError,)))
+    job = run(queue, registry, "t", RetryLaterError(retry_after=5))
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+# -- purge_finished ----------------------------------------------------------
+
+
+def test_purge_dead_letter_by_age(queue, clock):
+    old = dead_letter(queue)
+    clock.advance(7200 - 300)
+    fresh = dead_letter(queue)
+    clock.advance(300)
+    assert queue.purge_finished(older_than=3600) == 1
+    assert [e.job_id for e in queue.dead_letters()] == [fresh.id]
+    assert old.id not in [j.id for j in queue.list_jobs()]
+    assert queue.metrics.get(m.JOBS_PURGED) == 1
+
+
+def test_purge_dead_letter_boundary_and_age_from_dead_letter(queue, clock):
+    job = queue.enqueue("t")
+    clock.advance(10000)
+    queue.mark_running(job.id)
+    queue.mark_dead_lettered(job.id, "e")
+    assert queue.purge_finished(older_than=3600) == 0
+    clock.advance(3600)
+    assert queue.purge_finished(older_than=3600) == 1
+    assert queue.dead_letters() == []
+
+
+# -- requeue_all_dead_letters ------------------------------------------------
+
+
+def test_requeue_all(queue):
+    b = dead_letter(queue, "email")
+    a = dead_letter(queue, "billing")
+    result = queue.requeue_all_dead_letters()
+    assert [j.id for j in result] == [b.id, a.id]
+    assert all(j.status is JobStatus.PENDING for j in result)
+    assert queue.dead_letters() == []
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 2
+
+
+def test_requeue_all_by_type(queue):
+    b = dead_letter(queue, "email")
+    dead_letter(queue, "billing")
+    assert [j.id for j in queue.requeue_all_dead_letters("email")] == [b.id]
+    assert [e.job_type for e in queue.dead_letters()] == ["billing"]
+
+
+def test_requeue_all_empty(queue):
+    assert queue.requeue_all_dead_letters() == []
+    dead_letter(queue, "email")
+    assert queue.requeue_all_dead_letters("nope") == []
+    assert len(queue.dead_letters()) == 1
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 0
+
+
+def test_requeue_all_bad_type(queue):
+    with pytest.raises(ConfigError):
+        queue.requeue_all_dead_letters(5)
+
+
+def test_requeued_gets_full_attempts(queue, registry):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3))
+    registry.register("t", failing(TimeoutError("x")))
+    job = dead_letter(queue)
+    queue.requeue_all_dead_letters()
+    Worker(queue, registry).run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
