+
+class RetryLaterError(JobqError):
+    """Временная ошибка, после которой внешний сервис сам назвал время следующей попытки.
+
+    :param retry_after: через сколько секунд повторить; конечное число ``>= 0``.
+    """
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        if (
+            not isinstance(retry_after, (int, float))
+            or isinstance(retry_after, bool)
+            or not math.isfinite(retry_after)
+            or retry_after < 0
+        ):
+            raise ConfigError(f"retry_after must be a finite number >= 0, got {retry_after!r}")
+        super().__init__(message)
+        self.retry_after = retry_after
