diff --git a/tests/test_refine_retries.py b/tests/test_refine_retries.py
new file mode 100644
index 0000000..fdacb2d
--- /dev/null
+++ b/tests/test_refine_retries.py
@@ -0,0 +1,258 @@
+import math
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    DeadLetterReason,
+    HandlerRegistry,
+    JobNotFoundError,
+    JobqError,
+    JobQueue,
+    JobStatus,
+    ManualClock,
+    PermanentJobError,
+    RetryLaterError,
+    RetryPolicy,
+    Worker,
+)
+from jobq import metrics as m
+from tests.conftest import START
+
+
+def boom(exc):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+def setup(policy, handler, job_type="t", seed=None):
+    clock = ManualClock(START)
+    q = JobQueue(clock=clock, default_retry_policy=policy)
+    reg = HandlerRegistry()
+    reg.register(job_type, handler)
+    w = Worker(q, reg, rng=random.Random(seed) if seed is not None else None)
+    return clock, q, w
+
+
+class StubRng:
+    def __init__(self, value):
+        self.value = value
+        self.calls = []
+
+    def uniform(self, a, b):
+        self.calls.append((a, b))
+        return self.value
+
+
+# -- модели и ошибки ---------------------------------------------------------
+
+
+def test_dead_letter_entry_five_args_defaults_to_exhausted():
+    e = DeadLetterEntry("j", "t", 1, "e", START)
+    assert e.reason is DeadLetterReason.EXHAUSTED
+    assert DeadLetterReason.NON_RETRYABLE.value == "non_retryable"
+
+
+def test_retry_later_error_basics():
+    e = RetryLaterError("billing", retry_after=30)
+    assert isinstance(e, JobqError) and e.retry_after == 30 and str(e) == "billing"
+    assert str(RetryLaterError(retry_after=5)) == ""
+    assert RetryLaterError("x", retry_after=0).retry_after == 0
+    with pytest.raises(TypeError):
+        RetryLaterError("x")
+
+
+@pytest.mark.parametrize("bad", [-1, math.nan, math.inf, True, "5"])
+def test_retry_later_error_invalid(bad):
+    with pytest.raises(ConfigError):
+        RetryLaterError("x", retry_after=bad)
+
+
+# -- джиттер -----------------------------------------------------------------
+
+
+def test_jitter_only_reduces():
+    p = RetryPolicy(max_attempts=5, base_delay=8, max_delay=100, jitter=0.5)
+    rng = StubRng(0.75)
+    assert p.delay_for(1, rng) == 6
+    assert rng.calls == [(0.5, 1)]
+
+
+def test_jitter_ceiling_with_large_uniform():
+    p = RetryPolicy(base_delay=60, max_delay=60, jitter=0.5)
+    assert p.delay_for(1, StubRng(1.4)) == 60
+
+
+# -- исходы падения ----------------------------------------------------------
+
+
+@pytest.mark.parametrize("exc", [PermanentJobError("bad"), ValueError("bad")])
+def test_non_retryable_goes_to_dead_letter(exc):
+    _, q, w = setup(RetryPolicy(max_attempts=5, non_retryable=(ValueError,)), boom(exc))
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.DEAD_LETTERED and j.attempts == 1
+    (entry,) = q.dead_letters()
+    assert entry.reason is DeadLetterReason.NON_RETRYABLE
+    assert q.metrics.get(m.JOBS_DEAD_LETTERED) == 1
+    assert q.metrics.get(m.JOBS_FAILED) == 0
+
+
+def test_non_retryable_on_last_attempt_keeps_reason():
+    _, q, w = setup(RetryPolicy(max_attempts=1), boom(PermanentJobError("x")))
+    q.enqueue("t")
+    w.run_once()
+    assert q.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_exhausted_reason():
+    _, q, w = setup(RetryPolicy(max_attempts=1), boom(TimeoutError("x")))
+    q.enqueue("t")
+    w.run_once()
+    assert q.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_no_policy_fails():
+    _, q, w = setup(None, boom(PermanentJobError("x")))
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.FAILED and q.dead_letters() == []
+
+
+def test_mark_dead_lettered_default_reason():
+    _, q, _ = setup(None, boom(ValueError()))
+    j = q.enqueue("t")
+    q.mark_running(j.id)
+    q.mark_dead_lettered(j.id, "e")
+    assert q.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+# -- RetryLaterError ---------------------------------------------------------
+
+
+def test_retry_later_uses_server_delay_without_rng():
+    policy = RetryPolicy(max_attempts=3, max_delay=60, jitter=0.5)
+    _, q, w = setup(policy, boom(RetryLaterError("billing", retry_after=30)), seed=1)
+    state = w._rng.getstate()
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.RETRY_SCHEDULED
+    assert j.run_at == START + timedelta(seconds=30)
+    assert j.error == "RetryLaterError: billing"
+    assert w._rng.getstate() == state
+
+
+@pytest.mark.parametrize("after,expected", [(3600, 60), (0, 0)])
+def test_retry_later_clamp_and_zero(after, expected):
+    policy = RetryPolicy(max_attempts=3, max_delay=60)
+    _, q, w = setup(policy, boom(RetryLaterError(retry_after=after)))
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.RETRY_SCHEDULED
+    assert j.run_at == START + timedelta(seconds=expected)
+
+
+def test_retry_later_last_attempt_exhausted():
+    _, q, w = setup(RetryPolicy(max_attempts=1), boom(RetryLaterError(retry_after=5)))
+    q.enqueue("t")
+    w.run_once()
+    assert q.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_retry_later_without_policy_fails():
+    _, q, w = setup(None, boom(RetryLaterError(retry_after=5)))
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.FAILED
+
+
+# -- purge -------------------------------------------------------------------
+
+
+def dead_job(q, w):
+    j = q.enqueue("t")
+    w.run_once()
+    assert j.status is JobStatus.DEAD_LETTERED
+    return j
+
+
+def test_purge_removes_dead_letter():
+    clock, q, w = setup(RetryPolicy(max_attempts=1), boom(TimeoutError()))
+    j = dead_job(q, w)
+    clock.advance(100)
+    assert q.purge_finished() == 1
+    assert q.dead_letters() == [] and q.metrics.get(m.JOBS_PURGED) == 1
+    with pytest.raises(JobNotFoundError):
+        q.requeue_dead_letter(j.id)
+
+
+def test_purge_threshold_from_dead_lettered_at():
+    clock, q, w = setup(RetryPolicy(max_attempts=1), boom(TimeoutError()))
+    dead_job(q, w)
+    clock.advance(100)
+    assert q.purge_finished(older_than=200) == 0 and len(q.dead_letters()) == 1
+    assert q.purge_finished(older_than=50) == 1
+
+
+def test_purge_keeps_retry_scheduled():
+    clock, q, w = setup(RetryPolicy(max_attempts=3), boom(TimeoutError()))
+    j = q.enqueue("t")
+    w.run_once()
+    clock.advance(1000)
+    assert q.purge_finished() == 0 and j.status is JobStatus.RETRY_SCHEDULED
+
+
+# -- массовый возврат --------------------------------------------------------
+
+
+def three_dead():
+    q = JobQueue(clock=ManualClock(START), default_retry_policy=RetryPolicy(max_attempts=3))
+    reg = HandlerRegistry()
+    for t in ("a", "b"):
+        reg.register(t, boom(PermanentJobError("x")))
+    jobs = [q.enqueue(t) for t in ("a", "b", "a")]
+    Worker(q, reg).run_pending()
+    return q, jobs
+
+
+def test_requeue_all_order_and_counter():
+    q, jobs = three_dead()
+    assert q.requeue_all_dead_letters() == jobs
+    assert all(j.status is JobStatus.PENDING and j.attempts == 0 for j in jobs)
+    assert q.dead_letters() == [] and q.metrics.get(m.JOBS_REQUEUED) == 3
+
+
+def test_requeue_all_filter():
+    q, (a1, b, a2) = three_dead()
+    assert q.requeue_all_dead_letters("a") == [a1, a2]
+    assert b.status is JobStatus.DEAD_LETTERED and len(q.dead_letters()) == 1
+    assert q.metrics.get(m.JOBS_REQUEUED) == 2
+
+
+def test_requeue_all_empty_and_missing_type():
+    assert JobQueue(clock=ManualClock(START)).requeue_all_dead_letters() == []
+    q, _ = three_dead()
+    assert q.requeue_all_dead_letters("zzz") == []
+    assert len(q.dead_letters()) == 3 and q.metrics.get(m.JOBS_REQUEUED) == 0
+
+
+@pytest.mark.parametrize("bad", ["", 5])
+def test_requeue_all_invalid_type(bad):
+    q, _ = three_dead()
+    with pytest.raises(ConfigError):
+        q.requeue_all_dead_letters(bad)
+    assert len(q.dead_letters()) == 3 and q.metrics.get(m.JOBS_REQUEUED) == 0
+
+
+def test_requeue_all_gives_full_attempts():
+    q, _ = three_dead()
+    reg = HandlerRegistry()
+    reg.register("a", boom(TimeoutError("gw")))
+    q.requeue_all_dead_letters("a")
+    Worker(q, reg).run_once()
+    assert len(q.list_jobs(JobStatus.RETRY_SCHEDULED)) == 1
