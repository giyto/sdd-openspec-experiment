diff --git a/tests/test_jobq237.py b/tests/test_jobq237.py
new file mode 100644
index 0000000..4d4c3fc
--- /dev/null
+++ b/tests/test_jobq237.py
@@ -0,0 +1,82 @@
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError, DeadLetterReason, HandlerRegistry, JobQueue, JobStatus, ManualClock,
+    PermanentJobError, RetryLaterError, RetryPolicy, Worker,
+)
+
+
+def make(policy, handler):
+    clock = ManualClock()
+    q = JobQueue(clock=clock, default_retry_policy=policy)
+    reg = HandlerRegistry()
+    reg.register("t", handler)
+    reg.register("u", handler)
+    return clock, q, Worker(q, reg, rng=random.Random(1))
+
+
+def raiser(exc):
+    def h(job):
+        raise exc
+    return h
+
+
+def test_permanent_goes_to_dead_letter_even_on_last_attempt():
+    _, q, w = make(RetryPolicy(max_attempts=1), raiser(PermanentJobError("n")))
+    q.enqueue("t")
+    assert w.run_once().status is JobStatus.DEAD_LETTERED
+    assert q.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_exhausted_reason_and_retry_later_last_attempt():
+    _, q, w = make(RetryPolicy(max_attempts=1), raiser(RetryLaterError("x", retry_after=5)))
+    q.enqueue("t")
+    w.run_once()
+    assert q.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_jitter_only_reduces():
+    p = RetryPolicy(base_delay=10, jitter=0.5, max_delay=100)
+    rng = random.Random(3)
+    assert all(5 <= p.delay_for(1, rng) <= 10 for _ in range(200))
+
+
+def test_retry_later_capped_no_jitter_no_rng():
+    clock, q, w = make(RetryPolicy(max_attempts=3, jitter=0.5, max_delay=60),
+                       raiser(RetryLaterError(retry_after=3600)))
+    state = w._rng.getstate()
+    job = q.enqueue("t")
+    w.run_once()
+    assert job.run_at == clock.now() + timedelta(seconds=60)
+    assert w._rng.getstate() == state
+
+
+def test_retry_later_uses_value():
+    clock, q, w = make(RetryPolicy(max_attempts=3), raiser(RetryLaterError(retry_after=7)))
+    job = q.enqueue("t")
+    w.run_once()
+    assert job.run_at == clock.now() + timedelta(seconds=7)
+
+
+def test_retry_later_negative():
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=-1)
+
+
+def test_purge_dead_letters_and_requeue_all():
+    clock, q, w = make(RetryPolicy(max_attempts=1), boom := raiser(RuntimeError("x")))
+    for t in ("t", "u", "t"):
+        q.enqueue(t)
+    w.run_pending()
+    assert len(q.dead_letters()) == 3
+    clock.advance(10)
+    assert q.purge_finished(older_than=100) == 0
+    jobs = q.requeue_all_dead_letters("t")
+    assert [j.id for j in jobs] == ["job-000001", "job-000003"]
+    assert q.requeue_all_dead_letters("zzz") == []
+    assert q.purge_finished(older_than=5) == 1
+    assert q.dead_letters() == []
+    assert q.requeue_all_dead_letters() == []
