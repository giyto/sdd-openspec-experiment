 class PermanentJobError(JobqError):
     """Обработчик бросает её, когда повтор точно не поможет."""
+
+
+class RetryLaterError(JobqError):
+    """Повторяемая ошибка, после которой следующую попытку нужно сделать через ``retry_after`` секунд."""
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        if (
+            not isinstance(retry_after, (int, float))
+            or isinstance(retry_after, bool)
+            or retry_after != retry_after
+        ):
+            raise ConfigError(f"retry_after must be a number, got {retry_after!r}")
+        if retry_after < 0:
+            raise ConfigError("retry_after must be >= 0")
+        super().__init__(message)
+        self.retry_after = float(retry_after)
