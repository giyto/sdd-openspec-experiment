+def test_spread_invariant():
+    prices = ["0.01", "0.07", "1.00", "3.33", "10.00"]
+    for combo in itertools.chain(
+        itertools.combinations(prices, 2), itertools.combinations(prices, 3)
+    ):
+        cart = cart_of(*[(p, E) for p in combo])
+        for promo in (pct("7"), pct("33.3"), pct("100"), fixed("0.05"), fixed("1.00")):
+            try:
+                total = calculate_total(cart, promo=promo)
+            except PromoConditionsError:
+                continue
+            assert sum(line.discount for line in total.lines) == total.discount
+            assert all(line.discount <= line.amount for line in total.lines)
