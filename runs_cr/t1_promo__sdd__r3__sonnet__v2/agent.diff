+# --- 3.1 / 3.2 / 3.3 order service ------------------------------------------
+
+
+def service_with(products, clock=None, **promo_kwargs):
+    clock = clock or FixedClock(NOW)
+    promos = PromoRegistry(clock=clock)
+    promos.add(PromoCode("CODE", DiscountKind.PERCENT, D("10"), **promo_kwargs))
+    promos.add(free_ship())
+    service = OrderService(clock=clock, promos=promos)
+    cart = Cart()
+    cart.add(products["phone"])
+    return service, promos, cart, clock
+
+
+def test_customer_limit_without_customer_id(products):
+    service, promos, cart, _ = service_with(products, max_uses_per_customer=1)
+    for call in (service.quote, service.place_order):
+        with pytest.raises(PromoConditionsError):
+            call(cart, "CODE")
+    assert promos.uses("CODE") == 0
+    assert len(service.store) == 0
+
+
+def test_customer_limit_exhausted_and_other_customer(products):
+    service, promos, cart, _ = service_with(products, max_uses_per_customer=1)
+    order = service.place_order(cart, "code", customer_id="u1")
+    assert order.customer_id == "u1"
+    assert promos.uses("CODE") == 1
+    assert promos.uses("CODE", "u1") == 1
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "CODE", customer_id="u1")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "CODE", customer_id="u1")
+    assert len(service.store) == 1
+    assert service.quote(cart, "CODE", customer_id="U1").discount == D("250.00")
+    assert service.place_order(cart, "CODE", customer_id="u2")
+
+
+def test_customer_id_without_code(products):
+    service, _, cart, _ = service_with(products)
+    order = service.place_order(cart, customer_id="u1")
+    assert order.customer_id == "u1"
+    assert order.promo_code is None
+
+
+@pytest.mark.parametrize("bad", ["", 5])
+def test_invalid_customer_id(products, bad):
