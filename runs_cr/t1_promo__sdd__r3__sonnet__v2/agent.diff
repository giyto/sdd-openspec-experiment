+def test_cancel_inside_window(products):
+    service, promos, cart, clock = service_with(products, max_uses=1)
+    order = service.place_order(cart, "CODE")
+    clock.advance(timedelta(hours=23, minutes=59, seconds=59))
+    service.cancel(order.order_id)
+    assert promos.uses("CODE") == 0
+    assert service.place_order(cart, "CODE")
