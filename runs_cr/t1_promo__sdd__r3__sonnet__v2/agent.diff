+++ b/tests/test_promo_autumn.py
@@ -0,0 +1,473 @@
+import itertools
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.clock import FixedClock
+from shop.errors import (
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    ValidationError,
+)
+from shop.orders import OrderService
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+NOW = datetime(2026, 10, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def pct(value, **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("F", DiscountKind.FIXED, D(value), **kw)
+
+
+def free_ship(**kw):
+    return PromoCode("FS", DiscountKind.FREE_SHIPPING, D("0"), **kw)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for i, (price, category) in enumerate(items):
+        cart.add(Product(f"SKU-{i}", f"Item {i}", D(price), category))
+    return cart
+
+
+E = Category.ELECTRONICS
+CL = Category.CLOTHING
+GC = Category.GIFT_CARD
+
+
+# --- 1.1 FREE_SHIPPING value -------------------------------------------------
+
+
+@pytest.mark.parametrize("value", [0, D("0"), D("0.00")])
+def test_free_shipping_zero_value(value):
+    promo = PromoCode("FS", DiscountKind.FREE_SHIPPING, value)
+    assert promo.value == D("0")
+
+
+@pytest.mark.parametrize("value", [10, D("0.01"), D("-1")])
+def test_free_shipping_nonzero_value(value):
+    with pytest.raises(ValidationError):
+        PromoCode("FS", DiscountKind.FREE_SHIPPING, value)
+
+
+# --- 1.2 new fields ----------------------------------------------------------
+
+
+def test_max_discount_valid():
+    assert pct("10", max_discount=D("300.00")).max_discount == D("300.00")
+    assert pct("10", max_discount=300).max_discount == D("300.00")
+
+
+@pytest.mark.parametrize("cap", [0, -1, D("1.005"), 1.5, True])
+def test_max_discount_invalid(cap):
+    with pytest.raises(ValidationError):
+        pct("10", max_discount=cap)
+
+
+@pytest.mark.parametrize("make", [fixed, lambda v, **kw: free_ship(**kw)])
+def test_max_discount_only_for_percent(make):
+    with pytest.raises(ValidationError):
+        make("100", max_discount=D("300.00"))
+
+
+@pytest.mark.parametrize("limit", [0, -1, True, 1.5])
+def test_max_uses_per_customer_invalid(limit):
+    with pytest.raises(ValidationError):
+        pct("10", max_uses_per_customer=limit)
+
+
+@pytest.mark.parametrize("limit", [1, None])
+def test_max_uses_per_customer_valid(limit):
+    assert pct("10", max_uses_per_customer=limit).max_uses_per_customer == limit
+
+
+# --- 1.3 / 1.4 registry ------------------------------------------------------
+
+
+def registry(**kw):
+    clock = FixedClock(NOW)
+    return PromoRegistry([PromoCode("CODE", DiscountKind.PERCENT, D("10"), **kw)], clock=clock)
+
+
+def test_resolve_customer_limit_needs_customer():
+    reg = registry(max_uses_per_customer=1)
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("CODE")
+    assert reg.resolve("CODE", "u1").code == "CODE"
+
+
+def test_resolve_exhausted_customer_and_other_customer():
+    reg = registry(max_uses_per_customer=1)
+    reg.redeem("CODE", "u1")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("CODE", "u1")
+    assert reg.resolve("CODE", "u2")
+    assert reg.resolve("CODE", "U1")
+    assert reg.resolve("CODE", " u1")
+
+
+def test_resolve_without_customer_limit_ignores_customer():
+    reg = registry()
+    assert reg.resolve("CODE")
+    assert reg.resolve("CODE", "u1")
+
+
+def test_resolve_error_priority():
+    clock = FixedClock(NOW)
+    promo = PromoCode(
+        "CODE", DiscountKind.PERCENT, D("10"),
+        max_uses=1, max_uses_per_customer=1, expires_at=NOW + timedelta(hours=1),
+    )
+    reg = PromoRegistry([promo], clock=clock)
+    reg.redeem("CODE", "u1")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("CODE")
+    clock.advance(timedelta(hours=2))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("CODE")
+
+
+@pytest.mark.parametrize("bad", ["", 42])
+def test_registry_invalid_customer_id(bad):
+    reg = registry()
+    for call in (reg.resolve, reg.uses, reg.redeem, reg.release):
+        with pytest.raises(ValidationError):
+            call("CODE", bad)
+
+
+def test_customer_counters():
+    reg = registry()
+    reg.redeem("CODE", "u1")
+    reg.redeem("CODE", "u1")
+    reg.redeem("CODE", "u2")
+    reg.redeem("CODE")
+    assert reg.uses("CODE") == 4
+    assert reg.uses("CODE", "u1") == 2
+    assert reg.uses("CODE", "u2") == 1
+    assert reg.uses("CODE", "u3") == 0
+
+
+def test_release_customer_never_below_zero():
+    reg = registry()
+    reg.redeem("CODE", "u1")
+    reg.release("CODE", "u1")
+    reg.release("CODE", "u1")
+    assert reg.uses("CODE") == 0
+    assert reg.uses("CODE", "u1") == 0
