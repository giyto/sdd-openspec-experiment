+class RetryLaterError(JobqError):
+    """Обработчик сообщает, через сколько секунд внешний сервис ждёт следующую попытку.
+
+    Повтор планируется через ``min(retry_after, max_delay)`` секунд без джиттера.
+    Ошибка остаётся временной: проверка повторяемости и лимит попыток действуют как обычно.
