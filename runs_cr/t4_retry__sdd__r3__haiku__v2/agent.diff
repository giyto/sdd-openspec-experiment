diff --git a/tests/test_retry_followup.py b/tests/test_retry_followup.py
new file mode 100644
index 0000000..9889911
--- /dev/null
+++ b/tests/test_retry_followup.py
@@ -0,0 +1,366 @@
+"""Проверки change jobq-retry-followup: новые сценарии спецификаций.
+
+Существующие тесты не изменяются; их расхождения с новым поведением зафиксированы в design.md.
+"""
+
+import math
+import random
+from datetime import timedelta
+
+import pytest
+
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    DeadLetterReason,
+    HandlerRegistry,
+    JobNotFoundError,
+    JobQueue,
+    JobStatus,
+    PermanentJobError,
+    RetryLaterError,
+    RetryPolicy,
+    Worker,
+)
+from jobq import metrics as m
+from jobq.errors import JobqError
+
+from .conftest import START
+
+
+class CountingRandom(random.Random):
+    """Генератор, который считает вызовы ``uniform`` и возвращает фиксированное значение."""
+
+    def __init__(self, value: float = 1.0) -> None:
+        super().__init__(0)
+        self.value = value
+        self.draws = 0
+
+    def uniform(self, a: float, b: float) -> float:
+        self.draws += 1
+        return self.value
+
+
+def _raise(exc: BaseException):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+# -- 1. модели и ошибки -------------------------------------------------------
+
+
+def test_dead_letter_reason_values():
+    assert DeadLetterReason.EXHAUSTED.value == "exhausted"
+    assert DeadLetterReason.NON_RETRYABLE.value == "non_retryable"
+
+
+def test_dead_letter_entry_default_reason_and_explicit_reason():
+    legacy = DeadLetterEntry("job-1", "echo", 2, "ValueError: x", START)
+    assert legacy.reason is DeadLetterReason.EXHAUSTED
+
+    explicit = DeadLetterEntry("job-1", "echo", 1, "PermanentJobError: x", START, DeadLetterReason.NON_RETRYABLE)
+    assert explicit.reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_retry_later_error_is_jobq_error_and_keeps_message():
+    exc = RetryLaterError("busy", retry_after=5)
+    assert isinstance(exc, JobqError)
+    assert str(exc) == "busy"
+    assert exc.retry_after == 5.0
+
+
+def test_retry_later_error_negative_retry_after_is_config_error():
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=-1)
+
+
+@pytest.mark.parametrize("value", [math.nan, math.inf, -math.inf, "5", None, True])
+def test_retry_later_error_rejects_non_finite_or_non_numeric(value):
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=value)
+
+
+def test_retry_later_error_zero_is_allowed():
+    assert RetryLaterError(retry_after=0).retry_after == 0.0
+
+
+# -- 2. джиттер --------------------------------------------------------------
+
+
+def test_jitter_with_predictable_generator_is_multiplied_by_draw():
+    policy = RetryPolicy(base_delay=10.0, jitter=0.5)
+    rng = CountingRandom(0.8)
+    assert policy.delay_for(1, rng) == pytest.approx(8.0)
+    assert rng.draws == 1
+
+
+def test_jitter_never_delays_the_retry():
+    policy = RetryPolicy(base_delay=10.0, jitter=0.5)
+    for seed in range(50):
+        delay = policy.delay_for(1, random.Random(seed))
+        assert 5.0 <= delay <= 10.0
+
+
+def test_jitter_does_not_break_the_cap():
+    policy = RetryPolicy(base_delay=1.0, max_delay=10.0, jitter=0.5)
+    rng = CountingRandom(0.8)
+    assert policy.delay_for(20, rng) == pytest.approx(8.0)
+    assert rng.draws == 1
+
+
+def test_no_jitter_no_randomness():
+    policy = RetryPolicy(base_delay=1.0, jitter=0.0)
+    rng = CountingRandom()
+    policy.delay_for(2, rng)
+    assert rng.draws == 0
+
+
+# -- 3. очередь ---------------------------------------------------------------
+
+
+def test_mark_dead_lettered_old_call_defaults_to_exhausted(queue):
+    job = queue.enqueue("echo")
+    queue.mark_running(job.id)
+    queue.mark_dead_lettered(job.id, "ValueError: x")
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_mark_dead_lettered_records_reason(queue):
+    job = queue.enqueue("echo")
+    queue.mark_running(job.id)
+    queue.mark_dead_lettered(job.id, "PermanentJobError: x", reason=DeadLetterReason.NON_RETRYABLE)
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_mark_dead_lettered_reason_is_keyword_only(queue):
+    job = queue.enqueue("echo")
+    queue.mark_running(job.id)
+    with pytest.raises(TypeError):
+        queue.mark_dead_lettered(job.id, "x", DeadLetterReason.NON_RETRYABLE)
+
+
+def _dead_letter(queue, job_type="echo"):
+    job = queue.enqueue(job_type)
+    queue.mark_running(job.id)
+    queue.mark_dead_lettered(job.id, "ValueError: x")
+    return job
+
+
+def test_purge_removes_old_dead_letters(queue, clock):
+    dead = _dead_letter(queue)
+    clock.advance(1)
+
+    removed = queue.purge_finished(older_than=0)
+
+    assert removed == 1
+    assert queue.list_jobs() == []
+    assert queue.dead_letters() == []
+    assert queue.metrics.get(m.JOBS_PURGED) == 1
+    with pytest.raises(JobNotFoundError):
+        queue.get(dead.id)
+
+
+def test_purge_keeps_young_dead_letters(queue, clock):
+    dead = _dead_letter(queue)
+    clock.advance(50)
+
+    assert queue.purge_finished(older_than=100) == 0
+    assert [job.id for job in queue.list_jobs()] == [dead.id]
+    assert [entry.job_id for entry in queue.dead_letters()] == [dead.id]
+
+
+def test_purge_counts_dead_letter_age_from_dead_lettered_at(queue, clock):
+    job = queue.enqueue("echo")
+    queue.mark_running(job.id)
+    queue.mark_dead_lettered(job.id, "ValueError: x")
+    clock.advance(30)
+    later = queue.enqueue("echo")
+    queue.mark_running(later.id)
+    queue.mark_failed(later.id, "ValueError: y")
+
+    # dead-letter записан 30 секунд назад (старше порога 20) и удаляется;
+    # failed-задание закончилось только что и остаётся
+    assert queue.purge_finished(older_than=20) == 1
+    assert queue.dead_letters() == []
+    assert [job.id for job in queue.list_jobs()] == [later.id]
+
+
+def test_requeue_all_dead_letters_everything_in_order(queue):
+    a = queue.enqueue("send_email")
+    queue.mark_running(a.id)
+    queue.mark_dead_lettered(a.id, "ValueError: x")
+    b = queue.enqueue("charge")
+    queue.mark_running(b.id)
+    queue.mark_dead_lettered(b.id, "ValueError: y")
+
+    requeued = queue.requeue_all_dead_letters()
+
+    assert [job.id for job in requeued] == [a.id, b.id]
+    assert all(job.status is JobStatus.PENDING for job in requeued)
+    assert queue.dead_letters() == []
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 2
+
+
+def test_requeue_all_dead_letters_by_type(queue):
+    a = queue.enqueue("send_email")
+    queue.mark_running(a.id)
+    queue.mark_dead_lettered(a.id, "ValueError: x")
+    b = queue.enqueue("charge")
+    queue.mark_running(b.id)
+    queue.mark_dead_lettered(b.id, "ValueError: y")
+
+    requeued = queue.requeue_all_dead_letters("charge")
+
+    assert [job.id for job in requeued] == [b.id]
+    assert [entry.job_id for entry in queue.dead_letters()] == [a.id]
+    assert queue.get(a.id).status is JobStatus.DEAD_LETTERED
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 1
+
+
+def test_requeue_all_dead_letters_nothing_to_requeue(queue):
+    assert queue.requeue_all_dead_letters() == []
+    _dead_letter(queue, "send_email")
+    assert queue.requeue_all_dead_letters("charge") == []
+    assert queue.metrics.get(m.JOBS_REQUEUED) == 0
+    assert len(queue.dead_letters()) == 1
+
+
+# -- 4. воркер ----------------------------------------------------------------
+
+
+def test_non_retryable_on_last_attempt_is_dead_lettered_with_reason(queue, registry, worker):
+    queue.set_retry_policy("charge", RetryPolicy(max_attempts=1))
+    registry.register("charge", _raise(PermanentJobError("card declined")))
+    job = queue.enqueue("charge")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+    assert queue.metrics.get(m.JOBS_DEAD_LETTERED) == 1
+
+
+def test_non_retryable_with_attempts_left_does_not_draw_rng(queue, registry, clock):
+    rng = CountingRandom()
+    worker = Worker(queue, registry, rng=rng)
+    queue.set_retry_policy("echo", RetryPolicy(max_attempts=5, non_retryable=(KeyError,)))
+    registry.register("echo", _raise(KeyError("k")))
+    job = queue.enqueue("echo")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+    assert rng.draws == 0
+
+
+def test_attempts_exhausted_reason(queue, registry, worker):
+    queue.set_retry_policy("echo", RetryPolicy(max_attempts=2))
+    registry.register("echo", _raise(ConnectionError("timeout")))
+    job = queue.enqueue("echo")
+
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    queue.clock.advance(3600)
+    worker.run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+    assert queue.metrics.get(m.JOBS_DEAD_LETTERED) == 1
+
+
+def test_retry_later_larger_than_max_delay_is_capped_without_rng(queue, registry, clock):
+    rng = CountingRandom()
+    worker = Worker(queue, registry, rng=rng)
+    queue.set_retry_policy("echo", RetryPolicy(base_delay=1.0, max_delay=60.0, jitter=0.5))
+    registry.register("echo", _raise(RetryLaterError(retry_after=3600)))
+    job = queue.enqueue("echo")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=60)
+    assert rng.draws == 0
+
+
+def test_retry_later_within_limit(queue, registry):
+    queue.set_retry_policy("echo", RetryPolicy(max_delay=60.0))
+    registry.register("echo", _raise(RetryLaterError(retry_after=12.5)))
+    worker = Worker(queue, registry)
+    job = queue.enqueue("echo")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=12.5)
+
+
+def test_retry_later_on_last_attempt_is_exhausted(queue, registry, worker):
+    queue.set_retry_policy("echo", RetryPolicy(max_attempts=2))
+    registry.register("echo", _raise(RetryLaterError(retry_after=5)))
+    job = queue.enqueue("echo")
+
+    worker.run_once()
+    queue.clock.advance(3600)
+    worker.run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_retry_later_without_policy_fails(queue, registry, worker):
+    registry.register("echo", _raise(RetryLaterError(retry_after=5)))
+    job = queue.enqueue("echo")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.FAILED
+    assert queue.dead_letters() == []
+
+
+def test_retry_later_non_retryable_class_goes_to_dead_letter(queue, registry, worker):
+    queue.set_retry_policy("echo", RetryPolicy(non_retryable=(RetryLaterError,)))
+    registry.register("echo", _raise(RetryLaterError(retry_after=5)))
+    job = queue.enqueue("echo")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.DEAD_LETTERED
+    assert queue.dead_letters()[0].reason is DeadLetterReason.NON_RETRYABLE
+
+
+def test_unknown_job_type_with_policy_fails_without_rng(queue, registry):
+    rng = CountingRandom()
+    worker = Worker(queue, registry, rng=rng)
+    queue.set_retry_policy("missing", RetryPolicy())
+    job = queue.enqueue("missing")
+
+    worker.run_once()
+
+    assert job.status is JobStatus.FAILED
+    assert rng.draws == 0
+
