+def test_worker_logs_retry_after_and_delay(queue, registry, worker, caplog):
+    queue.set_retry_policy("echo", RetryPolicy(max_delay=60.0))
+    registry.register("echo", _raise(RetryLaterError(retry_after=3600)))
+    queue.enqueue("echo")
+
+    with caplog.at_level("INFO", logger="jobq.worker"):
+        worker.run_once()
+
+    assert any("retry_after=3600.00s" in r.getMessage() and "60.00s" in r.getMessage() for r in caplog.records)
