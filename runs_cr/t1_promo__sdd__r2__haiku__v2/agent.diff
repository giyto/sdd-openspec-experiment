new file mode 100644
index 0000000..56a78f9
--- /dev/null
+++ b/tests/test_promo_shop447_code.py
@@ -0,0 +1,63 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.errors import ValidationError
+from shop.promo import DiscountKind, PromoCode
+
+
+def make(kind=DiscountKind.PERCENT, value="10", **overrides):
+    return PromoCode(code="SALE", kind=kind, value=Decimal(value), **overrides)
+
+
+# 1.1 free shipping kind and the new fields
+
+
+def test_free_shipping_with_zero_value_is_created():
+    promo = make(DiscountKind.FREE_SHIPPING, "0")
+    assert promo.kind is DiscountKind.FREE_SHIPPING
+
+
+def test_free_shipping_with_nonzero_value_is_rejected():
+    with pytest.raises(ValidationError):
+        make(DiscountKind.FREE_SHIPPING, "10")
+
+
+def test_new_fields_default_to_none():
+    promo = make()
+    assert promo.max_discount is None
+    assert promo.max_uses_per_customer is None
+
+
+# 1.2 max_discount
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "0.001", "100.005"])
+def test_max_discount_must_be_positive_kopecks(value):
+    with pytest.raises(ValidationError):
+        make(max_discount=Decimal(value))
+
+
+@pytest.mark.parametrize("kind,value", [(DiscountKind.FIXED, "500"), (DiscountKind.FREE_SHIPPING, "0")])
+def test_max_discount_only_for_percent(kind, value):
+    with pytest.raises(ValidationError):
+        make(kind, value, max_discount=Decimal("100.00"))
+
+
+def test_max_discount_accepted_for_percent():
+    promo = make(max_discount=Decimal("150.00"))
+    assert promo.max_discount == Decimal("150.00")
+
+
+# 1.2 max_uses_per_customer
+
+
+@pytest.mark.parametrize("value", [0, -3, True, False, 1.5, "2"])
+def test_max_uses_per_customer_rejects_invalid_values(value):
+    with pytest.raises(ValidationError):
+        make(max_uses_per_customer=value)
+
+
+@pytest.mark.parametrize("value", [None, 1, 5])
+def test_max_uses_per_customer_accepts_valid_values(value):
+    assert make(max_uses_per_customer=value).max_uses_per_customer == value
diff --git a/tests/test_promo_shop447_orders.py b/tests/test_promo_shop447_orders.py
new file mode 100644
index 0000000..eeaa7f9
--- /dev/null
+++ b/tests/test_promo_shop447_orders.py
@@ -0,0 +1,131 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import PromoConditionsError
+from shop.orders import OrderService, OrderStatus
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+@pytest.fixture
+def book_cart(products):
+    cart = Cart()
+    cart.add(products["book"])  # 450.00
+    return cart
+
+
+def add_promo(registry, code="SALE", **overrides):
+    fields = {"kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    registry.add(PromoCode(code=code, **fields))
+
+
+# 4.1 Order.customer_id
+
+
+def test_order_stores_customer_id(service, registry, book_cart):
+    add_promo(registry, max_uses_per_customer=1)
+    order = service.place_order(book_cart, "SALE", customer_id="ACC-42")
+    assert order.customer_id == "ACC-42"
+    assert order.promo_code == "SALE"
+    assert registry.uses("SALE", "ACC-42") == 1
+
+
+def test_order_without_promo_has_no_promo_code_but_keeps_customer(service, book_cart):
+    order = service.place_order(book_cart, customer_id="ACC-42")
+    assert order.customer_id == "ACC-42"
+    assert order.promo_code is None
+
+
+def test_order_without_customer_has_none(service, book_cart):
+    assert service.place_order(book_cart).customer_id is None
+
+
+def test_quote_accepts_customer_id(service, registry, book_cart):
+    add_promo(registry, max_uses_per_customer=1)
+    total = service.quote(book_cart, "SALE", customer_id="ACC-42")
+    assert total.discount == Decimal("45.00")
+    assert registry.uses("SALE", "ACC-42") == 0
+
+
+def test_customer_id_is_keyword_only(service, book_cart):
+    with pytest.raises(TypeError):
+        service.place_order(book_cart, None, "ACC-42")
+
+
+def test_code_with_customer_limit_needs_customer_at_order(service, registry, book_cart):
+    add_promo(registry, max_uses_per_customer=1)
+    with pytest.raises(PromoConditionsError):
+        service.place_order(book_cart, "SALE")
+    assert len(service.store) == 0
+    assert registry.uses("SALE") == 0
+
+
+# 4.2 cancellation window
+
+
+@pytest.mark.parametrize(
+    "delay,returned",
+    [
+        (timedelta(hours=23, minutes=59), True),
+        (timedelta(hours=24), False),
+        (timedelta(days=3), False),
+    ],
+)
+def test_cancel_returns_use_only_within_window(service, registry, clock, book_cart, delay, returned):
+    add_promo(registry, max_uses=1)
+    order = service.place_order(book_cart, "SALE")
+    assert registry.uses("SALE") == 1
+
+    clock.advance(delay)
+    cancelled = service.cancel(order.order_id)
+
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert registry.uses("SALE") == (0 if returned else 1)
+
+
+# 4.3 customer limit with cancellation and failed orders
+
+
+def test_cancel_returns_customer_use(service, registry, clock, book_cart):
+    add_promo(registry, max_uses_per_customer=1)
+    order = service.place_order(book_cart, "SALE", customer_id="ACC-1")
+    clock.advance(timedelta(hours=23))
+    service.cancel(order.order_id)
+
+    assert registry.uses("SALE", "ACC-1") == 0
+    again = service.place_order(book_cart, "SALE", customer_id="ACC-1")
+    assert again.promo_code == "SALE"
+    assert registry.uses("SALE", "ACC-1") == 1
+
+
+def test_cancel_after_window_keeps_customer_use(service, registry, clock, book_cart):
+    add_promo(registry, max_uses_per_customer=1)
+    order = service.place_order(book_cart, "SALE", customer_id="ACC-1")
+    clock.advance(timedelta(hours=24))
+    service.cancel(order.order_id)
+
+    assert registry.uses("SALE", "ACC-1") == 1
+    with pytest.raises(PromoConditionsError):
+        service.place_order(book_cart, "SALE", customer_id="ACC-1")
+
+
+def test_failed_order_does_not_use_customer_limit(service, registry, book_cart):
+    add_promo(registry, max_uses_per_customer=1, min_order_amount=Decimal("5000.00"))
+    with pytest.raises(PromoConditionsError):
+        service.place_order(book_cart, "SALE", customer_id="ACC-1")
+    assert registry.uses("SALE", "ACC-1") == 0
+    assert registry.uses("SALE") == 0
+    assert len(service.store) == 0
diff --git a/tests/test_promo_shop447_pricing.py b/tests/test_promo_shop447_pricing.py
new file mode 100644
index 0000000..e106c3f
--- /dev/null
+++ b/tests/test_promo_shop447_pricing.py
@@ -0,0 +1,168 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+
+def promo(kind=DiscountKind.PERCENT, value="10", **overrides):
+    return PromoCode(code="SALE", kind=kind, value=Decimal(value), **overrides)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, quantity in items:
+        cart.add(product, quantity)
+    return cart
+
+
+def product(sku, price, category=Category.BOOKS):
+    return Product(sku, sku, Decimal(price), category)
+
+
+# 3.2 caps on discount amount
+
+
+def test_percent_discount_is_capped_by_max_discount():
+    cart = cart_of((product("B-1", "2000.00"), 1))
+    total = calculate_total(cart, promo=promo(value="10", max_discount=Decimal("150.00")))
+    assert total.discount == Decimal("150.00")
+
+
+def test_max_discount_above_percent_does_not_change_it():
+    cart = cart_of((product("B-1", "2000.00"), 1))
+    total = calculate_total(cart, promo=promo(value="10", max_discount=Decimal("250.00")))
+    assert total.discount == Decimal("200.00")
+
+
+def test_fixed_discount_is_capped_by_half_of_eligible_amount():
+    cart = cart_of((product("B-1", "300.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "500.00"))
+    assert total.discount == Decimal("150.00")
+    assert total.lines[0].tax == Decimal("15.00")  # tax is charged on 150.00 after the discount
+
+
+def test_fixed_discount_below_cap_is_applied_fully():
+    cart = cart_of((product("B-1", "1000.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "300.00"))
+    assert total.discount == Decimal("300.00")
+
+
+def test_fixed_cap_is_rounded_half_up():
+    cart = cart_of((product("B-1", "1005.55"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "600.00"))
+    assert total.discount == Decimal("502.78")
+
+
+def test_fixed_cap_uses_only_eligible_lines():
+    cart = cart_of((product("B-1", "1000.00"), 1), (product("E-1", "5000.00", Category.ELECTRONICS), 1))
+    total = calculate_total(
+        cart,
+        promo=promo(
+            DiscountKind.FIXED, "900.00", excluded_categories=frozenset({Category.ELECTRONICS})
+        ),
+    )
+    assert total.discount == Decimal("500.00")
+    assert [line.discount for line in total.lines] == [Decimal("500.00"), Decimal("0.00")]
+
+
+# 3.3 kopeck split with equal remainders
+
+
+def test_equal_remainders_go_to_larger_line():
+    small = product("S-1", "100.00")
+    large = product("L-1", "300.00")
+    total = calculate_total(cart_of((small, 1), (large, 1)), promo=promo(DiscountKind.FIXED, "0.02"))
+    assert [line.discount for line in total.lines] == [Decimal("0.00"), Decimal("0.02")]
+
+
+def test_equal_remainders_go_to_larger_line_regardless_of_cart_order():
+    small = product("S-1", "100.00")
+    large = product("L-1", "300.00")
+    total = calculate_total(cart_of((large, 1), (small, 1)), promo=promo(DiscountKind.FIXED, "0.02"))
+    assert [line.discount for line in total.lines] == [Decimal("0.02"), Decimal("0.00")]
+
+
+def test_equal_remainders_and_amounts_go_to_cart_order():
+    items = [product(f"C-{i}", "100.00") for i in range(3)]
+    total = calculate_total(
+        cart_of(*[(item, 1) for item in items]), promo=promo(DiscountKind.FIXED, "0.02")
+    )
+    assert [line.discount for line in total.lines] == [
+        Decimal("0.01"),
+        Decimal("0.01"),
+        Decimal("0.00"),
+    ]
+
+
+# 3.4 free-shipping threshold is compared with the subtotal before discount
+
+
+def test_discount_brings_free_shipping_threshold_within_reach():
+    cart = cart_of((product("BIG-1", "3100.00", Category.ELECTRONICS), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "200.00"))
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("0.00")
+
+
+def test_discount_does_not_push_goods_below_threshold_into_free_shipping():
+    cart = cart_of((product("P-1", "2500.00", Category.ELECTRONICS), 1), (product("B-1", "450.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "100.00"))
+    assert total.subtotal == Decimal("2950.00")
+    assert total.shipping == Decimal("299.00")
+
+
+# 3.5 free shipping promo
+
+
+def test_free_shipping_waives_delivery_and_reports_it():
+    cart = cart_of((product("B-1", "450.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FREE_SHIPPING, "0"))
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("299.00")
+    assert total.discount == Decimal("0.00")
+
+
+def test_free_shipping_with_only_gift_cards_gives_conditions_error():
+    cart = cart_of((product("GIFT-1000", "1000.00", Category.GIFT_CARD), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(DiscountKind.FREE_SHIPPING, "0"))
+
+
+def test_free_shipping_when_threshold_already_reached_saves_nothing():
+    cart = cart_of((product("P-1", "3500.00", Category.ELECTRONICS), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FREE_SHIPPING, "0"))
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("0.00")
+
+
+@pytest.mark.parametrize(
+    "kind,value",
+    [(DiscountKind.PERCENT, "10"), (DiscountKind.FIXED, "100.00")],
+)
+def test_other_kinds_report_zero_shipping_discount(kind, value):
+    cart = cart_of((product("B-1", "450.00"), 1))
+    total = calculate_total(cart, promo=promo(kind, value))
+    assert total.shipping == Decimal("299.00")
+    assert total.shipping_discount == Decimal("0.00")
+
+
+def test_free_shipping_respects_minimum_order_amount():
+    cart = cart_of((product("B-1", "450.00"), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(DiscountKind.FREE_SHIPPING, "0", min_order_amount=Decimal("500.00")))
+
+
+# 3.6 total formula with free shipping
+
+
+def test_free_shipping_keeps_goods_and_tax_and_total_formula():
+    cart = cart_of((product("B-1", "450.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FREE_SHIPPING, "0"))
+    assert total.lines[0].tax == Decimal("45.00")
+    assert total.tax == Decimal("45.00")
+    assert total.total == Decimal("495.00")
+    assert total.total == total.subtotal - total.discount + total.shipping + total.tax
diff --git a/tests/test_promo_shop447_registry.py b/tests/test_promo_shop447_registry.py
new file mode 100644
index 0000000..c7e5fe1
--- /dev/null
+++ b/tests/test_promo_shop447_registry.py
@@ -0,0 +1,136 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.errors import PromoConditionsError, ValidationError
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def add_limited(registry, code="SALE", per_customer=1, **overrides):
+    registry.add(
+        PromoCode(
+            code=code,
+            kind=DiscountKind.PERCENT,
+            value=Decimal("10"),
+            max_uses_per_customer=per_customer,
+            **overrides,
+        )
+    )
+
+
+# 2.1 customer_id is compared as given
+
+
+def test_customer_ids_are_case_sensitive(registry):
+    add_limited(registry)
+    registry.record_use("SALE", "acc-1")
+    assert registry.uses("SALE", "acc-1") == 1
+    assert registry.uses("SALE", "ACC-1") == 0
+    registry.resolve("SALE", "ACC-1")  # a different customer is not limited by "acc-1"
+
+
+@pytest.mark.parametrize("bad", [1, 1.5, b"acc-1", ["acc-1"]])
+def test_non_string_customer_id_is_rejected(registry, bad):
+    add_limited(registry)
+    with pytest.raises(ValidationError):
+        registry.resolve("SALE", bad)
+    with pytest.raises(ValidationError):
+        registry.record_use("SALE", bad)
+    with pytest.raises(ValidationError):
+        registry.release_use("SALE", bad)
+    with pytest.raises(ValidationError):
+        registry.uses("SALE", bad)
+
+
+# 2.2 per-customer limit in resolve
+
+
+def test_code_without_customer_id_is_not_applied(registry):
+    add_limited(registry)
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SALE")
+    with pytest.raises(PromoConditionsError):
+        registry.record_use("SALE")
+    assert registry.uses("SALE") == 0
+
+
+def test_exhausted_customer_limit_gives_conditions_error(registry):
+    add_limited(registry)
+    registry.record_use("SALE", "ACC-1")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SALE", "ACC-1")
+    assert registry.uses("SALE", "ACC-1") == 1
+
+
+def test_other_customer_can_use_the_code(registry):
+    add_limited(registry)
+    registry.record_use("SALE", "ACC-1")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SALE", "ACC-1")
+    registry.record_use("SALE", "ACC-2")
+    assert registry.uses("SALE", "ACC-2") == 1
+
+
+def test_total_limit_is_checked_for_customers_too(registry):
+    add_limited(registry, per_customer=5, max_uses=1)
+    registry.record_use("SALE", "ACC-1")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SALE", "ACC-2")
+
+
+def test_customer_limit_does_not_affect_codes_without_it(registry):
+    registry.add(PromoCode(code="OPEN", kind=DiscountKind.FIXED, value=Decimal("5")))
+    registry.record_use("OPEN")
+    registry.record_use("OPEN", "ACC-1")
+    registry.record_use("OPEN", "ACC-1")
+    assert registry.uses("OPEN") == 3
+    assert registry.uses("OPEN", "ACC-1") == 2
+
+
+# 2.3 counters and release
+
+
+def test_record_use_counts_total_and_customer(registry):
+    add_limited(registry, per_customer=3)
+    registry.record_use("SALE", "ACC-1")
+    registry.record_use("SALE", "ACC-2")
+    assert registry.uses("SALE") == 2
+    assert registry.uses("SALE", "ACC-1") == 1
+
+
+def test_uses_without_customer_returns_total(registry):
+    add_limited(registry, per_customer=3)
+    registry.record_use("SALE", "ACC-1")
+    registry.record_use("SALE", "ACC-1")
+    assert registry.uses("SALE") == 2
+
+
+def test_release_use_restores_customer_access(registry):
+    add_limited(registry)
+    registry.record_use("SALE", "ACC-1")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SALE", "ACC-1")
+    registry.release_use("SALE", "ACC-1")
+    assert registry.uses("SALE") == 0
+    assert registry.uses("SALE", "ACC-1") == 0
+    registry.resolve("SALE", "ACC-1")
+
+
+def test_release_use_never_goes_below_zero(registry):
+    add_limited(registry)
+    registry.release_use("SALE", "ACC-1")
+    registry.release_use("SALE")
+    assert registry.uses("SALE") == 0
+    assert registry.uses("SALE", "ACC-1") == 0
+
+
+def test_release_use_without_customer_keeps_customer_counter(registry):
+    add_limited(registry)
+    registry.record_use("SALE", "ACC-1")
+    registry.release_use("SALE")
+    assert registry.uses("SALE", "ACC-1") == 1
