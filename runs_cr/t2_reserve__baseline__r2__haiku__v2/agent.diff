index 0000000..8251ef5
--- /dev/null
+++ b/tests/test_reservations_rework.py
@@ -0,0 +1,244 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    ValidationError,
+)
+from warehouse.models import Availability, ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL, MAX_RESERVATION_LIFETIME
+
+T0 = datetime(2026, 3, 1, 10, 0, 0, tzinfo=timezone.utc)
+
+
+def kinds(inv):
+    return [event.kind for event in inv.log]
+
+
+def test_default_ttl_is_twenty_minutes():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=20)
+
+
+def test_max_lifetime_is_two_hours():
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+
+
+def test_reserve_rejects_ttl_above_limit(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME + timedelta(seconds=1))
+    assert len(inv.log) == 1
+
+
+def test_reserve_accepts_ttl_at_limit(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    assert res.expires_at == T0 + MAX_RESERVATION_LIFETIME
+
+
+def test_extend_beyond_limit_clamps_to_limit(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=30))
+    clock.advance(timedelta(minutes=20))
+    res = inv.extend("SO-1", timedelta(hours=5))
+    assert res.expires_at == T0 + MAX_RESERVATION_LIFETIME
+    assert inv.log.events("RESERVE_EXTEND")[0].get("expires") == "2026-03-01T12:00:00Z"
+
+
+def test_extend_at_limit_is_noop(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    clock.advance(timedelta(minutes=10))
+    res = inv.extend("SO-1", timedelta(hours=5))
+    assert res.expires_at == T0 + MAX_RESERVATION_LIFETIME
+    assert inv.log.events("RESERVE_EXTEND") == []
+
+
+def test_replace_active_reservation_frees_its_own_stock(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.lines == (ReservationLine("MAIN", "BOLT-M8", 4),)
+    assert inv.reserved("MAIN", "BOLT-M8") == 4
+    assert inv.available("MAIN", "BOLT-M8") == 1
+
+
+def test_replace_writes_cancel_then_new_reserve_lines(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=5))
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 1)])
+    assert kinds(inv) == ["RECEIVE", "RESERVE", "RESERVE_CANCEL", "RESERVE", "RESERVE"]
+    new_lines = inv.log.events("RESERVE")[1:]
+    assert all(e.get("expires") == "2026-03-01T10:25:00Z" for e in new_lines)
+
+
+def test_replace_gets_new_created_at_and_full_ttl(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=5))
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=60))
+    assert res.created_at == T0 + timedelta(minutes=5)
+    assert res.expires_at == T0 + timedelta(minutes=65)
+
+
+def test_replace_checks_stock_without_old_reservation_and_is_atomic(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("MAIN", "NUT-M8", 1)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    events_before = len(inv.log)
+    with pytest.raises(InsufficientStockError) as info:
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ("MAIN", "NUT-M8", 2)])
+    assert (info.value.sku, info.value.requested, info.value.available) == ("NUT-M8", 2, 1)
+    assert inv.get_reservation("SO-1").lines == (ReservationLine("MAIN", "BOLT-M8", 5),)
+    assert inv.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert len(inv.log) == events_before
+
+
+def test_replace_confirmed_is_still_error(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_cancel_confirmed_returns_stock_to_same_warehouses(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "NUT-M8", 10)
+    inv.reserve("SO-1", [("NORTH", "NUT-M8", 2), ("MAIN", "BOLT-M8", 3)])
+    inv.confirm("SO-1")
+    res = inv.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 10
+    assert inv.on_hand("NORTH", "NUT-M8") == 10
+    tail = inv.log.lines()[-3:]
+    assert [line.split(" ")[2] for line in tail] == ["RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+    receives = inv.log.events("RECEIVE")[-2:]
+    assert [(e.get("wh"), e.get("sku"), e.get("qty"), e.get("ref")) for e in receives] == [
+        ("NORTH", "NUT-M8", "2", "SO-1"),
+        ("MAIN", "BOLT-M8", "3", "SO-1"),
+    ]
+
+
+def test_cancel_confirmed_twice_is_noop(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    inv.cancel("SO-1")
+    events = len(inv.log)
+    assert inv.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(inv.log) == events
+    assert inv.on_hand("MAIN", "BOLT-M8") == 5
+
+
+def test_reservations_snapshots_sorted_and_filtered(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-B", [("MAIN", "BOLT-M8", 1)])
+    inv.reserve("SO-A", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=1))
+    inv.reserve("SO-C", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    inv.cancel("SO-B")
+    clock.advance(timedelta(minutes=1))
+    assert [r.order_id for r in inv.reservations()] == ["SO-A", "SO-B", "SO-C"]
+    assert [r.order_id for r in inv.reservations(ReservationStatus.ACTIVE)] == ["SO-A"]
+    assert [r.order_id for r in inv.reservations(ReservationStatus.EXPIRED)] == ["SO-C"]
+    assert [r.order_id for r in inv.reservations(ReservationStatus.CANCELLED)] == ["SO-B"]
+
+
+def test_availability_rows_match_methods(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "NUT-M8", 3)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    rows = inv.availability()
+    assert rows == [
+        Availability("MAIN", "BOLT-M8", on_hand=10, reserved=4, available=6),
+        Availability("NORTH", "NUT-M8", on_hand=3, reserved=0, available=3),
+    ]
+
+
+def test_availability_includes_reserved_only_position_and_filters_by_warehouse(inv):
+    inv.receive("NORTH", "NUT-M8", 2)
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("NORTH", "NUT-M8", 2)])
+    inv.adjust("NORTH", "NUT-M8", 0, "count")
+    rows = inv.availability()
+    assert rows == [
+        Availability("MAIN", "BOLT-M8", on_hand=5, reserved=0, available=5),
+        Availability("NORTH", "NUT-M8", on_hand=0, reserved=2, available=0),
+    ]
+    assert inv.availability("NORTH") == [rows[1]]
+
+
+def test_availability_skips_expired_and_empty_positions(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    clock.advance(timedelta(minutes=20))
+    inv.issue("MAIN", "BOLT-M8", 5)
+    assert inv.availability() == []
+
+
+def test_sweep_expired_writes_once_in_expiry_order(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-B", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=10))
+    inv.reserve("SO-A", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=10))
+    inv.reserve("SO-C", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=5))
+    inv.reserve("SO-D", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=30))
+    clock.advance(timedelta(minutes=10))
+    statuses_before = [r.status for r in inv.reservations()]
+    on_hand_before = inv.on_hand("MAIN", "BOLT-M8")
+    assert inv.sweep_expired() == ["SO-C", "SO-A", "SO-B"]
+    expire = inv.log.events("RESERVE_EXPIRE")
+    assert [(e.get("order"), e.get("expires")) for e in expire] == [
+        ("SO-C", "2026-03-01T10:05:00Z"),
+        ("SO-A", "2026-03-01T10:10:00Z"),
+        ("SO-B", "2026-03-01T10:10:00Z"),
+    ]
+    assert expire[0].ts == T0 + timedelta(minutes=10)
+    assert [r.status for r in inv.reservations()] == statuses_before
+    assert inv.on_hand("MAIN", "BOLT-M8") == on_hand_before
+    assert inv.sweep_expired() == []
+    assert len(inv.log.events("RESERVE_EXPIRE")) == 3
+
+
+def test_sweep_ignores_active_and_closed_reservations(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    inv.reserve("SO-3", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    inv.confirm("SO-3")
+    inv.cancel("SO-2")
+    clock.advance(timedelta(hours=1))
+    assert inv.sweep_expired() == ["SO-1"]
+
+
+def test_sweep_reports_replaced_expired_reservation_once(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=20))
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=20))
+    # старый резерв истёк и был заменён до sweep, новый истёк позже: это два разных резерва
+    assert inv.sweep_expired() == ["SO-1", "SO-1"]
+    assert [e.get("expires") for e in inv.log.events("RESERVE_EXPIRE")] == [
+        "2026-03-01T10:20:00Z",
+        "2026-03-01T10:40:00Z",
+    ]
+    assert inv.sweep_expired() == []
+
+
+def test_sweep_reports_new_reservation_of_same_order_again(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=20))
+    assert inv.sweep_expired() == ["SO-1"]
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=20))
+    assert inv.sweep_expired() == ["SO-1"]
+    assert [e.get("expires") for e in inv.log.events("RESERVE_EXPIRE")] == [
+        "2026-03-01T10:20:00Z",
+        "2026-03-01T10:40:00Z",
+    ]
