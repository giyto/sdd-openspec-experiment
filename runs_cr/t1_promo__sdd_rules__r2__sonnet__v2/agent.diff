+
+
+@pytest.mark.parametrize(
+    "delta, refunded",
+    [
+        (timedelta(0), True),
+        (timedelta(hours=23, minutes=59, seconds=59), True),
+        (timedelta(hours=24), False),
+        (timedelta(days=5), False),
+    ],
+)
+def test_cancel_window(svc, svc_registry, clock, delta, refunded):
+    order = svc.place_order(one("1000.00"), "ONCE", customer_id="u1")
+    clock.advance(delta)
+    assert svc.cancel(order.order_id).status is OrderStatus.CANCELLED
+    want = 0 if refunded else 1
+    assert svc_registry.uses("ONCE") == want
+    assert svc_registry.uses("ONCE", "u1") == want
+    with pytest.raises(InvalidOrderStateError):
+        svc.cancel(order.order_id)
+    assert svc_registry.uses("ONCE") == want
+    if refunded:
+        svc.place_order(one("1000.00"), "ONCE", customer_id="u1")
+
+
+def test_cancel_no_code_no_registry(clock):
+    bare = OrderService(clock=clock)
+    order = bare.place_order(one("1000.00"), customer_id="u1")
+    clock.advance(timedelta(days=2))
+    assert bare.cancel(order.order_id).status is OrderStatus.CANCELLED
