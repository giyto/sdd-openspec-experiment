diff --git a/tests/test_autumn_promo.py b/tests/test_autumn_promo.py
new file mode 100644
index 0000000..7a837f8
--- /dev/null
+++ b/tests/test_autumn_promo.py
@@ -0,0 +1,243 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import (
+    InvalidOrderStateError,
+    PromoConditionsError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.orders import OrderService, OrderStatus
+from shop.pricing import ShippingPolicy, TaxPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+def code(kind=DiscountKind.PERCENT, value="10", name="C", **kw):
+    return PromoCode(name, kind, D(value), **kw)
+
+
+def pct(v, **kw):
+    return code(DiscountKind.PERCENT, v, **kw)
+
+
+def fixed(v, **kw):
+    return code(DiscountKind.FIXED, v, **kw)
+
+
+def free(**kw):
+    return code(DiscountKind.FREE_SHIPPING, "0", **kw)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for i, (cat, price, qty) in enumerate(items):
+        cart.add(Product(f"SKU-{i}", f"Item {i}", D(price), cat), qty)
+    return cart
+
+
+def one(price, cat=Category.CLOTHING):
+    return cart_of((cat, price, 1))
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        dict(kind=DiscountKind.FIXED, value=D("10"), max_discount=D("5")),
+        dict(kind=DiscountKind.FREE_SHIPPING, value=D("0"), max_discount=D("5")),
+        dict(kind=DiscountKind.PERCENT, value=D("10"), max_discount=D("0")),
+        dict(kind=DiscountKind.PERCENT, value=D("10"), max_discount=D("-1")),
+        dict(kind=DiscountKind.PERCENT, value=D("10"), max_discount=5),
+        dict(kind=DiscountKind.FREE_SHIPPING, value=D("1")),
+        dict(kind=DiscountKind.PERCENT, value=D("10"), max_uses_per_customer=0),
+        dict(kind=DiscountKind.PERCENT, value=D("10"), max_uses_per_customer=True),
+        dict(kind=DiscountKind.PERCENT, value=D("10"), max_uses_per_customer="1"),
+    ],
+)
+def test_invalid_new_fields(kwargs):
+    with pytest.raises(ValidationError):
+        PromoCode("X", **kwargs)
+
+
+def test_valid_new_fields():
+    assert pct("10", max_discount=D("1.50"), max_uses_per_customer=2).max_discount == D("1.50")
+    assert free().kind is DiscountKind.FREE_SHIPPING
+    assert free(max_uses_per_customer=1).max_uses_per_customer == 1
+
+
+@pytest.fixture
+def registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(pct("10", name="LIM", max_uses_per_customer=1))
+    reg.add(pct("10", name="FREE"))
+    return reg
+
+
+def test_customer_counters(registry):
+    registry.record_use("LIM", "u1")
+    registry.record_use("LIM", "User-1")
+    assert registry.uses("LIM", "u1") == 1
+    assert registry.uses("LIM", "user-1") == 0
+    assert registry.uses("LIM") == 2
+    registry.release_use("LIM", "u1")
+    registry.release_use("LIM", "u1")
+    assert registry.uses("LIM", "u1") == 0
+    assert registry.uses("LIM") == 0
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE", "u1")
+
+
+def test_resolve_customer_limit(registry):
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("LIM")
+    assert registry.resolve("LIM", "u1").code == "LIM"
+    registry.record_use("LIM", "u1")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("LIM", "u1")
+    assert registry.resolve("LIM", "u2")
+    assert registry.resolve("FREE").code == "FREE"
+    with pytest.raises(ValidationError):
+        registry.resolve("FREE", 1)
+
+
+def test_threshold_before_discount():
+    assert calculate_total(one("3100.00"), promo=fixed("200")).shipping == D("0.00")
+    assert calculate_total(one("3000.00"), promo=fixed("100")).shipping == D("0.00")
+    assert calculate_total(one("2999.99")).shipping == D("299.00")
+
+
+def test_fixed_cap():
+    assert calculate_total(one("300.00"), promo=fixed("500")).discount == D("150.00")
+    for v, want in (("400", "400.00"), ("500", "500.00"), ("600", "500.00")):
+        assert calculate_total(one("1000.00"), promo=fixed(v)).discount == D(want)
+    assert calculate_total(one("333.33"), promo=fixed("200")).discount == D("166.67")
+
+
+def test_percent_cap():
+    cap = D("1500")
+    assert calculate_total(one("10000.00"), promo=pct("20", max_discount=cap)).discount == D("1500.00")
+    assert calculate_total(one("5000.00"), promo=pct("20", max_discount=cap)).discount == D("1000.00")
+    equal = pct("20", max_discount=D("1000"))
+    assert calculate_total(one("5000.00"), promo=equal).discount == D("1000.00")
+    assert calculate_total(one("1000.00"), promo=pct("80")).discount == D("800.00")
+
+
+def split(discount, *prices):
+    cart = cart_of(*[(Category.CLOTHING, p, 1) for p in prices])
+    t = calculate_total(cart, promo=fixed(discount))
+    assert sum(line.discount for line in t.lines) == t.discount
+    return [line.discount for line in t.lines]
+
+
+def test_split_ties():
+    assert split("0.02", "1.00", "3.00") == [D("0.00"), D("0.02")]
+    assert split("0.02", "3.00", "1.00") == [D("0.02"), D("0.00")]
+    assert split("10.00", "100.00", "100.00", "100.00") == [D("3.34"), D("3.33"), D("3.33")]
+
+
+def test_free_shipping():
+    t = calculate_total(one("1000.00"), promo=free())
+    assert (t.discount, t.shipping, t.shipping_discount) == (D("0.00"), D("0.00"), D("299.00"))
+    assert t.total == t.subtotal + t.tax
+    t = calculate_total(one("3000.00"), promo=free())
+    assert (t.shipping, t.shipping_discount) == (D("0.00"), D("0.00"))
+    shipping = ShippingPolicy(fee=D("50.00"), free_threshold=None)
+    t = calculate_total(one("1000.00"), shipping, TaxPolicy(), promo=free())
+    assert (t.shipping, t.shipping_discount) == (D("0.00"), D("50.00"))
+
+
+def test_free_shipping_conditions():
+    with pytest.raises(PromoConditionsError):
+        calculate_total(one("1000.00", Category.GIFT_CARD), promo=free())
+    with pytest.raises(PromoConditionsError):
+        calculate_total(one("100.00"), promo=free(min_order_amount=D("200.00")))
+
+
+def test_other_kinds_no_shipping_discount():
+    for p in (pct("10"), fixed("10")):
+        t = calculate_total(one("1000.00"), promo=p)
+        assert t.shipping_discount == D("0.00") and t.shipping == D("299.00")
+        assert t.total == t.subtotal - t.discount + t.shipping + t.tax
+    assert calculate_total(one("1000.00")).shipping_discount == D("0.00")
+
+
+@pytest.fixture
+def svc_registry(clock):
+    reg = PromoRegistry(clock)
+    reg.add(pct("10", name="ONCE", max_uses_per_customer=1, max_uses=5))
+    reg.add(pct("10", name="MIN", min_order_amount=D("5000.00"), max_uses_per_customer=1))
+    return reg
+
+
+@pytest.fixture
+def svc(clock, svc_registry):
+    return OrderService(clock=clock, promos=svc_registry)
+
+
+def test_customer_id_keyword_only_and_type(svc):
+    cart = one("1000.00")
+    with pytest.raises(TypeError):
+        svc.quote(cart, "ONCE", "u1")
+    with pytest.raises(TypeError):
+        svc.place_order(cart, "ONCE", "u1")
+    with pytest.raises(ValidationError):
+        svc.quote(cart, customer_id=42)
+    assert svc.place_order(cart, customer_id="u1").customer_id == "u1"
+    assert svc.place_order(cart).customer_id is None
+
+
+def test_customer_limit_flow(svc, svc_registry):
+    cart = one("1000.00")
+    with pytest.raises(PromoConditionsError):
+        svc.quote(cart, "ONCE")
+    with pytest.raises(PromoConditionsError):
+        svc.place_order(cart, "ONCE")
+    assert len(svc.store) == 0
+    svc.quote(cart, "ONCE", customer_id="u1")
+    assert svc_registry.uses("ONCE") == 0
+    svc.place_order(cart, "ONCE", customer_id="u1")
+    assert svc_registry.uses("ONCE", "u1") == 1
+    with pytest.raises(PromoConditionsError):
+        svc.place_order(cart, "ONCE", customer_id="u1")
+    svc.place_order(cart, "ONCE", customer_id="u2")
