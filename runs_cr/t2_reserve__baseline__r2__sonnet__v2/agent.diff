+    def reservations(self, status: ReservationStatus | None = None) -> list[Reservation]:
+        """Снимки резервов (по одному на заказ), по ``created_at`` и ``order_id``."""
+        now = self._clock.now()
+        result = [
+            replace(res, status=effective_status(res, now)) for res in self._store.reservations()
+        ]
+        if status is not None:
+            result = [res for res in result if res.status is status]
+        return sorted(result, key=lambda res: (res.created_at, res.order_id))
+
+    def availability(self, warehouse: str | None = None) -> list[Availability]:
+        """Остаток, резерв и доступное по каждой позиции с остатком или резервом."""
+        now = self._clock.now()
+        reserved: dict[tuple[str, str], int] = {}
+        for res in self._store.reservations():
+            if is_active(res, now):
+                for key, qty in totals(res.lines).items():
+                    reserved[key] = reserved.get(key, 0) + qty
+        on_hand = {(wh, sku): qty for wh, sku, qty in self._store.positions()}
+        result = []
+        for wh, sku in sorted(set(on_hand) | {k for k, v in reserved.items() if v > 0}):
+            if warehouse is not None and wh != warehouse:
+                continue
+            have = on_hand.get((wh, sku), 0)
+            held = reserved.get((wh, sku), 0)
+            result.append(Availability(wh, sku, have, held, max(0, have - held)))
+        return result
+
+    def sweep_expired(self) -> list[str]:
+        """Пишет ``RESERVE_EXPIRE`` по истёкшим резервам, о которых ещё не писали."""
+        now = self._clock.now()
+        found = [
+            res
+            for res in [*self._superseded, *self._store.reservations()]
+            if effective_status(res, now) is ReservationStatus.EXPIRED
+            and (res.order_id, res.created_at, res.expires_at) not in self._swept
+        ]
+        found.sort(key=lambda res: (res.expires_at, res.order_id))
+        for res in found:
+            self._swept.add((res.order_id, res.created_at, res.expires_at))
+            self._log.append(
+                now, "RESERVE_EXPIRE", order=res.order_id, expires=format_timestamp(res.expires_at)
+            )
+        return [res.order_id for res in found]
