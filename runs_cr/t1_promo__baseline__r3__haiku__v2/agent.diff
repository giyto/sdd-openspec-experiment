+def test_place_order_stores_customer_and_enforces_limit(products, clock):
+    registry = PromoRegistry(clock)
+    registry.add(PromoCode("ONEPER", DiscountKind.PERCENT, Decimal("10"), max_uses_per_customer=1))
+    service = OrderService(clock=clock, promos=registry)
+    cart = cart_of((products["tea"], 1))
+
+    order = service.place_order(cart, "ONEPER", customer_id="acc-1")
+    assert order.customer_id == "acc-1"
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "ONEPER", customer_id="acc-1")
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "ONEPER", customer_id="acc-1")
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "ONEPER")
+    assert service.place_order(cart, "ONEPER", customer_id="acc-2").customer_id == "acc-2"
+
