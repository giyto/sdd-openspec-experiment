+def test_remainder_tie_goes_to_larger_line_then_to_earlier():
+    small = Product("S-1", "Small", Decimal("10.00"), Category.CLOTHING)
+    large = Product("L-1", "Large", Decimal("30.00"), Category.CLOTHING)
+    promo = PromoCode("FIX", DiscountKind.FIXED, Decimal("0.02"))
+    # equal remainders (2000 of 4000 kopecks): the leftover kopeck goes to the larger line
+    total = calculate_total(cart_of((small, 1), (large, 1)), promo=promo)
+    assert [line.discount for line in total.lines] == [Decimal("0.00"), Decimal("0.02")]
