diff --git a/tests/test_promo_shop447.py b/tests/test_promo_shop447.py
new file mode 100644
index 0000000..3613a90
--- /dev/null
+++ b/tests/test_promo_shop447.py
@@ -0,0 +1,212 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.clock import FixedClock
+from shop.errors import PromoConditionsError, ValidationError
+from shop.orders import OrderService, OrderStatus
+from shop.pricing import calculate_total
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+def cart_of(*lines):
+    cart = Cart()
+    for product, quantity in lines:
+        cart.add(product, quantity)
+    return cart
+
+
+def test_free_shipping_code_needs_zero_value():
+    promo = PromoCode("FREESHIP", DiscountKind.FREE_SHIPPING, Decimal("0"))
+    assert promo.value == Decimal("0")
+    with pytest.raises(ValidationError):
+        PromoCode("FREESHIP", DiscountKind.FREE_SHIPPING, Decimal("10"))
+
+
+def test_free_shipping_zeroes_fee_and_reports_saving(products):
+    promo = PromoCode("FREESHIP", DiscountKind.FREE_SHIPPING, Decimal("0"))
+    total = calculate_total(cart_of((products["tea"], 1)), promo=promo)
+    assert total.discount == Decimal("0.00")
+    assert total.lines[0].discount == Decimal("0.00")
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("299.00")
+    assert total.tax == Decimal("19.99")
+    assert total.total == Decimal("219.89")  # 199.90 + 19.99 tax
+
+
+def test_shipping_discount_is_zero_without_free_shipping(products):
+    cart = cart_of((products["tea"], 1))
+    assert calculate_total(cart).shipping_discount == Decimal("0.00")
+    fixed = PromoCode("FIX", DiscountKind.FIXED, Decimal("10.00"))
+    assert calculate_total(cart, promo=fixed).shipping_discount == Decimal("0.00")
+
+
+def test_free_shipping_saves_nothing_when_threshold_already_reached(products):
+    promo = PromoCode("FREESHIP", DiscountKind.FREE_SHIPPING, Decimal("0"))
+    cart = cart_of((products["shirt"], 4))  # 3996.00, shipping already free
+    total = calculate_total(cart, promo=promo)
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("0.00")
+
+
+def test_free_shipping_needs_participating_items(products):
+    promo = PromoCode("FREESHIP", DiscountKind.FREE_SHIPPING, Decimal("0"))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=promo)
+
+
+def test_threshold_is_compared_before_discount(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 1), (products["tea"], 1))
+    promo = PromoCode("SALE", DiscountKind.PERCENT, Decimal("10"))
+    total = calculate_total(cart, promo=promo)  # 3149.90 before discount >= 3000
+    assert total.discount == Decimal("314.99")
+    assert total.shipping == Decimal("0.00")
+
+
+def test_max_discount_caps_percent(products):
+    cart = cart_of((products["book"], 1))  # 450.00
+    promo = PromoCode("CAP", DiscountKind.PERCENT, Decimal("50"), max_discount=Decimal("100.00"))
+    total = calculate_total(cart, promo=promo)
+    assert total.discount == Decimal("100.00")
+    assert total.total == total.subtotal - Decimal("100.00") + total.shipping + total.tax
+
+
+def test_max_discount_above_percent_changes_nothing(products):
+    cart = cart_of((products["book"], 1))
+    promo = PromoCode("CAP", DiscountKind.PERCENT, Decimal("10"), max_discount=Decimal("100.00"))
+    assert calculate_total(cart, promo=promo).discount == Decimal("45.00")
+
+
+@pytest.mark.parametrize("max_discount", [Decimal("0"), Decimal("-1"), Decimal("1.001")])
+def test_max_discount_rules(max_discount):
+    with pytest.raises(ValidationError):
+        PromoCode("CAP", DiscountKind.PERCENT, Decimal("10"), max_discount=max_discount)
+
+
+def test_max_discount_only_for_percent():
+    with pytest.raises(ValidationError):
+        PromoCode("CAP", DiscountKind.FIXED, Decimal("10"), max_discount=Decimal("100"))
+    with pytest.raises(ValidationError):
+        PromoCode("CAP", DiscountKind.FREE_SHIPPING, Decimal("0"), max_discount=Decimal("100"))
+
+
+def test_fixed_discount_capped_at_half_of_participating_amount(products):
+    cart = cart_of((products["phone"], 1), (products["gift"], 1))
+    promo = PromoCode("FIX", DiscountKind.FIXED, Decimal("5000.00"))
+    total = calculate_total(cart, promo=promo)
+    assert total.discount == Decimal("1250.00")  # half of the 2500.00 phone
+
+
+def test_fixed_cap_is_rounded_half_up():
