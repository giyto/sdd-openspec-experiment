+def _placed_service(products, clock, promo_code="ONCE"):
+    registry = PromoRegistry(clock)
+    registry.add(PromoCode(promo_code, DiscountKind.FIXED, Decimal("5.00"), max_uses=1))
+    service = OrderService(clock=clock, promos=registry)
+    order = service.place_order(cart_of((products["tea"], 1)), promo_code, customer_id="acc-1")
+    return service, registry, order
+
+
+def test_cancel_within_day_returns_use(products, clock):
+    service, registry, order = _placed_service(products, clock)
+    clock.advance(timedelta(hours=24) - timedelta(seconds=1))
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert registry.uses("ONCE") == 0
+    assert registry.uses("ONCE", "acc-1") == 0
+
+
+def test_cancel_exactly_after_day_does_not_return_use(products, clock):
+    service, registry, order = _placed_service(products, clock)
+    clock.advance(timedelta(hours=24))
+    service.cancel(order.order_id)
+    assert registry.uses("ONCE") == 1
+    assert registry.uses("ONCE", "acc-1") == 1
+
+
+def test_cancel_later_does_not_return_use(products, clock):
+    service, registry, order = _placed_service(products, clock)
+    clock.advance(timedelta(days=3))
+    service.cancel(order.order_id)
+    assert registry.uses("ONCE") == 1
+
+
+def test_late_cancel_keeps_code_used_up(products, clock):
+    service, registry, order = _placed_service(products, clock)
+    clock.advance(timedelta(days=3))
+    service.cancel(order.order_id)
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_of((products["tea"], 1)), "ONCE", customer_id="acc-2")
