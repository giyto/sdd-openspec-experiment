+class RetryLaterError(JobqError):
+    """Обработчик бросает её, когда внешний сервис сам назвал время повтора (секунды)."""
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        if isinstance(retry_after, bool) or not isinstance(retry_after, Real):
+            raise ConfigError("retry_after must be a number")
+        if math.isnan(retry_after) or retry_after < 0:
+            raise ConfigError("retry_after must be >= 0")
+        super().__init__(message)
+        self.retry_after = retry_after
