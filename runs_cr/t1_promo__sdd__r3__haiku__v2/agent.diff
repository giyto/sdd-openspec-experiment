diff --git a/tests/test_promo_campaign_model.py b/tests/test_promo_campaign_model.py
new file mode 100644
index 0000000..c61bf29
--- /dev/null
+++ b/tests/test_promo_campaign_model.py
@@ -0,0 +1,97 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.errors import ValidationError
+from shop.promo import DiscountKind, PromoCode
+
+
+def make(kind=DiscountKind.PERCENT, value=Decimal("10"), **overrides):
+    return PromoCode(code="SUMMER10", kind=kind, value=value, **overrides)
+
+
+def test_free_shipping_with_non_zero_value_rejected():
+    with pytest.raises(ValidationError):
+        make(kind=DiscountKind.FREE_SHIPPING, value=Decimal("100"))
+
+
+def test_free_shipping_with_zero_value_accepted():
+    promo = make(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0"))
+    assert promo.kind is DiscountKind.FREE_SHIPPING
+
+
+def test_free_shipping_with_zero_cents_accepted():
+    promo = make(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0.00"))
+    assert promo.value == 0
+
+
+@pytest.mark.parametrize("max_discount", [Decimal("0"), Decimal("-5.00"), Decimal("10.001")])
+def test_max_discount_must_be_positive_money_for_percent(max_discount):
+    with pytest.raises(ValidationError):
+        make(max_discount=max_discount)
+
+
+def test_max_discount_rejected_for_fixed():
+    with pytest.raises(ValidationError):
+        make(kind=DiscountKind.FIXED, value=Decimal("50.00"), max_discount=Decimal("100.00"))
+
+
+def test_max_discount_rejected_for_free_shipping():
+    with pytest.raises(ValidationError):
+        make(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0"), max_discount=Decimal("100.00"))
+
+
+def test_max_discount_must_be_decimal():
+    with pytest.raises(ValidationError):
+        make(max_discount=100)
+
+
+def test_max_discount_accepted_for_percent():
+    assert make(max_discount=Decimal("150.00")).max_discount == Decimal("150.00")
+
+
+@pytest.mark.parametrize("limit", [0, -1, True, 1.5])
+def test_max_uses_per_customer_must_be_none_or_positive_int(limit):
+    with pytest.raises(ValidationError):
+        make(max_uses_per_customer=limit)
+
+
+@pytest.mark.parametrize("limit", [None, 1, 3])
+def test_max_uses_per_customer_accepted(limit):
+    assert make(max_uses_per_customer=limit).max_uses_per_customer == limit
+
+
+def test_new_fields_default_to_none():
+    promo = make()
+    assert promo.max_discount is None
+    assert promo.max_uses_per_customer is None
+
+
+def test_new_fields_are_last_positional_fields_unchanged():
+    promo = PromoCode(
+        "SUMMER10",
+        DiscountKind.PERCENT,
+        Decimal("10"),
+        Decimal("0.00"),
+        None,
+        None,
+        None,
+        frozenset(),
+    )
+    assert promo.max_discount is None
+    assert promo.max_uses_per_customer is None
+
+
+def test_free_shipping_naive_expiry_still_rejected():
+    with pytest.raises(ValidationError):
+        make(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0"), expires_at=datetime(2026, 1, 1))
+
+
+def test_aware_validity_with_free_shipping_accepted():
+    promo = make(
+        kind=DiscountKind.FREE_SHIPPING,
+        value=Decimal("0"),
+        starts_at=datetime(2026, 1, 1, tzinfo=timezone.utc),
+    )
+    assert promo.starts_at is not None
diff --git a/tests/test_promo_campaign_orders.py b/tests/test_promo_campaign_orders.py
new file mode 100644
index 0000000..6aa3227
--- /dev/null
+++ b/tests/test_promo_campaign_orders.py
@@ -0,0 +1,148 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import PromoConditionsError
+from shop.orders import OrderService, OrderStatus
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+@pytest.fixture
+def service(clock, registry):
+    return OrderService(clock=clock, promos=registry)
+
+
+def add_code(registry, **overrides):
+    fields = {"code": "SUMMER10", "kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    registry.add(PromoCode(**fields))
+
+
+def cart_with(product, quantity=1):
+    cart = Cart()
+    cart.add(product, quantity)
+    return cart
+
+
+# 3.1 customer on the order
+
+
+def test_order_remembers_the_customer(service, registry, products):
+    add_code(registry, max_uses_per_customer=2)
+    order = service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    assert order.customer_id == "c-1"
+    assert registry.uses("SUMMER10", "c-1") == 1
+
+
+def test_order_without_customer(service, products):
+    order = service.place_order(cart_with(products["book"]))
+    assert order.customer_id is None
+
+
+def test_order_without_code_still_keeps_customer(service, products):
+    order = service.place_order(cart_with(products["book"]), customer_id="c-1")
+    assert order.promo_code is None
+    assert order.customer_id == "c-1"
+
+
+def test_quote_accepts_customer_for_per_customer_limit(service, registry, products):
+    add_code(registry, max_uses_per_customer=1)
+    registry.record_use("SUMMER10", "c-1")
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    assert service.quote(cart_with(products["book"]), "SUMMER10", customer_id="c-2").discount == Decimal("45.00")
+
+
+def test_place_order_without_customer_for_limited_code_raises(service, registry, products):
+    add_code(registry, max_uses_per_customer=1)
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_with(products["book"]), "SUMMER10")
+    assert len(service.store) == 0
+
+
+def test_customer_limit_blocks_second_order(service, registry, products):
+    add_code(registry, max_uses_per_customer=1)
+    service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    assert len(service.store) == 1
+    assert registry.uses("SUMMER10", "c-1") == 1
+
+
+# 3.2 failed order does not count
+
+
+def test_failed_order_does_not_consume_a_customer_use(service, registry, products):
+    add_code(registry, max_uses=2, max_uses_per_customer=2, min_order_amount=Decimal("1000.00"))
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    assert registry.uses("SUMMER10") == 0
+    assert registry.uses("SUMMER10", "c-1") == 0
+    assert len(service.store) == 0
+
+
+def test_customer_count_grows_only_on_successful_orders(service, registry, products):
+    add_code(registry, max_uses_per_customer=5, min_order_amount=Decimal("400.00"))
+    service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_with(products["tea"]), "SUMMER10", customer_id="c-1")
+    assert registry.uses("SUMMER10", "c-1") == 1
+
+
+# 3.3 cancellation window
+
+
+def test_cancellation_within_24_hours_restores_the_count(service, registry, products, clock):
+    add_code(registry, max_uses=1, max_uses_per_customer=1)
+    order = service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    clock.advance(timedelta(hours=23, minutes=59))
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert registry.uses("SUMMER10") == 0
+    assert registry.uses("SUMMER10", "c-1") == 0
+    assert registry.resolve("SUMMER10", "c-1").code == "SUMMER10"
+
+
+def test_cancellation_exactly_at_24_hours_spends_the_use(service, registry, products, clock):
+    add_code(registry, max_uses=1, max_uses_per_customer=1)
+    order = service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    clock.advance(timedelta(hours=24))
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert registry.uses("SUMMER10") == 1
+    assert registry.uses("SUMMER10", "c-1") == 1
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10", "c-1")
+
+
+def test_cancellation_after_24_hours_keeps_the_count(service, registry, products, clock):
+    add_code(registry, max_uses=1)
+    order = service.place_order(cart_with(products["book"]), "SUMMER10")
+    clock.advance(timedelta(days=3))
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert cancelled.promo_code == "SUMMER10"
+    assert registry.uses("SUMMER10") == 1
+
+
+def test_cancelled_order_keeps_customer(service, registry, products):
+    add_code(registry, max_uses_per_customer=1)
+    order = service.place_order(cart_with(products["book"]), "SUMMER10", customer_id="c-1")
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.customer_id == "c-1"
+    assert cancelled.promo_code == "SUMMER10"
+
+
+def test_cancel_order_without_code_changes_no_counts(service, registry, products):
+    add_code(registry, max_uses_per_customer=1)
+    order = service.place_order(cart_with(products["book"]), customer_id="c-1")
+    service.cancel(order.order_id)
+    assert registry.uses("SUMMER10") == 0
+    assert registry.uses("SUMMER10", "c-1") == 0
diff --git a/tests/test_promo_campaign_pricing.py b/tests/test_promo_campaign_pricing.py
new file mode 100644
index 0000000..67f5a33
--- /dev/null
+++ b/tests/test_promo_campaign_pricing.py
@@ -0,0 +1,190 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError, ValidationError
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+
+def promo(kind=DiscountKind.PERCENT, value=Decimal("10"), **overrides):
+    return PromoCode(code="CAMPAIGN", kind=kind, value=value, **overrides)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, quantity in items:
+        cart.add(product, quantity)
+    return cart
+
+
+def product(sku, price, category):
+    return Product(sku, sku, Decimal(price), category)
+
+
+# 2.1 fixed amount cap
+
+
+def test_fixed_amount_cap_is_rounded_half_up():
+    cart = cart_of((product("BOOK-999", "999.99", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("1000.00")))
+    assert total.discount == Decimal("500.00")
+
+
+def test_fixed_amount_above_cap_is_limited_to_half_the_base():
+    cart = cart_of((product("BOOK-300", "300.00", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("500.00")))
+    assert total.discount == Decimal("150.00")
+    assert total.lines[0].discount == Decimal("150.00")
+
+
+def test_fixed_amount_below_cap_is_taken_as_is():
+    cart = cart_of((product("BOOK-1000", "1000.00", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("300.00")))
+    assert total.discount == Decimal("300.00")
+
+
+# 2.2 percent ceiling
+
+
+def test_percent_discount_reaches_the_ceiling():
+    cart = cart_of((product("BOOK-2000", "2000.00", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=promo(value=Decimal("10"), max_discount=Decimal("150.00")))
+    assert total.discount == Decimal("150.00")
+
+
+def test_percent_discount_below_the_ceiling():
+    cart = cart_of((product("BOOK-1000", "1000.00", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=promo(value=Decimal("10"), max_discount=Decimal("150.00")))
+    assert total.discount == Decimal("100.00")
+
+
+def test_percent_ceiling_is_applied_to_rounded_discount():
+    cart = cart_of((product("BOOK-1", "1.00", Category.BOOKS), 1))
+    total = calculate_total(cart, promo=promo(value=Decimal("15"), max_discount=Decimal("0.01")))
+    assert total.discount == Decimal("0.01")
+
+
+# 2.3 tie-break of the remaining kopeck
+
+
+def test_tie_on_remainder_goes_to_the_larger_line():
+    first = product("BOOK-1A", "1.00", Category.BOOKS)
+    second = product("BOOK-3A", "3.00", Category.BOOKS)
+    cart = cart_of((first, 1), (second, 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("0.02")))
+    assert [line.discount for line in total.lines] == [Decimal("0.00"), Decimal("0.02")]
+
+
+def test_tie_on_remainder_and_amount_goes_to_the_earlier_line():
+    a = product("BOOK-A", "100.00", Category.BOOKS)
+    b = product("BOOK-B", "100.00", Category.BOOKS)
+    cart = cart_of((a, 1), (b, 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("0.01")))
+    assert [line.discount for line in total.lines] == [Decimal("0.01"), Decimal("0.00")]
+
+
+def test_largest_remainder_still_wins_over_larger_line():
+    first = product("BOOK-1B", "1.00", Category.BOOKS)
+    second = product("BOOK-2B", "2.00", Category.BOOKS)
+    cart = cart_of((first, 1), (second, 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FIXED, value=Decimal("0.02")))
+    assert [line.discount for line in total.lines] == [Decimal("0.01"), Decimal("0.01")]
+
+
+# 2.4 shipping_discount field
+
+
+def test_shipping_discount_defaults_to_zero_without_promo(products):
+    total = calculate_total(cart_of((products["book"], 1)))
+    assert total.shipping_discount == Decimal("0.00")
+
+
+def test_order_total_keeps_positional_construction():
+    cart = cart_of((product("BOOK-10", "10.00", Category.BOOKS), 1))
+    base = calculate_total(cart)
+    rebuilt = type(base)(base.lines, base.subtotal, base.shipping, base.tax, base.total, base.discount)
+    assert rebuilt.shipping_discount == Decimal("0.00")
+
+
+# 2.5 free shipping code
+
+
+def test_free_shipping_code_zeroes_shipping_and_reports_saving(products):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0")))
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("299.00")
+    assert total.discount == Decimal("0.00")
+
+
+def test_free_shipping_code_gives_no_goods_discount_and_taxes_full_price(products):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0")))
+    assert total.lines[0].discount == Decimal("0.00")
+    assert total.lines[0].tax == Decimal("45.00")
+
+
+def test_free_shipping_code_with_no_saving_when_threshold_reached(products):
+    cart = cart_of((products["phone"], 2))
+    total = calculate_total(cart, promo=promo(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0")))
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("0.00")
+
+
+@pytest.mark.parametrize(
+    "kind, value",
+    [(DiscountKind.PERCENT, Decimal("10")), (DiscountKind.FIXED, Decimal("50.00"))],
+)
+def test_other_code_kinds_give_no_shipping_saving(products, kind, value):
+    cart = cart_of((products["book"], 1))
+    total = calculate_total(cart, promo=promo(kind=kind, value=value))
+    assert total.shipping == Decimal("299.00")
+    assert total.shipping_discount == Decimal("0.00")
+
+
+def test_free_shipping_with_no_participating_lines_raises(products):
+    cart = cart_of((products["gift"], 2))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=promo(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0")))
+
+
+def test_free_shipping_below_minimum_raises():
+    cart = cart_of((product("SHIRT-999", "999.99", Category.CLOTHING), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart,
+            promo=promo(kind=DiscountKind.FREE_SHIPPING, value=Decimal("0"), min_order_amount=Decimal("1000.00")),
+        )
+
+
+def test_free_shipping_value_must_be_zero():
+    with pytest.raises(ValidationError):
+        promo(kind=DiscountKind.FREE_SHIPPING, value=Decimal("1"))
+
+
+# 2.6 threshold before the discount
+
+
+def test_goods_before_discount_reach_the_threshold():
+    goods = product("PHONE-3100", "3100.00", Category.ELECTRONICS)
+    total = calculate_total(cart_of((goods, 1)), promo=promo(kind=DiscountKind.FIXED, value=Decimal("100.00")))
+    assert total.discount == Decimal("100.00")
+    assert total.shipping == Decimal("0.00")
+
+
+def test_discount_does_not_bring_goods_to_the_threshold():
+    goods = product("PHONE-2990", "2990.00", Category.ELECTRONICS)
+    total = calculate_total(cart_of((goods, 1)), promo=promo(kind=DiscountKind.FIXED, value=Decimal("100.00")))
+    assert total.discount == Decimal("100.00")
+    assert total.shipping == Decimal("299.00")
+
+
+def test_threshold_is_compared_before_discount_with_custom_policy():
+    policy = ShippingPolicy(free_threshold=Decimal("2400.00"))
+    goods = product("BOOK-2500", "2500.00", Category.BOOKS)
+    total = calculate_total(
+        cart_of((goods, 1)), policy, promo=promo(kind=DiscountKind.FIXED, value=Decimal("100.00"))
+    )
+    assert total.shipping == Decimal("0.00")
diff --git a/tests/test_promo_campaign_registry.py b/tests/test_promo_campaign_registry.py
new file mode 100644
index 0000000..6dab729
--- /dev/null
+++ b/tests/test_promo_campaign_registry.py
@@ -0,0 +1,139 @@
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.clock import FixedClock
+from shop.errors import PromoConditionsError, UnknownPromoCodeError
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+NOW = datetime(2026, 6, 15, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def clock():
+    return FixedClock(NOW)
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def add_code(registry, **overrides):
+    fields = {"code": "SUMMER10", "kind": DiscountKind.PERCENT, "value": Decimal("10")}
+    fields.update(overrides)
+    registry.add(PromoCode(**fields))
+
+
+# 1.2 per-customer counter
+
+
+def test_customer_counter_grows_with_customer(registry):
+    add_code(registry)
+    registry.record_use("SUMMER10", "c-1")
+    registry.record_use("SUMMER10", "c-1")
+    registry.record_use("SUMMER10", "c-2")
+    assert registry.uses("SUMMER10", "c-1") == 2
+    assert registry.uses("SUMMER10", "c-2") == 1
+    assert registry.uses("SUMMER10") == 3
+
+
+def test_record_without_customer_counts_only_total(registry):
+    add_code(registry)
+    registry.record_use("SUMMER10")
+    assert registry.uses("SUMMER10") == 1
+    assert registry.uses("SUMMER10", "c-1") == 0
+
+
+def test_release_customer_use_decreases_both_counters(registry):
+    add_code(registry)
+    registry.record_use("SUMMER10", "c-1")
+    registry.release_use("SUMMER10", "c-1")
+    assert registry.uses("SUMMER10", "c-1") == 0
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_release_does_not_take_customer_count_below_zero(registry):
+    add_code(registry)
+    registry.record_use("SUMMER10", "c-1")
+    registry.record_use("SUMMER10", "c-2")
+    registry.release_use("SUMMER10", "c-1")
+    registry.release_use("SUMMER10", "c-1")
+    assert registry.uses("SUMMER10", "c-1") == 0
+    assert registry.uses("SUMMER10", "c-2") == 1
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_release_for_unknown_customer_keeps_others(registry):
+    add_code(registry)
+    registry.record_use("SUMMER10", "c-1")
+    registry.release_use("SUMMER10", "c-2")
+    assert registry.uses("SUMMER10", "c-1") == 1
+    assert registry.uses("SUMMER10") == 0
+
+
+def test_uses_with_customer_of_unknown_code_raises(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE", "c-1")
+
+
+# 1.3 per-customer limit in resolve
+
+
+def test_limited_code_without_customer_raises(registry):
+    add_code(registry, max_uses_per_customer=1)
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10")
+
+
+def test_customer_at_limit_raises(registry):
+    add_code(registry, max_uses_per_customer=1)
+    registry.record_use("SUMMER10", "c-1")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("SUMMER10", "c-1")
+
+
+def test_other_customer_is_not_limited(registry):
+    add_code(registry, max_uses_per_customer=1)
+    registry.record_use("SUMMER10", "c-1")
+    assert registry.resolve("SUMMER10", "c-2").code == "SUMMER10"
+
+
+def test_customer_below_limit_resolves(registry):
+    add_code(registry, max_uses_per_customer=2)
+    registry.record_use("SUMMER10", "c-1")
+    assert registry.resolve("SUMMER10", "c-1").code == "SUMMER10"
+
+
+def test_customer_ids_are_compared_as_given(registry):
+    add_code(registry, max_uses_per_customer=1)
+    registry.record_use("SUMMER10", "C-1")
+    assert registry.resolve("SUMMER10", "c-1").code == "SUMMER10"
+
+
+def test_per_customer_count_with_total_count(registry):
+    add_code(registry)
+    registry.record_use("SUMMER10", "c-1")
+    registry.record_use("SUMMER10", "c-1")
+    registry.record_use("SUMMER10", "c-2")
+    assert registry.uses("SUMMER10", "c-1") == 2
+    assert registry.uses("SUMMER10", "c-2") == 1
+    assert registry.uses("SUMMER10") == 3
+
+
+def test_unknown_code_in_per_customer_count_raises(registry):
+    with pytest.raises(UnknownPromoCodeError):
+        registry.uses("NOPE", "c-1")
+
+
+def test_unlimited_per_customer_code_resolves_without_customer(registry):
+    add_code(registry)
+    assert registry.resolve("SUMMER10").code == "SUMMER10"
+
+
+def test_total_limit_checked_before_customer_limit(registry):
+    add_code(registry, max_uses=1, max_uses_per_customer=1)
+    registry.record_use("SUMMER10", "c-1")
+    with pytest.raises(PromoConditionsError, match="no uses left$"):
+        registry.resolve("SUMMER10", "c-2")
