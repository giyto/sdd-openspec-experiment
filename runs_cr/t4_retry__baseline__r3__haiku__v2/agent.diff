+def test_purge_removes_old_dead_letters(queue, registry, worker, clock):
+    job = _dead_letter(queue, registry, "mail")
+    worker.run_pending()
+    clock.advance(100)
+
+    assert queue.purge_finished(older_than=200) == 0
+    assert queue.get(job.id) is job
+
+    assert queue.purge_finished(older_than=50) == 1
+    assert queue.dead_letters() == []
+    assert job.id not in queue.store
+    assert queue.metrics.get("jobs.purged") == 1
+
+
+def test_purge_keeps_recent_dead_letters_and_removes_only_old(queue, registry, worker, clock):
+    old = _dead_letter(queue, registry, "mail")
+    worker.run_pending()
+    clock.advance(100)
+    recent = _dead_letter(queue, registry, "mail")
+    worker.run_pending()
+    clock.advance(10)
+
+    assert queue.purge_finished(older_than=50) == 1
+    assert [entry.job_id for entry in queue.dead_letters()] == [recent.id]
+    assert old.id not in queue.store
+    assert recent.id in queue.store
