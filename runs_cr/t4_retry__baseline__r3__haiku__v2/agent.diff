+# -- requeue_all_dead_letters ---------------------------------------------------
+
+
+def _dead_letter(queue, registry, job_type):
+    queue.set_retry_policy(job_type, RetryPolicy(max_attempts=1))
+    if job_type not in registry:
+        _failing(registry, job_type, lambda: TimeoutError("gateway timeout"))
+    return queue.enqueue(job_type)
+
+
+def test_requeue_all_returns_everything_in_dead_letter_order(queue, registry, worker):
+    first = _dead_letter(queue, registry, "mail")
+    second = _dead_letter(queue, registry, "report")
+    third = _dead_letter(queue, registry, "mail")
+    worker.run_pending()
+
+    requeued = queue.requeue_all_dead_letters()
+
+    assert requeued == [first, second, third]
+    assert all(job.status is JobStatus.PENDING for job in requeued)
+    assert all(job.attempts == 0 and job.error is None for job in requeued)
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.requeued") == 3
+    assert queue.next_due() is first
+
+
+def test_requeue_all_filters_by_job_type(queue, registry, worker):
+    mail_first = _dead_letter(queue, registry, "mail")
+    report = _dead_letter(queue, registry, "report")
+    mail_second = _dead_letter(queue, registry, "mail")
+    worker.run_pending()
+
+    requeued = queue.requeue_all_dead_letters("mail")
+
+    assert requeued == [mail_first, mail_second]
+    assert [entry.job_id for entry in queue.dead_letters()] == [report.id]
+    assert report.status is JobStatus.DEAD_LETTERED
+
+
+def test_requeue_all_on_empty_dead_letter_returns_empty_list(queue):
+    assert queue.requeue_all_dead_letters() == []
+    assert queue.requeue_all_dead_letters("mail") == []
+
+
+def test_requeue_all_with_no_matching_type_returns_empty_list(queue, registry, worker):
+    job = _dead_letter(queue, registry, "mail")
+    worker.run_pending()
+
+    assert queue.requeue_all_dead_letters("report") == []
+    assert job.status is JobStatus.DEAD_LETTERED
+
