+def test_jitter_only_shortens_delay():
+    policy = RetryPolicy(base_delay=10.0, factor=2.0, max_delay=60.0, jitter=0.3)
+    rng = random.Random(42)
+    for attempt in range(1, 4):
+        nominal = min(10.0 * 2.0 ** (attempt - 1), 60.0)
+        for _ in range(200):
+            delay = policy.delay_for(attempt, rng)
+            assert nominal * 0.7 <= delay <= nominal
+
+
+def test_jitter_multiplier_matches_uniform_one_minus_jitter_to_one():
+    policy = RetryPolicy(base_delay=10.0, max_delay=60.0, jitter=0.25)
+    rng = random.Random(4)
+    expected_rng = random.Random(4)
+
+    assert policy.delay_for(1, rng) == 10.0 * expected_rng.uniform(0.75, 1)
