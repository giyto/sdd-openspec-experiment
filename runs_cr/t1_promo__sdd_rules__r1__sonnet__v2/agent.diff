+
+
+def test_refund_uses_service_clock_not_registry_clock(cart):
+    t = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+    reg_clock, svc_clock = FixedClock(t), FixedClock(t)
+    reg = PromoRegistry(reg_clock)
+    reg.add(PromoCode("ONE", DiscountKind.PERCENT, D("10")))
+    svc = OrderService(clock=svc_clock, promos=reg)
+    order = svc.place_order(cart, "ONE")
+    reg_clock.advance(timedelta(hours=30))
+    svc.cancel(order.order_id)
+    assert reg.uses("ONE") == 0
+    order = svc.place_order(cart, "ONE")
+    svc_clock.advance(timedelta(hours=30))
+    svc.cancel(order.order_id)
+    assert reg.uses("ONE") == 1
