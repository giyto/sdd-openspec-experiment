+def test_customer_limit_flow(service, cust, cart):
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "ONCE")
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "ONCE")
+    assert cust.uses("ONCE") == 0 and len(service.store) == 0
+    order = service.place_order(cart, "ONCE", customer_id="u1")
+    assert order.customer_id == "u1"
+    assert cust.uses("ONCE", "u1") == 1 and cust.uses("ONCE") == 1
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "ONCE", customer_id="u1")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "ONCE", customer_id="u1")
+    assert cust.uses("ONCE") == 1 and len(service.store) == 1
+    assert service.place_order(cart, "ONCE", customer_id="u2").customer_id == "u2"
+
+
+def test_customer_id_rules(service, cart):
+    assert service.place_order(cart).customer_id is None
+    assert service.place_order(cart, None, customer_id="u1").customer_id == "u1"
+    with pytest.raises(TypeError):
+        service.place_order(cart, "SUMMER10", "u1")
+    with pytest.raises(TypeError):
+        service.quote(cart, "SUMMER10", "u1")
+    with pytest.raises(ValidationError):
+        service.quote(cart, "SUMMER10", customer_id=5)
+
+
