+    total = service.quote(small, "SHIP")
+    assert total.shipping == D("0.00") and total.shipping_discount == D("299.00")
+
+
+@pytest.mark.parametrize(
+    "delta, refunded",
+    [
+        (timedelta(hours=1), True),
+        (timedelta(hours=23, minutes=59, seconds=59), True),
+        (timedelta(hours=24), False),
+        (timedelta(hours=25), False),
+    ],
+)
+def test_refund_window(service, cust, cart, clock, delta, refunded):
+    order = service.place_order(cart, "ONCE", customer_id="u1")
+    clock.advance(delta)
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status.value == "cancelled"
+    expected = 0 if refunded else 1
+    assert cust.uses("ONCE") == expected and cust.uses("ONCE", "u1") == expected
+    if refunded:
+        assert service.place_order(cart, "ONCE", customer_id="u1")
+    else:
+        with pytest.raises(PromoConditionsError):
+            service.place_order(cart, "ONCE", customer_id="u1")
+    with pytest.raises(InvalidOrderStateError):
