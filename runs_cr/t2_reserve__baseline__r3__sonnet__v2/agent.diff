+    def reservations(self, status: ReservationStatus | None = None) -> list[Reservation]:
+        """Снимки текущих резервов (по одному на заказ), по created_at и order_id."""
+        snapshots = [
+            replace(reservation, status=self._status(reservation))
+            for reservation in self._reservations.values()
+        ]
+        if status is not None:
+            snapshots = [r for r in snapshots if r.status is status]
+        return sorted(snapshots, key=lambda r: (r.created_at, r.order_id))
+
+    def availability(self, warehouse: str | None = None) -> list[Availability]:
+        """Остаток, резерв и доступное количество по каждой задействованной позиции."""
+        keys = {(wh, sku) for wh, sku, _ in self._store.positions()}
+        for reservation in self._reservations.values():
+            if self._status(reservation) is ReservationStatus.ACTIVE:
+                keys.update((line.warehouse, line.sku) for line in reservation.lines)
+        result = []
+        for wh, sku in sorted(keys):
+            if warehouse is not None and wh != warehouse:
+                continue
+            on_hand = self._store.get_qty(wh, sku)
+            reserved = self._reserved(wh, sku)
+            if on_hand == 0 and reserved == 0:
+                continue
+            result.append(
+                Availability(
+                    warehouse=wh,
+                    sku=sku,
+                    on_hand=on_hand,
+                    reserved=reserved,
+                    available=max(0, on_hand - reserved),
+                )
+            )
+        return result
+
+    def sweep_expired(self) -> list[str]:
+        """Пишет ``RESERVE_EXPIRE`` по истёкшим резервам, о которых ещё не писали.
+
+        Статусы и остатки не меняются. Возвращает ``order_id`` по expires_at, order_id.
+        """
+        now = self._clock.now()
+        pending = [
+            r
+            for r in [*self._retired, *self._reservations.values()]
+            if self._status(r) is ReservationStatus.EXPIRED
+            and (r.order_id, r.created_at) not in self._expire_reported
+        ]
+        pending.sort(key=lambda r: (r.expires_at, r.order_id))
+        for r in pending:
+            self._log.append(
+                now, "RESERVE_EXPIRE", order=r.order_id, expires=format_timestamp(r.expires_at)
+            )
+            self._expire_reported.add((r.order_id, r.created_at))
+        return [r.order_id for r in pending]
+
     def get_reservation(self, order_id: str) -> Reservation:
         reservation = self._get(order_id)
         return replace(reservation, status=self._status(reservation))
