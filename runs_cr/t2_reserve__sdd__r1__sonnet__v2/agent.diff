+    def reservations(self, status: ReservationStatus | None = None) -> list[Reservation]:
+        """Снимки резервов по ``(created_at, order_id)``, опционально по статусу."""
+        now = self._clock.now()
+        snapshots = [self._snapshot(oid, rec, now) for oid, rec in self._store.reservation_items()]
+        if status is not None:
+            snapshots = [snap for snap in snapshots if snap.status == status]
+        return sorted(snapshots, key=lambda snap: (snap.created_at, snap.order_id))
+
+    def availability(self, warehouse: str | None = None) -> list[Availability]:
+        """Остаток, резерв и доступное по позициям с остатком или активным резервом."""
+        now = self._clock.now()
+        keys = {(wh, sku) for wh, sku, _ in self._store.positions()}
+        for _, record in self._store.reservation_items():
+            if record.status_at(now) is ReservationStatus.ACTIVE:
+                keys.update((line.warehouse, line.sku) for line in record.lines)
+        result: list[Availability] = []
+        for wh, sku in sorted(keys):
+            if warehouse is not None and wh != warehouse:
+                continue
+            result.append(
+                Availability(
+                    warehouse=wh,
+                    sku=sku,
+                    on_hand=self._store.get_qty(wh, sku),
+                    reserved=self._store.reserved_qty(wh, sku, now),
+                    available=self._available(wh, sku, now),
+                )
+            )
+        return result
+
