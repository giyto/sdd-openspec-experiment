diff --git a/tests/test_reservations_followups.py b/tests/test_reservations_followups.py
new file mode 100644
index 0000000..ed9cc54
--- /dev/null
+++ b/tests/test_reservations_followups.py
@@ -0,0 +1,363 @@
+import dataclasses
+from datetime import timedelta
+
+import pytest
+
+import warehouse
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    ReservationExpiredError,
+    ValidationError,
+)
+from warehouse.models import Availability, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL, MAX_RESERVATION_LIFETIME
+
+from conftest import T0
+
+MIN = timedelta(minutes=1)
+HOUR = timedelta(hours=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "BOLT-M8", 5)
+    inv.receive("MAIN", "NUT-M8", 10)
+    return inv
+
+
+def kinds(inv):
+    return [e.kind for e in inv.log.events()]
+
+
+# --- константы и модель -------------------------------------------------------
+
+
+def test_constants_and_exports():
+    assert DEFAULT_RESERVATION_TTL == 20 * MIN
+    assert MAX_RESERVATION_LIFETIME == 2 * HOUR
+    assert warehouse.MAX_RESERVATION_LIFETIME == MAX_RESERVATION_LIFETIME
+    assert warehouse.Availability is Availability
+    assert "Availability" in warehouse.__all__
+    assert "MAX_RESERVATION_LIFETIME" in warehouse.__all__
+
+
+def test_availability_is_frozen():
+    row = Availability("MAIN", "BOLT-M8", 1, 0, 1)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        row.on_hand = 2
+
+
+# --- TTL и предел ---------------------------------------------------------------
+
+
+def test_default_ttl_is_20_minutes(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert res.expires_at == T0 + 20 * MIN
+
+
+def test_ttl_exactly_at_limit_ok(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)], ttl=2 * HOUR)
+    assert res.expires_at == T0 + 2 * HOUR
+
+
+def test_ttl_over_limit_rejected_and_old_reservation_kept(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    before = len(stocked.log)
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)], ttl=2 * HOUR + timedelta(seconds=1))
+    assert len(stocked.log) == before
+    res = stocked.get_reservation("SO-1")
+    assert res.lines[0].qty == 4
+    assert res.status is ReservationStatus.ACTIVE
+
+
+def test_ttl_over_limit_rejected_without_reservation(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)], ttl=3 * HOUR)
+    assert stocked.reservations() == []
+
+
+# --- extend ---------------------------------------------------------------------
+
+
+def test_extend_capped_at_limit(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(10 * MIN)
+    res = stocked.extend("SO-1", ttl=5 * HOUR)
+    assert res.expires_at == T0 + 2 * HOUR
+    event = stocked.log.events("RESERVE_EXTEND")[-1]
+    assert event.get("expires") == "2026-03-01T12:00:00Z"
+
+
+def test_extend_at_limit_is_noop(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)], ttl=2 * HOUR)
+    clock.advance(10 * MIN)
+    before = len(stocked.log)
+    res = stocked.extend("SO-1", ttl=5 * HOUR)
+    assert res.expires_at == T0 + 2 * HOUR
+    assert len(stocked.log) == before
+
+
+def test_extend_normal_and_no_shortening(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(15 * MIN)
+    res = stocked.extend("SO-1", ttl=30 * MIN)
+    assert res.expires_at == T0 + 45 * MIN
+    before = len(stocked.log)
+    stocked.extend("SO-1", ttl=MIN)
+    assert len(stocked.log) == before
+
+
+def test_extend_expired_raises(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(20 * MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-1")
+
+
+def test_limit_counts_from_replacement(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(30 * MIN)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    res = stocked.extend("SO-1", ttl=10 * HOUR)
+    assert res.expires_at == T0 + 30 * MIN + 2 * HOUR
+
+
+# --- замена резерва -------------------------------------------------------------
+
+
+def test_replace_active(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(5 * MIN)
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 7)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0 + 5 * MIN
+    assert res.expires_at == T0 + 25 * MIN
+    assert stocked.reserved("MAIN", "BOLT-M8") == 7
+    assert stocked.available("MAIN", "BOLT-M8") == 3
+    assert len(stocked.reservations()) == 1
+
+
+def test_replace_may_use_own_stock(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert stocked.available("MAIN", "BOLT-M8") == 6
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    assert res.status is ReservationStatus.ACTIVE
+
+
+def test_replace_counts_other_orders(stocked):
+    stocked.reserve("A", [("MAIN", "BOLT-M8", 4)])
+    stocked.reserve("B", [("MAIN", "BOLT-M8", 5)])
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("A", [("MAIN", "BOLT-M8", 6)])
+    assert exc.value.requested == 6 and exc.value.available == 5
+    assert len(stocked.log) == before
+    assert stocked.get_reservation("A").lines[0].qty == 4
+
+
+def test_replace_confirmed_rejected_even_after_expiry(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.confirm("SO-1")
+    clock.advance(3 * HOUR)
+    with pytest.raises(DuplicateReservationError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert exc.value.order_id == "SO-1"
+
+
+def test_replace_expired_and_cancelled_no_cancel_event(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(20 * MIN)
+    before = len(stocked.log)
+    stocked.reserve("SO-1", [("MAIN", "NUT-M8", 2)])
+    assert [e.kind for e in stocked.log.events()][before:] == ["RESERVE"]
+    stocked.cancel("SO-1")
+    before = len(stocked.log)
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert res.lines[0].sku == "BOLT-M8"
+    assert [e.kind for e in stocked.log.events()][before:] == ["RESERVE"]
+
+
+def test_replace_events(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    before = len(stocked.log)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("NORTH", "BOLT-M8", 2)])
+    assert kinds(stocked)[before:] == ["RESERVE_CANCEL", "RESERVE", "RESERVE"]
+
+
+# --- возврат --------------------------------------------------------------------
+
+
+def test_cancel_confirmed_returns_stock(stocked, clock):
+    stocked.reserve(
+        "SO-1", [("MAIN", "BOLT-M8", 2), ("NORTH", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 1)]
+    )
+    stocked.confirm("SO-1")
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 7
+    before = len(stocked.log)
+    res = stocked.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.on_hand("NORTH", "BOLT-M8") == 5
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    new = stocked.log.events()[before:]
+    assert [e.kind for e in new] == ["RECEIVE", "RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+    assert all(e.get("ref") == "SO-1" for e in new[:3])
+    assert [e.get("wh") for e in new[:3]] == ["MAIN", "NORTH", "MAIN"]
+
+
+def test_return_after_expiry_and_idempotent(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.confirm("SO-1")
+    clock.advance(3 * HOUR)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    before = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert len(stocked.log) == before
+
+
+def test_reserve_again_after_return(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-1")
+    assert stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)]).status is ReservationStatus.ACTIVE
+
+
+# --- reservations ---------------------------------------------------------------
+
+
+def test_reservations_empty(stocked):
+    assert stocked.reservations() == []
+
+
+def test_reservations_order(stocked, clock):
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(MIN)
+    stocked.reserve("SO-0", [("MAIN", "BOLT-M8", 1)])
+    assert [r.order_id for r in stocked.reservations()] == ["SO-1", "SO-2", "SO-0"]
+
+
+def test_reservations_status_filter(stocked, clock):
+    stocked.reserve("OLD", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    stocked.reserve("CONF", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("CONF")
+    clock.advance(10 * MIN)
+    stocked.reserve("LIVE", [("MAIN", "BOLT-M8", 1)])
+    before = len(stocked.log)
+    assert [r.order_id for r in stocked.reservations(ReservationStatus.EXPIRED)] == ["OLD"]
+    assert [r.order_id for r in stocked.reservations(ReservationStatus.ACTIVE)] == ["LIVE"]
+    assert [r.order_id for r in stocked.reservations(ReservationStatus.CONFIRMED)] == ["CONF"]
+    assert len(stocked.reservations()) == 3
+    assert len(stocked.log) == before
+
+
+# --- availability ---------------------------------------------------------------
+
+
+def test_availability_rows(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    rows = stocked.availability()
+    assert [(r.warehouse, r.sku) for r in rows] == [
+        ("MAIN", "BOLT-M8"),
+        ("MAIN", "NUT-M8"),
+        ("NORTH", "BOLT-M8"),
+    ]
+    assert rows[0] == Availability("MAIN", "BOLT-M8", 10, 4, 6)
+    assert [r.sku for r in stocked.availability("MAIN")] == ["BOLT-M8", "NUT-M8"]
+    assert stocked.availability("NOWHERE") == []
+
+
+def test_availability_reserve_only_position(stocked):
+    stocked.reserve("SO-1", [("MAIN", "NUT-M8", 3)])
+    stocked.adjust("MAIN", "NUT-M8", 0, "count")
+    row = [r for r in stocked.availability("MAIN") if r.sku == "NUT-M8"]
+    assert row == [Availability("MAIN", "NUT-M8", 0, 3, 0)]
+
+
+def test_availability_no_row_without_stock_or_active_reserve(stocked, clock):
+    stocked.receive("MAIN", "OIL-5L", 2)
+    stocked.reserve("SO-1", [("MAIN", "OIL-5L", 2)], ttl=5 * MIN)
+    stocked.adjust("MAIN", "OIL-5L", 0, "count")
+    assert any(r.sku == "OIL-5L" for r in stocked.availability())
+    clock.advance(5 * MIN)
+    assert not any(r.sku == "OIL-5L" for r in stocked.availability())
+
+
+# --- sweep_expired --------------------------------------------------------------
+
+
+def test_sweep_order_and_repeat(stocked, clock):
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=15 * MIN)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=15 * MIN)
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)], ttl=10 * MIN)
+    clock.advance(20 * MIN)
+    before = len(stocked.log)
+    assert stocked.sweep_expired() == ["SO-3", "SO-1", "SO-2"]
+    new = stocked.log.events()[before:]
+    assert [e.kind for e in new] == ["RESERVE_EXPIRE"] * 3
+    assert [e.get("order") for e in new] == ["SO-3", "SO-1", "SO-2"]
+    assert [e.get("expires") for e in new] == [
+        "2026-03-01T10:10:00Z",
+        "2026-03-01T10:15:00Z",
+        "2026-03-01T10:15:00Z",
+    ]
+    assert stocked.sweep_expired() == []
+    assert len(stocked.log) == before + 3
+
+
+def test_sweep_skips_active_confirmed_cancelled(stocked, clock):
+    stocked.reserve("ACT", [("MAIN", "BOLT-M8", 1)], ttl=2 * HOUR)
+    stocked.reserve("CONF", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    stocked.confirm("CONF")
+    stocked.reserve("CAN", [("MAIN", "BOLT-M8", 1)], ttl=5 * MIN)
+    stocked.cancel("CAN")
+    clock.advance(10 * MIN)
+    before = len(stocked.log)
+    assert stocked.sweep_expired() == []
+    assert len(stocked.log) == before
+
+
+def test_sweep_not_before_expiry(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(20 * MIN - timedelta(microseconds=1))
+    assert stocked.sweep_expired() == []
+    clock.advance(timedelta(microseconds=1))
+    assert stocked.sweep_expired() == ["SO-1"]
+
+
+def test_sweep_reserved_again(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(20 * MIN)
+    assert stocked.sweep_expired() == ["SO-1"]
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert stocked.sweep_expired() == []
+    clock.advance(20 * MIN)
+    before = len(stocked.log)
+    assert stocked.sweep_expired() == ["SO-1"]
+    assert len(stocked.log) == before + 1
+
+
+def test_sweep_does_not_change_state(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(20 * MIN)
+    stocked.sweep_expired()
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+
+
+def test_expiry_not_logged_without_sweep(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(30 * MIN)
+    before = len(stocked.log)
+    stocked.get_reservation("SO-1")
+    stocked.cancel("SO-1")
+    stocked.available("MAIN", "BOLT-M8")
+    stocked.reservations()
+    assert len(stocked.log) == before
