diff --git a/tests/test_promo_autumn.py b/tests/test_promo_autumn.py
new file mode 100644
index 0000000..4e56de0
--- /dev/null
+++ b/tests/test_promo_autumn.py
@@ -0,0 +1,78 @@
+from datetime import timedelta
+from decimal import Decimal as D
+
+import pytest
+
+from shop import (
+    Cart, DiscountKind, OrderService, PromoCode, PromoRegistry, ValidationError,
+)
+from shop.errors import PromoConditionsError
+
+
+def _service(clock, *promos):
+    reg = PromoRegistry(clock)
+    for p in promos:
+        reg.add(p)
+    return OrderService(clock=clock, promos=reg), reg
+
+
+def _cart(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def test_validation():
+    with pytest.raises(ValidationError):
+        PromoCode("A", DiscountKind.FREE_SHIPPING, D("1"))
+    with pytest.raises(ValidationError):
+        PromoCode("A", DiscountKind.FIXED, D("10"), max_discount=D("5"))
+    with pytest.raises(ValidationError):
+        PromoCode("A", DiscountKind.PERCENT, D("10"), max_discount=D("0"))
+    with pytest.raises(ValidationError):
+        PromoCode("A", DiscountKind.PERCENT, D("10"), max_uses_per_customer=0)
+
+
+def test_free_shipping_and_threshold(clock, products):
+    svc, _ = _service(clock, PromoCode("FS", DiscountKind.FREE_SHIPPING, D("0")))
+    t = svc.quote(_cart((products["shirt"], 1)), "fs")
+    assert t.shipping == D("0.00") and t.shipping_discount == D("299.00") and t.discount == 0
+    t = svc.quote(_cart((products["phone"], 2)), "fs")
+    assert t.shipping_discount == D("0.00")
+
+
+def test_caps(clock, products):
+    svc, _ = _service(
+        clock,
+        PromoCode("P", DiscountKind.PERCENT, D("50"), max_discount=D("100")),
+        PromoCode("F", DiscountKind.FIXED, D("5000")),
+    )
+    cart = _cart((products["shirt"], 1))
+    assert svc.quote(cart, "p").discount == D("100.00")
+    assert svc.quote(cart, "f").discount == D("499.50")
+
+
+def test_threshold_before_discount(clock, products):
+    svc, _ = _service(clock, PromoCode("P", DiscountKind.PERCENT, D("50")))
+    assert svc.quote(_cart((products["phone"], 2)), "p").shipping == D("0.00")
+
+
+def test_per_customer_and_refund_window(clock, products):
+    svc, reg = _service(
+        clock, PromoCode("C", DiscountKind.PERCENT, D("10"), max_uses_per_customer=1)
+    )
+    cart = _cart((products["shirt"], 1))
+    with pytest.raises(PromoConditionsError):
+        svc.quote(cart, "c")
+    o = svc.place_order(cart, "c", customer_id="u1")
+    assert o.customer_id == "u1" and reg.uses("c", "u1") == 1
+    with pytest.raises(PromoConditionsError):
+        svc.quote(cart, "c", customer_id="u1")
+    clock.advance(timedelta(hours=24))
+    svc.cancel(o.order_id)
+    assert reg.uses("c") == 1 and reg.uses("c", "u1") == 1
+    o2 = svc.place_order(cart, "c", customer_id="u2")
+    clock.advance(timedelta(hours=23, minutes=59))
+    svc.cancel(o2.order_id)
+    assert reg.uses("c", "u2") == 0
