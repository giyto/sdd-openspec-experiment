--- /dev/null
+++ b/tests/test_reservations_rework.py
@@ -0,0 +1,236 @@
+from datetime import timedelta
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    ValidationError,
+)
+from warehouse.models import Availability, ReservationLine, ReservationStatus
+from warehouse.reservations import DEFAULT_RESERVATION_TTL, MAX_RESERVATION_LIFETIME
+
+
+def test_max_lifetime_is_two_hours():
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+
+
+def test_reserve_ttl_at_limit_is_allowed_and_above_is_rejected(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 2)
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    assert res.expires_at == clock.now() + MAX_RESERVATION_LIFETIME
+    too_long = MAX_RESERVATION_LIFETIME + timedelta(seconds=1)
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=too_long)
+    assert len(inv.log.events("RESERVE")) == 1
+
+
+def test_extend_is_capped_at_lifetime_limit(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    created = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    clock.advance(timedelta(minutes=10))
+    res = inv.extend("SO-1", timedelta(hours=5))
+    assert res.expires_at == created.created_at + MAX_RESERVATION_LIFETIME
+    assert inv.get_reservation("SO-1").expires_at == created.created_at + MAX_RESERVATION_LIFETIME
+    assert inv.log.events("RESERVE_EXTEND")[0].fields["expires"] == "2026-03-01T12:00:00Z"
+
+
+def test_extend_at_limit_does_not_move_expiry_past_cap(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    created = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)], ttl=MAX_RESERVATION_LIFETIME)
+    clock.advance(timedelta(hours=1))
+    before = len(inv.log)
+    res = inv.extend("SO-1", timedelta(hours=1))
+    assert res.expires_at == created.expires_at
+    assert len(inv.log) == before
+
+
+def test_reserve_replaces_active_reservation(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    clock.advance(timedelta(minutes=10))
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + DEFAULT_RESERVATION_TTL
+    assert res.lines == (ReservationLine("MAIN", "BOLT-M8", 3),)
+    assert inv.reserved("MAIN", "BOLT-M8") == 3
+    assert inv.available("MAIN", "BOLT-M8") == 2
+
+
+def test_replace_writes_cancel_then_reserve(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    before = len(inv.log)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("MAIN", "BOLT-M8", 2)])
+    new_events = inv.log.lines()[before:]
+    assert [line.split(" ")[2] for line in new_events] == [
+        "RESERVE_CANCEL",
+        "RESERVE",
+        "RESERVE",
+    ]
+    assert new_events[0].endswith("order=SO-1")
+
+
+def test_replace_counts_old_lines_as_free(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    res = inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    assert res.lines == (ReservationLine("MAIN", "BOLT-M8", 5),)
+
+
+def test_failed_replace_changes_nothing(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    before = len(inv.log)
+    with pytest.raises(InsufficientStockError) as info:
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 6)])
+    assert (info.value.requested, info.value.available) == (6, 5)
+    assert inv.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    assert inv.get_reservation("SO-1").lines == (ReservationLine("MAIN", "BOLT-M8", 3),)
+    assert len(inv.log) == before
+
+
+def test_replace_confirmed_is_still_forbidden(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    before = len(inv.log)
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert len(inv.log) == before
+
+
+def test_cancel_confirmed_returns_stock_to_same_warehouses(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("NORTH", "NUT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("NORTH", "NUT-M8", 1), ("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-1")
+    before = len(inv.log)
+    res = inv.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 5
+    assert inv.on_hand("NORTH", "NUT-M8") == 5
+    new_events = inv.log.lines()[before:]
+    assert [line.split(" ")[2] for line in new_events] == [
+        "RECEIVE",
+        "RECEIVE",
+        "RECEIVE",
+        "RESERVE_CANCEL",
+    ]
+    receives = inv.log.events("RECEIVE")[-3:]
+    assert [(e.fields["wh"], e.fields["sku"], e.fields["qty"], e.fields["ref"]) for e in receives] == [
+        ("MAIN", "BOLT-M8", "2", "SO-1"),
+        ("NORTH", "NUT-M8", "1", "SO-1"),
+        ("MAIN", "BOLT-M8", "1", "SO-1"),
+    ]
+
+
+def test_cancel_confirmed_is_idempotent(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    inv.confirm("SO-1")
+    inv.cancel("SO-1")
+    before = len(inv.log)
+    assert inv.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 5
+    assert len(inv.log) == before
+
+
+def test_availability_rows_cover_stock_and_active_reserves(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("NORTH", "NUT-M8", 3)
+    inv.receive("NORTH", "OIL-5L", 1)
+    inv.reserve("SO-1", [("NORTH", "NUT-M8", 2)])
+    inv.adjust("MAIN", "BOLT-M8", 0, "recount")
+    inv.reserve("SO-2", [("NORTH", "OIL-5L", 1)])
+    assert inv.availability() == [
+        Availability("NORTH", "NUT-M8", on_hand=3, reserved=2, available=1),
+        Availability("NORTH", "OIL-5L", on_hand=1, reserved=1, available=0),
+    ]
+    assert inv.availability("MAIN") == []
+
+
+def test_availability_includes_reserved_position_with_zero_stock(inv):
+    inv.receive("MAIN", "BOLT-M8", 2)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    inv.adjust("MAIN", "BOLT-M8", 0, "recount")
+    assert inv.availability("MAIN") == [
+        Availability("MAIN", "BOLT-M8", on_hand=0, reserved=2, available=0),
+    ]
+
+
+def test_reservations_snapshots_sorted_and_filtered_by_status(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=1))
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    inv.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    assert [r.order_id for r in inv.reservations()] == ["SO-2", "SO-1", "SO-3"]
+    expired = inv.reservations(ReservationStatus.EXPIRED)
+    assert [r.order_id for r in expired] == ["SO-2", "SO-1"]
+    assert all(r.status is ReservationStatus.EXPIRED for r in expired)
+    assert [r.order_id for r in inv.reservations(ReservationStatus.ACTIVE)] == ["SO-3"]
+    assert inv.reservations(ReservationStatus.CONFIRMED) == []
+
+
+def test_sweep_writes_expire_once_in_expiry_order(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=1))
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert inv.sweep_expired() == ["SO-2", "SO-1"]
+    expire = inv.log.events("RESERVE_EXPIRE")
+    assert [(e.fields["order"], e.fields["expires"]) for e in expire] == [
+        ("SO-2", "2026-03-01T10:20:00Z"),
+        ("SO-1", "2026-03-01T10:21:00Z"),
+    ]
+    assert inv.sweep_expired() == []
+    assert len(inv.log.events("RESERVE_EXPIRE")) == 2
+
+
+def test_sweep_changes_no_status_or_stock(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 5)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    before_stock = inv.on_hand("MAIN", "BOLT-M8")
+    inv.sweep_expired()
+    assert inv.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert inv.on_hand("MAIN", "BOLT-M8") == before_stock
+    assert inv.available("MAIN", "BOLT-M8") == 5
+
+
+def test_sweep_ignores_active_and_finished(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-2")
+    inv.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    inv.cancel("SO-3")
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    inv.cancel("SO-1")
+    assert inv.sweep_expired() == ["SO-1"]
+
+
+def test_sweep_reports_replaced_expired_reservation(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert inv.sweep_expired() == ["SO-1", "SO-1"]
+    assert len(inv.log.events("RESERVE_EXPIRE")) == 2
+
+
+def test_sweep_writes_new_expiry_of_same_order_once(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert inv.sweep_expired() == ["SO-1"]
+    inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    assert inv.sweep_expired() == []
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    assert inv.sweep_expired() == ["SO-1"]
+    assert len(inv.log.events("RESERVE_EXPIRE")) == 2
