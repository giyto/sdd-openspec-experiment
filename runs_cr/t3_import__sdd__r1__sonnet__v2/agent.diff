+def test_dry_run_matches_real_import(write_csv, clock):
+    store = MemoryStore()
+    import_statement(write_csv(_file(["02.03.2026;-2,00;B"])), store, clock=clock)
+    path = write_csv(_file(["01.03.2026;-1,00;A", "02.03.2026;-2,00;B", "x;1;a"]), name="b.csv")
+    preview = import_statement(path, store, clock=clock, dry_run=True)
+    assert len(store.all()) == 1
+    assert [t.id for t in preview.transactions] == [None]
+    real = import_statement(path, store, clock=clock)
+    assert (preview.added, preview.duplicates, preview.errors) == (real.added, real.duplicates, real.errors)
+    assert [replace_id(t) for t in preview.transactions] == [replace_id(t) for t in real.transactions]
+
+
+def replace_id(tx):
+    import dataclasses
+
+    return dataclasses.replace(tx, id=None)
+
+
+def test_dry_run_json_store_not_created(write_csv, tmp_path):
+    db = tmp_path / "db.json"
+    res = import_statement(write_csv(_file(["01.03.2026;-1,00;A"])), JsonFileStore(db), dry_run=True)
+    assert res.added == 1 and res.transactions and all(t.id is None for t in res.transactions)
+    assert not db.exists()
