+    import_statement(write_csv(_file(["02.03.2026;-2,00;B"])), store)
+    res = import_statement(
+        write_csv(_file(["01.03.2026;-1,00;A", "02.03.2026;-2,00;B", "03.03.2026;-3,00;C"]), name="b.csv"),
+        store,
+    )
+    assert (res.added, res.duplicates) == (2, 1)
+    assert [t.description for t in res.transactions] == ["A", "C"]
+    assert res.transactions == store.all()[1:]
