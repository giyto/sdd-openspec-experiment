diff --git a/tests/test_promo_autumn.py b/tests/test_promo_autumn.py
new file mode 100644
index 0000000..ca17b1e
--- /dev/null
+++ b/tests/test_promo_autumn.py
@@ -0,0 +1,238 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError, ValidationError
+from shop.orders import OrderService, OrderStatus
+from shop.pricing import calculate_total
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+
+def percent(value="10", **kwargs):
+    return PromoCode("AUTUMN", DiscountKind.PERCENT, Decimal(value), **kwargs)
+
+
+def fixed(value, **kwargs):
+    return PromoCode("AUTUMN", DiscountKind.FIXED, Decimal(value), **kwargs)
+
+
+def free_shipping(**kwargs):
+    return PromoCode("FREESHIP", DiscountKind.FREE_SHIPPING, Decimal("0"), **kwargs)
+
+
+# --- validation of new fields -------------------------------------------------
+
+def test_free_shipping_value_must_be_zero():
+    with pytest.raises(ValidationError):
+        PromoCode("FREESHIP", DiscountKind.FREE_SHIPPING, Decimal("10"))
+    assert free_shipping().value == Decimal("0")
+
+
+@pytest.mark.parametrize("max_discount", [Decimal("0"), Decimal("-1"), Decimal("10.001")])
+def test_max_discount_must_be_positive_money(max_discount):
+    with pytest.raises(ValidationError):
+        percent(max_discount=max_discount)
+
+
+def test_max_discount_is_only_for_percent_codes():
+    with pytest.raises(ValidationError):
+        fixed("100.00", max_discount=Decimal("50.00"))
+    with pytest.raises(ValidationError):
+        free_shipping(max_discount=Decimal("50.00"))
+
+
+@pytest.mark.parametrize("limit", [0, -1, True, 1.5])
+def test_max_uses_per_customer_must_be_positive_int(limit):
+    with pytest.raises(ValidationError):
+        percent(max_uses_per_customer=limit)
+
+
+def test_new_fields_default_to_no_restriction():
+    promo = percent()
+    assert promo.max_discount is None
+    assert promo.max_uses_per_customer is None
+
+
+# --- threshold and fixed cap --------------------------------------------------
+
+def test_free_shipping_threshold_is_compared_before_discount(products):
+    cart = Cart()
+    cart.add(products["phone"])
+    cart.add(products["book"])
+    cart.add(products["tea"])  # 3149.90 before discount
+    total = calculate_total(cart, promo=fixed("200.00"))
+    assert total.shipping == Decimal("0.00")
+
+
+def test_fixed_discount_is_capped_at_half_of_participating_goods_rounded(products):
+    cart = Cart()
+    cart.add(Product("ODD-1", "Odd", Decimal("333.33"), Category.ELECTRONICS))
+    # 333.33 * 50 % = 166.665 -> 166.67 (ROUND_HALF_UP)
+    total = calculate_total(cart, promo=fixed("300.00"))
+    assert total.discount == Decimal("166.67")
+    assert total.total == total.subtotal - total.discount + total.shipping + total.tax
+
+
+def test_fixed_discount_cap_ignores_gift_cards(products):
+    cart = Cart()
+    cart.add(products["book"])   # 450.00 participates -> cap 225.00
+    cart.add(products["gift"])   # 1000.00 does not count
+    assert calculate_total(cart, promo=fixed("400.00")).discount == Decimal("225.00")
+
+
+# --- percent cap -------------------------------------------------------------
+
+def test_percent_discount_is_capped_by_max_discount(products):
+    cart = Cart()
+    cart.add(products["phone"])  # 10 % would be 250.00
+    total = calculate_total(cart, promo=percent("10", max_discount=Decimal("100.00")))
+    assert total.discount == Decimal("100.00")
+    assert total.lines[0].tax == Decimal("480.00")  # (2500.00 - 100.00) * 20 %
+
+
+def test_max_discount_above_percent_has_no_effect(products):
+    cart = Cart()
+    cart.add(products["phone"])
+    total = calculate_total(cart, promo=percent("10", max_discount=Decimal("5000.00")))
+    assert total.discount == Decimal("250.00")
+
+
+# --- split tie-break -------------------------------------------------------------
+
+def test_leftover_kopeck_goes_to_larger_line_on_equal_remainders():
+    # kopecks: 100 and 300 of 400 with a 2-kopeck discount -> equal remainders 200,
+    # the leftover kopeck goes to the larger line (3.00), not to the earlier one (1.00)
+    cart = Cart()
+    cart.add(Product("LOW-1", "Low", Decimal("1.00"), Category.CLOTHING))
+    cart.add(Product("HIGH-1", "High", Decimal("3.00"), Category.CLOTHING))
+    total = calculate_total(cart, promo=fixed("0.02"))
+    assert [line.discount for line in total.lines] == [Decimal("0.00"), Decimal("0.02")]
+
+
+# --- free shipping code -----------------------------------------------------
+
+def test_free_shipping_waives_fee_and_reports_saving(products):
+    cart = Cart()
+    cart.add(products["book"])  # 450.00, shipping 299.00
+    total = calculate_total(cart, promo=free_shipping())
+    assert total.discount == Decimal("0.00")
+    assert all(line.discount == Decimal("0.00") for line in total.lines)
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("299.00")
+    assert total.tax == Decimal("45.00")
+    assert total.total == Decimal("495.00")
+
+
+def test_shipping_discount_is_zero_when_nothing_to_save(products):
+    cart = Cart()
+    cart.add(products["phone"])
+    cart.add(products["tea"])
+    cart.add(products["book"])  # 3149.90 -> free shipping without a promo
+    total = calculate_total(cart, promo=free_shipping())
+    assert total.shipping == Decimal("0.00")
+    assert total.shipping_discount == Decimal("0.00")
+
