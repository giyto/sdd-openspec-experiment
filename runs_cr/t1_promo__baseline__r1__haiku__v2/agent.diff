+# --- return of use on cancel: 24 hours -----------------------------------------
+
+@pytest.fixture
+def limited_registry(clock):
+    promos = PromoRegistry(clock)
+    promos.add(PromoCode("LIMITED", DiscountKind.PERCENT, Decimal("10"), max_uses=1))
+    return promos
+
+
+def test_cancel_just_before_24_hours_returns_use(products, clock, limited_registry):
+    service = OrderService(clock=clock, promos=limited_registry)
+    cart = Cart()
+    cart.add(products["phone"])
+    order = service.place_order(cart, "LIMITED")
+    clock.advance(timedelta(hours=24) - timedelta(seconds=1))
+    assert service.cancel(order.order_id).status is OrderStatus.CANCELLED
+    assert limited_registry.uses("LIMITED") == 0
+
+
+def test_cancel_exactly_24_hours_later_burns_use(products, clock, limited_registry):
+    service = OrderService(clock=clock, promos=limited_registry)
+    cart = Cart()
+    cart.add(products["phone"])
+    order = service.place_order(cart, "LIMITED")
+    clock.advance(timedelta(hours=24))
+    service.cancel(order.order_id)
+    assert limited_registry.uses("LIMITED") == 1
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "LIMITED")
+
+
+def test_cancel_after_24_hours_burns_customer_use(products, clock, customer_registry):
+    service = OrderService(clock=clock, promos=customer_registry)
+    cart = Cart()
+    cart.add(products["book"])
+    order = service.place_order(cart, "ONCE", customer_id="u-1")
+    clock.advance(timedelta(days=2))
+    service.cancel(order.order_id)
+    assert customer_registry.uses("ONCE") == 1
+    assert customer_registry.uses("ONCE", "u-1") == 1
