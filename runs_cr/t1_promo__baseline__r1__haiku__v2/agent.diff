+# --- per-customer limit -----------------------------------------------------
+
+@pytest.fixture
+def customer_registry(clock):
+    promos = PromoRegistry(clock)
+    promos.add(PromoCode("ONCE", DiscountKind.FIXED, Decimal("100.00"), max_uses_per_customer=1))
+    return promos
+
+
+def test_per_customer_code_needs_customer_id(products, clock, customer_registry):
+    service = OrderService(clock=clock, promos=customer_registry)
+    cart = Cart()
+    cart.add(products["book"])
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "ONCE")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "ONCE")
+    assert len(service.store) == 0
+
+
+def test_per_customer_limit_is_separate_for_each_customer(products, clock, customer_registry):
+    service = OrderService(clock=clock, promos=customer_registry)
+    cart = Cart()
+    cart.add(products["book"])
+    first = service.place_order(cart, "ONCE", customer_id="u-1")
+    assert first.customer_id == "u-1"
+    assert first.promo_code == "ONCE"
+
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "ONCE", customer_id="u-1")
+    assert service.quote(cart, "ONCE", customer_id="u-2").discount == Decimal("100.00")
+
+    service.place_order(cart, "ONCE", customer_id="u-2")
+    assert customer_registry.uses("ONCE") == 2
+    assert customer_registry.uses("ONCE", "u-1") == 1
+    assert customer_registry.uses("ONCE", "u-2") == 1
+
+
+def test_customer_id_is_compared_as_is(customer_registry):
+    customer_registry.record_use("ONCE", "U-1")
+    assert customer_registry.uses("ONCE", "U-1") == 1
+    assert customer_registry.uses("ONCE", "u-1") == 0
+
+
+def test_customer_limit_is_returned_on_cancel_within_window(products, clock, customer_registry):
+    service = OrderService(clock=clock, promos=customer_registry)
+    cart = Cart()
+    cart.add(products["book"])
+    order = service.place_order(cart, "ONCE", customer_id="u-1")
+    service.cancel(order.order_id)
+    assert customer_registry.uses("ONCE", "u-1") == 0
+    assert service.place_order(cart, "ONCE", customer_id="u-1").customer_id == "u-1"
+
