+def test_dry_run(write_csv, clock, tmp_path):
+    cat = Categorizer([Rule("кофейня", "cafe")])
+    path = write_csv(SFERA)
+    store = JsonFileStore(tmp_path / "db.json")
+    preview = import_statement(path, store, categorizer=cat, clock=clock, dry_run=True)
+    assert store.all() == [] and not (tmp_path / "db.json").exists()
+    assert preview.added == 3 and len(preview.transactions) == 3
+    assert all(t.id is None for t in preview.transactions)
+    assert preview.transactions[2].category == "cafe"
+    assert all(t.imported_at == clock.now() for t in preview.transactions)
+    real = import_statement(path, store, categorizer=cat, clock=clock)
+    assert (real.added, real.duplicates, real.errors) == (preview.added, 0, preview.errors)
+    assert [dataclasses.replace(t, id=None) for t in real.transactions] == preview.transactions
