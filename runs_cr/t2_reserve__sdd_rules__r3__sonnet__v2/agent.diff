diff --git a/tests/test_reservation_improvements.py b/tests/test_reservation_improvements.py
new file mode 100644
index 0000000..35fda1c
--- /dev/null
+++ b/tests/test_reservation_improvements.py
@@ -0,0 +1,217 @@
+from datetime import timedelta
+
+import pytest
+
+from warehouse import (
+    Availability,
+    DuplicateReservationError,
+    InsufficientStockError,
+    MAX_RESERVATION_LIFETIME,
+    ReservationStatus,
+    ValidationError,
+)
+from warehouse.reservations import DEFAULT_RESERVATION_TTL
+
+MIN = timedelta(minutes=1)
+LINE = [("MAIN", "BOLT-M8", 1)]
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("NORTH", "BOLT-M8", 10)
+    return inv
+
+
+def kinds(inv):
+    return [e.kind for e in inv.log]
+
+
+# --- TTL и предел ----------------------------------------------------------------
+
+
+def test_constants():
+    assert DEFAULT_RESERVATION_TTL == 20 * MIN
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+
+
+def test_reserve_ttl_limit(stocked):
+    res = stocked.reserve("SO-1", LINE, ttl=MAX_RESERVATION_LIFETIME)
+    assert res.expires_at == res.created_at + timedelta(hours=2)
+    before = stocked.log.lines()
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-2", LINE, ttl=MAX_RESERVATION_LIFETIME + timedelta(seconds=1))
+    assert stocked.log.lines() == before
+    assert [r.order_id for r in stocked.reservations()] == ["SO-1"]
+
+
+def test_extend_capped_at_limit(stocked, clock):
+    res = stocked.reserve("SO-1", LINE)
+    clock.advance(19 * MIN)
+    stocked.extend("SO-1", timedelta(hours=3))
+    cur = stocked.get_reservation("SO-1")
+    assert cur.expires_at == res.created_at + MAX_RESERVATION_LIFETIME
+    assert kinds(stocked).count("RESERVE_EXTEND") == 1
+    clock.advance(MIN)
+    stocked.extend("SO-1", timedelta(hours=3))
+    assert stocked.get_reservation("SO-1").expires_at == cur.expires_at
+    assert kinds(stocked).count("RESERVE_EXTEND") == 1
+
+
+# --- замена ----------------------------------------------------------------------
+
+
+def test_replace_active(stocked, clock):
+    stocked.reserve("SO-1", LINE)
+    clock.advance(5 * MIN)
+    res = stocked.reserve("SO-1", [("NORTH", "BOLT-M8", 2), ("NORTH", "BOLT-M8", 3)])
+    assert res.created_at == clock.now()
+    assert res.expires_at == clock.now() + 20 * MIN
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.reserved("NORTH", "BOLT-M8") == 5
+    assert kinds(stocked)[-3:] == ["RESERVE_CANCEL", "RESERVE", "RESERVE"]
+
+
+def test_replace_counts_old_as_free(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    assert stocked.reserved("MAIN", "BOLT-M8") == 10
+
+
+def test_failed_replace_keeps_old(stocked):
+    old = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    before = stocked.log.lines()
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 11)])
+    assert stocked.get_reservation("SO-1") == old
+    assert stocked.log.lines() == before
+
+
+def test_replace_confirmed_rejected(stocked):
+    stocked.reserve("SO-1", LINE)
+    stocked.confirm("SO-1")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", LINE)
+
+
+def test_replace_expired_no_cancel_event(stocked, clock):
+    stocked.reserve("SO-1", LINE)
+    clock.advance(20 * MIN)
+    stocked.reserve("SO-1", LINE)
+    assert "RESERVE_CANCEL" not in kinds(stocked)
+
+
+# --- возврат ---------------------------------------------------------------------
+
+
+def test_cancel_confirmed_returns_goods(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("NORTH", "BOLT-M8", 2)])
+    stocked.confirm("SO-1")
+    n = len(stocked.log)
+    res = stocked.cancel("SO-1")
+    assert res.status is ReservationStatus.CANCELLED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.on_hand("NORTH", "BOLT-M8") == 10
+    new = list(stocked.log)[n:]
+    assert [e.kind for e in new] == ["RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+    assert [e.get("ref") for e in new[:2]] == ["SO-1", "SO-1"]
+    assert [e.get("wh") for e in new[:2]] == ["MAIN", "NORTH"]
+    assert new[2].get("order") == "SO-1"
+    lines = stocked.log.lines()
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.log.lines() == lines
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+
+
+def test_return_duplicate_lines(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 4)])
+    stocked.confirm("SO-1")
+    n = len(stocked.log)
+    stocked.cancel("SO-1")
+    recv = [e for e in list(stocked.log)[n:] if e.kind == "RECEIVE"]
+    assert [e.get("qty") for e in recv] == ["3", "4"]
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+
+
+# --- reservations ----------------------------------------------------------------
+
+
+def test_reservations_order_and_filter(stocked, clock):
+    stocked.reserve("SO-2", LINE)
+    stocked.reserve("SO-1", LINE)
+    clock.advance(MIN)
+    stocked.reserve("SO-0", LINE, ttl=timedelta(hours=1))
+    assert [r.order_id for r in stocked.reservations()] == ["SO-1", "SO-2", "SO-0"]
+    clock.advance(25 * MIN)
+    n = len(stocked.log)
+    exp = stocked.reservations(ReservationStatus.EXPIRED)
+    assert [r.order_id for r in exp] == ["SO-1", "SO-2"]
+    assert all(r.status is ReservationStatus.EXPIRED for r in exp)
+    assert [r.order_id for r in stocked.reservations(ReservationStatus.ACTIVE)] == ["SO-0"]
+    assert len(stocked.log) == n
+
+
+def test_reservations_empty(inv):
+    assert inv.reservations() == []
+
+
+# --- availability ----------------------------------------------------------------
+
+
+def test_availability(stocked, clock):
+    stocked.receive("MAIN", "NUT-M8", 3)
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4), ("MAIN", "NUT-M8", 3)])
+    stocked.adjust("MAIN", "NUT-M8", 0, "lost")
+    assert stocked.availability() == [
+        Availability("MAIN", "BOLT-M8", 10, 4, 6),
+        Availability("MAIN", "NUT-M8", 0, 3, 0),
+        Availability("NORTH", "BOLT-M8", 10, 0, 10),
+    ]
+    assert [a.sku for a in stocked.availability("MAIN")] == ["BOLT-M8", "NUT-M8"]
+    clock.advance(20 * MIN)
+    assert [(a.warehouse, a.sku) for a in stocked.availability()] == [
+        ("MAIN", "BOLT-M8"),
+        ("NORTH", "BOLT-M8"),
+    ]
+
+
+# --- sweep_expired ---------------------------------------------------------------
+
+
+def test_sweep_expired(stocked, clock):
+    stocked.reserve("SO-1", LINE, ttl=10 * MIN)
+    stocked.reserve("SO-3", LINE, ttl=5 * MIN)
+    stocked.reserve("SO-2", LINE, ttl=5 * MIN)
+    stocked.reserve("SO-4", LINE, ttl=5 * MIN)
+    stocked.cancel("SO-4")
+    stocked.reserve("SO-5", LINE)
+    stocked.confirm("SO-5")
+    clock.advance(30 * MIN)
+    on_hand = stocked.on_hand("MAIN", "BOLT-M8")
+    assert stocked.sweep_expired() == ["SO-2", "SO-3", "SO-1"]
+    events = stocked.log.events("RESERVE_EXPIRE")
+    assert [e.get("order") for e in events] == ["SO-2", "SO-3", "SO-1"]
+    assert all(e.get("expires") for e in events)
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == on_hand
+    n = len(stocked.log)
+    assert stocked.sweep_expired() == []
+    assert len(stocked.log) == n
+
+
+def test_sweep_after_rereserve(stocked, clock):
+    stocked.reserve("SO-1", LINE)
+    clock.advance(20 * MIN)
+    assert stocked.sweep_expired() == ["SO-1"]
+    stocked.reserve("SO-1", LINE)
+    assert stocked.sweep_expired() == []
+    clock.advance(20 * MIN)
+    assert stocked.sweep_expired() == ["SO-1"]
+    assert len(stocked.log.events("RESERVE_EXPIRE")) == 2
+
+
+def test_sweep_nothing_for_non_expired(stocked):
+    stocked.reserve("SO-1", LINE)
+    n = len(stocked.log)
+    assert stocked.sweep_expired() == []
+    assert len(stocked.log) == n
