diff --git a/tests/test_refine_retry.py b/tests/test_refine_retry.py
new file mode 100644
index 0000000..06c31ef
--- /dev/null
+++ b/tests/test_refine_retry.py
@@ -0,0 +1,228 @@
+import math
+from datetime import datetime, timedelta
+
+import pytest
+
+import jobq
+from jobq import (
+    ConfigError,
+    DeadLetterEntry,
+    DeadLetterReason,
+    HandlerRegistry,
+    JobqError,
+    JobQueue,
+    JobStatus,
+    ManualClock,
+    PermanentJobError,
+    RetryLaterError,
+    RetryPolicy,
+    Worker,
+)
+from jobq import metrics as m
+
+from .conftest import START
+
+
+class StubRng:
+    def __init__(self, value: float) -> None:
+        self.value = value
+        self.calls: list[tuple[float, float]] = []
+
+    def uniform(self, a: float, b: float) -> float:
+        self.calls.append((a, b))
+        return self.value
+
+
+def make(policy=None, *, rng=None):
+    clock = ManualClock(START)
+    queue = JobQueue(clock=clock, default_retry_policy=policy)
+    registry = HandlerRegistry()
+    return clock, queue, registry, Worker(queue, registry, rng=rng)
+
+
+def failing(exc):
+    def handler(job):
+        raise exc
+
+    return handler
+
+
+# -- модели и ошибки ----------------------------------------------------------
+
+
+def test_reason_values_and_legacy_constructor():
+    assert DeadLetterReason.EXHAUSTED.value == "exhausted"
+    assert DeadLetterReason.NON_RETRYABLE.value == "non_retryable"
+    entry = DeadLetterEntry("j", "t", 1, "e", START)
+    assert entry.reason is DeadLetterReason.EXHAUSTED
+
+
+def test_retry_later_error():
+    exc = RetryLaterError(retry_after=5)
+    assert exc.retry_after == 5
+    assert str(exc) == ""
+    assert RetryLaterError("slow", retry_after=1).args == ("slow",)
+    assert issubclass(RetryLaterError, JobqError)
+    assert jobq.RetryLaterError is RetryLaterError
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=-1)
+    with pytest.raises(ConfigError):
+        RetryLaterError(retry_after=math.nan)
+
+
+# -- джиттер ------------------------------------------------------------------
+
+
+def test_jitter_only_decreases():
+    rng = StubRng(2.0)
+    p = RetryPolicy(jitter=0.5, base_delay=10, max_delay=100)
+    assert p.delay_for(1, rng) <= 10
+    assert len(rng.calls) == 1
+    assert rng.calls == [(0.5, 1)]
+
+
+# -- очередь ------------------------------------------------------------------
+
+
+def dead_letter(q, reg, w, job_type="t", exc=RuntimeError("x")):
+    reg.register(job_type, failing(exc)) if job_type not in reg._handlers else None
+    job = q.enqueue(job_type)
+    w.run_once()
+    return job
+
+
+def test_mark_dead_lettered_reasons():
+    _, q, reg, w = make()
+    a = q.enqueue("t")
+    b = q.enqueue("t")
+    q.mark_running(a.id)
+    q.mark_dead_lettered(a.id, "e")
+    q.mark_running(b.id)
+    q.mark_dead_lettered(b.id, "e", DeadLetterReason.NON_RETRYABLE)
+    assert [e.reason for e in q.dead_letters()] == [
+        DeadLetterReason.EXHAUSTED,
+        DeadLetterReason.NON_RETRYABLE,
+    ]
+
+
+def test_purge_dead_letter_age():
+    clock, q, reg, w = make(RetryPolicy(max_attempts=1))
+    reg.register("t", failing(RuntimeError("x")))
+    q.enqueue("t")
+    clock.advance(1000)  # задание старое, но в dead-letter попадёт только сейчас
+    w.run_once()
+    assert q.purge_finished(older_than=50) == 0
+    clock.advance(100)
+    assert q.purge_finished(older_than=50) == 1
+    assert q.dead_letters() == []
+    assert q.metrics.get(m.JOBS_PURGED) == 1
+
+
+def test_purge_leaves_other_statuses():
+    clock, q, reg, w = make(RetryPolicy(max_attempts=1))
+    reg.register("t", failing(RuntimeError("x")))
+    pending = q.enqueue("t", delay=10_000)
+    q.enqueue("t")
+    w.run_once()
+    clock.advance(100)
+    assert q.purge_finished(older_than=50) == 1
+    assert pending.id in q.store
+
+
+def test_requeue_all():
+    _, q, reg, w = make(RetryPolicy(max_attempts=1))
+    assert q.requeue_all_dead_letters() == []
+    reg.register("email", failing(RuntimeError("x")))
+    reg.register("billing", failing(RuntimeError("x")))
+    a = q.enqueue("email")
+    b = q.enqueue("billing")
+    c = q.enqueue("email")
+    w.run_pending()
+    assert q.requeue_all_dead_letters("nothing") == []
+    assert q.metrics.get(m.JOBS_REQUEUED) == 0
+    assert q.requeue_all_dead_letters("email") == [a, c]
+    assert b.status is JobStatus.DEAD_LETTERED
+    assert [e.job_id for e in q.dead_letters()] == [b.id]
+    assert q.requeue_all_dead_letters() == [b]
+    for job in (a, b, c):
+        assert job.status is JobStatus.PENDING
+        assert job.attempts == 0 and job.error is None
+        assert job.run_at == q.clock.now()
+    assert q.dead_letters() == []
+    assert q.metrics.get(m.JOBS_REQUEUED) == 3
+
+
+# -- воркер -------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("exc", [PermanentJobError("no"), ValueError("no")])
+def test_non_retryable_first_attempt(exc):
+    rng = StubRng(1.0)
+    _, q, reg, w = make(RetryPolicy(max_attempts=3, jitter=0.5, non_retryable=[ValueError]), rng=rng)
+    reg.register("t", failing(exc))
+    job = q.enqueue("t")
+    assert w.run_once().status is JobStatus.DEAD_LETTERED
+    (entry,) = q.dead_letters()
+    assert entry.reason is DeadLetterReason.NON_RETRYABLE and entry.attempts == 1
+    assert q.metrics.get(m.JOBS_DEAD_LETTERED) == 1
+    assert q.metrics.get(m.JOBS_FAILED) == 0
+    assert q.metrics.get(m.JOBS_RETRIED) == 0
+    assert rng.calls == []
+    assert job.error.startswith(type(exc).__name__)
+
+
+def test_exhausted_reason():
+    clock, q, reg, w = make(RetryPolicy(max_attempts=2))
+    reg.register("t", failing(TimeoutError("x")))
+    q.enqueue("t")
+    w.run_once()
+    clock.advance(10)
+    w.run_once()
+    (entry,) = q.dead_letters()
+    assert entry.reason is DeadLetterReason.EXHAUSTED and entry.attempts == 2
+
+
+def test_no_policy_failed():
+    _, q, reg, w = make()
+    reg.register("t", failing(PermanentJobError("no")))
+    q.enqueue("t")
+    assert w.run_once().status is JobStatus.FAILED
+    assert q.dead_letters() == []
+
+
+def test_missing_handler_failed():
+    _, q, _, w = make(RetryPolicy())
+    q.enqueue("ghost")
+    assert w.run_once().status is JobStatus.FAILED
+    assert q.dead_letters() == []
+
+
+@pytest.mark.parametrize(
+    ("retry_after", "expected"), [(10, 10), (3600, 60), (0, 0)]
+)
+def test_retry_later_delay(retry_after, expected):
+    rng = StubRng(0.5)
+    _, q, reg, w = make(RetryPolicy(max_attempts=3, max_delay=60, jitter=0.5), rng=rng)
+    reg.register("t", failing(RetryLaterError("busy", retry_after=retry_after)))
+    q.enqueue("t")
+    job = w.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+    assert job.run_at == START + timedelta(seconds=expected)
+    assert job.error == "RetryLaterError: busy"
+    assert rng.calls == []
+    assert q.metrics.get(m.JOBS_RETRIED) == 1
+
+
+def test_retry_later_last_attempt():
+    _, q, reg, w = make(RetryPolicy(max_attempts=1))
+    reg.register("t", failing(RetryLaterError(retry_after=5)))
+    q.enqueue("t")
+    assert w.run_once().status is JobStatus.DEAD_LETTERED
+    assert q.dead_letters()[0].reason is DeadLetterReason.EXHAUSTED
+
+
+def test_retry_later_without_policy():
+    _, q, reg, w = make()
+    reg.register("t", failing(RetryLaterError(retry_after=5)))
+    q.enqueue("t")
+    assert w.run_once().status is JobStatus.FAILED
