+class RetryLaterError(JobqError):
+    """Обработчик сообщает, через сколько секунд повторить задание.
+
+    ``retry_after`` — время, которое назвал внешний сервис, секунды. Воркер ограничивает
+    его сверху ``max_delay`` политики и не применяет джиттер.
+    """
+
+    def __init__(self, message: str = "", *, retry_after: float) -> None:
+        super().__init__(message)
+        if isinstance(retry_after, bool) or not isinstance(retry_after, (int, float)):
+            raise ConfigError("retry_after must be a number")
+        if not math.isfinite(retry_after):
+            raise ConfigError("retry_after must be finite")
+        if retry_after < 0:
+            raise ConfigError("retry_after must be >= 0")
+        self.retry_after = float(retry_after)
+
+
 class DuplicateHandlerError(JobqError):
     """Попытка повторно зарегистрировать обработчик для того же типа."""
 
