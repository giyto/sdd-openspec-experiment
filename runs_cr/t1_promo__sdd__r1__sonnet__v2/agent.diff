diff --git a/tests/test_orders_autumn.py b/tests/test_orders_autumn.py
new file mode 100644
index 0000000..7613256
--- /dev/null
+++ b/tests/test_orders_autumn.py
@@ -0,0 +1,97 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import InvalidOrderStateError, PromoConditionsError, ValidationError
+from shop.orders import OrderService, OrderStatus
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+def setup(clock, kind=DiscountKind.PERCENT, value="10", **kw):
+    reg = PromoRegistry(clock, [PromoCode("AUT", kind, D(value), **kw)])
+    return OrderService(clock=clock, promos=reg), reg
+
+
+def cart_of(products, *names):
+    cart = Cart()
+    for name in names:
+        cart.add(products[name])
+    return cart
+
+
+def test_order_remembers_customer(clock, products):
+    service, _ = setup(clock)
+    cart = cart_of(products, "book")
+    assert service.place_order(cart, "aut", customer_id="u1").customer_id == "u1"
+    assert service.place_order(cart, customer_id=" U1").customer_id == " U1"
+    assert service.place_order(cart).customer_id is None
+
+
+def test_bad_customer_type(clock, products):
+    service, reg = setup(clock)
+    with pytest.raises(ValidationError):
+        service.place_order(cart_of(products, "book"), "aut", customer_id=123)
+    with pytest.raises(ValidationError):
+        service.quote(cart_of(products, "book"), customer_id=123)
+    assert len(service.store) == 0 and reg.uses("aut") == 0
+
+
+def test_customer_limit(clock, products):
+    service, reg = setup(clock, max_uses_per_customer=1)
+    cart = cart_of(products, "book")
+    for call in (service.quote, service.place_order):
+        with pytest.raises(PromoConditionsError):
+            call(cart, "aut")
+    service.place_order(cart, "aut", customer_id="u1")
+    for call in (service.quote, service.place_order):
+        with pytest.raises(PromoConditionsError):
+            call(cart, "aut", customer_id="u1")
+    service.place_order(cart, "aut", customer_id="u2")
+    assert reg.uses("aut") == 2 and reg.uses("aut", "u1") == 1 and len(service.store) == 2
+
+
+@pytest.mark.parametrize(
+    "delta,refund",
+    [
+        (timedelta(0), True),
+        (timedelta(hours=23, minutes=59, seconds=59), True),
+        (timedelta(hours=24), False),
+        (timedelta(hours=25), False),
+        (timedelta(days=5), False),
+    ],
+)
+def test_refund_window(clock, products, delta, refund):
+    service, reg = setup(clock, max_uses=1)
+    order = service.place_order(cart_of(products, "book"), "aut", customer_id="u1")
+    clock.advance(delta)
+    assert service.cancel(order.order_id).status is OrderStatus.CANCELLED
+    assert reg.uses("aut") == (0 if refund else 1)
+    assert reg.uses("aut", "u1") == (0 if refund else 1)
+    if not refund:
+        with pytest.raises(PromoConditionsError):
+            service.place_order(cart_of(products, "book"), "aut", customer_id="u1")
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(order.order_id)
+    assert reg.uses("aut") == (0 if refund else 1)
+
+
+def test_cancel_without_code(clock, products):
+    service, reg = setup(clock)
+    order = service.place_order(cart_of(products, "book"), customer_id="u1")
+    service.cancel(order.order_id)
+    assert reg.uses("aut") == 0 and reg.uses("aut", "u1") == 0
+
+
+def test_autumn_scenario(clock, products):
+    service, reg = setup(clock, DiscountKind.FREE_SHIPPING, "0", max_uses_per_customer=1)
+    order = service.place_order(cart_of(products, "book"), "aut", customer_id="u1")
+    assert order.total.shipping == D("0.00") and order.total.shipping_discount == D("299.00")
+    clock.advance(timedelta(hours=25))
+    service.cancel(order.order_id)
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart_of(products, "book"), "aut", customer_id="u1")
+    assert reg.uses("aut", "u1") == 1
