+++ b/tests/test_pricing_autumn.py
@@ -0,0 +1,145 @@
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import ShippingPolicy, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def pct(value="20", **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("P", DiscountKind.FIXED, D(value), **kw)
+
+
+def free(**kw):
+    return PromoCode("P", DiscountKind.FREE_SHIPPING, D("0"), **kw)
+
+
+def make_cart(*items):
+    cart = Cart()
+    for i, (price, category, qty) in enumerate(items):
+        cart.add(Product(f"SKU-{i}", f"Item {i}", D(price), category), qty)
+    return cart
+
+
+def one(price, category=Category.CLOTHING):
+    return make_cart((price, category, 1))
+
+
+def test_threshold_uses_subtotal_before_discount():
+    assert calculate_total(one("3100.00"), promo=fixed("200.00")).shipping == D("0.00")
+
+
+def test_below_threshold_pays_shipping():
+    assert calculate_total(one("2900.00"), promo=fixed("200.00")).shipping == D("299.00")
+    assert calculate_total(one("2900.00"), promo=pct()).shipping == D("299.00")
+
+
+def test_exact_threshold_before_discount():
+    assert calculate_total(one("3000.00"), promo=fixed("500.00")).shipping == D("0.00")
+
+
+@pytest.mark.parametrize(
+    "base,value,expected",
+    [
+        ("300.00", "500", "150.00"),
+        ("1000.00", "600", "500.00"),
+        ("1.01", "100", "0.51"),
+        ("1000.00", "100", "100.00"),
+    ],
+)
+def test_fixed_cap(base, value, expected):
+    assert calculate_total(one(base), promo=fixed(value)).discount == D(expected)
+
+
+def test_fixed_cap_ignores_gift_cards():
+    cart = make_cart(("100.00", Category.CLOTHING, 1), ("900.00", Category.GIFT_CARD, 1))
+    assert calculate_total(cart, promo=fixed("80.00")).discount == D("50.00")
+
+
+@pytest.mark.parametrize(
+    "base,expected", [("10000.00", "500.00"), ("1000.00", "200.00"), ("2500.00", "500.00")]
+)
+def test_percent_cap(base, expected):
+    total = calculate_total(one(base), promo=pct(max_discount=D("500.00")))
+    assert total.discount == D(expected)
+    assert sum(line.discount for line in total.lines) == total.discount
+
+
+def test_percent_cap_split_exact():
+    cart = make_cart(("3333.33", Category.CLOTHING, 1), ("6666.67", Category.ELECTRONICS, 1))
+    total = calculate_total(cart, promo=pct(max_discount=D("500.00")))
+    assert total.discount == D("500.00")
+    assert sum(line.discount for line in total.lines) == D("500.00")
+
+
+def test_tiebreak_larger_line_first():
+    cart = make_cart(("0.01", Category.CLOTHING, 1), ("0.03", Category.ELECTRONICS, 1))
+    total = calculate_total(cart, promo=fixed("0.02"))
+    assert total.discount == D("0.02")
+    assert [line.discount for line in total.lines] == [D("0.00"), D("0.02")]
+
+
+def test_tiebreak_equal_amounts_earlier_first():
+    cart = make_cart(("10.00", Category.CLOTHING, 1), ("10.00", Category.ELECTRONICS, 1))
+    total = calculate_total(cart, promo=fixed("0.01"))
+    assert [line.discount for line in total.lines] == [D("0.01"), D("0.00")]
+
+
+def test_existing_splits_unchanged():
+    cart = make_cart(
+        ("10.00", Category.CLOTHING, 1),
+        ("10.00", Category.ELECTRONICS, 1),
+        ("10.00", Category.FOOD, 1),
+    )
+    total = calculate_total(cart, promo=fixed("1.00"))
+    assert [line.discount for line in total.lines] == [D("0.34"), D("0.33"), D("0.33")]
+    cart = make_cart(("1.00", Category.CLOTHING, 1), ("2.00", Category.ELECTRONICS, 1))
+    total = calculate_total(cart, promo=fixed("1.00"))
+    assert [line.discount for line in total.lines] == [D("0.33"), D("0.67")]
+
+
+def test_free_shipping_basic():
+    cart = one("1000.00")
+    base = calculate_total(cart)
+    total = calculate_total(cart, promo=free())
+    assert total.discount == D("0.00")
+    assert total.shipping == D("0.00")
+    assert total.shipping_discount == D("299.00")
+    assert base.total - total.total == D("299.00")
+    assert total.tax == base.tax and total.subtotal == base.subtotal
+    assert all(line.discount == D("0.00") for line in total.lines)
+
+
+def test_free_shipping_already_free():
+    total = calculate_total(one("3000.00"), promo=free())
+    assert total.shipping == D("0.00") and total.shipping_discount == D("0.00")
+
+
+def test_free_shipping_gift_cards_only():
+    with pytest.raises(PromoConditionsError):
+        calculate_total(one("1000.00", Category.GIFT_CARD), promo=free())
+
+
+def test_free_shipping_custom_fee():
+    total = calculate_total(one("1000.00"), ShippingPolicy(fee=D("150.00")), promo=free())
+    assert total.shipping_discount == D("150.00") and total.shipping == D("0.00")
+
+
+def test_shipping_discount_zero_for_others():
+    cart = one("1000.00")
+    assert calculate_total(cart).shipping_discount == D("0.00")
+    assert calculate_total(cart, promo=pct()).shipping_discount == D("0.00")
+    assert calculate_total(cart, promo=fixed("10")).shipping_discount == D("0.00")
+
+
+def test_free_shipping_min_order():
+    with pytest.raises(PromoConditionsError):
+        calculate_total(one("1000.00"), promo=free(min_order_amount=D("1500.00")))
