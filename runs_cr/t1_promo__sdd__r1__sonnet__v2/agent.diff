+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+def free(value):
+    return PromoCode("F", DiscountKind.FREE_SHIPPING, value)
+
+
+@pytest.mark.parametrize("value", [D("0"), D("0.00")])
+def test_free_shipping_zero_ok(value):
+    assert free(value).kind is DiscountKind.FREE_SHIPPING
+
+
+@pytest.mark.parametrize("value", [D("5"), D("0.01"), D("-1"), 0.0, 0, False])
+def test_free_shipping_nonzero_rejected(value):
+    with pytest.raises(ValidationError):
+        free(value)
+
+
+@pytest.mark.parametrize("kind", [DiscountKind.PERCENT, DiscountKind.FIXED])
+def test_old_kinds_unchanged(kind):
+    with pytest.raises(ValidationError):
+        PromoCode("P", kind, D("0"))
+
+
+@pytest.mark.parametrize("cap", [D("0"), D("-1"), D("10.005"), 5.0, 5, True, "5"])
+def test_max_discount_invalid(cap):
+    with pytest.raises(ValidationError):
+        PromoCode("P", DiscountKind.PERCENT, D("10"), max_discount=cap)
+
+
+def test_max_discount_valid():
+    promo = PromoCode("P", DiscountKind.PERCENT, D("10"), max_discount=D("500.00"))
+    assert promo.max_discount == D("500.00")
+
+
+@pytest.mark.parametrize(
+    "kind,value", [(DiscountKind.FIXED, D("10")), (DiscountKind.FREE_SHIPPING, D("0"))]
+)
+def test_max_discount_only_percent(kind, value):
+    with pytest.raises(ValidationError):
+        PromoCode("P", kind, value, max_discount=D("5.00"))
+
+
+@pytest.mark.parametrize("limit", [0, -1, True, 1.5])
+def test_per_customer_invalid(limit):
+    with pytest.raises(ValidationError):
+        PromoCode("P", DiscountKind.PERCENT, D("10"), max_uses_per_customer=limit)
+
+
+@pytest.mark.parametrize("limit", [1, None])
+def test_per_customer_valid(limit):
+    assert PromoCode("P", DiscountKind.PERCENT, D("10"), max_uses_per_customer=limit)
+
+
+def test_old_constructor():
+    promo = PromoCode("p", DiscountKind.FIXED, D("10"), D("0"), 3)
+    assert promo.max_discount is None and promo.max_uses_per_customer is None
+
+
+def reg(clock, **kw):
+    return PromoRegistry(clock, [PromoCode("P", DiscountKind.PERCENT, D("10"), **kw)])
+
+
+def test_customer_required(clock):
+    r = reg(clock, max_uses_per_customer=1)
+    with pytest.raises(PromoConditionsError):
+        r.resolve("p")
+    assert r.resolve("p", "u1").code == "P"
+
+
+def test_customer_limit_and_distinct_ids(clock):
+    r = reg(clock, max_uses_per_customer=1)
+    r.redeem("p", "u1")
+    with pytest.raises(PromoConditionsError):
+        r.resolve("p", "u1")
+    r.resolve("p", "u2")
+    r.resolve("p", "U1")
+    r.resolve("p", " u1")
+    assert r.uses("p") == 1 and r.uses("p", "u1") == 1 and r.uses("p", "u2") == 0
+
+
+def test_customer_id_type(clock):
+    r = reg(clock)
+    for call in (r.resolve, r.uses, r.redeem, r.release):
+        with pytest.raises(ValidationError):
+            call("p", 123)
+
+
+def test_no_limit_ignores_customer(clock):
+    r = reg(clock)
+    r.resolve("p")
+    r.resolve("p", "u1")
+    r.redeem("p")
+    r.redeem("p", "u1")
+    assert r.uses("p") == 2 and r.uses("p", "u1") == 1
+
+
+def test_order_of_checks(clock):
+    now = clock.now()
+    r = PromoRegistry(
+        clock,
+        [
+            PromoCode(
+                "E",
+                DiscountKind.PERCENT,
+                D("10"),
+                max_uses_per_customer=1,
+                expires_at=now + timedelta(days=1),
+            ),
+            PromoCode("G", DiscountKind.PERCENT, D("10"), max_uses=1, max_uses_per_customer=1),
+        ],
+    )
+    r.redeem("e", "u1")
+    clock.advance(timedelta(days=2))
+    with pytest.raises(PromoExpiredError):
+        r.resolve("e", "u1")
+    r.redeem("g", "u1")
+    with pytest.raises(PromoConditionsError, match="usage limit"):
+        r.resolve("g", "u1")
+
+
+def test_release_not_below_zero(clock):
+    r = reg(clock)
+    r.release("p", "u1")
+    assert r.uses("p") == 0 and r.uses("p", "u1") == 0
+    r.redeem("p", "u1")
+    r.release("p", "u1")
+    r.release("p", "u1")
+    assert r.uses("p") == 0 and r.uses("p", "u1") == 0
+
+
+def test_unknown_code_uses(clock):
+    with pytest.raises(UnknownPromoCodeError):
+        reg(clock).uses("nope", "u1")
+
+
+def test_backward_compat_calls(clock):
+    r = reg(clock)
+    r.resolve("p")
+    r.redeem("p")
+    assert r.uses("p") == 1
+    r.release("p")
+    assert r.uses("p") == 0
