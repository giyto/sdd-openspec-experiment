diff --git a/tests/test_importer_followups.py b/tests/test_importer_followups.py
new file mode 100644
index 0000000..3522b96
--- /dev/null
+++ b/tests/test_importer_followups.py
@@ -0,0 +1,62 @@
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementRowError
+from ledger.importer import import_statement
+from ledger.storage import MemoryStore
+
+
+def test_both_separators_is_error(write_csv, clock):
+    text = "Дата;Сумма;Описание\n01.03.2026;-1 234.56;a\n02.03.2026;1,234.56;b\n"
+    store = MemoryStore()
+    r = import_statement(write_csv(text), store, clock=clock)
+    assert r.added == 1 and [e.line_no for e in r.errors] == [3]
+    assert store.all()[0].amount == Decimal("-1234.56")
+
+
+def test_split_zero_rows_skipped(write_csv, clock):
+    text = (
+        "Дата;Описание;Приход;Расход\n"
+        "01.03.2026;block;0;0,00\n"
+        "02.03.2026;half;0;\n"
+        "03.03.2026;ok;;5.5\n"
+    )
+    r = import_statement(write_csv(text), MemoryStore(), clock=clock)
+    assert (r.added, r.duplicates, [e.line_no for e in r.errors]) == (1, 0, [3])
+
+
+def test_description_whitespace_collapsed(write_csv, clock):
+    text = 'Дата;Сумма;Описание\n01.03.2026;-1,00;"  Оплата\n\t  Кофе   Х "\n'
+    store = MemoryStore()
+    import_statement(write_csv(text), store, clock=clock)
+    assert store.all()[0].description == "Оплата Кофе Х"
+
+
+def test_strict_collects_all_errors_with_raw(write_csv, clock):
+    store = MemoryStore()
+    text = (
+        "Дата;Сумма;Описание\r\n"
+        "01.03.2026;-1,00;ok\r\n"
+        "bad;1;x\r\n"
+        '02.03.2026;zz;"multi\r\nline"\r\n'
+    )
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(text), store, strict=True, clock=clock)
+    exc = info.value
+    assert exc.line_no == 3 and [e.line_no for e in exc.errors] == [3, 4]
+    assert exc.errors[0].raw == "bad;1;x"
+    assert exc.errors[1].raw == '02.03.2026;zz;"multi\nline"'
+    assert store.all() == []
+
+
+def test_dry_run_and_transactions(write_csv, clock):
+    text = "Дата;Сумма;Описание\n01.03.2026;-1,00;a\n02.03.2026;2.00;b\n"
+    store = MemoryStore()
+    p = write_csv(text)
+    r = import_statement(p, store, clock=clock, dry_run=True)
+    assert store.all() == []
+    assert r.added == 2 and [t.id for t in r.transactions] == [None, None]
+    r = import_statement(p, store, clock=clock)
+    assert [t.id for t in r.transactions] == [1, 2]
+    assert [t.description for t in r.transactions] == ["a", "b"]
