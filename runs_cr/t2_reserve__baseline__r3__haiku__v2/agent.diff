+++ b/tests/test_reservation_rework.py
@@ -0,0 +1,243 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from warehouse.errors import (
+    DuplicateReservationError,
+    InsufficientStockError,
+    ValidationError,
+)
+from warehouse.models import Availability, ReservationStatus
+from warehouse.reservations import (
+    DEFAULT_RESERVATION_TTL,
+    MAX_RESERVATION_LIFETIME,
+)
+
+T0 = datetime(2026, 3, 1, 10, 0, 0, tzinfo=timezone.utc)
+
+
+def test_default_ttl_is_twenty_minutes():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=20)
+
+
+def test_max_lifetime_is_two_hours():
+    assert MAX_RESERVATION_LIFETIME == timedelta(hours=2)
+
+
+def test_reserve_rejects_ttl_above_limit(inv):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    events_before = len(inv.log)
+    with pytest.raises(ValidationError):
+        inv.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME + timedelta(seconds=1))
+    assert len(inv.log) == events_before
+
+
+def test_reserve_accepts_ttl_at_limit(inv):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    reservation = inv.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    assert reservation.expires_at == reservation.created_at + MAX_RESERVATION_LIFETIME
+
+
+def test_extend_is_capped_at_lifetime_limit(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    created = inv.reserve("SO-3", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=30)).created_at
+    clock.advance(timedelta(minutes=10))
+    extended = inv.extend("SO-3", timedelta(hours=5))
+    assert extended.expires_at == created + MAX_RESERVATION_LIFETIME
+    assert inv.log.events("RESERVE_EXTEND")[0].get("expires") == "2026-03-01T12:00:00Z"
+
+
+def test_extend_at_limit_is_noop(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 3)
+    inv.reserve("SO-4", [("MAIN", "BOLT-M8", 1)], ttl=MAX_RESERVATION_LIFETIME)
+    clock.advance(timedelta(minutes=10))
+    events_before = len(inv.log)
+    assert inv.extend("SO-4", timedelta(hours=1)).expires_at == T0 + MAX_RESERVATION_LIFETIME
+    assert len(inv.log) == events_before
+
+
+def test_reserve_replaces_active_reservation(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-5", [("MAIN", "BOLT-M8", 4)])
+    clock.advance(timedelta(minutes=5))
+    replaced = inv.reserve("SO-5", [("MAIN", "BOLT-M8", 7)])
+    assert replaced.status is ReservationStatus.ACTIVE
+    assert replaced.created_at == clock.now()
+    assert replaced.expires_at == clock.now() + DEFAULT_RESERVATION_TTL
+    assert replaced.lines[0].qty == 7
+    assert inv.reserved("MAIN", "BOLT-M8") == 7
+    assert inv.available("MAIN", "BOLT-M8") == 3
+
+
+def test_replacement_frees_old_stock_for_check(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-6", [("MAIN", "BOLT-M8", 5)])
+    inv.reserve("SO-6", [("MAIN", "BOLT-M8", 5)])
+    assert inv.reserved("MAIN", "BOLT-M8") == 5
+    with pytest.raises(InsufficientStockError) as info:
+        inv.reserve("SO-6", [("MAIN", "BOLT-M8", 6)])
+    assert (info.value.requested, info.value.available) == (6, 5)
+
+
+def test_failed_replacement_keeps_old_reservation(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-7", [("MAIN", "BOLT-M8", 2)])
+    events_before = len(inv.log)
+    with pytest.raises(InsufficientStockError):
+        inv.reserve("SO-7", [("MAIN", "BOLT-M8", 6)])
+    assert len(inv.log) == events_before
+    assert inv.get_reservation("SO-7").status is ReservationStatus.ACTIVE
+    assert inv.reserved("MAIN", "BOLT-M8") == 2
+
+
+def test_replacement_log_order(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("NORTH", "NUT-M8", 5)
+    inv.reserve("SO-8", [("MAIN", "BOLT-M8", 1)])
+    inv.reserve("SO-8", [("MAIN", "BOLT-M8", 2), ("NORTH", "NUT-M8", 3)])
+    kinds = [(e.kind, e.get("order")) for e in inv.log.events() if e.kind.startswith("RESERVE")]
+    assert kinds == [
+        ("RESERVE", "SO-8"),
+        ("RESERVE_CANCEL", "SO-8"),
+        ("RESERVE", "SO-8"),
+        ("RESERVE", "SO-8"),
+    ]
+
+
+def test_replacing_confirmed_order_is_still_forbidden(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-9", [("MAIN", "BOLT-M8", 1)])
+    inv.confirm("SO-9")
+    with pytest.raises(DuplicateReservationError):
+        inv.reserve("SO-9", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_cancel_confirmed_returns_stock_per_line(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.receive("NORTH", "BOLT-M8", 5)
+    inv.reserve("SO-10", [("MAIN", "BOLT-M8", 2), ("NORTH", "BOLT-M8", 3)])
+    inv.confirm("SO-10")
+    cancelled = inv.cancel("SO-10")
+    assert cancelled.status is ReservationStatus.CANCELLED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 5
+    assert inv.on_hand("NORTH", "BOLT-M8") == 5
+    receives = inv.log.events("RECEIVE")[2:]
+    assert [(e.get("wh"), e.get("qty"), e.get("ref")) for e in receives] == [
+        ("MAIN", "2", "SO-10"),
+        ("NORTH", "3", "SO-10"),
+    ]
+    tail = [e.kind for e in inv.log.events()[-3:]]
+    assert tail == ["RECEIVE", "RECEIVE", "RESERVE_CANCEL"]
+
+
+def test_cancel_confirmed_is_idempotent(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-11", [("MAIN", "BOLT-M8", 2)])
+    inv.confirm("SO-11")
+    inv.cancel("SO-11")
+    events_before = len(inv.log)
+    assert inv.cancel("SO-11").status is ReservationStatus.CANCELLED
+    assert inv.on_hand("MAIN", "BOLT-M8") == 5
+    assert len(inv.log) == events_before
+
+
+def test_reservations_snapshots_sorted_and_filtered(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-B", [("MAIN", "BOLT-M8", 1)])
+    inv.reserve("SO-A", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=1))
+    inv.reserve("SO-C", [("MAIN", "BOLT-M8", 1)])
+    inv.cancel("SO-C")
+    inv.confirm("SO-A")
+    clock.advance(DEFAULT_RESERVATION_TTL)
+    all_ids = [r.order_id for r in inv.reservations()]
+    assert all_ids == ["SO-A", "SO-B", "SO-C"]
+    assert [r.order_id for r in inv.reservations(ReservationStatus.EXPIRED)] == ["SO-B"]
+    assert [r.order_id for r in inv.reservations(ReservationStatus.CONFIRMED)] == ["SO-A"]
+    assert [r.order_id for r in inv.reservations(ReservationStatus.CANCELLED)] == ["SO-C"]
+    assert inv.reservations(ReservationStatus.ACTIVE) == []
+
+
+def test_availability_rows_sorted_and_filtered(inv):
+    inv.receive("NORTH", "BOLT-M8", 4)
+    inv.receive("MAIN", "NUT-M8", 6)
+    inv.receive("MAIN", "BOLT-M8", 3)
+    inv.reserve("SO-12", [("MAIN", "NUT-M8", 2)])
+    assert inv.availability() == [
+        Availability("MAIN", "BOLT-M8", on_hand=3, reserved=0, available=3),
+        Availability("MAIN", "NUT-M8", on_hand=6, reserved=2, available=4),
+        Availability("NORTH", "BOLT-M8", on_hand=4, reserved=0, available=4),
+    ]
+    assert inv.availability("NORTH") == [
+        Availability("NORTH", "BOLT-M8", on_hand=4, reserved=0, available=4),
+    ]
+
+
+def test_availability_includes_reserved_position_without_stock(inv):
+    inv.receive("MAIN", "BOLT-M8", 5)
+    inv.reserve("SO-13", [("MAIN", "BOLT-M8", 5)])
+    inv.adjust("MAIN", "BOLT-M8", 0, "writeoff")
+    assert inv.availability() == [
+        Availability("MAIN", "BOLT-M8", on_hand=0, reserved=5, available=0),
+    ]
+
+
+def test_availability_matches_query_methods(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-14", [("MAIN", "BOLT-M8", 4)])
+    inv.adjust("MAIN", "BOLT-M8", 2, "recount")
+    (row,) = inv.availability()
+    assert (row.on_hand, row.reserved, row.available) == (
+        inv.on_hand("MAIN", "BOLT-M8"),
+        inv.reserved("MAIN", "BOLT-M8"),
+        inv.available("MAIN", "BOLT-M8"),
+    )
+
+
+def test_sweep_expired_records_once_in_expiry_order(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-15", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=10))
+    inv.reserve("SO-16", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=5))
+    inv.reserve("SO-17", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=5))
+    inv.reserve("SO-18", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=30))
+    clock.advance(timedelta(minutes=10))
+    assert inv.sweep_expired() == ["SO-16", "SO-17", "SO-15"]
+    events = inv.log.events("RESERVE_EXPIRE")
+    assert [(e.get("order"), e.get("expires")) for e in events] == [
+        ("SO-16", "2026-03-01T10:05:00Z"),
+        ("SO-17", "2026-03-01T10:05:00Z"),
+        ("SO-15", "2026-03-01T10:10:00Z"),
+    ]
+    assert inv.sweep_expired() == []
+    assert len(inv.log.events("RESERVE_EXPIRE")) == 3
+
+
+def test_sweep_expired_does_not_change_statuses_or_stock(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-19", [("MAIN", "BOLT-M8", 4)], ttl=timedelta(minutes=1))
+    clock.advance(timedelta(minutes=2))
+    inv.sweep_expired()
+    assert inv.on_hand("MAIN", "BOLT-M8") == 10
+    assert inv.get_reservation("SO-19").status is ReservationStatus.EXPIRED
+
+
+def test_sweep_expired_skips_non_expired_and_cancelled(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-20", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    inv.reserve("SO-21", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    inv.cancel("SO-21")
+    inv.reserve("SO-22", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=10))
+    clock.advance(timedelta(minutes=2))
+    assert inv.sweep_expired() == ["SO-20"]
+
+
+def test_sweep_expired_records_new_reservation_of_same_order(inv, clock):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.reserve("SO-23", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    clock.advance(timedelta(minutes=2))
+    assert inv.sweep_expired() == ["SO-23"]
+    inv.reserve("SO-23", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(minutes=1))
+    assert inv.sweep_expired() == []
+    clock.advance(timedelta(minutes=2))
+    assert inv.sweep_expired() == ["SO-23"]
+    assert len(inv.log.events("RESERVE_EXPIRE")) == 2
