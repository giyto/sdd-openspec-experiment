+def test_cancel_within_24_hours_refunds(clock, registry, cart):
+    service = make_service(clock, registry, max_uses=1, max_uses_per_customer=1)
+    order = service.place_order(cart, "once", customer_id="u1")
+    clock.advance(timedelta(hours=23, minutes=59))
+    service.cancel(order.order_id)
+    assert registry.uses("ONCE") == 0
+    assert registry.uses("ONCE", "u1") == 0
+    service.place_order(cart, "once", customer_id="u1")
+
+
+def test_cancel_exactly_24_hours_burns_usage(clock, registry, cart):
+    service = make_service(clock, registry, max_uses=1)
+    order = service.place_order(cart, "once", customer_id="u1")
+    clock.advance(timedelta(hours=24))
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert registry.uses("ONCE") == 1
+    assert registry.uses("ONCE", "u1") == 1
+
+
+def test_cancel_after_25_hours(clock, registry, cart):
+    service = make_service(clock, registry, max_uses=1)
+    order = service.place_order(cart, "once")
+    clock.advance(timedelta(hours=25))
+    service.cancel(order.order_id)
+    assert registry.uses("ONCE") == 1
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "once")
