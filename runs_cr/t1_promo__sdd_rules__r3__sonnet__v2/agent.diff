+def test_customer_limit(registry):
+    registry.add(PromoCode("C", DiscountKind.PERCENT, D("10"), max_uses_per_customer=1))
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("C")
+    registry.consume("C", "u1")
+    with pytest.raises(PromoConditionsError):
+        registry.resolve("C", "u1")
+    assert registry.resolve("C", "u2").code == "C"
+    assert registry.resolve("C", "U1").code == "C"
+    assert registry.resolve("C", "u1 ").code == "C"
