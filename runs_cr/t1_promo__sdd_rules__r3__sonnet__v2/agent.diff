+def test_order_without_code_keeps_customer(clock, registry, cart):
+    order = OrderService(clock=clock, promos=registry).place_order(cart, customer_id="u1")
+    assert order.customer_id == "u1"
+    assert order.promo_code is None
+    assert order.total.shipping_discount == D("0.00")
+    assert OrderService(clock=clock).place_order(cart).customer_id is None
+
+
+def test_customer_limit_in_orders(clock, registry, cart):
+    service = make_service(clock, registry, max_uses_per_customer=1)
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "once")
+    order = service.place_order(cart, "once", customer_id="u1")
+    assert order.customer_id == "u1"
+    assert registry.uses("ONCE") == 1
+    assert registry.uses("ONCE", "u1") == 1
+    with pytest.raises(PromoConditionsError):
+        service.quote(cart, "once", customer_id="u1")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "once", customer_id="u1")
+    assert len(service.store) == 1
+    assert service.quote(cart, "once", customer_id="u2").discount == D("100.00")
