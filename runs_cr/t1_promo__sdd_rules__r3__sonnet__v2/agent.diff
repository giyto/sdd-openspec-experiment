diff --git a/tests/test_autumn_limits.py b/tests/test_autumn_limits.py
new file mode 100644
index 0000000..f1db5e7
--- /dev/null
+++ b/tests/test_autumn_limits.py
@@ -0,0 +1,265 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError, ValidationError
+from shop.orders import OrderService, OrderStatus
+from shop.pricing import calculate_total
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+def prod(sku, price, category=Category.CLOTHING):
+    return Product(f"SKU-{sku}", sku, D(price), category)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def promo(kind, value, **kw):
+    return PromoCode("P", kind, D(value), **kw)
+
+
+# --- PromoCode validation -------------------------------------------------
+
+
+def test_free_shipping_value_must_be_zero():
+    with pytest.raises(ValidationError):
+        promo(DiscountKind.FREE_SHIPPING, "5")
+    assert promo(DiscountKind.FREE_SHIPPING, "0").value == 0
+
+
+@pytest.mark.parametrize("kind", [DiscountKind.FIXED, DiscountKind.FREE_SHIPPING])
+def test_max_discount_only_for_percent(kind):
+    value = "0" if kind is DiscountKind.FREE_SHIPPING else "10"
+    with pytest.raises(ValidationError):
+        promo(kind, value, max_discount=D("100"))
+
+
+@pytest.mark.parametrize("bad", [D("0"), D("-1"), D("1.005"), 5, D("NaN")])
+def test_invalid_max_discount(bad):
+    with pytest.raises(ValidationError):
+        promo(DiscountKind.PERCENT, "10", max_discount=bad)
+
+
+def test_valid_max_discount():
+    assert promo(DiscountKind.PERCENT, "10", max_discount=D("0.01")).max_discount == D("0.01")
+
+
+@pytest.mark.parametrize("bad", [0, -1, True])
+def test_invalid_limits(bad):
+    with pytest.raises(ValidationError):
+        promo(DiscountKind.PERCENT, "10", max_uses_per_customer=bad)
+    with pytest.raises(ValidationError):
+        promo(DiscountKind.PERCENT, "10", max_uses=bad)
+
+
+# --- Pricing --------------------------------------------------------------
+
+
+def test_percent_cap_and_not_reached():
+    big = cart_of((prod("A", "1000.00"), 1))
+    capped = promo(DiscountKind.PERCENT, "20", max_discount=D("150"))
+    assert calculate_total(big, promo=capped).discount == D("150.00")
+    small = cart_of((prod("A", "500.00"), 1))
+    assert calculate_total(small, promo=capped).discount == D("100.00")
+
+
+def test_percent_rounding():
+    cart = cart_of((prod("A", "100.05"), 1))
+    assert calculate_total(cart, promo=promo(DiscountKind.PERCENT, "10")).discount == D("10.01")
+
+
+def test_fixed_limited_to_half():
+    cart = cart_of((prod("A", "300.00"), 1))
+    assert calculate_total(cart, promo=promo(DiscountKind.FIXED, "500")).discount == D("150.00")
+    assert calculate_total(cart, promo=promo(DiscountKind.FIXED, "100")).discount == D("100.00")
+
+
+def test_fixed_half_rounds_up():
+    cart = cart_of((prod("A", "100.01"), 1))
+    assert calculate_total(cart, promo=promo(DiscountKind.FIXED, "500")).discount == D("50.01")
+
+
+def test_shipping_threshold_before_discount():
+    cart = cart_of((prod("A", "3100.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "200"))
+    assert total.shipping == D("0.00")
+    below = cart_of((prod("A", "2999.99"), 1))
+    assert calculate_total(below, promo=promo(DiscountKind.PERCENT, "10")).shipping == D("299.00")
+
+
+def test_free_shipping_pays_nothing_for_delivery():
+    cart = cart_of((prod("A", "1000.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FREE_SHIPPING, "0"))
+    assert total.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in total.lines)
+    assert total.shipping == D("0.00")
+    assert total.shipping_discount == D("299.00")
+    assert total.total == total.subtotal + total.tax
+
+
+def test_free_shipping_when_already_free():
+    cart = cart_of((prod("A", "3500.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FREE_SHIPPING, "0"))
+    assert total.shipping_discount == D("0.00")
+
+
+def test_shipping_discount_zero_for_other_kinds():
+    cart = cart_of((prod("A", "1000.00"), 1))
+    assert calculate_total(cart).shipping_discount == D("0.00")
+    assert calculate_total(cart, promo=promo(DiscountKind.PERCENT, "10")).shipping_discount == 0
+
+
+def test_free_shipping_conditions():
+    gift = prod("G", "1000.00", Category.GIFT_CARD)
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((gift, 1)), promo=promo(DiscountKind.FREE_SHIPPING, "0"))
+    cart = cart_of((prod("A", "500.00"), 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart,
+            promo=promo(DiscountKind.FREE_SHIPPING, "0", min_order_amount=D("1000.00")),
+        )
+
+
+def test_remainder_tie_goes_to_larger_line():
+    # amounts 0.01 and 0.03, discount 0.02: both remainders are 2/4, one kopeck is left
+    cart = cart_of((prod("A", "0.01"), 1), (prod("B", "0.03"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "0.02"))
+    assert [line.discount for line in total.lines] == [D("0.00"), D("0.02")]
+
+
+def test_remainder_tie_goes_to_earlier_line_for_equal_amounts():
+    cart = cart_of((prod("A", "100.00"), 1), (prod("B", "100.00"), 1), (prod("C", "100.00"), 1))
+    total = calculate_total(cart, promo=promo(DiscountKind.FIXED, "10"))
+    assert [line.discount for line in total.lines] == [D("3.34"), D("3.33"), D("3.33")]
+
+
+# --- Registry -------------------------------------------------------------
+
+
+@pytest.fixture
+def registry(clock):
+    return PromoRegistry(clock)
+
+
+def test_counters_per_customer(registry):
+    registry.add(PromoCode("C", DiscountKind.PERCENT, D("10")))
+    registry.consume("C", "u1")
+    registry.consume("C", "u1")
+    registry.consume("C", "u2")
+    assert registry.uses("C") == 3
+    assert registry.uses("C", "u1") == 2
+    assert registry.uses("C", "u2") == 1
+    assert registry.uses("C", "nobody") == 0
+    registry.release("C", "u2")
+    registry.release("C", "u2")
+    assert registry.uses("C", "u2") == 0
+
