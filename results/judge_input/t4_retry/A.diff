+def test_cancel_rules_and_purge(queue, registry, worker, clock):
+    (dead,) = _dead(queue, registry, worker, clock)
+    queue.set_retry_policy("r", RetryPolicy())
+    registry.register("r", failing())
+    waiting = queue.enqueue("r")
+    worker.run_once()
+    assert waiting.status is JobStatus.RETRY_SCHEDULED
+
+    clock.advance(10**6)
+    assert queue.purge_finished(0) == 0
+    assert dead.id in queue.store and waiting.id in queue.store
+    assert len(queue.dead_letters()) == 1
+
+    with pytest.raises(InvalidTransitionError):
+        queue.cancel(dead.id)
+    assert dead.status is JobStatus.DEAD_LETTERED
+
+    queue.cancel(waiting.id)
+    assert waiting.status is JobStatus.CANCELLED
+    assert queue.metrics.get("jobs.cancelled") == 1
+    assert worker.run_once() is None
+
