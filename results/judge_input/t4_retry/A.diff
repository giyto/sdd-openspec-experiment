+def test_requeue_then_first_error_retries(queue, registry, worker, clock):
+    (job,) = _dead(queue, registry, worker, clock)
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=3))
+    clock.advance(100)
+    same = queue.requeue_dead_letter(job.id)
+    assert same is job
+    assert (job.status, job.error, job.attempts, job.finished_at) == (JobStatus.PENDING, None, 0, None)
+    assert job.run_at == clock.now()
+    assert queue.dead_letters() == []
+    assert queue.metrics.get("jobs.requeued") == 1
+    worker.run_once()
+    assert job.status is JobStatus.RETRY_SCHEDULED
+
