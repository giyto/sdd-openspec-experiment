+def _dead(queue, registry, worker, clock, n=1):
+    queue.set_retry_policy("t", RetryPolicy(max_attempts=1))
+    registry.register("t", failing())
+    jobs = [queue.enqueue("t") for _ in range(n)]
+    for _ in jobs:
+        worker.run_once()
+    return jobs
+
+
+def test_dead_letters_order_and_copy(queue, registry, worker, clock):
+    a, b = _dead(queue, registry, worker, clock, 2)
+    entries = queue.dead_letters()
+    assert [e.job_id for e in entries] == [a.id, b.id]
+    entries.clear()
+    assert len(queue.dead_letters()) == 2
+
+
+def test_dead_letters_empty(queue):
+    assert queue.dead_letters() == []
+
