+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule, normalize_text
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1 200,50;Магазин Лента\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+)
+NOVA = "date,amount,description\n2026-03-01,-350.00,Кофе\n2026-03-02,10.00,Сдача\n"
+
+
+# 1. errors
+def test_errors_hierarchy():
+    for cls in (UnknownFormatError, StatementRowError):
+        err = cls("boom", line_no=7)
+        assert isinstance(err, StatementError)
+        assert err.line_no == 7
+
+
+# 2. decoding / header
+def test_bom_and_cp1251(write_csv, clock):
+    r = import_statement(write_csv("﻿" + SFERA), MemoryStore(), clock=clock)
+    assert (r.format, r.encoding, r.added) == ("sfera", "utf-8", 2)
+    store = MemoryStore()
+    r = import_statement(write_csv(SFERA, encoding="cp1251"), store, clock=clock)
+    assert r.encoding == "cp1251"
+    assert store.all()[0].description == "Магазин Лента"
+
+
+def test_undecodable_bytes(tmp_path):
+    p = tmp_path / "bad.csv"
+    p.write_bytes(b"\xff\x98\n")
+    store = MemoryStore()
+    with pytest.raises(StatementError):
+        import_statement(p, store)
+    assert store.all() == []
+
+
+def test_detect_format_variants():
+    assert detect_format(" ДАТА ;Номер карты; Сумма ;Описание;Остаток\n") == "sfera"
+    assert detect_format("Дата;Описание;Приход;Расход\n") == "sfera_split"
+    assert detect_format("Описание;Расход;Приход;Дата") == "sfera_split"
+    assert detect_format("DATE,Amount,description\n") == "nova"
+
+
+@pytest.mark.parametrize(
+    "header", ["date,sum,description\n", "Дата;Сумма;Приход;Расход;Описание\n",
+               "Дата;Сумма;Сумма;Описание\n", "\n"]
+)
+def test_unknown_header(write_csv, header):
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError) as ei:
+        import_statement(write_csv(header + "x\n"), store)
+    assert ei.value.line_no == 1
+    assert store.all() == []
+
+
+def test_empty_file_and_explicit_fmt(write_csv):
+    with pytest.raises(UnknownFormatError) as ei:
+        import_statement(write_csv(""), MemoryStore())
+    assert ei.value.line_no is None
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), store, fmt="nova")
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(SFERA), store, fmt="bogus")
+    assert store.all() == []
+
+
+# 3. rows
+@pytest.mark.parametrize(
+    "amount,expected",
+    [("-1 200,50", "-1200.50"), ("-1 200,50", "-1200.50"), ("+85 000,00", "85000.00"),
+     ("5", "5.00"), ("0,5", "0.50")],
+)
+def test_sfera_amounts(write_csv, amount, expected):
+    store = MemoryStore()
+    r = import_statement(write_csv(f"Дата;Сумма;Описание\n01.03.2026;{amount};X\n"), store)
+    assert r.errors == []
+    assert store.all()[0].amount == Decimal(expected)
+    assert store.all()[0].date == dt.date(2026, 3, 1)
+
+
+@pytest.mark.parametrize(
+    "date,amount",
+    [("01.03.2026", "1 234.56"), ("01.03.2026", "10,005"), ("2026-03-01", "10,00"),
+     ("1.3.2026", "10,00"), ("31.02.2026", "10,00"), ("01.03.2026", "abc"),
+     ("01.03.2026", "0,00"), ("01.03.2026", "1 23,00")],
+)
+def test_sfera_bad_rows(write_csv, date, amount):
+    store = MemoryStore()
+    r = import_statement(write_csv(f"Дата;Сумма;Описание\n{date};{amount};X\n"), store)
+    assert [e.line_no for e in r.errors] == [2]
+    assert store.all() == []
+
+
+def test_sfera_empty_description_and_short_row(write_csv):
+    r = import_statement(write_csv("Дата;Сумма;Описание\n01.03.2026;1,00; \n01.03.2026;1,00\n"),
+                         MemoryStore())
+    assert [e.line_no for e in r.errors] == [2, 3]
+
+
+def test_split_rows(write_csv):
+    text = (
+        "Дата;Описание;Приход;Расход\n"
+        "01.03.2026;A;;150,00\n"
+        "01.03.2026;B;0,00;150,00\n"
+        "01.03.2026;C;1 000,00;0,00\n"
+        "01.03.2026;D;1,00;2,00\n"
+        "01.03.2026;E;;\n"
+        "01.03.2026;F;0,00;0,00\n"
+        "01.03.2026;G;;-150,00\n"
+        "01.03.2026;H;+5,00;\n"
+    )
+    store = MemoryStore()
+    r = import_statement(write_csv(text), store)
+    assert [t.amount for t in store.all()] == [Decimal("-150.00")] * 2 + [Decimal("1000.00")]
+    assert [e.line_no for e in r.errors] == [5, 6, 7, 8, 9]
+
+
+def test_nova_rows(write_csv):
+    store = MemoryStore()
+    r = import_statement(write_csv(NOVA), store)
+    assert r.format == "nova" and r.added == 2
+    assert store.all()[0].amount == Decimal("-350.00")
+
+
+def test_junk_rows_and_line_numbers(write_csv):
+    text = "Дата;Сумма;Описание\n\n;;;\n   \n01.03.2026;oops;X\n01.03.2026;1,00;Y\n;;\n\n"
+    store = MemoryStore()
+    r = import_statement(write_csv(text), store)
+    assert r.added == 1 and r.duplicates == 0
+    assert r.errors == [RowError(5, r.errors[0].message)]
+    r = import_statement(write_csv("date,amount,description\n,,\n\n2026-03-01,1.00,A\n,,\n"),
+                         MemoryStore())
+    assert r.added == 1 and r.errors == []
+
+
+def test_multiline_record_line_no(write_csv):
+    text = 'date,amount,description\n2026-03-01,1.00,"a\nb"\n2026-03-02,bad,X\n'
+    r = import_statement(write_csv(text), MemoryStore())
+    assert r.added == 1 and [e.line_no for e in r.errors] == [4]
+
+
+# 4. import
+def test_normalize_description():
+    for s in ("  Ёлка   МАГАЗИН ", "елка магазин"):
+        assert normalize_description(s) == normalize_text(s) == "елка магазин"
+
+
+def test_reimport_and_description_spelling(write_csv, clock):
+    store = MemoryStore()
+    path = write_csv(SFERA)
+    assert import_statement(path, store, clock=clock).added == 2
+    r = import_statement(path, store, clock=clock)
+    assert (r.added, r.duplicates) == (0, 2)
+    r = import_statement(
+        write_csv("Дата;Сумма;Описание\n01.03.2026;-1200,50;  магазин   лента\n", name="b.csv"),
+        store,
+    )
+    assert (r.added, r.duplicates) == (0, 1)
+    assert len(store.all()) == 2
+
+
+def test_count_based_dedup(write_csv):
+    row = "01.03.2026;-150,00;Кофе\n"
+    head = "Дата;Сумма;Описание\n"
+    store = MemoryStore()
+    r = import_statement(write_csv(head + row * 2), store)
+    assert (r.added, r.duplicates) == (2, 0)
+    store = MemoryStore()
+    import_statement(write_csv(head + row), store)
+    r = import_statement(write_csv(head + row * 2, name="b.csv"), store)
+    assert (r.added, r.duplicates) == (1, 1)
+    assert len(store.all()) == 2
+
+
+def test_categorizer_and_single_clock(write_csv, clock):
+    store = MemoryStore()
+    cat = Categorizer([Rule("зарплата", "salary")])
+    import_statement(write_csv(SFERA), store, categorizer=cat, clock=clock)
+    assert [t.category for t in store.all()] == [None, "salary"]
+    assert {t.imported_at for t in store.all()} == {clock.now()}
+
