+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementError, StatementRowError, UnknownFormatError
+from ledger.importer import (
+    ImportResult,
+    RowError,
+    detect_format,
+    import_csv,
+    import_statement,
+    normalize_description,
+)
+from ledger.rules import Categorizer, Rule, normalize_text
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = "Дата;Сумма;Описание\n"
+SPLIT = "Дата;Описание;Приход;Расход\n"
+NOVA = "date,amount,description\n"
+
+
+def test_error_hierarchy():
+    assert issubclass(UnknownFormatError, StatementError)
+    assert StatementRowError("x", line_no=4).line_no == 4
+    assert ImportResult("nova", "utf-8", 0, 0).errors == ()
+    assert RowError(2, "m").line_no == 2
+
+
+def test_normalize_description_matches_normalize_text():
+    for s in ["  Магазин   Лента ", "КОФЕ", "Ёлка", "a\tb"]:
+        assert normalize_description(s) == normalize_text(s)
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        (NOVA, "nova"),
+        (SFERA, "sfera"),
+        (SPLIT, "sfera_split"),
+        ("Номер карты;ДАТА; Описание ;Остаток; Сумма \n", "sfera"),
+        ("Расход;Приход;описание;дата\n", "sfera_split"),
+        ("\n;;;\n" + SFERA, "sfera"),
+    ],
+)
+def test_detect_format(write_csv, text, expected):
+    assert detect_format(write_csv(text)) == expected
+
+
+@pytest.mark.parametrize("text", ["", "\n  \n;;;\n", "a;b;c\n1;2;3\n", "Дата;Сумма;Описание;Сумма\n"])
+@pytest.mark.parametrize("strict", [True, False])
+def test_unknown_format(write_csv, text, strict):
+    store = MemoryStore()
+    with pytest.raises(UnknownFormatError):
+        import_statement(write_csv(text), store, strict=strict)
+    assert store.all() == []
+
+
+def test_encodings(write_csv, clock):
+    body = SFERA + "01.03.2026;-1 200,50;Магазин Лента\n"
+    for enc, name in [("utf-8", "utf-8"), ("utf-8-sig", "utf-8"), ("cp1251", "cp1251")]:
+        res = import_statement(write_csv(body, encoding=enc), MemoryStore(), clock=clock)
+        assert (res.encoding, res.added, res.format) == (name, 1, "sfera")
+
+
+def test_undecodable(tmp_path):
+    p = tmp_path / "x.csv"
+    p.write_bytes(b"\xff\x98\n")
+    with pytest.raises(StatementError):
+        import_statement(p, MemoryStore())
+
+
+def test_explicit_fmt_mismatch_and_unknown(write_csv):
+    store = MemoryStore()
+    for fmt in ("nova", "bogus"):
+        for strict in (True, False):
+            with pytest.raises(UnknownFormatError) as info:
+                import_statement(write_csv(SFERA + "01.03.2026;-1,00;x\n"), store, fmt=fmt, strict=strict)
+            assert info.value.line_no == 1
+    assert store.all() == []
+
+
+@pytest.mark.parametrize(
