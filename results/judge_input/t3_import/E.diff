@@ -0,0 +1,66 @@
+import datetime as dt
+from decimal import Decimal
+
+import pytest
+
+from ledger.errors import StatementRowError, UnknownFormatError
+from ledger.importer import detect_format, import_statement
+from ledger.storage import JsonFileStore, MemoryStore
+
+SFERA = (
+    "Дата;Сумма;Описание\n"
+    "01.03.2026;-1\u00a0200,50;Магазин Лента\n"
+    ";;;\n"
+    "02.03.2026;+85 000,00;Зарплата\n"
+    "   \n"
+)
+
+
+def test_sfera_cp1251_and_junk(write_csv, clock):
+    store = MemoryStore()
+    r = import_statement(write_csv(SFERA, encoding="cp1251"), store, clock=clock)
+    assert (r.format, r.encoding, r.added, r.duplicates, r.errors) == ("sfera", "cp1251", 2, 0, [])
+    assert store.all()[0].amount == Decimal("-1200.50")
+
+
+def test_reimport_and_in_file_repeats(write_csv, clock):
+    text = "Дата;Сумма;Описание\n01.03.2026;-150,00;Кофе\n01.03.2026;-150,00;кофе\n"
+    store = MemoryStore()
+    p = write_csv(text, encoding="utf-8-sig")
+    assert import_statement(p, store, clock=clock).added == 2
+    r = import_statement(p, store, clock=clock)
+    assert (r.added, r.duplicates, r.encoding) == (0, 2, "utf-8")
+
+
+def test_split_and_errors(write_csv, clock):
+    text = (
+        "ДАТА;Номер карты; Описание ;Приход;Расход\n"
+        "01.03.2026;1;A;100,00;0,00\n"
+        "02.03.2026;1;B;;5,5\n"
+        "03.03.2026;1;C;1,00;2,00\n"
+        "04.03.2026;1;D;-1,00;\n"
+        "05.03.2026;1;E;1.50;\n"
+        "2026-03-06;1;F;1,00;\n"
+        "06.03.2026;1;G;1,001;\n"
+    )
+    store = MemoryStore()
+    r = import_statement(write_csv(text), store, clock=clock)
+    assert r.format == "sfera_split" and r.added == 2
+    assert [e.line_no for e in r.errors] == [4, 5, 6, 7, 8]
+    assert store.all()[1].amount == Decimal("-5.50")
+
+
+def test_strict_is_atomic(write_csv, tmp_path, clock):
+    store = JsonFileStore(tmp_path / "s.json")
+    text = "Дата;Сумма;Описание\n01.03.2026;-1,00;ok\n02.03.2026;1.5;bad\n"
+    with pytest.raises(StatementRowError) as info:
+        import_statement(write_csv(text), store, strict=True, clock=clock)
+    assert info.value.line_no == 3
+    assert store.all() == [] and not (tmp_path / "s.json").exists()
+
+
+def test_unknown_format(write_csv):
+    assert detect_format(write_csv(SFERA)) == "sfera"
+    for text, fmt in [("", None), ("a;b\n1;2\n", None), (SFERA, "nova")]:
+        with pytest.raises(UnknownFormatError):
+            import_statement(write_csv(text), MemoryStore(), fmt=fmt)
