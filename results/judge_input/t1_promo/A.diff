+++ b/tests/test_orders_promo.py
@@ -0,0 +1,139 @@
+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart
+from shop.errors import (
+    EmptyCartError,
+    InvalidOrderStateError,
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.orders import OrderService
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+D = Decimal
+
+
+def make(clock, **kw):
+    promo = PromoCode("SUMMER", DiscountKind.PERCENT, D("10"), **kw)
+    reg = PromoRegistry(clock, [promo])
+    return OrderService(clock=clock, promos=reg), reg
+
+
+@pytest.fixture
+def cart(products):
+    c = Cart()
+    c.add(products["shirt"])
+    return c
+
+
+def test_blank_code_is_no_promo(clock, cart):
+    service, reg = make(clock)
+    for code in (None, "", "   "):
+        order = service.place_order(cart, code)
+        assert order.promo_code is None
+        assert order.total.discount == D("0.00")
+    assert reg.uses("SUMMER") == 0
+
+
+def test_normalized_code(clock, cart):
+    service, reg = make(clock)
+    assert service.quote(cart, " summer ").discount == D("99.90")
+    assert reg.uses("SUMMER") == 0
+    order = service.place_order(cart, " summer ")
+    assert order.promo_code == "SUMMER"
+    assert order.total.discount == D("99.90")
+    assert reg.uses("SUMMER") == 1
+
+
+def test_no_registry(clock, cart):
+    service = OrderService(clock=clock)
+    with pytest.raises(UnknownPromoCodeError):
+        service.quote(cart, "ANY")
+    assert service.quote(cart, "  ").discount == D("0.00")
+
+
+def test_non_string(clock, cart):
+    service, _ = make(clock)
+    with pytest.raises(ValidationError):
+        service.quote(cart, 123)
+    with pytest.raises(ValidationError):
+        service.place_order(cart, 123)
+
+
+def test_failed_attempts_have_no_side_effects(clock, cart):
+    service, reg = make(clock, min_order_amount=D("5000"), max_uses=5)
+    for code, exc in [("NOPE", UnknownPromoCodeError), ("SUMMER", PromoConditionsError)]:
+        with pytest.raises(exc):
+            service.place_order(cart, code)
+    with pytest.raises(EmptyCartError):
+        service.place_order(Cart(), "SUMMER")
+    assert reg.uses("SUMMER") == 0
+    assert len(service.store) == 0
+    assert service.store.next_id() == "ORD-000001"
+
+
+def test_expired(clock, cart):
+    service, reg = make(clock, expires_at=clock.now() + timedelta(hours=1))
+    clock.advance(timedelta(hours=1))
+    with pytest.raises(PromoExpiredError):
+        service.place_order(cart, "SUMMER")
+    assert len(service.store) == 0
+    assert reg.uses("SUMMER") == 0
+
+
+def test_limit_one(clock, cart):
+    service, reg = make(clock, max_uses=1)
+    service.place_order(cart, "SUMMER")
+    with pytest.raises(PromoConditionsError):
+        service.place_order(cart, "SUMMER")
+    assert reg.uses("SUMMER") == 1
+    assert len(service.store) == 1
+
+
+def test_cancel_releases(clock, cart):
+    service, reg = make(clock, max_uses=1)
+    order = service.place_order(cart, "SUMMER")
+    cancelled = service.cancel(order.order_id)
+    assert cancelled.promo_code == "SUMMER"
+    assert reg.uses("SUMMER") == 0
+    service.place_order(cart, "SUMMER")
+    assert reg.uses("SUMMER") == 1
+
+
+def test_double_cancel(clock, cart):
+    service, reg = make(clock)
+    first = service.place_order(cart, "SUMMER")
+    service.place_order(cart, "SUMMER")
+    service.cancel(first.order_id)
+    with pytest.raises(InvalidOrderStateError):
+        service.cancel(first.order_id)
+    assert reg.uses("SUMMER") == 1
+
+
+def test_cancel_after_expiry(clock, cart):
+    service, reg = make(clock, expires_at=clock.now() + timedelta(hours=1))
+    order = service.place_order(cart, "SUMMER")
+    clock.advance(timedelta(days=1))
+    service.cancel(order.order_id)
+    assert reg.uses("SUMMER") == 0
+
+
+def test_cancel_without_code_keeps_counters(clock, cart):
+    service, reg = make(clock)
+    service.place_order(cart, "SUMMER")
+    plain = service.place_order(cart)
+    service.cancel(plain.order_id)
+    assert reg.uses("SUMMER") == 1
+
+
+def test_legacy_calls(clock, cart):
+    service = OrderService(clock=clock)
+    order = service.place_order(cart)
+    assert order.promo_code is None
+    assert order.total.discount == D("0.00")
+    assert service.quote(cart).total == order.total.total
