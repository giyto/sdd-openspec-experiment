@@ -0,0 +1,158 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Category
+from shop.clock import FixedClock
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from shop.promo import DiscountKind, PromoCode, PromoRegistry
+
+T0 = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def pct(code="SUMMER", value="10", **kw):
+    return PromoCode(code, DiscountKind.PERCENT, Decimal(value), **kw)
+
+
+def test_code_is_normalized():
+    assert pct("  summer10 ").code == "SUMMER10"
+
+
+@pytest.mark.parametrize("value", ["0", "100.01", "-1"])
+def test_bad_percent(value):
+    with pytest.raises(ValidationError):
+        pct(value=value)
+
+
+def test_percent_100_ok():
+    assert pct(value="100").value == Decimal("100")
+
+
+def test_empty_code():
+    with pytest.raises(ValidationError):
+        pct("   ")
+
+
+@pytest.mark.parametrize("value", ["0", "-5", "10.001"])
+def test_bad_fixed(value):
+    with pytest.raises(ValidationError):
+        PromoCode("X", DiscountKind.FIXED, Decimal(value))
+
+
+def test_fixed_ok():
+    assert PromoCode("X", DiscountKind.FIXED, Decimal("10.50")).value == Decimal("10.50")
+
+
+def test_value_must_be_decimal():
+    with pytest.raises(ValidationError):
+        PromoCode("X", DiscountKind.FIXED, 10)
+
+
+def test_negative_min_amount():
+    with pytest.raises(ValidationError):
+        pct(min_order_amount=Decimal("-1"))
+
+
+@pytest.mark.parametrize("uses", [0, -1, 1.5, True])
+def test_bad_max_uses(uses):
+    with pytest.raises(ValidationError):
+        pct(max_uses=uses)
+
+
+def test_naive_dates():
+    with pytest.raises(ValidationError):
+        pct(starts_at=datetime(2026, 1, 1))
+    with pytest.raises(ValidationError):
+        pct(expires_at=datetime(2026, 1, 1))
+
+
+@pytest.mark.parametrize("delta", [0, -1])
+def test_inverted_window(delta):
+    with pytest.raises(ValidationError):
+        pct(starts_at=T0, expires_at=T0 + timedelta(days=delta))
+
+
+def test_bad_excluded_categories():
+    with pytest.raises(ValidationError):
+        pct(excluded_categories=frozenset({"books"}))
+
+
+def test_gift_card_never_participates():
+    promo = pct()
+    assert not promo.participates(Category.GIFT_CARD)
+    assert promo.participates(Category.BOOKS)
+    assert not pct(excluded_categories=frozenset({Category.BOOKS})).participates(Category.BOOKS)
+
+
+@pytest.fixture
+def clock():
+    return FixedClock(T0)
+
+
+def test_resolve_case_insensitive(clock):
+    reg = PromoRegistry(clock, [pct()])
+    assert reg.resolve("  summer ").code == "SUMMER"
+
+
+def test_unknown_and_empty(clock):
+    reg = PromoRegistry(clock, [pct()])
+    for code in ("NOPE", "", "  "):
+        with pytest.raises(UnknownPromoCodeError):
+            reg.resolve(code)
+
+
+def test_duplicate(clock):
+    reg = PromoRegistry(clock, [pct("SUMMER")])
+    with pytest.raises(ValidationError):
+        reg.add(pct("summer "))
+    assert reg.resolve("SUMMER")
+
+
+def test_window_boundaries(clock):
+    reg = PromoRegistry(clock, [pct(starts_at=T0, expires_at=T0 + timedelta(hours=1))])
+    assert reg.resolve("SUMMER")
+    clock.set(T0 - timedelta(seconds=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER")
+    clock.set(T0 + timedelta(hours=1))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER")
+
+
+def test_expired_beats_limit(clock):
+    reg = PromoRegistry(clock, [pct(expires_at=T0 + timedelta(hours=1), max_uses=1)])
+    reg.redeem("SUMMER")
+    clock.advance(timedelta(hours=2))
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("SUMMER")
+
+
+def test_limit(clock):
+    reg = PromoRegistry(clock, [pct(max_uses=2)])
+    reg.redeem("SUMMER")
+    assert reg.resolve("SUMMER")
+    reg.redeem("SUMMER")
+    with pytest.raises(PromoConditionsError):
+        reg.resolve("SUMMER")
+    with pytest.raises(PromoConditionsError):
+        reg.redeem("SUMMER")
+    assert reg.uses("SUMMER") == 2
+
+
+def test_counter(clock):
+    reg = PromoRegistry(clock, [pct()])
+    for _ in range(3):
+        reg.resolve("SUMMER")
+    assert reg.uses("SUMMER") == 0
+    assert reg.uses("NOPE") == 0
+    reg.release("SUMMER")
+    assert reg.uses("summer") == 0
+    reg.redeem("SUMMER")
+    reg.release("SUMMER")
+    assert reg.uses("SUMMER") == 0
