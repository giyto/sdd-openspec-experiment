+def _line_discounts(cart: Cart, promo: PromoCode | None) -> list[Decimal]:
+    """Discount of every cart line: all ``0.00`` without a promo or for non-participating lines."""
+    if promo is None:
+        return [ZERO] * len(cart.lines)
+    amounts = [
+        line.amount if promo.participates(line.product.category) else None for line in cart.lines
+    ]
+    base = sum_money(amount for amount in amounts if amount is not None)
+    if all(amount is None for amount in amounts):
+        raise PromoConditionsError(f"promo code {promo.code} has no applicable items in the order")
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(
+            f"promo code {promo.code} requires at least {promo.min_order_amount} of applicable items"
+        )
+    if promo.kind is DiscountKind.PERCENT:
+        discount = quantize_money(base * promo.value / 100)
+    else:
+        discount = min(promo.value, base)
+    return _split_discount(discount, amounts, base)
+
+
+def _split_discount(
+    discount: Decimal, amounts: list[Decimal | None], base: Decimal
+) -> list[Decimal]:
+    """Largest remainder split in integer kopecks; ``None`` amounts get nothing."""
+    discount_cents = int(discount * 100)
+    base_cents = int(base * 100)
+    shares: dict[int, int] = {}
+    remainders: list[tuple[int, int]] = []
+    for index, amount in enumerate(amounts):
+        if amount is None:
+            continue
+        shares[index], remainder = divmod(discount_cents * int(amount * 100), base_cents)
+        remainders.append((-remainder, index))
+    leftover = discount_cents - sum(shares.values())
+    for _, index in sorted(remainders)[:leftover]:
+        shares[index] += 1
+    return [Decimal(shares.get(i, 0)).scaleb(-2).quantize(ZERO) for i in range(len(amounts))]
