index 0000000..9696d56
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,149 @@
+"""Promo codes: the :class:`PromoCode` model and the :class:`PromoRegistry`.
+
+The registry checks existence, validity period and usage limit; conditions of the order
+itself (participating lines, minimum amount) are checked by ``calculate_total``.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import ZERO, to_money
+
+logger = logging.getLogger(__name__)
+
+HUNDRED = Decimal("100")
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _is_aware(value: datetime) -> bool:
+    return value.tzinfo is not None and value.utcoffset() is not None
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = ZERO
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", normalize_key(self.code))
+        if not self.code:
+            raise ValidationError("promo code must not be empty")
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError(f"kind of promo {self.code} must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError(f"value of promo {self.code} must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= HUNDRED:
+                raise ValidationError(f"percent of promo {self.code} must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError(f"amount of promo {self.code} must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError(f"amount of promo {self.code} has more than two digits")
+        if not isinstance(self.min_order_amount, Decimal) or not self.min_order_amount.is_finite():
+            raise ValidationError(f"min order amount of promo {self.code} must be Decimal")
+        if self.min_order_amount < 0:
+            raise ValidationError(f"min order amount of promo {self.code} must not be negative")
+        if to_money(self.min_order_amount) != self.min_order_amount:
+            raise ValidationError(f"min order amount of promo {self.code} has too many digits")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool) or not isinstance(self.max_uses, int) or self.max_uses < 1
+        ):
+            raise ValidationError(f"max_uses of promo {self.code} must be an integer >= 1")
+        for name in ("starts_at", "expires_at"):
+            moment = getattr(self, name)
+            if moment is not None and (not isinstance(moment, datetime) or not _is_aware(moment)):
+                raise ValidationError(f"{name} of promo {self.code} must be an aware datetime")
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError(f"promo {self.code}: starts_at must be before expires_at")
+        try:
+            categories = frozenset(self.excluded_categories)
+        except TypeError:
+            raise ValidationError("excluded_categories must be an iterable of categories") from None
+        if not all(isinstance(c, Category) for c in categories):
+            raise ValidationError(f"promo {self.code}: excluded_categories must be Category values")
+        object.__setattr__(self, "excluded_categories", categories)
+
+    def participates(self, category: Category) -> bool:
+        """Gift cards never take part in discounts, whatever the promo says."""
+        return category is not Category.GIFT_CARD and category not in self.excluded_categories
+
+
+class PromoRegistry:
+    """In-memory promo code registry with a usage counter."""
+
+    def __init__(self, clock: Clock, promos: Iterable[PromoCode] = ()) -> None:
+        self._clock = clock
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+        for promo in promos:
+            self.add(promo)
+
+    def add(self, promo: PromoCode) -> None:
+        if promo.code in self._promos:
+            raise ValidationError(f"duplicate promo code: {promo.code}")
+        self._promos[promo.code] = promo
+        self._uses[promo.code] = 0
+        logger.debug("promo: added %s", promo.code)
+
+    def resolve(self, code: str) -> PromoCode:
+        """Find a usable promo: it exists, is valid now and its limit is not reached."""
+        key = normalize_key(code)
+        promo = self._promos.get(key)
+        if promo is None:
+            raise UnknownPromoCodeError(f"unknown promo code: {key!r}")
+        now = self._clock.now()
+        if promo.starts_at is not None and now < promo.starts_at:
+            raise PromoExpiredError(f"promo code {key} is not active yet")
+        if promo.expires_at is not None and now >= promo.expires_at:
+            raise PromoExpiredError(f"promo code {key} has expired")
+        if promo.max_uses is not None and self._uses[key] >= promo.max_uses:
+            raise PromoConditionsError(f"usage limit of promo code {key} is reached")
+        return promo
+
+    def uses(self, code: str) -> int:
+        return self._uses.get(normalize_key(code), 0)
+
+    def redeem(self, code: str) -> None:
+        """Count one use of the code; refuses when the limit is already reached."""
+        key = normalize_key(code)
+        promo = self._promos.get(key)
+        if promo is None:
+            raise UnknownPromoCodeError(f"unknown promo code: {key!r}")
+        if promo.max_uses is not None and self._uses[key] >= promo.max_uses:
+            raise PromoConditionsError(f"usage limit of promo code {key} is reached")
+        self._uses[key] += 1
+
+    def release(self, code: str) -> None:
+        """Give one use back; the counter never goes below zero."""
+        key = normalize_key(code)
+        if self._uses.get(key, 0) > 0:
+            self._uses[key] -= 1
diff --git a/tests/test_orders_promo.py b/tests/test_orders_promo.py
new file mode 100644
index 0000000..2be479c
