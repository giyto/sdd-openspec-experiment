+from decimal import Decimal
+
+import pytest
+
+from shop.catalog import Cart, Category, Product
+from shop.errors import PromoConditionsError
+from shop.pricing import ShippingPolicy, _split_discount, calculate_total
+from shop.promo import DiscountKind, PromoCode
+
+D = Decimal
+
+
+def pct(value="10", **kw):
+    return PromoCode("P", DiscountKind.PERCENT, D(value), **kw)
+
+
+def fixed(value, **kw):
+    return PromoCode("P", DiscountKind.FIXED, D(value), **kw)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def prod(sku, price, category=Category.CLOTHING):
+    return Product(sku, sku, D(price), category)
+
+
+def test_no_promo_regression(products):
+    cart = cart_of((products["phone"], 1), (products["book"], 2))
+    total = calculate_total(cart)
+    assert total.discount == D("0.00")
+    assert all(line.discount == D("0.00") for line in total.lines)
+    assert total.total == total.subtotal + total.shipping + total.tax
+
+
+def test_gift_card_excluded(products):
+    cart = cart_of((products["gift"], 1), (products["shirt"], 1))
+    total = calculate_total(cart, promo=pct("10"))
+    assert total.lines[0].discount == D("0.00")
+    assert total.discount == D("99.90")
+
+
+def test_excluded_category(products):
+    cart = cart_of((products["book"], 1), (products["shirt"], 1))
+    total = calculate_total(cart, promo=pct("10", excluded_categories=frozenset({Category.BOOKS})))
+    assert total.lines[0].discount == D("0.00")
+    assert total.discount == D("99.90")
+
+
+def test_percent_rounding():
+    cart = cart_of((prod("A-1", "199.90"), 1))
+    assert calculate_total(cart, promo=pct("15")).discount == D("29.99")
+
+
+def test_fixed_capped_by_base():
+    cart = cart_of((prod("A-1", "300.00"), 1))
+    total = calculate_total(cart, promo=fixed("500"))
+    assert total.discount == D("300.00")
+    assert total.lines[0].discount == D("300.00")
+
+
+def test_hundred_percent():
+    cart = cart_of((prod("A-1", "300.00"), 1))
+    total = calculate_total(cart, promo=pct("100"))
+    assert total.discount == D("300.00")
+    assert total.tax == D("0.00")
+    assert total.total == total.shipping
+
+
+def test_min_amount_inclusive():
+    cart = cart_of((prod("A-1", "1000.00"), 1))
+    assert calculate_total(cart, promo=pct(min_order_amount=D("1000"))).discount == D("100.00")
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(min_order_amount=D("1000.01")))
+
+
+def test_gift_cards_do_not_reach_minimum(products):
+    cart = cart_of((prod("A-1", "600.00"), 1), (products["gift"], 1))
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart, promo=pct(min_order_amount=D("1000")))
+
+
+def test_no_participating_lines(products):
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=pct())
+    with pytest.raises(PromoConditionsError):
+        calculate_total(
+            cart_of((products["book"], 1)),
+            promo=pct(excluded_categories=frozenset({Category.BOOKS})),
+        )
+
+
+def test_split_equal_remainders():
+    cart = cart_of((prod("A-1", "10.00"), 1), (prod("B-1", "10.00"), 1), (prod("C-1", "10.00"), 1))
+    total = calculate_total(cart, promo=fixed("10"))
+    assert [line.discount for line in total.lines] == [D("3.34"), D("3.33"), D("3.33")]
+
+
+def test_split_largest_remainder():
+    cart = cart_of((prod("A-1", "30.00"), 1), (prod("B-1", "20.00"), 1), (prod("C-1", "10.00"), 1))
+    total = calculate_total(cart, promo=fixed("0.10"))
+    assert [line.discount for line in total.lines] == [D("0.05"), D("0.03"), D("0.02")]
+
+
+@pytest.mark.parametrize("discount_cents", range(1, 40))
+def test_split_properties(discount_cents):
+    amounts = [D("3.33"), None, D("7.01"), D("0.99"), D("12.50")]
+    base = D("23.83")
+    discount = D(discount_cents) / 100
+    shares = _split_discount(discount, amounts, base)
+    assert sum(shares) == discount
+    assert shares[1] == D("0.00")
+    for share, amount in zip(shares, amounts):
+        assert share <= (amount or D("0"))
+
+
+def test_tax_after_discount():
+    cart = cart_of((prod("E-1", "1000.00", Category.ELECTRONICS), 1))
+    total = calculate_total(cart, promo=fixed("100"))
+    assert total.lines[0].tax == D("180.00")
+    assert total.tax == D("180.00")
+
+
+def test_shipping_threshold_after_discount():
+    ship = ShippingPolicy()
+    below = calculate_total(cart_of((prod("A-1", "3000.00"), 1)), ship, promo=fixed("100"))
+    assert below.shipping == D("299.00")
+    exact = calculate_total(cart_of((prod("A-1", "3100.00"), 1)), ship, promo=fixed("100"))
+    assert exact.shipping == D("0.00")
+
+
+def test_total_formula():
+    cart = cart_of((prod("A-1", "500.00"), 1), (prod("B-1", "250.50"), 2))
+    t = calculate_total(cart, promo=pct("12.5"))
+    assert t.total == t.subtotal - t.discount + t.shipping + t.tax
+    assert t.discount == sum(line.discount for line in t.lines)
