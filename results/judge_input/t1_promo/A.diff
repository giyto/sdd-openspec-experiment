+import itertools
+
+import pytest
+
+from shop.errors import (
+    PromoConditionsError,
+    PromoError,
+    PromoExpiredError,
+    ShopError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+
+LEAVES = [UnknownPromoCodeError, PromoExpiredError, PromoConditionsError]
+
+
+@pytest.mark.parametrize("exc", LEAVES)
+def test_leaf_is_promo_error(exc):
+    assert issubclass(exc, PromoError)
+    assert issubclass(exc, ShopError)
+    assert not issubclass(exc, ValidationError)
+
+
+@pytest.mark.parametrize("a,b", list(itertools.permutations(LEAVES, 2)))
+def test_leaves_are_unrelated(a, b):
+    assert not issubclass(a, b)
