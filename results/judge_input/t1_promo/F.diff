+def _promo_discounts(cart_lines, promo: PromoCode) -> list[Decimal]:
+    """Per-line discounts; their sum is exactly the promo discount."""
+    from .promo import DiscountKind
+
+    eligible = [promo.applies_to(line.product.category) for line in cart_lines]
+    if not any(eligible):
+        raise PromoConditionsError(f"promo code {promo.code} has no eligible items in the cart")
+    base = sum_money(line.amount for line, ok in zip(cart_lines, eligible) if ok)
+    if base < promo.min_order_amount:
+        raise PromoConditionsError(f"order amount is below the minimum for {promo.code}")
+
+    if promo.kind is DiscountKind.PERCENT:
+        discount = quantize_money(base * promo.value / Decimal("100"))
+    else:
+        discount = min(quantize_money(promo.value), base)
+
+    base_kop = int(base / CENT)
+    discount_kop = int(discount / CENT)
+    floors = [0] * len(cart_lines)
+    remainders = [0] * len(cart_lines)
+    for i, (line, ok) in enumerate(zip(cart_lines, eligible)):
+        if ok:
+            floors[i], remainders[i] = divmod(discount_kop * int(line.amount / CENT), base_kop)
+    leftover = discount_kop - sum(floors)
+    order = sorted(range(len(cart_lines)), key=lambda i: (-remainders[i], i))
+    for i in order[:leftover]:
+        floors[i] += 1
+    return [Decimal(k) * CENT for k in floors]
