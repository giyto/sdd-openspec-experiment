new file mode 100644
index 0000000..d013ea7
--- /dev/null
+++ b/shop/promo.py
@@ -0,0 +1,139 @@
+"""Promo codes and their registry."""
+
+from __future__ import annotations
+
+import logging
+import threading
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from enum import StrEnum
+
+from .catalog import Category, normalize_key
+from .clock import Clock
+from .errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+from .money import to_money
+
+logger = logging.getLogger(__name__)
+
+
+class DiscountKind(StrEnum):
+    PERCENT = "percent"
+    FIXED = "fixed"
+
+
+def _require_aware(name: str, at: datetime | None) -> None:
+    if at is not None and (at.tzinfo is None or at.utcoffset() is None):
+        raise ValidationError(f"{name} must be an aware datetime")
+
+
+@dataclass(frozen=True)
+class PromoCode:
+    code: str
+    kind: DiscountKind
+    value: Decimal
+    min_order_amount: Decimal = Decimal("0.00")
+    starts_at: datetime | None = None
+    expires_at: datetime | None = None
+    max_uses: int | None = None
+    excluded_categories: frozenset[Category] = field(default_factory=frozenset)
+
+    def __post_init__(self) -> None:
+        code = normalize_key(self.code)
+        if not code:
+            raise ValidationError("promo code must not be empty")
+        object.__setattr__(self, "code", code)
+        if not isinstance(self.kind, DiscountKind):
+            raise ValidationError("promo kind must be a DiscountKind")
+        if not isinstance(self.value, Decimal) or not self.value.is_finite():
+            raise ValidationError("promo value must be a finite Decimal")
+        if self.kind is DiscountKind.PERCENT:
+            if not Decimal("0") < self.value <= Decimal("100"):
+                raise ValidationError("percent discount must be in (0, 100]")
+        else:
+            if self.value <= 0:
+                raise ValidationError("fixed discount must be positive")
+            if to_money(self.value) != self.value:
+                raise ValidationError("fixed discount has more than two fractional digits")
+        if not isinstance(self.min_order_amount, Decimal) or not self.min_order_amount.is_finite():
+            raise ValidationError("min_order_amount must be a finite Decimal")
+        if self.min_order_amount < 0:
+            raise ValidationError("min_order_amount must not be negative")
+        _require_aware("starts_at", self.starts_at)
+        _require_aware("expires_at", self.expires_at)
+        if (
+            self.starts_at is not None
+            and self.expires_at is not None
+            and self.starts_at >= self.expires_at
+        ):
+            raise ValidationError("starts_at must be earlier than expires_at")
+        if self.max_uses is not None and (
+            isinstance(self.max_uses, bool)
+            or not isinstance(self.max_uses, int)
+            or self.max_uses < 1
+        ):
+            raise ValidationError("max_uses must be an integer >= 1")
+        excluded = frozenset(self.excluded_categories)
+        if not all(isinstance(c, Category) for c in excluded):
+            raise ValidationError("excluded_categories must contain Category values")
+        object.__setattr__(self, "excluded_categories", excluded)
+
+    def applies_to(self, category: Category) -> bool:
+        """Gift cards never take part in promotions."""
+        return category is not Category.GIFT_CARD and category not in self.excluded_categories
+
+
+class PromoRegistry:
+    def __init__(self, clock: Clock) -> None:
+        self._clock = clock
+        self._promos: dict[str, PromoCode] = {}
+        self._uses: dict[str, int] = {}
+        self._lock = threading.RLock()
+
+    def add(self, promo: PromoCode) -> None:
+        with self._lock:
+            if promo.code in self._promos:
+                raise ValidationError(f"duplicate promo code: {promo.code}")
+            self._promos[promo.code] = promo
+            self._uses[promo.code] = 0
+
+    def resolve(self, code: str) -> PromoCode:
+        key = normalize_key(code)
+        with self._lock:
+            promo = self._promos.get(key)
+            if promo is None:
+                raise UnknownPromoCodeError(f"unknown promo code: {key!r}")
+            now = self._clock.now()
+            if (promo.starts_at is not None and now < promo.starts_at) or (
+                promo.expires_at is not None and now >= promo.expires_at
+            ):
+                raise PromoExpiredError(f"promo code {key} is not valid now")
+            if promo.max_uses is not None and self._uses[key] >= promo.max_uses:
+                raise PromoConditionsError(f"promo code {key} usage limit reached")
+            return promo
+
+    def uses(self, code: str) -> int:
+        key = normalize_key(code)
+        with self._lock:
+            if key not in self._promos:
+                raise UnknownPromoCodeError(f"unknown promo code: {key!r}")
+            return self._uses[key]
+
+    def consume(self, code: str) -> PromoCode:
+        """Re-check the code and count one use atomically."""
+        with self._lock:
+            promo = self.resolve(code)
+            self._uses[promo.code] += 1
+            return promo
+
+    def release(self, code: str) -> None:
+        """Give one use back (order cancelled)."""
+        key = normalize_key(code)
+        with self._lock:
+            if self._uses.get(key, 0) > 0:
+                self._uses[key] -= 1
diff --git a/tests/test_promo.py b/tests/test_promo.py
new file mode 100644
index 0000000..9c250a4
--- /dev/null
+++ b/tests/test_promo.py
@@ -0,0 +1,127 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from shop import Cart, DiscountKind, OrderService, PromoCode, PromoRegistry, calculate_total
+from shop.catalog import Category
+from shop.errors import (
+    PromoConditionsError,
+    PromoExpiredError,
+    UnknownPromoCodeError,
+    ValidationError,
+)
+
+D = Decimal
+
+
+def make(clock, *promos):
+    reg = PromoRegistry(clock)
+    for p in promos:
+        reg.add(p)
+    return reg, OrderService(clock=clock, promos=reg)
+
+
+def cart_of(*items):
+    cart = Cart()
+    for product, qty in items:
+        cart.add(product, qty)
+    return cart
+
+
+def test_percent_split_and_tax(products):
+    promo = PromoCode("sum", DiscountKind.PERCENT, D("10"))
+    cart = cart_of((products["book"], 1), (products["phone"], 1), (products["gift"], 1))
+    t = calculate_total(cart, promo=promo)
+    assert t.discount == D("295.00")
+    assert [l.discount for l in t.lines] == [D("45.00"), D("250.00"), D("0.00")]
+    assert t.lines[0].tax == D("40.50")
+    assert t.total == t.subtotal - t.discount + t.shipping + t.tax
+
+
+def test_remainder_distribution_largest_remainder(products):
+    promo = PromoCode("F", DiscountKind.FIXED, D("0.02"))
+    cart = cart_of((products["book"], 1), (products["tea"], 1), (products["shirt"], 1))
+    t = calculate_total(cart, promo=promo)
+    assert sum(l.discount for l in t.lines) == D("0.02")
+    assert [l.discount for l in t.lines] == [D("0.01"), D("0.00"), D("0.01")]
+
+
+def test_fixed_capped(products):
+    promo = PromoCode("F", DiscountKind.FIXED, D("5000"))
+    t = calculate_total(cart_of((products["book"], 1), (products["gift"], 1)), promo=promo)
+    assert t.discount == D("450.00")
+
+
+def test_min_amount_and_no_eligible(products):
+    promo = PromoCode("M", DiscountKind.PERCENT, D("10"), min_order_amount=D("1000"))
+    ok = cart_of((products["book"], 1), (products["tea"], 1), (products["shirt"], 1))
+    assert calculate_total(ok, promo=PromoCode("M", DiscountKind.PERCENT, D("10"), min_order_amount=D("1648.90"))).discount > 0
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["book"], 1), (products["gift"], 5)), promo=promo)
+    with pytest.raises(PromoConditionsError):
+        calculate_total(cart_of((products["gift"], 1)), promo=PromoCode("X", DiscountKind.PERCENT, D("10")))
+
+
+def test_shipping_threshold_after_discount(products):
+    promo = PromoCode("P", DiscountKind.PERCENT, D("10"))
+    cart = cart_of((products["phone"], 1), (products["book"], 1))  # 2950 -> 2655
+    t = calculate_total(cart, promo=promo)
+    assert t.shipping == D("299.00")
+    assert calculate_total(cart).shipping == D("299.00")
+
+
+def test_resolve_order_and_normalization(clock):
+    now = clock.now()
+    exp = PromoCode("old", DiscountKind.PERCENT, D("5"), expires_at=now, max_uses=1)
+    fut = PromoCode("fut", DiscountKind.PERCENT, D("5"), starts_at=now + timedelta(days=1))
+    ok = PromoCode(" summer ", DiscountKind.PERCENT, D("5"), starts_at=now, max_uses=1)
+    reg, _ = make(clock, exp, fut, ok)
+    assert reg.resolve("  SUMMER").code == "SUMMER"
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("old")
+    with pytest.raises(PromoExpiredError):
+        reg.resolve("fut")
+    with pytest.raises(UnknownPromoCodeError):
+        reg.resolve("")
+    with pytest.raises(ValidationError):
+        reg.add(PromoCode("Summer", DiscountKind.FIXED, D("1")))
+
+
+def test_validation():
+    for kwargs in (
+        dict(code="  ", kind=DiscountKind.FIXED, value=D("1")),
+        dict(code="a", kind=DiscountKind.PERCENT, value=D("0")),
+        dict(code="a", kind=DiscountKind.PERCENT, value=D("100.1")),
+        dict(code="a", kind=DiscountKind.FIXED, value=D("0")),
+        dict(code="a", kind=DiscountKind.FIXED, value=D("1"), max_uses=0),
+    ):
+        with pytest.raises(ValidationError):
+            PromoCode(**kwargs)
+
+
+def test_usage_lifecycle(clock, products):
+    promo = PromoCode("ONE", DiscountKind.PERCENT, D("10"), max_uses=1)
+    reg, svc = make(clock, promo)
+    cart = cart_of((products["phone"], 1))
+    svc.quote(cart, "one")
+    assert reg.uses("ONE") == 0
+    with pytest.raises(PromoConditionsError):
+        svc.place_order(cart_of((products["gift"], 1)), "one")
+    assert reg.uses("one") == 0
+    order = svc.place_order(cart, " one ")
+    assert order.promo_code == "ONE" and reg.uses("ONE") == 1
+    with pytest.raises(PromoConditionsError):
+        svc.place_order(cart, "ONE")
+    svc.cancel(order.order_id)
+    assert reg.uses("ONE") == 0
+    assert svc.place_order(cart, "ONE").promo_code == "ONE"
+
+
+def test_blank_and_no_registry(clock, products):
+    svc = OrderService(clock=clock)
+    cart = cart_of((products["phone"], 1))
+    assert svc.place_order(cart, "  ").promo_code is None
+    assert svc.quote(cart, "").discount == D("0.00")
+    with pytest.raises(UnknownPromoCodeError):
+        svc.quote(cart, "X")
