diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..2d7495f
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,408 @@
+from dataclasses import FrozenInstanceError
+from datetime import timedelta
+
+import pytest
+
+import warehouse
+from warehouse import (
+    DEFAULT_RESERVATION_TTL,
+    DuplicateReservationError,
+    InsufficientStockError,
+    InvalidQuantityError,
+    ReservationError,
+    ReservationExpiredError,
+    ReservationLine,
+    ReservationNotFoundError,
+    ReservationStateError,
+    ReservationStatus,
+    UnknownSkuError,
+    ValidationError,
+    WarehouseError,
+)
+from warehouse.models import Reservation
+from warehouse.reservations import aggregate, effective_status, normalize_lines
+from warehouse.storage import InMemoryStore
+
+from conftest import T0
+
+MIN = timedelta(minutes=1)
+
+
+@pytest.fixture
+def stocked(inv):
+    inv.receive("MAIN", "BOLT-M8", 10)
+    inv.receive("EXTRA", "NUT-M8", 5)
+    return inv
+
+
+# --- модели, ошибки, хелперы, хранилище -------------------------------------
+
+
+def test_error_hierarchy_and_order_id():
+    for cls in (ReservationNotFoundError, DuplicateReservationError, ReservationExpiredError):
+        err = cls("SO-1")
+        assert isinstance(err, ReservationError) and isinstance(err, WarehouseError)
+        assert err.order_id == "SO-1"
+    assert ReservationStateError("SO-1", "CANCELLED").order_id == "SO-1"
+
+
+def test_models_are_frozen():
+    res = Reservation("SO-1", (ReservationLine("MAIN", "BOLT-M8", 1),), ReservationStatus.ACTIVE, T0, T0)
+    with pytest.raises(FrozenInstanceError):
+        res.status = ReservationStatus.CANCELLED
+    with pytest.raises(FrozenInstanceError):
+        res.lines[0].qty = 5
+
+
+def test_helpers():
+    assert DEFAULT_RESERVATION_TTL == timedelta(minutes=15)
+    lines = normalize_lines([("A", "X", 1), ReservationLine("A", "X", 2)])
+    assert aggregate(lines) == {("A", "X"): 3}
+    for bad in ([], [("A", "X")], ["abc"], "abc", 5):
+        with pytest.raises(ValidationError):
+            normalize_lines(bad)
+    res = Reservation("SO-1", lines, ReservationStatus.ACTIVE, T0, T0 + MIN)
+    assert effective_status(res, T0 + MIN - timedelta(seconds=1)) is ReservationStatus.ACTIVE
+    assert effective_status(res, T0 + MIN) is ReservationStatus.EXPIRED
+
+
+def test_store_reservations():
+    store = InMemoryStore()
+    assert store.get_reservation("SO-1") is None
+    first = Reservation("SO-1", (), ReservationStatus.ACTIVE, T0, T0)
+    store.put_reservation(first)
+    second = Reservation("SO-1", (), ReservationStatus.CANCELLED, T0, T0)
+    store.put_reservation(second)
+    assert store.get_reservation("SO-1") is second
+
+
+def test_package_exports():
+    for name in ("Reservation", "ReservationLine", "ReservationStatus", "DEFAULT_RESERVATION_TTL"):
+        assert name in warehouse.__all__
+
+
+# --- reserve ------------------------------------------------------------------
+
+
+def test_reserve_success(stocked, clock):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ReservationLine("EXTRA", "NUT-M8", 2)])
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.created_at == T0 and res.expires_at == T0 + timedelta(minutes=15)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 3
+    assert stocked.reserved("EXTRA", "NUT-M8") == 2
+
+
+def test_reserve_explicit_ttl(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=timedelta(hours=1))
+    assert res.expires_at == T0 + timedelta(hours=1)
+
+
+def test_reserve_keeps_duplicate_lines(stocked):
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 3)])
+    assert [line.qty for line in res.lines] == [2, 3]
+    assert stocked.reserved("MAIN", "BOLT-M8") == 5
+
+
+def test_reserve_insufficient_by_sum(stocked):
+    stocked.reserve("SO-0", [("MAIN", "BOLT-M8", 6)])
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2), ("MAIN", "BOLT-M8", 3)])
+    assert (exc.value.requested, exc.value.available) == (5, 4)
+    assert len(stocked.log) == before
+    with pytest.raises(ReservationNotFoundError):
+        stocked.get_reservation("SO-1")
+
+
+def test_reserve_second_line_fails_atomically(stocked):
+    before = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1), ("EXTRA", "NUT-M8", 6)])
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert len(stocked.log) == before
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), -MIN, 15, True, "15"])
+def test_reserve_bad_ttl(stocked, ttl):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=ttl)
+
+
+@pytest.mark.parametrize("order_id", ["", "SO 1", "SO=1", None])
+def test_reserve_bad_order_id(stocked, order_id):
+    with pytest.raises(ValidationError):
+        stocked.reserve(order_id, [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_empty_lines(stocked):
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+
+
+@pytest.mark.parametrize("qty", [0, True, 1.5, -1])
+def test_reserve_bad_qty(stocked, qty):
+    with pytest.raises(InvalidQuantityError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", qty)])
+
+
+def test_reserve_unknown_sku_and_bad_code(stocked):
+    with pytest.raises(UnknownSkuError):
+        stocked.reserve("SO-1", [("MAIN", "NOPE", 1)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [("MA IN", "BOLT-M8", 1)])
+
+
+def test_reserve_accepts_iterator(stocked):
+    res = stocked.reserve("SO-1", iter([("MAIN", "BOLT-M8", 1)]))
+    assert len(res.lines) == 1
+
+
+# --- available / reserved -----------------------------------------------------
+
+
+def test_available_and_adjust_clamp(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert (stocked.reserved("MAIN", "BOLT-M8"), stocked.available("MAIN", "BOLT-M8")) == (4, 6)
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+    assert stocked.stock_levels("MAIN")[0].on_hand == 10
+    stocked.adjust("MAIN", "BOLT-M8", 3, "count")
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    assert stocked.reserved("MAIN", "BOLT-M8") == 4
+
+
+def test_available_unknown_and_empty(stocked):
+    for method in (stocked.available, stocked.reserved):
+        with pytest.raises(UnknownSkuError):
+            method("MAIN", "NOPE")
+        assert method("MAIN", "OIL-5L") == 0
+
+
+# --- истечение ----------------------------------------------------------------
+
+
+def test_expiry_boundary(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)], ttl=MIN)
+    clock.advance(MIN - timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+    clock.advance(timedelta(seconds=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.EXPIRED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+
+
+def test_final_statuses_do_not_expire(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-2")
+    clock.advance(timedelta(days=1))
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation("SO-2").status is ReservationStatus.CANCELLED
+
+
+def test_expiry_not_logged(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    n = len(stocked.log)
+    clock.advance(timedelta(hours=1))
+    stocked.get_reservation("SO-1")
+    stocked.available("MAIN", "BOLT-M8")
+    assert len(stocked.log) == n
+
+
+# --- confirm ------------------------------------------------------------------
+
+
+def test_confirm_success_and_events(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("EXTRA", "NUT-M8", 2)])
+    res = stocked.confirm("SO-1")
+    assert res.status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 7
+    assert stocked.on_hand("EXTRA", "NUT-M8") == 3
+    assert stocked.reserved("MAIN", "BOLT-M8") == 0
+    assert stocked.log.lines()[-3:] == [
+        "000005 2026-03-01T10:00:00Z ISSUE qty=3 ref=SO-1 sku=BOLT-M8 wh=MAIN",
+        "000006 2026-03-01T10:00:00Z ISSUE qty=2 ref=SO-1 sku=NUT-M8 wh=EXTRA",
+        "000007 2026-03-01T10:00:00Z RESERVE_CONFIRM order=SO-1",
+    ]
+
+
+def test_confirm_with_zero_available(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 10)])
+    assert stocked.available("MAIN", "BOLT-M8") == 0
+    assert stocked.confirm("SO-1").status is ReservationStatus.CONFIRMED
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 0
+
+
+def test_confirm_insufficient_has_no_side_effects(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("MAIN", "BOLT-M8", 3)])
+    stocked.adjust("MAIN", "BOLT-M8", 5, "count")
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 5
+    assert len(stocked.log) == n
+    assert stocked.get_reservation("SO-1").status is ReservationStatus.ACTIVE
+
+
+def test_confirm_shortage_on_second_position(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("EXTRA", "NUT-M8", 2)])
+    stocked.adjust("EXTRA", "NUT-M8", 1, "count")
+    with pytest.raises(InsufficientStockError):
+        stocked.confirm("SO-1")
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10
+
+
+def test_confirm_state_errors(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)], ttl=MIN)
+    stocked.reserve("SO-3", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-1")
+    stocked.cancel("SO-3")
+    clock.advance(MIN)
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-1")
+    with pytest.raises(ReservationStateError):
+        stocked.confirm("SO-3")
+    with pytest.raises(ReservationExpiredError) as exc:
+        stocked.confirm("SO-2")
+    assert exc.value.order_id == "SO-2"
+
+
+# --- cancel -------------------------------------------------------------------
+
+
+def test_cancel_flow(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 4)])
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert stocked.available("MAIN", "BOLT-M8") == 10
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.CANCELLED
+    assert len(stocked.log) == n
+    assert stocked.log.lines()[-1] == "000004 2026-03-01T10:00:00Z RESERVE_CANCEL order=SO-1"
+
+
+def test_cancel_expired_and_confirmed(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MIN)
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.confirm("SO-2")
+    clock.advance(MIN)
+    n = len(stocked.log)
+    assert stocked.cancel("SO-1").status is ReservationStatus.EXPIRED
+    assert len(stocked.log) == n
+    with pytest.raises(ReservationStateError):
+        stocked.cancel("SO-2")
+
+
+def test_not_found(stocked):
+    for call in (
+        stocked.confirm,
+        stocked.cancel,
+        stocked.get_reservation,
+        lambda oid: stocked.extend(oid, MIN),
+    ):
+        with pytest.raises(ReservationNotFoundError) as exc:
+            call("SO-9")
+        assert exc.value.order_id == "SO-9"
+
+
+# --- extend -------------------------------------------------------------------
+
+
+def test_extend_from_now(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=10))
+    res = stocked.extend("SO-1", timedelta(minutes=30))
+    assert res.expires_at == T0 + timedelta(minutes=40)
+    assert stocked.log.lines()[-1] == "000004 2026-03-01T10:10:00Z RESERVE_EXTEND expires=2026-03-01T10:40:00Z order=SO-1"
+
+
+def test_extend_never_shortens(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    clock.advance(timedelta(minutes=10))
+    n = len(stocked.log)
+    res = stocked.extend("SO-1", MIN)
+    assert res.expires_at == T0 + timedelta(minutes=15)
+    assert len(stocked.log) == n
+
+
+def test_extend_errors(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MIN)
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    stocked.cancel("SO-2")
+    with pytest.raises(ValidationError):
+        stocked.extend("SO-1", timedelta(0))
+    clock.advance(MIN)
+    with pytest.raises(ReservationExpiredError):
+        stocked.extend("SO-1", MIN)
+    with pytest.raises(ReservationStateError):
+        stocked.extend("SO-2", MIN)
+
+
+# --- повторное резервирование -------------------------------------------------
+
+
+def test_duplicate_active_and_confirmed(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)])
+    stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 2)])
+    assert stocked.get_reservation("SO-1").lines[0].qty == 1
+    stocked.confirm("SO-2")
+    with pytest.raises(DuplicateReservationError):
+        stocked.reserve("SO-2", [("MAIN", "BOLT-M8", 1)])
+
+
+def test_reserve_replaces_expired_or_cancelled(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 1)], ttl=MIN)
+    clock.advance(MIN)
+    res = stocked.reserve("SO-1", [("EXTRA", "NUT-M8", 2)])
+    assert stocked.get_reservation("SO-1") == res
+    assert [line.sku for line in res.lines] == ["NUT-M8"]
+    stocked.cancel("SO-1")
+    res = stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3)])
+    assert stocked.get_reservation("SO-1").lines == res.lines
+    assert res.status is ReservationStatus.ACTIVE
+
+
+# --- issue / transfer ---------------------------------------------------------
+
+
+def test_issue_respects_reservations(stocked, clock):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)], ttl=MIN)
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError) as exc:
+        stocked.issue("MAIN", "BOLT-M8", 3)
+    assert exc.value.available == 2
+    assert stocked.on_hand("MAIN", "BOLT-M8") == 10 and len(stocked.log) == n
+    assert stocked.issue("MAIN", "BOLT-M8", 2) == 8
+    clock.advance(MIN)
+    assert stocked.issue("MAIN", "BOLT-M8", 8) == 0
+
+
+def test_transfer_respects_reservations(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 8)])
+    with pytest.raises(InsufficientStockError):
+        stocked.transfer("MAIN", "EXTRA", "BOLT-M8", 3)
+    stocked.transfer("MAIN", "EXTRA", "BOLT-M8", 2)
+    assert stocked.on_hand("EXTRA", "BOLT-M8") == 2
+
+
+# --- события ------------------------------------------------------------------
+
+
+def test_reserve_events(stocked):
+    stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 3), ("EXTRA", "NUT-M8", 2)])
+    assert stocked.log.lines()[-2:] == [
+        "000003 2026-03-01T10:00:00Z RESERVE expires=2026-03-01T10:15:00Z order=SO-1 qty=3 sku=BOLT-M8 wh=MAIN",
+        "000004 2026-03-01T10:00:00Z RESERVE expires=2026-03-01T10:15:00Z order=SO-1 qty=2 sku=NUT-M8 wh=EXTRA",
+    ]
+
+
+def test_failed_operations_leave_no_events(stocked):
+    n = len(stocked.log)
+    with pytest.raises(InsufficientStockError):
+        stocked.reserve("SO-1", [("MAIN", "BOLT-M8", 11)])
+    with pytest.raises(ValidationError):
+        stocked.reserve("SO-1", [])
+    assert len(stocked.log) == n
